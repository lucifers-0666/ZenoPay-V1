# ZenoPay Environment Variables Configuration
# Copy this file to .env and update with your actual values

# ============ APPLICATION SETTINGS ============
NODE_ENV=development
PORT=3000

# ============ APPLICATION SETTINGS ============
APP_URL=http://localhost:3000

# ============ DATABASE ============
MONGO_URI=mongodb://localhost:27017/zenopay
# For production, use MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zenopay?retryWrites=true&w=majority

# ============ SESSION CONFIGURATION ============
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
BCRYPT_ROUNDS=12
CARD_ENCRYPTION_KEY=replace-with-long-random-secret
CARD_HASH_KEY=replace-with-long-random-secret
PIN_HASH_ROUNDS=12
CARD_TOKEN_PROVIDER=stripe
CARD_TOKENIZATION_REQUIRED=true

# ============ EMAIL SERVICE ============
EMAIL_PROVIDER=smtp
# Options: smtp, sendgrid, mailgun

# SMTP Configuration (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your-smtp-login-email@example.com
EMAIL_PASS=your-smtp-app-password
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# SendGrid (optional)
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun (optional)
MAILGUN_DOMAIN=your-domain.com
MAILGUN_API_KEY=your-mailgun-api-key

# Email From Settings
EMAIL_FROM=noreply@zenopay.com
EMAIL_FROM_NAME=ZenoPay

EMAIL_OTP_EXPIRY_MS=600000
# ============ SMS SERVICE ============
# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============ PAYMENT GATEWAY ============
# Razorpay
RAZORPAY_KEY=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox
# Change to 'live' for production

# ============ AZURE BLOB STORAGE ============
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=zenopay-uploads

# ============ SECURITY ============
# JWT (if using token-based auth)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ============ CORS SETTINGS ============
ALLOWED_ORIGINS=http://localhost:3000,https://zenopay.com
# Comma-separated list of allowed origins

# ============ 2FA SETTINGS ============
TWO_FA_ISSUER=ZenoPay
TWO_FA_WINDOW=2

# ============ LOGGING ============
LOG_LEVEL=info
# Options: error, warn, info, debug

# ============ TESTING ============
TEST_MONGO_URI=mongodb://localhost:27017/zenopay-test

# ============ ADMIN CONFIGURATION ============
# Default admin credentials (for initial setup only)
DEFAULT_ADMIN_EMAIL=admin@zenopay.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_ZENOPAY_ID=ZADMIN0001

# ============ MERCHANT SETTINGS ============
MERCHANT_COMMISSION_PERCENTAGE=2.5
AUTO_PAYOUT_THRESHOLD=10000
SETTLEMENT_FREQUENCY=daily
# Options: daily, weekly, monthly

# ============ FRONTEND URLs ============
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
MERCHANT_URL=http://localhost:3000/merchant

# ============ WEBHOOK URLs ============
PAYMENT_WEBHOOK_URL=https://api.zenopay.com/webhooks/payment
MERCHANT_WEBHOOK_URL=https://api.zenopay.com/webhooks/merchant

# ============ FEATURE FLAGS ============
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_KYC_VERIFICATION=true
ENABLE_REFERRAL_PROGRAM=true
ENABLE_MERCHANT_ONBOARDING=true

# ============ ANALYTICS & MONITORING ============
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y
SENTRY_DSN=your-sentry-dsn

# ============ REDIS (for caching - optional) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ============ MISCELLANEOUS ============
MAX_FILE_UPLOAD_SIZE=5242880
# 5MB in bytes
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Currency Settings
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR

# Transaction Limits
MIN_TRANSACTION_AMOUNT=1
MAX_TRANSACTION_AMOUNT=100000
DAILY_TRANSACTION_LIMIT=500000
