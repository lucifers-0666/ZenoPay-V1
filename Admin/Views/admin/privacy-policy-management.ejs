<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 30px;
    }
    
    .container {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .header {
      background: white;
      padding: 30px;
      border-radius: 16px;
      margin-bottom: 30px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }
    
    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    
    h1 {
      font-size: 32px;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    h1 i {
      color: #667eea;
    }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    
    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 20px;
      border-radius: 12px;
      color: white;
    }
    
    .stat-label {
      font-size: 14px;
      opacity: 0.9;
      margin-bottom: 8px;
    }
    
    .stat-value {
      font-size: 32px;
      font-weight: bold;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.3s;
    }
    
    .btn:hover {
      background: #5568d3;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }
    
    .btn-success {
      background: #10b981;
    }
    
    .btn-success:hover {
      background: #059669;
    }
    
    .btn-danger {
      background: #ef4444;
    }
    
    .btn-danger:hover {
      background: #dc2626;
    }
    
    .content-section {
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }
    
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 2px solid #f0f0f0;
    }
    
    .section-title {
      font-size: 24px;
      font-weight: 600;
      color: #1a1a1a;
    }
    
    .policies-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .policies-table th {
      background: #f8f9fa;
      padding: 15px;
      text-align: left;
      font-weight: 600;
      color: #666;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .policies-table td {
      padding: 20px 15px;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .policies-table tr:hover {
      background: #f8f9fa;
    }
    
    .status-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .status-draft {
      background: #fef3c7;
      color: #92400e;
    }
    
    .status-published {
      background: #d1fae5;
      color: #065f46;
    }
    
    .status-archived {
      background: #e5e7eb;
      color: #374151;
    }
    
    .current-badge {
      background: #667eea;
      color: white;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      margin-left: 8px;
    }
    
    .action-buttons {
      display: flex;
      gap: 8px;
    }
    
    .btn-icon {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.3s;
      background: #f3f4f6;
      color: #6b7280;
    }
    
    .btn-icon:hover {
      background: #667eea;
      color: white;
    }
    
    .btn-icon.danger:hover {
      background: #ef4444;
      color: white;
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }
    
    .empty-state i {
      font-size: 64px;
      color: #d1d5db;
      margin-bottom: 20px;
    }
    
    .empty-state h3 {
      font-size: 20px;
      color: #6b7280;
      margin-bottom: 10px;
    }
    
    .empty-state p {
      color: #9ca3af;
      margin-bottom: 20px;
    }
    
    .alert {
      padding: 15px 20px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: none;
    }
    
    .alert.show {
      display: block;
    }
    
    .alert-success {
      background: #d1fae5;
      color: #065f46;
      border-left: 4px solid #10b981;
    }
    
    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border-left: 4px solid #ef4444;
    }
    
    .version-text {
      font-family: 'Courier New', monospace;
      font-weight: 600;
      color: #667eea;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="header-top">
        <h1>
          <i class="fas fa-shield-alt"></i>
          Privacy Policy Management
        </h1>
        <a href="/admin/privacy-policy/create" class="btn">
          <i class="fas fa-plus"></i>
          Create New Version
        </a>
      </div>
      
      <!-- Statistics -->
      <% if (currentPolicy) { %>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Current Version</div>
          <div class="stat-value">v<%= currentPolicy.version %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Users Accepted</div>
          <div class="stat-value"><%= acceptanceCount %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Total Users</div>
          <div class="stat-value"><%= totalUsers %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Acceptance Rate</div>
          <div class="stat-value"><%= acceptancePercentage %>%</div>
        </div>
      </div>
      <% } %>
    </div>
    
    <!-- Alerts -->
    <div id="alertBox" class="alert"></div>
    
    <!-- Policies List -->
    <div class="content-section">
      <div class="section-header">
        <h2 class="section-title">All Privacy Policy Versions</h2>
      </div>
      
      <% if (policies && policies.length > 0) { %>
      <table class="policies-table">
        <thead>
          <tr>
            <th>Version</th>
            <th>Status</th>
            <th>Published Date</th>
            <th>Effective Date</th>
            <th>Last Modified</th>
            <th>Change Summary</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% policies.forEach(policy => { %>
          <tr>
            <td>
              <span class="version-text">v<%= policy.version %></span>
              <% if (policy.isCurrent) { %>
              <span class="current-badge">CURRENT</span>
              <% } %>
            </td>
            <td>
              <span class="status-badge status-<%= policy.status %>">
                <%= policy.status %>
              </span>
            </td>
            <td>
              <%= policy.publishedDate ? new Date(policy.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not published' %>
            </td>
            <td>
              <%= new Date(policy.effectiveDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </td>
            <td>
              <%= new Date(policy.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </td>
            <td>
              <%= policy.changeSummary || 'No summary provided' %>
            </td>
            <td>
              <div class="action-buttons">
                <% if (policy.status === 'draft') { %>
                <a href="/admin/privacy-policy/<%= policy._id %>/edit" class="btn-icon" title="Edit">
                  <i class="fas fa-edit"></i>
                </a>
                <button onclick="publishPolicy('<%= policy._id %>')" class="btn-icon" title="Publish">
                  <i class="fas fa-paper-plane"></i>
                </button>
                <button onclick="deletePolicy('<%= policy._id %>')" class="btn-icon danger" title="Delete">
                  <i class="fas fa-trash"></i>
                </button>
                <% } %>
                
                <a href="/admin/privacy-policy/<%= policy._id %>/preview" target="_blank" class="btn-icon" title="Preview">
                  <i class="fas fa-eye"></i>
                </a>
                
                <% if (policy.status === 'published') { %>
                <a href="/admin/privacy-policy/<%= policy.version %>/analytics" class="btn-icon" title="Analytics">
                  <i class="fas fa-chart-bar"></i>
                </a>
                <button onclick="archivePolicy('<%= policy._id %>')" class="btn-icon" title="Archive">
                  <i class="fas fa-archive"></i>
                </button>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <div class="empty-state">
        <i class="fas fa-file-alt"></i>
        <h3>No Privacy Policies Yet</h3>
        <p>Create your first privacy policy version to get started.</p>
        <a href="/admin/privacy-policy/create" class="btn">
          <i class="fas fa-plus"></i>
          Create Privacy Policy
        </a>
      </div>
      <% } %>
    </div>
  </div>
  
  <script>
    function showAlert(message, type = 'success') {
      const alertBox = document.getElementById('alertBox');
      alertBox.className = `alert alert-${type} show`;
      alertBox.textContent = message;
      
      setTimeout(() => {
        alertBox.classList.remove('show');
      }, 5000);
    }
    
    async function publishPolicy(policyId) {
      if (!confirm('Are you sure you want to publish this policy? All users will be notified.')) {
        return;
      }
      
      try {
        const response = await fetch(`/admin/privacy-policy/${policyId}/publish`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        
        if (data.success) {
          showAlert(data.message, 'success');
          setTimeout(() => window.location.reload(), 2000);
        } else {
          showAlert(data.message || 'Failed to publish policy', 'error');
        }
      } catch (error) {
        showAlert('Error publishing policy', 'error');
        console.error(error);
      }
    }
    
    async function deletePolicy(policyId) {
      if (!confirm('Are you sure you want to delete this draft? This action cannot be undone.')) {
        return;
      }
      
      try {
        const response = await fetch(`/admin/privacy-policy/${policyId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        
        if (data.success) {
          showAlert(data.message, 'success');
          setTimeout(() => window.location.reload(), 2000);
        } else {
          showAlert(data.message || 'Failed to delete policy', 'error');
        }
      } catch (error) {
        showAlert('Error deleting policy', 'error');
        console.error(error);
      }
    }
    
    async function archivePolicy(policyId) {
      if (!confirm('Are you sure you want to archive this policy?')) {
        return;
      }
      
      try {
        const response = await fetch(`/admin/privacy-policy/${policyId}/archive`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        
        if (data.success) {
          showAlert(data.message, 'success');
          setTimeout(() => window.location.reload(), 2000);
        } else {
          showAlert(data.message|'Failed to archive policy', 'error');
        }
      } catch (error) {
        showAlert('Error archiving policy', 'error');
        console.error(error);
      }
    }
    
    // Check for URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success')) {
      showAlert(urlParams.get('success'), 'success');
    }
    if (urlParams.get('error')) {
      showAlert(urlParams.get('error'), 'error');
    }
  </script>
</body>
</html>
