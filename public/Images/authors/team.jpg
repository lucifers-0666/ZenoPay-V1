<svg width="200" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="teamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="100" fill="url(#teamGrad)"/>
  <g fill="white" opacity="0.9">
    <circle cx="70" cy="75" r="15"/>
    <ellipse cx="70" cy="110" rx="20" ry="18"/>
    <circle cx="130" cy="75" r="15"/>
    <ellipse cx="130" cy="110" rx="20" ry="18"/>
    <circle cx="100" cy="85" r="12"/>
    <ellipse cx="100" cy="115" rx="18" ry="15"/>
  </g>
  <text x="50%" y="90%" font-family="Arial" font-size="14" font-weight="bold" fill="white" text-anchor="middle">
    Editorial Team
  </text>
</svg>
