<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ZenoPay helps modern businesses accept payments globally, get paid instantly, and manage collections with enterprise-grade security.">
  <title><%= pageTitle || 'ZenoPay | Accept Payments Globally' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="landing-page">
    <!-- HERO -->
    <section class="zeno-hero" aria-labelledby="hero-title">
      <div class="zeno-hero__bg">
        <span class="zeno-hero__mesh"></span>
        <span class="zeno-hero__orb zeno-hero__orb--blue"></span>
        <span class="zeno-hero__orb zeno-hero__orb--purple"></span>
        <span class="zeno-hero__orb zeno-hero__orb--cyan"></span>
      </div>

      <div class="container zeno-hero__grid">
        <div class="zeno-hero__content">
          <div class="hero-kicker">
            <i class="fas fa-shield-heart"></i>
            <span>Trusted fintech infrastructure for modern businesses</span>
          </div>

          <h1 id="hero-title" class="zeno-hero__title">Accept Payments Globally. Get Paid Instantly.</h1>
          <p class="zeno-hero__subtitle">Fast, secure, enterprise-grade payment infrastructure for Indian and global businesses that need stronger conversion, cleaner operations, and reliable scale.</p>

          <p class="zeno-hero__microtrust">No setup fee · Fast onboarding · 99.9% uptime · Built for scale</p>

          <div class="hero-actions" aria-label="Primary actions">
            <a class="btn btn--primary" href="/register">
              <i class="fas fa-bolt"></i>
              <span>Start Free</span>
            </a>
            <a class="btn btn--ghost" href="/contact">
              <i class="fas fa-play-circle"></i>
              <span>Book Demo</span>
            </a>
          </div>

          <div class="hero-badges" aria-label="Trust badges">
            <span class="trust-badge"><i class="fas fa-check-circle"></i> PCI DSS</span>
            <span class="trust-badge"><i class="fas fa-check-circle"></i> RBI-ready messaging</span>
            <span class="trust-badge"><i class="fas fa-check-circle"></i> 10,000+ businesses</span>
            <span class="trust-badge"><i class="fas fa-check-circle"></i> 24/7 support</span>
          </div>
        </div>

        <div class="zeno-hero__visual" aria-hidden="true">
          <div class="hero-card hero-card--primary">
            <div class="hero-card__top">
              <div>
                <p class="hero-card__eyebrow">Live dashboard</p>
                <h2 class="hero-card__title">Payments moving now</h2>
              </div>
              <div class="hero-live-pill"><span></span> Live</div>
            </div>

            <div class="hero-metrics">
              <div class="hero-metric">
                <span class="hero-metric__label">Today’s volume</span>
                <strong>₹24.8L</strong>
                <small class="is-positive"><i class="fas fa-arrow-up"></i> 12.4%</small>
              </div>
              <div class="hero-metric">
                <span class="hero-metric__label">Success rate</span>
                <strong>99.92%</strong>
                <small class="is-positive"><i class="fas fa-arrow-up"></i> 0.3%</small>
              </div>
            </div>

            <div class="hero-chart" aria-label="Payment activity chart">
              <span style="height:38%"></span>
              <span style="height:56%"></span>
              <span style="height:44%"></span>
              <span style="height:72%"></span>
              <span style="height:61%"></span>
              <span style="height:88%"></span>
              <span style="height:74%" class="is-active"></span>
            </div>

            <div class="hero-transactions">
              <div class="hero-transaction">
                <div class="hero-avatar hero-avatar--blue">A</div>
                <div>
                  <strong>Arjun Retail</strong>
                  <span>Payment received · 2 min ago</span>
                </div>
                <b class="is-positive">+₹5,200</b>
              </div>
              <div class="hero-transaction">
                <div class="hero-avatar hero-avatar--green">S</div>
                <div>
                  <strong>Secure settlement</strong>
                  <span>Settlement in progress</span>
                </div>
                <b>In flight</b>
              </div>
              <div class="hero-transaction">
                <div class="hero-avatar hero-avatar--purple">U</div>
                <div>
                  <strong>UPI / Card / Netbanking</strong>
                  <span>Multi-rail checkout support</span>
                </div>
                <b>Ready</b>
              </div>
            </div>
          </div>

          <div class="hero-float hero-float--left">
            <i class="fas fa-shield-halved"></i>
            <span>Bank-grade security</span>
          </div>
          <div class="hero-float hero-float--right">
            <i class="fas fa-globe"></i>
            <span>Global-ready collections</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROOF STRIP -->
    <section class="proof-strip" aria-labelledby="proof-title">
      <div class="container">
        <div class="section-kicker">Proof that scales with you</div>
        <h2 id="proof-title" class="section-title section-title--center">Trusted by businesses that need clarity, reliability, and speed</h2>
        <div class="proof-grid">
          <article class="proof-card">
            <strong class="proof-card__value" data-count="10000">10,000+</strong>
            <span class="proof-card__label">Businesses onboarded</span>
          </article>
          <article class="proof-card">
            <strong class="proof-card__value" data-count="500">₹500Cr+</strong>
            <span class="proof-card__label">Annual payment volume</span>
          </article>
          <article class="proof-card">
            <strong class="proof-card__value" data-count="99.9">99.9%</strong>
            <span class="proof-card__label">Platform uptime</span>
          </article>
          <article class="proof-card">
            <strong class="proof-card__value" data-count="150">150+</strong>
            <span class="proof-card__label">Payment flows supported</span>
          </article>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features-section" aria-labelledby="features-title">
      <div class="container">
        <div class="section-header">
          <div class="section-kicker">Why choose ZenoPay</div>
          <h2 id="features-title" class="section-title">Designed for modern businesses that need speed, clarity, and trust</h2>
          <p class="section-subtitle">Built to reduce checkout friction, improve visibility, and keep operations calm under pressure.</p>
        </div>

        <div class="feature-grid feature-grid--primary">
          <article class="feature-card feature-card--large">
            <i class="feature-card__icon fas fa-bolt"></i>
            <h3>Instant Transfers</h3>
            <p>Move money quickly with payment rails that support fast settlements and a cleaner cash cycle.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
          <article class="feature-card feature-card--large">
            <i class="feature-card__icon fas fa-shield-halved"></i>
            <h3>Bank-grade Security</h3>
            <p>Keep every transaction protected with layered controls, monitoring, and compliance-minded architecture.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
          <article class="feature-card feature-card--large">
            <i class="feature-card__icon fas fa-chart-line"></i>
            <h3>Smart Analytics</h3>
            <p>Understand success rates, settlements, and payment mix with dashboards that are actually useful.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
        </div>

        <div class="feature-grid feature-grid--secondary">
          <article class="feature-card">
            <i class="feature-card__icon fas fa-receipt"></i>
            <h3>Multi-rail Payments</h3>
            <p>UPI, cards, netbanking, wallets, and international flows in one platform.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
          <article class="feature-card">
            <i class="feature-card__icon fas fa-tags"></i>
            <h3>Zero Hidden Fees</h3>
            <p>Transparent pricing that makes finance teams and founders equally comfortable.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
          <article class="feature-card">
            <i class="feature-card__icon fas fa-headset"></i>
            <h3>24/7 Support</h3>
            <p>Get responsive help from a team that understands what downtime costs.</p>
            <a href="/contact">Learn more <i class="fas fa-arrow-right"></i></a>
          </article>
        </div>
      </div>
    </section>

    <!-- PAYMENT METHODS -->
    <section class="payments-section" aria-labelledby="payments-title">
      <div class="container payments-grid">
        <div class="payments-copy">
          <div class="section-kicker">Payment methods</div>
          <h2 id="payments-title" class="section-title">Accept payments the way your customers prefer</h2>
          <p class="section-subtitle">From UPI and cards to net banking and wallets — give every customer a checkout experience that feels familiar and friction-light.</p>

          <div class="payments-points">
            <div><i class="fas fa-circle-check"></i><span>2.3 Cr+ monthly transactions processed</span></div>
            <div><i class="fas fa-circle-check"></i><span>Higher conversion across local and global payment rails</span></div>
            <div><i class="fas fa-circle-check"></i><span>Easy checkout orchestration with one unified flow</span></div>
          </div>

          <div class="payment-tabs" role="tablist" aria-label="Supported payment methods">
            <button class="payment-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="payment-panel-upi" data-payment-tab="upi">UPI</button>
            <button class="payment-tab" type="button" role="tab" aria-selected="false" aria-controls="payment-panel-cards" data-payment-tab="cards">Cards</button>
            <button class="payment-tab" type="button" role="tab" aria-selected="false" aria-controls="payment-panel-netbanking" data-payment-tab="netbanking">Net Banking</button>
            <button class="payment-tab" type="button" role="tab" aria-selected="false" aria-controls="payment-panel-wallets" data-payment-tab="wallets">Wallets</button>
            <button class="payment-tab" type="button" role="tab" aria-selected="false" aria-controls="payment-panel-international" data-payment-tab="international">International</button>
          </div>

          <div class="payment-brand-row" aria-label="Accepted brands">
            <span>UPI</span><span>Visa</span><span>Mastercard</span><span>RuPay</span><span>NetBanking</span><span>Wallets</span>
          </div>
        </div>

        <div class="payments-panel-wrap">
          <div class="payment-panel is-active" id="payment-panel-upi" role="tabpanel">
            <div class="mock-checkout">
              <div class="mock-checkout__top">
                <span>Checkout preview</span>
                <strong>UPI</strong>
              </div>
              <div class="mock-checkout__body">
                <div class="mock-checkout__merchant">
                  <div class="mock-dot mock-dot--blue"></div>
                  <div>
                    <strong>ZenoPay Store</strong>
                    <span>Secure UPI collect request</span>
                  </div>
                </div>
                <div class="mock-checkout__amount">
                  <span>Amount</span>
                  <strong>₹4,999.00</strong>
                </div>
                <div class="mock-checkout__rail">PhonePe · GPay · Paytm · BHIM</div>
                <button class="mock-checkout__cta" type="button">Pay securely</button>
              </div>
            </div>
          </div>

          <div class="payment-panel" id="payment-panel-cards" role="tabpanel" hidden>
            <div class="mock-checkout mock-checkout--card">
              <div class="mock-checkout__top">
                <span>Checkout preview</span>
                <strong>Cards</strong>
              </div>
              <div class="card-stack">
                <div class="card-stack__card card-stack__card--front">
                  <span class="card-chip"></span>
                  <strong>•••• 4821</strong>
                  <small>Visa · Debit</small>
                </div>
                <div class="card-stack__card card-stack__card--back">
                  <span>Saved cards</span>
                  <strong>Fast repeat checkout</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="payment-panel" id="payment-panel-netbanking" role="tabpanel" hidden>
            <div class="mock-checkout mock-checkout--list">
              <div class="mock-checkout__top">
                <span>Checkout preview</span>
                <strong>Net Banking</strong>
              </div>
              <ul class="bank-list">
                <li>HDFC Bank</li>
                <li>ICICI Bank</li>
                <li>SBI</li>
                <li>Kotak</li>
              </ul>
            </div>
          </div>

          <div class="payment-panel" id="payment-panel-wallets" role="tabpanel" hidden>
            <div class="mock-checkout mock-checkout--wallets">
              <div class="mock-checkout__top">
                <span>Checkout preview</span>
                <strong>Wallets</strong>
              </div>
              <div class="wallet-grid">
                <span>Paytm</span>
                <span>Amazon Pay</span>
                <span>MobiKwik</span>
                <span>PhonePe</span>
              </div>
            </div>
          </div>

          <div class="payment-panel" id="payment-panel-international" role="tabpanel" hidden>
            <div class="mock-checkout mock-checkout--intl">
              <div class="mock-checkout__top">
                <span>Checkout preview</span>
                <strong>International</strong>
              </div>
              <div class="intl-rail">
                <div><strong>USD</strong><span>Visa / Mastercard</span></div>
                <div><strong>EUR</strong><span>Multi-currency settlement</span></div>
                <div><strong>GBP</strong><span>Global customer support</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIRTUAL ACCOUNT -->
    <section class="virtual-section" aria-labelledby="virtual-title">
      <div class="container virtual-grid">
        <div class="virtual-copy">
          <div class="section-kicker">Virtual account collections</div>
          <h2 id="virtual-title" class="section-title">Your business gets a dedicated virtual bank account</h2>
          <p class="section-subtitle">Turn collections into a cleaner operational process with reconciliation that is easier to track, faster to close, and friendlier for finance teams.</p>

          <ul class="benefit-list">
            <li><i class="fas fa-circle-check"></i><span>Automated reconciliation across invoices and payers</span></li>
            <li><i class="fas fa-circle-check"></i><span>Faster settlements and better cash visibility</span></li>
            <li><i class="fas fa-circle-check"></i><span>Easier collections for subscriptions and enterprise billing</span></li>
            <li><i class="fas fa-circle-check"></i><span>Better transaction tracking with named references</span></li>
          </ul>

          <div class="inline-cta-group">
            <a href="/contact" class="btn btn--primary btn--small">Explore Business Accounts</a>
            <a href="/contact" class="text-link">See sample flow <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>

        <div class="virtual-visual">
          <div class="virtual-card">
            <div class="virtual-card__header">
              <div>
                <span class="virtual-card__label">Dedicated account</span>
                <strong>ZP-VA-42891</strong>
              </div>
              <span class="virtual-card__status">Active</span>
            </div>
            <div class="virtual-card__body">
              <div class="virtual-card__number">
                <span>Collections received</span>
                <strong>₹18,42,500</strong>
              </div>
              <div class="virtual-ledger">
                <div><span>Invoice #1042</span><b>₹2,500</b></div>
                <div><span>Invoice #1043</span><b>₹7,900</b></div>
                <div><span>Refund reserve</span><b>₹1,250</b></div>
              </div>
              <div class="virtual-card__footer">
                <span><i class="fas fa-lock"></i> Secure routing</span>
                <span><i class="fas fa-clock"></i> Instant updates</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEVELOPER INTEGRATION -->
    <section class="developer-section" aria-labelledby="developer-title">
      <div class="container developer-grid">
        <div class="developer-copy">
          <div class="section-kicker section-kicker--light">Developer integration</div>
          <h2 id="developer-title" class="section-title section-title--light">Integrate in minutes, not days</h2>
          <p class="section-subtitle section-subtitle--light">Clean REST APIs, webhooks, sandbox tools, and production-ready flows that fit into modern engineering teams without friction.</p>

          <div class="developer-checklist">
            <div><i class="fas fa-circle-check"></i><span>Clean REST APIs</span></div>
            <div><i class="fas fa-circle-check"></i><span>Webhooks for every critical event</span></div>
            <div><i class="fas fa-circle-check"></i><span>Sandbox + production support</span></div>
          </div>
        </div>

        <div class="developer-console" data-code-console>
          <div class="developer-console__bar">
            <div class="developer-tabs" role="tablist" aria-label="Code samples">
              <button class="developer-tab is-active" type="button" data-code-tab="node" aria-selected="true">Node.js</button>
              <button class="developer-tab" type="button" data-code-tab="python" aria-selected="false">Python</button>
              <button class="developer-tab" type="button" data-code-tab="php" aria-selected="false">PHP</button>
              <button class="developer-tab" type="button" data-code-tab="curl" aria-selected="false">cURL</button>
            </div>
            <button class="copy-btn" type="button" data-copy-code>
              <i class="fas fa-copy"></i>
              <span>Copy</span>
            </button>
          </div>

          <div class="developer-code is-active" data-code-panel="node">
<pre><code>const response = await fetch('https://api.zenopay.com/v1/payments', {
  method: 'POST',
  headers: {
    'Authorization': `Bearer ${process.env.ZENOPAY_KEY}`,
    'Content-Type': 'application/json'
  },
  body: JSON.stringify({
    amount: 4999,
    currency: 'INR',
    payment_method: 'upi'
  })
});</code></pre>
          </div>

          <div class="developer-code" data-code-panel="python" hidden>
<pre><code>import requests

response = requests.post(
    'https://api.zenopay.com/v1/payments',
    headers={'Authorization': f'Bearer {ZENOPAY_KEY}'},
    json={'amount': 4999, 'currency': 'INR', 'payment_method': 'upi'}
)</code></pre>
          </div>

          <div class="developer-code" data-code-panel="php" hidden>
<pre><code>&lt;?php
$payload = json_encode(['amount' =&gt; 4999, 'currency' =&gt; 'INR', 'payment_method' =&gt; 'upi']);
// Post to /v1/payments with your API key and webhook signing secret.
?&gt;</code></pre>
          </div>

          <div class="developer-code" data-code-panel="curl" hidden>
<pre><code>curl -X POST https://api.zenopay.com/v1/payments \
  -H 'Authorization: Bearer $ZENOPAY_KEY' \
  -H 'Content-Type: application/json' \
  -d '{"amount":4999,"currency":"INR","payment_method":"upi"}'</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- SECURITY -->
    <section class="security-section" aria-labelledby="security-title">
      <div class="container">
        <div class="section-header section-header--light">
          <div class="section-kicker section-kicker--light">Security & compliance</div>
          <h2 id="security-title" class="section-title section-title--light">Bank-grade security you can trust</h2>
          <p class="section-subtitle section-subtitle--light">Encryption, compliance-ready messaging, fraud defense, and operational safeguards that help visitors feel confident before they convert.</p>
        </div>

        <div class="security-grid security-grid--certs">
          <article class="security-card"><i class="fas fa-shield-halved"></i><h3>PCI DSS</h3><p>Payment data handling aligned with industry expectations.</p></article>
          <article class="security-card"><i class="fas fa-building-columns"></i><h3>RBI-ready</h3><p>Messaging and operational posture designed for Indian payments.</p></article>
          <article class="security-card"><i class="fas fa-certificate"></i><h3>ISO 27001</h3><p>Security management practices that scale with the business.</p></article>
          <article class="security-card"><i class="fas fa-globe"></i><h3>GDPR ready</h3><p>Privacy-conscious treatment of customer and transaction data.</p></article>
          <article class="security-card"><i class="fas fa-circle-nodes"></i><h3>NPCI / UPI compatibility</h3><p>Built for high-trust domestic payment flows where applicable.</p></article>
        </div>

        <div class="security-grid security-grid--capabilities">
          <article class="security-card security-card--soft"><i class="fas fa-lock"></i><h3>256-bit SSL encryption</h3><p>Secure traffic and session protection across the platform.</p></article>
          <article class="security-card security-card--soft"><i class="fas fa-eye"></i><h3>24/7 fraud monitoring</h3><p>Continuous monitoring for unusual behavior and suspicious patterns.</p></article>
          <article class="security-card security-card--soft"><i class="fas fa-user-check"></i><h3>3D Secure authentication</h3><p>Extra verification layers for safer card payments.</p></article>
          <article class="security-card security-card--soft"><i class="fas fa-database"></i><h3>No card data stored</h3><p>Minimize exposure by avoiding unnecessary sensitive storage.</p></article>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-header">
          <div class="section-kicker">Pricing</div>
          <h2 id="pricing-title" class="section-title">Transparent plans that help teams move faster</h2>
          <p class="section-subtitle">Simple pricing, featured growth plan, and a comparison matrix to make the decision obvious.</p>
        </div>

        <div class="billing-switch" role="tablist" aria-label="Billing period">
          <button class="billing-switch__btn is-active" type="button" data-billing="monthly" aria-selected="true">Monthly</button>
          <button class="billing-switch__btn" type="button" data-billing="annual" aria-selected="false">Annual</button>
        </div>

        <div class="pricing-grid">
          <article class="pricing-card">
            <span class="pricing-card__label">Starter</span>
            <div class="pricing-card__price"><sup>₹</sup><strong data-price-monthly="2499" data-price-annual="24990">2,499</strong><span data-price-suffix>/mo</span></div>
            <p>For teams validating payment operations and launch readiness.</p>
            <ul>
              <li>Core payment methods</li>
              <li>Basic analytics</li>
              <li>Email support</li>
            </ul>
            <a href="/register" class="pricing-card__cta">Start free</a>
          </article>

          <article class="pricing-card pricing-card--featured">
            <span class="pricing-card__popular">Most Popular</span>
            <span class="pricing-card__label">Growth</span>
            <div class="pricing-card__price"><sup>₹</sup><strong data-price-monthly="6999" data-price-annual="69990">6,999</strong><span data-price-suffix>/mo</span></div>
            <p>For scaling businesses that need better visibility and support.</p>
            <ul>
              <li>All payment methods</li>
              <li>Advanced analytics</li>
              <li>Priority onboarding</li>
            </ul>
            <a href="/contact" class="pricing-card__cta pricing-card__cta--featured">Talk to sales</a>
          </article>

          <article class="pricing-card">
            <span class="pricing-card__label">Enterprise</span>
            <div class="pricing-card__price pricing-card__price--custom"><strong>Custom</strong></div>
            <p>For high-volume businesses with custom security and support needs.</p>
            <ul>
              <li>Custom settlement support</li>
              <li>Dedicated implementation</li>
              <li>Account manager</li>
            </ul>
            <a href="/contact" class="pricing-card__cta">Request quote</a>
          </article>
        </div>

        <div class="pricing-matrix" aria-label="Plan comparison matrix">
          <div class="pricing-matrix__row pricing-matrix__row--head">
            <span>Feature</span>
            <span>Starter</span>
            <span>Growth</span>
