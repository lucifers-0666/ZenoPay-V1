<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="About ZenoPay - building secure, transparent payment infrastructure for Indian businesses.">
  <title><%= pageTitle || 'About ZenoPay' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body>
  <%- include('partials/header') %>

  <main class="about-page">
    <section class="about-hero-v2" aria-labelledby="hero-title">
      <div class="container hero-v2-inner">
        <div class="hero-v2-left" data-animate>
          <span class="hero-v2-badge">About ZenoPay</span>
          <h1 id="hero-title" class="hero-v2-title">Payment infrastructure built for businesses that need clarity, control, and scale.</h1>
          <p class="hero-v2-sub">
            ZenoPay builds secure, transparent, and scalable payment infrastructure for Indian businesses that want cleaner collections, faster visibility, and steadier growth.
          </p>

          <div class="hero-v2-actions">
            <a class="btn-v2-primary" href="/register"><i data-lucide="zap"></i><span>Start Free</span></a>
            <a class="btn-v2-ghost" href="/contact"><i data-lucide="message-square"></i><span>Contact Us</span></a>
          </div>

          <div class="hero-v2-trust" aria-label="Trust markers">
            <span class="trust-chip"><i data-lucide="shield-check"></i> Secure by design</span>
            <span class="trust-chip"><i data-lucide="landmark"></i> Built for India</span>
            <span class="trust-chip"><i data-lucide="code"></i> API-first operations</span>
          </div>
        </div>

        <div class="hero-v2-right" data-animate>
          <article class="hero-visual-card" aria-label="ZenoPay platform snapshot">
            <div class="hvc-header">
              <div class="hvc-brand-wrap">
                <img src="/Images/bgFavicon.png" alt="ZenoPay" class="hvc-logo">
                <div>
                  <div class="hvc-brand">ZenoPay Dashboard</div>
                  <div class="hvc-tagline">Calm operations for modern payment teams</div>
                </div>
              </div>
              <span class="hvc-live-badge"><span class="hvc-live-dot"></span> Live</span>
            </div>

            <div class="hvc-stats-grid">
              <div class="hvc-stat">
                <span class="hvc-stat-key">Settlement status</span>
                <span class="hvc-stat-val">On track</span>
              </div>
              <div class="hvc-stat">
                <span class="hvc-stat-key">Daily visibility</span>
                <span class="hvc-stat-val">Real-time</span>
              </div>
              <div class="hvc-stat">
                <span class="hvc-stat-key">Merchant support</span>
                <span class="hvc-stat-val">24/7 ops</span>
              </div>
              <div class="hvc-stat">
                <span class="hvc-stat-key">Core rails</span>
                <span class="hvc-stat-val">UPI, cards, net banking</span>
              </div>
            </div>

            <div class="hvc-flow">
              <div class="hvc-flow-head">
                <span class="hvc-flow-label">Platform overview</span>
                <span class="hvc-flow-meta">Today</span>
              </div>
              <div class="hvc-chart" aria-hidden="true">
                <span class="hvc-chart-bar" style="height: 34%"></span>
                <span class="hvc-chart-bar" style="height: 48%"></span>
                <span class="hvc-chart-bar" style="height: 56%"></span>
                <span class="hvc-chart-bar hvc-chart-bar--active" style="height: 78%"></span>
                <span class="hvc-chart-bar" style="height: 62%"></span>
                <span class="hvc-chart-bar" style="height: 84%"></span>
              </div>
            </div>

            <div class="hvc-txn-list" aria-label="Sample activity">
              <div class="hvc-txn">
                <div class="hvc-txn-avatar">AR</div>
                <div class="hvc-txn-info">
                  <span class="hvc-txn-name">Arjun Retail</span>
                  <span class="hvc-txn-time">Collections settled with reconciliation status attached</span>
                </div>
                <span class="hvc-txn-amt">INR 5,200</span>
              </div>
              <div class="hvc-txn">
                <div class="hvc-txn-avatar hvc-txn-avatar--green">OP</div>
                <div class="hvc-txn-info">
                  <span class="hvc-txn-name">Ops routing</span>
                  <span class="hvc-txn-time">Monitoring active across payment flows</span>
                </div>
                <span class="hvc-txn-amt">Stable</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="story-v2" id="story" aria-labelledby="story-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">Our story</span>
          <h2 class="section-title" id="story-title">How ZenoPay began</h2>
          <p class="section-description">
            A fintech story shaped by merchant pain points, practical product decisions, and the need to make money movement easier to trust.
          </p>
        </div>

        <div class="story-v2-grid">
          <div class="story-v2-timeline" data-animate>
            <article class="sv2-tl-item">
              <span class="sv2-tl-dot"></span>
              <div class="sv2-tl-content">
                <span class="sv2-tl-year">2024</span>
                <h3 class="sv2-tl-title">The problem became clear</h3>
                <p class="sv2-tl-text">Businesses needed faster onboarding, better settlement visibility, and less operational confusion.</p>
              </div>
            </article>
            <article class="sv2-tl-item">
              <span class="sv2-tl-dot"></span>
              <div class="sv2-tl-content">
                <span class="sv2-tl-year">2024</span>
                <h3 class="sv2-tl-title">Merchant discovery shaped the product</h3>
                <p class="sv2-tl-text">Early conversations informed the first onboarding, dashboard, and collections experience.</p>
              </div>
            </article>
            <article class="sv2-tl-item">
              <span class="sv2-tl-dot"></span>
              <div class="sv2-tl-content">
                <span class="sv2-tl-year">2025</span>
                <h3 class="sv2-tl-title">Infrastructure moved into production</h3>
                <p class="sv2-tl-text">The platform matured around secure rails, reporting discipline, and operational reliability.</p>
              </div>
            </article>
          </div>

          <div class="story-v2-text" data-animate>
            <p>ZenoPay was founded in 2024 by Zaid Amreliya and Ashok Sah with one belief: businesses in India deserve payment infrastructure that is fast, secure, and easy to understand.</p>
            <p>The idea came from seeing how difficult payment operations could become for growing teams. High fees, delayed settlements, and poor visibility turned payments into friction instead of an advantage.</p>
            <p>Zaid focused on strategy, partnerships, and user experience while Ashok built the technical foundation. Together, they formed a lean team in Ahmedabad and started building a product around trust and usability.</p>
            <p>Today, ZenoPay supports businesses that want simpler money movement, clearer reporting, and a platform that can grow with them.</p>

            <div class="story-v2-actions">
              <a class="btn-v2-primary" href="/contact"><i data-lucide="calendar-days"></i><span>Talk to the team</span></a>
              <a class="btn-v2-ghost" href="#team"><i data-lucide="users"></i><span>Meet the people</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mission-vision-section" aria-labelledby="mission-vision-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">Mission and vision</span>
          <h2 class="section-title" id="mission-vision-title">Focused on simpler payments and stronger operating trust</h2>
          <p class="section-description">Two ideas guide the product: reduce payment friction now, and build the long-term rails businesses can depend on.</p>
        </div>

        <div class="mission-vision-grid">
          <article class="mv-card" data-animate>
            <div class="mv-icon-wrapper"><i data-lucide="target"></i></div>
            <h3 class="mv-title">Our mission</h3>
            <p class="mv-text">To make payment infrastructure simple, secure, and predictable for Indian businesses so teams spend less time managing friction and more time building momentum.</p>
            <a href="/contact" class="mv-link">See how we work <i data-lucide="arrow-right"></i></a>
          </article>

          <article class="mv-card" data-animate>
            <div class="mv-icon-wrapper"><i data-lucide="eye"></i></div>
            <h3 class="mv-title">Our vision</h3>
            <p class="mv-text">To become a trusted infrastructure layer for the next generation of Indian commerce, combining product discipline, operational transparency, and scale-ready systems.</p>
            <a href="/register" class="mv-link">Build with ZenoPay <i data-lucide="arrow-right"></i></a>
          </article>
        </div>
      </div>
    </section>

    <section class="values-section" aria-labelledby="values-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">Core values</span>
          <h2 class="section-title" id="values-title">The standards behind the product</h2>
          <p class="section-description">Six principles shape product decisions, service quality, and the way we think about security and scale.</p>
        </div>

        <div class="values-grid">
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="shield-check"></i></div>
            <h3 class="value-title">Trust</h3>
            <p class="value-description">Reliability, clear reporting, and secure operations are treated as baseline expectations.</p>
          </article>
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="sparkles"></i></div>
            <h3 class="value-title">Innovation</h3>
            <p class="value-description">We improve the platform with practical ideas that remove operational friction for real businesses.</p>
          </article>
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="zap"></i></div>
            <h3 class="value-title">Speed</h3>
            <p class="value-description">Fast onboarding and fast visibility help finance and operations teams move with confidence.</p>
          </article>
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="eye"></i></div>
            <h3 class="value-title">Transparency</h3>
            <p class="value-description">Straightforward pricing, clear status updates, and understandable interfaces keep decisions grounded.</p>
          </article>
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="users"></i></div>
            <h3 class="value-title">Customer focus</h3>
            <p class="value-description">Merchant and operator feedback stays close to the roadmap, not separated from it.</p>
          </article>
          <article class="value-card" data-animate>
            <div class="value-icon"><i data-lucide="layout-grid"></i></div>
            <h3 class="value-title">Simplicity</h3>
            <p class="value-description">The best fintech UX removes complexity without hiding important controls or context.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="stats-section" aria-labelledby="stats-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">By the numbers</span>
          <h2 class="section-title" id="stats-title">A concise view of scale and reliability</h2>
          <p class="section-description">A stronger platform shows up in volume, consistency, visibility, and operational discipline.</p>
        </div>

        <div class="stats-grid">
          <article class="stat-card" data-animate>
            <span class="stat-number" data-target="10" data-suffix="M+" data-counted="false">0</span>
            <span class="stat-label">Payment volume supported</span>
          </article>
          <article class="stat-card" data-animate>
            <span class="stat-number" data-target="50000" data-counted="false">0</span>
            <span class="stat-label">Transactions processed</span>
          </article>
          <article class="stat-card" data-animate>
            <span class="stat-number" data-target="99.9" data-suffix="%" data-counted="false">0</span>
            <span class="stat-label">Platform uptime target</span>
          </article>
          <article class="stat-card" data-animate>
            <span class="stat-number" data-target="24" data-suffix="/7" data-counted="false">0</span>
            <span class="stat-label">Operations visibility</span>
          </article>
        </div>
      </div>
    </section>

    <section class="team-section" id="team" aria-labelledby="team-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">Team</span>
          <h2 class="section-title" id="team-title">The people building ZenoPay</h2>
          <p class="section-description">A founder-led company supported by a compact team across product, engineering, security, and growth.</p>
        </div>

        <div class="founders-section">
          <h3 class="subsection-title" data-animate>Founders</h3>
          <div class="founders-grid">
            <article class="founder-card" data-animate>
              <div class="founder-card-top">
                <div class="founder-avatar">
                  <img src="/Images/team/zaid-amreliya.jpg" alt="Zaid Amreliya" loading="lazy" onerror="this.style.display='none'">
                </div>
                <div class="founder-meta">
                  <h4 class="founder-name">Zaid Amreliya</h4>
                  <p class="founder-role">CEO</p>
                </div>
              </div>
              <p class="founder-bio">Leads business strategy, partnerships, and the user experience direction behind ZenoPay's merchant and finance workflows.</p>
              <div class="founder-badge"><i data-lucide="rocket"></i><span>Product and business leadership</span></div>
              <div class="founder-links">
                <a href="#" aria-label="Zaid Amreliya on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" aria-label="Zaid Amreliya on X"><i class="fab fa-x-twitter"></i></a>
              </div>
            </article>

            <article class="founder-card" data-animate>
              <div class="founder-card-top">
                <div class="founder-avatar">
                  <img src="/Images/team/ashokimg.jpg" alt="Ashok Sah" loading="lazy" onerror="this.style.display='none'">
                </div>
                <div class="founder-meta">
                  <h4 class="founder-name">Ashok Sah</h4>
                  <p class="founder-role">CTO</p>
                </div>
              </div>
              <p class="founder-bio">Owns the infrastructure and engineering strategy that keeps payments reliable, secure, and easier to operate at scale.</p>
              <div class="founder-badge"><i data-lucide="code"></i><span>Platform and architecture leadership</span></div>
              <div class="founder-links">
                <a href="#" aria-label="Ashok Sah on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" aria-label="Ashok Sah on X"><i class="fab fa-x-twitter"></i></a>
              </div>
            </article>
          </div>
        </div>

        <div class="team-section-core">
          <h3 class="subsection-title" data-animate>Core team</h3>
          <div class="team-grid">
            <article class="team-card" data-animate>
              <div class="team-avatar">
                <img src="/Images/team/rohan-mehta.jpg" alt="Rohan Mehta" loading="lazy" onerror="this.style.display='none'">
              </div>
              <h4 class="team-name">Rohan Mehta</h4>
              <p class="team-role">Head of Product</p>
              <p class="team-bio">Works on platform UX, payment operations flows, and product discipline across merchant journeys.</p>
            </article>

            <article class="team-card" data-animate>
              <div class="team-avatar">
                <img src="/Images/team/priya-iyer.jpg" alt="Priya Iyer" loading="lazy" onerror="this.style.display='none'">
              </div>
              <h4 class="team-name">Priya Iyer</h4>
              <p class="team-role">Head of Engineering</p>
              <p class="team-bio">Leads engineering execution with a focus on stability, scalability, and platform maintainability.</p>
            </article>

            <article class="team-card" data-animate>
              <div class="team-avatar">
                <img src="/Images/team/neha-joshi.jpg" alt="Neha Joshi" loading="lazy" onerror="this.style.display='none'">
              </div>
              <h4 class="team-name">Neha Joshi</h4>
              <p class="team-role">Head of Security</p>
              <p class="team-bio">Oversees controls, audit readiness, and the security practices that underpin merchant trust.</p>
            </article>

            <article class="team-card" data-animate>
              <div class="team-avatar">
                <img src="/Images/team/arjun-kapoor.jpg" alt="Arjun Kapoor" loading="lazy" onerror="this.style.display='none'">
              </div>
              <h4 class="team-name">Arjun Kapoor</h4>
              <p class="team-role">Head of Growth</p>
              <p class="team-bio">Focuses on merchant growth, go-to-market execution, and scaling the right operating channels.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="achievements-section">
      <div class="container">
        <div class="section-header-center">
          <span class="section-label">Milestones</span>
          <h2 class="section-title">Six milestones on the path to scale</h2>
          <p class="section-description">
            The journey from idea to infrastructure, shaped by speed, trust, and product discipline.
          </p>
        </div>

        <div class="timeline">
          <article class="timeline-item timeline-left">
            <div class="timeline-card">
              <span class="timeline-year">Q1 2024</span>
              <div class="timeline-icon"><i class="fas fa-lightbulb"></i></div>
              <h3 class="timeline-title">The idea took shape</h3>
              <p class="timeline-description">ZenoPay started after identifying major gaps in merchant onboarding, payout visibility, and settlement trust.</p>
            </div>
            <div class="timeline-marker"><span class="marker-dot"></span></div>
          </article>

          <article class="timeline-item timeline-right">
            <div class="timeline-marker"><span class="marker-dot"></span></div>
            <div class="timeline-card">
              <span class="timeline-year">Q2 2024</span>
              <div class="timeline-icon"><i class="fas fa-store"></i></div>
              <h3 class="timeline-title">Merchant discovery sprint</h3>
              <p class="timeline-description">Early merchant conversations shaped the first onboarding, dashboard, and settlements experience.</p>
            </div>
          </article>

          <article class="timeline-item timeline-left">
            <div class="timeline-card">
              <span class="timeline-year">Q3 2024</span>
              <div class="timeline-icon"><i class="fas fa-bolt"></i></div>
              <h3 class="timeline-title">Gateway infrastructure launched</h3>
              <p class="timeline-description">UPI, cards, and core payment flows went live with the first real merchant traffic and internal ops tooling.</p>
            </div>
            <div class="timeline-marker"><span class="marker-dot"></span></div>
          </article>

          <article class="timeline-item timeline-right">
            <div class="timeline-marker"><span class="marker-dot"></span></div>
            <div class="timeline-card">
              <span class="timeline-year">Q4 2024</span>
              <div class="timeline-icon"><i class="fas fa-chart-line"></i></div>
              <h3 class="timeline-title">Reporting and scale systems matured</h3>
              <p class="timeline-description">Analytics, reconciliation, exports, and operational dashboards became reliable for daily business use.</p>
            </div>
          </article>

          <article class="timeline-item timeline-left">
            <div class="timeline-card">
              <span class="timeline-year">Q1 2025</span>
              <div class="timeline-icon"><i class="fas fa-shield-alt"></i></div>
              <h3 class="timeline-title">Security and compliance expanded</h3>
              <p class="timeline-description">Security hardening, audit readiness, and compliance-first engineering became core product requirements.</p>
            </div>
            <div class="timeline-marker"><span class="marker-dot"></span></div>
          </article>

          <article class="timeline-item timeline-right">
            <div class="timeline-marker"><span class="marker-dot"></span></div>
            <div class="timeline-card">
              <span class="timeline-year">Q2 2025</span>
              <div class="timeline-icon"><i class="fas fa-globe"></i></div>
              <h3 class="timeline-title">Built for the next phase of growth</h3>
              <p class="timeline-description">ZenoPay evolved from an idea into a scalable payment platform with stronger product foundations and broader ambitions.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="partners-section" aria-labelledby="certifications-title">
      <div class="container">
        <div class="section-header-center" data-animate>
          <span class="section-label">Trust and compliance</span>
          <h2 class="section-title" id="certifications-title">Signals that help businesses trust the platform</h2>
          <p class="section-description">Security, governance, and operational readiness need to feel visible, not buried in a small footer row.</p>
        </div>

        <div class="certifications-grid">
          <article class="cert-badge" data-animate>
            <div class="cert-icon"><i data-lucide="shield-check"></i></div>
            <h3 class="cert-title">PCI DSS</h3>
            <p class="cert-subtitle">Payment security controls built into platform practices.</p>
          </article>
          <article class="cert-badge" data-animate>
            <div class="cert-icon"><i data-lucide="badge-check"></i></div>
            <h3 class="cert-title">ISO 27001</h3>
            <p class="cert-subtitle">Security management discipline across systems and teams.</p>
          </article>
          <article class="cert-badge" data-animate>
            <div class="cert-icon"><i data-lucide="landmark"></i></div>
            <h3 class="cert-title">RBI-ready ops</h3>
            <p class="cert-subtitle">Operational rigor aligned with regulated payment expectations.</p>
          </article>
          <article class="cert-badge" data-animate>
            <div class="cert-icon"><i data-lucide="shield-user"></i></div>
            <h3 class="cert-title">SOC 2 readiness</h3>
            <p class="cert-subtitle">Monitoring and control maturity for scaling infrastructure.</p>
          </article>
          <article class="cert-badge" data-animate>
            <div class="cert-icon"><i data-lucide="lock"></i></div>
            <h3 class="cert-title">Privacy by design</h3>
            <p class="cert-subtitle">Data handling designed around access control and protection.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="cta-section" aria-labelledby="cta-title">
      <div class="container">
        <div class="cta-content" data-animate>
          <span class="section-label section-label-light">Get started</span>
          <h2 class="cta-title" id="cta-title">Ready to build with a calmer payments stack?</h2>
          <p class="cta-subtitle">Join businesses using ZenoPay for cleaner collections, clearer reconciliation, and more dependable payment operations.</p>
          <div class="cta-buttons">
            <a href="/register" class="btn-cta-primary"><i data-lucide="zap"></i><span>Start Free</span></a>
            <a href="/contact" class="btn-cta-outline"><i data-lucide="message-square"></i><span>Talk to Sales</span></a>
          </div>
          <p class="cta-footnote"><i data-lucide="shield-check"></i><span>Bank-grade security, no setup fees, and support when operations get real.</span></p>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/about.js"></script>
</body>
</html>
