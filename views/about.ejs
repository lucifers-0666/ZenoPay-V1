<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'About Us - ZenoPay' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- ═══════════════════════════════════════
       HERO SECTION — Full redesign
  ═══════════════════════════════════════ -->
  <section class="about-hero-v2">
    <!-- Background layers -->
    <div class="hero-v2-bg">
      <div class="hero-dot-grid"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
      <div class="hero-orb hero-orb-3"></div>
    </div>

    <div class="hero-v2-inner">
      <!-- LEFT: Text content -->
      <div class="hero-v2-left">
        <!-- Badge -->
        <div class="hero-v2-badge">
          <span class="badge-dot"></span>
          <span>Fintech · Founded 2024 · India</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-v2-title">
          Reimagining How
          <br>
          <span class="hero-v2-gradient">India Pays</span>
        </h1>

        <!-- Subtext -->
        <p class="hero-v2-sub">
          ZenoPay was built with one belief — that every person and every business deserves fast, secure, and transparent financial infrastructure. No hidden fees. No complexity. Just payments that work.
        </p>

        <!-- Floating stat pills -->
        <div class="hero-v2-pills">
          <div class="hero-pill">
            <i class="fas fa-users hero-pill-icon"></i>
            <span class="hero-pill-num">50K+</span>
            <span class="hero-pill-label">Active Users</span>
          </div>
          <div class="hero-pill">
            <i class="fas fa-bolt hero-pill-icon hero-pill-icon--green"></i>
            <span class="hero-pill-num">99.9%</span>
            <span class="hero-pill-label">Uptime</span>
          </div>
          <div class="hero-pill">
            <i class="fas fa-rupee-sign hero-pill-icon hero-pill-icon--purple"></i>
            <span class="hero-pill-num">&#8377;10M+</span>
            <span class="hero-pill-label">Monthly Volume</span>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="hero-v2-actions">
          <a href="/register" class="btn-v2-primary">
            <i class="fas fa-user-plus"></i>
            <span>Open Free Account</span>
          </a>
          <a href="#story" class="btn-v2-ghost">
            <span>Our Story</span>
            <i class="fas fa-arrow-down"></i>
          </a>
        </div>

        <!-- Trust row -->
        <div class="hero-v2-trust">
          <div class="trust-item">
            <i class="fas fa-shield-alt trust-icon"></i>
            <span>PCI DSS L1</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <i class="fas fa-lock trust-icon"></i>
            <span>256-bit SSL</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <i class="fas fa-certificate trust-icon"></i>
            <span>ISO 27001</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <i class="fas fa-check-circle trust-icon trust-icon--green"></i>
            <span>RBI Approved</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: Visual card -->
      <div class="hero-v2-right">
        <div class="hero-visual-card">
          <!-- Card header -->
          <div class="hvc-header">
            <img src="/Images/bgFavicon.png" alt="ZenoPay" class="hvc-logo" onerror="this.style.display='none'">
            <div class="hvc-header-text">
              <span class="hvc-brand">ZenoPay</span>
              <span class="hvc-tagline">Payment Platform</span>
            </div>
            <div class="hvc-live-badge">
              <span class="hvc-live-dot"></span>
              Live
            </div>
          </div>

          <!-- Divider -->
          <div class="hvc-divider"></div>

          <!-- Stats inside card -->
          <div class="hvc-stats-grid">
            <div class="hvc-stat">
              <span class="hvc-stat-val">&#8377;2.4M</span>
              <span class="hvc-stat-key">Today's Volume</span>
              <span class="hvc-stat-change hvc-up"><i class="fas fa-arrow-up"></i> 12.4%</span>
            </div>
            <div class="hvc-stat">
              <span class="hvc-stat-val">8,240</span>
              <span class="hvc-stat-key">Transactions</span>
              <span class="hvc-stat-change hvc-up"><i class="fas fa-arrow-up"></i> 5.1%</span>
            </div>
          </div>

          <!-- Mini chart bar -->
          <div class="hvc-chart">
            <div class="hvc-chart-bar" style="height:40%"></div>
            <div class="hvc-chart-bar" style="height:65%"></div>
            <div class="hvc-chart-bar" style="height:50%"></div>
            <div class="hvc-chart-bar" style="height:80%"></div>
            <div class="hvc-chart-bar" style="height:60%"></div>
            <div class="hvc-chart-bar" style="height:90%"></div>
            <div class="hvc-chart-bar hvc-chart-bar--active" style="height:75%"></div>
          </div>

          <!-- Recent txns -->
          <div class="hvc-txn-list">
            <div class="hvc-txn">
              <div class="hvc-txn-avatar" style="background:linear-gradient(135deg,#3B82F6,#8B5CF6)">A</div>
              <div class="hvc-txn-info">
                <span class="hvc-txn-name">Arjun Mehta</span>
                <span class="hvc-txn-time">2 min ago</span>
              </div>
              <span class="hvc-txn-amt hvc-txn-cr">+&#8377;5,200</span>
            </div>
            <div class="hvc-txn">
              <div class="hvc-txn-avatar" style="background:linear-gradient(135deg,#10B981,#059669)">S</div>
              <div class="hvc-txn-info">
                <span class="hvc-txn-name">Sneha Rao</span>
                <span class="hvc-txn-time">5 min ago</span>
              </div>
              <span class="hvc-txn-amt hvc-txn-dr">-&#8377;1,800</span>
            </div>
            <div class="hvc-txn">
              <div class="hvc-txn-avatar" style="background:linear-gradient(135deg,#F59E0B,#D97706)">R</div>
              <div class="hvc-txn-info">
                <span class="hvc-txn-name">Raj Traders</span>
                <span class="hvc-txn-time">8 min ago</span>
              </div>
              <span class="hvc-txn-amt hvc-txn-cr">+&#8377;12,000</span>
            </div>
          </div>
        </div>

        <!-- Floating accent cards -->
        <div class="hero-float-card hero-float-card--tl">
          <i class="fas fa-shield-alt" style="color:#10B981"></i>
          <span>Bank-grade Security</span>
        </div>
        <div class="hero-float-card hero-float-card--br">
          <i class="fas fa-globe" style="color:#3B82F6"></i>
          <span>150+ Countries</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#story" class="hero-v2-scroll">
      <i class="fas fa-chevron-down"></i>
    </a>
  </section>

  <!-- ═══════════════════════════════════════
       STORY SECTION — Redesigned dark version
  ═══════════════════════════════════════ -->
  <section id="story" class="story-v2">
    <div class="story-v2-inner">

      <!-- Section header -->
      <div class="story-v2-header">
        <span class="sv2-label">Our Story</span>
        <h2 class="sv2-title">The Story Behind <span class="sv2-grad">ZenoPay</span></h2>
        <p class="sv2-sub">From a shared workspace in Mumbai to a platform trusted by thousands — this is how we got here.</p>
      </div>

      <!-- Two-column layout -->
      <div class="story-v2-grid">

        <!-- Left: Timeline milestones -->
        <div class="story-v2-timeline">
          <div class="sv2-tl-item" data-animate="fade-up">
            <div class="sv2-tl-dot sv2-tl-dot--blue"></div>
            <div class="sv2-tl-content">
              <span class="sv2-tl-year">2024 · Jan</span>
              <h4 class="sv2-tl-title">The Idea Sparked</h4>
              <p class="sv2-tl-text">Born from firsthand frustration with complicated payment flows while helping small family businesses go digital.</p>
            </div>
          </div>
          <div class="sv2-tl-item" data-animate="fade-up" data-delay="100">
            <div class="sv2-tl-dot sv2-tl-dot--purple"></div>
            <div class="sv2-tl-content">
              <span class="sv2-tl-year">2024 · June</span>
              <h4 class="sv2-tl-title">First 1,000 Users</h4>
              <p class="sv2-tl-text">Reached our first major user milestone just 5 months after launch — proof of product-market fit.</p>
            </div>
          </div>
          <div class="sv2-tl-item" data-animate="fade-up" data-delay="200">
            <div class="sv2-tl-dot sv2-tl-dot--green"></div>
            <div class="sv2-tl-content">
              <span class="sv2-tl-year">2024 · Oct</span>
              <h4 class="sv2-tl-title">Series A · $5M</h4>
              <p class="sv2-tl-text">Secured Series A funding from Sequoia Capital India, scaling engineering from 8 to 30 members.</p>
            </div>
          </div>
          <div class="sv2-tl-item" data-animate="fade-up" data-delay="300">
            <div class="sv2-tl-dot sv2-tl-dot--blue"></div>
            <div class="sv2-tl-content">
              <span class="sv2-tl-year">2025 · March</span>
              <h4 class="sv2-tl-title">ISO 27001 Certified</h4>
              <p class="sv2-tl-text">Achieved PCI DSS Level 1 and ISO 27001 certifications — zero security breaches to date.</p>
            </div>
          </div>
          <div class="sv2-tl-item" data-animate="fade-up" data-delay="400">
            <div class="sv2-tl-dot sv2-tl-dot--purple"></div>
            <div class="sv2-tl-content">
              <span class="sv2-tl-year">2026 · Jan</span>
              <h4 class="sv2-tl-title">South Asia Expansion</h4>
              <p class="sv2-tl-text">Launched in Nepal, Bangladesh, and Sri Lanka. Now serving 75,000+ users across 5 countries.</p>
            </div>
          </div>
        </div>

        <!-- Right: Story text -->
        <div class="story-v2-text" data-animate="fade-up">
          <p>
            <strong>ZenoPay was founded in 2024</strong> from a simple yet powerful vision — to make digital payments accessible, secure, and effortless for everyone. Our founders recognized the growing need for a platform that combines cutting-edge technology with truly user-friendly design.
          </p>
          <p>
            The inspiration came when our <strong>CTO, Ashok Sah</strong>, experienced firsthand the frustration of complex payment processes while helping a family business go digital. Millions of businesses were facing the same challenges — high fees, slow processing times, and interfaces that made payments a burden rather than a tool.
          </p>
          <p>
            What started as a team of five in a shared workspace in Mumbai has grown into a fintech company processing over <strong>&#8377;10 million monthly</strong> — helping individuals send money instantly, merchants accept payments with zero setup costs, and businesses scale with confidence.
          </p>
          <p>
            Today, we're not just building a payment platform — we're creating a financial ecosystem that empowers everyone to participate in the digital economy. With recent Series A funding and major banking partnerships, the journey is just beginning.
          </p>

          <!-- Founder highlights -->
          <div class="story-v2-founders">
            <div class="sv2-founder">
              <div class="sv2-founder-avatar">
                <img src="/Images/team/ashok-sah.jpg" alt="Ashok Sah" onerror="this.src='/Images/bgFavicon.png'">
              </div>
              <div class="sv2-founder-info">
                <span class="sv2-founder-name">Ashok Sah</span>
                <span class="sv2-founder-role">Co-founder &amp; CTO</span>
              </div>
            </div>
            <div class="sv2-founder">
              <div class="sv2-founder-avatar">
                <img src="/Images/team/zaid-amreliya.jpg" alt="Zaid Amreliya" onerror="this.src='/Images/bgFavicon.png'">
              </div>
              <div class="sv2-founder-info">
                <span class="sv2-founder-name">Zaid Amreliya</span>
                <span class="sv2-founder-role">Co-founder &amp; CEO</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Section -->
  <section class="mission-vision-section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-card mission-card">
          <div class="mv-icon-wrapper"><i class="fas fa-rocket"></i></div>
          <h3 class="mv-title">Our Mission</h3>
          <div class="quote-marks">"</div>
          <p class="mv-text">To democratize digital payments by providing a secure, efficient, and user-friendly platform that empowers individuals and businesses to transact with confidence, regardless of their technical expertise or financial background.</p>
          <p class="mv-text">We believe everyone deserves access to fast, reliable payment solutions without the complexity of traditional banking systems.</p>
          <div class="mv-badge">Est. 2024</div>
        </div>
        <div class="mv-card vision-card">
          <div class="mv-icon-wrapper"><i class="fas fa-eye"></i></div>
          <h3 class="mv-title">Our Vision</h3>
          <div class="quote-marks">"</div>
          <p class="mv-text">To become India's most trusted and innovative payment gateway, enabling seamless financial transactions across borders and empowering millions to participate in the global digital economy.</p>
          <p class="mv-text">A world where payments are instant, secure, and accessible to everyone — regardless of location, knowledge, or background.</p>
          <div class="mv-badge">Global Impact</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values Section -->
  <section class="values-section">
    <div class="container">
      <div class="section-header-center">
        <span class="section-label">What Drives Us</span>
        <h2 class="section-title">Our Core <span class="gradient-text">Values</span></h2>
        <p class="section-description">The principles that guide everything we do</p>
      </div>
      <div class="values-grid">
        <div class="value-card"><div class="value-icon"><i class="fas fa-shield-alt"></i></div><h3 class="value-title">Trust & Security</h3><p class="value-description">Bank-grade 256-bit encryption, MFA, PCI DSS Level 1 and ISO 27001. Every transaction monitored 24/7.</p></div>
        <div class="value-card"><div class="value-icon"><i class="fas fa-lightbulb"></i></div><h3 class="value-title">Innovation</h3><p class="value-description">AI-powered fraud detection, instant settlements, and QR payments. Always pushing the boundaries of digital finance.</p></div>
        <div class="value-card"><div class="value-icon"><i class="fas fa-bolt"></i></div><h3 class="value-title">Speed & Efficiency</h3><p class="value-description">Real-time transaction processing ensures payments reach their destination instantly, every time.</p></div>
        <div class="value-card"><div class="value-icon"><i class="fas fa-eye"></i></div><h3 class="value-title">Transparency</h3><p class="value-description">Clear pricing. No hidden fees. Complete visibility into every transaction. Honest business, always.</p></div>
        <div class="value-card"><div class="value-icon"><i class="fas fa-users"></i></div><h3 class="value-title">Customer First</h3><p class="value-description">24/7 support with under 2-minute response time. Every feature built from real user feedback.</p></div>
        <div class="value-card"><div class="value-icon"><i class="fas fa-globe"></i></div><h3 class="value-title">Accessibility</h3><p class="value-description">Payment solutions designed for everyone — making digital finance inclusive and easy to use across India.</p></div>
      </div>
    </div>
  </section>

  <!-- Statistics Section -->
  <section class="stats-section">
    <div class="stats-background"></div>
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card" data-animate="fade-up">
          <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
          <div class="stat-content">
            <div class="stat-value"><span class="stat-number" data-target="10">0</span><span class="stat-suffix">M+</span></div>
            <div class="stat-label">Transaction Volume</div>
          </div>
        </div>
        <div class="stat-card" data-animate="fade-up" data-delay="100">
          <div class="stat-icon"><i class="fas fa-users"></i></div>
          <div class="stat-content">
            <div class="stat-value"><span class="stat-number" data-target="50000">0</span><span class="stat-suffix">+</span></div>
            <div class="stat-label">Active Users</div>
          </div>
        </div>
        <div class="stat-card" data-animate="fade-up" data-delay="200">
          <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
          <div class="stat-content">
            <div class="stat-value"><span class="stat-number" data-target="99.9">0</span><span class="stat-suffix">%</span></div>
            <div class="stat-label">Uptime</div>
          </div>
        </div>
        <div class="stat-card" data-animate="fade-up" data-delay="300">
          <div class="stat-icon"><i class="fas fa-globe-americas"></i></div>
          <div class="stat-content">
            <div class="stat-value"><span class="stat-number" data-target="5">0</span><span class="stat-suffix">+</span></div>
            <div class="stat-label">Countries Served</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="team-section">
    <div class="container">
      <div class="section-header-center">
        <span class="section-label">The People Behind ZenoPay</span>
        <h2 class="section-title">Meet Our <span class="gradient-text">Team</span></h2>
        <p class="section-description">Passionate experts dedicated to revolutionizing payments</p>
      </div>
      <div class="founders-section">
        <h3 class="subsection-title">Founders</h3>
        <div class="founders-grid">
          <div class="founder-card" data-animate="fade-up">
            <div class="founder-avatar"><img src="/Images/team/ashok-sah.jpg" alt="Ashok Sah" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a><a href="#" class="social-link"><i class="fab fa-twitter"></i></a></div></div>
            <div class="founder-info"><h4 class="founder-name">Ashok Sah</h4><p class="founder-role">Chief Technology Officer (CTO)</p><p class="founder-bio">Leading ZenoPay's technical architecture and innovation strategy. Expert in cloud architecture, distributed systems, and modern payment technologies.</p><div class="founder-badge"><i class="fas fa-code"></i> Tech Visionary</div></div>
          </div>
          <div class="founder-card" data-animate="fade-up" data-delay="200">
            <div class="founder-avatar"><img src="/Images/team/zaid-amreliya.jpg" alt="Zaid Amreliya" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a><a href="#" class="social-link"><i class="fab fa-twitter"></i></a></div></div>
            <div class="founder-info"><h4 class="founder-name">Zaid Amreliya</h4><p class="founder-role">Chief Executive Officer (CEO)</p><p class="founder-bio">Driving ZenoPay's vision to revolutionize digital payments. Deep expertise in fintech business strategy, partnerships, and user experience design.</p><div class="founder-badge"><i class="fas fa-rocket"></i> Business Leader</div></div>
          </div>
        </div>
      </div>
      <div class="core-team-section">
        <h3 class="subsection-title">Core Team</h3>
        <div class="team-grid">
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member1.jpg" alt="Emily Rodriguez" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Emily Rodriguez</h4><p class="team-role">Head of Product</p><p class="team-bio">10+ years in fintech. Previously at Revolut and TransferWise.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member2.jpg" alt="James Wilson" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">James Wilson</h4><p class="team-role">Head of Engineering</p><p class="team-bio">MIT graduate. Former AWS architect. Ex-Stripe & Square.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member3.jpg" alt="Priya Sharma" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Priya Sharma</h4><p class="team-role">Head of Security</p><p class="team-bio">CISSP certified. Former cybersecurity lead at HDFC Bank.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member4.jpg" alt="Alex Thompson" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Alex Thompson</h4><p class="team-role">Head of Marketing</p><p class="team-bio">Former growth lead at Coinbase. 500K+ user acquisitions.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member5.jpg" alt="Raj Patel" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Raj Patel</h4><p class="team-role">Head of Customer Success</p><p class="team-bio">15 years in service leadership. Ex-Paytm and PhonePe.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member6.jpg" alt="Lisa Chang" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Lisa Chang</h4><p class="team-role">Head of Business Dev</p><p class="team-bio">MBA Wharton. Former BD Director at Visa.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member7.jpg" alt="Kumar Reddy" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Kumar Reddy</h4><p class="team-role">Head of Data Science</p><p class="team-bio">PhD ML from IIT Delhi. Former Google Research scientist.</p></div>
          <div class="team-card"><div class="team-avatar"><img src="/Images/team/member8.jpg" alt="Maria Garcia" onerror="this.src='/Images/bgFavicon.png'"><div class="avatar-overlay"><a href="#" class="social-link"><i class="fab fa-linkedin"></i></a></div></div><h4 class="team-name">Maria Garcia</h4><p class="team-role">Head of Legal</p><p class="team-bio">15 years fintech legal. Former RBI regulatory counsel.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Achievements & Milestones Section -->
  <section class="achievements-section">
    <div class="container">
      <div class="section-header-center">
        <span class="section-label">Our Journey</span>
        <h2 class="section-title">Achievements & <span class="gradient-text">Milestones</span></h2>
        <p class="section-description">Key moments that shaped our story</p>
      </div>
      <div class="timeline">
        <div class="timeline-item"><div class="timeline-marker"><div class="marker-dot"></div></div><div class="timeline-card"><span class="timeline-year">January 2024</span><div class="timeline-icon"><i class="fas fa-flag-checkered"></i></div><h4 class="timeline-title">Company Founded</h4><p class="timeline-description">ZenoPay officially launched with $500K angel funding. Five passionate fintech veterans began building the platform from scratch.</p></div></div>
