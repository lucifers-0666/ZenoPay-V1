<script nonce="<%= locals.cspNonce || '' %>">
  (() => {
    const tabs = Array.from(document.querySelectorAll('#announcementTabs .filter-tab'));
    const typeFilter = document.getElementById('typeFilter');
    const cards = () => Array.from(document.querySelectorAll('.announcement-card[data-id]'));
    const dropdown = document.getElementById('announcementDropdown');
    const createForm = document.getElementById('createAnnouncementForm');
    const editForm = document.getElementById('editAnnouncementForm');
    const createContent = document.getElementById('createContent');
    const createTitle = document.getElementById('createTitle');
    const createType = document.getElementById('createType');
    const createAudience = document.getElementById('createAudience');
    const counter = document.getElementById('contentCounter');
    const editContent = document.getElementById('editContent');
    const editCounter = document.getElementById('editContentCounter');
    const scheduledWrap = document.getElementById('scheduledWrap');
    const scheduledAtInput = document.getElementById('scheduledAtInput');
    const priorityInput = document.getElementById('priorityInput');
    const editPriorityInput = document.getElementById('editPriorityInput');
    const saveDraftBtn = document.getElementById('saveDraftBtn');
    const createPublishBtn = document.getElementById('createPublishBtn');
    const paginationBar = document.getElementById('paginationBar');
    const confirmDeleteBtn = document.getElementById('confirmDeleteAnnouncementBtn');
    const confirmPublishBtn = document.getElementById('confirmPublishBtn');

    let createSubmitStatus = 'draft';
    let activeCard = null;

    function showToast(message, type = 'success') {
      const host = document.getElementById('toastContainer') || document.body;
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type === 'error' ? 'admin-toast-error' : 'admin-toast-success'}`;
      toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i><span>${String(message || '')}</span>`;
      host.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 260);
      }, 2200);
    }

    function getTypeMeta(type) {
      const t = String(type || 'info').toLowerCase();
      if (t === 'success') return { icon: 'fa-circle-check', color: '#22c55e' };
      if (t === 'warning') return { icon: 'fa-triangle-exclamation', color: '#f59e0b' };
      if (t === 'danger') return { icon: 'fa-circle-xmark', color: '#ef4444' };
      if (t === 'maintenance') return { icon: 'fa-screwdriver-wrench', color: '#f97316' };
      if (t === 'feature') return { icon: 'fa-star', color: '#8B5CF6' };
      return { icon: 'fa-circle-info', color: '#3B82F6' };
    }

    function audienceLabel(value) {
      const a = String(value || 'all').toLowerCase();
      if (a === 'users') return 'Users Only';
      if (a === 'merchants') return 'Merchants Only';
      if (a === 'admins') return 'Admins Only';
      if (a === 'premium') return 'Premium Users';
      return 'All Users';
    }

    function openModal(id) {
      document.getElementById(id)?.classList.add('open');
    }

    function closeModal(id) {
      document.getElementById(id)?.classList.remove('open');
    }

    function setTypeSelectBorder(selectEl) {
      if (!selectEl) return;
      selectEl.classList.remove('type-info', 'type-success', 'type-warning', 'type-danger', 'type-maintenance', 'type-feature');
      const value = String(selectEl.value || 'info').toLowerCase();
      selectEl.classList.add(`type-${value}`);
    }

    function switchAnnouncementTab(status) {
      localStorage.setItem('admin_announcements_active_tab', status);
      const url = new URL(window.location.href);
      if (!status || status === 'all') url.searchParams.delete('status');
      else url.searchParams.set('status', status);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    }

    function applyTypeFilter() {
      const selectedType = String(typeFilter?.value || 'all').toLowerCase();
      cards().forEach((card) => {
        const cardType = String(card.dataset.type || '').toLowerCase();
        const visible = selectedType === 'all' || selectedType === cardType;
        card.style.display = visible ? '' : 'none';
      });
    }

    function setPriority(value) {
      const v = Number(value || 3);
      priorityInput.value = String(v);
      document.querySelectorAll('#priorityStars .priority-star').forEach((s, i) => {
        s.style.color = (i < v) ? '#f59e0b' : '#e2e8f0';
      });
    }

    function setEditPriority(value) {
      const v = Number(value || 3);
      editPriorityInput.value = String(v);
      document.querySelectorAll('#editPriorityStars .edit-priority-star').forEach((s, i) => {
        s.style.color = (i < v) ? '#f59e0b' : '#e2e8f0';
      });
    }

    function toggleScheduleInput() {
      const selected = document.querySelector('input[name="createStatusMode"]:checked')?.value || 'draft';
      scheduledWrap.style.display = selected === 'scheduled' ? '' : 'none';
      if (selected !== 'scheduled') scheduledAtInput.value = '';
      const liveStatus = document.getElementById('liveStatus');
      liveStatus.textContent = selected;
      liveStatus.className = 'status-badge ' + (selected === 'published' ? 'badge-success' : selected === 'scheduled' ? 'badge-purple' : 'badge-info');
    }

    function updateLivePreview() {
      const title = (createTitle.value || '').trim() || 'Announcement title preview';
      const content = (createContent.value || '').trim() || 'Your content preview will appear here...';
      const type = createType.value || 'info';
      const meta = getTypeMeta(type);

      document.getElementById('liveTitle').textContent = title;
      document.getElementById('liveContent').textContent = content;

      const liveIcon = document.getElementById('liveIcon');
      const liveIconWrap = document.getElementById('liveIconWrap');
      liveIcon.className = `fas ${meta.icon}`;
      liveIconWrap.style.color = meta.color;
      liveIconWrap.style.background = `${meta.color}1A`;
    }

    function openEditModal(id, title, content, type, audience, priority, status, scheduledAt) {
      document.getElementById('editAnnouncementId').value = id || '';
      document.getElementById('editTitle').value = title || '';
      document.getElementById('editContent').value = content || '';
      document.getElementById('editType').value = type || 'info';
      document.getElementById('editAudience').value = audience || 'all';
      document.getElementById('editScheduledAt').value = scheduledAt || '';
      setTypeSelectBorder(document.getElementById('editType'));
      setEditPriority(Number(priority || 3));
      editCounter.textContent = `${(content || '').length} / 1000`;
      openModal('editModal');
    }

    function openPreviewModal(title, content, type, audience, priority, status) {
      const meta = getTypeMeta(type);
      const banner = document.getElementById('previewBanner');
      const iconWrap = document.getElementById('previewIconWrap');
      const icon = document.getElementById('previewIcon');
      banner.style.borderTopColor = meta.color;
      iconWrap.style.color = meta.color;
      iconWrap.style.background = `${meta.color}1A`;
      icon.className = `fas ${meta.icon}`;

      document.getElementById('previewTitle').textContent = title || 'Announcement';
      document.getElementById('previewContent').textContent = content || '-';
      document.getElementById('previewAudience').innerHTML = `<i class="fas fa-users"></i> ${audienceLabel(audience)}`;

      const p = Number(priority || 3);
      let stars = '';
      for (let i = 1; i <= 5; i += 1) {
        stars += `<i class="fas fa-star" style="color:${i <= p ? '#f59e0b' : '#e2e8f0'}; font-size:0.72rem;"></i>`;
      }
      document.getElementById('previewPriority').innerHTML = `<i class="fas fa-signal"></i> Priority ${p}/5 ${stars}`;
      document.getElementById('previewStatus').innerHTML = `<i class="fas fa-circle-info"></i> ${String(status || 'draft')}`;

      openModal('previewModal');
    }

    function openDeleteModal(id, title) {
      document.getElementById('deleteAnnouncementId').value = id || '';
      document.getElementById('deleteAnnouncementTitle').textContent = `"${title || '-'}"`;
      openModal('deleteModal');
    }

    function publishAnnouncement(id, audience) {
      document.getElementById('publishAnnouncementId').value = id || '';
      document.getElementById('publishAudienceText').textContent = audienceLabel(audience);
      openModal('publishModal');
    }

    async function unpublishAnnouncement(id) {
      if (!window.confirm('Move this announcement back to draft?')) return;
      const resp = await fetch(`/admin/announcements/${encodeURIComponent(id)}/unpublish`, { method: 'PATCH' });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok || !result.success) {
        showToast(result.message || 'Unpublish failed', 'error');
        return;
      }
      showToast(result.message || 'Moved to draft');
      setTimeout(() => window.location.reload(), 350);
    }

    function closeDropdown() {
      dropdown.style.display = 'none';
      activeCard = null;
    }

    function openDropdownFor(button, card) {
      activeCard = card;
      const rect = button.getBoundingClientRect();
      dropdown.style.display = 'block';
      const h = dropdown.offsetHeight;
      const w = dropdown.offsetWidth;
      let top = rect.bottom + 4;
      let left = rect.right - w;
      if (top + h > window.innerHeight - 8) top = rect.top - h - 4;
      if (left < 8) left = 8;
      dropdown.style.top = `${top}px`;
      dropdown.style.left = `${left}px`;

      const status = String(card.dataset.status || '').toLowerCase();
      dropdown.querySelector('[data-dd-action="publish"]').style.display = status === 'draft' ? 'flex' : 'none';
      dropdown.querySelector('[data-dd-action="unpublish"]').style.display = status === 'published' ? 'flex' : 'none';
    }

    async function createAnnouncement(statusOverride) {
      const statusMode = statusOverride || document.querySelector('input[name="createStatusMode"]:checked')?.value || 'draft';
      const payload = {
        title: createTitle.value.trim(),
        content: createContent.value.trim(),
        type: createType.value,
        targetAudience: createAudience.value,
        priority: Number(priorityInput.value || 3),
        scheduledAt: statusMode === 'scheduled' ? (scheduledAtInput.value || null) : null,
        status: statusMode,
      };

      const resp = await fetch('/admin/announcements/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok || !result.success) {
        showToast(result.message || 'Failed to create announcement', 'error');
        return;
      }
      showToast(result.message || 'Announcement created successfully');
      closeModal('createModal');
      setTimeout(() => window.location.reload(), 350);
    }

    async function updateAnnouncement() {
      const id = document.getElementById('editAnnouncementId').value;
      const payload = {
        title: document.getElementById('editTitle').value.trim(),
        content: document.getElementById('editContent').value.trim(),
        type: document.getElementById('editType').value,
        targetAudience: document.getElementById('editAudience').value,
        priority: Number(editPriorityInput.value || 3),
        scheduledAt: document.getElementById('editScheduledAt').value || null,
      };

      const resp = await fetch(`/admin/announcements/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok || !result.success) {
        showToast(result.message || 'Update failed', 'error');
        return;
      }
      showToast(result.message || 'Announcement updated');
      setTimeout(() => window.location.reload(), 350);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => switchAnnouncementTab(tab.dataset.status));
    });

    typeFilter?.addEventListener('change', () => {
      applyTypeFilter();
      const url = new URL(window.location.href);
      const val = String(typeFilter.value || 'all');
      if (val === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', val);
      url.searchParams.delete('page');
      window.history.replaceState({}, '', url.toString());
    });

    createType?.addEventListener('change', () => {
      setTypeSelectBorder(createType);
      updateLivePreview();
    });

    createTitle?.addEventListener('input', updateLivePreview);
    createContent?.addEventListener('input', () => {
      if (createContent.value.length > 1000) {
        createContent.value = createContent.value.substring(0, 1000);
      }
      counter.textContent = `${createContent.value.length} / 1000`;
      updateLivePreview();
    });

    editContent?.addEventListener('input', () => {
      if (editContent.value.length > 1000) {
        editContent.value = editContent.value.substring(0, 1000);
      }
      editCounter.textContent = `${editContent.value.length} / 1000`;
    });

    document.querySelectorAll('input[name="createStatusMode"]').forEach((radio) => {
      radio.addEventListener('change', toggleScheduleInput);
    });

    scheduledAtInput.min = new Date(Date.now() - (new Date()).getTimezoneOffset() * 60000).toISOString().slice(0, 16);

    document.querySelectorAll('#priorityStars .priority-star').forEach((btn) => {
      btn.addEventListener('click', () => setPriority(Number(btn.dataset.value || 3)));
    });

    document.querySelectorAll('#editPriorityStars .edit-priority-star').forEach((btn) => {
      btn.addEventListener('click', () => setEditPriority(Number(btn.dataset.value || 3)));
    });

    saveDraftBtn?.addEventListener('click', () => {
      createSubmitStatus = 'draft';
    });

    createPublishBtn?.addEventListener('click', () => {
      createSubmitStatus = 'published';
    });

    createForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await createAnnouncement(createSubmitStatus);
    });

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await updateAnnouncement();
    });

    paginationBar?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-page]');
      if (!btn || btn.disabled) return;
      const page = btn.getAttribute('data-page');
      const url = new URL(window.location.href);
      url.searchParams.set('page', page);
      window.location.href = url.toString();
    });

    document.addEventListener('click', (e) => {
      const openBtn = e.target.closest('[data-open-modal]');
      if (openBtn) {
        openModal(openBtn.getAttribute('data-open-modal'));
        closeDropdown();
        return;
      }

      const closeBtn = e.target.closest('[data-close-modal]');
      if (closeBtn) {
        closeModal(closeBtn.getAttribute('data-close-modal'));
        return;
      }

      const menuTrigger = e.target.closest('[data-menu-trigger="true"]');
      if (menuTrigger) {
        const card = menuTrigger.closest('.announcement-card');
        if (dropdown.style.display === 'block' && activeCard === card) closeDropdown();
        else openDropdownFor(menuTrigger, card);
        return;
      }

      const actionBtn = e.target.closest('[data-action]');
      if (actionBtn) {
        const card = actionBtn.closest('.announcement-card');
        if (!card) return;
        const a = {
          id: card.dataset.id,
          title: card.dataset.title,
          content: card.dataset.content,
          type: card.dataset.type,
          audience: card.dataset.audience,
          priority: card.dataset.priority,
          status: card.dataset.status,
          scheduledAt: card.dataset.scheduledAt,
        };

        const action = actionBtn.dataset.action;
        if (action === 'preview') openPreviewModal(a.title, a.content, a.type, a.audience, a.priority, a.status);
        if (action === 'edit') openEditModal(a.id, a.title, a.content, a.type, a.audience, a.priority, a.status, a.scheduledAt);
        if (action === 'publish') publishAnnouncement(a.id, a.audience);
        if (action === 'unpublish') unpublishAnnouncement(a.id);
        if (action === 'delete') openDeleteModal(a.id, a.title);
      }

      if (dropdown.style.display === 'block' && !e.target.closest('#announcementDropdown')) {
        closeDropdown();
      }
    });

    dropdown?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-dd-action]');
      if (!btn || !activeCard) return;
      const action = btn.dataset.ddAction;
      const a = {
        id: activeCard.dataset.id,
        title: activeCard.dataset.title,
        content: activeCard.dataset.content,
        type: activeCard.dataset.type,
        audience: activeCard.dataset.audience,
        priority: activeCard.dataset.priority,
        status: activeCard.dataset.status,
        scheduledAt: activeCard.dataset.scheduledAt,
      };

      if (action === 'preview') openPreviewModal(a.title, a.content, a.type, a.audience, a.priority, a.status);
      if (action === 'edit') openEditModal(a.id, a.title, a.content, a.type, a.audience, a.priority, a.status, a.scheduledAt);
      if (action === 'publish') publishAnnouncement(a.id, a.audience);
      if (action === 'unpublish') unpublishAnnouncement(a.id);
      if (action === 'delete') openDeleteModal(a.id, a.title);
      closeDropdown();
    });

    confirmPublishBtn?.addEventListener('click', async () => {
      const id = document.getElementById('publishAnnouncementId').value;
      const resp = await fetch(`/admin/announcements/${encodeURIComponent(id)}/publish`, { method: 'PATCH' });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok || !result.success) {
        showToast(result.message || 'Publish failed', 'error');
        return;
      }
      showToast(result.message || 'Announcement published');
      closeModal('publishModal');
      setTimeout(() => window.location.reload(), 350);
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      const id = document.getElementById('deleteAnnouncementId').value;
      const card = document.getElementById(`announcement-${id}`);
      const resp = await fetch(`/admin/announcements/${encodeURIComponent(id)}`, { method: 'DELETE' });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok || !result.success) {
        showToast(result.message || 'Delete failed', 'error');
        return;
      }

      closeModal('deleteModal');
      if (card) card.classList.add('removing');
      showToast(result.message || 'Announcement deleted');
      setTimeout(() => window.location.reload(), 350);
    });

    window.switchAnnouncementTab = switchAnnouncementTab;
    window.setPriority = setPriority;
    window.openEditModal = openEditModal;
    window.openPreviewModal = openPreviewModal;
    window.publishAnnouncement = publishAnnouncement;
    window.unpublishAnnouncement = unpublishAnnouncement;
    window.openDeleteModal = openDeleteModal;
    window.showToast = showToast;

    setPriority(3);
    setEditPriority(3);
    toggleScheduleInput();
    setTypeSelectBorder(createType);
    setTypeSelectBorder(document.getElementById('editType'));
    updateLivePreview();
    applyTypeFilter();

    document.querySelectorAll('.modal-overlay').forEach((overlay) => {
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) overlay.classList.remove('open');
      });
    });

    window.addEventListener('scroll', closeDropdown, true);
  })();
</script>

