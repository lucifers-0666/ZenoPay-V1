<div class="logout-page">
  <div class="logout-card">
    <div style="font-size:48px; color:#64748b; margin-bottom: 12px;">
      <i class="fas fa-right-from-bracket"></i>
    </div>
    <h1 class="auth-form-title" style="margin-bottom: 8px;">Signing out...</h1>
    <p class="auth-form-subtitle" style="margin-bottom: 22px;">You have been logged out securely.</p>

    <div style="font-size:56px; color:#22c55e; margin-bottom: 10px;">
      <i class="fas fa-circle-check"></i>
    </div>
    <p style="color:#166534; font-weight:600; margin-bottom: 8px;">Session ended</p>
    <p id="redirectText" style="color:#64748b; font-size:0.9rem; margin-bottom: 26px;">
      Redirecting to login in 3 seconds...
    </p>

    <a href="/admin/login" class="auth-btn auth-btn-outline">
      <i class="fas fa-arrow-left"></i>
      Back to Login
    </a>
  </div>
</div>

<script>
  var countdown = 3;
  var interval = setInterval(function() {
    countdown--;
    var el = document.getElementById('redirectText');
    if (el) {
      el.textContent = 'Redirecting to login in ' + countdown + ' seconds...';
    }
    if (countdown <= 0) {
      clearInterval(interval);
      window.location.href = '/admin/login';
    }
  }, 1000);
</script>
