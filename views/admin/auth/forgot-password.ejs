<div class="auth-wrapper">
  <div class="auth-left">
    <div class="auth-left-orb1"></div>
    <div class="auth-left-orb2"></div>
    <div class="auth-left-orb3"></div>
    <div class="auth-left-dots"></div>

    <div class="auth-brand">
      <div class="auth-brand-icon" style="background: linear-gradient(135deg, #1D4ED8, #6B41E8); border: 1.5px solid rgba(255,255,255,0.3); box-shadow: 0 4px 16px rgba(59,130,246,0.4), inset 0 1px 0 rgba(255,255,255,0.2);">
        <i class="fas fa-shield-halved" style="color: #93C5FD;"></i>
      </div>
      <div>
        <div class="auth-brand-name">ZenoPay</div>
      </div>
      <span class="auth-brand-tag">ADMIN</span>
    </div>

    <div class="auth-left-content">
      <div class="auth-illustration-box" style="background: linear-gradient(145deg, #0E7490, #06B6D4);">
        <i class="fas fa-envelope-circle-check" style="color: #CFFAFE;"></i>
      </div>
      <div class="auth-tagline">Password Recovery</div>
      <div class="auth-tagline-sub">We'll send a secure reset link to your email</div>

      <div class="auth-features">
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #1D4ED8, #3B82F6);"><i class="fas fa-paper-plane" style="color: #BFDBFE;"></i></div>
          <span>Reset link sent to your email</span>
        </div>
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #B45309, #F59E0B);"><i class="fas fa-clock" style="color: #FDE68A;"></i></div>
          <span>Link expires in 15 minutes</span>
        </div>
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #059669, #10B981);"><i class="fas fa-shield-halved" style="color: #A7F3D0;"></i></div>
          <span>Secure one-time link</span>
        </div>
      </div>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-right-top">
      <span class="auth-right-brand">
        <i class="fas fa-shield-halved"></i>
        ZenoPay Admin
      </span>
      <span class="auth-right-badge">Secure Portal</span>
    </div>

    <div class="auth-form-container">
      <div class="auth-form-header">
        <div class="auth-form-icon" style="background: linear-gradient(135deg, #0E7490, #06B6D4);">
          <i class="fas fa-envelope-circle-check" style="color:#CFFAFE;"></i>
        </div>
        <h1 class="auth-form-title">Forgot Password?</h1>
        <p class="auth-form-subtitle">Enter your admin email and we'll send you a reset link</p>
      </div>

      <% if (locals.error) { %>
        <div class="auth-alert error">
          <i class="fas fa-circle-xmark"></i>
          <%= error %>
        </div>
      <% } %>

      <% const emailSent = !!(locals.emailSent || locals.showSuccess); %>
      <% const sentTo = locals.sentTo || locals.email || ''; %>

      <% if (emailSent) { %>
        <div class="auth-success-state">
          <div class="auth-success-icon">
            <i class="fas fa-circle-check"></i>
          </div>
          <h2 class="auth-form-title" style="font-size:1.4rem; margin-bottom:10px;">Reset link sent!</h2>
          <p class="auth-form-subtitle" style="margin-bottom:16px;">
            Check your inbox at <strong><%= sentTo %></strong><br>
            Link expires in 15 minutes.
          </p>

          <form action="/admin/forgot-password" method="POST" id="resendForm" style="margin-bottom: 12px;">
            <input type="hidden" name="email" value="<%= sentTo %>">
            <button type="submit" class="auth-btn auth-btn-outline" id="resendBtn">
              <i class="fas fa-rotate"></i>
              Resend link
            </button>
          </form>

          <a href="/admin/login" class="auth-back-link"><i class="fas fa-arrow-left"></i>Back to Login</a>
        </div>
      <% } else { %>
        <form action="/admin/forgot-password" method="POST" id="forgotForm" novalidate>
          <div class="auth-form-group">
            <label class="auth-form-label">
              <i class="fas fa-at" style="color:#06B6D4;"></i>
              Email Address
            </label>
            <div class="auth-input-wrap">
              <i class="fas fa-envelope auth-input-icon"></i>
              <input
                type="email"
                id="emailInput"
                name="email"
                class="auth-input"
                placeholder="Enter your admin email address"
                value="<%= locals.email || '' %>"
                required
              >
            </div>
            <div class="auth-input-error" id="emailError">Please enter a valid email address</div>
          </div>

          <button type="submit" class="auth-btn auth-btn-primary" id="forgotBtn">
            <i class="fas fa-paper-plane"></i>
            Send Reset Link
          </button>

          <a href="/admin/login" class="auth-back-link"><i class="fas fa-arrow-left"></i>Back to Login</a>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script>
  var forgotForm = document.getElementById('forgotForm');
  if (forgotForm) {
    forgotForm.addEventListener('submit', function(e) {
      var input = document.getElementById('emailInput');
      var err = document.getElementById('emailError');
      var btn = document.getElementById('forgotBtn');

      err.classList.remove('show');
      input.classList.remove('error');

      if (!input.value || !/\S+@\S+\.\S+/.test(input.value)) {
        e.preventDefault();
        input.classList.add('error');
        err.classList.add('show');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
    });
  }

  var resendForm = document.getElementById('resendForm');
  if (resendForm) {
    resendForm.addEventListener('submit', function() {
      var btn = document.getElementById('resendBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resending...';
    });
  }
</script>
