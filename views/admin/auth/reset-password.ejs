<div class="auth-wrapper">
  <div class="auth-left">
    <div class="auth-left-orb1"></div>
    <div class="auth-left-orb2"></div>
    <div class="auth-left-orb3"></div>
    <div class="auth-left-dots"></div>

    <div class="auth-brand">
      <div class="auth-brand-icon" style="background: linear-gradient(135deg, #1D4ED8, #6B41E8); border: 1.5px solid rgba(255,255,255,0.3); box-shadow: 0 4px 16px rgba(59,130,246,0.4), inset 0 1px 0 rgba(255,255,255,0.2);">
        <i class="fas fa-shield-halved" style="color: #93C5FD;"></i>
      </div>
      <div>
        <div class="auth-brand-name">ZenoPay</div>
      </div>
      <span class="auth-brand-tag">ADMIN</span>
    </div>

    <div class="auth-left-content">
      <div class="auth-illustration-box" style="background: linear-gradient(145deg, #5B21B6, #7C3AED);">
        <i class="fas fa-key" style="color: #EDE9FE;"></i>
      </div>
      <div class="auth-tagline">Create New Password</div>
      <div class="auth-tagline-sub">Choose a strong password to protect your account</div>

      <div class="auth-features">
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #059669, #10B981);"><i class="fas fa-check-circle" style="color: #A7F3D0;"></i></div>
          <span>Minimum 8 characters</span>
        </div>
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #1D4ED8, #3B82F6);"><i class="fas fa-font" style="color: #BFDBFE;"></i></div>
          <span>Include uppercase &amp; lowercase</span>
        </div>
        <div class="auth-feature-item">
          <div class="auth-feature-icon" style="background: linear-gradient(135deg, #B45309, #F59E0B);"><i class="fas fa-hashtag" style="color: #FDE68A;"></i></div>
          <span>Include numbers &amp; symbols</span>
        </div>
      </div>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-right-top">
      <span class="auth-right-brand">
        <i class="fas fa-shield-halved"></i>
        ZenoPay Admin
      </span>
      <span class="auth-right-badge">Secure Portal</span>
    </div>

    <div class="auth-form-container">
      <% const tokenValid = (typeof locals.tokenValid !== 'undefined') ? locals.tokenValid : locals.validToken; %>

      <% if (!tokenValid) { %>
        <div class="auth-error-state">
          <div class="auth-form-icon" style="background: linear-gradient(135deg, #991B1B, #EF4444);">
            <i class="fas fa-circle-xmark" style="color:#FECACA;"></i>
          </div>
          <h2>Invalid or Expired Link</h2>
          <p>
            This reset link has expired or already been used.<br>
            Request a new one to continue.
          </p>
          <a href="/admin/forgot-password" class="auth-btn auth-btn-primary">
            <i class="fas fa-rotate"></i>
            Request New Link
          </a>
        </div>
      <% } else { %>
        <div class="auth-form-header">
          <div class="auth-form-icon" style="background: linear-gradient(135deg, #5B21B6, #7C3AED);">
            <i class="fas fa-key" style="color:#EDE9FE;"></i>
          </div>
          <h1 class="auth-form-title">Create New Password</h1>
          <p class="auth-form-subtitle">Enter and confirm your new password below</p>
        </div>

        <% if (locals.error) { %>
          <div class="auth-alert error">
            <i class="fas fa-circle-xmark"></i>
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/admin/reset-password/<%= token %>" id="resetForm" novalidate>
          <input type="hidden" name="token" value="<%= token %>">

          <div class="auth-form-group">
            <label class="auth-form-label">
              <i class="fas fa-key" style="color:#6B41E8;"></i>
              New Password
            </label>
            <div class="auth-input-wrap">
              <i class="fas fa-lock auth-input-icon"></i>
              <input type="password" id="newPasswordInput" name="password" class="auth-input" placeholder="Enter new password" required>
              <button type="button" class="auth-input-toggle" onclick="togglePassword('newPasswordInput', this)">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div class="auth-input-hint"><i class="fas fa-circle-info"></i>At least 8 characters with uppercase, lowercase, number, and symbol</div>
            <div class="password-strength-wrap">
              <div class="password-strength-bar">
                <div class="password-strength-fill" id="strengthFill"></div>
              </div>
              <div class="strength-text" id="strengthText"></div>
            </div>
          </div>

          <div class="auth-form-group">
            <label class="auth-form-label">
              <i class="fas fa-check-double" style="color:#10B981;"></i>
              Confirm Password
            </label>
            <div class="auth-input-wrap">
              <i class="fas fa-lock auth-input-icon"></i>
              <input type="password" id="confirmPasswordInput" name="confirmPassword" class="auth-input" placeholder="Confirm password" required>
              <button type="button" class="auth-input-toggle" onclick="togglePassword('confirmPasswordInput', this)">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div class="auth-input-error" id="confirmError">Passwords do not match</div>
          </div>

          <button type="submit" class="auth-btn auth-btn-primary" id="resetBtn">
            <i class="fas fa-check"></i>
            Reset Password
          </button>

          <a href="/admin/login" class="auth-back-link"><i class="fas fa-arrow-left"></i>Back to Login</a>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>">
  function checkStrength(val) {
    var score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[a-z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    var fill = document.getElementById('strengthFill');
    var text = document.getElementById('strengthText');
    if (!fill || !text) return;

    var colors = ['', '#ef4444', '#f97316', '#f59e0b', '#22c55e', '#16a34a'];
    var labels = ['', 'Very Weak', 'Weak', 'Fair', 'Strong', 'Very Strong'];
    fill.style.width = (score * 20) + '%';
    fill.style.background = colors[score];
    text.textContent = val ? ('Strength: ' + labels[score]) : '';
    text.style.color = colors[score] || '#94a3b8';
  }

  var newPasswordInput = document.getElementById('newPasswordInput');
  if (newPasswordInput) {
    newPasswordInput.addEventListener('keyup', function() {
      checkStrength(this.value);
    });
  }

  var confirmPasswordInput = document.getElementById('confirmPasswordInput');
  if (confirmPasswordInput) {
    confirmPasswordInput.addEventListener('input', function() {
      var newPass = document.getElementById('newPasswordInput').value;
      var errEl = document.getElementById('confirmError');
      if (this.value && this.value !== newPass) {
        this.classList.add('error');
        errEl.classList.add('show');
        errEl.textContent = 'Passwords do not match';
      } else {
        this.classList.remove('error');
        errEl.classList.remove('show');
      }
    });
  }

  var resetForm = document.getElementById('resetForm');
  if (resetForm) {
    resetForm.addEventListener('submit', function(e) {
      var pass = document.getElementById('newPasswordInput');
      var confirmPass = document.getElementById('confirmPasswordInput');
      var errEl = document.getElementById('confirmError');

      if (!pass.value || !confirmPass.value || pass.value !== confirmPass.value) {
        e.preventDefault();
        confirmPass.classList.add('error');
        errEl.classList.add('show');
        errEl.textContent = 'Passwords do not match';
        return;
      }

      var btn = document.getElementById('resetBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting...';
    });
  }
</script>


