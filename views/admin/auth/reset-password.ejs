<div class="auth-container">
  <div class="auth-card">
    <h1 style="text-align: center; margin-bottom: var(--spacing-xl); color: var(--text-dark);">
      <i class="fas fa-lock" style="color: var(--primary); margin-right: var(--spacing-sm);"></i>
      Create New Password
    </h1>
    <p style="text-align: center; color: var(--text-light); margin-bottom: var(--spacing-xl);">
      Enter your new password below
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (typeof validToken !== 'undefined' && validToken === false && !error) { %>
      <div class="alert alert-error">This reset link is invalid or has expired.</div>
      <a href="/admin/forgot-password" class="btn btn-primary" style="width:100%;text-align:center;display:block;margin-top:var(--spacing-lg);">Request New Link</a>
    <% } else { %>

    <form method="POST" action="/admin/reset-password/<%= typeof token !== 'undefined' ? token : '' %>">
      <div class="form-group">
        <label class="form-label">New Password</label>
        <div style="position:relative;">
          <input type="password" id="passwordInput" name="password" class="form-input" placeholder="Enter new password" required>
          <button type="button" onclick="togglePwd('passwordInput',this)" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-light);cursor:pointer;">
            <i class="fas fa-eye"></i>
          </button>
        </div>
        <small style="color:var(--text-light);font-size:var(--text-xs);">At least 8 characters with uppercase, lowercase, number, and symbol</small>
      </div>

      <div class="form-group">
        <label class="form-label">Confirm Password</label>
        <div style="position:relative;">
          <input type="password" id="confirmInput" name="confirmPassword" class="form-input" placeholder="Confirm password" required>
          <button type="button" onclick="togglePwd('confirmInput',this)" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-light);cursor:pointer;">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <div style="margin-bottom:var(--spacing-lg);">
        <div style="width:100%;height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:4px;">
          <div id="strengthFill" style="height:100%;width:0%;background:var(--error);transition:all 0.3s;"></div>
        </div>
        <small id="strengthText" style="color:var(--text-light);">Password strength: —</small>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
        <i class="fas fa-check"></i> Reset Password
      </button>
    </form>

    <% } %>

    <div style="text-align:center;margin-top:var(--spacing-xl);">
      <a href="/admin/login" style="color:var(--primary);text-decoration:none;font-size:var(--text-sm);">
        <i class="fas fa-arrow-left"></i> Back to Login
      </a>
    </div>
  </div>
</div>

<script>
function togglePwd(id, btn) {
  const inp = document.getElementById(id);
  if (inp.type === 'password') { inp.type = 'text'; btn.innerHTML = '<i class="fas fa-eye-slash"></i>'; }
  else { inp.type = 'password'; btn.innerHTML = '<i class="fas fa-eye"></i>'; }
}
document.getElementById('passwordInput')?.addEventListener('input', function() {
  const val = this.value;
  const fill = document.getElementById('strengthFill');
  const text = document.getElementById('strengthText');
  let score = 0;
  if (val.length >= 8) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;
  const labels = ['—', 'Weak', 'Fair', 'Good', 'Strong'];
  const colors = ['var(--error)', 'var(--error)', 'var(--warning)', 'var(--primary)', 'var(--success)'];
  fill.style.width = (score * 25) + '%';
  fill.style.background = colors[score];
  text.textContent = 'Password strength: ' + labels[score];
});
</script>

