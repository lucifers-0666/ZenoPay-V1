<div id="bankFloatingDropdown" class="merchant-dropdown" style="display:none; position:fixed; z-index:99999; background:var(--card-bg); border:1px solid var(--border); border-radius:10px; box-shadow:var(--shadow-lg); min-width:200px; padding:6px 0;">
  <button id="ddEditBank" type="button" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 16px; background:none; border:none; text-align:left; color:var(--text-dark); font-size:0.84rem;"><i class="fas fa-pen-to-square" style="color:var(--primary); width:16px;"></i> Edit Bank</button>
  <button id="ddToggleUpi" type="button" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 16px; background:none; border:none; text-align:left; color:var(--text-dark); font-size:0.84rem;"><i class="fas fa-mobile-screen" style="color:var(--green-dark); width:16px;"></i> Toggle UPI</button>
  <button id="ddActivate" type="button" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 16px; background:none; border:none; text-align:left; color:var(--text-dark); font-size:0.84rem;"><i class="fas fa-circle-check" style="color:var(--green-dark); width:16px;"></i> Activate</button>
  <button id="ddDeactivate" type="button" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 16px; background:none; border:none; text-align:left; color:var(--text-dark); font-size:0.84rem;"><i class="fas fa-ban" style="color:var(--amber-dark); width:16px;"></i> Deactivate</button>
  <button id="ddDeleteBank" type="button" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 16px; background:none; border:none; text-align:left; color:var(--red-dark); font-size:0.84rem;"><i class="fas fa-trash" style="width:16px;"></i> Delete</button>
</div>

<script>
  (() => {
    Array.from(document.querySelectorAll('.coverage-fill')).forEach((bar) => {
      const width = Number.parseInt(bar.getAttribute('data-width') || '0', 10);
      bar.style.width = `${Number.isFinite(width) ? Math.max(0, Math.min(100, width)) : 0}%`;
      const color = bar.getAttribute('data-color');
      if (color) bar.style.background = color;
    });

    const bankSearch = document.getElementById('bankSearch');
    const statusFilter = document.getElementById('statusFilter');
    const typeFilter = document.getElementById('typeFilter');
    const resetFilters = document.getElementById('resetFilters');
    const rows = Array.from(document.querySelectorAll('#banksTableBody tr[data-search]'));

    const floatingDropdown = document.getElementById('bankFloatingDropdown');
    const ddActivate = document.getElementById('ddActivate');
    const ddDeactivate = document.getElementById('ddDeactivate');
    const ddEditBank = document.getElementById('ddEditBank');
    const ddDeleteBank = document.getElementById('ddDeleteBank');
    const ddToggleUpi = document.getElementById('ddToggleUpi');

    let activeBank = null;

    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type === 'error' ? 'admin-toast-error' : 'admin-toast-success'}`;
      toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i><span>${message}</span>`;
      document.body.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 250);
      }, 3000);
    }

    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('open');
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('open');
    }

    function closeFloatingDropdown() {
      if (floatingDropdown) {
        floatingDropdown.style.display = 'none';
        floatingDropdown._openBtn = null;
      }
    }

    window.toggleBankDropdown = function toggleBankDropdown(btn) {
      if (!floatingDropdown) return;

      if (floatingDropdown.style.display === 'block' && floatingDropdown._openBtn === btn) {
        closeFloatingDropdown();
        return;
      }

      activeBank = {
        id: btn.getAttribute('data-bank-id'),
        status: btn.getAttribute('data-bank-status') || 'inactive',
        upi: btn.getAttribute('data-bank-upi') === 'true',
        name: btn.getAttribute('data-bank-name') || '',
        bankCode: btn.getAttribute('data-bank-code') || '',
        ifscPrefix: btn.getAttribute('data-ifsc-prefix') || '',
        type: btn.getAttribute('data-bank-type') || 'public',
        priority: btn.getAttribute('data-bank-priority') || '99',
        logoUrl: btn.getAttribute('data-logo-url') || '',
        neft: btn.getAttribute('data-neft') === 'true',
        rtgs: btn.getAttribute('data-rtgs') === 'true',
        imps: btn.getAttribute('data-imps') === 'true'
      };

      ddActivate.style.display = activeBank.status !== 'active' ? 'flex' : 'none';
      ddDeactivate.style.display = activeBank.status === 'active' ? 'flex' : 'none';
      ddToggleUpi.innerHTML = activeBank.upi
        ? '<i class="fas fa-mobile-screen" style="color:var(--text-soft); width:16px;"></i> Disable UPI'
        : '<i class="fas fa-mobile-screen" style="color:var(--green-dark); width:16px;"></i> Enable UPI';

      floatingDropdown.style.display = 'block';
      const rect = btn.getBoundingClientRect();
      const width = 200;
      let left = rect.right - width;
      let top = rect.bottom + 4;
      const ddHeight = floatingDropdown.offsetHeight;

      if (top + ddHeight > window.innerHeight - 10) {
        top = rect.top - ddHeight - 4;
      }
      if (left < 8) left = 8;

      floatingDropdown.style.left = left + 'px';
      floatingDropdown.style.top = top + 'px';
      floatingDropdown._openBtn = btn;
    };

    window.toggleBankStatus = function toggleBankStatus(toggle) {
      var bankId = toggle.getAttribute('data-bank-id');
      var status = toggle.checked ? 'active' : 'inactive';
      fetch('/admin/banks/' + bankId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) {
          toggle.checked = !toggle.checked;
          alert('Error updating status');
          return;
        }
        showToast('Bank status updated');
      })
      .catch(function () {
        toggle.checked = !toggle.checked;
        alert('Error updating status');
      });
    };

    window.updatePriority = function updatePriority(input) {
      var bankId = input.getAttribute('data-bank-id');
      var priority = parseInt(input.value, 10);
      if (isNaN(priority) || priority < 1) {
        input.value = 99;
        return;
      }
      fetch('/admin/banks/' + bankId + '/priority', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ priority: priority })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.success) showToast('Priority updated');
      });
    };

    window.openEditModal = function openEditModal(bankId, bankName, bankCode, ifscPrefix, type, priority, logoUrl, upi, neft, rtgs, imps) {
      document.getElementById('editBankId').value = bankId;
      document.getElementById('editBankName').value = bankName || '';
      document.getElementById('editBankCode').value = bankCode || '';
      document.getElementById('editIfscPrefix').value = ifscPrefix || '';
      document.getElementById('editBankType').value = type || 'public';
      document.getElementById('editPriority').value = priority || 99;
      document.getElementById('editLogoUrl').value = logoUrl || '';
      document.getElementById('editUpiToggle').checked = !!upi;
      document.getElementById('editNeftToggle').checked = !!neft;
      document.getElementById('editRtgsToggle').checked = !!rtgs;
      document.getElementById('editImpsToggle').checked = !!imps;
      openModal('editBankModal');
    };

    window.openDeleteModal = function openDeleteModal(bankId, bankName) {
      document.getElementById('deleteBankId').value = bankId;
      document.getElementById('deleteBankName').textContent = bankName || '-';
      openModal('deleteBankModal');
    };

    function patchStatus(bankId, status) {
      return fetch('/admin/banks/' + bankId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: status })
      }).then(function (r) { return r.json(); });
    }

    function applyClientFilters() {
      var q = (bankSearch.value || '').trim().toLowerCase();
      var s = statusFilter.value;
      var t = typeFilter.value;

      rows.forEach(function (row) {
        var passQ = !q || (row.dataset.search || '').includes(q);
        var passS = s === 'all' || (row.dataset.status || '') === s;
        var passT = t === 'all' || (row.dataset.type || '') === t;
        row.style.display = passQ && passS && passT ? '' : 'none';
      });
    }

    document.addEventListener('click', function (e) {
      var openBtn = e.target.closest('[data-open-modal]');
      if (openBtn) {
        openModal(openBtn.getAttribute('data-open-modal'));
      }

      var closeBtn = e.target.closest('[data-close-modal]');
      if (closeBtn) {
        closeModal(closeBtn.getAttribute('data-close-modal'));
        return;
      }

      if (floatingDropdown && !e.target.closest('#bankFloatingDropdown') && !e.target.closest('.bank-action-btn')) {
        closeFloatingDropdown();
      }
    });

    window.addEventListener('scroll', function () { closeFloatingDropdown(); }, true);

    ddEditBank.addEventListener('click', function () {
      closeFloatingDropdown();
      if (!activeBank) return;
      openEditModal(
        activeBank.id,
        activeBank.name,
        activeBank.bankCode,
        activeBank.ifscPrefix,
        activeBank.type,
        activeBank.priority,
        activeBank.logoUrl,
        activeBank.upi,
        activeBank.neft,
        activeBank.rtgs,
        activeBank.imps
      );
    });

    ddToggleUpi.addEventListener('click', function () {
      closeFloatingDropdown();
      if (!activeBank) return;
      fetch('/admin/banks/' + activeBank.id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ upiEnabled: !activeBank.upi })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) {
          showToast(data.message || 'Failed to update UPI', 'error');
          return;
        }
        showToast('UPI mode updated');
        setTimeout(function () { window.location.reload(); }, 450);
      });
    });

    ddActivate.addEventListener('click', function () {
      closeFloatingDropdown();
      if (!activeBank) return;
      patchStatus(activeBank.id, 'active').then(function (data) {
        if (!data.success) return showToast(data.message || 'Failed to activate bank', 'error');
        showToast('Bank activated successfully');
        setTimeout(function () { window.location.reload(); }, 450);
      });
    });

    ddDeactivate.addEventListener('click', function () {
      closeFloatingDropdown();
      if (!activeBank) return;
      patchStatus(activeBank.id, 'inactive').then(function (data) {
        if (!data.success) return showToast(data.message || 'Failed to deactivate bank', 'error');
        showToast('Bank deactivated successfully');
        setTimeout(function () { window.location.reload(); }, 450);
      });
    });

    ddDeleteBank.addEventListener('click', function () {
      closeFloatingDropdown();
      if (!activeBank) return;
      openDeleteModal(activeBank.id, activeBank.name);
    });

    document.getElementById('addBankForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var body = {
        bankName: document.getElementById('addBankName').value,
        bankCode: document.getElementById('addBankCode').value.toUpperCase(),
        ifscPrefix: document.getElementById('addIfscPrefix').value.toUpperCase(),
        type: document.getElementById('addBankType').value,
        priority: document.getElementById('addPriority').value,
        logoUrl: document.getElementById('addLogoUrl').value,
        upiEnabled: document.getElementById('addUpiToggle').checked,
        neftEnabled: document.getElementById('addNeftToggle').checked,
        rtgsEnabled: document.getElementById('addRtgsToggle').checked,
        impsEnabled: document.getElementById('addImpsToggle').checked
      };

      fetch('/admin/banks/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) return showToast(data.message || 'Failed to add bank', 'error');
        showToast('Bank added successfully');
        closeModal('addBankModal');
        setTimeout(function () { window.location.reload(); }, 500);
      });
    });

    document.getElementById('editBankForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var bankId = document.getElementById('editBankId').value;
      var body = {
        bankName: document.getElementById('editBankName').value,
        bankCode: document.getElementById('editBankCode').value.toUpperCase(),
        ifscPrefix: document.getElementById('editIfscPrefix').value.toUpperCase(),
        type: document.getElementById('editBankType').value,
        priority: document.getElementById('editPriority').value,
        logoUrl: document.getElementById('editLogoUrl').value,
        upiEnabled: document.getElementById('editUpiToggle').checked,
        neftEnabled: document.getElementById('editNeftToggle').checked,
        rtgsEnabled: document.getElementById('editRtgsToggle').checked,
        impsEnabled: document.getElementById('editImpsToggle').checked
      };

      fetch('/admin/banks/' + bankId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) return showToast(data.message || 'Failed to update bank', 'error');
        showToast('Bank updated successfully');
        closeModal('editBankModal');
        setTimeout(function () { window.location.reload(); }, 500);
      });
    });

    document.getElementById('confirmDeleteBankBtn').addEventListener('click', function () {
      var bankId = document.getElementById('deleteBankId').value;
      fetch('/admin/banks/' + bankId, { method: 'DELETE' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) return showToast(data.message || 'Failed to delete bank', 'error');
        showToast('Bank deleted successfully');
        closeModal('deleteBankModal');
        setTimeout(function () { window.location.reload(); }, 500);
      });
    });

    bankSearch.addEventListener('input', applyClientFilters);
    statusFilter.addEventListener('change', applyClientFilters);
    typeFilter.addEventListener('change', applyClientFilters);

    resetFilters.addEventListener('click', function () {
      bankSearch.value = '';
      statusFilter.value = 'all';
      typeFilter.value = 'all';
      applyClientFilters();
    });
  })();
</script>
