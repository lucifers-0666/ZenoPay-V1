<!-- Blog Comments Moderation -->
<div class="page-header">
  <div>
    <h1 class="page-title">Blog Comments</h1>
    <p class="page-subtitle">Review and moderate reader comments.</p>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (comments && comments.length) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Author</th>
          <th>Comment</th>
          <th>Post</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% comments.forEach(function(comment) { %>
        <tr>
          <td>
            <strong><%= comment.author_name || 'Anonymous' %></strong><br>
            <small style="color:var(--text-light);"><%= comment.author_email || '' %></small>
          </td>
          <td style="max-width:300px;"><%= (comment.comment_text || '').substring(0, 120) %><%= (comment.comment_text || '').length > 120 ? '…' : '' %></td>
          <td><small><%= comment.post_id?.title || comment.post_id || '—' %></small></td>
          <td>
            <span class="badge badge-<%= comment.status === 'approved' ? 'success' : comment.status === 'rejected' ? 'danger' : 'warning' %>">
              <%= comment.status || 'pending' %>
            </span>
          </td>
          <td><small><%= comment.created_at ? new Date(comment.created_at).toLocaleDateString() : '—' %></small></td>
          <td style="display:flex;gap:6px;">
            <% if (comment.status !== 'approved') { %>
            <button onclick="moderateComment('<%= comment._id %>', 'approve')" class="btn-icon-sm" title="Approve" style="color:var(--success);"><i class="fas fa-check"></i></button>
            <% } %>
            <% if (comment.status !== 'rejected') { %>
            <button onclick="moderateComment('<%= comment._id %>', 'reject')" class="btn-icon-sm btn-danger-sm" title="Reject"><i class="fas fa-times"></i></button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="empty-state">No comments found.</p>
    <% } %>
  </div>
</div>

<script>
async function moderateComment(id, action) {
  try {
    const res = await fetch('/blog/admin/comments/' + id + '/' + action, { method: 'PUT' });
    if (res.ok) window.location.reload();
    else alert('Failed to ' + action + ' comment.');
  } catch(e) { alert('Error: ' + e.message); }
}
</script>
