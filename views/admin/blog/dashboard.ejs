<!-- Blog Admin Dashboard -->
<div class="page-header">
  <div>
    <h1 class="page-title">Blog Dashboard</h1>
    <p class="page-subtitle">Manage your blog content and monitor performance.</p>
  </div>
  <div class="page-actions">
    <a href="/blog/admin/posts/new" class="btn-primary">
      <i class="fas fa-plus"></i> New Post
    </a>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card blue">
    <div class="stat-icon-wrapper"><i class="fas fa-file-alt stat-icon"></i></div>
    <div class="stat-content">
      <p class="stat-label">Total Posts</p>
      <h3 class="stat-value"><%= stats?.totalPosts || 0 %></h3>
    </div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon-wrapper"><i class="fas fa-check-circle stat-icon"></i></div>
    <div class="stat-content">
      <p class="stat-label">Published</p>
      <h3 class="stat-value"><%= stats?.publishedPosts || 0 %></h3>
    </div>
  </div>
  <div class="stat-card purple">
    <div class="stat-icon-wrapper"><i class="fas fa-eye stat-icon"></i></div>
    <div class="stat-content">
      <p class="stat-label">Total Views</p>
      <h3 class="stat-value"><%= stats?.totalViews || 0 %></h3>
    </div>
  </div>
  <div class="stat-card orange">
    <div class="stat-icon-wrapper"><i class="fas fa-comments stat-icon"></i></div>
    <div class="stat-content">
      <p class="stat-label">Comments</p>
      <h3 class="stat-value"><%= stats?.totalComments || 0 %></h3>
    </div>
  </div>
</div>

<div class="card" style="margin-top:var(--spacing-xl);">
  <div class="card-header">
    <h2 class="card-title">Recent Posts</h2>
  </div>
  <div class="card-body">
    <% if (recentPosts && recentPosts.length) { %>
    <table class="data-table">
      <thead><tr><th>Title</th><th>Status</th><th>Views</th><th>Created</th><th>Actions</th></tr></thead>
      <tbody>
        <% recentPosts.forEach(function(post) { %>
        <tr>
          <td><%= post.title %></td>
          <td><span class="badge badge-<%= post.status === 'published' ? 'success' : 'warning' %>"><%= post.status %></span></td>
          <td><%= post.view_count || 0 %></td>
          <td><%= post.created_at ? new Date(post.created_at).toLocaleDateString() : '—' %></td>
          <td>
            <a href="/blog/admin/posts/<%= post._id %>/edit" class="btn-icon-sm"><i class="fas fa-edit"></i></a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="empty-state">No posts yet. <a href="/blog/admin/posts/new">Create your first post</a>.</p>
    <% } %>
  </div>
</div>
