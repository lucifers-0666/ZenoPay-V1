<!-- Blog Posts List -->
<div class="page-header">
  <div>
    <h1 class="page-title">Blog Posts</h1>
    <p class="page-subtitle">Manage all your blog articles.</p>
  </div>
  <div class="page-actions">
    <a href="/blog/admin/posts/new" class="btn-primary"><i class="fas fa-plus"></i> New Post</a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (posts && posts.length) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Status</th>
          <th>Views</th>
          <th>Published</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% posts.forEach(function(post) { %>
        <tr>
          <td><strong><%= post.title %></strong></td>
          <td><%= post.category_id?.name || '—' %></td>
          <td><span class="badge badge-<%= post.status === 'published' ? 'success' : 'warning' %>"><%= post.status %></span></td>
          <td><%= post.view_count || 0 %></td>
          <td><%= post.published_at ? new Date(post.published_at).toLocaleDateString() : '—' %></td>
          <td style="display:flex;gap:8px;">
            <a href="/blog/admin/posts/<%= post._id %>/edit" class="btn-icon-sm" title="Edit"><i class="fas fa-edit"></i></a>
            <button onclick="deletePost('<%= post._id %>')" class="btn-icon-sm btn-danger-sm" title="Delete"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="empty-state">No posts found. <a href="/blog/admin/posts/new">Create your first post</a>.</p>
    <% } %>
  </div>
</div>

<script>
async function deletePost(id) {
  if (!confirm('Delete this post?')) return;
  try {
    const res = await fetch('/blog/admin/posts/' + id, { method: 'DELETE' });
    if (res.ok) window.location.reload();
    else alert('Failed to delete post.');
  } catch(e) { alert('Error: ' + e.message); }
}
</script>
