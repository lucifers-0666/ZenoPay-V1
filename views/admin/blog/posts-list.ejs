<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Blog Posts</title></head>
<body>
  <h1>Blog Posts</h1>
  <ul>
    <% (posts || []).forEach(function(post){ %>
      <li><%= post.title %> - <%= post.status %></li>
    <% }) %>
  </ul>
</body></html>
