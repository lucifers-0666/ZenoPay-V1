<!-- Blog Tags -->
<div class="page-header">
  <div>
    <h1 class="page-title">Blog Tags</h1>
    <p class="page-subtitle">Manage tags to help readers discover related content.</p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--spacing-xl);">
  <!-- Tags List -->
  <div class="card">
    <div class="card-header"><h2 class="card-title">All Tags</h2></div>
    <div class="card-body">
      <% if (tags && tags.length) { %>
      <table class="data-table">
        <thead><tr><th>Name</th><th>Slug</th><th>Posts</th><th>Actions</th></tr></thead>
        <tbody>
          <% tags.forEach(function(tag) { %>
          <tr>
            <td><span class="badge badge-info"><%= tag.name %></span></td>
            <td><code style="font-size:var(--text-xs);background:var(--bg-secondary);padding:2px 6px;border-radius:4px;"><%= tag.slug %></code></td>
            <td><%= tag.post_count || 0 %></td>
            <td style="display:flex;gap:6px;">
              <button onclick="editTag('<%= tag._id %>', '<%= tag.name %>')" class="btn-icon-sm"><i class="fas fa-edit"></i></button>
              <button onclick="deleteTag('<%= tag._id %>')" class="btn-icon-sm btn-danger-sm"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <p class="empty-state">No tags yet.</p>
      <% } %>
    </div>
  </div>

  <!-- Add / Edit Tag -->
  <div class="card">
    <div class="card-header"><h2 class="card-title" id="tagFormTitle">Add New Tag</h2></div>
    <div class="card-body">
      <form id="tagForm" method="POST" action="/blog/admin/tags">
        <input type="hidden" id="tagId" name="_id">
        <input type="hidden" id="tagMethod" name="_method" value="">
        <div class="form-group">
          <label class="form-label">Tag Name *</label>
          <input type="text" id="tagName" name="name" class="form-input" required placeholder="Tag name">
        </div>
        <div style="display:flex;gap:8px;">
          <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save</button>
          <button type="button" onclick="resetTagForm()" class="btn-secondary">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function editTag(id, name) {
  document.getElementById('tagFormTitle').textContent = 'Edit Tag';
  document.getElementById('tagId').value = id;
  document.getElementById('tagName').value = name;
  document.getElementById('tagMethod').value = 'PUT';
  document.getElementById('tagForm').action = '/blog/admin/tags/' + id;
}
function resetTagForm() {
  document.getElementById('tagFormTitle').textContent = 'Add New Tag';
  document.getElementById('tagId').value = '';
  document.getElementById('tagName').value = '';
  document.getElementById('tagMethod').value = '';
  document.getElementById('tagForm').action = '/blog/admin/tags';
}
async function deleteTag(id) {
  if (!confirm('Delete this tag?')) return;
  try {
    const res = await fetch('/blog/admin/tags/' + id, { method: 'DELETE' });
    if (res.ok) window.location.reload();
    else alert('Failed to delete tag.');
  } catch(e) { alert('Error: ' + e.message); }
}
</script>
