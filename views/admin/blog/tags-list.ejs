<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Blog Tags</title></head>
<body>
  <h1>Blog Tags</h1>
  <ul>
    <% (tags || []).forEach(function(tag){ %>
      <li><%= tag.name %></li>
    <% }) %>
  </ul>
</body></html>
