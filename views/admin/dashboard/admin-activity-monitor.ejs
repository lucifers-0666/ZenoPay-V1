  .feed-badge.success { color: #22c55e; border-color: rgba(34,197,94,0.25); background: rgba(34,197,94,0.10); }
  .feed-badge.failed { color: #ef4444; border-color: rgba(239,68,68,0.25); background: rgba(239,68,68,0.10); }
  .feed-badge.user { color: #3B82F6; border-color: rgba(59,130,246,0.25); background: rgba(59,130,246,0.10); }
  .feed-badge.kyc { color: #f59e0b; border-color: rgba(245,158,11,0.25); background: rgba(245,158,11,0.10); }
  .feed-badge.support { color: #8B5CF6; border-color: rgba(139,92,246,0.25); background: rgba(139,92,246,0.10); }
  .feed-badge.admin { color: var(--slate-500); border-color: rgba(100,116,139,0.25); background: rgba(100,116,139,0.10); }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
    70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
  }

  @media (max-width: 1300px) {
    .monitor-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 1024px) {
    .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feed-row { grid-template-columns: auto 82px 1fr; }
    .feed-badge { display: none; }
  }

  @media (max-width: 640px) {
    .kpi-grid { grid-template-columns: 1fr; }
  }
</style>

<%
  const safeTransactions = Array.isArray(recentTransactions) ? recentTransactions : [];
  const safeUsers = Array.isArray(recentUsers) ? recentUsers : [];
  const safeAlerts = Array.isArray(recentAlerts) ? recentAlerts : [];
  const safeStats = systemStats || {};

  const toNum = (v) => {
    if (v === null || v === undefined) return 0;
    if (typeof v === 'number') return v;
    if (typeof v === 'string') return Number(v) || 0;
    if (typeof v === 'object' && v.$numberDecimal) return Number(v.$numberDecimal) || 0;
    if (typeof v.toString === 'function') return Number(v.toString()) || 0;
    return 0;
  };

  const initials = (name, email) => {
    const source = String(name || '').trim() || String(email || '').trim() || 'U';
    const words = source.split(/\s+/).filter(Boolean);
    if (words.length >= 2) return (words[0][0] + words[1][0]).toUpperCase();
    return source.slice(0, 2).toUpperCase();
  };

  const txnStatus = (s) => {
    const v = String(s || 'pending').toLowerCase();
    if (v === 'success') return 'success';
    if (v === 'failed') return 'failed';
    return 'pending';
  };

  const kycBadge = (u) => {
    const k = String(u.KYCStatus || '').toLowerCase();
    if (k === 'approved' || k === 'verified') return { cls: 'verified', icon: 'fa-shield-halved', text: 'verified' };
    if (k === 'pending') return { cls: 'pending', icon: 'fa-clock', text: 'pending' };
    return { cls: 'none', icon: 'fa-shield', text: 'none' };
  };

  const feedItems = [
    ...safeTransactions.map((t) => ({
      type: 'transaction',
      icon: String(t.Status || '').toLowerCase() === 'success' ? 'success' : 'failed',
      text: 'Transaction of ₹' + toNum(t.Amount).toLocaleString('en-IN') + ' — ' + String(t.Status || 'pending'),
      time: t.TransactionTime,
    })),
    ...safeUsers.map((u) => ({
      type: 'user',
      icon: 'user',
      text: 'New user registered: ' + (u.FullName || u.Email || 'Unknown'),
      time: u.RegistrationDate,
    })),
  ]
    .sort((a, b) => new Date(b.time || 0) - new Date(a.time || 0))
    .slice(0, 10);

  const uptimeSeconds = Number(safeStats.uptime || 0);
%>

<section class="activity-page">
  <header class="page-header">
    <div class="page-header-left">
      <div class="page-title-wrap">
        <div class="page-icon"><i class="fas fa-bolt"></i></div>
        <div>
          <h1 class="page-title">Activity Monitor</h1>
          <p class="page-subtitle">Real-time platform activity and system health</p>
        </div>
      </div>
      <div class="breadcrumb">
        <i class="fas fa-home"></i>
        <i class="fas fa-chevron-right"></i>
        <span>Dashboard</span>
        <i class="fas fa-chevron-right"></i>
        <span class="current">Activity Monitor</span>
      </div>
    </div>

    <div class="page-header-right">
      <span class="live-chip">
        <span class="live-dot"></span>
        Live
      </span>
      <button class="refresh-btn" type="button" onclick="location.reload()">
        <i class="fas fa-rotate-right"></i> Refresh
      </button>
    </div>
  </header>

  <section class="kpi-grid">
    <article class="kpi-card green">
      <div class="kpi-head">
        <p class="kpi-label">USERS ONLINE NOW</p>
        <span class="kpi-icon green"><i class="fas fa-circle-dot live-dot"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(totalUsersOnline || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Active in last 15 minutes</p>
    </article>

    <article class="kpi-card blue">
      <div class="kpi-head">
        <p class="kpi-label">NEW USERS TODAY</p>
        <span class="kpi-icon blue"><i class="fas fa-user-plus"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(newUsersToday || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Registered since midnight</p>
    </article>

    <article class="kpi-card purple">
      <div class="kpi-head">
        <p class="kpi-label">ACTIVE TRANSACTIONS</p>
        <span class="kpi-icon purple"><i class="fas fa-arrow-right-arrow-left"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(activeTransactions || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Processing right now</p>
    </article>

    <article class="kpi-card red" id="failedTodayCard">
      <div class="kpi-head">
        <p class="kpi-label">FAILED TODAY</p>
        <span class="kpi-icon red"><i class="fas fa-circle-xmark"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(failedToday || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Transactions failed</p>
    </article>

    <article class="kpi-card amber">
      <div class="kpi-head">
        <p class="kpi-label">PENDING KYC</p>
        <span class="kpi-icon amber"><i class="fas fa-id-card"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(pendingKYC || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Awaiting verification</p>
    </article>

    <article class="kpi-card orange">
      <div class="kpi-head">
        <p class="kpi-label">OPEN TICKETS</p>
        <span class="kpi-icon orange"><i class="fas fa-ticket"></i></span>
      </div>
      <h3 class="kpi-value"><%= Number(openTickets || 0).toLocaleString('en-IN') %></h3>
      <p class="kpi-subtext">Support tickets open</p>
    </article>
  </section>

  <section class="monitor-grid">
    <div>
      <article class="card">
        <div class="card-head">
          <div>
            <h3 class="card-title"><i class="fas fa-arrow-right-arrow-left"></i> Recent Transactions</h3>
            <p class="card-subtitle">Last 8 transactions</p>
          </div>
          <a class="card-link" href="/admin/transactions">View All</a>
        </div>
        <div class="card-body">
          <% if (safeTransactions.length) { %>
            <% safeTransactions.forEach((tx) => { const st = txnStatus(tx.Status); %>
              <div class="list-item">
                <div class="list-left">
                  <span class="avatar"><%= initials(tx.SenderHolderName, tx.SenderAccountNumber) %></span>
                  <div>
                    <p class="main-text"><%= tx.SenderHolderName || 'Unknown User' %></p>
                    <p class="sub-text mono">TXN-<%= tx.TransactionID || '-' %></p>
                  </div>
                </div>
                <div class="list-right">
                  <span class="amt <%= st %>">₹<%= toNum(tx.Amount).toLocaleString('en-IN') %></span>
                  <span class="badge <%= st %>"><%= st %></span>
                  <span class="time-text" data-timeago="<%= tx.TransactionTime %>"></span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">
              <i class="fas fa-receipt"></i>
              <h4>No recent transactions</h4>
            </div>
          <% } %>
        </div>
      </article>
    </div>

    <div>
      <article class="card">
        <div class="card-head">
          <div>
            <h3 class="card-title"><i class="fas fa-user-plus"></i> Recent Users</h3>
            <p class="card-subtitle">Newly registered accounts</p>
          </div>
          <a class="card-link" href="/admin/users">View All</a>
        </div>
        <div class="card-body">
          <% if (safeUsers.length) { %>
            <% safeUsers.forEach((u, idx) => { const kb = kycBadge(u); %>
              <div class="list-item">
                <div class="list-left">
                  <span class="avatar <%= idx % 4 === 0 ? 'secondary' : (idx % 4 === 1 ? 'green' : (idx % 4 === 2 ? 'amber' : 'gray')) %>"><%= initials(u.FullName, u.Email) %></span>
                  <div>
                    <p class="main-text"><%= u.FullName || 'Unknown' %></p>
                    <p class="sub-text"><%= u.Email || '-' %></p>
                    <span class="badge <%= kb.cls %>"><i class="fas <%= kb.icon %>"></i> <%= kb.text %></span>
                  </div>
                </div>
                <div class="list-right">
                  <span class="time-text" data-timeago="<%= u.RegistrationDate %>"></span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">
              <i class="fas fa-users"></i>
              <h4>No new registrations</h4>
            </div>
          <% } %>
        </div>
      </article>

      <article class="card health-card">
        <div class="card-head">
          <div>
            <h3 class="card-title"><i class="fas fa-server"></i> System Health</h3>
            <p class="card-subtitle">Current service status</p>
          </div>
        </div>
        <div class="card-body">
          <div class="health-row">
            <span class="health-label"><i class="fas fa-server"></i> API Server</span>
            <span class="health-value">
              <% if (String(safeStats.serverStatus || '').toLowerCase() === 'healthy') { %>
                <span class="status-dot dot-green"></span>Operational
              <% } else { %>
                <span class="status-dot dot-red"></span>Issues Detected
              <% } %>
            </span>
          </div>

          <div class="health-row">
            <span class="health-label"><i class="fas fa-database"></i> Database</span>
            <span class="health-value">
              <% if (String(safeStats.dbStatus || '').toLowerCase() === 'connected') { %>
                <span class="status-dot dot-green"></span>Connected
              <% } else { %>
                <span class="status-dot dot-red"></span>Disconnected
              <% } %>
            </span>
          </div>

          <div class="health-row">
            <span class="health-label"><i class="fas fa-globe"></i> Payment Gateway</span>
            <span class="health-value">
              <% if (String(safeStats.apiStatus || '').toLowerCase() === 'operational') { %>
                <span class="status-dot dot-green"></span>Operational
              <% } else { %>
                <span class="status-dot dot-red"></span>Degraded
              <% } %>
            </span>
          </div>

          <div class="health-row">
            <span class="health-label"><i class="fas fa-clock"></i> Server Uptime</span>
            <span class="health-value uptime-green" id="uptimeValue" data-seconds="<%= uptimeSeconds %>"></span>
          </div>
        </div>
      </article>
    </div>

    <div>
      <article class="card alerts-card">
        <div class="card-head">
          <div>
            <h3 class="card-title"><i class="fas fa-triangle-exclamation"></i> Recent Alerts</h3>
            <p class="card-subtitle">System warnings and errors</p>
          </div>
          <a class="card-link" href="/admin/audit-logs">View All</a>
        </div>
        <div class="card-body">
          <% if (safeAlerts.length) { %>
            <% safeAlerts.forEach((a) => {
              const st = String(a.status || '').toLowerCase();
              const isFailed = st === 'failed';
              const isWarning = st === 'warning';
              const boxCls = isFailed ? 'red' : (isWarning ? 'amber' : 'blue');
              const iconCls = isFailed ? 'fa-circle-xmark' : (isWarning ? 'fa-triangle-exclamation' : 'fa-circle-info');
            %>
              <div class="list-item">
                <div class="list-left">
                  <span class="icon-box <%= boxCls %>"><i class="fas <%= iconCls %>"></i></span>
                  <div>
                    <p class="main-text"><%= a.action || 'System alert' %></p>
                    <p class="alert-desc"><%= a.description || 'No description provided.' %></p>
                  </div>
                </div>
                <div class="list-right">
                  <span class="time-text" data-timeago="<%= a.createdAt %>"></span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">
              <i class="fas fa-circle-check" style="font-size:64px; color:#22c55e;"></i>
              <h4>No alerts</h4>
              <p>System is running normally</p>
            </div>
          <% } %>
        </div>
      </article>

      <article class="card quick-actions">
        <div class="card-head">
          <div>
            <h3 class="card-title"><i class="fas fa-bolt"></i> Quick Actions</h3>
            <p class="card-subtitle">Common admin shortcuts</p>
          </div>
        </div>

        <div class="quick-actions-grid">
          <a href="/admin/users" class="quick-action-btn"><span class="quick-action-icon qa-blue"><i class="fas fa-user-plus"></i></span><span>Add New User</span></a>
          <a href="/admin/transactions/flagged" class="quick-action-btn"><span class="quick-action-icon qa-red"><i class="fas fa-flag"></i></span><span>Review Flagged</span></a>
          <a href="/admin/kyc" class="quick-action-btn"><span class="quick-action-icon qa-amber"><i class="fas fa-id-card"></i></span><span>KYC Review</span></a>
          <a href="/admin/support" class="quick-action-btn"><span class="quick-action-icon qa-purple"><i class="fas fa-ticket"></i></span><span>Support Queue</span></a>
          <a href="/admin/refunds" class="quick-action-btn"><span class="quick-action-icon qa-orange"><i class="fas fa-rotate-left"></i></span><span>Pending Refunds</span></a>
          <a href="/admin/audit-logs" class="quick-action-btn"><span class="quick-action-icon qa-gray"><i class="fas fa-scroll"></i></span><span>Audit Logs</span></a>
        </div>
      </article>
    </div>
  </section>

  <section class="card feed-card">
    <div class="card-head">
      <div>
        <h3 class="card-title"><i class="fas fa-rss"></i> Live Activity Feed</h3>
        <p class="card-subtitle">Real-time platform events</p>
      </div>
      <div class="feed-head-right">
        <label class="toggle-row">
          Auto-refresh
          <div class="toggle-switch">
            <input type="checkbox" id="autoRefreshToggle" checked>
            <span class="toggle-slider"></span>
          </div>
        </label>
        <span id="refreshCountdown" class="countdown">Refreshing in 30s</span>
      </div>
    </div>

    <div class="feed-body">
      <% if (feedItems.length) { %>
        <% feedItems.forEach((item) => {
          const type = item.type === 'user' ? 'user' : (item.icon === 'success' ? 'success' : 'failed');
          const dotClass = item.type === 'user' ? 'blue' : (item.icon === 'success' ? 'green' : 'red');
          const badgeClass = item.type === 'user' ? 'user' : (item.icon === 'success' ? 'success' : 'failed');
        %>
          <div class="feed-row">
            <span class="feed-dot <%= dotClass %>"></span>
            <span class="feed-time" data-timeago="<%= item.time %>"></span>
            <span class="feed-text"><%= item.text %></span>
            <span class="feed-badge <%= badgeClass %>"><%= type %></span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-rss"></i>
          <h4>No recent activity</h4>
        </div>
      <% } %>
    </div>
  </section>
</section>

<script>
  function formatUptime(seconds) {
    var d = Math.floor(seconds / 86400);
    var h = Math.floor((seconds % 86400) / 3600);
    var m = Math.floor((seconds % 3600) / 60);
    return d + 'd ' + h + 'h ' + m + 'm';
  }

  function timeAgo(dateStr) {
    var diff = Math.floor((Date.now() - new Date(dateStr)) / 1000);
    if (!Number.isFinite(diff) || diff < 0) return 'now';
    if (diff < 60) return diff + 's ago';
    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
    return Math.floor(diff / 86400) + 'd ago';
  }

  var refreshInterval = null;
  var countdown = 30;

  function startAutoRefresh() {
    if (refreshInterval) clearInterval(refreshInterval);
    countdown = 30;
    var el = document.getElementById('refreshCountdown');
    if (el) el.textContent = 'Refreshing in ' + countdown + 's';

    refreshInterval = setInterval(function() {
      countdown--;
      var countdownEl = document.getElementById('refreshCountdown');
      if (countdownEl) countdownEl.textContent = 'Refreshing in ' + countdown + 's';
      if (countdown <= 0) location.reload();
    }, 1000);
  }

  document.addEventListener('DOMContentLoaded', function() {
    var uptimeEl = document.getElementById('uptimeValue');
    if (uptimeEl) {
      var sec = Number(uptimeEl.getAttribute('data-seconds') || 0);
      uptimeEl.textContent = formatUptime(sec);
    }

    document.querySelectorAll('[data-timeago]').forEach(function(el) {
      el.textContent = timeAgo(el.getAttribute('data-timeago'));
    });

    var autoToggle = document.getElementById('autoRefreshToggle');
    if (autoToggle) {
      autoToggle.addEventListener('change', function() {
        if (this.checked) {
          startAutoRefresh();
        } else {
          if (refreshInterval) clearInterval(refreshInterval);
          var c = document.getElementById('refreshCountdown');
          if (c) c.textContent = 'Auto-refresh off';
        }
      });
    }

    startAutoRefresh();

    var failedCard = document.getElementById('failedTodayCard');
    var failedVal = parseInt(failedCard && failedCard.querySelector('.kpi-value')
      ? failedCard.querySelector('.kpi-value').textContent.replace(/,/g, '')
      : '0', 10);
    if (failedVal > 0 && failedCard) {
      failedCard.style.background = 'rgba(239,68,68,0.04)';
    }
  });
</script>
