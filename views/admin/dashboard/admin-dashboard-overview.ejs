          <tr>
            <th>Transaction ID</th>
            <th>User</th>
            <th>Amount</th>
            <th>Type</th>
            <th>Status</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#ZP-8X7K</span></td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3B82F6,#8B5CF6);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px">R</div><span>Rahul S.</span></div></td>
            <td style="font-weight:700">₹5,000</td>
            <td><span class="badge badge-info">Transfer</span></td>
            <td><span class="badge badge-success"><i class="fas fa-check-circle"></i> Success</span></td>
            <td style="color:var(--text-soft)">2m ago</td>
          </tr>
          <tr>
            <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#ZP-7H2Q</span></td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#10B981,#059669);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px">P</div><span>Priya M.</span></div></td>
            <td style="font-weight:700">₹12,450</td>
            <td><span class="badge badge-purple">Merchant</span></td>
            <td><span class="badge badge-success"><i class="fas fa-check-circle"></i> Success</span></td>
            <td style="color:var(--text-soft)">8m ago</td>
          </tr>
          <tr>
            <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#ZP-4D9N</span></td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#8B5CF6,#7C3AED);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px">A</div><span>Arjun K.</span></div></td>
            <td style="font-weight:700">₹1,980</td>
