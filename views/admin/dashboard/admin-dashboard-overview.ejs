<% page = 'dashboard'; %>

<%
  const d = dashboard || {};
  const m = d.metrics || {};
  const recentTx = Array.isArray(d.recentTransactions) ? d.recentTransactions : [];
  const activity = Array.isArray(d.activity) ? d.activity : [];
  const charts = d.charts || {};

  const usersGrowth = Number(m.usersGrowthPct || 0);
  const txGrowth = Number(m.txGrowthPct || 0);
  const merchantGrowth = Number(m.merchantsGrowthPct || 0);
%>

<script nonce="<%= locals.cspNonce || '' %>">
  window.__ADMIN_DASHBOARD_CHARTS = <%- JSON.stringify(charts) %>;
</script>

<div class="page-header">
  <div class="page-header-left">
    <h1 class="page-title">Dashboard Overview</h1>
    <p class="page-subtitle">Welcome back! Here's what's happening today.</p>
  </div>
  <div class="page-header-right">
    <span class="live-indicator">
      <span class="live-dot"></span> Live
    </span>
    <button class="btn btn-outline btn-sm" id="refreshBtn">
      <i class="fas fa-sync-alt"></i> Refresh
    </button>
    <button class="btn btn-primary btn-sm">
      <i class="fas fa-download"></i> Export
    </button>
  </div>
</div>

<div class="stats-section">

  <div class="stats-row stats-row-top">
    <div class="stat-card" style="animation-delay:0s">
      <div class="icon-sq icon-sq-lg icon-blue"><i class="fas fa-users"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Total Users</div>
        <div class="stat-card-value stat-value" data-count="<%= Number(m.totalUsers || 0) %>"><%= Number(m.totalUsers || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= usersGrowth >= 0 ? 'positive' : 'negative' %>">
          <i class="fas <%= usersGrowth >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %>"></i>
          <span class="pct"><%= Math.abs(usersGrowth).toFixed(1) %>%</span>
          <span class="label">vs last month</span>
        </span>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.05s">
      <div class="icon-sq icon-sq-lg icon-green"><i class="fas fa-exchange-alt"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Total Transactions</div>
        <div class="stat-card-value stat-value" data-count="<%= Number(m.totalTransactions || 0) %>"><%= Number(m.totalTransactions || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= txGrowth >= 0 ? 'positive' : 'negative' %>">
          <i class="fas <%= txGrowth >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %>"></i>
          <span class="pct"><%= Math.abs(txGrowth).toFixed(1) %>%</span>
          <span class="label">vs last month</span>
        </span>
        <div class="stat-card-sub muted" style="margin-top:4px;font-size:.82rem;">Volume: <%= m.totalVolumeText || '₹0' %></div>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.10s">
      <div class="icon-sq icon-sq-lg icon-purple"><i class="fas fa-store"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Active Merchants</div>
        <div class="stat-card-value stat-value" data-count="<%= Number(m.activeMerchants || 0) %>"><%= Number(m.activeMerchants || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= merchantGrowth >= 0 ? 'positive' : 'negative' %>">
          <i class="fas <%= merchantGrowth >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %>"></i>
          <span class="pct"><%= Math.abs(merchantGrowth).toFixed(1) %>%</span>
          <span class="label">vs last month</span>
        </span>
      </div>
    </div>
  </div>

  <div class="stats-row stats-row-bottom">
    <div class="stat-card" style="animation-delay:0.15s">
      <div class="icon-sq icon-sq-lg icon-amber"><i class="fas fa-clock"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Pending Approvals</div>
        <div class="stat-card-value amber"><%= Number(m.pendingApprovals || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change warning">
          <i class="fas fa-circle-exclamation"></i>
          <span class="pct">Needs attention</span>
        </span>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.20s">
      <div class="icon-sq icon-sq-lg icon-red"><i class="fas fa-flag"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Flagged Transactions</div>
        <div class="stat-card-value red"><%= Number(m.flaggedTransactions || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change negative">
          <i class="fas fa-arrow-down"></i>
          <span class="label">Needs review</span>
        </span>
      </div>
    </div>
  </div>

</div>

<div class="charts-row">

  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title">
        <div class="chart-icon" style="background: linear-gradient(135deg, #3B82F6, #2563EB);">
          <i class="fas fa-chart-line"></i>
        </div>
        Transaction Volume
      </div>
      <div class="chart-period-tabs">
        <button class="chart-period-tab active" data-period="7d">7D</button>
        <button class="chart-period-tab" data-period="30d">30D</button>
        <button class="chart-period-tab" data-period="90d">90D</button>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="transactionVolumeChart"></canvas>
    </div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title">
        <div class="chart-icon" style="background: linear-gradient(135deg, #8B5CF6, #7C3AED);">
          <i class="fas fa-user-plus"></i>
        </div>
        User Growth
      </div>
      <span class="chart-trend-badge <%= usersGrowth >= 0 ? 'up' : 'down' %>">
        <i class="fas <%= usersGrowth >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %>" style="font-size:11px;"></i>
        <%= usersGrowth >= 0 ? '+' : '-' %><%= Math.abs(usersGrowth).toFixed(1) %>%
      </span>
    </div>
    <div class="chart-container">
      <canvas id="userGrowthChart"></canvas>
    </div>
  </div>

</div>

<div class="bottom-row">

  <div class="admin-card">
    <div class="admin-card-header">
      <div class="admin-card-title">
        <div class="icon-sq icon-green"><i class="fas fa-exchange-alt"></i></div>
        Recent Transactions
      </div>
      <a href="/admin/transactions" class="btn btn-outline btn-sm">View All</a>
    </div>
    <div class="table-wrap" style="border:none;box-shadow:none;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Transaction ID</th>
            <th>User</th>
            <th>Amount</th>
            <th>Type</th>
            <th>Status</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentTx.length) { %>
            <% recentTx.forEach(function(tx) { %>
              <% const tone = tx.status === 'success' ? 'success' : tx.status === 'failed' ? 'danger' : 'warning'; %>
              <tr>
                <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#<%= tx.id || 'N/A' %></span></td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px">
                    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3B82F6,#8B5CF6);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px"><%= tx.initials || 'U' %></div>
                    <span><%= tx.userName || 'Unknown User' %></span>
                  </div>
                </td>
                <td style="font-weight:700"><%= tx.amountText || '₹0' %></td>
                <td><span class="badge badge-info"><%= tx.type || 'Transaction' %></span></td>
                <td><span class="badge badge-<%= tone %>"><i class="fas <%= tx.status === 'success' ? 'fa-check-circle' : tx.status === 'failed' ? 'fa-times-circle' : 'fa-clock' %>"></i> <%= (tx.status || 'pending').charAt(0).toUpperCase() + (tx.status || 'pending').slice(1) %></span></td>
                <td style="color:var(--text-soft)"><%= tx.timeAgo || '-' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align:center;color:var(--text-soft);padding:18px;">No recent transactions found in database.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <div class="admin-card-title">
        <div class="icon-sq icon-amber"><i class="fas fa-bolt"></i></div>
        Live Activity
      </div>
      <span class="live-indicator"><span class="live-dot"></span> Live</span>
    </div>
    <div class="activity-feed" id="activityFeed">
      <% if (activity.length) { %>
        <% activity.forEach(function(item) { %>
          <div class="activity-item">
            <div class="activity-dot <%= item.tone || 'blue' %>"></div>
            <div class="activity-body">
              <p class="activity-text"><%= item.text || 'Activity update' %></p>
              <span class="activity-time"><%= item.timeAgo || '-' %></span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="activity-item">
          <div class="activity-dot blue"></div>
          <div class="activity-body">
            <p class="activity-text">No live activity found in database yet.</p>
            <span class="activity-time">-</span>
          </div>
        </div>
      <% } %>
    </div>
  </div>

</div>

