          </tr>
          <tr>
            <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#ZP-2L6T</span></td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#F59E0B,#D97706);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px">S</div><span>Sonia R.</span></div></td>
            <td style="font-weight:700">₹22,000</td>
            <td><span class="badge badge-info">Bank</span></td>
            <td><span class="badge badge-danger"><i class="fas fa-times-circle"></i> Failed</span></td>
            <td style="color:var(--text-soft)">21m ago</td>
          </tr>
          <tr>
            <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#ZP-9M3W</span></td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#EF4444,#DC2626);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px">N</div><span>Neeraj V.</span></div></td>
            <td style="font-weight:700">₹7,200</td>
            <td><span class="badge badge-purple">Merchant</span></td>
            <td><span class="badge badge-success"><i class="fas fa-check-circle"></i> Success</span></td>
            <td style="color:var(--text-soft)">30m ago</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <div class="admin-card-title">
        <div class="icon-sq icon-amber"><i class="fas fa-bolt"></i></div>
        Live Activity
      </div>
      <span class="live-indicator"><span class="live-dot"></span> Live</span>
    </div>
    <div class="activity-feed" id="activityFeed">
      <div class="activity-item">
        <div class="activity-dot green"></div>
        <div class="activity-body">
          <p class="activity-text">New user <strong>Priya M.</strong> registered</p>
          <span class="activity-time">1 min ago</span>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-dot blue"></div>
        <div class="activity-body">
          <p class="activity-text">Merchant <strong>UrbanKart</strong> submitted KYC</p>
          <span class="activity-time">3 min ago</span>
        </div>
