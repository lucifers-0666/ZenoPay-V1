<%
  page = 'dashboard';
  const d = dashboard || {};
  const m = d.metrics || {};
  const recentTransactions = Array.isArray(d.recentTransactions) ? d.recentTransactions : [];
  const activity = Array.isArray(d.activity) ? d.activity : [];
  const charts = d.charts || { tx: {}, users: {} };

  const trendClass = (pct) => Number(pct || 0) >= 0 ? 'positive' : 'negative';
  const trendIcon = (pct) => Number(pct || 0) >= 0 ? 'fa-arrow-up' : 'fa-arrow-down';
  const fmtPct = (pct) => `${Math.abs(Number(pct || 0)).toFixed(1)}%`;

  const statusClass = (status) => {
    const s = String(status || '').toLowerCase();
    if (s === 'success') return 'badge-success';
    if (s === 'failed') return 'badge-danger';
    return 'badge-warning';
  };

  const statusIcon = (status) => {
    const s = String(status || '').toLowerCase();
    if (s === 'success') return 'fa-check-circle';
    if (s === 'failed') return 'fa-times-circle';
    return 'fa-clock';
  };

  const statusLabel = (status) => {
    const s = String(status || '').toLowerCase();
    if (s === 'success') return 'Success';
    if (s === 'failed') return 'Failed';
    return 'Pending';
  };

  const activityToneClass = (tone) => {
    const t = String(tone || '').toLowerCase();
    if (t === 'green') return 'green';
    if (t === 'red') return 'red';
    if (t === 'amber') return 'amber';
    return 'blue';
  };
%>

<div id="adminDashboardData" data-charts='<%- JSON.stringify(charts) %>' style="display:none" aria-hidden="true"></div>

<div class="page-header">
  <div class="page-header-left">
    <h1 class="page-title">Dashboard Overview</h1>
    <p class="page-subtitle">Live data from your database only.</p>
  </div>
  <div class="page-header-right">
    <span class="live-indicator">
      <span class="live-dot"></span> Live
    </span>
    <button class="btn btn-outline btn-sm" id="refreshBtn" onclick="window.location.reload()">
      <i class="fas fa-sync-alt"></i> Refresh
    </button>
    <a href="/admin/reports/export" class="btn btn-primary btn-sm">
      <i class="fas fa-download"></i> Export
    </a>
  </div>
</div>

<div class="stats-section">
  <div class="stats-row stats-row-top">
    <div class="stat-card" style="animation-delay:0s">
      <div class="icon-sq icon-sq-lg icon-blue"><i class="fas fa-users"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Total Users</div>
        <div class="stat-card-value"><%= Number(m.totalUsers || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= trendClass(m.usersGrowthPct) %>">
          <i class="fas <%= trendIcon(m.usersGrowthPct) %>"></i>
          <span class="pct"><%= fmtPct(m.usersGrowthPct) %></span>
          <span class="label">vs previous 30 days</span>
        </span>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.05s">
      <div class="icon-sq icon-sq-lg icon-green"><i class="fas fa-exchange-alt"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Total Transactions</div>
        <div class="stat-card-value"><%= Number(m.totalTransactions || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= trendClass(m.txGrowthPct) %>">
          <i class="fas <%= trendIcon(m.txGrowthPct) %>"></i>
          <span class="pct"><%= fmtPct(m.txGrowthPct) %></span>
          <span class="label">vs previous 30 days</span>
        </span>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.10s">
      <div class="icon-sq icon-sq-lg icon-purple"><i class="fas fa-store"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Active Merchants</div>
        <div class="stat-card-value"><%= Number(m.activeMerchants || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change <%= trendClass(m.merchantsGrowthPct) %>">
          <i class="fas <%= trendIcon(m.merchantsGrowthPct) %>"></i>
          <span class="pct"><%= fmtPct(m.merchantsGrowthPct) %></span>
          <span class="label">vs previous 30 days</span>
        </span>
      </div>
    </div>
  </div>

  <div class="stats-row stats-row-bottom">
    <div class="stat-card" style="animation-delay:0.15s">
      <div class="icon-sq icon-sq-lg icon-amber"><i class="fas fa-clock"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Pending Approvals</div>
        <div class="stat-card-value amber"><%= Number(m.pendingApprovals || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change warning">
          <i class="fas fa-circle-exclamation"></i>
          <span class="pct">Requires attention</span>
        </span>
      </div>
    </div>

    <div class="stat-card" style="animation-delay:0.20s">
      <div class="icon-sq icon-sq-lg icon-red"><i class="fas fa-flag"></i></div>
      <div class="stat-card-info">
        <div class="stat-card-label">Flagged / Failed</div>
        <div class="stat-card-value red"><%= Number(m.flaggedTransactions || 0).toLocaleString('en-IN') %></div>
        <span class="stat-change negative">
          <i class="fas fa-arrow-down"></i>
          <span class="label">Needs review</span>
        </span>
      </div>
    </div>
  </div>
</div>

<div class="charts-row">
  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title">
        <div class="chart-icon" style="background: linear-gradient(135deg, #3B82F6, #2563EB);">
          <i class="fas fa-chart-line"></i>
        </div>
        Transaction Volume
      </div>
      <div class="chart-period-tabs">
        <button class="chart-period-tab active" data-period="7d">7D</button>
        <button class="chart-period-tab" data-period="30d">30D</button>
        <button class="chart-period-tab" data-period="90d">90D</button>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="transactionVolumeChart"></canvas>
    </div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title">
        <div class="chart-icon" style="background: linear-gradient(135deg, #8B5CF6, #7C3AED);">
          <i class="fas fa-user-plus"></i>
        </div>
        User Growth
      </div>
      <span class="chart-trend-badge <%= trendClass(m.usersGrowthPct) === 'positive' ? 'up' : '' %>">
        <i class="fas <%= trendIcon(m.usersGrowthPct) %>" style="font-size:11px;"></i>
        <%= fmtPct(m.usersGrowthPct) %>
      </span>
    </div>
    <div class="chart-container">
      <canvas id="userGrowthChart"></canvas>
    </div>
  </div>
</div>

<div class="bottom-row">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="admin-card-title">
        <div class="icon-sq icon-green"><i class="fas fa-exchange-alt"></i></div>
        Recent Transactions
      </div>
      <a href="/admin/transactions" class="btn btn-outline btn-sm">View All</a>
    </div>

    <div class="table-wrap" style="border:none;box-shadow:none;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Transaction ID</th>
            <th>User</th>
            <th>Amount</th>
            <th>Type</th>
            <th>Status</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <% if (!recentTransactions.length) { %>
            <tr>
              <td colspan="6" style="text-align:center;color:var(--text-soft);padding:18px;">No recent transactions found</td>
            </tr>
          <% } %>

          <% recentTransactions.forEach((tx) => { %>
            <tr>
              <td><span style="font-family:monospace;color:var(--primary);font-weight:600">#<%= tx.id %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3B82F6,#8B5CF6);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:12px"><%= tx.initials %></div>
                  <span><%= tx.userName %></span>
                </div>
              </td>
              <td style="font-weight:700"><%= tx.amountText %></td>
              <td><span class="badge badge-info"><%= tx.type %></span></td>
              <td><span class="badge <%= statusClass(tx.status) %>"><i class="fas <%= statusIcon(tx.status) %>"></i> <%= statusLabel(tx.status) %></span></td>
              <td style="color:var(--text-soft)"><%= tx.timeAgo %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <div class="admin-card-title">
        <div class="icon-sq icon-amber"><i class="fas fa-bolt"></i></div>
        Live Activity
      </div>
      <span class="live-indicator"><span class="live-dot"></span> Live</span>
    </div>

    <div class="activity-feed" id="activityFeed">
      <% if (!activity.length) { %>
        <div class="activity-item">
          <div class="activity-dot blue"></div>
          <div class="activity-body">
            <p class="activity-text">No recent activity found</p>
            <span class="activity-time">just now</span>
          </div>
        </div>
      <% } %>

      <% activity.forEach((item) => { %>
        <div class="activity-item">
          <div class="activity-dot <%= activityToneClass(item.tone) %>"></div>
          <div class="activity-body">
            <p class="activity-text"><%= item.text %></p>
            <span class="activity-time"><%= item.timeAgo %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
