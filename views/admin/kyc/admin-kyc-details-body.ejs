  }
  .risk-flag-row p { flex: 1; font-size: 13px; font-weight: 500; color: var(--text-main); }

  .risk-flag-row.high .flag-icon { background: color-mix(in srgb, var(--red) 16%, var(--card-bg)); color: var(--red); }
  .risk-flag-row.medium .flag-icon { background: color-mix(in srgb, var(--amber) 16%, var(--card-bg)); color: var(--amber-dark); }
  .risk-flag-row.low .flag-icon { background: color-mix(in srgb, var(--green) 16%, var(--card-bg)); color: var(--green); }

  .flag-pill { font-size: 10px; font-weight: 700; border-radius: 9999px; padding: 3px 8px; }
  .flag-pill.high { color: var(--red); background: color-mix(in srgb, var(--red) 14%, var(--card-bg)); }
  .flag-pill.medium { color: var(--amber-dark); background: color-mix(in srgb, var(--amber) 14%, var(--card-bg)); }
  .flag-pill.low { color: var(--green); background: color-mix(in srgb, var(--green) 14%, var(--card-bg)); }

  .decision-panel { border: 1.5px solid var(--primary); }
  .decision-title { display: inline-flex; align-items: center; gap: 8px; color: var(--primary); font-weight: 800; font-size: 15px; margin-bottom: 12px; }
  .decision-stack { display: grid; gap: 10px; }
  .note-label { display: block; margin-top: 14px; font-size: 12px; color: var(--text-soft); font-weight: 700; }
  .note-label small { font-weight: 500; margin-left: 4px; }
  .save-note-btn {
    width: 100%;
    margin-top: 8px;
    height: 36px;
    border-radius: 9999px;
    border: 1px solid var(--primary);
    color: var(--primary);
    background: transparent;
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }
  .save-note-btn:hover { background: color-mix(in srgb, var(--primary) 8%, var(--card-bg)); }

  .timeline-wrap { position: relative; margin-top: 2px; }
  .timeline-item { position: relative; padding-left: 24px; min-height: 48px; }
  .timeline-item .dot { position: absolute; left: 0; top: 5px; width: 9px; height: 9px; border-radius: 9999px; }
  .timeline-item .dot.blue { background: var(--primary); }
  .timeline-item .dot.slate { background: var(--text-soft); }
  .timeline-item .dot.amber { background: var(--amber); }
  .timeline-item .dot.purple { background: var(--secondary); }
  .timeline-item .line { position: absolute; left: 4px; top: 15px; width: 2px; height: calc(100% - 14px); background: var(--border-light); }

  .event-time { font-size: 11px; color: var(--text-soft); }
  .event-action { margin-top: 2px; font-size: 13px; font-weight: 600; color: var(--text-main); }
  .event-admin { margin-top: 1px; font-size: 12px; color: var(--text-soft); }
  .log-link { margin-top: 6px; display: inline-flex; font-size: 12px; font-weight: 700; color: var(--primary); }

  .kyc-modal-card { max-width: 470px; }
  .kyc-modal-copy { font-size: 14px; color: var(--text-mid); }
  .kyc-modal-head-green { background: linear-gradient(135deg, var(--green), var(--green-dark)); }
  .kyc-modal-head-red { background: linear-gradient(135deg, var(--red), var(--red-dark)); }
  .kyc-modal-head-blue { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); }

  .check-item { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-mid); margin-bottom: 8px; }

  @media (max-width: 1220px) {
    .kyc-details-grid { grid-template-columns: 1fr; }
