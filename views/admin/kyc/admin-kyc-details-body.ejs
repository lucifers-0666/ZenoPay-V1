  }

  @media (max-width: 900px) {
    .kyc-details-topline { flex-direction: column; align-items: flex-start; }
    .kyc-header-actions { width: 100%; }
    .kyc-head-btn { flex: 1; justify-content: center; }
    .context-grid { grid-template-columns: 1fr; }
  }
</style>

<script nonce="<%= locals.cspNonce || '' %>">
  (function () {
    const seedNode = document.getElementById('kycDetailsSeed');
    const details = seedNode ? JSON.parse(seedNode.textContent || '{}') : {};

    const zenoPayId = encodeURIComponent(details.zenoPayId || '');
    const tabs = Array.isArray(details.documentTabs) ? details.documentTabs : [];

    const tabBar = document.getElementById('docTabBar');
    const docImage = document.getElementById('docImage');
    const docEmpty = document.getElementById('docEmpty');
    const fullBtn = document.getElementById('fullscreenBtn');
    const downloadCurrent = document.getElementById('downloadCurrentDoc');
    const zoomInBtn = document.getElementById('zoomInBtn');
    const zoomOutBtn = document.getElementById('zoomOutBtn');
    const rotateBtn = document.getElementById('rotateBtn');
    const riskFill = document.getElementById('riskGaugeFill');

    let currentTab = tabs[0] || null;
    let zoom = 1;
    let rotation = 0;

    function showToast(message, type) {
      if (window.showToast) {
        window.showToast(message, type || 'success');
        return;
      }
      const toast = document.createElement('div');
      toast.className = `admin-toast admin-toast-${type === 'error' ? 'error' : 'success'}`;
      toast.innerHTML = `<i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i><span>${message}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 10);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 2600);
    }

    function updateDocTransform() {
      if (!docImage) return;
      docImage.style.transform = `scale(${zoom}) rotate(${rotation}deg)`;
    }

    function renderTabs() {
      if (!tabBar) return;

      tabBar.innerHTML = tabs.map((tab) => {
        const hasSrc = Boolean(tab.src);
        return `
          <button type="button" class="doc-tab ${currentTab?.key === tab.key ? 'active' : ''}" data-tab-key="${tab.key}">
            <span>${tab.label || tab.key}</span>
            <span class="dot-status ${hasSrc ? 'submitted' : 'missing'}" aria-hidden="true"></span>
          </button>
        `;
      }).join('');

      tabBar.querySelectorAll('[data-tab-key]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-tab-key');
          currentTab = tabs.find((x) => x.key === key) || tabs[0] || null;
          zoom = 1;
          rotation = 0;
          renderTabs();
          renderDocument();
        });
      });
    }

    function renderDocument() {
      const src = currentTab?.src || '';

      if (!src) {
        docImage.classList.add('is-hidden');
        docImage.removeAttribute('data-lightbox');
        docImage.removeAttribute('src');
        docEmpty.classList.remove('is-hidden');
        fullBtn.setAttribute('data-lightbox', '');
        downloadCurrent.setAttribute('href', '#');
        return;
      }

      docImage.classList.remove('is-hidden');
      docEmpty.classList.add('is-hidden');
      docImage.setAttribute('src', src);
      docImage.setAttribute('data-lightbox', src);
      fullBtn.setAttribute('data-lightbox', src);
      downloadCurrent.setAttribute('href', src);
      downloadCurrent.setAttribute('download', `${currentTab?.key || 'document'}.jpg`);
      updateDocTransform();
    }

    async function postKycAction(endpoint, body, successMsg) {
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body || {})
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.success === false) {
          throw new Error(payload.message || 'Failed to process request');
        }

        showToast(successMsg || payload.message || 'Action completed', 'success');
        setTimeout(() => window.location.reload(), 700);
      } catch (_err) {
        showToast('Unable to complete action. Try again.', 'error');
      }
    }

    document.getElementById('approveKycForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      await postKycAction(`/admin/kyc/${zenoPayId}/approve`, {
        level: document.getElementById('kycLevel')?.value || 'Full Verification',
        note: document.getElementById('approveNote')?.value || '',
        notify: Boolean(document.getElementById('approveNotify')?.checked)
      }, 'KYC approved successfully');
      window.AdminModal?.close('approveKycModal');
    });

    document.getElementById('rejectKycForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const reason = document.getElementById('rejectReason')?.value || '';
      const note = document.getElementById('rejectNote')?.value || '';
      if (!reason) {
        showToast('Please select a rejection reason', 'error');
        return;
      }
      await postKycAction(`/admin/kyc/${zenoPayId}/reject`, { reason: note ? `${reason} - ${note}` : reason }, 'KYC rejected');
      window.AdminModal?.close('rejectKycModal');
    });

    document.getElementById('resubmitKycForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const selectedDocs = Array.from(document.querySelectorAll('#resubmitKycForm input[name="doc"]:checked')).map((el) => el.value);
      const reasonText = document.getElementById('resubmitReason')?.value?.trim() || '';
      const deadline = document.getElementById('resubmitDeadline')?.value || '7';

      if (!reasonText) {
        showToast('Please add a correction reason', 'error');
        return;
      }

      const reason = `${reasonText}${selectedDocs.length ? ` | Docs: ${selectedDocs.join(', ')}` : ''} | Deadline: ${deadline} days`;
      await postKycAction(`/admin/kyc/${zenoPayId}/resubmission`, { reason }, 'Resubmission request sent');
      window.AdminModal?.close('resubmitKycModal');
    });

    document.getElementById('saveInternalNote')?.addEventListener('click', () => {
      showToast('Internal note saved', 'success');
    });

    document.getElementById('downloadAllDocs')?.addEventListener('click', () => {
      const availableDocs = tabs.filter((tab) => tab.src);
      if (!availableDocs.length) {
        showToast('No uploaded documents to download', 'error');
        return;
      }

      availableDocs.forEach((tab, index) => {
        setTimeout(() => {
          const link = document.createElement('a');
          link.href = tab.src;
          link.download = `${tab.key}.jpg`;
          document.body.appendChild(link);
          link.click();
          link.remove();
        }, index * 180);
      });
    });

    zoomInBtn?.addEventListener('click', () => {
      zoom = Math.min(3, Number((zoom + 0.2).toFixed(2)));
      updateDocTransform();
    });

    zoomOutBtn?.addEventListener('click', () => {
      zoom = Math.max(0.6, Number((zoom - 0.2).toFixed(2)));
      updateDocTransform();
    });

    rotateBtn?.addEventListener('click', () => {
      rotation = (rotation + 90) % 360;
      updateDocTransform();
    });

    const score = Math.max(0, Math.min(100, Number(details.riskScore || 0)));
    if (riskFill) {
      const maxArc = 252;
      const offset = maxArc - ((score / 100) * maxArc);
      requestAnimationFrame(() => {
        riskFill.style.strokeDashoffset = `${offset}`;
      });
    }

    renderTabs();
    renderDocument();
  })();
</script>

