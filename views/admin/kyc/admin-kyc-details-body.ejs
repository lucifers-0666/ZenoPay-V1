<%
  const kyc = (typeof details !== 'undefined' && details) ? details : {};
  const docTabs = Array.isArray(kyc.documentTabs) ? kyc.documentTabs : [];
  const firstTab = docTabs.length ? docTabs[0] : null;
  const fullName = kyc.fullName || 'Unknown User';
  const pendingDays = Number(kyc.daysAgo || 0);
  const submittedLabel = kyc.submittedAt ? new Date(kyc.submittedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : (kyc.submittedFormatted || 'N/A');
  const submittedDateTime = kyc.submittedAt ? new Date(kyc.submittedAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : submittedLabel;
  const riskScore = Math.max(0, Math.min(100, Number(kyc.riskScore || 0)));
  const riskLevel = riskScore <= 30 ? 'Low Risk' : riskScore <= 70 ? 'Medium Risk' : 'High Risk';
  const riskTone = riskScore <= 30 ? 'low' : riskScore <= 70 ? 'medium' : 'high';
  const extractedRows = Array.isArray(kyc.extractedRows) && kyc.extractedRows.length ? kyc.extractedRows : [
    { field: 'Full Name', documentValue: fullName, userValue: fullName, match: true },
    { field: 'Date of Birth', documentValue: 'N/A', userValue: 'N/A', match: null },
    { field: 'Document Number', documentValue: 'N/A', userValue: 'N/A', match: null },
    { field: 'Address', documentValue: kyc.userProvided?.address || 'N/A', userValue: kyc.userProvided?.address || 'N/A', match: true },
    { field: "Father's Name", documentValue: 'N/A', userValue: 'N/A', match: null },
    { field: 'Gender', documentValue: 'N/A', userValue: 'N/A', match: null }
  ];
  const riskFlags = Array.isArray(kyc.riskFlagsDetailed) && kyc.riskFlagsDetailed.length ? kyc.riskFlagsDetailed : [
    { severity: 'low', icon: 'fa-check', text: 'PAN verified successfully' },
    { severity: 'medium', icon: 'fa-exclamation-triangle', text: 'Address partially matches' },
    { severity: 'high', icon: 'fa-flag', text: 'Name mismatch detected' },
    { severity: 'low', icon: 'fa-map-marker-alt', text: 'IP location: Mumbai' }
  ];
  const timeline = Array.isArray(kyc.timeline) && kyc.timeline.length ? kyc.timeline.slice(0, 6) : [
    { timestamp: submittedDateTime, action: 'Documents submitted by user', actor: fullName },
    { timestamp: submittedDateTime, action: 'Auto-scan completed', actor: 'OCR Bot' },
    { timestamp: submittedDateTime, action: 'Queued for admin review', actor: 'System' },
    { timestamp: submittedDateTime, action: 'Under review', actor: 'Admin' }
  ];
  const docNames = {
    'aadhaar-front': 'Aadhaar Front',
    'aadhaar-back': 'Aadhaar Back',
    'pan-card': 'PAN Card',
    'selfie': 'Selfie'
  };
%>

<section class="kyc-details-page" id="kycDetailsPage">
  <nav class="kyc-custom-breadcrumb" aria-label="KYC Breadcrumb">
    <a href="/admin/dashboard" class="crumb-link"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right"></i>
    <a href="/admin/kyc" class="crumb-link">KYC Management</a>
    <i class="fas fa-chevron-right"></i>
    <span class="crumb-current"><%= fullName %></span>
  </nav>

  <div class="kyc-details-header-shell">
    <div class="kyc-details-topline">
      <a href="/admin/kyc" class="kyc-back-link"><i class="fas fa-arrow-left"></i><span>Back to KYC List</span></a>
      <div class="kyc-header-actions">
        <button type="button" class="kyc-head-btn kyc-head-btn-outline" data-open-modal="resubmitKycModal"><i class="fas fa-redo"></i><span>Request Resubmission</span></button>
        <button type="button" class="kyc-head-btn kyc-head-btn-reject" data-open-modal="rejectKycModal"><i class="fas fa-times-circle"></i><span>Reject KYC</span></button>
        <button type="button" class="kyc-head-btn kyc-head-btn-approve" data-open-modal="approveKycModal"><i class="fas fa-check-circle"></i><span>Approve KYC</span></button>
      </div>
    </div>

    <h1 class="kyc-details-title">KYC Review — <%= fullName %></h1>
    <p class="kyc-details-subtitle">
      Submitted <%= submittedLabel %>
      <span class="pipe">•</span>
      <%= pendingDays %> day<%= pendingDays === 1 ? '' : 's' %> pending
      <span class="pipe">•</span>
      <code>#<%= kyc.zenoPayId || 'N/A' %></code>
    </p>
  </div>

  <div class="kyc-details-grid">
    <div class="kyc-left-col">
      <section class="kyc-card doc-card left-delay-1">
        <header class="kyc-card-head doc-card-head">
          <div class="kyc-head-title-wrap">
            <span class="kyc-head-icon"><i class="fas fa-folder-open"></i></span>
            <h2>Identity Documents</h2>
          </div>
          <button type="button" id="downloadAllDocs" class="kyc-mini-outline"><i class="fas fa-download"></i><span>Download All</span></button>
        </header>

        <div class="doc-tabbar" id="docTabBar"></div>

        <div class="doc-view-wrap">
          <div class="doc-viewer" id="docViewer">
            <img id="docImage"
                 src="<%= firstTab?.src || '' %>"
                 alt="Document Preview"
                 data-lightbox="<%= firstTab?.src || '' %>"
                 class="doc-image <%= firstTab?.src ? '' : 'is-hidden' %>">

            <div class="doc-empty <%= firstTab?.src ? 'is-hidden' : '' %>" id="docEmpty">
              <i class="fas fa-cloud-upload-alt"></i>
              <p>No document uploaded</p>
            </div>

            <button type="button" class="verify-badge verify-ok" id="verifyName" title="Name verified from OCR">
              <i class="fas fa-check"></i>
            </button>
            <button type="button" class="verify-badge verify-ok" id="verifyDob" title="Date of birth verified">
              <i class="fas fa-check"></i>
            </button>
            <button type="button" class="verify-badge verify-bad" id="verifyId" title="Document number mismatch flagged">
              <i class="fas fa-times"></i>
            </button>
          </div>

          <div class="doc-toolbar">
            <button type="button" class="doc-tool-btn" id="zoomInBtn" title="Zoom In"><i class="fas fa-search-plus"></i><span>Zoom In</span></button>
            <button type="button" class="doc-tool-btn" id="zoomOutBtn" title="Zoom Out"><i class="fas fa-search-minus"></i><span>Zoom Out</span></button>
            <button type="button" class="doc-tool-btn" id="fullscreenBtn" title="Fullscreen" data-lightbox=""><i class="fas fa-expand"></i><span>Fullscreen</span></button>
            <a href="#" class="doc-tool-btn" id="downloadCurrentDoc" download><i class="fas fa-download"></i><span>Download</span></a>
            <button type="button" class="doc-tool-btn" id="rotateBtn" title="Rotate"><i class="fas fa-redo"></i><span>Rotate</span></button>
          </div>
        </div>
      </section>

      <section class="kyc-card extracted-card left-delay-2">
        <header class="kyc-card-head">
          <div class="kyc-head-title-wrap">
            <span class="kyc-head-icon"><i class="fas fa-table"></i></span>
            <h2>Extracted Data Verification</h2>
          </div>
          <span class="ocr-pill"><i class="fas fa-robot"></i>Auto-verified by OCR</span>
        </header>

        <div class="comparison-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Extracted from Document</th>
                <th>User Provided</th>
                <th>Match</th>
              </tr>
            </thead>
            <tbody>
              <% extractedRows.forEach((row) => { 
                const rowTone = row.match === false ? 'is-mismatch' : '';
                const matchState = row.match === true ? 'match' : row.match === false ? 'mismatch' : 'na';
                const badgeIcon = matchState === 'match' ? 'fa-check-circle' : matchState === 'mismatch' ? 'fa-exclamation-triangle' : 'fa-minus-circle';
                const badgeLabel = matchState === 'match' ? 'Match' : matchState === 'mismatch' ? 'Mismatch' : 'N/A';
              %>
                <tr class="<%= rowTone %>">
                  <td class="field-name"><%= row.field %></td>
                  <td class="doc-value"><%= row.documentValue || 'N/A' %></td>
                  <td class="user-value"><%= row.userValue || 'N/A' %></td>
                  <td>
                    <span class="match-pill <%= matchState %>"><i class="fas <%= badgeIcon %>"></i><%= badgeLabel %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="kyc-card context-card left-delay-3">
        <header class="kyc-card-head">
          <div class="kyc-head-title-wrap">
            <span class="kyc-head-icon"><i class="fas fa-info-circle"></i></span>
            <h2>Submission Context</h2>
          </div>
        </header>

        <div class="context-grid">
          <div class="context-item"><span>Submission Date</span><strong><%= submittedDateTime %></strong></div>
          <div class="context-item"><span>IP Address</span><strong>103.45.22.xxx</strong></div>
          <div class="context-item"><span>Device</span><strong>Chrome on Android</strong></div>
          <div class="context-item"><span>Location</span><strong>Mumbai, Maharashtra</strong></div>
          <div class="context-item"><span>Previous Attempts</span><strong>2 (1 rejected before)</strong></div>
          <div class="context-item"><span>KYC Method</span><strong>Self-Upload</strong></div>
          <div class="context-item"><span>Processing Time</span><strong><%= pendingDays %> days, 4 hours</strong></div>
          <div class="context-item"><span>Assigned Admin</span><strong>Unassigned</strong></div>
        </div>
      </section>
    </div>

    <aside class="kyc-right-col">
      <section class="kyc-card side-card right-delay-1">
        <div class="identity-top">
          <div class="identity-avatar"><%= (kyc.avatarInitial || fullName.charAt(0) || 'U').toUpperCase() %></div>
          <div>
            <h3 class="identity-name"><%= fullName %></h3>
            <p class="identity-email"><%= kyc.email || 'N/A' %></p>
            <code class="identity-id">#<%= kyc.zenoPayId || 'N/A' %></code>
          </div>
        </div>

        <div class="identity-badges">
          <span class="state-pill ok">Active</span>
          <span class="state-pill warn">Pending</span>
          <span class="state-pill slate">User</span>
        </div>

        <div class="identity-info-list">
          <div><i class="fas fa-calendar-alt"></i><span>Joined</span><strong><%= kyc.accountCreated || 'N/A' %></strong></div>
          <div><i class="fas fa-phone"></i><span>Phone</span><strong><%= kyc.phone || 'N/A' %></strong></div>
          <div><i class="fas fa-wallet"></i><span>Wallet</span><strong><%= (typeof kyc.walletBalance !== 'undefined' && kyc.walletBalance !== null) ? `₹ ${Number(kyc.walletBalance).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : 'N/A' %></strong></div>
          <div><i class="fas fa-exchange-alt"></i><span>Transactions</span><strong><%= (kyc.totalTransactions || 0).toLocaleString('en-IN') %></strong></div>
        </div>

        <a href="/admin/users/<%= encodeURIComponent(kyc.zenoPayId || '') %>" class="profile-link">View Full Profile <i class="fas fa-arrow-right"></i></a>
      </section>

      <section class="kyc-card side-card right-delay-2">
        <header class="kyc-card-head compact">
          <div class="kyc-head-title-wrap">
            <span class="kyc-head-icon"><i class="fas fa-shield-alt"></i></span>
            <h2>Risk Analysis</h2>
          </div>
        </header>

        <div class="risk-gauge-wrap">
          <svg viewBox="0 0 200 110" class="risk-gauge-svg" aria-hidden="true">
            <path class="risk-track" d="M20,95 A80,80 0 0,1 180,95"></path>
            <path class="risk-fill <%= riskTone %>" id="riskGaugeFill" d="M20,95 A80,80 0 0,1 180,95"></path>
          </svg>
          <div class="risk-score-block">
            <strong class="risk-score <%= riskTone %>"><%= riskScore %></strong>
            <span><%= riskLevel %></span>
          </div>
        </div>

        <div class="risk-flag-list">
          <% riskFlags.forEach((flag) => { 
            const sev = String(flag.severity || 'low').toLowerCase();
          %>
            <div class="risk-flag-row <%= sev %>">
              <span class="flag-icon"><i class="fas <%= flag.icon || 'fa-check-circle' %>"></i></span>
              <p><%= flag.text %></p>
              <span class="flag-pill <%= sev %>"><%= sev.charAt(0).toUpperCase() + sev.slice(1) %></span>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="kyc-card side-card decision-panel right-delay-3">
        <header class="decision-title"><i class="fas fa-gavel"></i><span>Admin Decision</span></header>

        <div class="decision-stack">
          <button type="button" class="decision-btn decision-approve" data-open-modal="approveKycModal">
            <i class="fas fa-check-circle"></i>
            <span>Approve KYC</span>
            <i class="fas fa-arrow-right decision-arrow"></i>
          </button>
          <button type="button" class="decision-btn decision-reject" data-open-modal="rejectKycModal">
            <i class="fas fa-times-circle"></i>
            <span>Reject KYC</span>
            <i class="fas fa-arrow-right decision-arrow"></i>
          </button>
          <button type="button" class="decision-btn decision-resubmit" data-open-modal="resubmitKycModal">
            <i class="fas fa-redo"></i>
            <span>Request Resubmission</span>
            <i class="fas fa-arrow-right decision-arrow"></i>
          </button>
        </div>

        <label for="internalNote" class="note-label">Internal Note <small>Not visible to user</small></label>
        <textarea id="internalNote" class="admin-textarea" rows="3" placeholder="Add internal verification notes..."><%= kyc.adminNotes || '' %></textarea>
        <button type="button" id="saveInternalNote" class="save-note-btn"><i class="fas fa-save"></i>Save Note</button>
      </section>

      <section class="kyc-card side-card right-delay-4">
        <header class="kyc-card-head compact">
          <div class="kyc-head-title-wrap">
            <span class="kyc-head-icon"><i class="fas fa-history"></i></span>
            <h2>KYC Activity Log</h2>
          </div>
        </header>

        <div class="timeline-wrap">
          <% timeline.forEach((item, idx) => { %>
            <article class="timeline-item">
              <span class="dot <%= idx === 0 ? 'blue' : idx === 1 ? 'slate' : idx === 2 ? 'amber' : 'purple' %>"></span>
              <% if (idx !== timeline.length - 1) { %><span class="line"></span><% } %>
              <div class="event-body">
                <p class="event-time"><%= item.timestamp %></p>
                <p class="event-action"><%= item.action %></p>
                <p class="event-admin"><%= item.actor %></p>
              </div>
            </article>
          <% }) %>
        </div>

        <a href="#" class="log-link">View Full Log</a>
      </section>
    </aside>
  </div>
</section>

<div id="approveKycModal" class="modal-overlay" hidden>
  <div class="modal-card kyc-modal-card">
    <div class="modal-header kyc-modal-head-green">
      <div>
        <h2 class="modal-title"><i class="fas fa-check-circle"></i> Approve KYC</h2>
        <p class="modal-subtitle">Complete final approval settings</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="approveKycModal"><i class="fas fa-times"></i></button>
    </div>

    <form class="modal-body" id="approveKycForm">
      <p class="kyc-modal-copy">You are approving KYC for <strong><%= fullName %></strong>. A verification confirmation email will be sent.</p>

      <div class="form-group">
        <label class="form-label" for="kycLevel">KYC Level</label>
        <select id="kycLevel" class="admin-select">
          <option>Basic Verification</option>
          <option selected>Full Verification</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="approveNote">Optional note</label>
        <textarea id="approveNote" class="admin-textarea" rows="4" placeholder="Add optional internal note..."></textarea>
      </div>

      <label class="form-toggle-row">
        <span class="form-label">Send Approval Email</span>
        <input id="approveNotify" type="checkbox" checked>
      </label>

      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="approveKycModal">Cancel</button>
        <button type="submit" class="btn-primary-modal kyc-btn-green">Confirm Approve</button>
      </div>
    </form>
  </div>
</div>

<div id="rejectKycModal" class="modal-overlay" hidden>
  <div class="modal-card kyc-modal-card">
    <div class="modal-header kyc-modal-head-red">
      <div>
        <h2 class="modal-title"><i class="fas fa-times-circle"></i> Reject KYC</h2>
        <p class="modal-subtitle">Provide rejection details</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="rejectKycModal"><i class="fas fa-times"></i></button>
    </div>

    <form class="modal-body" id="rejectKycForm">
      <p class="kyc-modal-copy">You are rejecting KYC for <strong><%= fullName %></strong>.</p>

      <div class="form-group">
        <label class="form-label" for="rejectReason">Rejection Reason</label>
        <select id="rejectReason" class="admin-select" required>
          <option value="">Select reason</option>
          <option>Blurry / Unclear Image</option>
          <option>Expired Document</option>
          <option>Name Mismatch</option>
          <option>Document Tampered</option>
          <option>Incomplete Submission</option>
          <option>Other</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="rejectNote">Additional Note</label>
        <textarea id="rejectNote" class="admin-textarea" rows="4" placeholder="Add detailed rejection note..."></textarea>
      </div>

      <label class="form-toggle-row">
        <span class="form-label">Notify User</span>
        <input id="rejectNotify" type="checkbox" checked>
      </label>

      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="rejectKycModal">Cancel</button>
        <button type="submit" class="btn-danger-modal">Confirm Reject</button>
      </div>
    </form>
  </div>
</div>

<div id="resubmitKycModal" class="modal-overlay" hidden>
  <div class="modal-card kyc-modal-card">
    <div class="modal-header kyc-modal-head-blue">
      <div>
        <h2 class="modal-title"><i class="fas fa-redo"></i> Request Resubmission</h2>
        <p class="modal-subtitle">Specify required corrections</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="resubmitKycModal"><i class="fas fa-times"></i></button>
    </div>

    <form class="modal-body" id="resubmitKycForm">
      <div class="form-group">
        <label class="form-label">Documents to resubmit</label>
        <label class="check-item"><input type="checkbox" name="doc" value="Aadhaar Front"> <span>Aadhaar Front</span></label>
        <label class="check-item"><input type="checkbox" name="doc" value="Aadhaar Back"> <span>Aadhaar Back</span></label>
        <label class="check-item"><input type="checkbox" name="doc" value="PAN Card"> <span>PAN Card</span></label>
        <label class="check-item"><input type="checkbox" name="doc" value="Selfie"> <span>Selfie</span></label>
      </div>

      <div class="form-group">
        <label class="form-label" for="resubmitReason">Reason</label>
        <textarea id="resubmitReason" class="admin-textarea" rows="4" placeholder="Explain what needs to be corrected..." required></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="resubmitDeadline">Deadline</label>
        <select id="resubmitDeadline" class="admin-select">
          <option value="3">3 days</option>
          <option value="7" selected>7 days</option>
          <option value="14">14 days</option>
        </select>
      </div>

      <label class="form-toggle-row">
        <span class="form-label">Notify User</span>
        <input id="resubmitNotify" type="checkbox" checked>
      </label>

      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="resubmitKycModal">Cancel</button>
        <button type="submit" class="btn-primary-modal">Send Request</button>
      </div>
    </form>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>" id="kycDetailsSeed" type="application/json"><%- JSON.stringify(kyc).replace(/</g, '\\u003c') %></script>

<style>
  .kyc-details-page { color: var(--text-main); }
  .kyc-custom-breadcrumb {
    margin-bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    font-size: 13px;
  }
  .kyc-custom-breadcrumb .crumb-link { color: var(--text-muted); font-weight: 600; }
  .kyc-custom-breadcrumb .crumb-link:hover { color: var(--primary); }
  .kyc-custom-breadcrumb i { font-size: 11px; }
  .kyc-custom-breadcrumb .crumb-current { color: var(--text-main); font-weight: 700; }

  .kyc-details-header-shell { margin-bottom: 18px; animation: fadeInUp 0.35s ease-out both; }
  .kyc-details-topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }

  .kyc-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--trans-fast), transform var(--trans-fast);
  }
  .kyc-back-link:hover { color: var(--primary); transform: translateX(-2px); }

  .kyc-details-title { font-size: 28px; font-weight: 800; color: var(--text-main); }
  .kyc-details-subtitle { margin-top: 4px; font-size: 14px; color: var(--text-soft); display: inline-flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .kyc-details-subtitle .pipe { color: var(--border); }
  .kyc-details-subtitle code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text-muted); font-size: 12px; }

  .kyc-header-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .kyc-head-btn {
    height: 42px;
    border-radius: 9999px;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid transparent;
    transition: transform var(--trans-fast), box-shadow var(--trans-fast), background var(--trans-fast), color var(--trans-fast), border-color var(--trans-fast);
  }
  .kyc-head-btn:hover { transform: translateY(-1px); }
  .kyc-head-btn-outline { background: var(--card-bg); border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); color: var(--primary-dark); }
  .kyc-head-btn-outline:hover { background: color-mix(in srgb, var(--primary) 8%, var(--card-bg)); }
  .kyc-head-btn-reject { color: #fff; background: linear-gradient(135deg, var(--red), var(--red-dark)); box-shadow: 0 4px 12px rgba(239,68,68,0.28); }
  .kyc-head-btn-approve { color: #fff; background: linear-gradient(135deg, var(--green), var(--green-dark)); box-shadow: 0 4px 12px rgba(16,185,129,0.28); }

  .kyc-details-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) 340px; gap: 24px; }

  .kyc-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .left-delay-1 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.06s; }
  .left-delay-2 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.12s; }
  .left-delay-3 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.18s; }

  .kyc-right-col { position: sticky; top: 88px; height: fit-content; }
  .right-delay-1 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.08s; }
  .right-delay-2 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.16s; }
  .right-delay-3 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.24s; }
  .right-delay-4 { animation: fadeInUp 0.35s ease-out both; animation-delay: 0.32s; }

  .doc-card { margin-bottom: 20px; overflow: hidden; }
  .doc-card-head { padding: 20px 24px; border-bottom: 1px solid var(--border-light); }
  .kyc-card-head { padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .kyc-card-head.compact { padding-bottom: 14px; }

  .kyc-head-title-wrap { display: inline-flex; align-items: center; gap: 10px; }
  .kyc-head-title-wrap h2 { font-size: 17px; font-weight: 800; color: var(--text-main); }
  .kyc-head-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
  }

  .kyc-mini-outline {
    height: 36px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--card-bg);
    padding: 0 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .kyc-mini-outline:hover { color: var(--primary); border-color: var(--primary); }

  .doc-tabbar {
    padding: 0 24px;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    gap: 2px;
    overflow-x: auto;
  }
  .doc-tab {
    height: 46px;
    padding: 0 18px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .doc-tab:hover { color: var(--text-main); }
  .doc-tab.active { color: var(--primary); border-bottom-color: var(--primary); }
  .dot-status { width: 8px; height: 8px; border-radius: 9999px; }
  .dot-status.submitted { background: var(--green); }
  .dot-status.missing { background: var(--red); }

  .doc-view-wrap { padding: 24px; }
  .doc-viewer {
    min-height: 320px;
    background: #F8FAFC;
    border: 1.5px dashed var(--border);
    border-radius: var(--r-md);
