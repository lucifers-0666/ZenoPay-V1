  .doc-image.is-hidden { display: none; }

  .doc-empty { text-align: center; color: var(--text-soft); }
  .doc-empty.is-hidden { display: none; }
  .doc-empty i { font-size: 40px; color: #CBD5E1; margin-bottom: 10px; }
