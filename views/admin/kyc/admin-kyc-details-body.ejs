  .identity-badges { margin-top: 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .state-pill { font-size: 11px; font-weight: 700; border-radius: 9999px; padding: 4px 10px; }
  .state-pill.ok { color: var(--green); background: color-mix(in srgb, var(--green) 12%, var(--card-bg)); }
  .state-pill.warn { color: var(--amber-dark); background: color-mix(in srgb, var(--amber) 15%, var(--card-bg)); }
  .state-pill.slate { color: var(--text-muted); background: color-mix(in srgb, var(--text-soft) 15%, var(--card-bg)); }

  .identity-info-list {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
  }
  .identity-info-list > div {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-light);
    font-size: 13px;
    color: var(--text-muted);
  }
  .identity-info-list > div:last-child { border-bottom: 0; }
  .identity-info-list i { color: var(--text-soft); width: 14px; }
  .identity-info-list span { min-width: 78px; }
  .identity-info-list strong { margin-left: auto; color: var(--text-main); font-weight: 700; }

  .profile-link { margin-top: 12px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: var(--primary); }

  .risk-gauge-wrap { width: 160px; margin: 12px auto 14px; text-align: center; }
  .risk-gauge-svg { width: 160px; height: 90px; }
  .risk-track { stroke: var(--border); stroke-width: 10; fill: none; stroke-linecap: round; }
  .risk-fill {
    stroke-width: 10;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 252;
    stroke-dashoffset: 252;
    transition: stroke-dashoffset 1.2s ease-out;
  }
  .risk-fill.low { stroke: var(--green); }
  .risk-fill.medium { stroke: var(--amber); }
  .risk-fill.high { stroke: var(--red); }

  .risk-score-block { margin-top: -4px; display: grid; gap: 2px; }
  .risk-score-block .risk-score { font-size: 28px; font-weight: 800; line-height: 1; }
  .risk-score.low { color: var(--green); }
  .risk-score.medium { color: var(--amber-dark); }
  .risk-score.high { color: var(--red); }
  .risk-score-block span { font-size: 12px; color: var(--text-soft); font-weight: 600; }

  .risk-flag-list { margin-top: 16px; display: grid; gap: 9px; }
  .risk-flag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 8px 9px;
  }
  .flag-icon {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
