  .comparison-table tbody tr:last-child td { border-bottom: 0; }
  .comparison-table .field-name { font-weight: 700; color: var(--text-main); }
  .comparison-table tr.is-mismatch { background: rgba(245,158,11,0.06); box-shadow: inset 3px 0 0 var(--amber); }

