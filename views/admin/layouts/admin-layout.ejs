<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin' %> — ZenoPay Admin</title>
  <link rel="icon" type="image/png" href="/Images/bgFavicon.png">
  <link rel="shortcut icon" type="image/png" href="/Images/bgFavicon.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- Admin CSS (NEW — no old files) -->
  <link rel="stylesheet" href="/css/admin/admin-base.css">
  <link rel="stylesheet" href="/css/admin/admin-components.css">
  <link rel="stylesheet" href="/css/admin/admin-pages.css">

  <style>
    /* Admin hard-guard: never show public-site header/nav inside admin pages */
    #zenoHeader,
    .zenopay-header,
    .mobile-bottom-nav,
    .mobile-bottom-spacer,
    .header-spacer,
    #mobileOverlay {
      display: none !important;
      visibility: hidden !important;
    }
  </style>

  <%- typeof extraCSS !== 'undefined' ? extraCSS : '' %>
</head>

<body class="admin-body">
<div class="admin-layout" id="adminLayout">

  <!-- SIDEBAR -->
  <%- include('../partials/sidebar') %>

  <!-- MAIN -->
  <div class="admin-main">

    <!-- HEADER -->
    <%- include('../partials/header') %>

    <!-- PAGE CONTENT -->
    <main class="admin-content">
      <%- include('../partials/breadcrumb') %>
      <%- body %>
    </main>

  </div>
</div>

<!-- Toast container -->
<div class="admin-toast-container" id="toastContainer"></div>

<!-- Admin JS (NEW — no old files) -->
<script src="/js/admin/admin-core.js"></script>
<script src="/js/admin/admin-charts.js"></script>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<%- typeof extraJS !== 'undefined' ? extraJS : '' %>
<!-- Global admin JS — must be last -->
<script src="/js/admin-base.js"></script>
<script src="/js/admin-dashboard.js"></script>
<script>
  (function removePublicHeaderArtifacts() {
    [
      '#zenoHeader',
      '.zenopay-header',
      '.mobile-bottom-nav',
      '.mobile-bottom-spacer',
      '.header-spacer',
      '#mobileOverlay'
    ].forEach((selector) => {
      document.querySelectorAll(selector).forEach((el) => el.remove());
    });
  })();
</script>
<script>
  (function setupAdminInactivityWarning() {
    var timeoutMs = Number(<%= typeof inactivityTimeoutMs !== 'undefined' ? inactivityTimeoutMs : 0 %>);
    var warningMs = Number(<%= typeof inactivityWarningMs !== 'undefined' ? inactivityWarningMs : 0 %>);
    var pingUrl = '/admin/session/ping';
    var logoutUrl = '/admin/login?timeout=1';

    if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) return;
    if (!Number.isFinite(warningMs) || warningMs < 0 || warningMs >= timeoutMs) {
      warningMs = Math.min(60000, Math.max(30000, timeoutMs - 1000));
    }

    var warningTimer = null;
    var hardTimeoutTimer = null;
    var countdownInterval = null;
    var isPromptOpen = false;
    var remainingSeconds = 0;

    function ensureModalStyles() {
      if (document.getElementById('adminSessionWarningStyles')) return;
      var style = document.createElement('style');
      style.id = 'adminSessionWarningStyles';
      style.textContent = [
        '.admin-session-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;z-index:13000;background:rgba(2,6,23,.6);backdrop-filter:blur(3px);}',
        '.admin-session-card{width:min(92vw,450px);border-radius:16px;background:#fff;box-shadow:0 22px 64px rgba(15,23,42,.35);padding:20px 20px 16px;font-family:Inter,Segoe UI,Arial,sans-serif;color:#0f172a;}',
        '.admin-session-title{margin:0 0 8px;font-size:1.05rem;font-weight:800;display:flex;align-items:center;gap:8px;}',
        '.admin-session-title i{color:#f97316;}',
        '.admin-session-text{margin:0 0 14px;font-size:.95rem;line-height:1.5;color:#334155;}',
        '.admin-session-count{font-weight:800;color:#dc2626;}',
        '.admin-session-actions{display:flex;gap:10px;justify-content:flex-end;}',
        '.admin-session-btn{border:0;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer;}',
        '.admin-session-btn.secondary{background:#f1f5f9;color:#0f172a;}',
        '.admin-session-btn.primary{background:#1d4ed8;color:#fff;}',
        '.admin-session-btn.primary:disabled{opacity:.75;cursor:not-allowed;}'
      ].join('');
      document.head.appendChild(style);
    }

    function ensureModal() {
      var existing = document.getElementById('adminSessionWarningModal');
      if (existing) return existing;

      ensureModalStyles();
      var modal = document.createElement('div');
      modal.id = 'adminSessionWarningModal';
      modal.className = 'admin-session-modal';
      modal.innerHTML = [
        '<div class="admin-session-card" role="dialog" aria-modal="true" aria-labelledby="adminSessionWarningTitle">',
          '<h3 class="admin-session-title" id="adminSessionWarningTitle"><i class="fas fa-user-shield"></i> Admin session expiring</h3>',
          '<p class="admin-session-text">For security, admin access will end in <span class="admin-session-count" id="adminSessionCountdown">0</span> seconds due to inactivity.</p>',
          '<div class="admin-session-actions">',
            '<button type="button" class="admin-session-btn secondary" id="adminSessionLogoutNow">Log out now</button>',
            '<button type="button" class="admin-session-btn primary" id="adminSessionStayBtn">Stay logged in</button>',
          '</div>',
        '</div>'
      ].join('');

      document.body.appendChild(modal);
      return modal;
    }

    function clearTimers() {
      if (warningTimer) {
        window.clearTimeout(warningTimer);
        warningTimer = null;
      }
      if (hardTimeoutTimer) {
        window.clearTimeout(hardTimeoutTimer);
        hardTimeoutTimer = null;
      }
      if (countdownInterval) {
        window.clearInterval(countdownInterval);
        countdownInterval = null;
      }
    }

    function pingSession() {
      return fetch(pingUrl, {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      }).then(function(res) {
        if (!res.ok) {
          throw new Error('Session ping failed');
        }
        return res.json().catch(function() { return {}; });
      });
    }

    function closeModal() {
      var modal = document.getElementById('adminSessionWarningModal');
      if (modal) {
        modal.style.display = 'none';
      }
      if (countdownInterval) {
        window.clearInterval(countdownInterval);
        countdownInterval = null;
      }
      isPromptOpen = false;
    }

    function showWarningPrompt() {
      if (isPromptOpen) return;
      isPromptOpen = true;

      var modal = ensureModal();
      var countdownEl = modal.querySelector('#adminSessionCountdown');
      var stayBtn = modal.querySelector('#adminSessionStayBtn');
      var logoutBtn = modal.querySelector('#adminSessionLogoutNow');

      remainingSeconds = Math.max(1, Math.ceil(warningMs / 1000));
      if (countdownEl) countdownEl.textContent = String(remainingSeconds);
      modal.style.display = 'flex';

      if (countdownInterval) {
        window.clearInterval(countdownInterval);
      }
      countdownInterval = window.setInterval(function() {
        remainingSeconds = Math.max(0, remainingSeconds - 1);
        if (countdownEl) countdownEl.textContent = String(remainingSeconds);
        if (remainingSeconds <= 0) {
          window.clearInterval(countdownInterval);
          countdownInterval = null;
          window.location.assign(logoutUrl);
        }
      }, 1000);

      if (logoutBtn) {
        logoutBtn.onclick = function() {
          window.location.assign(logoutUrl);
        };
      }

      if (stayBtn) {
        stayBtn.disabled = false;
        stayBtn.textContent = 'Stay logged in';
        stayBtn.onclick = function() {
          stayBtn.disabled = true;
          stayBtn.textContent = 'Refreshing...';

          pingSession()
            .then(function() {
              closeModal();
              scheduleTimers();
            })
            .catch(function() {
              window.location.assign(logoutUrl);
            })
            .finally(function() {
              if (stayBtn) {
                stayBtn.disabled = false;
                stayBtn.textContent = 'Stay logged in';
              }
            });
        };
      }
    }

    function scheduleTimers() {
      clearTimers();
      warningTimer = window.setTimeout(showWarningPrompt, timeoutMs - warningMs);
      hardTimeoutTimer = window.setTimeout(function() {
        window.location.assign(logoutUrl);
      }, timeoutMs + 1000);
    }

    var interactionEvents = ['click', 'keydown', 'mousemove', 'scroll', 'touchstart'];
    var lastInteractionAt = 0;

    function handleInteraction() {
      if (isPromptOpen) return;
      var now = Date.now();
      if (now - lastInteractionAt < 1000) return;
      lastInteractionAt = now;
      scheduleTimers();
    }

    interactionEvents.forEach(function(evt) {
      window.addEventListener(evt, handleInteraction, { passive: true });
    });

    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        scheduleTimers();
      }
    });

    scheduleTimers();
  })();
</script>
</body>
</html>
