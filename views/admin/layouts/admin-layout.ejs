<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin' %> — ZenoPay Admin</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- Admin CSS (NEW — no old files) -->
  <link rel="stylesheet" href="/css/admin/admin-base.css">
  <link rel="stylesheet" href="/css/admin/admin-components.css">
  <link rel="stylesheet" href="/css/admin/admin-pages.css">

  <%- typeof extraCSS !== 'undefined' ? extraCSS : '' %>
</head>

<body class="admin-body">
<div class="admin-layout" id="adminLayout">

  <!-- SIDEBAR -->
  <%- include('../partials/sidebar') %>

  <!-- MAIN -->
  <div class="admin-main">

    <!-- HEADER -->
    <%- include('../partials/header') %>

    <!-- PAGE CONTENT -->
    <main class="admin-content">
      <%- include('../partials/breadcrumb') %>
      <%- body %>
    </main>

  </div>
</div>

<!-- Toast container -->
<div class="admin-toast-container" id="toastContainer"></div>

<!-- Admin JS (NEW — no old files) -->
<script src="/js/admin/admin-core.js"></script>
<script src="/js/admin/admin-charts.js"></script>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<%- typeof extraJS !== 'undefined' ? extraJS : '' %>
<!-- Global admin JS — must be last -->
<script src="/js/admin-base.js"></script>
<script src="/js/admin-dashboard.js"></script>
</body>
</html>
