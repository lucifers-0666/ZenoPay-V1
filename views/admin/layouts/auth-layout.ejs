<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'ZenoPay Admin' %></title>
  <link rel="icon" type="image/png" href="/Images/bgFavicon.png">
  <link rel="shortcut icon" type="image/png" href="/Images/bgFavicon.png">
  <link rel="stylesheet" href="/css/admin-auth.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
  <!-- Additional Head Scripts -->
  <%- typeof headScripts !== 'undefined' ? headScripts : '' %>
</head>
<body>
  
  <!-- Page Body (auth views already wrap in auth-container/auth-card) -->
