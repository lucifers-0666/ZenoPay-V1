          <h2 class="card-title"><i class="fas fa-address-card"></i> Contact Information</h2>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Contact Person</div>
            <div class="info-value"><%= safeMerchant.contactPerson || safeMerchant.name || '—' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">Email</div>
            <div class="info-value with-icon"><i class="fas fa-envelope"></i> <span><%= safeMerchant.email || '—' %></span></div>
          </div>

          <div class="info-item">
            <div class="info-label">Phone</div>
            <div class="info-value with-icon"><i class="fas fa-phone"></i> <span><%= safeMerchant.phone || '—' %></span></div>
          </div>

          <div class="info-item">
            <div class="info-label">Support Email</div>
            <div class="info-value"><%= safeMerchant.supportEmail || '—' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">City</div>
            <div class="info-value"><%= safeMerchant.city || '—' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">State</div>
            <div class="info-value"><%= safeMerchant.state || '—' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">Pincode</div>
            <div class="info-value"><%= safeMerchant.pincode || '—' %></div>
          </div>

          <div class="info-item full-span">
            <div class="info-label">Address</div>
            <div class="info-value"><%= safeMerchant.address || '—' %></div>
          </div>
        </div>
      </article>

      <article class="detail-card">
        <div class="card-head">
          <h2 class="card-title"><i class="fas fa-arrow-right-arrow-left"></i> Recent Transactions</h2>
          <a class="view-all-link" href="<%= txnLink %>">View All</a>
        </div>

        <% if (safeTransactions.length) { %>
          <div class="tx-list">
            <div class="tx-head">
              <span>TXN ID</span>
              <span>Amount</span>
              <span>Status</span>
              <span>Date</span>
            </div>
            <% safeTransactions.forEach((txn) => { %>
              <div class="tx-row">
                <div class="tx-left">
                  <span class="tx-id"><%= String(txn.TransactionID || txn._id || '').slice(0, 12) %></span>
                  <span class="amount-green">₹<%= formatMoney(txn.Amount) %></span>
                </div>
                <div class="tx-right">
                  <span class="badge <%= statusBadgeClass(txn.Status) %>"><%= txn.Status || 'pending' %></span>
                  <span class="muted" style="font-size:0.75rem;"><%= shortDate(txn.TransactionTime || txn.createdAt) %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i class="fas fa-receipt"></i>
            No transactions found
          </div>
        <% } %>
      </article>
    </div>

    <div>
      <article class="detail-card">
        <div class="card-head">
          <h2 class="card-title"><i class="fas fa-shield-halved"></i> Account Status</h2>
        </div>

        <div class="status-grid">
          <div class="status-row">
            <span class="label">Account Status</span>
            <span class="value">
              <span class="badge status-badge-large <%= statusBadgeClass(merchantStatus) %>"><%= merchantStatus %></span>
            </span>
          </div>

          <div class="status-row">
            <span class="label">Verification</span>
            <span class="value">
              <% if (isVerified) { %>
                <span class="with-icon"><i class="fas fa-shield-halved" style="color: var(--green-dark);"></i><span class="badge badge-success">Verified</span></span>
                <span class="verified-note">Since <%= shortDate(safeMerchant.verifiedAt || safeMerchant.updatedAt || safeMerchant.createdAt) %></span>
              <% } else { %>
                <span class="with-icon"><i class="fas fa-shield" style="color: var(--text-soft);"></i><span class="badge badge-warning">Not Verified</span></span>
              <% } %>
            </span>
          </div>

          <div class="status-row">
            <span class="label">Member Since</span>
            <span class="value with-icon"><i class="fas fa-calendar"></i> <%= shortDate(safeMerchant.createdAt) %></span>
          </div>

          <div class="status-row">
            <span class="label">Last Updated</span>
            <span class="value"><%= relativeTime(safeMerchant.updatedAt) %></span>
          </div>
        </div>

        <div class="action-stack">
          <% if (!isVerified) { %>
            <button type="button" id="cardVerifyBtn" class="action-btn green-filled"><i class="fas fa-shield-halved"></i> Verify Merchant</button>
          <% } %>

          <% if (merchantStatus === 'active') { %>
            <button type="button" id="cardSuspendBtn" class="action-btn red-outline"><i class="fas fa-ban"></i> Suspend Merchant</button>
          <% } else { %>
            <button type="button" id="cardActivateBtn" class="action-btn green-outline"><i class="fas fa-circle-check"></i> Activate Merchant</button>
          <% } %>
        </div>
      </article>

      <article class="detail-card">
        <div class="card-head">
          <h2 class="card-title"><i class="fas fa-landmark"></i> Settlement Details</h2>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Settlement Cycle</div>
            <div class="info-value"><%= safeMerchant.settlementCycle || 'T+1' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">Bank Name</div>
            <div class="info-value"><%= safeMerchant.bankName || 'Not provided' %></div>
          </div>

          <div class="info-item">
            <div class="info-label">Account Number</div>
            <div class="info-value mono"><%= maskedAccount(safeMerchant.accountNumber) %></div>
          </div>

          <div class="info-item">
            <div class="info-label">IFSC Code</div>
            <div class="info-value"><%= safeMerchant.ifscCode || '—' %></div>
          </div>

          <div class="info-item full-span">
            <div class="info-label">UPI ID</div>
            <div class="info-value"><%= safeMerchant.upiId || '—' %></div>
          </div>
        </div>

        <div class="security-note">
          <i class="fas fa-circle-info"></i>
          Bank details are encrypted and stored securely.
        </div>
      </article>

      <article class="detail-card">
        <div class="card-head">
          <h2 class="card-title"><i class="fas fa-file-lines"></i> Documents</h2>
        </div>

        <div class="doc-list">
          <div class="doc-row">
            <span class="doc-name"><i class="fas fa-file-text"></i> GST Certificate</span>
            <span class="badge <%= safeMerchant.docs && safeMerchant.docs.gst ? 'badge-success' : 'badge-danger' %>"><%= safeMerchant.docs && safeMerchant.docs.gst ? 'Submitted' : 'Missing' %></span>
            <a href="#" class="doc-action">View</a>
          </div>

          <div class="doc-row">
            <span class="doc-name"><i class="fas fa-id-card"></i> PAN Card</span>
            <span class="badge <%= safeMerchant.docs && safeMerchant.docs.pan ? 'badge-success' : 'badge-danger' %>"><%= safeMerchant.docs && safeMerchant.docs.pan ? 'Submitted' : 'Missing' %></span>
            <a href="#" class="doc-action">View</a>
          </div>

          <div class="doc-row">
            <span class="doc-name"><i class="fas fa-landmark"></i> Bank Statement</span>
            <span class="badge <%= safeMerchant.docs && safeMerchant.docs.bank ? 'badge-success' : 'badge-danger' %>"><%= safeMerchant.docs && safeMerchant.docs.bank ? 'Submitted' : 'Missing' %></span>
            <a href="#" class="doc-action">View</a>
          </div>

          <div class="doc-row">
            <span class="doc-name"><i class="fas fa-building"></i> Business License</span>
            <span class="badge <%= safeMerchant.docs && safeMerchant.docs.license ? 'badge-success' : 'badge-danger' %>"><%= safeMerchant.docs && safeMerchant.docs.license ? 'Submitted' : 'Missing' %></span>
            <a href="#" class="doc-action">View</a>
          </div>
        </div>

        <p class="doc-foot-note">Document upload integration coming soon</p>
      </article>

      <article class="detail-card">
        <div class="card-head">
          <h2 class="card-title"><i class="fas fa-rotate-left"></i> Recent Refunds</h2>
          <a class="view-all-link" href="<%= refundLink %>">View All</a>
        </div>

        <% if (safeRefunds.length) { %>
          <div class="refund-list">
            <% safeRefunds.forEach((refund) => { %>
              <div class="refund-row">
                <div>
                  <div class="refund-id"><%= refund.refundId || refund._id %></div>
                  <div class="amount-red">₹<%= formatMoney(refund.amount) %></div>
                  <div class="refund-reason"><%= refund.reason || '—' %></div>
                </div>
                <div class="refund-date"><%= shortDate(refund.createdAt) %></div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i class="fas fa-rotate-left"></i>
            No refunds found
          </div>
        <% } %>
      </article>
    </div>
  </section>
</section>

<div class="modal-overlay" id="verifyModal" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title green"><i class="fas fa-shield-halved"></i> Verify Merchant</h3>
      <button class="modal-close" type="button" data-close-modal="verifyModal"><i class="fas fa-times"></i></button>
    </div>
    <form id="verifyForm">
      <div class="modal-body">
        <strong><%= safeMerchant.businessName %></strong>
        <div class="info-box-green">Verifying confirms business documents are valid and enables full payment capabilities.</div>
        <div>
          <label class="field-label" for="verifyAdminNote">Admin Note (optional)</label>
          <textarea id="verifyAdminNote" class="field-textarea"></textarea>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn-header btn-header-gray-outline" type="button" data-close-modal="verifyModal">Cancel</button>
        <button class="btn-header btn-header-green-filled" type="submit"><i class="fas fa-shield-halved"></i> Verify</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="suspendModal" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title red"><i class="fas fa-ban"></i> Suspend Merchant</h3>
      <button class="modal-close" type="button" data-close-modal="suspendModal"><i class="fas fa-times"></i></button>
    </div>
    <form id="suspendForm">
      <div class="modal-body">
        <strong><%= safeMerchant.businessName %></strong>
        <div>
          <label class="field-label" for="suspendReason">Suspension Reason</label>
          <select id="suspendReason" class="field-select" required>
            <option value="Policy Violation">Policy Violation</option>
            <option value="Fraud Suspected">Fraud Suspected</option>
            <option value="Document Issues">Document Issues</option>
            <option value="Chargebacks">Chargebacks</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="suspendNotes">Notes</label>
          <textarea id="suspendNotes" class="field-textarea"></textarea>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn-header btn-header-gray-outline" type="button" data-close-modal="suspendModal">Cancel</button>
        <button class="btn-header btn-header-red-outline" type="submit"><i class="fas fa-ban"></i> Suspend</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="activateModal" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title green"><i class="fas fa-circle-check"></i> Activate Merchant</h3>
      <button class="modal-close" type="button" data-close-modal="activateModal"><i class="fas fa-times"></i></button>
    </div>
    <form id="activateForm">
      <div class="modal-body">
        <strong><%= safeMerchant.businessName %></strong>
        <p class="muted">Are you sure you want to activate this merchant account?</p>
      </div>
      <div class="modal-foot">
        <button class="btn-header btn-header-gray-outline" type="button" data-close-modal="activateModal">Cancel</button>
        <button class="btn-header btn-header-green-filled" type="submit"><i class="fas fa-circle-check"></i> Activate</button>
      </div>
    </form>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>">
  (() => {
    const merchantId = '<%= safeMerchant._id %>';

    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('open');
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('open');
    }

    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type === 'error' ? 'admin-toast-error' : 'admin-toast-success'}`;
      toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i><span>${message}</span>`;
      document.body.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 240);
      }, 3000);
    }

    async function patchRequest(url, payload) {
      const resp = await fetch(url, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: payload ? JSON.stringify(payload) : undefined,
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.success) {
        throw new Error(data.message || 'Request failed');
      }
      return data;
    }

    document.getElementById('headerVerifyBtn')?.addEventListener('click', () => openModal('verifyModal'));
    document.getElementById('cardVerifyBtn')?.addEventListener('click', () => openModal('verifyModal'));
    document.getElementById('headerSuspendBtn')?.addEventListener('click', () => openModal('suspendModal'));
    document.getElementById('cardSuspendBtn')?.addEventListener('click', () => openModal('suspendModal'));
    document.getElementById('headerActivateBtn')?.addEventListener('click', () => openModal('activateModal'));
    document.getElementById('cardActivateBtn')?.addEventListener('click', () => openModal('activateModal'));

    document.addEventListener('click', (event) => {
      const closeBtn = event.target.closest('[data-close-modal]');
      if (closeBtn) {
        closeModal(closeBtn.getAttribute('data-close-modal'));
        return;
      }

      const overlay = event.target.closest('.modal-overlay');
      if (overlay && event.target === overlay) {
        overlay.classList.remove('open');
      }
    });

    document.getElementById('verifyForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        const note = document.getElementById('verifyAdminNote')?.value || '';
        await patchRequest(`/admin/merchants/${encodeURIComponent(merchantId)}/verify`, { note });
        showToast('Merchant verified!');
        setTimeout(() => window.location.reload(), 500);
      } catch (error) {
        showToast(error.message || 'Failed to verify merchant', 'error');
      }
    });

    document.getElementById('suspendForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        const reason = document.getElementById('suspendReason')?.value || 'Other';
        const notes = document.getElementById('suspendNotes')?.value || '';
        await patchRequest(`/admin/merchants/${encodeURIComponent(merchantId)}/status`, {
          status: 'suspended',
          reason,
          notes,
        });
        showToast('Merchant suspended successfully');
        setTimeout(() => window.location.reload(), 500);
      } catch (error) {
        showToast(error.message || 'Failed to suspend merchant', 'error');
      }
    });

    document.getElementById('activateForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await patchRequest(`/admin/merchants/${encodeURIComponent(merchantId)}/status`, { status: 'active' });
        showToast('Merchant activated successfully');
        setTimeout(() => window.location.reload(), 500);
      } catch (error) {
        showToast(error.message || 'Failed to activate merchant', 'error');
      }
    });
  })();
</script>

