<script nonce="<%= locals.cspNonce || '' %>">
  (() => {
    const merchantSearch = document.getElementById('merchantSearch');
    const statusFilter = document.getElementById('statusFilter');
    const categoryFilter = document.getElementById('categoryFilter');
    const resetFilters = document.getElementById('resetFilters');
    const exportAllBtn = document.getElementById('exportAllBtn');
    const merchantRows = Array.from(document.querySelectorAll('#merchantTableBody tr[data-id]'));

    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const rowChecks = Array.from(document.querySelectorAll('.row-check'));
    const bulkActionBar = document.getElementById('bulkActionBar');
    const bulkSelectedCount = document.getElementById('bulkSelectedCount');

    const bulkActivateBtn = document.getElementById('bulkActivateBtn');
    const bulkSuspendBtn = document.getElementById('bulkSuspendBtn');
    const bulkVerifyBtn = document.getElementById('bulkVerifyBtn');
    const bulkExportBtn = document.getElementById('bulkExportBtn');
    const bulkClearBtn = document.getElementById('bulkClearBtn');

    const verifyMerchantForm = document.getElementById('verifyMerchantForm');
    const verifyMerchantId = document.getElementById('verifyMerchantId');
    const verifyBusinessName = document.getElementById('verifyBusinessName');

    const suspendMerchantForm = document.getElementById('suspendMerchantForm');
    const suspendMerchantId = document.getElementById('suspendMerchantId');
    const suspendBusinessName = document.getElementById('suspendBusinessName');

    const deleteMerchantId = document.getElementById('deleteMerchantId');
    const deleteConfirmName = document.getElementById('deleteConfirmName');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

    function showToast(message, type = 'success') {
      const host = document.getElementById('toastContainer') || document.body;
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type === 'error' ? 'admin-toast-error' : 'admin-toast-success'}`;
      toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i><span>${message}</span>`;
      host.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 260);
      }, 2200);
    }

    function getSelectedIds() {
      return rowChecks.filter((c) => c.checked).map((c) => c.value);
    }

    function updateBulkBar() {
      const ids = getSelectedIds();
      bulkSelectedCount.textContent = `${ids.length} merchants selected`;
      bulkActionBar.style.display = ids.length ? 'inline-flex' : 'none';
      selectAllCheckbox.checked = rowChecks.length && rowChecks.every((c) => c.checked);
    }

    let _activeMerchantId = null;
    let _activeMerchantName = null;
    const floatingDropdown = document.getElementById('merchantFloatingDropdown');

    function closeFloatingDropdown() {
      if (!floatingDropdown) return;
      floatingDropdown.style.display = 'none';
      floatingDropdown._openBtn = null;
    }

    window.toggleMerchantDropdown = function toggleMerchantDropdown(btn) {
      if (!floatingDropdown) return;

      if (floatingDropdown.style.display === 'block' && floatingDropdown._openBtn === btn) {
        closeFloatingDropdown();
        return;
      }

      const merchantId = btn.getAttribute('data-merchant-id');
      const merchantStatus = btn.getAttribute('data-merchant-status');
      const merchantVerified = btn.getAttribute('data-merchant-verified');
      const merchantName = btn.getAttribute('data-merchant-name');

      _activeMerchantId = merchantId;
      _activeMerchantName = merchantName;

      const ddVerify = document.getElementById('ddVerify');
      const ddActivate = document.getElementById('ddActivate');
      const ddSuspend = document.getElementById('ddSuspend');
      const ddViewDetails = document.getElementById('ddViewDetails');

      if (ddVerify) ddVerify.style.display = merchantVerified === 'false' ? 'flex' : 'none';
      if (ddActivate) ddActivate.style.display = merchantStatus !== 'active' ? 'flex' : 'none';
      if (ddSuspend) ddSuspend.style.display = merchantStatus === 'active' ? 'flex' : 'none';
      if (ddViewDetails) ddViewDetails.href = '/admin/merchants/' + merchantId;

      const rect = btn.getBoundingClientRect();
      const dropdownWidth = 200;
      let left = rect.right - dropdownWidth;
      let top = rect.bottom + 4;

      floatingDropdown.style.display = 'block';
      const ddHeight = floatingDropdown.offsetHeight;
      if (top + ddHeight > window.innerHeight - 10) {
        top = rect.top - ddHeight - 4;
      }

      if (left < 8) left = 8;

      floatingDropdown.style.left = left + 'px';
      floatingDropdown.style.top = top + 'px';
      floatingDropdown._openBtn = btn;
    };

    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('open');
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('open');
    }

    window.openVerifyModal = function openVerifyModal(merchantId, businessName) {
      verifyMerchantId.value = merchantId || '';
      verifyBusinessName.textContent = businessName || '-';
      openModal('verifyMerchantModal');
    };

    window.openSuspendModal = function openSuspendModal(merchantId, businessName) {
      suspendMerchantId.value = merchantId || '';
      suspendBusinessName.textContent = businessName || '-';
      openModal('suspendMerchantModal');
    };

    window.openDeleteModal = function openDeleteModal(merchantId, businessName) {
      deleteMerchantId.value = merchantId || '';
      deleteConfirmName.value = '';
      deleteConfirmName.dataset.name = businessName || '';
      confirmDeleteBtn.disabled = true;
      openModal('deleteMerchantModal');
    };

    window.openDocsModal = function openDocsModal() {
      openModal('viewDocsModal');
    };

    function applyClientFilters() {
      const q = (merchantSearch.value || '').trim().toLowerCase();
      const status = statusFilter.value;
      const category = categoryFilter.value;

      merchantRows.forEach((row) => {
        const rowStatus = row.dataset.status || '';
        const rowCategory = row.dataset.category || '';
        const rowSearch = row.dataset.search || '';

        const passQ = !q || rowSearch.includes(q);
        const passStatus = status === 'all' || rowStatus === status;
        const passCategory = category === 'all' || rowCategory === category;

        row.style.display = passQ && passStatus && passCategory ? '' : 'none';
      });
    }

    async function patchStatus(merchantId, status, body = {}) {
      const resp = await fetch(`/admin/merchants/${encodeURIComponent(merchantId)}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, ...body }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.success) throw new Error(data.message || 'Request failed');
      return data;
    }

    async function runBulk(action) {
      const merchantIds = getSelectedIds();
      if (!merchantIds.length) {
        showToast('No merchants selected', 'error');
        return;
      }

      const resp = await fetch('/admin/merchants/bulk-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ merchantIds, action }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.success) {
        showToast(data.message || 'Bulk action failed', 'error');
        return;
      }

      showToast(data.message || 'Bulk action completed');
      setTimeout(() => window.location.reload(), 600);
    }

    document.addEventListener('click', (e) => {
      const openBtn = e.target.closest('[data-open-modal]');
      if (openBtn) {
        const modalId = openBtn.getAttribute('data-open-modal');
        const merchantId = openBtn.getAttribute('data-merchant-id');
        const merchantName = openBtn.getAttribute('data-merchant-name');

        if (modalId === 'verifyMerchantModal') openVerifyModal(merchantId, merchantName);
        else if (modalId === 'suspendMerchantModal') openSuspendModal(merchantId, merchantName);
        else if (modalId === 'deleteMerchantModal') openDeleteModal(merchantId, merchantName);
        else openModal(modalId);
        closeAllDropdowns();
        return;
      }

      const closeBtn = e.target.closest('[data-close-modal]');
      if (closeBtn) {
        closeModal(closeBtn.getAttribute('data-close-modal'));
        return;
      }

      if (floatingDropdown && !e.target.closest('#merchantFloatingDropdown') && !e.target.closest('.merchant-action-btn')) {
        closeFloatingDropdown();
      }
    });

    window.addEventListener('scroll', () => {
      closeFloatingDropdown();
    }, true);

    document.getElementById('ddVerify')?.addEventListener('click', () => {
      closeFloatingDropdown();
      openVerifyModal(_activeMerchantId, _activeMerchantName);
    });

    document.getElementById('ddActivate')?.addEventListener('click', () => {
      closeFloatingDropdown();
      merchantStatusAction(_activeMerchantId, 'active');
    });

    document.getElementById('ddSuspend')?.addEventListener('click', () => {
      closeFloatingDropdown();
      openSuspendModal(_activeMerchantId, _activeMerchantName);
    });

    document.getElementById('ddDocs')?.addEventListener('click', () => {
      closeFloatingDropdown();
      openDocsModal(_activeMerchantId);
    });

    document.getElementById('ddDelete')?.addEventListener('click', () => {
      closeFloatingDropdown();
      openDeleteModal(_activeMerchantId, _activeMerchantName);
    });

    window.merchantStatusAction = function merchantStatusAction(merchantId, status, btn) {
      const parentDrop = btn && btn.closest('.merchant-dropdown');
      if (parentDrop) parentDrop.style.display = 'none';
      closeFloatingDropdown();
      if (!confirm('Activate this merchant?')) return;

      fetch('/admin/merchants/' + merchantId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: status })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          alert(data.message);
          location.reload();
        } else {
          alert('Error: ' + (data.message || 'Request failed'));
        }
      })
      .catch(function() { alert('Network error'); });
    };

    document.querySelectorAll('.modal-overlay').forEach((overlay) => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.classList.remove('open');
      });
    });

    verifyMerchantForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const merchantId = verifyMerchantId.value;
      const resp = await fetch(`/admin/merchants/${encodeURIComponent(merchantId)}/verify`, { method: 'PATCH' });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.success) {
        showToast(data.message || 'Verify failed', 'error');
        return;
      }
      showToast(data.message || 'Merchant verified successfully');
      closeModal('verifyMerchantModal');
      setTimeout(() => window.location.reload(), 800);
    });

    suspendMerchantForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const merchantId = suspendMerchantId.value;
      const reason = document.getElementById('suspendReason').value;
      const notes = document.getElementById('suspendNotes').value;
      try {
        await patchStatus(merchantId, 'suspended', { reason, notes });
        showToast('Merchant suspended successfully');
        closeModal('suspendMerchantModal');
        setTimeout(() => window.location.reload(), 800);
      } catch (err) {
        showToast(err.message || 'Suspend failed', 'error');
      }
    });

    deleteConfirmName?.addEventListener('input', () => {
      const expected = (deleteConfirmName.dataset.name || '').trim();
      const typed = deleteConfirmName.value.trim();
      confirmDeleteBtn.disabled = !(expected && typed === expected);
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      const merchantId = deleteMerchantId.value;
      const resp = await fetch(`/admin/merchants/${encodeURIComponent(merchantId)}`, { method: 'DELETE' });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.success) {
        showToast(data.message || 'Delete failed', 'error');
        return;
      }
      showToast('Merchant deleted successfully');
      closeModal('deleteMerchantModal');
      setTimeout(() => window.location.reload(), 800);
    });

    merchantSearch?.addEventListener('input', applyClientFilters);
    statusFilter?.addEventListener('change', applyClientFilters);
    categoryFilter?.addEventListener('change', applyClientFilters);

    resetFilters?.addEventListener('click', () => {
      merchantSearch.value = '';
      statusFilter.value = 'all';
      categoryFilter.value = 'all';
      applyClientFilters();
    });

    exportAllBtn?.addEventListener('click', () => {
      window.location.href = '/admin/merchants/export';
    });

    document.getElementById('paginationBar')?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-page]');
      if (!btn || btn.disabled) return;
      const page = btn.getAttribute('data-page');
      const url = new URL(window.location.href);
      url.searchParams.set('page', page);
      window.location.href = url.toString();
    });

    selectAllCheckbox?.addEventListener('change', () => {
      rowChecks.forEach((c) => { c.checked = selectAllCheckbox.checked; });
      updateBulkBar();
    });

    rowChecks.forEach((c) => c.addEventListener('change', updateBulkBar));

    bulkActivateBtn?.addEventListener('click', () => runBulk('activate'));
    bulkSuspendBtn?.addEventListener('click', () => runBulk('suspend'));
    bulkVerifyBtn?.addEventListener('click', () => runBulk('verify'));
    bulkExportBtn?.addEventListener('click', () => {
      const ids = getSelectedIds();
      if (!ids.length) {
        showToast('No merchants selected', 'error');
        return;
      }
      window.location.href = '/admin/merchants/export?ids=' + encodeURIComponent(ids.join(','));
    });

    bulkClearBtn?.addEventListener('click', () => {
      rowChecks.forEach((c) => { c.checked = false; });
      selectAllCheckbox.checked = false;
      updateBulkBar();
    });

    updateBulkBar();
  })();
</script>

