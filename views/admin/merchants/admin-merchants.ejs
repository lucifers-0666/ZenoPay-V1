<style>
  .merchants-page { display: grid; gap: 16px; }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
  }

  .page-header-left {
    display: flex;
    flex-direction: column;
  }

  .page-title-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .page-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(139, 92, 246, 0.15);
    color: #8B5CF6;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .page-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-dark, #1e293b);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: #94a3b8;
    margin: 4px 0 0 0;
  }

  .breadcrumb {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .breadcrumb i.fa-chevron-right {
    font-size: 0.6rem;
    color: #94a3b8;
  }

  .breadcrumb .current {
    color: var(--primary);
    font-weight: 600;
  }

  .page-header-right {
    display: inline-flex;
    align-items: center;
  }

  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-card .stat-info { flex: 1; }

  .stat-card .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0 0 6px 0;
  }

  .stat-card .stat-value {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-dark, #1e293b);
    margin: 0;
    line-height: 1;
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    color: inherit;
  }
  .stat-icon.blue { background: var(--primary); }
  .stat-icon.green { background: var(--green); }
  .stat-icon.amber { background: var(--amber); }
  .stat-icon.purple { background: var(--secondary); }
  .stat-label { color: var(--text-soft); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }
  .stat-value { color: var(--text-dark); font-size: 22px; font-weight: 800; line-height: 1.1; }

  .filter-card { border: 1px solid var(--border); background: var(--card-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 12px; display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 10px; }
  .filter-input, .filter-select { height: 40px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card-bg); color: var(--text-dark); font-size: 13px; padding: 0 12px; }

  .btn-outline-admin { border: 1px solid var(--border); background: var(--card-bg); color: var(--text-mid); height: 40px; border-radius: 999px; padding: 0 14px; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; }
  .btn-outline-blue { border-color: var(--primary); color: var(--primary); }
  .btn-outline-blue:hover { background: color-mix(in srgb, var(--primary) 10%, var(--card-bg)); }

  .table-card { border: 1px solid var(--border); background: var(--card-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: visible; }
  .admin-table-wrapper { overflow-x: auto; }
  .merchants-table { width: 100%; min-width: 1050px; border-collapse: separate; border-spacing: 0; }
  .merchants-table thead th { background: var(--bg-page); color: var(--text-mid); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border); padding: 12px 14px; white-space: nowrap; }
  .merchants-table tbody td { padding: 14px 16px; border-bottom: 1px solid var(--border-light); white-space: nowrap; vertical-align: middle; }
  .merchants-table th:last-child, .merchants-table td:last-child { position: sticky; right: 0; background: var(--card-bg); }
  .merchants-table thead th:last-child { background: var(--bg-page); z-index: 3; }
  .merchants-table tbody td:last-child { z-index: 2; }

  .merchant-cell { display: inline-flex; align-items: center; gap: 10px; }
  .merchant-logo { width: 38px; height: 38px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: var(--card-bg); font-weight: 800; font-size: 14px; }
  .merchant-logo.tone-primary { background: var(--primary); }
  .merchant-logo.tone-secondary { background: var(--secondary); }
  .merchant-logo.tone-green { background: var(--green); }
  .merchant-logo.tone-amber { background: var(--amber); }
  .merchant-logo.tone-muted { background: var(--text-soft); }
  .merchant-name { font-weight: 600; font-size: .9rem; color: var(--text-dark); }
  .merchant-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--primary); font-size: .75rem; margin-top: 2px; }

  .category-badge { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-page); color: var(--text-mid); padding: 4px 9px; font-size: 11px; font-weight: 700; }
  .cat-e-commerce i { color: var(--primary); }
  .cat-food-and-beverage i { color: color-mix(in srgb, var(--amber) 80%, var(--red) 20%); }
  .cat-travel i { color: color-mix(in srgb, var(--primary) 55%, var(--green) 45%); }
  .cat-healthcare i { color: var(--red); }
  .cat-education i { color: var(--secondary); }
  .cat-retail i { color: var(--green); }
  .cat-entertainment i { color: color-mix(in srgb, var(--secondary) 70%, var(--red) 30%); }
  .cat-finance i { color: var(--amber); }
  .cat-other i { color: var(--text-soft); }

  .contact-stack { display: grid; gap: 2px; }
  .contact-stack .email { color: var(--text-dark); font-size: 12px; }
  .contact-stack .phone { color: var(--text-soft); font-size: 12px; }

  .volume-text { text-align: right; color: var(--green-dark); font-weight: 700; }
  .right { text-align: right; }

  .verify-icon.verified { color: var(--green); }
  .verify-icon.not-verified { color: var(--text-soft); }

  .merchant-dropdown button:hover,
  .merchant-dropdown a:hover {
    background: #f8fafc;
  }

  .badge { display: inline-flex; border-radius: 999px; padding: 4px 9px; font-size: 11px; font-weight: 700; text-transform: capitalize; border: 1px solid transparent; }
  .badge-success { background: color-mix(in srgb, var(--green) 14%, var(--card-bg)); color: var(--green-dark); border-color: color-mix(in srgb, var(--green) 30%, var(--card-bg)); }
  .badge-warning { background: color-mix(in srgb, var(--amber) 14%, var(--card-bg)); color: var(--amber-dark); border-color: color-mix(in srgb, var(--amber) 30%, var(--card-bg)); }
  .badge-danger { background: color-mix(in srgb, var(--red) 14%, var(--card-bg)); color: var(--red-dark); border-color: color-mix(in srgb, var(--red) 30%, var(--card-bg)); }
  .badge-rejected { background: color-mix(in srgb, var(--red-dark) 18%, var(--card-bg)); color: var(--red-dark); border-color: color-mix(in srgb, var(--red-dark) 30%, var(--card-bg)); }

  .empty-state { padding: 30px 14px; text-align: center; color: var(--text-soft); }
  .empty-state i { font-size: 54px; margin-bottom: 8px; }
  .empty-state h4 { color: var(--text-dark); font-weight: 800; margin-bottom: 4px; }

  .pagination-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-top: 1px solid var(--border-light); color: var(--text-soft); font-size: 12px; }
  .pages { display: inline-flex; gap: 6px; align-items: center; }
  .page-btn { min-width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text-mid); font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .page-btn.active { border-color: var(--primary); color: var(--primary-dark); }

  .bulk-action-bar {
    position: fixed; left: 50%; transform: translateX(-50%); bottom: 22px; z-index: 450;
    background: var(--sidebar-bg); border: 1px solid var(--sidebar-border); color: var(--card-bg);
    border-radius: 999px; box-shadow: var(--shadow-lg); padding: 8px 10px; display: none; align-items: center; gap: 8px;
  }
  .bulk-count { font-size: 12px; font-weight: 700; color: var(--sidebar-text); margin-right: 4px; }
  .bulk-btn { height: 34px; border-radius: 999px; padding: 0 12px; border: 1px solid transparent; font-size: 12px; font-weight: 700; color: var(--card-bg); display: inline-flex; gap: 7px; align-items: center; }
  .bulk-btn.green { background: color-mix(in srgb, var(--green) 60%, transparent); border-color: color-mix(in srgb, var(--green) 60%, transparent); }
  .bulk-btn.red { background: color-mix(in srgb, var(--red) 65%, transparent); border-color: color-mix(in srgb, var(--red) 65%, transparent); }
  .bulk-btn.purple { background: color-mix(in srgb, var(--secondary) 65%, transparent); border-color: color-mix(in srgb, var(--secondary) 65%, transparent); }
  .bulk-btn.gray { background: color-mix(in srgb, var(--text-soft) 35%, transparent); border-color: color-mix(in srgb, var(--text-soft) 35%, transparent); }

  .modal-overlay { position: fixed; inset: 0; background: color-mix(in srgb, var(--text-dark) 45%, transparent); display: none; align-items: center; justify-content: center; z-index: 500; padding: 18px; }
  .modal-overlay.open { display: flex; }
  .modal-card { width: min(560px, 100%); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card-bg); box-shadow: var(--shadow-lg); overflow: hidden; }
  .modal-header { padding: 14px 16px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; }
  .modal-title { font-size: 16px; font-weight: 800; color: var(--text-dark); display: inline-flex; align-items: center; gap: 8px; }
  .modal-title.green { color: var(--green-dark); }
  .modal-title.red { color: var(--red-dark); }
  .modal-close { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border); background: var(--card-bg); color: var(--text-soft); }
  .modal-body { padding: 14px 16px; display: grid; gap: 10px; }
  .modal-foot { padding: 12px 16px; border-top: 1px solid var(--border-light); display: flex; justify-content: flex-end; gap: 8px; }
  .field-label { color: var(--text-mid); font-size: 12px; font-weight: 700; }
  .field-input, .field-select, .field-textarea { width: 100%; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card-bg); color: var(--text-dark); font-size: 13px; padding: 10px 12px; }
  .field-textarea { resize: vertical; min-height: 88px; }
  .info-box-green { border: 1px solid color-mix(in srgb, var(--green) 35%, var(--card-bg)); background: color-mix(in srgb, var(--green) 10%, var(--card-bg)); color: var(--green-dark); border-radius: var(--radius-sm); padding: 10px; font-size: 12px; }
  .warning-box-red { border: 1px solid color-mix(in srgb, var(--red) 35%, var(--card-bg)); background: color-mix(in srgb, var(--red) 10%, var(--card-bg)); color: var(--red-dark); border-radius: var(--radius-sm); padding: 10px; font-size: 12px; }

  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .filter-card { grid-template-columns: 1fr; }
  }
</style>

<%
  const safeMerchants = Array.isArray(merchants) ? merchants : [];
  const safeFilters = filters || {};
  const current = Number(currentPage || 1);
  const pages = Math.max(1, Number(totalPages || 1));
  const start = totalCount ? ((current - 1) * 10 + 1) : 0;
  const end = Math.min(current * 10, Number(totalCount || 0));

  const categoryIcon = (category) => {
    const key = String(category || '').toLowerCase();
    if (key === 'e-commerce') return 'fa-cart-shopping';
    if (key === 'food & beverage') return 'fa-utensils';
    if (key === 'travel') return 'fa-plane';
    if (key === 'healthcare') return 'fa-heart-pulse';
    if (key === 'education') return 'fa-graduation-cap';
    if (key === 'retail') return 'fa-bag-shopping';
    if (key === 'entertainment') return 'fa-film';
    if (key === 'finance') return 'fa-landmark';
    return 'fa-briefcase';
  };

  const statusClass = (status) => {
    const s = String(status || '').toLowerCase();
    if (s === 'active') return 'badge-success';
    if (s === 'pending') return 'badge-warning';
    if (s === 'suspended') return 'badge-danger';
    if (s === 'rejected') return 'badge-rejected';
    return 'badge-warning';
  };

  const letterTone = (name) => {
    const n = String(name || 'M').charCodeAt(0);
    const idx = n % 5;
    if (idx === 0) return 'tone-primary';
    if (idx === 1) return 'tone-secondary';
    if (idx === 2) return 'tone-green';
    if (idx === 3) return 'tone-amber';
    return 'tone-muted';
  };
%>

<section class="merchants-page">
  <header class="page-header">
    <div class="page-header-left">
      <div class="page-title-wrap">
        <div class="page-icon">
          <i class="fas fa-store"></i>
        </div>
        <div>
          <h1 class="page-title">Merchants</h1>
          <p class="page-subtitle">Manage merchant accounts, verification and payment volumes</p>
        </div>
      </div>
      <div class="breadcrumb">
        <i class="fas fa-home"></i>
        <i class="fas fa-chevron-right"></i>
        <span class="current">Merchants</span>
      </div>
    </div>
    <div class="page-header-right">
      <button class="btn-outline-admin btn-outline-blue" id="exportAllBtn" type="button"><i class="fas fa-file-export"></i> Export</button>
    </div>
  </header>

  <section class="stats-grid">
    <article class="stat-card">
      <div class="stat-icon" style="background:rgba(59,130,246,0.12);">
        <i class="fas fa-store" style="color:#3B82F6;"></i>
      </div>
      <div class="stat-info">
        <p class="stat-label">Total Merchants</p>
        <h3 class="stat-value"><%= Number(totalCount || 0) %></h3>
      </div>
    </article>
    <article class="stat-card">
      <div class="stat-icon" style="background:rgba(34,197,94,0.12);">
        <i class="fas fa-circle-check" style="color:#22c55e;"></i>
      </div>
      <div class="stat-info">
        <p class="stat-label">Active Merchants</p>
        <h3 class="stat-value"><%= Number(activeCount || 0) %></h3>
      </div>
    </article>
    <article class="stat-card">
      <div class="stat-icon" style="background:rgba(245,158,11,0.12);">
        <i class="fas fa-clock" style="color:#f59e0b;"></i>
      </div>
      <div class="stat-info">
        <p class="stat-label">Pending Review</p>
        <h3 class="stat-value"><%= Number(pendingCount || 0) %></h3>
      </div>
    </article>
    <article class="stat-card">
      <div style="width:48px; height:48px; border-radius:12px;
                  background:rgba(139,92,246,0.12);
                  display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-shield-halved"
           style="color:#8B5CF6; font-size:1.25rem;"></i>
      </div>
      <div class="stat-info">
        <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.05em;
                  text-transform:uppercase; color:#94a3b8; margin:0 0 4px 0;">
          Verified
        </p>
        <h3 style="font-size:1.6rem; font-weight:700;
                   color:var(--text-dark, #1e293b); margin:0; line-height:1;">
          <%= Number(verifiedCount || 0) %>
        </h3>
      </div>
    </article>
  </section>

  <section class="filter-card">
    <input id="merchantSearch" class="filter-input" type="text" placeholder="Search by business name, email, merchant ID..." value="<%= safeFilters.search || '' %>">
    <select id="statusFilter" class="filter-select">
      <option value="all">All Status</option>
      <option value="active" <%= safeFilters.status==='active' ? 'selected' : '' %>>Active</option>
      <option value="pending" <%= safeFilters.status==='pending' ? 'selected' : '' %>>Pending</option>
      <option value="suspended" <%= safeFilters.status==='suspended' ? 'selected' : '' %>>Suspended</option>
      <option value="rejected" <%= safeFilters.status==='rejected' ? 'selected' : '' %>>Rejected</option>
    </select>
    <select id="categoryFilter" class="filter-select">
      <option value="all">All Categories</option>
      <option value="E-Commerce" <%= safeFilters.category==='E-Commerce' ? 'selected' : '' %>>E-Commerce</option>
      <option value="Food & Beverage" <%= safeFilters.category==='Food & Beverage' ? 'selected' : '' %>>Food & Beverage</option>
      <option value="Travel" <%= safeFilters.category==='Travel' ? 'selected' : '' %>>Travel</option>
      <option value="Healthcare" <%= safeFilters.category==='Healthcare' ? 'selected' : '' %>>Healthcare</option>
      <option value="Education" <%= safeFilters.category==='Education' ? 'selected' : '' %>>Education</option>
      <option value="Retail" <%= safeFilters.category==='Retail' ? 'selected' : '' %>>Retail</option>
      <option value="Entertainment" <%= safeFilters.category==='Entertainment' ? 'selected' : '' %>>Entertainment</option>
      <option value="Finance" <%= safeFilters.category==='Finance' ? 'selected' : '' %>>Finance</option>
      <option value="Other" <%= safeFilters.category==='Other' ? 'selected' : '' %>>Other</option>
    </select>
    <button id="resetFilters" class="btn-outline-admin" type="button"><i class="fas fa-rotate-left"></i> Reset</button>
  </section>

  <section class="table-card">
    <div class="admin-table-wrapper">
      <table class="merchants-table" id="merchantsTable">
        <thead>
          <tr>
            <th><input id="selectAllCheckbox" type="checkbox"></th>
            <th>Merchant</th>
            <th>Category</th>
            <th>Contact</th>
            <th class="right">Total Volume</th>
            <th class="right">Transactions</th>
            <th>Verified</th>
            <th>Status</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="merchantTableBody">
          <% if (safeMerchants.length) { %>
            <% safeMerchants.forEach((merchant) => { %>
              <tr data-id="<%= merchant.id %>" data-name="<%= merchant.businessName %>" data-status="<%= merchant.status %>" data-category="<%= merchant.category %>" data-search="<%= `${merchant.businessName} ${merchant.merchantId} ${merchant.email}`.toLowerCase() %>">
                <td><input class="row-check" value="<%= merchant.id %>" type="checkbox"></td>
                <td>
                  <div class="merchant-cell">
                    <span class="merchant-logo <%= letterTone(merchant.businessName) %>"><%= (merchant.businessName || 'M').charAt(0).toUpperCase() %></span>
                    <div>
                      <div class="merchant-name"><%= merchant.businessName %></div>
                      <div class="merchant-id"><%= merchant.merchantId %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="category-badge cat-<%= String(merchant.category || '').toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and') %>">
                    <i class="fas <%= categoryIcon(merchant.category) %>"></i>
                    <%= merchant.category %>
                  </span>
                </td>
                <td>
                  <div class="contact-stack">
                    <span class="email"><%= merchant.email %></span>
                    <span class="phone"><%= merchant.phone %></span>
                  </div>
                </td>
                <td class="right"><span class="volume-text">₹<%= merchant.totalVolumeText %></span></td>
                <td class="right"><%= merchant.transactions %></td>
                <td style="text-align:center; vertical-align:middle;">
                  <% if (merchant.isVerified) { %>
                    <span style="display:inline-flex; align-items:center; gap:5px;
                                 background:rgba(34,197,94,0.1); color:#16a34a;
                                 padding:4px 10px; border-radius:20px;
                                 font-size:0.78rem; font-weight:600;">
                      <i class="fas fa-shield-halved"></i> Yes
                    </span>
                  <% } else { %>
                    <span style="display:inline-flex; align-items:center; gap:5px;
                                 background:rgba(100,116,139,0.1); color:#64748b;
                                 padding:4px 10px; border-radius:20px;
                                 font-size:0.78rem; font-weight:600;">
                      <i class="fas fa-shield"></i> No
                    </span>
                  <% } %>
                </td>
                <td><span class="badge <%= statusClass(merchant.status) %>"><%= merchant.status %></span></td>
                <td><%= merchant.joinedAtText %></td>
                <td class="action-cell" style="position:relative; overflow:visible; width:60px; text-align:center;">
                  <button type="button"
                    class="merchant-action-btn"
                    data-merchant-id="<%= merchant.id %>"
                    data-merchant-status="<%= merchant.status %>"
                    data-merchant-verified="<%= merchant.isVerified ? 'true' : 'false' %>"
                    data-merchant-name="<%= merchant.businessName %>"
                    onclick="toggleMerchantDropdown(this)"
                    style="background:none; border:none; cursor:pointer;
                           width:32px; height:32px; border-radius:6px;
                           display:inline-flex; align-items:center;
                           justify-content:center; color:#94a3b8; font-size:1rem;">
                    <i class="fas fa-ellipsis-v"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10">
                <div class="empty-state">
                  <i class="fas fa-store"></i>
                  <h4>No merchants found</h4>
                  <p>Merchant accounts will appear here</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="pagination-row">
      <span>Showing <%= start %>–<%= end %> of <%= Number(totalCount || 0) %> merchants</span>
      <div class="pages" id="paginationBar">
        <button class="page-btn" type="button" data-page="<%= Math.max(1, current - 1) %>" <%= current <= 1 ? 'disabled' : '' %>>Prev</button>
        <% for (let i = 1; i <= pages; i++) { %>
          <button class="page-btn <%= i===current ? 'active' : '' %>" type="button" data-page="<%= i %>"><%= i %></button>
        <% } %>
        <button class="page-btn" type="button" data-page="<%= Math.min(pages, current + 1) %>" <%= current >= pages ? 'disabled' : '' %>>Next</button>
      </div>
    </div>
  </section>
</section>

