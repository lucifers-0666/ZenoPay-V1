<%
  const adminUser =
    (typeof user !== 'undefined' && user) ||
    (typeof admin !== 'undefined' && admin) ||
    (typeof locals !== 'undefined' && locals && (locals.user || locals.admin)) ||
    null;
  const adminName = (adminUser && adminUser.name) ? adminUser.name : 'Admin User';
  const initials = adminName.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
%>

<header class="admin-header">
  <button class="header-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
    <i class="fas fa-bars"></i>
  </button>

  <div class="header-search">
    <i class="fas fa-search"></i>
    <input type="text" placeholder="Search users, merchants, transactions...">
  </div>

  <div class="header-right">
    <button class="header-icon-btn" title="Notifications" aria-label="Notifications">
      <i class="fas fa-bell"></i>
      <span class="notif-dot"></span>
    </button>

    <button class="header-icon-btn" title="Messages" aria-label="Messages">
      <i class="fas fa-envelope"></i>
    </button>

    <div class="header-user" id="userMenuBtn" role="button" tabindex="0" aria-label="Open user menu">
      <div class="header-user-avatar"><%= initials %></div>
      <div>
        <div class="header-user-name"><%= adminName %></div>
        <div class="header-user-role">Super Admin</div>
      </div>
      <i class="fas fa-chevron-down" style="font-size:11px;color:var(--text-soft);"></i>
    </div>

    <div id="userDropdown" style="position:absolute;right:24px;top:56px;background:#fff;border:1px solid var(--border);border-radius:var(--r-md);box-shadow:var(--shadow-md);min-width:200px;display:none;z-index:60;">
      <a href="/admin/profile" style="display:block;padding:10px 14px;font-size:13px;color:var(--text-mid);">My Profile</a>
      <a href="/admin/settings" style="display:block;padding:10px 14px;font-size:13px;color:var(--text-mid);">Settings</a>
      <a href="/admin/logout" style="display:block;padding:10px 14px;font-size:13px;color:var(--red);border-top:1px solid var(--border-light);">Logout</a>
    </div>
  </div>
</header>
