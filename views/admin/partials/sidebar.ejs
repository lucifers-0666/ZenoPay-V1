<%
  /* Safe defaults — prevent ReferenceError when locals are not passed */
  const _page       = (typeof page       !== 'undefined') ? page       : '';
  const _kycPending  = (typeof kycPending  !== 'undefined') ? kycPending  : 0;
  const _supportOpen = (typeof supportOpen !== 'undefined') ? supportOpen : 0;
%>

<aside class="admin-sidebar" id="adminSidebar">

  <!-- Logo -->
  <div class="sidebar-logo">
    <img src="/images/logo.svg" alt="ZenoPay" height="28">
    <span class="logo-text">ZenoPay</span>
    <span class="admin-badge">ADMIN</span>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav">

    <!-- MAIN -->
    <div class="sidebar-section-label">Main</div>
    <a href="/admin/dashboard" class="sidebar-link <%= _page === 'dashboard' ? 'active' : '' %>">
      <i class="fas fa-home"></i> Dashboard
    </a>
    <a href="/admin/dashboard/statistics" class="sidebar-link <%= _page === 'statistics' ? 'active' : '' %>">
      <i class="fas fa-chart-bar"></i> Statistics
    </a>
    <a href="/admin/dashboard/activity-monitor" class="sidebar-link <%= _page === 'activity' ? 'active' : '' %>">
      <i class="fas fa-bolt"></i> Activity Monitor
    </a>

    <!-- USER MANAGEMENT -->
    <div class="sidebar-section-label">User Management</div>
    <a href="/admin/users" class="sidebar-link <%= _page === 'users' ? 'active' : '' %>">
      <i class="fas fa-users"></i> Users List
    </a>
    <a href="/admin/kyc" class="sidebar-link <%= _page === 'kyc' ? 'active' : '' %>">
      <i class="fas fa-id-card"></i> KYC Management
      <% if(_kycPending > 0) { %>
        <span class="sidebar-badge"><%= _kycPending %></span>
      <% } %>
    </a>
    <a href="/admin/support" class="sidebar-link <%= _page === 'support' ? 'active' : '' %>">
      <i class="fas fa-headset"></i> Support Tickets
      <% if(_supportOpen > 0) { %>
        <span class="sidebar-badge"><%= _supportOpen %></span>
      <% } %>
    </a>

    <!-- MERCHANT MANAGEMENT -->
    <div class="sidebar-section-label">Merchants & Banks</div>
    <a href="/admin/merchants" class="sidebar-link has-sub <%= ['merchants','merchants-pending'].includes(_page) ? 'active open' : '' %>" data-submenu="sub-merchants">
      <i class="fas fa-store"></i> Merchants
      <i class="fas fa-chevron-down sidebar-arrow"></i>
    </a>
    <div class="sidebar-submenu <%= ['merchants','merchants-pending'].includes(_page) ? 'open' : '' %>" id="sub-merchants">
      <a href="/admin/merchants" class="sidebar-link <%= _page === 'merchants' ? 'active' : '' %>"><i class="fas fa-list"></i> All Merchants</a>
      <a href="/admin/merchants/pending" class="sidebar-link <%= _page === 'merchants-pending' ? 'active' : '' %>"><i class="fas fa-clock"></i> Pending Approval</a>
    </div>

    <a href="/admin/banks" class="sidebar-link has-sub <%= ['banks','banks-pending'].includes(_page) ? 'active open' : '' %>" data-submenu="sub-banks">
      <i class="fas fa-university"></i> Banks
      <i class="fas fa-chevron-down sidebar-arrow"></i>
    </a>
    <div class="sidebar-submenu <%= ['banks','banks-pending'].includes(_page) ? 'open' : '' %>" id="sub-banks">
      <a href="/admin/banks" class="sidebar-link <%= _page === 'banks' ? 'active' : '' %>"><i class="fas fa-list"></i> All Banks</a>
      <a href="/admin/banks/pending" class="sidebar-link <%= _page === 'banks-pending' ? 'active' : '' %>"><i class="fas fa-clock"></i> Pending Approval</a>
    </div>

    <!-- TRANSACTIONS -->
    <div class="sidebar-section-label">Transactions</div>
    <a href="/admin/transactions" class="sidebar-link <%= _page === 'transactions' ? 'active' : '' %>">
      <i class="fas fa-exchange-alt"></i> All Transactions
    </a>
    <a href="/admin/transactions/flagged" class="sidebar-link <%= _page === 'transactions-flagged' ? 'active' : '' %>">
      <i class="fas fa-flag"></i> Flagged
    </a>
    <a href="/admin/transactions/failed" class="sidebar-link <%= _page === 'transactions-failed' ? 'active' : '' %>">
      <i class="fas fa-times-circle"></i> Failed
    </a>

    <!-- ANALYTICS -->
    <div class="sidebar-section-label">Analytics</div>
    <a href="/admin/analytics" class="sidebar-link <%= _page === 'analytics' ? 'active' : '' %>">
      <i class="fas fa-chart-line"></i> Analytics
    </a>
    <a href="/admin/reports" class="sidebar-link <%= _page === 'reports' ? 'active' : '' %>">
      <i class="fas fa-file-alt"></i> Reports
    </a>
    <a href="/admin/audit-logs" class="sidebar-link <%= _page === 'audit-logs' ? 'active' : '' %>">
      <i class="fas fa-history"></i> Audit Logs
    </a>

    <!-- PLATFORM -->
    <div class="sidebar-section-label">Platform</div>
    <a href="/admin/notifications" class="sidebar-link <%= _page === 'notifications' ? 'active' : '' %>">
      <i class="fas fa-bell"></i> Notifications
    </a>
    <a href="/admin/pricing" class="sidebar-link <%= _page === 'pricing' ? 'active' : '' %>">
      <i class="fas fa-tag"></i> Pricing
    </a>
    <a href="/admin/privacy-policy" class="sidebar-link <%= _page === 'privacy' ? 'active' : '' %>">
      <i class="fas fa-shield-alt"></i> Privacy Policy
    </a>
    <a href="/blog/admin/dashboard" class="sidebar-link <%= _page === 'blog' ? 'active' : '' %>">
      <i class="fas fa-rss"></i> Blog Manager
    </a>

    <!-- SETTINGS -->
    <div class="sidebar-section-label">System</div>
    <a href="/admin/settings" class="sidebar-link <%= _page === 'settings' ? 'active' : '' %>">
      <i class="fas fa-cog"></i> Settings
    </a>

  </nav>

  <!-- Footer -->
  <div class="sidebar-footer">
    <a href="/" target="_blank" class="sidebar-link">
      <i class="fas fa-external-link-alt"></i> View Live Site
    </a>
    <a href="/admin/logout" class="sidebar-link" style="color: #F87171;">
      <i class="fas fa-sign-out-alt"></i> Logout
    </a>
  </div>

</aside>
