<%
  /* Safe defaults — prevent ReferenceError when locals are not passed */
  const _page       = (typeof adminPage  !== 'undefined') ? adminPage  : ((typeof page !== 'undefined') ? page : '');
  const _kycPending  = (typeof kycPending  !== 'undefined') ? kycPending  : 0;
  const _supportOpen = (typeof supportOpen !== 'undefined') ? supportOpen : 0;
  const _unreadCount = (typeof unreadCount !== 'undefined') ? unreadCount : 0;
%>

<aside class="admin-sidebar" id="adminSidebar">

  <!-- Logo -->
  <div class="sidebar-logo">
    <img src="/images/logo.svg" alt="ZenoPay" height="28">
    <span class="logo-text">ZenoPay</span>
    <span class="admin-badge">ADMIN</span>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav">

    <!-- MAIN -->
    <div class="sidebar-section-label">Main</div>
    <a href="/admin/dashboard" class="sidebar-link <%= _page === 'dashboard' ? 'active' : '' %>" data-tooltip="Dashboard">
      <i class="fas fa-home"></i> <span>Dashboard</span>
    </a>
    <a href="/admin/dashboard/statistics" class="sidebar-link <%= _page === 'statistics' ? 'active' : '' %>" data-tooltip="Statistics">
      <i class="fas fa-chart-line"></i> <span>Statistics</span>
    </a>
    <a href="/admin/dashboard/activity-monitor" class="sidebar-link <%= _page === 'activity-monitor' ? 'active' : '' %>" data-tooltip="Activity Monitor">
      <i class="fas fa-bolt"></i> <span>Activity Monitor</span>
      <% if (typeof failedToday !== 'undefined' && failedToday > 0) { %>
        <span class="sidebar-badge"><%= failedToday %></span>
      <% } %>
    </a>

    <!-- USER MANAGEMENT -->
    <div class="sidebar-section-label">User Management</div>
    <a href="/admin/users" class="sidebar-link <%= _page === 'users' ? 'active' : '' %>" data-tooltip="Users List">
      <i class="fas fa-users"></i> <span>Users List</span>
    </a>
    <a href="/admin/kyc" class="sidebar-link <%= _page === 'kyc' ? 'active' : '' %>" data-tooltip="KYC Management">
      <i class="fas fa-id-card"></i> <span>KYC Management</span>
      <% if(_kycPending > 0) { %>
        <span class="sidebar-badge"><%= _kycPending %></span>
      <% } %>
    </a>
    <a href="/admin/support" class="sidebar-link <%= _page === 'support' ? 'active' : '' %>" data-tooltip="Support Tickets">
      <i class="fas fa-headset"></i> <span>Support Tickets</span>
      <% if(_supportOpen > 0) { %>
        <span class="sidebar-badge"><%= _supportOpen %></span>
      <% } %>
    </a>

    <!-- MERCHANT MANAGEMENT -->
    <div class="sidebar-section-label">Merchants & Banks</div>
    <a href="/admin/merchants" class="sidebar-link has-sub <%= ['merchants','merchants-pending'].includes(_page) ? 'active open' : '' %>" data-submenu="sub-merchants" data-tooltip="Merchants">
      <i class="fas fa-store"></i> <span>Merchants</span>
      <i class="fas fa-chevron-down sidebar-arrow"></i>
    </a>
    <div class="sidebar-submenu <%= ['merchants','merchants-pending'].includes(_page) ? 'open' : '' %>" id="sub-merchants">
      <a href="/admin/merchants" class="sidebar-link <%= _page === 'merchants' ? 'active' : '' %>" data-tooltip="Merchants List"><i class="fas fa-store"></i><span>Merchants List</span></a>
      <a href="/admin/merchants/pending" class="sidebar-link <%= _page === 'merchants-pending' ? 'active' : '' %>" data-tooltip="Pending Approval"><i class="fas fa-clock"></i><span>Pending Approval</span></a>
    </div>

    <a href="/admin/banks" class="sidebar-link has-sub <%= ['banks','banks-pending'].includes(_page) ? 'active open' : '' %>" data-submenu="sub-banks" data-tooltip="Banks">
      <i class="fas fa-university"></i> <span>Banks</span>
      <i class="fas fa-chevron-down sidebar-arrow"></i>
    </a>
    <div class="sidebar-submenu <%= ['banks','banks-pending'].includes(_page) ? 'open' : '' %>" id="sub-banks">
      <a href="/admin/banks" class="sidebar-link <%= _page === 'banks' ? 'active' : '' %>" data-tooltip="All Banks"><i class="fas fa-list"></i><span>All Banks</span></a>
      <a href="/admin/banks/pending" class="sidebar-link <%= _page === 'banks-pending' ? 'active' : '' %>" data-tooltip="Pending Approval"><i class="fas fa-clock"></i><span>Pending Approval</span></a>
    </div>

    <!-- TRANSACTIONS -->
    <div class="sidebar-section-label">Transactions</div>
    <a href="/admin/transactions" class="sidebar-link <%= _page === 'transactions' ? 'active' : '' %>" data-tooltip="All Transactions">
      <i class="fas fa-exchange-alt"></i> <span>All Transactions</span>
    </a>
    <a href="/admin/transactions/flagged" class="sidebar-link <%= _page === 'flagged' ? 'active' : '' %>" data-tooltip="Flagged">
      <i class="fas fa-flag"></i> <span>Flagged</span>
    </a>
    <a href="/admin/transactions/failed" class="sidebar-link <%= _page === 'failed' ? 'active' : '' %>" data-tooltip="Failed">
      <i class="fas fa-times-circle"></i> <span>Failed</span>
    </a>
    <a href="/admin/wallets" class="sidebar-link <%= _page === 'wallets' ? 'active' : '' %>" data-tooltip="Wallets">
      <i class="fas fa-wallet"></i> <span>Wallets</span>
    </a>
    <a href="/admin/refunds" class="sidebar-link <%= _page === 'refunds' ? 'active' : '' %>" data-tooltip="Refunds">
      <i class="fas fa-rotate-left"></i> <span>Refunds</span>
    </a>

    <!-- ANALYTICS -->
    <div class="sidebar-section-label">Analytics</div>
    <a href="/admin/analytics" class="sidebar-link <%= _page === 'analytics' ? 'active' : '' %>" data-tooltip="Analytics">
      <i class="fas fa-chart-line"></i> <span>Analytics</span>
    </a>
    <a href="/admin/reports" class="sidebar-link <%= _page === 'reports' ? 'active' : '' %>" data-tooltip="Reports">
      <i class="fas fa-file-alt"></i> <span>Reports</span>
    </a>

    <!-- PLATFORM -->
    <div class="sidebar-section-label">Platform</div>
    <a href="/admin/notifications" class="sidebar-link <%= _page === 'notifications' ? 'active' : '' %>" data-tooltip="Notifications">
      <i class="fas fa-bell"></i> <span>Notifications</span>
      <% if (_unreadCount > 0) { %>
        <span class="sidebar-badge"><%= _unreadCount %></span>
      <% } %>
    </a>
    <a href="/admin/pricing" class="sidebar-link <%= _page === 'pricing' ? 'active' : '' %>" data-tooltip="Pricing">
      <i class="fas fa-tag"></i> <span>Pricing</span>
    </a>
    <a href="/admin/privacy-policy" class="sidebar-link <%= _page === 'privacy' ? 'active' : '' %>" data-tooltip="Privacy Policy">
      <i class="fas fa-shield-alt"></i> <span>Privacy Policy</span>
    </a>
    <a href="/blog/admin/dashboard" class="sidebar-link <%= _page === 'blog' ? 'active' : '' %>" data-tooltip="Blog Manager">
      <i class="fas fa-rss"></i> <span>Blog Manager</span>
    </a>

    <!-- SETTINGS -->
    <div class="sidebar-section-label">System</div>
    <a href="/admin/admins" class="sidebar-link <%= _page === 'admins' ? 'active' : '' %>" data-tooltip="Admin Management">
      <i class="fas fa-user-shield"></i> <span>Admin Management</span>
    </a>
    <a href="/admin/settings" class="sidebar-link <%= _page === 'settings' ? 'active' : '' %>" data-tooltip="Settings">
      <i class="fas fa-gear"></i> <span>Settings</span>
    </a>
    <a href="/admin/audit-logs" class="sidebar-link <%= _page === 'audit-logs' ? 'active' : '' %>" data-tooltip="Audit Logs">
      <i class="fas fa-scroll"></i> <span>Audit Logs</span>
    </a>
    <a href="/admin/announcements" class="sidebar-link <%= _page === 'announcements' ? 'active' : '' %>" data-tooltip="Announcements">
      <i class="fas fa-bullhorn"></i> <span>Announcements</span>
    </a>

  </nav>

  <!-- Footer -->
  <div class="sidebar-footer">
    <a href="/admin/profile" class="sidebar-link <%= _page === 'profile' ? 'active' : '' %>" data-tooltip="My Profile">
      <i class="fas fa-circle-user"></i> <span>My Profile</span>
    </a>
    <a href="/" target="_blank" class="sidebar-link" data-tooltip="View Live Site">
      <i class="fas fa-external-link-alt"></i> <span>View Live Site</span>
    </a>
    <a href="/admin/logout" class="sidebar-link" style="color: #F87171;" data-tooltip="Logout">
      <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
    </a>
  </div>

  <!-- Sidebar collapse toggle — lives at bottom of sidebar -->
  <div class="sidebar-collapse-wrap">
    <button id="sidebar-collapse-btn" class="sidebar-collapse-btn" title="Collapse sidebar">
      <i class="fas fa-chevron-left" id="collapse-icon"></i>
      <span class="collapse-label">Collapse</span>
    </button>
  </div>

</aside>
