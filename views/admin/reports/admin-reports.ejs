<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const root = document.documentElement;
    const rootStyles = getComputedStyle(root);

    const cssVar = (name) => rootStyles.getPropertyValue(name).trim();

    const rgbaFromVar = (name, alpha) => {
      const raw = cssVar(name);
      if (!raw) return cssVar('--text-soft') || cssVar('--text-muted');

      if (raw.startsWith('#')) {
        const hex = raw.replace('#', '');
        const normalized = hex.length === 3
          ? hex.split('').map((c) => c + c).join('')
          : hex;

        const intVal = parseInt(normalized, 16);
        const r = (intVal >> 16) & 255;
        const g = (intVal >> 8) & 255;
        const b = intVal & 255;
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      }

      if (raw.startsWith('rgb(')) {
        const values = raw.replace('rgb(', '').replace(')', '').split(',').map((v) => v.trim());
        return `rgba(${values[0]}, ${values[1]}, ${values[2]}, ${alpha})`;
      }

      if (raw.startsWith('rgba(')) {
        return raw;
      }

      return raw;
    };

    const chartText = cssVar('--text-soft') || cssVar('--text-muted');
    const chartGrid = rgbaFromVar('--border', 0.8);
    const primary = cssVar('--primary');
    const success = cssVar('--green') || cssVar('--success');
    const warning = cssVar('--amber') || cssVar('--warning');
    const danger = cssVar('--red') || cssVar('--danger');
    const gray = cssVar('--text-soft');
    const secondary = cssVar('--secondary');

    const defaultChartOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          grid: { color: chartGrid, drawBorder: false },
          ticks: { color: chartText }
        },
        y: {
          grid: { color: chartGrid, drawBorder: false },
          ticks: { color: chartText }
        }
      }
    };

    const labels = ['Mar 01', 'Mar 03', 'Mar 05', 'Mar 07', 'Mar 09', 'Mar 11', 'Mar 13', 'Mar 15', 'Mar 17', 'Mar 19', 'Mar 21', 'Mar 23'];

    const revenueCanvas = document.getElementById('revenueOverTimeChart');
    if (revenueCanvas && window.Chart) {
      const gradient = revenueCanvas.getContext('2d').createLinearGradient(0, 0, 0, 260);
      gradient.addColorStop(0, rgbaFromVar('--primary', 0.35));
      gradient.addColorStop(1, rgbaFromVar('--primary', 0.02));

      new Chart(revenueCanvas, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Revenue (₹)',
            data: [2560000, 2850000, 3015000, 2925000, 3240000, 3565000, 3720000, 3980000, 4105000, 4320000, 4475000, 4625000],
            borderColor: primary,
            backgroundColor: gradient,
            borderWidth: 3,
            fill: true,
            tension: 0.38,
            pointRadius: 2,
            pointHoverRadius: 4,
            pointBackgroundColor: primary
          }]
        },
        options: {
          ...defaultChartOptions,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) {
                  return ` ₹${ctx.raw.toLocaleString('en-IN')}`;
                }
              }
            }
          }
        }
      });
    }

    const donutLabels = ['P2P Transfer', 'Merchant Payment', 'Wallet Top-Up', 'Refund'];
    const donutData = [44, 31, 19, 6];
    const donutColors = [primary, secondary, success, warning];

    const transactionBreakdownCanvas = document.getElementById('transactionBreakdownChart');
    if (transactionBreakdownCanvas && window.Chart) {
      new Chart(transactionBreakdownCanvas, {
        type: 'doughnut',
        data: {
          labels: donutLabels,
          datasets: [{
            data: donutData,
            backgroundColor: donutColors,
            borderColor: cssVar('--card-bg'),
            borderWidth: 2,
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

    const legendHost = document.getElementById('transactionLegend');
    if (legendHost) {
      legendHost.innerHTML = donutLabels.map((label, idx) => {
        return `
          <span class="legend-item">
            <span class="legend-dot legend-dot-${idx}"></span>
            <span>${label}</span>
          </span>
        `;
      }).join('');

      const legendDots = legendHost.querySelectorAll('.legend-dot');
      legendDots.forEach((dot, idx) => {
        dot.style.backgroundColor = donutColors[idx];
      });
    }

    const userGrowthCanvas = document.getElementById('userGrowthChart');
    if (userGrowthCanvas && window.Chart) {
      new Chart(userGrowthCanvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'New Registrations',
            data: [320, 410, 455, 498, 520, 560, 588, 604, 631, 658, 672, 705],
            backgroundColor: rgbaFromVar('--primary', 0.85),
            borderRadius: 8,
            borderSkipped: false,
            maxBarThickness: 24
          }]
        },
        options: {
          ...defaultChartOptions,
          plugins: { legend: { display: false } }
        }
      });
    }

    const kycStatusCanvas = document.getElementById('kycStatusChart');
    if (kycStatusCanvas && window.Chart) {
      new Chart(kycStatusCanvas, {
        type: 'bar',
        data: {
          labels: ['Approved', 'Pending', 'Rejected', 'Not Submitted'],
          datasets: [{
            label: 'KYC Profiles',
            data: [42100, 9350, 2180, 12440],
            backgroundColor: [success, warning, danger, gray],
            borderRadius: 8,
            borderSkipped: false
          }]
        },
        options: {
          ...defaultChartOptions,
          indexAxis: 'y',
          plugins: { legend: { display: false } }
        }
      });
    }

    const transactionHealthCanvas = document.getElementById('transactionHealthChart');
    if (transactionHealthCanvas && window.Chart) {
      new Chart(transactionHealthCanvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Success',
              data: [1320, 1388, 1422, 1455, 1490, 1510, 1575, 1622, 1684, 1705, 1752, 1820],
              backgroundColor: rgbaFromVar('--green', 0.9)
            },
            {
              label: 'Failed',
              data: [124, 138, 116, 141, 132, 127, 148, 155, 161, 149, 152, 165],
              backgroundColor: rgbaFromVar('--red', 0.9)
            },
            {
              label: 'Pending',
              data: [88, 95, 102, 97, 108, 111, 118, 120, 126, 123, 130, 134],
              backgroundColor: rgbaFromVar('--amber', 0.9)
            }
          ]
        },
        options: {
          ...defaultChartOptions,
          plugins: {
            legend: {
              display: true,
              labels: { color: chartText }
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: { color: chartGrid, drawBorder: false },
              ticks: { color: chartText }
            },
            y: {
              stacked: true,
              grid: { color: chartGrid, drawBorder: false },
              ticks: { color: chartText }
            }
          }
        }
      });
    }

    const supportTicketsCanvas = document.getElementById('supportTicketsChart');
    if (supportTicketsCanvas && window.Chart) {
      new Chart(supportTicketsCanvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Open',
              data: [125, 132, 140, 148, 151, 145, 142, 138, 131, 129, 124, 121],
              borderColor: danger,
              backgroundColor: rgbaFromVar('--red', 0.1),
              borderWidth: 2,
              fill: false,
              tension: 0.34,
              pointRadius: 2
            },
            {
              label: 'Closed',
              data: [98, 105, 111, 120, 127, 133, 141, 147, 154, 161, 168, 174],
              borderColor: success,
              backgroundColor: rgbaFromVar('--green', 0.1),
              borderWidth: 2,
              fill: false,
              tension: 0.34,
              pointRadius: 2
            }
          ]
        },
        options: {
          ...defaultChartOptions,
          plugins: {
            legend: {
              display: true,
              labels: { color: chartText }
            }
          }
        }
      });
    }

    const dateRangeButtons = document.querySelectorAll('.date-range-btn[data-range]');
    dateRangeButtons.forEach((btn) => {
      btn.addEventListener('click', function () {
        dateRangeButtons.forEach((node) => node.classList.remove('active'));
        this.classList.add('active');
      });
    });
  });
</script>

<style>
  .reports-header {
    margin-bottom: 22px;
  }

  .reports-gradient-icon {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
  }

  .reports-breadcrumb {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    font-size: 12px;
    font-weight: 600;
  }

  .crumb-item.active {
    color: var(--text-main);
  }

  .crumb-separator {
    font-size: 11px;
  }

  .reports-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn-group {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 9999px;
    box-shadow: var(--shadow-sm);
    padding: 4px;
  }

  .date-range-btn {
    height: 34px;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    background: transparent;
    transition: all var(--trans-fast);
  }

  .date-range-btn:hover {
    color: var(--text-main);
    background: var(--border-light);
  }

  .date-range-btn.active {
    color: var(--card-bg);
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    box-shadow: var(--shadow-xs);
  }

  .reports-export-btn {
    font-weight: 700;
  }

  .reports-kpi-grid {
