<script nonce="<%= locals.cspNonce || '' %>">
const pricingPlans = JSON.parse('<%- JSON.stringify(plans || []).replace(/</g, "\\u003c") %>');

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2800);
}

function saveGSTSettings() {
  const payload = {
    enabled: document.getElementById('applyGST')?.checked,
    rate: Number(document.getElementById('gstRate')?.value || 0),
    gstNumber: (document.getElementById('gstRegNumber')?.value || '').trim().toUpperCase(),
    annualDiscount: Number(document.getElementById('annualDiscount')?.value || 0),
    studentDiscountEnabled: document.getElementById('studentDiscount')?.checked,
    studentDiscount: Number(document.getElementById('studentDiscountPct')?.value || 0),
  };

  fetch('/admin/pricing/settings', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  })
    .then(async (res) => {
      let data = {};
      try { data = await res.json(); } catch (_) { data = {}; }

      if (!res.ok || data.success === false) {
        throw new Error(data.error || 'Unable to save settings');
      }

      showToast('Settings saved', 'success');
    })
    .catch((error) => {
      showToast(error.message || 'Network error', 'error');
    });
}

function openEditModal(plan) {
  document.getElementById('editModalTitle').textContent = 'Edit — ' + (plan.name || 'Plan');
  document.getElementById('editName').value = plan.name || '';
  document.getElementById('editTagline').value = plan.tagline || '';
  document.getElementById('editDescription').value = plan.description || '';
  document.getElementById('editMonthlyPrice').value = plan.monthlyPrice ?? plan.monthly ?? '';
  document.getElementById('editAnnualPrice').value = plan.annualPrice ?? plan.yearly ?? '';
  document.getElementById('editDiscount').value = plan.discount || 0;
  document.getElementById('editMonthlyTxLimit').value = plan.monthlyTxLimit || '';
  document.getElementById('editDailyTransferLimit').value = plan.dailyTransferLimit || '';
  document.getElementById('editApiCallsPerDay').value = plan.apiCallsPerDay || '';
  document.getElementById('editFeatures').value = (plan.features || []).join('\n');
  document.getElementById('editShowOnPage').checked = plan.showOnPricingPage !== false;
  document.getElementById('editHighlightPopular').checked = !!plan.highlightPopular;
  document.getElementById('editBestValue').checked = !!plan.bestValue;
  document.getElementById('editPlanForm').dataset.planId = plan._id || plan.id;

  updatePricePreview();
  updateFeaturePreview();
  document.getElementById('editPlanModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeEditModal() {
  document.getElementById('editPlanModal').style.display = 'none';
  document.body.style.overflow = '';
}

function updatePricePreview() {
  const monthly  = parseFloat(document.getElementById('editMonthlyPrice').value) || 0;
  const discount = parseFloat(document.getElementById('editDiscount').value) || 0;
  const effective = monthly * (1 - discount / 100);

  const rounded = Math.round(effective);
  document.getElementById('effectivePrice').textContent = '₹' + rounded.toLocaleString('en-IN');

  const savings = monthly - effective;
  document.getElementById('savingsAmount').textContent = savings > 0
    ? 'You save ₹' + Math.round(savings).toLocaleString('en-IN') + '/mo'
    : 'No discount applied';

  const annualSuggested = Math.round(effective * 12 * 0.85);
  document.getElementById('annualHint').textContent = 'Suggested: ₹' + annualSuggested.toLocaleString('en-IN');
}

function toggleFeaturePreview() {
  const preview = document.getElementById('featuresPreview');
  const isVisible = preview.style.display !== 'none';
  preview.style.display = isVisible ? 'none' : 'block';
  if (!isVisible) updateFeaturePreview();
}

function updateFeaturePreview() {
  const text = document.getElementById('editFeatures').value;
  const features = text.split('\n').map(f => f.trim()).filter(Boolean);
  const list = document.getElementById('featuresPreviewList');
  list.innerHTML = features.map(f => `<li><i class="fas fa-circle-check" style="color:#10B981;font-size:0.75rem;"></i>${f}</li>`).join('');
}

document.getElementById('editMonthlyPrice')?.addEventListener('input', updatePricePreview);
document.getElementById('editDiscount')?.addEventListener('input', updatePricePreview);

async function savePlanChanges(e) {
  e.preventDefault();
  const btn = document.getElementById('savePlanBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

  const form = e.target;
  const id = form.dataset.planId;
  const features = document.getElementById('editFeatures').value.split('\n').map(f => f.trim()).filter(Boolean);

  const data = {
    name: document.getElementById('editName')?.value,
    tagline: document.getElementById('editTagline')?.value,
    description: document.getElementById('editDescription')?.value,
    monthlyPrice: parseFloat(document.getElementById('editMonthlyPrice')?.value),
    annualPrice: parseFloat(document.getElementById('editAnnualPrice')?.value),
    discount: parseFloat(document.getElementById('editDiscount')?.value),
    monthlyTxLimit: parseInt(document.getElementById('editMonthlyTxLimit')?.value),
    dailyTransferLimit: parseFloat(document.getElementById('editDailyTransferLimit')?.value),
    apiCallsPerDay: parseInt(document.getElementById('editApiCallsPerDay')?.value),
    features,
    showOnPricingPage: document.getElementById('editShowOnPage')?.checked,
    highlightPopular: document.getElementById('editHighlightPopular')?.checked,
    bestValue: document.getElementById('editBestValue')?.checked,
  };

  try {
    const res = await fetch(`/admin/pricing/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    let result = {};
    try { result = await res.json(); } catch (_) { result = {}; }
    if (res.ok && result.success !== false) {
      closeEditModal();
      showToast('Plan updated successfully!', 'success');
      setTimeout(() => location.reload(), 800);
    } else {
      showToast(result.error || 'Save failed', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Save Changes';
    }
  } catch (_err) {
    showToast('Network error', 'error');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Save Changes';
  }
}

document.querySelectorAll('.edit-plan').forEach((btn) => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.plan;
    const plan = pricingPlans.find((p) => String(p.id) === String(id) || String(p._id) === String(id)) || {};
    openEditModal(plan);
  });
});

document.querySelectorAll('.plan-visibility-toggle').forEach((toggle) => {
  toggle.addEventListener('change', async () => {
    const planId = toggle.dataset.planId;

    try {
      const res = await fetch(`/admin/pricing/${planId}/visibility`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ show: !!toggle.checked }),
      });

      const result = await res.json();
      if (!res.ok || result.success === false) {
        throw new Error(result.error || 'Could not update visibility');
      }

      showToast('Plan visibility updated', 'success');
    } catch (error) {
      toggle.checked = !toggle.checked;
      showToast(error.message || 'Failed to update visibility', 'error');
    }
  });
});

document.querySelectorAll('.archive-plan').forEach((button) => {
  button.addEventListener('click', async () => {
    const planId = button.dataset.planId;
    const confirmed = window.confirm('Archive this plan? It will be hidden from the public pricing page.');
    if (!confirmed) return;

    try {
      const res = await fetch(`/admin/pricing/${planId}/archive`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
      });

      const result = await res.json();
      if (!res.ok || result.success === false) {
        throw new Error(result.error || 'Could not archive plan');
      }

      showToast('Plan archived', 'success');
      setTimeout(() => location.reload(), 600);
    } catch (error) {
      showToast(error.message || 'Failed to archive plan', 'error');
    }
  });
});

document.getElementById('editPlanModal')?.addEventListener('click', function (e) {
  if (e.target === this) closeEditModal();
});

document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    const modal = document.getElementById('editPlanModal');
    if (modal && modal.style.display !== 'none') {
      e.preventDefault();
      document.getElementById('editPlanForm')
        .dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
    }
  }
});

(() => {
  const ctx = document.getElementById('revenueChart');
  if (!ctx || typeof Chart === 'undefined') return;

  if (typeof ChartDataLabels !== 'undefined') {
    Chart.register(ChartDataLabels);
  }

  const chartValues = JSON.parse('<%- JSON.stringify((revenue && (revenue.chartData || revenue.chart)) || [620000,710000,780000,820000,870000,897143]).replace(/</g, "\\u003c") %>');
  const normalizedValues = Array.isArray(chartValues) ? chartValues.map((v) => Number(v || 0)) : [620000,710000,780000,820000,870000,897143];
  const datasetValues = normalizedValues.every((v) => v <= 1000) ? [620000,710000,780000,820000,870000,897143] : normalizedValues;

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
      datasets: [{
        label: 'MRR (₹)',
        data: datasetValues,
        backgroundColor: (context) => {
          const g = context.chart.ctx.createLinearGradient(0, 0, 0, 200);
          g.addColorStop(0, 'rgba(59,130,246,0.9)');
          g.addColorStop(1, 'rgba(99,102,241,0.5)');
          return g;
        },
        borderRadius: 8,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: (p) => ' ₹' + Number(p.raw || 0).toLocaleString('en-IN')
          }
        },
        datalabels: typeof ChartDataLabels !== 'undefined' ? {
          anchor: 'end',
          align: 'top',
          color: '#64748B',
          font: { size: 11, weight: '600' },
          formatter: (v) => '₹' + (v / 100000).toFixed(1) + 'L'
        } : undefined,
      },
      scales: {
        x: { grid: { display: false }, ticks: { color: '#94A3B8', font: { size: 12 } } },
        y: {
          grid: { color: '#F1F5F9' },
          ticks: {
            color: '#94A3B8',
            callback: (v) => '₹' + (Number(v || 0) / 100000).toFixed(0) + 'L'
          }
        }
      }
    }
  });
})();
</script>

