<div class="page-header">
  <div>
    <h1 class="page-title">Pricing Management</h1>
    <p class="page-subtitle">Manage subscription plans, pricing, and feature access</p>
  </div>
</div>

<div class="pricing-grid" id="plansGrid">
  <% (plans || []).forEach((p) => { %>
    <article class="plan-card <%= p.highlighted ? 'highlighted' : '' %>">
      <div class="plan-head"><h3><%= p.name %></h3><span class="status-pill <%= p.status.toLowerCase() === 'active' ? 'resolved' : p.status.toLowerCase() === 'beta' ? 'open' : 'closed' %>"><%= p.status %></span></div>
      <label class="mini-toggle"><input type="checkbox" class="plan-visibility-toggle" data-plan-id="<%= p.id %>" <%= p.showOnPricingPage !== false ? 'checked' : '' %>> <span>Show plan</span></label>
      <div class="price-line">₹<%= p.monthly %> <small>/ month</small></div>
      <div class="year-line">₹<%= p.yearly %> / year</div>
      <div class="stat-row"><span>Active subscribers: <strong><%= p.subscribers %></strong></span><span class="green">Revenue: <%= p.revenue %></span></div>
      <ul class="feature-list"><% (p.features || []).slice(0,5).forEach((f) => { %><li><i class="fas fa-check"></i> <%= f %></li><% }) %></ul>
      <button class="btn-secondary btn-icon edit-plan" type="button" data-plan="<%= p.id %>"><i class="fas fa-edit"></i> Edit Plan</button>
      <button class="link-danger archive-plan" type="button" data-plan-id="<%= p.id %>">Archive Plan</button>
    </article>
  <% }) %>
</div>

<div class="settings-card">
  <div class="settings-card-header">
    <div class="settings-title-wrap">
      <div class="settings-icon" style="background:linear-gradient(135deg,#059669,#10B981);">
        <i class="fas fa-percent" style="color:#A7F3D0;"></i>
      </div>
      <div>
        <h3 class="settings-title">GST & Discount Settings</h3>
        <p class="settings-subtitle">Configure tax rates and discount policies</p>
      </div>
    </div>
    <button class="btn btn-primary btn-sm" onclick="saveGSTSettings()">
      <i class="fas fa-floppy-disk"></i>
      Save Settings
    </button>
  </div>

  <div class="settings-body">
    <div class="settings-row">
      <div class="settings-field settings-field-full">
        <label class="toggle-label-wrap">
          <div class="toggle-switch">
            <input type="checkbox" id="applyGST" name="applyGST" <%= gst.enabled ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
          </div>
          <div>
            <span class="toggle-label-text">Apply GST on all plans</span>
            <span class="toggle-label-sub">Adds GST to every subscription payment</span>
          </div>
        </label>
      </div>
    </div>

    <div class="settings-row">
      <div class="settings-field">
        <label class="field-label"><i class="fas fa-percent" style="color:#10B981;font-size:0.7rem;"></i> GST Rate (%)</label>
        <div class="field-input-wrap">
          <input type="number" id="gstRate" name="gstRate" value="<%= gst.rate || 18 %>" min="0" max="100" step="0.1" class="field-input" placeholder="e.g. 18">
          <span class="field-suffix">%</span>
        </div>
        <span class="field-hint">Standard GST rate in India is 18%</span>
      </div>

      <div class="settings-field">
        <label class="field-label"><i class="fas fa-building" style="color:#3B82F6;font-size:0.7rem;"></i> GST Registration Number</label>
        <input type="text" id="gstRegNumber" name="gstRegNumber" value="<%= gst.gstNumber || '' %>" class="field-input" placeholder="e.g. 27AACCZ0000Z1Z0" maxlength="15" style="text-transform:uppercase;">
        <span class="field-hint">15-digit GSTIN from your certificate</span>
      </div>
    </div>

    <div class="settings-divider"><span>Discount Configuration</span></div>

    <div class="settings-row">
      <div class="settings-field">
        <label class="field-label"><i class="fas fa-calendar-days" style="color:#7C3AED;font-size:0.7rem;"></i> Annual Discount (%)</label>
        <div class="field-input-wrap">
          <input type="number" id="annualDiscount" name="annualDiscount" value="<%= gst.annualDiscount || 15 %>" min="0" max="100" class="field-input" placeholder="e.g. 15">
          <span class="field-suffix">%</span>
        </div>
        <span class="field-hint">Discount when users choose yearly billing</span>
      </div>

      <div class="settings-field">
        <label class="toggle-label-wrap" style="margin-bottom:8px;">
          <div class="toggle-switch">
            <input type="checkbox" id="studentDiscount" name="studentDiscount" <%= gst.studentDiscountEnabled ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
          </div>
          <div>
            <span class="toggle-label-text">Student Discount</span>
            <span class="toggle-label-sub">Enable verified student pricing</span>
          </div>
        </label>

        <label class="field-label" style="margin-top:12px;"><i class="fas fa-graduation-cap" style="color:#F59E0B;font-size:0.7rem;"></i> Student Discount (%)</label>
        <div class="field-input-wrap">
          <input type="number" id="studentDiscountPct" name="studentDiscountPct" value="<%= gst.studentDiscount || 10 %>" min="0" max="100" class="field-input" placeholder="e.g. 10">
          <span class="field-suffix">%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="revenue-snapshot-card">
  <div class="settings-card-header">
    <div class="settings-title-wrap">
      <div class="settings-icon" style="background:linear-gradient(135deg,#1D4ED8,#3B82F6);">
        <i class="fas fa-chart-line" style="color:#BFDBFE;"></i>
      </div>
      <div>
        <h3 class="settings-title">Revenue Snapshot</h3>
        <p class="settings-subtitle">Live subscription revenue metrics</p>
      </div>
    </div>
    <span class="live-badge"><i class="fas fa-circle" style="color:#10B981;font-size:0.4rem;"></i> Live</span>
  </div>

  <div class="revenue-stats-grid">
    <div class="rev-stat">
      <div class="rev-stat-icon" style="background:linear-gradient(135deg,#1D4ED8,#3B82F6);"><i class="fas fa-arrow-trend-up" style="color:#BFDBFE;"></i></div>
      <div>
        <span class="rev-stat-label">Total MRR</span>
        <span class="rev-stat-value" id="mrrValue"><%= revenue.mrr %></span>
        <span class="rev-stat-change positive"><i class="fas fa-arrow-up"></i> +12.4% vs last month</span>
      </div>
    </div>

    <div class="rev-stat">
      <div class="rev-stat-icon" style="background:linear-gradient(135deg,#059669,#10B981);"><i class="fas fa-calendar-check" style="color:#A7F3D0;"></i></div>
      <div>
        <span class="rev-stat-label">Total ARR</span>
        <span class="rev-stat-value" id="arrValue"><%= revenue.arr %></span>
        <span class="rev-stat-change positive"><i class="fas fa-arrow-up"></i> +8.7% vs last year</span>
      </div>
    </div>

    <div class="rev-stat">
      <div class="rev-stat-icon" style="background:linear-gradient(135deg,#B45309,#F59E0B);"><i class="fas fa-arrow-trend-down" style="color:#FDE68A;"></i></div>
      <div>
        <span class="rev-stat-label">Churn Rate</span>
        <span class="rev-stat-value"><%= revenue.churn || '2.8%' %></span>
        <span class="rev-stat-change negative"><i class="fas fa-arrow-up"></i> +0.3% this month</span>
      </div>
    </div>

    <div class="rev-stat">
      <div class="rev-stat-icon" style="background:linear-gradient(135deg,#5B21B6,#7C3AED);"><i class="fas fa-user-plus" style="color:#EDE9FE;"></i></div>
      <div>
        <span class="rev-stat-label">New This Month</span>
        <span class="rev-stat-value"><%= revenue.newThisMonth || 0 %></span>
        <span class="rev-stat-change positive"><i class="fas fa-arrow-up"></i> +5 vs last month</span>
      </div>
    </div>
  </div>

  <div class="revenue-chart-wrap">
    <canvas id="revenueChart" height="120"></canvas>
  </div>
</div>

<!-- Modal overlay -->
<div id="editPlanModal" class="modal-overlay" style="display:none;">
  <div class="modal-box modal-box-lg">
    <div class="modal-header ep-header">
      <div class="ep-header-left">
        <div class="ep-header-icon">
          <i class="fas fa-pen-to-square"></i>
        </div>
        <div class="ep-header-text">
          <h2 class="ep-title" id="editModalTitle">
            Edit Plan
          </h2>
          <p class="ep-subtitle">
            Update plan details and pricing
          </p>
        </div>
      </div>
      <button class="ep-close" onclick="closeEditModal()" type="button">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <form id="editPlanForm" onsubmit="savePlanChanges(event)">
      <div class="modal-body">
        <div class="modal-section">
          <div class="ep-section-label">
            <span class="ep-section-dot" style="background:#3B82F6;"></span>
            <i class="fas fa-circle-info" style="color:#3B82F6;"></i>
            Basic Information
          </div>
          <div class="form-row">
            <div class="ep-field">
              <label class="ep-label">Plan Name *</label>
              <input type="text" name="name" id="editName" class="ep-input" placeholder="e.g. Professional" required>
            </div>
            <div class="ep-field">
              <label class="ep-label">Tagline</label>
              <input type="text" name="tagline" id="editTagline" class="ep-input" placeholder="e.g. For growing businesses">
              <span class="ep-hint">
                Shown below plan name on pricing page
              </span>
            </div>
          </div>
          <div class="ep-field ep-field-full">
            <label class="ep-label">Description</label>
            <textarea name="description" id="editDescription" class="ep-input ep-textarea" rows="3" placeholder="Brief description..."></textarea>
          </div>
        </div>

        <div class="modal-section">
          <div class="ep-section-label">
            <span class="ep-section-dot" style="background:#10B981;"></span>
            <i class="fas fa-indian-rupee-sign" style="color:#10B981;"></i>
            Pricing
          </div>
          <div class="form-row">
            <div class="ep-field">
              <label class="ep-label">Monthly Price (₹)</label>
              <div class="ep-input-group">
                <span class="ep-input-prefix">₹</span>
                <input type="number" name="monthlyPrice" id="editMonthlyPrice" class="ep-input" placeholder="299" min="0">
              </div>
            </div>
            <div class="ep-field">
              <label class="ep-label">Annual Price (₹)</label>
              <div class="ep-input-group">
                <span class="ep-input-prefix">₹</span>
                <input type="number" name="annualPrice" id="editAnnualPrice" class="ep-input" placeholder="2999" min="0">
              </div>
              <span class="ep-hint">Auto-calculated: <span id="annualHint" style="color:#10B981;font-weight:600;"></span></span>
            </div>
          </div>
          <div class="form-row">
            <div class="ep-field">
              <label class="ep-label">Discount (%)</label>
              <div class="ep-input-group ep-input-with-suffix">
                <input type="number" name="discount" id="editDiscount" class="ep-input" placeholder="0" min="0" max="100">
                <span class="ep-input-suffix">%</span>
              </div>
            </div>
            <div class="ep-field">
              <label class="ep-label">Effective Monthly Price</label>
              <div class="ep-price-preview-card">
                <div class="ep-price-preview-top">
                  <div>
                    <span class="ep-preview-label">
                      Effective Monthly Price
                    </span>
                    <span class="ep-preview-amount" id="effectivePrice">₹0</span>
                  </div>
                  <div class="ep-preview-badge">
                    after discount
                  </div>
                </div>
                <div class="ep-preview-savings" id="savingsAmount">
                  No discount applied
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-section">
          <div class="ep-section-label">
            <span class="ep-section-dot" style="background:#F59E0B;"></span>
            <i class="fas fa-gauge" style="color:#F59E0B;"></i>
            Usage Limits
          </div>
          <div class="form-row-3">
            <div class="ep-field">
              <label class="ep-label">Monthly Tx Limit</label>
              <input type="number" name="monthlyTxLimit" id="editMonthlyTxLimit" class="ep-input" placeholder="e.g. 2000">
              <span class="ep-hint">0 = unlimited</span>
            </div>
            <div class="ep-field">
              <label class="ep-label">Daily Transfer Limit (₹)</label>
              <div class="ep-input-group">
                <span class="ep-input-prefix">₹</span>
                <input type="number" name="dailyTransferLimit" id="editDailyTransferLimit" class="ep-input" placeholder="e.g. 100000">
              </div>
            </div>
            <div class="ep-field">
              <label class="ep-label">API Calls / Day</label>
              <input type="number" name="apiCallsPerDay" id="editApiCallsPerDay" class="ep-input" placeholder="e.g. 1000">
              <span class="ep-hint">0 = unlimited</span>
            </div>
          </div>
        </div>

        <div class="modal-section">
          <div class="ep-section-label">
            <span class="ep-section-dot" style="background:#7C3AED;"></span>
            <i class="fas fa-list-check" style="color:#7C3AED;"></i>
            Features
          </div>
          <div class="ep-field ep-field-full">
            <label class="ep-label">Feature List</label>
            <div class="ep-features-wrap">
              <div class="ep-features-editor">
                <div class="ep-features-toolbar">
                  <span class="ep-features-tip">
                    <i class="fas fa-circle-info"></i>
                    One feature per line — each becomes a
                    <span style="color:#10B981;font-weight:700;">
                      ✓ bullet
                    </span>
                  </span>
                  <button type="button" class="ep-features-preview-toggle" onclick="toggleFeaturePreview()">
                    <i class="fas fa-eye"></i>
                    Preview
                  </button>
                </div>
                <textarea name="features" id="editFeatures" class="ep-input ep-features-textarea" rows="5" placeholder="200 transactions per month&#10;Advanced analytics&#10;Priority support&#10;API access" oninput="updateFeaturePreview()"></textarea>
              </div>
              <div class="ep-features-preview" id="featuresPreview" style="display:none;">
                <div class="ep-preview-header">
                  Live Preview
                </div>
                <ul class="ep-preview-list" id="featuresPreviewList"></ul>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-section">
          <div class="ep-section-label">
            <span class="ep-section-dot" style="background:#06B6D4;"></span>
            <i class="fas fa-eye" style="color:#06B6D4;"></i>
            Visibility & Badges
          </div>
          <div class="ep-toggle-list">
            <label class="ep-toggle-row" for="editShowOnPage">
              <div class="ep-toggle-left">
                <div class="ep-toggle-icon" style="background:rgba(6,182,212,0.1); color:#06B6D4;">
                  <i class="fas fa-eye"></i>
                </div>
                <div>
                  <span class="ep-toggle-name">
                    Show on pricing page
                  </span>
                  <span class="ep-toggle-desc">
                    Visible to public customers
                  </span>
                </div>
              </div>
              <div class="toggle-switch">
                <input type="checkbox" name="showOnPricingPage" id="editShowOnPage">
                <span class="toggle-slider"></span>
              </div>
            </label>

            <label class="ep-toggle-row" for="editHighlightPopular">
              <div class="ep-toggle-left">
                <div class="ep-toggle-icon" style="background:rgba(245,158,11,0.1); color:#F59E0B;">
                  <i class="fas fa-star"></i>
                </div>
                <div>
                  <span class="ep-toggle-name">
                    Highlight as Popular
                  </span>
                  <span class="ep-toggle-desc">
                    Shows "Most Popular" badge on card
                  </span>
                </div>
              </div>
              <div class="toggle-switch">
                <input type="checkbox" name="highlightPopular" id="editHighlightPopular">
                <span class="toggle-slider"></span>
              </div>
            </label>

            <label class="ep-toggle-row ep-toggle-last" for="editBestValue">
              <div class="ep-toggle-left">
                <div class="ep-toggle-icon" style="background:rgba(124,58,237,0.1); color:#7C3AED;">
                  <i class="fas fa-crown"></i>
                </div>
                <div>
                  <span class="ep-toggle-name">
                    Best Value badge
                  </span>
                  <span class="ep-toggle-desc">
                    Shows "Best Value" ribbon on card
                  </span>
                </div>
              </div>
              <div class="toggle-switch">
                <input type="checkbox" name="bestValue" id="editBestValue">
                <span class="toggle-slider"></span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <div class="ep-footer">
        <div class="ep-footer-hint">
          <i class="fas fa-keyboard"></i>
          Press <kbd>Ctrl</kbd> + <kbd>S</kbd> to save
        </div>
        <div class="ep-footer-actions">
          <button type="button" class="ep-btn-cancel" onclick="closeEditModal()">
            Discard
          </button>
          <button type="submit" class="ep-btn-save" id="savePlanBtn">
            <i class="fas fa-floppy-disk"></i>
            Save Changes
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
.pricing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-bottom:32px}
.plan-card{background:#fff;border:1px solid #E2E8F0;border-radius:20px;padding:28px;box-shadow:0 10px 24px rgba(15,23,42,.04);position:relative}
.plan-card.highlighted{border-top:4px solid #3B82F6;box-shadow:0 14px 32px rgba(37,99,235,.12)}
.plan-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.plan-head h3{margin:0;font-size:22px;color:#1F2937;font-weight:800}
.mini-toggle{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#475569;margin:10px 0}
.price-line{font-size:32px;font-weight:800;color:#1F2937}.price-line small{font-size:14px;color:#64748B;font-weight:600}.year-line{font-size:14px;color:#16A34A;margin-bottom:10px}
.stat-row{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:13px;color:#475569}.green{color:#16A34A}
.feature-list{margin:12px 0 14px;padding:0;list-style:none;display:grid;gap:8px}.feature-list li{font-size:13px;color:#334155;display:flex;gap:8px;align-items:center}.feature-list i{color:#16A34A}
.edit-plan{width:100%;margin-bottom:8px}.link-danger{width:100%;border:none;background:transparent;color:#DC2626;font-size:12px}

/* ── Settings Card ── */
.settings-card {
  background: #fff;
  border: 1px solid #F1F5F9;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  margin-bottom: 24px;
}
.settings-card-header {
  display: flex; align-items: center;
  justify-content: space-between;
  padding: 22px 26px;
  border-bottom: 1px solid #F1F5F9;
  flex-wrap: wrap; gap: 12px;
}
.settings-title-wrap {
  display: flex; align-items: center; gap: 14px;
}
.settings-icon {
  width: 44px; height: 44px;
  border-radius: 12px;
  display: flex; align-items: center;
  justify-content: center;
  font-size: 1.05rem; flex-shrink: 0;
  box-shadow: 0 3px 10px rgba(0,0,0,0.12);
}
.settings-title {
  font-size: 1rem; font-weight: 800;
  color: #0F172A; margin: 0;
}
.settings-subtitle {
  font-size: 0.78rem; color: #94A3B8;
  margin: 2px 0 0;
}
.settings-body {
  padding: 24px 26px;
  display: flex; flex-direction: column; gap: 20px;
}
.settings-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.settings-field { display: flex; flex-direction: column; gap: 6px; }
.settings-field-full { grid-column: 1 / -1; }

/* Toggle switch */
.toggle-label-wrap {
  display: flex; align-items: center; gap: 12px;
  cursor: pointer;
}
.toggle-switch {
  position: relative;
  width: 42px; height: 24px; flex-shrink: 0;
}
.toggle-switch input { display: none; }
.toggle-slider {
  position: absolute; inset: 0;
  background: #CBD5E1; border-radius: 24px;
  transition: 0.25s;
  cursor: pointer;
}
.toggle-slider::before {
  content: '';
  position: absolute;
  width: 18px; height: 18px;
  left: 3px; top: 3px;
  background: #fff; border-radius: 50%;
  transition: 0.25s;
  box-shadow: 0 1px 4px rgba(0,0,0,0.15);
}
.toggle-switch input:checked + .toggle-slider {
  background: #3B82F6;
}
.toggle-switch input:checked + .toggle-slider::before {
  transform: translateX(18px);
}
.toggle-label-text {
  display: block;
  font-size: 0.875rem; font-weight: 600;
  color: #334155;
}
.toggle-label-sub {
  display: block;
  font-size: 0.75rem; color: #94A3B8;
}

/* Field styles */
.field-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.8rem; font-weight: 600;
  color: #334155;
}
.field-input-wrap { position: relative; display: flex; }
.field-prefix {
  display: flex; align-items: center;
  padding: 0 12px;
  background: #F8FAFC;
  border: 1.5px solid #E2E8F0;
  border-right: none;
  border-radius: 10px 0 0 10px;
  font-size: 0.85rem; color: #64748B;
  font-weight: 600;
}
.field-suffix {
  display: flex; align-items: center;
  padding: 0 12px;
  background: #F8FAFC;
  border: 1.5px solid #E2E8F0;
  border-left: none;
  border-radius: 0 10px 10px 0;
  font-size: 0.85rem; color: #64748B;
  font-weight: 600;
}
.field-input {
  width: 100%; padding: 11px 14px;
  border: 1.5px solid #E2E8F0;
  border-radius: 10px;
  font-size: 0.875rem; color: #0F172A;
  background: #F8FAFC; outline: none;
  transition: all 0.2s; font-family: inherit;
}
.field-input.with-prefix {
  border-radius: 0 10px 10px 0;
}
.field-input:focus {
  border-color: #3B82F6; background: #fff;
  box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
}
.field-hint {
  font-size: 0.72rem; color: #94A3B8;
}
.settings-divider {
  display: flex; align-items: center; gap: 12px;
  color: #94A3B8; font-size: 0.75rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.06em;
}
.settings-divider::before,
.settings-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #F1F5F9;
}

/* ── Revenue Snapshot ── */
.revenue-snapshot-card {
  background: #fff;
  border: 1px solid #F1F5F9;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  margin-bottom: 24px;
