<%
  const ticket = details || {};
  const thread = Array.isArray(ticket.thread) ? ticket.thread : [];
  const user = ticket.user || {};
  const txns = Array.isArray(ticket.relatedTransactions) ? ticket.relatedTransactions : [];
  const replyCount = Number(ticket.metadata?.responseCount || thread.filter(m => m.type === 'admin').length || 0);
  const messageCount = thread.filter(m => m.type === 'user' || m.type === 'admin').length || thread.length;
  const userLink = user.id ? `/admin/users/${encodeURIComponent(user.id)}` : '#';
  const statusTone = String(ticket.status || 'open').toLowerCase();
  const priorityTone = String(ticket.priority || 'medium').toLowerCase();

  const formatDate = (v) => {
    try {
      const dt = new Date(v);
      if (Number.isNaN(dt.getTime())) return v || 'N/A';
      return dt.toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch (e) {
      return v || 'N/A';
    }
  };

  const systemIcon = (text = '') => {
    const x = String(text).toLowerCase();
    if (x.includes('assigned')) return 'fa-user-check';
    if (x.includes('priority')) return 'fa-flag';
    if (x.includes('progress') || x.includes('in progress')) return 'fa-check-circle';
    if (x.includes('closed')) return 'fa-lock';
    return 'fa-info-circle';
  };

  const categoryClass = () => {
    const c = String(ticket.category || 'Other').toLowerCase();
    if (c.includes('payment')) return 'cat-payment';
    if (c.includes('kyc')) return 'cat-kyc';
    if (c.includes('technical')) return 'cat-technical';
    if (c.includes('refund')) return 'cat-refund';
    if (c.includes('account')) return 'cat-account';
    return 'cat-other';
  };

  const priorityClass = () => {
    if (priorityTone === 'urgent') return 'prio-urgent';
    if (priorityTone === 'high') return 'prio-high';
    if (priorityTone === 'low') return 'prio-low';
    return 'prio-medium';
  };

  const statusClass = () => {
    if (statusTone === 'in_progress') return 'stat-progress';
    if (statusTone === 'resolved') return 'stat-resolved';
    if (statusTone === 'closed') return 'stat-closed';
    if (statusTone === 'waiting') return 'stat-waiting';
    return 'stat-open';
  };

  const safeInitials = (name) => {
    const parts = String(name || 'U').trim().split(/\s+/);
    return parts.slice(0, 2).map(p => p.charAt(0).toUpperCase()).join('') || 'U';
  };

  const timeline = [
    { dot: 'dot-blue', text: `Ticket created by ${user.name || 'User'}`, time: ticket.createdAt || 'N/A' },
    ticket.assignedAgent ? { dot: 'dot-amber', text: `Assigned to ${ticket.assignedAgent.name}`, time: ticket.updatedAt || 'N/A' } : null,
    replyCount > 0 ? { dot: 'dot-green', text: `First reply sent (${ticket.lastResponse || 'N/A'})`, time: ticket.updatedAt || 'N/A' } : null,
    ['high', 'urgent'].includes(priorityTone) ? { dot: 'dot-purple', text: `Priority changed to ${ticket.priorityMeta?.label || ticket.priority || 'High'}`, time: ticket.updatedAt || 'N/A' } : null,
    messageCount > 1 ? { dot: 'dot-blue', text: 'User replied', time: ticket.updatedAt || 'N/A' } : null,
    statusTone === 'in_progress' ? { dot: 'dot-amber', text: 'Status: In Progress', time: ticket.updatedAt || 'N/A' } : null
  ].filter(Boolean);
%>

<section class="ticket-details-page" id="ticketDetailsPage">
  <nav class="ticket-crumb" aria-label="Support Breadcrumb">
    <a href="/admin/dashboard" class="crumb-home"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right"></i>
    <a href="/admin/support">Support Tickets</a>
    <i class="fas fa-chevron-right"></i>
    <span><%= ticket.ticketNo || '#TKT-XXXX-XXXX' %></span>
  </nav>

  <header class="ticket-head">
    <div class="ticket-head-left">
      <a href="/admin/support" class="back-link"><i class="fas fa-arrow-left"></i>Back to Tickets</a>
      <h1><%= ticket.ticketNo || '#TKT-XXXX-XXXX' %> — <%= ticket.subject || 'Support Request' %></h1>
      <p>
        Opened <%= ticket.createdAt || 'N/A' %> •
        <a href="<%= userLink %>"><%= user.name || 'Unknown User' %></a> •
        Priority: <%= ticket.priorityMeta?.label || 'Medium' %>
      </p>
    </div>

    <div class="ticket-head-actions">
      <button type="button" class="btn-pill btn-success" id="markResolvedBtn"><i class="fas fa-check-double"></i>Mark Resolved</button>
      <button type="button" class="btn-pill btn-outline" data-open-modal="closeTicketModal"><i class="fas fa-lock"></i>Close Ticket</button>

      <div class="head-more-wrap">
        <button type="button" class="btn-pill btn-outline icon-only" id="ticketMoreBtn"><i class="fas fa-ellipsis-v"></i></button>
        <div class="head-more-menu" id="ticketMoreMenu" hidden>
          <button type="button" data-more-action="assign"><i class="fas fa-user-check"></i><span>Assign to Me</span></button>
          <button type="button" data-open-modal="changePriorityModal"><i class="fas fa-flag"></i><span>Change Priority</span></button>
          <button type="button" data-more-action="merge"><i class="fas fa-code-branch"></i><span>Merge Ticket</span></button>
          <button type="button" data-more-action="export"><i class="fas fa-download"></i><span>Export Thread</span></button>
          <hr>
          <button type="button" data-more-action="delete" class="danger"><i class="fas fa-trash"></i><span>Delete Ticket</span></button>
        </div>
      </div>
    </div>
  </header>

  <section class="ticket-layout-grid">
    <div class="left-col">
      <article class="meta-strip-card">
        <div class="meta-item">
          <i class="fas fa-tag"></i>
          <span>Ticket ID</span>
          <strong class="mono"><%= ticket.ticketNo || 'N/A' %></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-layer-group"></i>
          <span>Category</span>
          <strong><span class="pill <%= categoryClass() %>"><%= ticket.category || 'Other' %></span></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-fire"></i>
          <span>Priority</span>
          <strong><span class="pill <%= priorityClass() %>"><%= ticket.priorityMeta?.label || 'Medium' %></span></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-circle"></i>
          <span>Status</span>
          <strong><span class="pill <%= statusClass() %>"><%= ticket.statusMeta?.label || 'Open' %></span></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-user-tie"></i>
          <span>Assigned To</span>
          <strong><%= ticket.assignedAgent?.name || 'Unassigned' %></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-reply-all"></i>
          <span>Replies</span>
          <strong><%= messageCount %> messages</strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-clock"></i>
          <span>Opened</span>
          <strong><%= ticket.createdAt || 'N/A' %></strong>
        </div>
        <div class="meta-item">
          <i class="fas fa-stopwatch"></i>
          <span>Response Time</span>
          <strong><%= ticket.lastResponse || 'Awaiting response' %></strong>
        </div>
      </article>

      <article class="thread-card">
        <header class="thread-head">
          <div class="thread-title-wrap">
            <span class="thread-icon"><i class="fas fa-comments"></i></span>
            <h2>Conversation</h2>
          </div>
          <span class="thread-count"><%= messageCount %> messages</span>
        </header>

        <div class="thread-body" id="threadBody">
          <% if (!thread.length) { %>
            <div class="thread-empty">No conversation messages yet.</div>
          <% } %>

          <% thread.forEach((msg, idx) => { %>
            <% if (msg.type === 'system') { %>
              <div class="system-row delay-<%= idx % 8 %>">
                <span class="line"></span>
                <p><i class="fas <%= systemIcon(msg.text) %>"></i> <%= msg.text %></p>
                <span class="line"></span>
              </div>
            <% } else if (msg.type === 'admin') { %>
              <div class="message-row admin delay-<%= idx % 8 %>">
                <div class="message-card admin-card">
                  <div class="message-head">
                    <strong class="author admin-name"><%= msg.name || 'Support Admin' %></strong>
                    <span class="badge admin-badge"><i class="fas fa-shield-alt"></i>Admin</span>
                    <time><%= msg.timestamp || '' %></time>
                  </div>
                  <div class="message-text"><%- String(msg.body || '').replace(/\n/g, '<br>') %></div>
                </div>
                <span class="avatar admin-avatar"><%= safeInitials(msg.name) %></span>
              </div>
            <% } else { %>
              <div class="message-row user delay-<%= idx % 8 %>">
                <span class="avatar user-avatar"><%= safeInitials(msg.name) %></span>
                <div class="message-card user-card">
                  <div class="message-head">
                    <strong class="author"><%= msg.name || 'User' %></strong>
                    <span class="badge user-badge">User</span>
                    <time><%= msg.timestamp || '' %></time>
                  </div>
                  <div class="message-text"><%- String(msg.body || '').replace(/\n/g, '<br>') %></div>

                  <% if (Array.isArray(msg.attachments) && msg.attachments.length) { %>
                    <div class="attach-list">
                      <% msg.attachments.forEach((att) => { %>
                        <div class="attach-item">
                          <div class="attach-left">
                            <i class="fas fa-paperclip"></i>
                            <div>
                              <p><%= att.name || 'attachment' %></p>
                              <small><%= att.size || 'file' %></small>
                            </div>
                          </div>
                          <a href="#" onclick="return false;">Download</a>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      </article>

      <article class="reply-card" id="replyCard">
        <div class="reply-tabs">
          <button type="button" class="reply-tab active" data-tab="reply"><i class="fas fa-reply"></i>Reply to User</button>
          <button type="button" class="reply-tab" data-tab="note"><i class="fas fa-sticky-note"></i>Internal Note</button>
        </div>

        <div class="reply-input-wrap">
          <textarea id="replyText" placeholder="Type your reply..."></textarea>
        </div>

        <div class="reply-toolbar">
          <div class="toolbar-left">
            <button type="button" class="fmt-btn"><i class="fas fa-bold"></i></button>
            <button type="button" class="fmt-btn"><i class="fas fa-italic"></i></button>
            <button type="button" class="fmt-btn"><i class="fas fa-underline"></i></button>
            <span class="tool-sep"></span>
            <button type="button" class="fmt-btn"><i class="fas fa-list-ul"></i></button>
            <button type="button" class="fmt-btn"><i class="fas fa-list-ol"></i></button>
            <button type="button" class="fmt-btn"><i class="fas fa-link"></i></button>
          </div>
          <select id="quickReply" class="admin-select quick-select">
            <option value="">Quick Replies</option>
            <option value="We are reviewing your request and will update you shortly.">Under review</option>
            <option value="Thanks for your patience. We have escalated this to the payments team.">Escalated to payments team</option>
            <option value="Issue resolved from our side. Please refresh and check again.">Resolved, please recheck</option>
          </select>
        </div>

        <div class="reply-attachments" id="replyAttachmentChips" hidden></div>

        <footer class="reply-foot">
          <div class="reply-foot-left">
            <label class="attach-action"><i class="fas fa-paperclip"></i>Attach
              <input type="file" id="fileAttachInput" multiple>
            </label>
            <label class="attach-action"><i class="fas fa-image"></i>Image
              <input type="file" id="imageAttachInput" accept="image/*" multiple>
            </label>

            <div class="status-change-wrap">
              <span>Change Status to:</span>
              <div class="status-pills" id="statusPills">
                <button type="button" class="status-pill-btn active" data-status="open">Open</button>
                <button type="button" class="status-pill-btn" data-status="in_progress">In Progress</button>
                <button type="button" class="status-pill-btn" data-status="resolved">Resolved</button>
                <button type="button" class="status-pill-btn" data-status="closed">Closed</button>
              </div>
            </div>
          </div>

          <button type="button" class="send-btn" id="sendReplyBtn"><i class="fas fa-paper-plane"></i>Send Reply</button>
        </footer>
      </article>
    </div>

    <aside class="right-col">
      <article class="side-card mgmt-card animate-stagger">
        <h3><i class="fas fa-cog"></i>Ticket Management</h3>

        <div class="field-group">
          <label>Status</label>
          <select id="manageStatus" class="admin-select">
            <option value="open" <%= statusTone === 'open' ? 'selected' : '' %>>● Open</option>
            <option value="in_progress" <%= statusTone === 'in_progress' ? 'selected' : '' %>>● In Progress</option>
            <option value="resolved" <%= statusTone === 'resolved' ? 'selected' : '' %>>● Resolved</option>
            <option value="closed" <%= statusTone === 'closed' ? 'selected' : '' %>>● Closed</option>
            <option value="waiting" <%= statusTone === 'waiting' ? 'selected' : '' %>>● Waiting on User</option>
          </select>
        </div>

        <div class="field-group">
          <label>Priority</label>
          <select id="managePriority" class="admin-select">
            <option value="urgent" <%= priorityTone === 'urgent' ? 'selected' : '' %>>Urgent</option>
            <option value="high" <%= priorityTone === 'high' ? 'selected' : '' %>>High</option>
            <option value="medium" <%= priorityTone === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="low" <%= priorityTone === 'low' ? 'selected' : '' %>>Low</option>
          </select>
        </div>

        <div class="field-group">
          <label>Assigned To</label>
          <select id="manageAssignee" class="admin-select">
            <option value="">Unassigned</option>
            <option value="Admin Priya" <%= ticket.assignedAgent?.name === 'Admin Priya' ? 'selected' : '' %>>Admin Priya</option>
            <option value="Admin Arjun" <%= ticket.assignedAgent?.name === 'Admin Arjun' ? 'selected' : '' %>>Admin Arjun</option>
            <option value="Admin Neha" <%= ticket.assignedAgent?.name === 'Admin Neha' ? 'selected' : '' %>>Admin Neha</option>
          </select>
          <% if (!ticket.assignedAgent) { %>
            <button type="button" class="quick-assign" id="quickAssignBtn">Assign to Me</button>
          <% } %>
        </div>

        <div class="field-group">
          <label>Category</label>
          <select id="manageCategory" class="admin-select">
            <option value="Payment" <%= String(ticket.category || '').includes('Payment') ? 'selected' : '' %>>Payment</option>
            <option value="KYC" <%= String(ticket.category || '').includes('KYC') ? 'selected' : '' %>>KYC</option>
            <option value="Technical" <%= String(ticket.category || '').includes('Technical') ? 'selected' : '' %>>Technical</option>
            <option value="Refund" <%= String(ticket.category || '').includes('Refund') ? 'selected' : '' %>>Refund</option>
            <option value="Account" <%= String(ticket.category || '').includes('Account') ? 'selected' : '' %>>Account</option>
            <option value="Other" <%= String(ticket.category || '').includes('Other') ? 'selected' : '' %>>Other</option>
          </select>
        </div>

        <div class="field-group">
          <label>Tags</label>
          <input id="tagInput" class="admin-input" type="text" placeholder="Type and press Enter">
          <div class="tag-chips" id="tagChips"></div>
        </div>

        <button type="button" class="btn-pill btn-primary full" id="updateTicketBtn"><i class="fas fa-save"></i>Update Ticket</button>
      </article>

      <article class="side-card animate-stagger">
        <h3><span class="title-icon"><i class="fas fa-user"></i></span>Reported By</h3>

        <div class="reporter-row">
          <span class="reporter-avatar"><%= safeInitials(user.name) %></span>
          <div>
            <p class="reporter-name"><%= user.name || 'Unknown User' %></p>
            <p class="reporter-email"><%= user.email || 'Not provided' %></p>
          </div>
          <span class="acct-badge <%= String(user.accountStatus || '').toLowerCase() === 'suspended' ? 'suspended' : 'active' %>"><%= user.accountStatus || 'Active' %></span>
        </div>

        <div class="info-rows">
          <div><i class="fas fa-phone"></i><span><%= user.phone || 'Not provided' %></span></div>
          <div><i class="fas fa-calendar-alt"></i><span>Joined <%= user.joinedAt || 'N/A' %></span></div>
          <div><i class="fas fa-ticket-alt"></i><a href="/admin/support?user=<%= encodeURIComponent(user.email || '') %>"><%= user.totalTransactions || 0 %> total tickets</a></div>
          <div>
            <i class="fas fa-id-card"></i>
            <span>KYC: <span class="pill <%= String(user.kycStatus || '').toLowerCase().includes('verified') ? 'stat-resolved' : 'stat-waiting' %>"><%= user.kycStatus || 'Unknown' %></span></span>
          </div>
        </div>

        <a class="btn-pill btn-outline full" href="<%= userLink %>"><i class="fas fa-external-link-alt"></i>View Profile</a>
      </article>

      <article class="side-card animate-stagger">
        <h3><span class="title-icon"><i class="fas fa-exchange-alt"></i></span>Related Transactions</h3>
        <p class="subhead">Transactions linked to this ticket</p>

        <% if (!txns.length) { %>
          <div class="empty-mini"><i class="fas fa-info-circle"></i>No linked transactions</div>
        <% } else { %>
          <div class="txn-list">
            <% txns.forEach((tx) => { %>
              <div class="txn-item">
                <div class="txn-left">
                  <span class="txn-ico <%= String(tx.description || '').toLowerCase().includes('receive') ? 'recv' : 'sent' %>">
                    <i class="fas <%= String(tx.description || '').toLowerCase().includes('receive') ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                  </span>
                  <div>
                    <p class="txn-id"><%= tx.id || 'TXN-NA' %></p>
                    <small><%= tx.date || 'N/A' %></small>
                  </div>
                </div>
                <div class="txn-right">
                  <strong><%= tx.amount || '₹0.00' %></strong>
                  <span class="pill <%= String(tx.status || '').toLowerCase().includes('success') ? 'stat-resolved' : 'stat-waiting' %>"><%= tx.status || 'pending' %></span>
                </div>
              </div>
            <% }) %>
          </div>
          <a href="/admin/transactions?user=<%= encodeURIComponent(user.id || user.email || '') %>" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
        <% } %>
      </article>

      <article class="side-card animate-stagger">
        <h3><span class="title-icon"><i class="fas fa-history"></i></span>Activity Timeline</h3>
        <div class="timeline-list">
          <% timeline.forEach((item) => { %>
            <div class="time-row">
              <span class="dot <%= item.dot %>"></span>
              <div>
                <p><%= item.text %></p>
                <small><%= item.time %></small>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    </aside>
  </section>
</section>

<div id="closeTicketModal" class="modal-overlay" hidden>
  <div class="modal-card support-modal-card">
    <div class="modal-header close-head">
      <h3><i class="fas fa-lock"></i>Close Ticket</h3>
      <button type="button" class="modal-close-btn" data-close-modal="closeTicketModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <p class="modal-note">Closing this ticket will notify the user and archive the conversation.</p>

      <div class="form-group">
        <label class="form-label" for="closeSummary">Resolution Summary</label>
        <textarea id="closeSummary" class="admin-textarea" rows="4" placeholder="Summarize how this was resolved..."></textarea>
      </div>

      <div class="toggle-row">
        <span>Send Closure Email to User</span>
        <label class="switch"><input type="checkbox" id="sendClosureEmail" checked><span></span></label>
      </div>
      <div class="toggle-row">
        <span>Mark as Resolved Before Closing</span>
        <label class="switch"><input type="checkbox" id="markResolvedBeforeClose" checked><span></span></label>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="closeTicketModal">Cancel</button>
        <button type="button" class="btn-primary-modal slate" id="confirmCloseTicket"><i class="fas fa-lock"></i>Close Ticket</button>
      </div>
    </div>
  </div>
</div>

<div id="changePriorityModal" class="modal-overlay" hidden>
  <div class="modal-card support-modal-card">
    <div class="modal-header prio-head">
      <h3><i class="fas fa-flag"></i>Change Priority</h3>
      <button type="button" class="modal-close-btn" data-close-modal="changePriorityModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="priority-grid" id="priorityGrid">
        <button type="button" class="priority-opt urgent" data-priority="urgent"><i class="fas fa-fire"></i><span>Urgent</span></button>
        <button type="button" class="priority-opt high" data-priority="high"><i class="fas fa-exclamation"></i><span>High</span></button>
        <button type="button" class="priority-opt medium" data-priority="medium"><i class="fas fa-minus"></i><span>Medium</span></button>
        <button type="button" class="priority-opt low" data-priority="low"><i class="fas fa-arrow-down"></i><span>Low</span></button>
      </div>

      <div class="form-group">
        <label class="form-label" for="priorityReason">Reason</label>
        <textarea id="priorityReason" class="admin-textarea" rows="3" placeholder="Reason for priority change..."></textarea>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="changePriorityModal">Cancel</button>
        <button type="button" class="btn-primary-modal amber" id="confirmPriorityUpdate"><i class="fas fa-check"></i>Update Priority</button>
      </div>
    </div>
  </div>
</div>

<style>
  .ticket-details-page { color: var(--text-main); }

  .ticket-crumb { margin-bottom: 12px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-soft); }
  .ticket-crumb a { color: var(--text-muted); font-weight: 700; }
  .ticket-crumb a:hover { color: var(--primary); }
  .ticket-crumb i { font-size: 11px; }
  .ticket-crumb span { color: var(--text-main); font-weight: 700; }

  .ticket-head { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; margin-bottom: 22px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 14px; font-weight: 700; transition: color var(--trans-fast), transform var(--trans-fast); }
  .back-link:hover { color: var(--primary); transform: translateX(-2px); }
  .ticket-head h1 { margin-top: 10px; font-size: 26px; font-weight: 800; color: var(--text-main); line-height: 1.25; }
  .ticket-head p { margin-top: 6px; font-size: 14px; color: var(--text-soft); }
  .ticket-head p a { color: var(--primary); font-weight: 700; }

  .ticket-head-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .btn-pill {
    height: 42px;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: transform var(--trans-fast), box-shadow var(--trans-fast), border-color var(--trans-fast), color var(--trans-fast);
  }
  .btn-pill:hover { transform: translateY(-1px); }
  .btn-pill.full { width: 100%; justify-content: center; }
  .btn-success { color: #fff; background: linear-gradient(135deg, var(--green), var(--green-dark)); box-shadow: 0 6px 14px rgba(16,185,129,.28); }
  .btn-outline { background: var(--card-bg); border-color: var(--border); color: var(--text-muted); }
