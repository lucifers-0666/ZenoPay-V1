  }

  @media (max-width: 860px) {
    .ticket-head { flex-direction: column; }
    .meta-strip-card { gap: 14px; }
    .meta-item { min-width: calc(50% - 7px); }
    .message-card { max-width: 100%; }
  }
</style>

<script>
(() => {
  const state = {
    mode: 'reply',
    pendingFiles: [],
    selectedPriority: '<%= priorityTone %>'
  };

  const dom = {
    moreBtn: document.getElementById('ticketMoreBtn'),
    moreMenu: document.getElementById('ticketMoreMenu'),
    replyCard: document.getElementById('replyCard'),
    replyText: document.getElementById('replyText'),
    sendBtn: document.getElementById('sendReplyBtn'),
    tabs: document.querySelectorAll('.reply-tab'),
    quickReply: document.getElementById('quickReply'),
    fileInput: document.getElementById('fileAttachInput'),
    imageInput: document.getElementById('imageAttachInput'),
    chips: document.getElementById('replyAttachmentChips'),
    statusPills: document.querySelectorAll('#statusPills .status-pill-btn'),
    threadBody: document.getElementById('threadBody'),
    tagInput: document.getElementById('tagInput'),
    tagChips: document.getElementById('tagChips'),
    priorityGrid: document.getElementById('priorityGrid'),
    managePriority: document.getElementById('managePriority')
  };

  const tags = [];

  function toast(msg, type = 'success') {
    if (window.showToast) return window.showToast(msg, type);
    const node = document.createElement('div');
    node.className = `admin-toast admin-toast-${type === 'error' ? 'error' : 'success'}`;
    node.innerHTML = `<i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i><span>${msg}</span>`;
    document.body.appendChild(node);
    setTimeout(() => node.classList.add('show'), 30);
    setTimeout(() => { node.classList.remove('show'); setTimeout(() => node.remove(), 250); }, 2200);
  }

  function closeHeadMenu() { dom.moreMenu.hidden = true; }
  dom.moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dom.moreMenu.hidden = !dom.moreMenu.hidden;
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.head-more-wrap')) closeHeadMenu();
  });

  document.querySelectorAll('[data-more-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-more-action');
      closeHeadMenu();
      if (action === 'assign') return toast('Ticket assigned to you', 'success');
      if (action === 'merge') return toast('Merge flow can be connected to backend next', 'success');
      if (action === 'export') {
        const text = [...document.querySelectorAll('.message-text')].map((n) => n.textContent.trim()).filter(Boolean).join('\n\n');
        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ticket-thread.txt';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        return toast('Thread exported', 'success');
      }
      if (action === 'delete') return toast('Delete action is ready for backend wiring', 'error');
    });
  });

  dom.tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      dom.tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      state.mode = tab.dataset.tab;
      const isNote = state.mode === 'note';
      dom.replyCard.classList.toggle('note-mode', isNote);
      dom.sendBtn.classList.toggle('note', isNote);
      dom.replyText.placeholder = isNote
        ? 'Add internal note (not visible to user)...'
        : 'Type your reply...';
    });
  });

  dom.quickReply?.addEventListener('change', () => {
    if (!dom.quickReply.value) return;
    dom.replyText.value = dom.replyText.value ? `${dom.replyText.value}\n\n${dom.quickReply.value}` : dom.quickReply.value;
    dom.quickReply.value = '';
  });

  function fileSizeText(bytes) {
    if (!bytes) return 'file';
    if (bytes < 1024) return `${bytes} B`;
    return `${Math.round(bytes / 1024)} KB`;
  }

  function renderChips() {
    if (!state.pendingFiles.length) {
      dom.chips.hidden = true;
      dom.chips.innerHTML = '';
      return;
    }
    dom.chips.hidden = false;
    dom.chips.innerHTML = state.pendingFiles.map((f, idx) => (
      `<span class="file-chip"><i class="fas fa-paperclip"></i>${f.name} (${fileSizeText(f.size)})<button type="button" data-remove-file="${idx}"><i class="fas fa-times"></i></button></span>`
    )).join('');

    dom.chips.querySelectorAll('[data-remove-file]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.pendingFiles.splice(Number(btn.dataset.removeFile), 1);
        renderChips();
      });
    });
  }

  function addFiles(list) {
    const files = Array.from(list || []).slice(0, 8);
    files.forEach((file) => state.pendingFiles.push(file));
    renderChips();
  }

  dom.fileInput?.addEventListener('change', () => addFiles(dom.fileInput.files));
  dom.imageInput?.addEventListener('change', () => addFiles(dom.imageInput.files));

  dom.statusPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      dom.statusPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
    });
  });

  function appendReplyToThread(text) {
    const row = document.createElement('div');
    row.className = `message-row ${state.mode === 'note' ? 'admin' : 'admin'}`;
    const now = new Date();
    const timestamp = now.toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });

    row.innerHTML = `
      <div class="message-card admin-card">
        <div class="message-head">
          <strong class="author admin-name">${state.mode === 'note' ? 'Internal Note' : 'Support Admin'}</strong>
          <span class="badge admin-badge"><i class="fas fa-shield-alt"></i>${state.mode === 'note' ? 'Note' : 'Admin'}</span>
          <time>${timestamp}</time>
        </div>
        <div class="message-text">${text.replace(/\n/g, '<br>')}</div>
      </div>
      <span class="avatar admin-avatar">AD</span>
    `;

    dom.threadBody.appendChild(row);
  }

  dom.sendBtn?.addEventListener('click', () => {
    const text = dom.replyText.value.trim();
    if (!text && !state.pendingFiles.length) return toast('Add a reply or attachment first', 'error');

    dom.sendBtn.classList.add('pressed');
    setTimeout(() => dom.sendBtn.classList.remove('pressed'), 120);

    if (text) appendReplyToThread(text);

    dom.replyText.value = '';
    state.pendingFiles = [];
    renderChips();
    toast(state.mode === 'note' ? 'Internal note saved' : 'Reply sent', 'success');
  });

  document.getElementById('markResolvedBtn')?.addEventListener('click', () => {
    const btn = document.querySelector('#statusPills [data-status="resolved"]');
    btn?.click();
    toast('Ticket marked resolved', 'success');
  });

  document.getElementById('confirmCloseTicket')?.addEventListener('click', () => {
    window.AdminModal?.close('closeTicketModal');
    toast('Ticket closed successfully', 'success');
  });

  dom.priorityGrid?.querySelectorAll('[data-priority]').forEach((opt) => {
    if (opt.dataset.priority === state.selectedPriority) opt.classList.add('selected');
    opt.addEventListener('click', () => {
      dom.priorityGrid.querySelectorAll('[data-priority]').forEach((o) => o.classList.remove('selected'));
      opt.classList.add('selected');
      state.selectedPriority = opt.dataset.priority;
    });
  });

  document.getElementById('confirmPriorityUpdate')?.addEventListener('click', () => {
    dom.managePriority.value = state.selectedPriority;
    window.AdminModal?.close('changePriorityModal');
    toast('Priority updated', 'success');
  });

  document.getElementById('updateTicketBtn')?.addEventListener('click', () => {
    toast('Ticket updates saved', 'success');
  });

  document.getElementById('quickAssignBtn')?.addEventListener('click', () => {
    const sel = document.getElementById('manageAssignee');
    sel.value = 'Admin Priya';
    toast('Assigned to you', 'success');
  });

  dom.tagInput?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const value = dom.tagInput.value.trim();
    if (!value) return;
    if (tags.length >= 5) return toast('Maximum 5 tags allowed', 'error');
    if (tags.includes(value)) return;
    tags.push(value);
    dom.tagInput.value = '';
    renderTags();
  });

  function renderTags() {
    dom.tagChips.innerHTML = tags.map((tag, idx) => (
      `<span class="tag-chip">${tag}<button type="button" data-remove-tag="${idx}"><i class="fas fa-times"></i></button></span>`
    )).join('');

    dom.tagChips.querySelectorAll('[data-remove-tag]').forEach((btn) => {
      btn.addEventListener('click', () => {
        tags.splice(Number(btn.dataset.removeTag), 1);
        renderTags();
      });
    });
  }
})();
</script>
