<%
  const rows = Array.isArray(transactions) ? transactions : [];
  const current = Number(currentPageNumber || 1);
  const pages = Number(totalPages || 1);
  const perPageCurrent = Number(perPage || 10);
  const total = Number(totalCount || 0);
  const startItem = total === 0 ? 0 : ((current - 1) * perPageCurrent) + 1;
  const endItem = Math.min(current * perPageCurrent, total);

  const f = filters || {};
  const formatMoney = (n) => `₹${Number(n || 0).toLocaleString('en-IN')}`;
  const formatDateTime = (d) => {
    if (!d) return '—';
    const dt = new Date(d);
    if (Number.isNaN(dt.getTime())) return '—';
    return dt.toLocaleString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  };

  const reasonClass = (reason) => {
    const r = String(reason || '').toLowerCase();
    if (r.includes('insufficient') || r.includes('declined')) return 'red';
    if (r.includes('timeout')) return 'orange';
    if (r.includes('invalid')) return 'yellow';
    if (r.includes('limit')) return 'purple';
    if (r.includes('fraud')) return 'darkred';
    return 'red';
  };

  const pageLink = (targetPage, targetLimit = perPageCurrent) => {
    const params = new URLSearchParams();
    if (f.search) params.set('search', f.search);
    if (f.type) params.set('type', f.type);
    if (f.dateFrom) params.set('dateFrom', f.dateFrom);
    if (f.dateTo) params.set('dateTo', f.dateTo);
    params.set('page', targetPage);
    params.set('limit', targetLimit);
    return `/admin/transactions/failed?${params.toString()}`;
  };

  const paginationPages = [];
  const windowSize = 5;
  let start = Math.max(1, current - Math.floor(windowSize / 2));
  let end = Math.min(pages, start + windowSize - 1);
  if (end - start + 1 < windowSize) {
    start = Math.max(1, end - windowSize + 1);
  }
  for (let i = start; i <= end; i += 1) paginationPages.push(i);
%>

<div class="failed-transactions-page">
