        <span class="ft-stat-value">₹<%= (stats.totalAmountLost || 0).toLocaleString('en-IN') %></span>
        <span class="ft-stat-sub"><i class="fas fa-arrow-trend-down"></i>Failed volume</span>
      </div>
    </div>

    <div class="ft-stat-card">
      <div class="ft-stat-icon" style="background:linear-gradient(135deg,#065F46,#10B981);">
        <i class="fas fa-rotate-left" style="color:#A7F3D0;"></i>
      </div>
      <div class="ft-stat-body">
        <span class="ft-stat-label">Retry Success Rate</span>
        <span class="ft-stat-value"><%= stats.retrySuccessRate || 0 %>%</span>
        <span class="ft-stat-sub ft-stat-stable"><i class="fas fa-arrow-trend-up"></i>Stable</span>
      </div>
    </div>
  </div>

  <div class="ft-filter-bar">
    <form id="failedFilterForm" method="GET" action="/admin/transactions/failed" class="ft-filter-form">
      <div class="ft-filter-search">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" name="search" id="failedSearch" value="<%= filters?.search || '' %>" placeholder="Search by Txn ID, sender, receiver..." class="ft-filter-input" oninput="debounceFilter()">
      </div>

      <select name="type" class="ft-filter-select" onchange="this.form.submit()">
        <option value="">All Types</option>
        <option value="Wallet" <%= filters?.type==='Wallet'?'selected':'' %>>Wallet</option>
        <option value="UPI" <%= filters?.type==='UPI'?'selected':'' %>>UPI</option>
        <option value="Card" <%= filters?.type==='Card'?'selected':'' %>>Card</option>
        <option value="Bank Transfer" <%= filters?.type==='Bank Transfer'?'selected':'' %>>Bank Transfer</option>
      </select>

      <select name="reason" class="ft-filter-select" onchange="this.form.submit()">
        <option value="">All Reasons</option>
        <option value="Network Timeout" <%= filters?.reason==='Network Timeout'?'selected':'' %>>Network Timeout</option>
        <option value="Insufficient Funds" <%= filters?.reason==='Insufficient Funds'?'selected':'' %>>Insufficient Funds</option>
        <option value="Invalid Account" <%= filters?.reason==='Invalid Account'?'selected':'' %>>Invalid Account</option>
        <option value="Declined" <%= filters?.reason==='Declined'?'selected':'' %>>Declined by Bank</option>
      </select>

      <div class="ft-filter-date-wrap">
        <i class="fas fa-calendar"></i>
        <input type="date" name="dateFrom" id="dateFrom_failed" value="<%= filters?.dateFrom || '' %>" class="ft-filter-date date-from" data-date-pair="failed" data-date-role="from" onchange="this.form.submit()">
      </div>

      <div class="ft-filter-date-wrap">
        <i class="fas fa-calendar"></i>
        <input type="date" name="dateTo" id="dateTo_failed" value="<%= filters?.dateTo || '' %>" class="ft-filter-date date-to" data-date-pair="failed" data-date-role="to" onchange="this.form.submit()">
      </div>

      <button type="submit" class="ft-filter-apply">
        <i class="fas fa-filter"></i>
        Apply
      </button>

      <% if (filters?.search || filters?.type || filters?.reason || filters?.dateFrom || filters?.dateTo) { %>
      <a href="/admin/transactions/failed" class="ft-filter-clear">
        <i class="fas fa-xmark"></i>
        Clear
      </a>
      <% } %>
    </form>
  </div>

  <div class="ft-table-wrap">
    <table class="ft-table">
      <thead>
        <tr class="ft-thead-row">
          <th class="ft-th ft-th-check">
            <input type="checkbox" id="selectAllFailed" onchange="toggleSelectAll(this)">
          </th>
          <th class="ft-th">TXN ID</th>
          <th class="ft-th">TYPE</th>
          <th class="ft-th">SENDER</th>
          <th class="ft-th">RECEIVER</th>
          <th class="ft-th ft-th-right">AMOUNT (₹)</th>
          <th class="ft-th">FAILURE REASON</th>
          <th class="ft-th">DATE & TIME</th>
          <th class="ft-th ft-th-center">ACTIONS</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows || rows.length === 0) { %>
        <tr>
          <td colspan="9" class="ft-empty">
            <div class="ft-empty-inner">
              <div class="ft-empty-icon">
                <i class="fas fa-circle-check" style="color:#10B981;"></i>
              </div>
              <p class="ft-empty-title">No failed transactions</p>
              <p class="ft-empty-sub">All transactions are processing normally</p>
            </div>
          </td>
        </tr>
        <% } else { %>
        <% rows.forEach(txn => { 
          const docId = txn._id || txn.transactionId;
          const displayTxn = txn.txnId || (docId ? String(docId).slice(-12).toUpperCase() : '—');
          const receiverText = txn.receiver || txn.receiverLabel || txn.receiver?.name || 'Unknown';
          const senderText = txn.sender || txn.senderLabel || txn.sender?.name || txn.senderId || '—';
          const txnType = txn.type || '—';
          const amount = Number(txn.amount || 0);
          const reason = txn.failureReason || 'Unknown';
          const tc = typeColorsMap[txnType] || { bg:'#F1F5F9', color:'#64748B', border:'#E2E8F0' };
          const rc = reasonColorsMap[reason] || { bg:'#F1F5F9', color:'#64748B', icon:'fa-circle-info' };
          const createdDate = txn.createdAt || txn.time || txn.TransactionTime;
        %>
        <tr class="ft-row" onclick="viewTxnDetail('<%= docId %>')" style="cursor:pointer;">
          <td class="ft-td ft-td-check" onclick="event.stopPropagation()">
            <input type="checkbox" class="ft-checkbox" value="<%= docId %>" onchange="updateBulkBar()">
          </td>

          <td class="ft-td">
            <div class="ft-txn-id-wrap">
              <a href="/admin/transactions/<%= docId %>" class="ft-txn-link" onclick="event.stopPropagation()">
                #<%= displayTxn %>
              </a>
              <button class="ft-copy-btn" onclick="event.stopPropagation(); copyTxnId('<%= displayTxn %>')" title="Copy ID">
                <i class="fas fa-copy"></i>
              </button>
            </div>
          </td>

          <td class="ft-td">
            <span class="ft-type-badge" style="<%= `background:${tc.bg};color:${tc.color};border:1px solid ${tc.border};` %>">
              <%= txnType %>
            </span>
          </td>

          <td class="ft-td">
            <span class="ft-mono-text"><%= senderText %></span>
          </td>

          <td class="ft-td">
            <span class="<%= (!receiverText || receiverText === 'Unknown') ? 'ft-unknown' : 'ft-mono-text' %>"><%= receiverText || 'Unknown' %></span>
          </td>

          <td class="ft-td ft-td-right">
            <span class="ft-amount-failed">₹<%= amount.toLocaleString('en-IN') %></span>
          </td>

          <td class="ft-td">
            <span class="ft-reason-badge" style="<%= `background:${rc.bg};color:${rc.color};` %>">
              <i class="fas <%= rc.icon %>"></i>
              <%= reason %>
            </span>
          </td>

          <td class="ft-td">
            <div class="ft-date-wrap">
              <span class="ft-date">
                <%= createdDate ? new Date(createdDate).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '—' %>
              </span>
              <span class="ft-time">
                <%= createdDate ? new Date(createdDate).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true }) : '—' %>
              </span>
            </div>
          </td>

          <td class="ft-td ft-td-actions" onclick="event.stopPropagation()">
            <div class="ft-row-actions">
              <button class="ft-action-btn ft-action-view" onclick="viewTxnDetail('<%= docId %>')" title="View Details">
                <i class="fas fa-eye"></i>
              </button>
              <button class="ft-action-btn ft-action-retry" onclick="retryTransaction('<%= docId %>')" title="Retry Transaction">
                <i class="fas fa-rotate-left"></i>
              </button>
              <button class="ft-action-btn ft-action-more" onclick="toggleRowMenu(this, '<%= docId %>')" title="More options">
                <i class="fas fa-ellipsis-vertical"></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>

    <div class="ft-table-footer">
      <span class="ft-result-count">
        Showing
        <strong><%= pagination.from %>–<%= pagination.to %></strong>
        of <strong><%= pagination.total %></strong>
        failed transactions
      </span>

      <div class="ft-pagination">
        <a href="?<%= new URLSearchParams({ ...(filters||{}), page: pagination.current - 1 }) %>" class="ft-page-btn <%= pagination.current <= 1 ? 'ft-page-disabled' : '' %>">
          <i class="fas fa-chevron-left"></i>
          Prev
        </a>

        <% for(let p = Math.max(1, pagination.current - 2); p <= Math.min(pagination.totalPages, pagination.current + 2); p++) { %>
        <a href="?<%= new URLSearchParams({ ...(filters||{}), page: p }) %>" class="ft-page-btn <%= p === pagination.current ? 'ft-page-active' : '' %>">
          <%= p %>
        </a>
        <% } %>

        <a href="?<%= new URLSearchParams({ ...(filters||{}), page: pagination.current + 1 }) %>" class="ft-page-btn <%= pagination.current >= pagination.totalPages ? 'ft-page-disabled' : '' %>">
          Next
          <i class="fas fa-chevron-right"></i>
        </a>
      </div>

      <div class="ft-per-page">
        <span>Show</span>
        <select onchange="changePerPage(this.value)">
          <% [10,20,50,100].forEach(n => { %>
          <option value="<%= n %>" <%= pagination.limit == n ? 'selected':'' %>><%= n %></option>
          <% }) %>
        </select>
        <span>per page</span>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>">
// Debounce search
let ft_timer;
const ftCurrentFilters = <%- JSON.stringify(filters || {}) %>;

function changePerPage(limitValue) {
  const params = new URLSearchParams(ftCurrentFilters || {});
  params.set('limit', String(limitValue));
  params.set('page', '1');
  window.location.href = `?${params.toString()}`;
}

function debounceFilter() {
  clearTimeout(ft_timer);
  ft_timer = setTimeout(() =>
    document.getElementById('failedFilterForm').submit()
  , 500);
}

function showToast(message, type = 'success') {
  const toast = document.createElement('div');
  toast.style.position = 'fixed';
  toast.style.right = '18px';
  toast.style.bottom = '18px';
  toast.style.zIndex = '1000';
  toast.style.borderRadius = '10px';
  toast.style.padding = '10px 12px';
  toast.style.fontSize = '13px';
  toast.style.color = '#fff';
  toast.style.background = type === 'error' ? '#DC2626' : '#10B981';
  toast.style.boxShadow = '0 10px 20px rgba(15, 23, 42, .2)';
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 1800);
}

// Select all checkboxes
function toggleSelectAll(cb) {
  document.querySelectorAll('.ft-checkbox')
    .forEach(c => c.checked = cb.checked);
  updateBulkBar();
}
function updateBulkBar() {
  const checked = document.querySelectorAll(
    '.ft-checkbox:checked').length;
  const btn = document.getElementById('retrySelectedBtn');
  if (btn) btn.style.display = checked > 0 ? 'flex' : 'none';
}

// Retry single
async function retryTransaction(id) {
  if (!confirm('Retry this transaction?')) return;
  const res = await fetch(`/admin/transactions/${id}/retry`,
    { method: 'POST',
      headers: {'Content-Type':'application/json'} }
  );
  const data = await res.json();
  showToast(data.success
    ? 'Retry initiated successfully'
    : 'Retry failed: ' + (data.message || data.error || 'Unknown error'),
    data.success ? 'success' : 'error'
  );
  if (data.success)
    setTimeout(() => location.reload(), 800);
}

// Retry selected
async function retrySelected() {
  const ids = [...document.querySelectorAll(
    '.ft-checkbox:checked')].map(c => c.value);
  if (!ids.length) return;
  if (!confirm(`Retry ${ids.length} transactions?`)) return;

  let res;
  try {
    res = await fetch('/admin/transactions/retry-bulk',
      { method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ ids }) }
    );
    if (res.status === 404) {
      res = await fetch('/admin/transactions/bulk-retry',
        { method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ ids }) }
      );
    }
  } catch (_) {
    showToast('Bulk retry failed', 'error');
    return;
  }

  const data = await res.json();
  showToast(data.message || (data.success ? 'Bulk retry initiated' : 'Bulk retry failed'), data.success ? 'success' : 'error');
  if (data.success) setTimeout(() => location.reload(), 800);
}

// Copy TXN ID
function copyTxnId(id) {
  navigator.clipboard.writeText(id);
  showToast('Transaction ID copied!', 'success');
}

// View detail
function viewTxnDetail(id) {
  window.location.href = `/admin/transactions/${id}`;
}

// Refresh with spin animation
function refreshPage() {
  const icon = document.getElementById('refreshIcon');
  icon.classList.add('fa-spin');
  setTimeout(() => location.reload(), 300);
}

function toggleRowMenu(_btn, _id) {
  showToast('More actions coming soon', 'success');
}
</script>

