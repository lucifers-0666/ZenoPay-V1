<%
  const safeTransactions = Array.isArray(transactions) ? transactions : [];
  const safeFilters = filters || {};
  const safePagination = {
    current: Number(currentPageNumber || 1),
    totalPages: Number(totalPages || 1),
    total: Number(totalCount || 0),
    limit: Number(perPage || 10),
  };
  const safeStats = {
    totalFailed: Number(totalFailed || safePagination.total || safeTransactions.length || 0),
    failedToday: Number(failedToday || 0),
    totalAmountLost: Number(totalAmount || 0),
    retrySuccessRate: Number(typeof retrySuccessRate !== 'undefined' ? retrySuccessRate : 0) || 0,
  };

  const rows = safeTransactions;
  const current = safePagination.current;
  const pages = safePagination.totalPages;
  const perPageCurrent = safePagination.limit;
  const total = safePagination.total;
  const startItem = total === 0 ? 0 : ((current - 1) * perPageCurrent) + 1;
  const endItem = Math.min(current * perPageCurrent, total);

  const f = safeFilters;

  const stats = safeStats;

  const pagination = {
    from: startItem,
    to: endItem,
    total,
    current,
    totalPages: pages,
    limit: perPageCurrent,
  };

  const filtersForLinks = {
    search: f.search || '',
    type: f.type || '',
    reason: f.reason || '',
    dateFrom: f.dateFrom || '',
    dateTo: f.dateTo || '',
    limit: String(perPageCurrent),
  };

  const exportQuery = new URLSearchParams({ ...(filtersForLinks || {}), status: 'failed' }).toString();

  const reasonColorsMap = {
    'Network Timeout':   { bg:'#FFF7ED', color:'#C2410C', icon:'fa-wifi' },
    'Insufficient Funds':{ bg:'#FEF2F2', color:'#DC2626', icon:'fa-wallet' },
    'Invalid Account':   { bg:'#F5F3FF', color:'#7C3AED', icon:'fa-user-xmark' },
    'Declined':          { bg:'#FEF2F2', color:'#DC2626', icon:'fa-ban' },
    'Timeout':           { bg:'#FFF7ED', color:'#C2410C', icon:'fa-clock' }
  };

  const typeColorsMap = {
    'Wallet':        { bg:'#EFF6FF', color:'#2563EB', border:'#BFDBFE' },
    'UPI':           { bg:'#F5F3FF', color:'#7C3AED', border:'#DDD6FE' },
    'Card':          { bg:'#ECFDF5', color:'#059669', border:'#A7F3D0' },
    'Bank Transfer': { bg:'#FFF7ED', color:'#C2410C', border:'#FED7AA' }
  };
%>

<div class="failed-transactions-page">
  <div class="ft-page-header">
    <div class="ft-header-left">
      <nav class="ft-breadcrumb">
        <a href="/admin/dashboard">
          <i class="fas fa-house"></i>
        </a>
        <i class="fas fa-chevron-right"></i>
        <a href="/admin/transactions">Transactions</a>
        <i class="fas fa-chevron-right"></i>
        <span>Failed Transactions</span>
      </nav>
      <div class="ft-title-wrap">
        <div class="ft-title-icon">
          <i class="fas fa-circle-xmark"></i>
        </div>
        <div>
          <h1 class="ft-title">Failed Transactions</h1>
          <p class="ft-subtitle">
            All failed and declined payment transactions
          </p>
        </div>
      </div>
    </div>

    <div class="ft-header-actions">
      <button class="ft-btn-ghost" id="refreshBtn" onclick="refreshPage()" title="Refresh data">
        <i class="fas fa-rotate-right" id="refreshIcon"></i>
        Refresh
      </button>

      <a href="/admin/transactions/export?<%= exportQuery %>" class="ft-btn-outline">
        <i class="fas fa-download"></i>
        Export CSV
      </a>

      <button class="ft-btn-primary" id="retrySelectedBtn" style="display:none;" onclick="retrySelected()">
        <i class="fas fa-rotate-left"></i>
        Retry Selected
      </button>
    </div>
  </div>

  <div class="ft-stats-grid">
    <div class="ft-stat-card ft-stat-danger">
      <div class="ft-stat-icon" style="background:linear-gradient(135deg,#991B1B,#EF4444);">
        <i class="fas fa-circle-xmark" style="color:#FECACA;"></i>
      </div>
      <div class="ft-stat-body">
        <span class="ft-stat-label">Total Failed</span>
        <span class="ft-stat-value"><%= stats.totalFailed || 0 %></span>
        <span class="ft-stat-sub"><i class="fas fa-chart-line"></i>Monitoring</span>
      </div>
    </div>

    <div class="ft-stat-card">
      <div class="ft-stat-icon" style="background:linear-gradient(135deg,#B45309,#F59E0B);">
        <i class="fas fa-calendar-xmark" style="color:#FDE68A;"></i>
      </div>
