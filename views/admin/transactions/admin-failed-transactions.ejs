      </div>

      <select id="typeFilter" class="failed-select" aria-label="Transaction type filter">
        <option value="all" <%= (f.type || 'all') === 'all' ? 'selected' : '' %>>All Types</option>
        <option value="p2p_transfer" <%= f.type === 'p2p_transfer' ? 'selected' : '' %>>P2P Transfer</option>
        <option value="merchant_payment" <%= f.type === 'merchant_payment' ? 'selected' : '' %>>Merchant Payment</option>
        <option value="wallet_topup" <%= f.type === 'wallet_topup' ? 'selected' : '' %>>Wallet Top-Up</option>
        <option value="refund" <%= f.type === 'refund' ? 'selected' : '' %>>Refund</option>
        <option value="withdrawal" <%= f.type === 'withdrawal' ? 'selected' : '' %>>Withdrawal</option>
      </select>

      <input id="dateFrom" class="failed-input" type="date" value="<%= f.dateFrom || '' %>">
      <input id="dateTo" class="failed-input" type="date" value="<%= f.dateTo || '' %>">

      <button id="applyFiltersBtn" type="button" class="btn-primary-admin">
        <i class="fas fa-filter" aria-hidden="true"></i>
        Apply Filters
      </button>

      <button id="resetFilters" type="button" class="btn-outline-admin">
        <i class="fas fa-rotate-left" aria-hidden="true"></i>
        Reset
      </button>
    </div>
  </section>

  <section class="failed-table-card">
    <div class="admin-table-wrapper">
      <% if (!rows.length) { %>
        <div class="failed-empty-state">
          <i class="fas fa-circle-check" aria-hidden="true"></i>
          <h3>No failed transactions found</h3>
          <p>All transactions are running smoothly</p>
        </div>
      <% } else { %>
        <table class="failed-table" id="failedTable">
          <thead>
            <tr>
              <th>
                <label class="wallet-checkbox" for="failedSelectAll">
                  <input id="failedSelectAll" type="checkbox">
                  <span class="wallet-checkbox-ui"></span>
                </label>
              </th>
              <th>Txn ID</th>
              <th>Type</th>
              <th>Sender</th>
              <th>Receiver</th>
              <th class="amount-col">Amount (₹)</th>
              <th>Failure Reason</th>
              <th>Date &amp; Time</th>
              <th class="actions-col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((tx, idx) => { %>
              <tr data-transaction-id="<%= tx.transactionId %>">
                <td>
                  <label class="wallet-checkbox" for="failed-row-<%= idx %>">
                    <input id="failed-row-<%= idx %>" type="checkbox" class="row-check" value="<%= tx.transactionId %>">
                    <span class="wallet-checkbox-ui"></span>
                  </label>
                </td>
                <td>
                  <div class="txn-id-wrap">
                    <span class="txn-id-text"><%= tx.txnId || tx.transactionId %></span>
                    <button type="button" class="copy-txn-btn" data-txn-id="<%= tx.transactionId %>" title="Copy Txn ID">
                      <i class="fas fa-copy" aria-hidden="true"></i>
                    </button>
                  </div>
                </td>
                <td><span class="type-badge"><%= tx.type || 'Wallet' %></span></td>
                <td><%= tx.senderLabel || tx.sender?.name || '—' %></td>
                <td><%= tx.receiverLabel || tx.receiver?.name || '—' %></td>
                <td class="amount-cell"><%= formatMoney(tx.amount || 0) %></td>
                <td>
                  <span class="reason-pill <%= reasonClass(tx.failureReason || 'Unknown Error') %>">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    <%= tx.failureReason || 'Unknown Error' %>
                  </span>
                </td>
                <td><%= formatDateTime(tx.time || tx.TransactionTime) %></td>
                <td class="action-cell actions-col">
                  <button type="button" class="action-btn txn-dropdown-toggle" aria-label="Open actions">
                    <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
                  </button>

                  <div class="action-dropdown">
                    <a href="/admin/transactions/<%= tx.transactionId %>">
                      <i class="fas fa-eye" aria-hidden="true"></i>
                      View Details
                    </a>

                    <button type="button" class="open-retry-modal" data-open-modal="retryTxnModal" data-txn-id="<%= tx.transactionId %>" data-txn-display="<%= tx.txnId || tx.transactionId %>" data-amount="<%= tx.amount || 0 %>">
                      <i class="fas fa-rotate-right" aria-hidden="true"></i>
                      Retry Transaction
                    </button>

                    <button type="button" class="open-flag-modal" data-open-modal="flagFraudModal" data-txn-id="<%= tx.transactionId %>" data-txn-display="<%= tx.txnId || tx.transactionId %>">
                      <i class="fas fa-flag" aria-hidden="true"></i>
                      Flag as Fraud
                    </button>

                    <button
                      type="button"
                      class="open-receipt-modal"
                      data-open-modal="viewReceiptModal"
                      data-txn-id="<%= tx.transactionId %>"
                      data-txn-display="<%= tx.txnId || tx.transactionId %>"
                      data-type="<%= tx.type || 'Wallet' %>"
                      data-amount="<%= tx.amount || 0 %>"
                      data-sender="<%= tx.senderLabel || tx.sender?.name || '—' %>"
                      data-receiver="<%= tx.receiverLabel || tx.receiver?.name || '—' %>"
                      data-reason="<%= tx.failureReason || 'Unknown Error' %>"
                      data-datetime="<%= formatDateTime(tx.time || tx.TransactionTime) %>"
                      data-response="<%= tx.gatewayResponse || 'No gateway response' %>"
                    >
                      <i class="fas fa-file-lines" aria-hidden="true"></i>
                      View Receipt
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <section class="failed-pagination">
    <p class="pagination-meta">Showing <%= startItem %>–<%= endItem %> of <%= total %> failed transactions</p>

    <div class="pagination-controls" aria-label="Pagination controls">
      <a class="page-btn <%= current <= 1 ? 'disabled' : '' %>" href="<%= current <= 1 ? '#' : pageLink(current - 1) %>">Prev</a>
      <% paginationPages.forEach((p) => { %>
        <a class="page-btn <%= p === current ? 'active' : '' %>" href="<%= pageLink(p) %>"><%= p %></a>
      <% }) %>
      <a class="page-btn <%= current >= pages ? 'disabled' : '' %>" href="<%= current >= pages ? '#' : pageLink(current + 1) %>">Next</a>
    </div>

    <label class="items-per-page">
      <span>Items per page:</span>
      <select id="itemsPerPage" class="items-select" aria-label="Items per page">
        <option value="10" <%= perPageCurrent === 10 ? 'selected' : '' %>>10</option>
        <option value="25" <%= perPageCurrent === 25 ? 'selected' : '' %>>25</option>
        <option value="50" <%= perPageCurrent === 50 ? 'selected' : '' %>>50</option>
      </select>
    </label>
  </section>
</div>

<div class="bulk-action-bar" id="bulkActionBar" hidden>
  <span class="bulk-count" id="bulkSelectedCount">0 transactions selected</span>
  <button type="button" class="bulk-btn retry" id="bulkRetryBtn"><i class="fas fa-rotate-right" aria-hidden="true"></i> Retry Selected</button>
  <button type="button" class="bulk-btn flag" id="bulkFlagBtn"><i class="fas fa-flag" aria-hidden="true"></i> Flag Selected</button>
  <button type="button" class="bulk-btn export" id="bulkExportBtn"><i class="fas fa-file-export" aria-hidden="true"></i> Export Selected</button>
  <button type="button" class="bulk-clear" id="bulkClearBtn" aria-label="Clear selection"><i class="fas fa-times" aria-hidden="true"></i></button>
</div>

<div id="retryTxnModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <h3><i class="fas fa-rotate-right" aria-hidden="true"></i> Retry Transaction</h3>
      <button type="button" class="modal-close-btn" data-close-modal="retryTxnModal"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <div class="modal-row">
        <span class="label">Transaction ID</span>
        <span class="value" id="retryTxnIdText">—</span>
      </div>
      <div class="modal-row">
        <span class="label">Amount</span>
        <span class="value" id="retryTxnAmountText">₹0</span>
      </div>
      <p class="modal-warning">This will attempt to reprocess the payment.</p>
      <div class="modal-footer">
        <button type="button" class="btn-modal" data-close-modal="retryTxnModal">Cancel</button>
        <button type="button" class="btn-modal success" id="confirmRetryBtn"><i class="fas fa-rotate-right" aria-hidden="true"></i> Retry Now</button>
      </div>
    </div>
  </div>
</div>

<div id="flagFraudModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <h3><i class="fas fa-flag" aria-hidden="true"></i> Flag as Fraud</h3>
      <button type="button" class="modal-close-btn" data-close-modal="flagFraudModal"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <form id="flagFraudForm">
        <input type="hidden" id="flagTxnId">

        <div class="modal-row">
          <span class="label">Transaction ID</span>
          <span class="value" id="flagTxnDisplay">—</span>
        </div>

        <div class="modal-row">
          <label class="label" for="fraudType">Fraud Type</label>
          <select id="fraudType" class="failed-select" required>
            <option value="Suspicious Activity">Suspicious Activity</option>
            <option value="Identity Theft">Identity Theft</option>
            <option value="Unauthorized Access">Unauthorized Access</option>
            <option value="Money Laundering">Money Laundering</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="modal-row">
          <label class="label" for="fraudNotes">Notes</label>
          <textarea id="fraudNotes" class="failed-textarea" required placeholder="Enter investigation notes..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-modal" data-close-modal="flagFraudModal">Cancel</button>
          <button type="submit" class="btn-modal danger"><i class="fas fa-flag" aria-hidden="true"></i> Flag Transaction</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="viewReceiptModal" class="modal-overlay" hidden>
  <div class="modal-card modal-xl">
    <div class="modal-header">
      <h3><i class="fas fa-file-lines" aria-hidden="true"></i> Transaction Receipt</h3>
      <div>
        <button type="button" class="btn-modal" id="printReceiptBtn"><i class="fas fa-print" aria-hidden="true"></i> Print</button>
        <button type="button" class="modal-close-btn" data-close-modal="viewReceiptModal"><i class="fas fa-times" aria-hidden="true"></i></button>
      </div>
    </div>
    <div class="modal-body" id="receiptContent">
      <div class="receipt-grid">
        <div class="receipt-item"><div class="k">Transaction ID</div><div class="v" id="receiptTxnId">—</div></div>
        <div class="receipt-item"><div class="k">Type</div><div class="v" id="receiptType">—</div></div>
        <div class="receipt-item"><div class="k">Amount</div><div class="v" id="receiptAmount">₹0</div></div>
        <div class="receipt-item"><div class="k">Sender</div><div class="v" id="receiptSender">—</div></div>
        <div class="receipt-item"><div class="k">Receiver</div><div class="v" id="receiptReceiver">—</div></div>
        <div class="receipt-item"><div class="k">Failure Reason</div><div class="v" id="receiptReason">—</div></div>
        <div class="receipt-item"><div class="k">Date &amp; Time</div><div class="v" id="receiptDateTime">—</div></div>
        <div class="receipt-item"><div class="k">Gateway Response</div><div class="v" id="receiptResponse">—</div></div>
      </div>
    </div>
  </div>
</div>

<script>
  let selectedRetryTxnId = '';

  function showToast(message, type) {
    const node = document.createElement('div');
    node.className = `toast ${type || 'success'}`;
    node.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i><span>${message}</span>`;
    document.body.appendChild(node);
    setTimeout(() => node.remove(), 1800);
  }

  function toggleTxnDropdown(btn) {
    const dropdown = btn.nextElementSibling;
    const willOpen = !dropdown.classList.contains('open');

    document.querySelectorAll('.action-dropdown.open').forEach((menu) => menu.classList.remove('open'));

    if (willOpen) {
      dropdown.classList.add('open');
    }
  }

  async function retryTransaction(txnId) {
    const response = await fetch(`/admin/transactions/${encodeURIComponent(txnId)}/retry`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await response.json();

    if (!response.ok || !data.success) {
      throw new Error(data.message || 'Retry failed');
    }

    return data;
  }

  function copyTxnId(text) {
    if (!text) return;
    navigator.clipboard.writeText(text)
      .then(() => {
        showToast('Copied!', 'success');
      })
      .catch(() => {
        showToast('Copy failed', 'error');
      });
  }

  function getSelectedTxnIds() {
    return Array.from(document.querySelectorAll('.row-check:checked')).map((el) => el.value).filter(Boolean);
  }

  function updateBulkBar() {
    const ids = getSelectedTxnIds();
    const bulkBar = document.getElementById('bulkActionBar');
    const bulkSelectedCount = document.getElementById('bulkSelectedCount');
    bulkBar.hidden = ids.length === 0;
    bulkSelectedCount.textContent = `${ids.length} transaction${ids.length > 1 ? 's' : ''} selected`;
  }

  document.addEventListener('click', (event) => {
    const dropdownToggle = event.target.closest('.txn-dropdown-toggle');
    if (dropdownToggle) {
      toggleTxnDropdown(dropdownToggle);
      event.stopPropagation();
      return;
    }

    if (!event.target.closest('.action-cell')) {
      document.querySelectorAll('.action-dropdown.open').forEach((menu) => menu.classList.remove('open'));
    }

    const copyBtn = event.target.closest('.copy-txn-btn');
    if (copyBtn) {
      copyTxnId(copyBtn.dataset.txnId);
    }

    const retryBtn = event.target.closest('.open-retry-modal');
    if (retryBtn) {
      selectedRetryTxnId = retryBtn.dataset.txnId || '';
      document.getElementById('retryTxnIdText').textContent = retryBtn.dataset.txnDisplay || selectedRetryTxnId || '—';
      document.getElementById('retryTxnAmountText').textContent = `₹${Number(retryBtn.dataset.amount || 0).toLocaleString('en-IN')}`;
    }

    const flagBtn = event.target.closest('.open-flag-modal');
    if (flagBtn) {
      document.getElementById('flagTxnId').value = flagBtn.dataset.txnId || '';
      document.getElementById('flagTxnDisplay').textContent = flagBtn.dataset.txnDisplay || flagBtn.dataset.txnId || '—';
      document.getElementById('fraudNotes').value = '';
      document.getElementById('fraudType').value = 'Suspicious Activity';
    }

    const receiptBtn = event.target.closest('.open-receipt-modal');
    if (receiptBtn) {
      document.getElementById('receiptTxnId').textContent = receiptBtn.dataset.txnDisplay || receiptBtn.dataset.txnId || '—';
      document.getElementById('receiptType').textContent = receiptBtn.dataset.type || '—';
      document.getElementById('receiptAmount').textContent = `₹${Number(receiptBtn.dataset.amount || 0).toLocaleString('en-IN')}`;
      document.getElementById('receiptSender').textContent = receiptBtn.dataset.sender || '—';
      document.getElementById('receiptReceiver').textContent = receiptBtn.dataset.receiver || '—';
      document.getElementById('receiptReason').textContent = receiptBtn.dataset.reason || '—';
      document.getElementById('receiptDateTime').textContent = receiptBtn.dataset.datetime || '—';
      document.getElementById('receiptResponse').textContent = receiptBtn.dataset.response || '—';
    }
  });

  document.querySelectorAll('.row-check').forEach((checkbox) => {
    checkbox.addEventListener('change', updateBulkBar);
  });

  const selectAll = document.getElementById('failedSelectAll');
  if (selectAll) {
    selectAll.addEventListener('change', () => {
      document.querySelectorAll('.row-check').forEach((checkbox) => {
        checkbox.checked = selectAll.checked;
      });
      updateBulkBar();
    });
  }

  document.getElementById('bulkClearBtn')?.addEventListener('click', () => {
    document.querySelectorAll('.row-check').forEach((checkbox) => {
      checkbox.checked = false;
    });
    if (selectAll) selectAll.checked = false;
    updateBulkBar();
  });

  document.getElementById('confirmRetryBtn')?.addEventListener('click', async () => {
    if (!selectedRetryTxnId) return;

    try {
      await retryTransaction(selectedRetryTxnId);
      showToast('Retry initiated successfully', 'success');
      setTimeout(() => window.location.reload(), 1000);
    } catch (error) {
      showToast(error.message || 'Retry failed', 'error');
    }
  });

  document.getElementById('flagFraudForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const txnId = document.getElementById('flagTxnId').value;
    const reason = document.getElementById('fraudType').value;
    const notes = document.getElementById('fraudNotes').value.trim();

    if (!notes) {
      showToast('Notes are required', 'error');
      return;
    }

    try {
      const response = await fetch(`/admin/transactions/${encodeURIComponent(txnId)}/flag`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason, notes })
      });

      const data = await response.json();
      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Flag failed');
      }

      window.location.reload();
    } catch (error) {
      showToast(error.message || 'Flag failed', 'error');
    }
  });

  document.getElementById('applyFiltersBtn')?.addEventListener('click', () => {
    const search = document.getElementById('failedSearch').value.trim();
    const type = document.getElementById('typeFilter').value;
    const dateFrom = document.getElementById('dateFrom').value;
    const dateTo = document.getElementById('dateTo').value;
    const limit = document.getElementById('itemsPerPage').value || '10';

    const params = new URLSearchParams();
    if (search) params.set('search', search);
    if (type && type !== 'all') params.set('type', type);
    if (dateFrom) params.set('dateFrom', dateFrom);
    if (dateTo) params.set('dateTo', dateTo);
    params.set('limit', limit);
    params.set('page', '1');

    window.location.href = `/admin/transactions/failed?${params.toString()}`;
  });

  document.getElementById('resetFilters')?.addEventListener('click', () => {
    document.getElementById('failedSearch').value = '';
    document.getElementById('typeFilter').value = 'all';
    document.getElementById('dateFrom').value = '';
    document.getElementById('dateTo').value = '';
    window.location.href = '/admin/transactions/failed';
  });

  document.getElementById('itemsPerPage')?.addEventListener('change', (event) => {
    const params = new URLSearchParams(window.location.search);
    params.set('limit', event.target.value);
    params.set('page', '1');
    window.location.href = `/admin/transactions/failed?${params.toString()}`;
  });

  document.getElementById('bulkRetryBtn')?.addEventListener('click', async () => {
    const ids = getSelectedTxnIds();
    if (!ids.length) return;

    try {
      const response = await fetch('/admin/transactions/bulk-retry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Bulk retry failed');
      showToast('Bulk retry initiated', 'success');
      setTimeout(() => window.location.reload(), 800);
    } catch (error) {
      showToast(error.message || 'Bulk retry failed', 'error');
    }
  });

  document.getElementById('bulkFlagBtn')?.addEventListener('click', async () => {
    const ids = getSelectedTxnIds();
    if (!ids.length) return;

    try {
      const response = await fetch('/admin/transactions/bulk-flag', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, reason: 'Suspicious Activity', notes: 'Flagged from failed transactions bulk action' })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Bulk flag failed');
      showToast('Selected transactions flagged', 'success');
      setTimeout(() => window.location.reload(), 800);
    } catch (error) {
      showToast(error.message || 'Bulk flag failed', 'error');
    }
  });

  document.getElementById('bulkExportBtn')?.addEventListener('click', () => {
    const ids = getSelectedTxnIds();
    if (!ids.length) return;
    window.location.href = `/admin/transactions/export?ids=${encodeURIComponent(ids.join(','))}&status=failed`;
  });

  document.getElementById('exportAllBtn')?.addEventListener('click', () => {
    window.location.href = '/admin/transactions/export?status=failed';
  });

  document.getElementById('retryAllBtn')?.addEventListener('click', async () => {
    const ids = Array.from(document.querySelectorAll('.row-check')).map((el) => el.value).filter(Boolean);
    if (!ids.length) {
      showToast('No failed transactions available', 'error');
      return;
    }

    try {
      const response = await fetch('/admin/transactions/bulk-retry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Retry all failed');
      showToast('Retry queued for all listed failed transactions', 'success');
      setTimeout(() => window.location.reload(), 900);
    } catch (error) {
      showToast(error.message || 'Retry all failed', 'error');
    }
  });

  document.getElementById('printReceiptBtn')?.addEventListener('click', () => {
    window.print();
  });

  document.querySelectorAll('[data-close-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-close-modal');
      const modal = document.getElementById(modalId);
      if (modal) modal.hidden = true;
    });
  });

  document.querySelectorAll('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-open-modal');
      const modal = document.getElementById(modalId);
      if (modal) modal.hidden = false;
    });
  });
</script>
