<script nonce="<%= locals.cspNonce || '' %>">
(() => {
  const seedNode = document.getElementById('flaggedSeed');
  const seedRows = seedNode ? JSON.parse(seedNode.textContent || '[]') : [];

  const state = {
    rows: Array.isArray(seedRows) ? seedRows : [],
    filtered: [],
    selected: new Set(),
    filters: {
      q: '',
      risk: '',
      reason: '',
      from: '',
      to: ''
    }
  };

  const dom = {
    tableBody: document.getElementById('flaggedTableBody'),
    emptyState: document.getElementById('emptyState'),
    selectAll: document.getElementById('selectAllFlagged'),
    showingCount: document.getElementById('showingCount'),
    bulkBar: document.getElementById('bulkActionBar'),
    bulkCount: document.getElementById('bulkCount'),
    searchInput: document.getElementById('searchInput'),
    riskFilter: document.getElementById('riskFilter'),
    reasonFilter: document.getElementById('reasonFilter'),
    fromDate: document.getElementById('fromDate'),
    toDate: document.getElementById('toDate')
  };

  const initials = (name) => {
    const parts = String(name || 'U').trim().split(/\s+/);
    return parts.slice(0, 2).map(p => p.charAt(0).toUpperCase()).join('') || 'U';
  };

  const fmtDate = (v) => {
    const d = new Date(v || Date.now());
    if (Number.isNaN(d.getTime())) return { day: 'N/A', time: 'N/A' };
    return {
      day: d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
      time: d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })
    };
  };

  const money = (n) => `₹${Number(n || 0).toLocaleString('en-IN')}`;

  function toast(message, type = 'success') {
    if (window.showToast) return window.showToast(message, type);
    const node = document.createElement('div');
    node.className = `admin-toast admin-toast-${type === 'error' ? 'error' : 'success'}`;
    node.innerHTML = `<i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i><span>${message}</span>`;
    document.body.appendChild(node);
    setTimeout(() => node.classList.add('show'), 10);
    setTimeout(() => { node.classList.remove('show'); setTimeout(() => node.remove(), 260); }, 2300);
  }

  function riskLevel(score) {
    const n = Number(score || 0);
    if (n >= 85) return 'critical';
    if (n > 70) return 'high';
    if (n > 30) return 'medium';
    return 'low';
  }

  function riskTone(score) {
    const lvl = riskLevel(score);
    if (lvl === 'critical' || lvl === 'high') return 'high';
    if (lvl === 'medium') return 'medium';
    return 'low';
  }

  function matchesFilters(row) {
    const q = state.filters.q;
    const qMatch = !q || [row.txnId, row.transactionId, row.userName, row.userEmail, row.flagReason, row.amount]
      .some(v => String(v || '').toLowerCase().includes(q));

    const score = Number(row.risk?.score || 0);
    const lvl = riskLevel(score);
    const riskMatch = !state.filters.risk || lvl === state.filters.risk;

    const reason = String(row.flagReason || 'Suspicious Activity');
    const reasonMatch = !state.filters.reason || reason === state.filters.reason;

    const time = new Date(row.flaggedAt || row.time || Date.now()).getTime();
    const fromMatch = !state.filters.from || time >= new Date(state.filters.from).getTime();
    const toMatch = !state.filters.to || time <= (new Date(state.filters.to).getTime() + (24 * 60 * 60 * 1000 - 1));

    return qMatch && riskMatch && reasonMatch && fromMatch && toMatch;
  }

  function rowHtml(row) {
    const riskScore = Number(row.risk?.score || 75);
    const riskToneClass = riskTone(riskScore);
    const d = fmtDate(row.flaggedAt || row.time);

    return `
      <tr class="flagged-row" data-tx-id="${row.transactionId}">
        <td>
          <label class="table-check">
            <input type="checkbox" class="flag-row-check" value="${row.transactionId}">
            <span><i class="fas fa-check"></i></span>
          </label>
        </td>

        <td>
          <div class="flagged-row-id">${row.txnId || row.transactionId || 'TXN-NA'}</div>
          <div class="flagged-row-sub"><i class="fas fa-mobile-alt"></i>${row.type || 'UPI'}</div>
        </td>

        <td>
          <div class="user-cell">
            <div class="user-avatar">${initials(row.userName || row.sender?.name)}</div>
            <div>
              <div class="user-name">${row.userName || row.sender?.name || 'Unknown User'}</div>
              <div class="user-email">${row.userEmail || ''}</div>
            </div>
          </div>
        </td>

        <td>
          <div class="amt-main">−${money(row.amount || 0)}</div>
          <div class="amt-sub">Fee: ${money(row.fee || 0)}</div>
        </td>

        <td>
          <span class="reason-pill"><i class="fas fa-flag"></i>${row.flagReason || 'Suspicious Activity'}</span>
        </td>

        <td>
          <div class="risk-wrap">
            <div class="risk-track"><div class="risk-fill ${riskToneClass}" data-risk-width="${Math.max(5, Math.min(100, riskScore))}"></div></div>
            <span class="risk-score ${riskToneClass}">${riskScore}</span>
          </div>
        </td>

        <td>
          <div class="flag-date">${d.day}</div>
          <div class="flag-time">${d.time}</div>
        </td>

        <td>
          <span class="status-pill"><i class="fas fa-clock"></i>Under Review</span>
        </td>

        <td class="action-cell">
          <div class="action-cell-actions">
            <a href="/admin/transactions/${encodeURIComponent(row.transactionId || row.id)}" class="action-icon-btn" title="View Transaction"><i class="fas fa-eye"></i></a>
            <button type="button" class="action-icon-btn text-green" data-action="reviewed" data-id="${row.transactionId}" title="Unflag"><i class="fas fa-check"></i></button>
            <button type="button" class="action-icon-btn dropdown-trigger" title="More"><i class="fas fa-ellipsis-v"></i></button>

            <div class="action-dropdown">
              <a href="/admin/transactions/${encodeURIComponent(row.transactionId || row.id)}" class="action-dropdown-item">
                <i class="fas fa-eye"></i> View Details
              </a>
              <button type="button" class="action-dropdown-item text-green" data-action="reviewed" data-id="${row.transactionId}">
                <i class="fas fa-check-circle"></i> Mark Reviewed
              </button>
              <button type="button" class="action-dropdown-item text-blue" data-action="refund" data-id="${row.transactionId}">
                <i class="fas fa-undo"></i> Initiate Refund
              </button>
              <button type="button" class="action-dropdown-item" data-action="user" data-id="${row.transactionId}">
                <i class="fas fa-user"></i> View User
              </button>
              <div class="action-dropdown-separator"></div>
              <button type="button" class="action-dropdown-item text-red" data-action="reverse" data-id="${row.transactionId}">
                <i class="fas fa-ban"></i> Reverse Transaction
              </button>
            </div>
          </div>
        </td>
      </tr>
    `;
  }

  function updateRiskBars() {
    document.querySelectorAll('[data-risk-width]').forEach((el) => {
      const width = Number(el.getAttribute('data-risk-width') || 0);
      el.style.width = `${Math.max(5, Math.min(100, width))}%`;
    });
  }

  function updateBulkBar() {
    const count = state.selected.size;
    dom.bulkBar.hidden = count === 0;
    dom.bulkCount.textContent = `${count} selected`;
  }

  function render() {
    state.filtered = state.rows.filter(matchesFilters);
    dom.showingCount.textContent = state.filtered.length.toLocaleString('en-IN');

    if (!state.filtered.length) {
      dom.tableBody.innerHTML = '';
      dom.emptyState.hidden = false;
      updateBulkBar();
      return;
    }

    dom.emptyState.hidden = true;
    dom.tableBody.innerHTML = state.filtered.map(rowHtml).join('');

    updateRiskBars();

    dom.tableBody.querySelectorAll('tr[data-tx-id]').forEach((tr) => {
      tr.addEventListener('click', (event) => {
        if (event.target.closest('button, a, input, label, .action-dropdown')) return;
        const txId = tr.getAttribute('data-tx-id');
        if (txId) window.location.href = `/admin/transactions/${encodeURIComponent(txId)}`;
      });
    });

    dom.tableBody.querySelectorAll('.flag-row-check').forEach((check) => {
      check.addEventListener('change', () => {
        if (check.checked) state.selected.add(check.value);
        else state.selected.delete(check.value);
        updateBulkBar();
      });
    });

    dom.tableBody.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const action = btn.getAttribute('data-action');
        const id = btn.getAttribute('data-id');

        if (action === 'reviewed') {
          state.rows = state.rows.filter((r) => String(r.transactionId) !== String(id));
          state.selected.delete(String(id));
          toast('Transaction marked reviewed', 'success');
          render();
          return;
        }

        if (action === 'refund') {
          toast('Refund flow opened', 'success');
          return;
        }

        if (action === 'user') {
          toast('Opening user profile...', 'success');
          return;
        }

        if (action === 'reverse') {
          toast('Transaction reversed (demo)', 'success');
        }
      });
    });

    updateBulkBar();
  }

  function clearFilters() {
    state.filters = { q: '', risk: '', reason: '', from: '', to: '' };
    dom.searchInput.value = '';
    dom.riskFilter.value = '';
    dom.reasonFilter.value = '';
    dom.fromDate.value = '';
    dom.toDate.value = '';
    render();
  }

  dom.searchInput.addEventListener('input', () => { state.filters.q = dom.searchInput.value.trim().toLowerCase(); render(); });
  dom.riskFilter.addEventListener('change', () => { state.filters.risk = dom.riskFilter.value; render(); });
  dom.reasonFilter.addEventListener('change', () => { state.filters.reason = dom.reasonFilter.value; render(); });
  dom.fromDate.addEventListener('change', () => { state.filters.from = dom.fromDate.value; render(); });
  dom.toDate.addEventListener('change', () => { state.filters.to = dom.toDate.value; render(); });

  document.getElementById('clearFlagFilters').addEventListener('click', clearFilters);

  dom.selectAll.addEventListener('change', () => {
    dom.tableBody.querySelectorAll('.flag-row-check').forEach((check) => {
      check.checked = dom.selectAll.checked;
      if (check.checked) state.selected.add(check.value);
      else state.selected.delete(check.value);
    });
    updateBulkBar();
  });

  document.getElementById('markAllReviewedBtn').addEventListener('click', () => {
    state.rows = [];
    state.selected.clear();
    toast('All flagged transactions marked reviewed', 'success');
    render();
  });

  document.getElementById('exportFlaggedBtn').addEventListener('click', () => {
    const header = ['TxnId', 'User', 'Amount', 'FlagReason', 'RiskScore', 'FlaggedAt'];
    const lines = state.filtered.map((r) => [r.txnId || r.transactionId, r.userName || r.sender?.name, r.amount, r.flagReason, r.risk?.score || 0, new Date(r.flaggedAt || r.time || Date.now()).toISOString()]);
    const csv = [header, ...lines].map((row) => row.map((cell) => `"${String(cell ?? '').replace(/"/g, '""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `flagged-transactions-${Date.now()}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    toast('Flagged transactions exported', 'success');
  });

  document.getElementById('confirmBulkReviewBtn').addEventListener('click', () => {
    if (!state.selected.size) {
      toast('Select transactions first', 'error');
      return;
    }

    const action = document.getElementById('bulkActionSelect').value;
    if (action === 'reviewed') {
      state.rows = state.rows.filter((r) => !state.selected.has(String(r.transactionId)));
      state.selected.clear();
      window.AdminModal?.close('bulkReviewModal');
      toast('Bulk review completed', 'success');
      render();
      return;
    }

    window.AdminModal?.close('bulkReviewModal');
    toast('Bulk action queued', 'success');
  });

  document.getElementById('bulkReviewedBtn').addEventListener('click', () => {
    if (!state.selected.size) return toast('Select transactions first', 'error');
    state.rows = state.rows.filter((r) => !state.selected.has(String(r.transactionId)));
    state.selected.clear();
    toast('Selected transactions marked reviewed', 'success');
    render();
  });

  document.getElementById('bulkRefundBtn').addEventListener('click', () => {
    if (!state.selected.size) return toast('Select transactions first', 'error');
    toast('Refund initiated for selected transactions', 'success');
  });

  document.getElementById('bulkReverseBtn').addEventListener('click', () => {
    if (!state.selected.size) return toast('Select transactions first', 'error');
    toast('Reverse initiated for selected transactions', 'success');
  });

  render();
})();
</script>

