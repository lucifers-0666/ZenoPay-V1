<%
  const rows = Array.isArray(transactions) ? transactions : [];
  const cardStats = stats || {};

  const formatMoney = (n) => `₹${Number(n || 0).toLocaleString('en-IN')}`;
  const compactMoney = (n) => {
    const num = Number(n || 0);
    if (num >= 10000000) return `₹${(num / 10000000).toFixed(1)}Cr`;
    if (num >= 100000) return `₹${(num / 100000).toFixed(1)}L`;
    if (num >= 1000) return `₹${(num / 1000).toFixed(1)}K`;
    return `₹${num.toFixed(0)}`;
  };
%>

<section class="flagged-page" id="flaggedPage">
  <nav class="flagged-breadcrumb" aria-label="Flagged Breadcrumb">
    <a href="/admin/dashboard"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right"></i>
    <a href="/admin/transactions">Transactions</a>
    <i class="fas fa-chevron-right"></i>
    <span>Flagged</span>
  </nav>

  <header class="admin-page-header">
    <div>
      <h1 class="admin-page-title">
        <span class="page-title-icon flagged-icon"><i class="fas fa-flag"></i></span>
        Flagged Transactions
      </h1>
      <p class="admin-page-subtitle">Transactions marked for suspicious activity review</p>
    </div>
    <div class="page-header-actions">
      <a href="/admin/transactions" class="btn-outline-admin"><i class="fas fa-arrow-left"></i> All Transactions</a>
      <button type="button" class="btn-outline-admin" id="exportFlaggedBtn"><i class="fas fa-download"></i> Export</button>
      <button type="button" class="btn-primary-admin" data-open-modal="bulkReviewModal"><i class="fas fa-tasks"></i> Bulk Review</button>
    </div>
  </header>

  <section class="admin-stats-grid flagged-stats-grid">
    <article class="admin-stat-card delay-1">
      <div class="stat-icon-wrap bg-amber"><i class="fas fa-flag"></i></div>
      <div class="stat-info">
        <div class="stat-value" id="statTotalFlagged"><%= Number(cardStats.totalFlagged || rows.length).toLocaleString('en-IN') %></div>
        <div class="stat-label">TOTAL FLAGGED</div>
      </div>
      <span class="stat-trend neutral"><i class="fas fa-minus"></i>Active flags</span>
    </article>

    <article class="admin-stat-card delay-2 high-risk-card">
      <div class="stat-icon-wrap bg-red"><i class="fas fa-exclamation-triangle"></i></div>
      <div class="stat-info">
        <div class="stat-value" id="statHighRisk"><%= Number(cardStats.highRisk || 0).toLocaleString('en-IN') %></div>
        <div class="stat-label">HIGH RISK</div>
      </div>
      <span class="stat-trend down"><i class="fas fa-fire"></i>Needs immediate review</span>
    </article>

    <article class="admin-stat-card delay-3">
      <div class="stat-icon-wrap bg-purple"><i class="fas fa-rupee-sign"></i></div>
      <div class="stat-info">
        <div class="stat-value" id="statFlaggedVolume"><%= compactMoney(cardStats.flaggedVolume || 0) %></div>
        <div class="stat-label">FLAGGED VOLUME</div>
      </div>
      <span class="stat-trend neutral"><i class="fas fa-info-circle"></i>Under review</span>
    </article>

    <article class="admin-stat-card delay-4">
      <div class="stat-icon-wrap bg-green"><i class="fas fa-check-circle"></i></div>
      <div class="stat-info">
        <div class="stat-value" id="statResolvedMonth"><%= Number(cardStats.resolvedMonth || 0).toLocaleString('en-IN') %></div>
        <div class="stat-label">RESOLVED THIS MONTH</div>
      </div>
      <span class="stat-trend up"><i class="fas fa-arrow-up"></i>+5 from last month</span>
    </article>
  </section>

  <section class="admin-card flagged-filter-card">
    <div class="flagged-filter-row">
      <div class="search-wrap flagged-search">
        <i class="fas fa-search"></i>
        <input id="searchInput" type="text" class="admin-input round" placeholder="Search by TXN ID, user, amount...">
      </div>

      <select id="riskFilter" class="admin-select round min-150">
        <option value="">All Risk Levels</option>
        <option value="low">Low Risk</option>
        <option value="medium">Medium Risk</option>
        <option value="high">High Risk</option>
        <option value="critical">Critical</option>
      </select>

      <select id="reasonFilter" class="admin-select round min-170">
        <option value="">All Flag Reasons</option>
        <option value="Suspicious Activity">Suspicious Activity</option>
        <option value="Large Amount">Large Amount</option>
        <option value="Multiple Failed Attempts">Multiple Failed Attempts</option>
        <option value="User Reported Fraud">User Reported Fraud</option>
      </select>

      <input id="fromDate" type="date" class="admin-input w-160 date-from" data-date-pair="flagged" data-date-role="from">
      <input id="toDate" type="date" class="admin-input w-160 date-to" data-date-pair="flagged" data-date-role="to">

      <button type="button" class="btn-outline-admin clear-danger" id="clearFlagFilters"><i class="fas fa-times"></i>Clear</button>
    </div>
  </section>

  <section class="admin-card flagged-table-card admin-table-wrapper">
    <div class="table-meta-row">
      <span>Showing <strong id="showingCount">0</strong> flagged transactions</span>
      <button type="button" class="btn-outline-admin btn-sm" id="markAllReviewedBtn"><i class="fas fa-check-double"></i>Mark All Reviewed</button>
    </div>

    <table class="flagged-table" id="flaggedTable">
      <thead>
        <tr>
          <th>
            <label class="table-check">
              <input type="checkbox" id="selectAllFlagged">
              <span><i class="fas fa-check"></i></span>
            </label>
          </th>
          <th>TXN ID</th>
          <th>User</th>
          <th>Amount</th>
          <th>Flag Reason</th>
          <th>Risk</th>
          <th>Flagged On</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="flaggedTableBody"></tbody>
    </table>

    <div class="flagged-empty" id="emptyState" hidden>
      <i class="fas fa-flag empty-state-icon"></i>
      <h3>No Flagged Transactions</h3>
      <p>All clear — no transactions currently flagged for review</p>
      <a href="/admin/transactions" class="btn-primary-admin"><i class="fas fa-arrow-left"></i>Back to All Transactions</a>
    </div>
  </section>
</section>

<div class="bulk-action-bar" id="bulkActionBar" hidden>
  <p class="bulk-action-count" id="bulkCount">0 selected</p>
  <button type="button" class="bulk-action-btn bulk-action-btn-success" id="bulkReviewedBtn"><i class="fas fa-check-circle"></i>Mark Reviewed</button>
  <button type="button" class="bulk-action-btn bulk-action-btn-primary" id="bulkRefundBtn"><i class="fas fa-undo"></i>Initiate Refund</button>
  <button type="button" class="bulk-action-btn bulk-action-btn-red" id="bulkReverseBtn"><i class="fas fa-ban"></i>Reverse</button>
</div>

<div id="bulkReviewModal" class="modal-overlay" hidden>
  <div class="modal-card flagged-modal-card">
    <div class="modal-header flagged-modal-head">
      <h3><i class="fas fa-tasks"></i> Bulk Review Actions</h3>
      <button type="button" class="modal-close-btn" data-close-modal="bulkReviewModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <p class="modal-note">Apply one action to all selected flagged transactions.</p>
      <div class="form-group">
        <label class="form-label">Action</label>
        <select id="bulkActionSelect" class="admin-select">
          <option value="reviewed">Mark as Reviewed</option>
          <option value="refund">Initiate Refund</option>
          <option value="reverse">Reverse Transaction</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Admin Note</label>
        <textarea id="bulkReviewNote" class="admin-textarea" rows="3" placeholder="Add review context..."></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="bulkReviewModal">Cancel</button>
        <button type="button" class="btn-primary-modal" id="confirmBulkReviewBtn"><i class="fas fa-check"></i>Apply Action</button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>" id="flaggedSeed" type="application/json"><%- JSON.stringify(rows).replace(/</g, '\\u003c') %></script>

