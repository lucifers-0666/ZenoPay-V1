<%
  const tx = transaction || {};
  const rawId = String(tx.TransactionID || tx._id || 'N/A');
  const txDate = tx.TransactionTime ? new Date(tx.TransactionTime) : new Date();

  const amount = Number(tx.Amount || 0);
  const fee = Math.max(0.5, +(amount * 0.001).toFixed(2));
  const netAmount = +(amount - fee).toFixed(2);

  const senderName = tx.SenderHolderName || 'N/A';
  const receiverName = tx.ReceiverHolderName || 'N/A';
  const senderAccount = tx.SenderAccountNumber || 'N/A';
  const receiverAccount = tx.ReceiverAccountNumber || 'N/A';
  const senderBank = tx.SenderBank || 'N/A';
  const receiverBank = tx.ReceiverBank || 'N/A';

  const senderEmail = tx.SenderEmail || 'N/A';
  const receiverEmail = tx.ReceiverEmail || 'N/A';
  const senderWalletAfter = Number(tx.SenderWalletAfter || 1200);
  const receiverWalletAfter = Number(tx.ReceiverWalletAfter || 4750);

  const description = String(tx.Description || 'Transaction');
  const type = /refund|reversal/i.test(description) ? 'Refund' : (/neft|rtgs|imps/i.test(description) ? 'Bank Transfer' : 'UPI Transfer');
  const paymentType = /upi/i.test(description + ' ' + senderAccount) ? 'UPI' : 'Wallet';
  const authMethod = paymentType === 'UPI' ? 'UPI PIN' : 'Wallet PIN';

  const isFlagged = Boolean(tx.IsFlagged);
  const rawStatus = String(tx.Status || 'success').toLowerCase();
  const status = isFlagged ? 'flagged' : (rawStatus === 'failed' ? 'failed' : (rawStatus === 'pending' ? 'pending' : (rawStatus === 'success' ? 'success' : 'success')));

  let riskScore = 22;
  if (amount >= 50000) riskScore += 34;
  else if (amount >= 10000) riskScore += 18;
  else if (amount >= 2500) riskScore += 8;
  if (status === 'pending') riskScore += 10;
  if (status === 'failed') riskScore += 24;
  if (status === 'flagged') riskScore += 20;
  riskScore = Math.max(5, Math.min(99, riskScore));
  const riskLevel = riskScore > 70 ? 'high' : (riskScore > 30 ? 'medium' : 'low');

  const txnDisplayId = `#TXN-${txDate.getFullYear()}-${rawId.replace(/\D/g, '').padStart(6, '0')}`;
  const dateMain = txDate.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' });
  const timeMain = txDate.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
  const fullDateTime = `${dateMain} · ${timeMain}`;

  const money = (n) => `₹${Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const senderInitial = (senderName || 'S').split(' ').map(x => x.charAt(0)).join('').slice(0, 2).toUpperCase();
  const receiverInitial = (receiverName || 'R').split(' ').map(x => x.charAt(0)).join('').slice(0, 2).toUpperCase();

  const statusMeta = {
    success: { icon: 'fa-check-circle', label: 'Success', cls: 'is-success' },
    pending: { icon: 'fa-clock', label: 'Pending', cls: 'is-pending' },
    failed: { icon: 'fa-times-circle', label: 'Failed', cls: 'is-failed' },
    flagged: { icon: 'fa-flag', label: 'Flagged', cls: 'is-flagged' }
  }[status] || { icon: 'fa-check-circle', label: 'Success', cls: 'is-success' };
%>

<section class="txd-page" id="txDetailsPage">
  <nav class="txd-breadcrumb" aria-label="breadcrumb">
    <a href="/admin/dashboard"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right"></i>
    <a href="/admin/transactions">Transactions</a>
    <i class="fas fa-chevron-right"></i>
    <span><%= txnDisplayId %></span>
  </nav>

  <header class="txd-header">
    <div class="txd-header-left">
      <a href="/admin/transactions" class="txd-back-link"><i class="fas fa-arrow-left"></i>Back to Transactions</a>
      <h1 class="txd-title">Transaction <%= txnDisplayId %></h1>
      <p class="txd-subtitle"><%= dateMain %> • <%= timeMain %> • <%= type %> • <strong><%= money(amount) %></strong></p>
    </div>

    <div class="txd-header-actions">
      <button type="button" class="txd-btn txd-btn-outline" id="downloadReceiptTop"><i class="fas fa-download"></i>Download Receipt</button>
      <button type="button" class="txd-btn txd-btn-amber" data-open-modal="flagTransactionModal"><i class="fas fa-flag"></i>Flag Transaction</button>
      <div class="action-cell txd-more-cell">
        <button type="button" class="action-icon-btn dropdown-trigger" aria-label="More actions"><i class="fas fa-ellipsis-v"></i></button>
        <div class="action-dropdown">
          <button type="button" class="action-dropdown-item text-blue" data-open-modal="refundModal"><i class="fas fa-undo"></i>Initiate Refund</button>
          <button type="button" class="action-dropdown-item text-amber" data-open-modal="reverseModal"><i class="fas fa-ban"></i>Reverse Transaction</button>
          <a href="/admin/users" class="action-dropdown-item"><i class="fas fa-user"></i>View Sender Profile</a>
          <a href="/admin/users" class="action-dropdown-item"><i class="fas fa-user"></i>View Receiver Profile</a>
          <div class="action-dropdown-separator"></div>
          <button type="button" class="action-dropdown-item text-red" id="deleteRecordBtn"><i class="fas fa-trash"></i>Delete Record</button>
        </div>
      </div>
    </div>
  </header>

  <div class="txd-layout-grid">
    <div>
      <article class="txd-card left-card delay-0">
        <div class="txd-amount-block">
          <h2 class="txd-amount <%= status === 'failed' ? 'failed' : (status === 'pending' || status === 'flagged' ? 'debit' : 'credit') %> js-count-amount" data-value="<%= amount.toFixed(2) %>">
            <%= status === 'failed' || status === 'pending' || status === 'flagged' ? '−' : '+' %><%= money(amount) %>
          </h2>
          <span class="txd-status-pill <%= statusMeta.cls %>"><i class="fas <%= statusMeta.icon %>"></i><%= statusMeta.label %></span>
          <p class="txd-type-line"><%= type %></p>
        </div>

        <div class="txd-divider"></div>

        <div class="txd-info-grid">
          <div class="txd-info-item"><span class="txd-info-icon blue"><i class="fas fa-hashtag"></i></span><p>Transaction ID</p><h4><%= txnDisplayId %></h4></div>
          <div class="txd-info-item"><span class="txd-info-icon slate"><i class="fas fa-calendar-alt"></i></span><p>Date & Time</p><h4><%= fullDateTime %></h4></div>
          <div class="txd-info-item"><span class="txd-info-icon blue"><i class="fas fa-mobile-alt"></i></span><p>Payment Type</p><h4><%= paymentType %></h4></div>

          <div class="txd-info-item"><span class="txd-info-icon green"><i class="fas fa-rupee-sign"></i></span><p>Amount</p><h4><%= money(amount) %></h4></div>
          <div class="txd-info-item"><span class="txd-info-icon slate"><i class="fas fa-receipt"></i></span><p>Platform Fee</p><h4><%= money(fee) %></h4></div>
          <div class="txd-info-item"><span class="txd-info-icon green"><i class="fas fa-rupee-sign"></i></span><p>Net Amount</p><h4><%= money(netAmount) %></h4></div>

          <div class="txd-info-item"><span class="txd-info-icon purple"><i class="fas fa-stopwatch"></i></span><p>Processing Time</p><h4>1.2 seconds</h4></div>
          <div class="txd-info-item"><span class="txd-info-icon slate"><i class="fas fa-server"></i></span><p>Gateway</p><h4>Razorpay</h4></div>
          <div class="txd-info-item"><span class="txd-info-icon green"><i class="fas fa-shield-alt"></i></span><p>Auth Method</p><h4><%= authMethod %></h4></div>
        </div>
      </article>

      <article class="txd-card left-card delay-1">
        <header class="txd-card-header">
          <span class="txd-header-icon"><i class="fas fa-exchange-alt"></i></span>
          <h3>Transaction Parties</h3>
        </header>

        <div class="txd-flow-wrap">
          <div class="txd-party-card sender">
            <div class="txd-party-top">
              <span class="txd-party-avatar sender"><%= senderInitial %></span>
              <p class="txd-party-tag sender">SENDER</p>
            </div>
            <h4><%= senderName %></h4>
            <p class="txd-party-sub"><%= senderEmail %></p>
            <p class="txd-party-mono"><%= senderAccount %></p>
            <p class="txd-party-wallet">Wallet: <%= money(senderWalletAfter) %></p>
            <a href="/admin/users" class="txd-profile-link">View Profile <i class="fas fa-arrow-right"></i></a>
          </div>

          <div class="txd-flow-center">
            <i class="fas fa-long-arrow-alt-right"></i>
            <h5><%= money(amount) %></h5>
            <span class="txd-micro-badge <%= statusMeta.cls %>"><%= statusMeta.label %></span>
          </div>

          <div class="txd-party-card receiver">
            <div class="txd-party-top">
              <span class="txd-party-avatar receiver"><%= receiverInitial %></span>
              <p class="txd-party-tag receiver">RECEIVER</p>
            </div>
            <h4><%= receiverName %></h4>
            <p class="txd-party-sub"><%= receiverEmail %></p>
            <p class="txd-party-mono"><%= receiverAccount %></p>
            <p class="txd-party-wallet">Wallet: <%= money(receiverWalletAfter) %></p>
            <a href="/admin/users" class="txd-profile-link">View Profile <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </article>

      <article class="txd-card left-card delay-2">
        <header class="txd-card-header">
          <span class="txd-header-icon"><i class="fas fa-credit-card"></i></span>
          <h3>Payment Method Details</h3>
        </header>

        <div class="txd-two-col-grid">
          <div class="txd-kv"><p>Method</p><h4><%= paymentType %></h4></div>
          <div class="txd-kv"><p>UPI ID</p><h4><%= senderAccount %></h4></div>
          <div class="txd-kv"><p>Bank Name</p><h4><%= senderBank %></h4></div>
          <div class="txd-kv"><p>VPA Handle</p><h4><%= (String(senderAccount).includes('@') ? '@' + String(senderAccount).split('@')[1] : 'N/A') %></h4></div>
          <div class="txd-kv"><p>Device</p><h4>iPhone 14 — iOS 17</h4></div>
          <div class="txd-kv"><p>IP Address</p><h4>103.45.22.xxx</h4></div>
          <div class="txd-kv"><p>Location</p><h4>Mumbai, Maharashtra</h4></div>
          <div class="txd-kv"><p>App Used</p><h4>ZenoPay iOS App v2.4.1</h4></div>
        </div>
      </article>

      <article class="txd-card left-card delay-3">
        <header class="txd-card-header">
          <span class="txd-header-icon"><i class="fas fa-history"></i></span>
          <h3>Processing Timeline</h3>
        </header>

        <div class="txd-timeline">
          <div class="txd-step delay-0"><span class="dot blue"></span><div><h5>Initiated</h5><p>User initiated UPI transfer</p><time><%= dateMain %> • <%= timeMain %></time></div></div>
          <div class="txd-step delay-1"><span class="dot amber"></span><div><h5>Processing</h5><p>Sent to payment gateway</p><time><%= dateMain %> • <%= timeMain %></time></div></div>
          <div class="txd-step delay-2"><span class="dot purple"></span><div><h5>Bank Verification</h5><p>Bank authentication completed</p><time><%= dateMain %> • <%= timeMain %></time></div></div>
          <div class="txd-step delay-3"><span class="dot blue"></span><div><h5>Gateway Response</h5><p>Razorpay confirmed success</p><time><%= dateMain %> • <%= timeMain %></time></div></div>
          <div class="txd-step delay-4"><span class="dot green"></span><div><h5>Completed</h5><p>Amount credited to receiver</p><time><%= dateMain %> • <%= timeMain %></time></div></div>
        </div>
      </article>

      <article class="txd-card left-card delay-4">
        <header class="txd-card-header txd-card-subhead">
          <div>
            <span class="txd-header-icon"><i class="fas fa-link"></i></span>
            <h3>Related Transactions</h3>
          </div>
          <p>Other transactions by same sender today</p>
        </header>

        <div class="admin-table-wrapper txd-related-wrap">
          <table class="txd-related-table">
            <thead>
              <tr><th>TXN ID</th><th>Amount</th><th>Receiver</th><th>Status</th><th>Time</th></tr>
            </thead>
            <tbody>
              <tr data-href="/admin/transactions/<%= encodeURIComponent(rawId) %>"><td><%= txnDisplayId %></td><td><%= money(amount) %></td><td><%= receiverName %></td><td><span class="mini-status <%= statusMeta.cls %>"><%= statusMeta.label %></span></td><td><%= timeMain %></td></tr>
            </tbody>
          </table>
        </div>

        <a href="/admin/transactions?user=<%= encodeURIComponent(senderName) %>" class="txd-view-all-link">View All by User</a>
      </article>
    </div>

    <aside class="txd-right-rail">
      <article class="txd-card right-card delay-0 txd-health-card">
        <header class="txd-side-title"><i class="fas fa-tachometer-alt"></i><h4>Transaction Health</h4></header>

        <div class="txd-status-row"><span>Current Status</span><span class="txd-status-pill <%= statusMeta.cls %>"><i class="fas <%= statusMeta.icon %>"></i><%= statusMeta.label %></span></div>

        <div class="txd-gauge-wrap">
          <svg viewBox="0 0 160 90" class="txd-risk-gauge" aria-label="Risk gauge">
            <path d="M 20 80 A 60 60 0 0 1 140 80" class="txd-gauge-bg"></path>
            <path d="M 20 80 A 60 60 0 0 1 140 80" class="txd-gauge-progress" id="riskGaugePath"></path>
          </svg>
          <div class="txd-gauge-center">
            <h3 id="riskScoreValue" data-risk="<%= riskScore %>"><%= riskScore %></h3>
            <p><%= riskLevel === 'high' ? 'High Risk' : (riskLevel === 'medium' ? 'Medium Risk' : 'Low Risk') %></p>
          </div>
        </div>

        <div class="txd-risk-flags">
          <div class="txd-flag-row"><span class="icon green"><i class="fas fa-check"></i></span><p>Amount within normal range</p><span class="sev low">LOW</span></div>
          <div class="txd-flag-row"><span class="icon slate"><i class="fas fa-map-marker-alt"></i></span><p>Location matches user history</p><span class="sev low">LOW</span></div>
          <div class="txd-flag-row"><span class="icon amber"><i class="fas fa-exclamation-triangle"></i></span><p>3rd transaction in 1 hour</p><span class="sev medium">MEDIUM</span></div>
        </div>
      </article>

      <article class="txd-card right-card delay-1">
        <header class="txd-side-title"><span class="txd-header-icon small"><i class="fas fa-bolt"></i></span><h4>Admin Actions</h4></header>
        <div class="txd-action-stack">
          <button type="button" class="txd-quick-btn blue" data-open-modal="refundModal"><i class="fas fa-undo"></i>Initiate Refund</button>
          <button type="button" class="txd-quick-btn amber" data-open-modal="reverseModal"><i class="fas fa-ban"></i>Reverse Transaction</button>
          <button type="button" class="txd-quick-btn amber" data-open-modal="flagTransactionModal"><i class="fas fa-flag"></i>Flag for Review</button>
          <button type="button" class="txd-quick-btn slate" id="downloadReceiptSide"><i class="fas fa-download"></i>Download Receipt</button>
          <button type="button" class="txd-quick-btn red" data-open-modal="suspendUserModal"><i class="fas fa-user-slash"></i>Suspend Sender</button>
        </div>
      </article>

      <article class="txd-card right-card delay-2">
        <header class="txd-side-title"><span class="txd-header-icon small"><i class="fas fa-server"></i></span><h4>Gateway Response</h4></header>
        <div class="txd-code-wrap">
          <button type="button" id="copyGatewayBtn" class="txd-copy-btn" aria-label="Copy gateway response"><i class="fas fa-copy"></i></button>
          <pre id="gatewayResponseBlock" class="txd-code-block">{
  "status": "success",
  "gateway": "razorpay",
  "razorpay_txn_id": "pay_OjKLM12345",
  "bank_ref": "423891029384",
  "response_code": "00",
  "response_msg": "Transaction Approved",
  "timestamp": "<%= txDate.toISOString() %>"
}</pre>
        </div>
      </article>

      <article class="txd-card right-card delay-3">
        <header class="txd-side-title with-sub"><div><span class="txd-header-icon small"><i class="fas fa-sticky-note"></i></span><h4>Admin Notes</h4></div><p>Internal only</p></header>
        <div id="notesList" class="txd-notes-list">
          <article class="txd-note-item"><span><%= dateMain %> • Admin User</span><p>Transaction reviewed. No discrepancy observed in sender KYC.</p></article>
          <article class="txd-note-item"><span><%= dateMain %> • Compliance Bot</span><p>Velocity check triggered medium risk due to repeated payouts.</p></article>
        </div>
        <div class="txd-note-form">
          <textarea class="admin-textarea" id="newAdminNote" rows="3" placeholder="Add an internal note..."></textarea>
          <button type="button" class="txd-add-note" id="addAdminNoteBtn"><i class="fas fa-plus"></i>Add Note</button>
        </div>
      </article>
    </aside>
  </div>
</section>

<div id="refundModal" class="modal-overlay" hidden>
  <div class="modal-card txd-modal-card">
    <div class="modal-header txd-head-blue">
      <div>
        <h3 class="modal-title"><i class="fas fa-undo"></i> Initiate Refund</h3>
        <p class="modal-subtitle">Process refund for this transaction</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="refundModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="txd-modal-strip"><strong><%= txnDisplayId %></strong> • <%= money(amount) %> • <%= fullDateTime %></div>
      <div class="form-group">
        <label class="form-label" for="refundAmountInput">Refund Amount</label>
        <input id="refundAmountInput" type="number" class="admin-input" value="<%= amount.toFixed(2) %>" step="0.01" min="0">
      </div>
      <div class="form-toggle-row"><span>Full Refund</span><label class="admin-toggle"><input id="fullRefundToggle" type="checkbox" checked><span class="toggle-slider"></span></label></div>
      <div class="form-group">
        <label class="form-label" for="refundReasonInput">Reason</label>
        <select id="refundReasonInput" class="admin-select">
          <option>Duplicate</option>
          <option>User Request</option>
          <option>Fraud</option>
          <option>Technical</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="refundNoteInput">Note</label>
        <textarea id="refundNoteInput" class="admin-textarea" rows="3" placeholder="Add internal reason..."></textarea>
      </div>
      <div class="form-toggle-row"><span>Notify User</span><label class="admin-toggle"><input id="refundNotifyToggle" type="checkbox" checked><span class="toggle-slider"></span></label></div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="refundModal">Cancel</button>
        <button type="button" class="btn-primary-modal" id="processRefundBtn"><i class="fas fa-check"></i>Process Refund</button>
      </div>
    </div>
  </div>
</div>

<div id="reverseModal" class="modal-overlay" hidden>
  <div class="modal-card txd-modal-card small">
    <div class="modal-header txd-head-amber">
      <div>
        <h3 class="modal-title"><i class="fas fa-ban"></i> Reverse Transaction</h3>
        <p class="modal-subtitle">This will move funds back to sender</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="reverseModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="txd-warning-box"><i class="fas fa-exclamation-triangle"></i><p>This action cannot be undone. Funds will be returned to sender.</p></div>
      <div class="form-group">
        <label class="form-label" for="reverseReasonInput">Reason</label>
        <select id="reverseReasonInput" class="admin-select" required>
          <option value="">Select a reason</option>
          <option>Fraud Suspicion</option>
          <option>Duplicate Transfer</option>
          <option>Compliance Hold</option>
          <option>Technical Mismatch</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="adminPasswordInput">Enter admin password to confirm</label>
        <input id="adminPasswordInput" type="password" class="admin-input" placeholder="Admin password">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="reverseModal">Cancel</button>
        <button type="button" class="btn-primary-modal txd-amber-btn" id="confirmReverseBtn"><i class="fas fa-ban"></i>Confirm Reversal</button>
      </div>
    </div>
  </div>
</div>

<div id="flagTransactionModal" class="modal-overlay" hidden>
  <div class="modal-card txd-modal-card small">
    <div class="modal-header txd-head-amber">
      <div>
        <h3 class="modal-title"><i class="fas fa-flag"></i> Flag Transaction</h3>
        <p class="modal-subtitle">Mark this transaction for compliance review</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="flagTransactionModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <p class="txd-modal-copy">You are flagging <strong><%= txnDisplayId %></strong> for review.</p>
      <div class="form-group">
        <label class="form-label" for="flagReasonInput">Flag Reason</label>
        <select id="flagReasonInput" class="admin-select">
          <option>Suspicious Activity</option>
          <option>Unusually Large Amount</option>
          <option>Multiple Failed Attempts</option>
          <option>User Reported Fraud</option>
          <option>AML Compliance Check</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="flagNoteInput">Admin Note</label>
        <textarea id="flagNoteInput" class="admin-textarea" rows="3" placeholder="Add review context..."></textarea>
      </div>
      <div class="form-toggle-row"><span>Notify Compliance Team</span><label class="admin-toggle"><input id="notifyComplianceToggle" type="checkbox" checked><span class="toggle-slider"></span></label></div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="flagTransactionModal">Cancel</button>
        <button type="button" class="btn-primary-modal txd-amber-btn" id="confirmFlagBtn"><i class="fas fa-flag"></i>Flag Transaction</button>
      </div>
    </div>
  </div>
</div>

<div id="suspendUserModal" class="modal-overlay" hidden>
  <div class="modal-card txd-modal-card small">
    <div class="modal-header txd-head-red">
      <div>
        <h3 class="modal-title"><i class="fas fa-user-slash"></i> Suspend Sender</h3>
        <p class="modal-subtitle">Temporary suspend sender account</p>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="suspendUserModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <p class="txd-modal-copy">Suspend <strong><%= senderName %></strong> pending manual review?</p>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="suspendUserModal">Cancel</button>
        <button type="button" class="btn-danger-modal" id="confirmSuspendBtn"><i class="fas fa-user-slash"></i>Suspend User</button>
      </div>
    </div>
  </div>
</div>

<style>
  .txd-page { color: var(--text-main); }

  .txd-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--text-soft);
  }
  .txd-breadcrumb a { color: var(--text-muted); transition: color var(--trans-fast); }
