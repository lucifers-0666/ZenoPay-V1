<script>
  (() => {
    const $ = (sel) => document.querySelector(sel);

    const showToast = (message, type = 'success') => {
      if (window.showToast) return window.showToast(message, type);
      const el = document.createElement('div');
      el.className = `admin-toast admin-toast-${type === 'error' ? 'error' : 'success'}`;
      el.innerHTML = `<i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i><span>${message}</span>`;
      document.body.appendChild(el);
      setTimeout(() => el.classList.add('show'), 10);
      setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 220); }, 2400);
    };

    function animateAmount() {
      const el = document.querySelector('.js-count-amount');
      if (!el) return;
      const raw = Number(el.getAttribute('data-value') || 0);
      const isDebit = el.textContent.trim().startsWith('−');
      const sign = isDebit ? '−' : '+';

      const duration = 850;
      const start = performance.now();
      const step = (now) => {
        const t = Math.min(1, (now - start) / duration);
        const val = raw * (1 - Math.pow(1 - t, 3));
        el.textContent = `${sign}₹${val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    function setupGauge() {
      const scoreEl = $('#riskScoreValue');
      const arc = $('#riskGaugePath');
      if (!scoreEl || !arc) return;

      const score = Math.max(0, Math.min(100, Number(scoreEl.getAttribute('data-risk') || 0)));
      const len = arc.getTotalLength();
      const pct = score / 100;

      arc.style.strokeDasharray = String(len);
      arc.style.strokeDashoffset = String(len);

      if (score <= 30) {
        arc.style.stroke = 'var(--green)';
        scoreEl.style.color = 'var(--green-dark)';
      } else if (score <= 70) {
        arc.style.stroke = 'var(--amber)';
        scoreEl.style.color = 'var(--amber-dark)';
      } else {
        arc.style.stroke = 'var(--red)';
        scoreEl.style.color = 'var(--red)';
      }

      requestAnimationFrame(() => {
        arc.style.strokeDashoffset = String(len - len * pct);
      });
    }

    function setupRelatedRows() {
      document.querySelectorAll('.txd-related-table tbody tr[data-href]').forEach((tr) => {
        tr.addEventListener('click', () => {
          const href = tr.getAttribute('data-href');
          if (href) window.location.href = href;
        });
      });
    }

    function setupCopyGateway() {
      const btn = $('#copyGatewayBtn');
      const block = $('#gatewayResponseBlock');
      if (!btn || !block) return;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(block.textContent || '');
          showToast('Gateway response copied', 'success');
        } catch (_) {
          showToast('Unable to copy response', 'error');
        }
      });
    }

    function setupDownloads() {
      const onDownload = () => showToast('Receipt download started', 'success');
      $('#downloadReceiptTop')?.addEventListener('click', onDownload);
      $('#downloadReceiptSide')?.addEventListener('click', onDownload);
    }

    function setupNotes() {
      const btn = $('#addAdminNoteBtn');
      const textarea = $('#newAdminNote');
      const list = $('#notesList');
      if (!btn || !textarea || !list) return;

      btn.addEventListener('click', () => {
        const value = String(textarea.value || '').trim();
        if (!value) return showToast('Please enter a note first', 'error');

        const now = new Date();
        const stamp = now.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) + ' • Admin User';
        const row = document.createElement('article');
        row.className = 'txd-note-item';
        row.innerHTML = `<span>${stamp}</span><p>${value.replace(/</g, '&lt;')}</p>`;
        list.prepend(row);
        textarea.value = '';
        showToast('Note added', 'success');
      });
    }

    function setupModalActions() {
      const fullToggle = $('#fullRefundToggle');
      const amountInput = $('#refundAmountInput');
      const baseAmount = Number(amountInput?.value || 0);

      fullToggle?.addEventListener('change', () => {
        if (!amountInput) return;
        if (fullToggle.checked) {
          amountInput.value = baseAmount.toFixed(2);
          amountInput.readOnly = true;
        } else {
          amountInput.readOnly = false;
        }
      });

      $('#processRefundBtn')?.addEventListener('click', () => {
        window.AdminModal?.close('refundModal');
        showToast('Refund request submitted', 'success');
      });

      $('#confirmReverseBtn')?.addEventListener('click', () => {
        const reason = String($('#reverseReasonInput')?.value || '').trim();
        const pass = String($('#adminPasswordInput')?.value || '').trim();
        if (!reason) return showToast('Please select reversal reason', 'error');
        if (!pass) return showToast('Admin password is required', 'error');
        window.AdminModal?.close('reverseModal');
        showToast('Transaction reversed successfully', 'success');
      });

      $('#confirmFlagBtn')?.addEventListener('click', async () => {
        try {
          const txId = '<%= encodeURIComponent(rawId) %>';
          const reason = String($('#flagReasonInput')?.value || 'Suspicious Activity');
          const resp = await fetch(`/admin/transactions/${txId}/flag`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
          });
          if (!resp.ok) throw new Error('failed');
          window.AdminModal?.close('flagTransactionModal');
          showToast('Transaction flagged successfully', 'success');
        } catch (_) {
          showToast('Could not flag transaction right now', 'error');
        }
      });

      $('#confirmSuspendBtn')?.addEventListener('click', () => {
        window.AdminModal?.close('suspendUserModal');
        showToast('Sender suspended for review', 'success');
      });

      $('#deleteRecordBtn')?.addEventListener('click', () => {
        showToast('Delete action requires API wiring', 'error');
      });
    }

    animateAmount();
    setupGauge();
    setupRelatedRows();
    setupCopyGateway();
    setupDownloads();
    setupNotes();
    setupModalActions();
  })();
</script>
