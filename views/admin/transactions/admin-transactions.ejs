<%
  const rows = Array.isArray(transactions) ? transactions : [];
  const stats = summary || {};
  const pageInfo = pagination || {};
  const totalRecords = Number(pageInfo.totalTransactions || rows.length || 0);
  const pageLimit = Number(pageInfo.limit || 20);
  const currPage = Number(pageInfo.page || 1);
  const startIdx = totalRecords ? ((currPage - 1) * pageLimit + 1) : 0;
  const endIdx = Math.min(currPage * pageLimit, totalRecords);
  const volumeTotal = Number(totalAmount || 0);

  const money = (n) => `₹${Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const compactMoney = (n) => {
    const num = Number(n || 0);
    if (num >= 10000000) return `₹${(num / 10000000).toFixed(1)}Cr`;
    if (num >= 100000) return `₹${(num / 100000).toFixed(1)}L`;
    if (num >= 1000) return `₹${(num / 1000).toFixed(1)}K`;
    return `₹${num.toFixed(0)}`;
  };
%>

<section class="tx-page" id="txPage">
  <nav class="tx-breadcrumb" aria-label="Transactions Breadcrumb">
    <a href="/admin/dashboard"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right"></i>
    <span>Transactions</span>
  </nav>

  <header class="tx-header">
    <div>
      <h1>All Transactions</h1>
      <p>Monitor and manage all payment transactions</p>
    </div>
    <div class="tx-head-actions">
      <button type="button" class="tx-btn tx-btn-outline" id="exportAllBtn"><i class="fas fa-download"></i>Export</button>
      <a href="/admin/transactions/flagged" class="tx-btn tx-btn-amber"><i class="fas fa-flag"></i>Flagged</a>
      <a href="/admin/transactions/failed" class="tx-btn tx-btn-red"><i class="fas fa-times-circle"></i>Failed</a>
    </div>
  </header>

  <section class="tx-stats-grid">
    <article class="tx-stat-card delay-0">
      <span class="tx-stat-icon blue"><i class="fas fa-exchange-alt"></i></span>
      <div>
        <p>Total Today</p>
        <h3 id="statTotalToday"><%= Number(stats.totalToday || 0).toLocaleString('en-IN') %></h3>
        <span class="mini-pill">vs yesterday</span>
      </div>
    </article>

    <article class="tx-stat-card delay-1">
      <span class="tx-stat-icon green"><i class="fas fa-rupee-sign"></i></span>
      <div>
        <p>Volume Today</p>
        <h3 id="statVolumeToday"><%= compactMoney(stats.volumeToday || 0) %></h3>
        <span class="mini-pill green">+8.2%</span>
      </div>
    </article>

    <article class="tx-stat-card delay-2">
      <span class="tx-stat-icon green"><i class="fas fa-check-circle"></i></span>
      <div>
        <p>Success Rate</p>
        <h3 id="statSuccessRate" class="success-rate"><%= Number(stats.successRate || 0).toFixed(1) %>%</h3>
        <span class="mini-pill <%= Number(stats.successRate || 0) > 95 ? 'green' : 'amber' %>"><%= Number(stats.successRate || 0) > 95 ? 'Healthy' : 'Watch' %></span>
      </div>
    </article>

    <article class="tx-stat-card delay-3 alert-amber <%= Number(stats.flaggedToday || 0) > 0 ? 'with-border' : '' %>">
      <span class="tx-stat-icon amber"><i class="fas fa-flag"></i></span>
      <div>
        <p>Flagged</p>
        <h3 id="statFlagged"><span class="pulse-dot amber <%= Number(stats.flaggedToday || 0) > 0 ? '' : 'hidden' %>"></span><%= Number(stats.flaggedToday || 0).toLocaleString('en-IN') %></h3>
      </div>
    </article>

    <article class="tx-stat-card delay-4 alert-red <%= Number(stats.failedToday || 0) > 10 ? 'with-border' : '' %>">
      <span class="tx-stat-icon red"><i class="fas fa-times-circle"></i></span>
      <div>
        <p>Failed</p>
        <h3 id="statFailed"><span class="pulse-dot red <%= Number(stats.failedToday || 0) > 10 ? '' : 'hidden' %>"></span><%= Number(stats.failedToday || 0).toLocaleString('en-IN') %></h3>
      </div>
    </article>
  </section>

  <section class="tx-live-strip">
    <div class="live-left">
      <span class="live-dot"></span>
      <p>Live — transactions updating in real time</p>
    </div>
    <div class="live-center" id="liveTicker"></div>
    <button type="button" class="auto-refresh on" id="autoRefreshBtn">Auto-refresh: ON</button>
  </section>

  <section class="tx-filter-card">
    <div class="search-wrap">
      <i class="fas fa-search"></i>
      <input type="text" id="searchInput" placeholder="Search by TXN ID, user, amount, UPI ID...">
    </div>

    <select id="typeFilter" class="tx-select">
      <option value="">All Types</option>
      <option value="UPI">UPI</option>
      <option value="NEFT">NEFT</option>
      <option value="IMPS">IMPS</option>
      <option value="Card">Card</option>
      <option value="Wallet">Wallet</option>
      <option value="Refund">Refund</option>
    </select>

    <select id="statusFilter" class="tx-select">
      <option value="">All Status</option>
      <option value="success">Success</option>
      <option value="pending">Pending</option>
      <option value="failed">Failed</option>
      <option value="flagged">Flagged</option>
      <option value="refunded">Refunded</option>
      <option value="reversed">Reversed</option>
    </select>

    <select id="methodFilter" class="tx-select">
      <option value="">All Methods</option>
      <option value="UPI">UPI</option>
      <option value="Net Banking">Net Banking</option>
      <option value="Debit Card">Debit Card</option>
      <option value="Credit Card">Credit Card</option>
      <option value="Wallet">Wallet</option>
    </select>

    <div class="range-wrap">
      <input type="number" id="minAmount" class="tx-num" placeholder="Min ₹">
      <input type="number" id="maxAmount" class="tx-num" placeholder="Max ₹">
    </div>

    <div class="date-wrap">
      <input type="date" id="fromDate" class="tx-date" aria-label="From date">
      <input type="date" id="toDate" class="tx-date" aria-label="To date">
    </div>

    <select id="riskFilter" class="tx-select">
      <option value="">All Risk</option>
      <option value="low">Low</option>
      <option value="medium">Medium</option>
      <option value="high">High</option>
    </select>

    <button type="button" id="clearFilters" class="clear-link" hidden><i class="fas fa-times"></i>Clear Filters</button>
  </section>

  <section class="tx-results-bar">
    <p id="resultsText">Showing <%= startIdx %>–<%= endIdx %> of <%= totalRecords.toLocaleString('en-IN') %> transactions • Total: <strong><%= money(volumeTotal) %></strong></p>
    <div class="view-toggle" role="group" aria-label="Transactions view toggle">
      <button type="button" class="view-btn" data-view="summary"><i class="fas fa-border-all"></i>Summary</button>
      <button type="button" class="view-btn active" data-view="table"><i class="fas fa-bars"></i>Table</button>
    </div>
  </section>

  <section id="tableView" class="admin-table-wrapper tx-table-wrap">
    <table class="tx-table" id="txTable">
      <thead>
        <tr>
          <th><label class="table-check"><input type="checkbox" id="selectAllRows"><span><i class="fas fa-check"></i></span></label></th>
          <th class="sortable" data-sort="txnId">TXN ID <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="type">TYPE <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="sender">FROM <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="receiver">TO <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="amount">AMOUNT <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="method">METHOD <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="status">STATUS <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="date">DATE <i class="fas fa-sort"></i></th>
          <th class="sortable" data-sort="risk">RISK <i class="fas fa-sort"></i></th>
          <th>ACTIONS</th>
        </tr>
      </thead>
      <tbody id="txTableBody"></tbody>
    </table>
  </section>

  <section id="summaryView" class="tx-summary" hidden>
    <div class="summary-row three">
      <article class="summary-card">
        <header><h3>By Type</h3><i class="fas fa-chart-bar"></i></header>
        <div class="chart-box"><canvas id="typeChart"></canvas></div>
      </article>
      <article class="summary-card">
        <header><h3>By Status</h3><i class="fas fa-chart-pie"></i></header>
        <div class="chart-box"><canvas id="statusChart"></canvas></div>
      </article>
      <article class="summary-card">
        <header><h3>By Hour (Today)</h3><i class="fas fa-chart-line"></i></header>
        <div class="chart-box"><canvas id="hourChart"></canvas></div>
      </article>
    </div>

    <div class="summary-row two">
      <article class="summary-card">
        <header><h3><i class="fas fa-arrow-up"></i>Top Senders Today</h3></header>
        <div id="topSenders" class="rank-list"></div>
      </article>
      <article class="summary-card">
        <header><h3><i class="fas fa-arrow-down"></i>Top Receivers Today</h3></header>
        <div id="topReceivers" class="rank-list"></div>
      </article>
    </div>
  </section>

  <section class="tx-empty" id="emptyState" hidden>
    <i class="fas fa-exchange-alt"></i>
    <h3>No transactions found</h3>
    <p>Try adjusting your filters or date range</p>
    <button type="button" class="tx-btn tx-btn-outline" id="emptyClearBtn">Clear Filters</button>
  </section>

  <footer class="tx-pagination" id="paginationBar">
    <p id="paginationLeft">Showing <%= startIdx %>–<%= endIdx %> of <%= totalRecords.toLocaleString('en-IN') %> transactions - <%= money(volumeTotal) %> total</p>
    <div class="page-center" id="pageCenter"></div>
    <label class="rows-select">Rows
      <select id="rowsPerPage">
        <option value="20" selected>20</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </label>
  </footer>
</section>

<div class="bulk-action-bar" id="bulkBar" hidden>
  <p class="bulk-action-count" id="bulkCount">0 selected</p>
  <button type="button" class="bulk-action-btn bulk-action-btn-warning" id="bulkFlag"><i class="fas fa-flag"></i>Flag Selected</button>
  <button type="button" class="bulk-action-btn bulk-action-btn-light" id="bulkExport"><i class="fas fa-download"></i>Export Selected</button>
  <button type="button" class="bulk-action-btn bulk-action-btn-primary" id="bulkRefund"><i class="fas fa-undo"></i>Initiate Refund</button>
  <button type="button" class="bulk-action-btn bulk-action-btn-red" id="bulkReverse"><i class="fas fa-ban"></i>Reverse Selected</button>
</div>

<div id="initiateRefundModal" class="modal-overlay" hidden>
  <div class="modal-card tx-modal-card">
    <div class="modal-header refund-head">
      <h3><i class="fas fa-undo"></i> Initiate Refund</h3>
      <button type="button" class="modal-close-btn" data-close-modal="initiateRefundModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="tx-info-strip" id="refundInfoStrip"></div>
      <div class="form-group">
        <label class="form-label">Refund Amount</label>
        <div class="money-input-wrap">
          <i class="fas fa-rupee-sign"></i>
          <input type="number" id="refundAmount" class="admin-input" step="0.01" min="0">
        </div>
      </div>
      <div class="toggle-row">
        <span>Full Refund</span>
        <label class="switch"><input type="checkbox" id="fullRefundToggle" checked><span></span></label>
      </div>
      <div class="form-group">
        <label class="form-label">Reason</label>
        <select id="refundReason" class="admin-select">
          <option>Duplicate Payment</option>
          <option>User Request</option>
          <option>Fraud</option>
          <option>Technical Error</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Admin Note</label>
        <textarea id="refundNote" class="admin-textarea" rows="3" placeholder="Optional note..."></textarea>
      </div>
      <div class="toggle-row">
        <span>Notify User</span>
        <label class="switch"><input type="checkbox" id="refundNotifyToggle" checked><span></span></label>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="initiateRefundModal">Cancel</button>
        <button type="button" class="btn-primary-modal" id="processRefundBtn"><i class="fas fa-check"></i>Process Refund</button>
      </div>
    </div>
  </div>
</div>

<div id="flagTransactionModal" class="modal-overlay" hidden>
  <div class="modal-card tx-modal-card small">
    <div class="modal-header flag-head">
      <h3><i class="fas fa-flag"></i> Flag Transaction</h3>
      <button type="button" class="modal-close-btn" data-close-modal="flagTransactionModal"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <p class="modal-note" id="flagNoteText">You are flagging transaction for review.</p>
      <div class="form-group">
        <label class="form-label">Flag Reason</label>
        <select id="flagReason" class="admin-select">
          <option>Suspicious Activity</option>
          <option>Unusually Large Amount</option>
          <option>Multiple Failed Attempts</option>
          <option>User Reported Fraud</option>
          <option>AML Compliance Check</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Severity</label>
        <div class="severity-pills" id="severityPills">
          <button type="button" class="sev-pill" data-sev="low">Low</button>
          <button type="button" class="sev-pill active" data-sev="medium">Medium</button>
          <button type="button" class="sev-pill" data-sev="high">High</button>
          <button type="button" class="sev-pill" data-sev="critical">Critical</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Admin Note</label>
        <textarea id="flagAdminNote" class="admin-textarea" rows="3" placeholder="Add review context..."></textarea>
      </div>
      <div class="toggle-row">
        <span>Freeze User Account</span>
        <label class="switch"><input type="checkbox" id="freezeUserToggle"><span></span></label>
      </div>
      <div class="toggle-row">
        <span>Notify Compliance Team</span>
        <label class="switch"><input type="checkbox" id="notifyComplianceToggle" checked><span></span></label>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-outline-modal" data-close-modal="flagTransactionModal">Cancel</button>
        <button type="button" class="btn-primary-modal amber" id="confirmFlagBtn"><i class="fas fa-flag"></i>Flag Transaction</button>
      </div>
    </div>
  </div>
</div>

<script id="txSeedData" type="application/json"><%- JSON.stringify(rows).replace(/</g, '\\u003c') %></script>

<style>
  .tx-page { color: var(--text-main); }
  .tx-breadcrumb { margin-bottom: 12px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-soft); }
  .tx-breadcrumb a { color: var(--text-muted); }
  .tx-breadcrumb a:hover { color: var(--primary); }
  .tx-breadcrumb i { font-size: 11px; }
  .tx-breadcrumb span { color: var(--text-main); font-weight: 700; }

  .tx-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 24px; }
  .tx-header h1 { font-size: 28px; font-weight: 800; color: var(--text-main); }
  .tx-header p { margin-top: 4px; font-size: 14px; color: var(--text-soft); }

  .tx-head-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tx-btn {
    height: 42px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-muted);
    padding: 0 16px;
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: border-color var(--trans-fast), color var(--trans-fast), transform var(--trans-fast);
  }
  .tx-btn:hover { transform: translateY(-1px); }
  .tx-btn-outline:hover { border-color: var(--primary); color: var(--primary); }
  .tx-btn-amber { border-color: color-mix(in srgb, var(--amber) 45%, var(--border)); color: var(--amber-dark); }
  .tx-btn-amber:hover { background: rgba(245,158,11,0.08); }
  .tx-btn-red { border-color: color-mix(in srgb, var(--red) 45%, var(--border)); color: var(--red); }
  .tx-btn-red:hover { background: rgba(239,68,68,0.08); }

  .tx-stats-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
  .tx-stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    animation: fadeInUp .35s ease-out both;
  }
  .tx-stat-card.delay-0 { animation-delay: 0s; }
  .tx-stat-card.delay-1 { animation-delay: .05s; }
  .tx-stat-card.delay-2 { animation-delay: .10s; }
  .tx-stat-card.delay-3 { animation-delay: .15s; }
  .tx-stat-card.delay-4 { animation-delay: .20s; }
  .tx-stat-card.with-border.alert-amber { border-left: 3px solid var(--amber); }
  .tx-stat-card.with-border.alert-red { border-left: 3px solid var(--red); }

  .tx-stat-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .tx-stat-icon.blue { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); }
  .tx-stat-icon.green { background: linear-gradient(135deg, var(--green), var(--green-dark)); }
  .tx-stat-icon.amber { background: linear-gradient(135deg, var(--amber), var(--amber-dark)); }
  .tx-stat-icon.red { background: linear-gradient(135deg, var(--red), var(--red-dark)); }

  .tx-stat-card p { font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: var(--text-soft); font-weight: 700; }
  .tx-stat-card h3 { margin-top: 2px; font-size: 24px; font-weight: 800; color: var(--text-main); display: inline-flex; align-items: center; gap: 6px; }
  .mini-pill {
    margin-top: 4px;
    border-radius: 9999px;
    padding: 3px 8px;
    display: inline-flex;
    font-size: 10px;
    font-weight: 700;
    color: var(--text-soft);
    background: var(--border-light);
  }
  .mini-pill.green { color: var(--green-dark); background: color-mix(in srgb, var(--green) 12%, var(--card-bg)); }
  .mini-pill.amber { color: var(--amber-dark); background: color-mix(in srgb, var(--amber) 14%, var(--card-bg)); }
  .pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    display: inline-block;
    animation: pulse 2s infinite;
  }
  .pulse-dot.hidden { display: none; }
  .pulse-dot.amber { background: var(--amber); }
  .pulse-dot.red { background: var(--red); }

  .tx-live-strip {
    margin-bottom: 20px;
    border-radius: var(--r-md);
    border: 1px solid rgba(16,185,129,.25);
    background: rgba(16,185,129,.05);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .live-left { display: inline-flex; align-items: center; gap: 8px; }
  .live-dot { width: 8px; height: 8px; border-radius: 9999px; background: var(--green); animation: pulse 2s infinite; }
  .live-left p { color: var(--green-dark); font-size: 13px; font-weight: 600; }

  .live-center { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .live-pill {
    border: 1px solid color-mix(in srgb, var(--green) 30%, var(--border));
    border-radius: 9999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: var(--green-dark);
    background: #fff;
  }

  .auto-refresh {
    height: 30px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: #fff;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-soft);
  }
  .auto-refresh.on { border-color: color-mix(in srgb, var(--green) 40%, var(--border)); color: var(--green-dark); background: color-mix(in srgb, var(--green) 10%, var(--card-bg)); }

  .tx-filter-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-sm);
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .search-wrap { position: relative; min-width: 280px; flex: 1; }
  .search-wrap i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-soft); }
  .search-wrap input,
  .tx-select,
  .tx-num,
  .tx-date {
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 14px;
    color: var(--text-main);
    background: var(--card-bg);
    transition: border-color var(--trans-fast), box-shadow var(--trans-fast);
  }
  .search-wrap input { width: 100%; padding: 0 14px 0 40px; }
  .tx-select { min-width: 150px; padding: 0 12px; }
  .range-wrap, .date-wrap { display: inline-flex; align-items: center; gap: 8px; }
  .tx-num { width: 100px; border-radius: var(--r-sm); padding: 0 10px; }
  .tx-date { border-radius: var(--r-sm); padding: 0 10px; }
  .clear-link { border: 0; background: transparent; color: var(--text-soft); font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
  .clear-link:hover { color: var(--red); }

  .search-wrap input:focus,
  .tx-select:focus,
  .tx-num:focus,
  .tx-date:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 14%, transparent);
  }

  .tx-results-bar { margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .tx-results-bar p { font-size: 13px; color: var(--text-soft); }
  .tx-results-bar p strong { color: var(--green-dark); font-weight: 700; }

  .view-toggle { border: 1px solid var(--border); border-radius: 9999px; background: var(--card-bg); padding: 2px; display: inline-flex; }
  .view-btn {
    border: 0;
    background: transparent;
    height: 30px;
    border-radius: 9999px;
    color: var(--text-soft);
    font-size: 12px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .view-btn.active { color: #fff; background: var(--primary); }

  .tx-table-wrap { background: var(--card-bg); margin-bottom: 16px; }
