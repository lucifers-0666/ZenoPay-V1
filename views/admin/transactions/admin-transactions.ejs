  .amount { font-size: 15px; font-weight: 800; }
  .amount.debit { color: var(--red); }
  .amount.credit { color: var(--green-dark); }
  .amount.refund { color: var(--amber-dark); }

  .method-main { font-size: 13px; color: var(--text-muted); display: inline-flex; align-items: center; gap: 6px; }

  .status-pill {
    border-radius: 9999px;
    padding: 5px 10px;
