  }
  .status-pill.success { color: var(--green-dark); background: color-mix(in srgb, var(--green) 12%, var(--card-bg)); }
  .status-pill.pending { color: var(--amber-dark); background: color-mix(in srgb, var(--amber) 14%, var(--card-bg)); }
  .status-pill.failed { color: var(--red); background: color-mix(in srgb, var(--red) 12%, var(--card-bg)); }
  .status-pill.flagged { color: var(--amber-dark); background: rgba(245,158,11,.18); }
  .status-pill.refunded { color: var(--primary-dark); background: color-mix(in srgb, var(--primary) 13%, var(--card-bg)); }
  .status-pill.reversed { color: var(--text-muted); background: color-mix(in srgb, var(--text-soft) 13%, var(--card-bg)); }

  .risk-wrap { display: inline-flex; align-items: center; gap: 7px; }
  .risk-bar { width: 60px; height: 6px; border-radius: 9999px; background: var(--border-light); overflow: hidden; }
  .risk-fill { height: 100%; border-radius: 9999px; }
  .risk-fill.low { background: var(--green); }
  .risk-fill.medium { background: var(--amber); }
  .risk-fill.high { background: var(--red); }
  .risk-warn { color: var(--amber); }
  .risk-score { font-size: 12px; font-weight: 700; }
