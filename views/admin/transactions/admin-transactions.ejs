  }
  .table-check span i { font-size: 10px; }
  .table-check input:checked + span { background: var(--primary); border-color: var(--primary); color: #fff; }

  .sortable { cursor: pointer; }
  .sortable.active, .sortable.active i { color: var(--primary); }

  .txn-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--primary); font-size: 13px; font-weight: 700; }
  .subtext { margin-top: 3px; font-size: 11px; color: var(--text-soft); }

  .type-cell { display: inline-flex; align-items: center; gap: 8px; }
  .type-icon {
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
  }
  .type-icon.upi { color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, var(--card-bg)); }
  .type-icon.neft { color: var(--secondary-dark); background: color-mix(in srgb, var(--secondary) 12%, var(--card-bg)); }
  .type-icon.card { color: var(--text-muted); background: color-mix(in srgb, var(--text-soft) 12%, var(--card-bg)); }
  .type-icon.refund { color: var(--amber-dark); background: color-mix(in srgb, var(--amber) 13%, var(--card-bg)); }
  .type-icon.wallet { color: var(--green-dark); background: color-mix(in srgb, var(--green) 12%, var(--card-bg)); }

  .entity-cell { display: flex; align-items: center; gap: 9px; }
  .entity-avatar {
    width: 32px;
