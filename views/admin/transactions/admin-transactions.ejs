    color: var(--text-mid);
  }
  .tx-table tbody tr { transition: background var(--trans-fast); animation: fadeInUp .2s ease-out both; }
  .tx-table tbody tr:hover { background: #FAFBFF; cursor: pointer; }
  .tx-table tbody tr.flagged { background: rgba(245,158,11,0.05); box-shadow: inset 3px 0 0 var(--amber); }
  .tx-table tbody tr.failed { background: rgba(239,68,68,0.04); }

  .table-check { display: inline-flex; }
