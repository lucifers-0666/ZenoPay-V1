<%
  const currentAdminPage = typeof adminPage !== 'undefined' ? adminPage : 'users';
  page = currentAdminPage;
%>

<section class="users-page" id="usersPage">
  <nav class="users-crumb" aria-label="Breadcrumb">
    <a href="/admin/dashboard" class="users-crumb-link"><i class="fas fa-home"></i><span>Admin</span></a>
    <i class="fas fa-chevron-right users-crumb-sep"></i>
    <span class="users-crumb-current">User Management</span>
  </nav>

  <header class="users-title-row">
    <div>
      <h1 class="users-title">User Management</h1>
      <p class="users-subtitle">Manage all registered ZenoPay users</p>
    </div>
    <div class="users-title-actions">
      <button class="users-btn users-btn-primary" id="openAddUserModal" type="button"><i class="fas fa-plus"></i><span>Add User</span></button>
      <button class="users-btn users-btn-outline" id="exportCsvBtn" type="button"><i class="fas fa-download"></i><span>Export CSV</span></button>
    </div>
  </header>

  <section class="users-stats-strip">
    <article class="users-stat-card users-stat-delay-0">
      <div class="users-stat-icon users-stat-icon-blue"><i class="fas fa-users"></i></div>
      <div class="users-stat-body">
        <p class="users-stat-label">Total Users</p>
        <h3 class="users-stat-value">24,583</h3>
        <span class="users-trend users-trend-up"><i class="fas fa-arrow-up"></i>+12.5%</span>
      </div>
    </article>

    <article class="users-stat-card users-stat-delay-1">
      <div class="users-stat-icon users-stat-icon-green"><i class="fas fa-user-check"></i></div>
      <div class="users-stat-body">
        <p class="users-stat-label">Verified (KYC)</p>
        <h3 class="users-stat-value">18,240</h3>
        <span class="users-trend users-trend-up"><i class="fas fa-arrow-up"></i>+8.1%</span>
      </div>
    </article>

    <article class="users-stat-card users-stat-delay-2">
      <div class="users-stat-icon users-stat-icon-amber"><i class="fas fa-user-clock"></i></div>
      <div class="users-stat-body">
        <p class="users-stat-label">Pending KYC</p>
        <h3 class="users-stat-value">3,891</h3>
        <span class="users-trend users-trend-neutral">Count only</span>
      </div>
    </article>

    <article class="users-stat-card users-stat-delay-3">
      <div class="users-stat-icon users-stat-icon-red"><i class="fas fa-user-times"></i></div>
      <div class="users-stat-body">
        <p class="users-stat-label">Suspended</p>
        <h3 class="users-stat-value">124</h3>
        <span class="users-trend users-trend-neutral">Count only</span>
      </div>
    </article>

    <article class="users-stat-card users-stat-delay-4">
      <div class="users-stat-icon users-stat-icon-purple"><i class="fas fa-user-plus"></i></div>
      <div class="users-stat-body">
        <p class="users-stat-label">New Today</p>
        <h3 class="users-stat-value">47</h3>
        <span class="users-trend users-trend-neutral">+5 from yesterday</span>
      </div>
    </article>
  </section>

  <section class="users-filter-card">
    <div class="users-search-wrap">
      <i class="fas fa-search users-search-icon"></i>
      <input id="userSearchInput" class="users-search-input" type="text" placeholder="Search by name, email, phone, user ID..." />
    </div>

    <select id="statusFilter" class="users-select-pill" aria-label="Status filter">
      <option value="">All Status</option>
      <option value="active">Active</option>
      <option value="suspended">Suspended</option>
      <option value="pending kyc">Pending KYC</option>
      <option value="unverified">Unverified</option>
    </select>

    <select id="kycFilter" class="users-select-pill" aria-label="KYC filter">
      <option value="">All KYC</option>
      <option value="verified">Verified</option>
      <option value="pending">Pending</option>
      <option value="rejected">Rejected</option>
      <option value="not submitted">Not Submitted</option>
    </select>

    <div class="users-date-wrap">
      <label class="users-date-input-wrap"><i class="fas fa-calendar-alt"></i><input id="fromDate" class="users-date-input" type="date" aria-label="From date" /></label>
      <label class="users-date-input-wrap"><i class="fas fa-calendar-alt"></i><input id="toDate" class="users-date-input" type="date" aria-label="To date" /></label>
    </div>

    <button id="clearFiltersBtn" class="users-clear-filters" type="button" hidden><i class="fas fa-times"></i><span>Clear Filters</span></button>
  </section>

  <section class="users-results-bar">
    <p class="users-results-text" id="resultsMeta">Showing 1–20 of 24,583 users</p>
    <div class="users-results-controls">
      <button class="users-mini-btn" type="button"><i class="fas fa-columns"></i><span>Columns</span></button>
      <div class="users-view-switch" role="group" aria-label="View mode">
        <button class="users-view-btn" type="button" aria-pressed="false"><i class="fas fa-th-large"></i><span>Grid</span></button>
        <button class="users-view-btn active" type="button" aria-pressed="true"><i class="fas fa-list"></i><span>Table</span></button>
      </div>
    </div>
  </section>

  <section class="users-table-shell">
    <table class="users-table" id="usersTable">
      <thead>
        <tr>
          <th class="users-col-checkbox"><label class="users-checkbox"><input id="selectAllUsers" type="checkbox"><span class="users-checkbox-ui"><i class="fas fa-check"></i></span></label></th>
          <th class="users-sortable active" data-sort="name">USER <i class="fas fa-sort"></i></th>
          <th class="users-sortable" data-sort="contact">CONTACT <i class="fas fa-sort"></i></th>
          <th>KYC</th>
          <th>ROLE</th>
          <th class="users-align-right users-sortable" data-sort="balance">BALANCE <i class="fas fa-sort"></i></th>
          <th>STATUS</th>
          <th class="users-sortable" data-sort="joined">JOINED <i class="fas fa-sort"></i></th>
          <th>ACTIONS</th>
        </tr>
      </thead>
      <tbody id="usersTableBody"></tbody>
      <tbody id="usersSkeletonBody" hidden>
        <tr>
          <td><div class="skeleton users-skeleton-check"></div></td>
          <td><div class="skeleton users-skeleton-wide"></div><div class="skeleton users-skeleton-mid"></div></td>
          <td><div class="skeleton users-skeleton-wide"></div><div class="skeleton users-skeleton-mid"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-mid users-align-right"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-mid"></div><div class="skeleton users-skeleton-small"></div></td>
          <td><div class="skeleton users-skeleton-actions"></div></td>
        </tr>
        <tr>
          <td><div class="skeleton users-skeleton-check"></div></td>
          <td><div class="skeleton users-skeleton-wide"></div><div class="skeleton users-skeleton-mid"></div></td>
          <td><div class="skeleton users-skeleton-wide"></div><div class="skeleton users-skeleton-mid"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-mid users-align-right"></div></td>
          <td><div class="skeleton users-skeleton-pill"></div></td>
          <td><div class="skeleton users-skeleton-mid"></div><div class="skeleton users-skeleton-small"></div></td>
          <td><div class="skeleton users-skeleton-actions"></div></td>
        </tr>
      </tbody>
    </table>

    <div class="users-empty" id="usersEmpty" hidden>
      <i class="fas fa-users users-empty-icon"></i>
      <h3 class="users-empty-title">No users found</h3>
      <p class="users-empty-subtitle">Try adjusting your filters or search term</p>
      <button id="clearFiltersEmptyBtn" class="users-btn users-btn-outline" type="button">Clear All Filters</button>
    </div>

    <footer class="users-pagination-wrap">
      <p class="users-pagination-meta" id="paginationMeta">Showing 1–20 of 24,583 users</p>
      <div class="users-pagination-center" id="paginationCenter"></div>
      <label class="users-rows-wrap">Show:
        <select id="rowsPerPage" class="users-rows-select">
          <option value="10">10</option>
          <option value="20" selected>20</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </label>
    </footer>
  </section>
</section>

<div class="bulk-action-bar" id="bulkActionBar" hidden>
  <p class="bulk-action-count" id="bulkActionCount">0 users selected</p>
  <button class="bulk-action-btn bulk-action-btn-light" type="button">Export Selected</button>
  <button class="bulk-action-btn bulk-action-btn-primary" type="button">Send Notification</button>
  <button class="bulk-action-btn bulk-action-btn-amber" type="button">Suspend Selected</button>
  <button class="bulk-action-btn bulk-action-btn-red" type="button">Delete Selected</button>
  <button class="bulk-action-close" id="bulkActionClose" type="button" aria-label="Dismiss"><i class="fas fa-times"></i></button>
</div>

<div id="addUserModal" class="modal-overlay" style="display:none;">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="addUserTitle">
    <div class="modal-header">
      <div>
        <h2 id="addUserTitle" class="modal-title">Add New User</h2>
        <p class="modal-subtitle">Create a manual user account</p>
      </div>
      <button type="button" id="closeAddUserModal" class="modal-close-btn" aria-label="Close modal"><i class="fas fa-times"></i></button>
    </div>

    <form id="addUserForm" class="modal-body">
      <label class="users-field-wrap"><span>Full Name</span><div class="users-field-input-wrap"><i class="fas fa-user"></i><input name="fullName" type="text" required /></div></label>
      <label class="users-field-wrap"><span>Email Address</span><div class="users-field-input-wrap"><i class="fas fa-envelope"></i><input name="email" type="email" required /></div></label>
      <label class="users-field-wrap"><span>Phone Number</span><div class="users-field-input-wrap"><i class="fas fa-phone"></i><input name="phone" type="tel" required /></div></label>

      <div class="users-field-grid">
        <label class="users-field-wrap"><span>Role</span>
          <select class="users-field-select" name="role" required>
            <option>User</option>
            <option>Merchant</option>
            <option>Admin</option>
          </select>
        </label>

        <label class="users-field-wrap"><span>KYC Status</span>
          <select class="users-field-select" name="kycStatus" required>
            <option>Not Submitted</option>
            <option>Verified</option>
            <option>Pending</option>
          </select>
        </label>
      </div>

      <label class="users-field-wrap"><span>Initial Password</span>
        <div class="users-field-input-wrap">
          <i class="fas fa-lock"></i>
          <input id="passwordField" name="password" type="password" required />
          <button type="button" class="users-password-toggle" id="passwordToggle"><i class="fas fa-eye"></i></button>
        </div>
      </label>

      <label class="users-toggle-wrap">
        <span>Send Welcome Email</span>
        <span class="users-toggle users-toggle-on"><span class="users-toggle-knob"></span></span>
      </label>

      <div class="modal-footer">
        <button type="button" id="cancelAddUser" class="btn-outline-modal">Cancel</button>
        <button type="submit" class="btn-primary-modal"><i class="fas fa-check"></i><span>Create User</span></button>
      </div>
    </form>
  </div>
</div>

<style>
  .users-page { color: var(--text-main); }

  .users-crumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--text-soft);
  }
  .users-crumb-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color var(--trans-fast);
  }
  .users-crumb-link:hover { color: var(--primary); }
  .users-crumb-current { color: var(--text-muted); font-weight: 600; }
  .users-crumb-sep { font-size: 11px; }

  .users-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .users-title { font-size: 28px; font-weight: 800; color: var(--text-main); line-height: 1.15; }
  .users-subtitle { margin-top: 4px; font-size: 14px; color: var(--text-muted); }

  .users-title-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .users-btn {
    height: 42px;
    border-radius: 9999px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: all var(--trans-fast);
    border: 1px solid transparent;
  }
  .users-btn i { font-size: 13px; }
  .users-btn-primary {
    color: var(--card-bg);
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    box-shadow: var(--shadow-sm);
  }
  .users-btn-primary:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .users-btn-outline {
    color: var(--text-muted);
    border-color: var(--border);
    background: var(--card-bg);
  }
  .users-btn-outline:hover { color: var(--primary); border-color: var(--primary); }

  .users-stats-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .users-stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 22px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform var(--trans-fast), box-shadow var(--trans-fast);
    animation: fadeInUp 0.3s ease-out both;
  }
  .users-stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .users-stat-delay-0 { animation-delay: 0s; }
  .users-stat-delay-1 { animation-delay: 0.05s; }
  .users-stat-delay-2 { animation-delay: 0.10s; }
  .users-stat-delay-3 { animation-delay: 0.15s; }
  .users-stat-delay-4 { animation-delay: 0.20s; }

  .users-stat-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--card-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .users-stat-icon i { font-size: 20px; }
  .users-stat-icon-blue { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); }
  .users-stat-icon-green { background: linear-gradient(135deg, var(--green), var(--green-dark)); }
  .users-stat-icon-amber { background: linear-gradient(135deg, var(--amber), var(--amber-dark)); }
  .users-stat-icon-red { background: linear-gradient(135deg, var(--red), var(--red-dark)); }
  .users-stat-icon-purple { background: linear-gradient(135deg, var(--secondary), var(--secondary-dark)); }

  .users-stat-label {
    font-size: 12px;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .users-stat-value {
    margin-top: 4px;
    font-size: 26px;
    color: var(--text-main);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .users-trend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 7px;
    border-radius: 9999px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
  }
  .users-trend-up {
    color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, var(--card-bg));
  }
  .users-trend-up i { font-size: 10px; }
  .users-trend-neutral {
    color: var(--text-muted);
    background: color-mix(in srgb, var(--text-soft) 10%, var(--card-bg));
  }

  .users-filter-card {
    margin-bottom: 20px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .users-search-wrap { position: relative; flex: 1; min-width: 280px; }
  .users-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-soft);
    font-size: 14px;
    pointer-events: none;
  }
  .users-search-input,
  .users-select-pill {
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--card-bg);
    color: var(--text-main);
    font-size: 14px;
    transition: border-color var(--trans-fast), box-shadow var(--trans-fast);
  }
  .users-search-input {
    width: 100%;
    padding: 0 16px 0 42px;
  }
  .users-search-input::placeholder { color: var(--text-soft); }
  .users-search-input:focus,
  .users-select-pill:focus,
  .users-date-input:focus,
  .users-field-input-wrap input:focus,
  .users-field-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent);
  }
  .users-select-pill { min-width: 160px; padding: 0 16px; }

  .users-date-wrap { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .users-date-input-wrap {
    height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    background: var(--card-bg);
  }
  .users-date-input { border: 0; background: transparent; color: var(--text-main); }

  .users-clear-filters {
    border: 0;
    background: transparent;
    color: var(--text-soft);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    transition: color var(--trans-fast);
  }
  .users-clear-filters:hover { color: var(--red); }

  .users-results-bar {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .users-results-text { font-size: 13px; color: var(--text-soft); }
  .users-results-controls { display: inline-flex; align-items: center; gap: 10px; }
  .users-mini-btn {
    height: 34px;
    padding: 0 12px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--card-bg);
    font-size: 12px;
    font-weight: 600;
  }
  .users-view-switch {
    border: 1px solid var(--border);
    background: var(--card-bg);
    border-radius: 9999px;
    padding: 2px;
    display: inline-flex;
  }
  .users-view-btn {
    border: 0;
    height: 30px;
    padding: 0 10px;
    border-radius: 9999px;
    color: var(--text-soft);
    background: transparent;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .users-view-btn.active { background: var(--primary); color: var(--card-bg); }

  .users-table-shell {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .users-table { width: 100%; border-collapse: collapse; }
  .users-table thead th {
    background: var(--bg-page);
    border-bottom: 1px solid var(--border);
    padding: 13px 20px;
    color: var(--text-soft);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-align: left;
    white-space: nowrap;
  }
  .users-col-checkbox { width: 44px; }
  .users-sortable {
    cursor: pointer;
    transition: color var(--trans-fast);
  }
  .users-sortable i { margin-left: 4px; font-size: 12px; color: var(--text-soft); }
  .users-sortable.active,
  .users-sortable.active i { color: var(--primary); }

  .users-table tbody tr {
    border-bottom: 1px solid var(--border-light);
    transition: background var(--trans-fast);
    animation: fadeInUp 0.2s ease-out both;
  }
  .users-table tbody tr:hover { background: color-mix(in srgb, var(--primary) 4%, var(--card-bg)); }
  .users-table tbody tr.users-row-selected {
    background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
    box-shadow: inset 3px 0 0 var(--primary);
  }
  .users-table tbody td { padding: 16px 20px; vertical-align: middle; }
  .users-align-right { text-align: right; }

  .users-checkbox { display: inline-flex; align-items: center; }
  .users-checkbox input { position: absolute; opacity: 0; pointer-events: none; }
  .users-checkbox-ui {
    width: 18px;
    height: 18px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    background: var(--card-bg);
    transition: all var(--trans-fast);
  }
  .users-checkbox-ui i { font-size: 10px; }
  .users-checkbox input:checked + .users-checkbox-ui {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--card-bg);
  }

  .users-cell-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .users-avatar {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--card-bg);
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .users-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .users-avatar-grad-0 { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); }
  .users-avatar-grad-1 { background: linear-gradient(135deg, var(--green), var(--green-dark)); }
  .users-avatar-grad-2 { background: linear-gradient(135deg, var(--secondary), var(--secondary-dark)); }
  .users-avatar-grad-3 { background: linear-gradient(135deg, var(--amber), var(--amber-dark)); }
  .users-avatar-grad-4 { background: linear-gradient(135deg, var(--red), var(--red-dark)); }
  .users-avatar-grad-5 { background: linear-gradient(135deg, var(--text-muted), var(--text-mid)); }

  .users-user-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
