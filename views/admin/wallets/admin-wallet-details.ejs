<%
  const walletObj = wallet || {};
  const userObj = walletObj.userId || {};
  const userId = userObj?._id || walletObj?.userId?._id || "";
  const userName = userObj?.name || userObj?.FullName || "Unknown User";
  const userEmail = userObj?.email || userObj?.Email || "—";
  const userPhone = userObj?.phone || userObj?.Mobile || "—";
  const walletIdText = walletObj?.walletId || walletObj?._id || "N/A";
  const statusRaw = String(walletObj?.status || "active").toLowerCase();
  const statusLabel = statusRaw?.charAt(0).toUpperCase() + statusRaw?.slice(1);
  const balance = Number(walletObj?.balance || 0);
  const totalCredit = Number(walletObj?.totalCredit || 0);
  const totalDebit = Number(walletObj?.totalDebit || 0);
  const txList = Array.isArray(transactions) ? transactions : [];
  const totalTransactions = txList?.length || 0;

  const createdAt = walletObj?.createdAt ? new Date(walletObj?.createdAt) : null;
  const updatedAt = walletObj?.updatedAt ? new Date(walletObj?.updatedAt) : null;
  const memberSince = (userObj?.createdAt || userObj?.RegistrationDate) ? new Date(userObj?.createdAt || userObj?.RegistrationDate) : null;

  const initials = String(userName || "U")
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s?.charAt(0)?.toUpperCase())
    .join("") || "U";

  const lastTxAt = txList?.[0]?.createdAt ? new Date(txList?.[0]?.createdAt) : null;
  const walletAgeDays = createdAt ? Math.max(1, Math.floor((Date.now() - createdAt.getTime()) / 86400000)) : 0;
%>

<style>
  .wallet-details-page { display: grid; gap: 16px; }
  .wallet-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 18px;
  }

  .wallet-head-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .wallet-page-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-dark);
  }
  .wallet-title-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--card-bg);
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  }
  .wallet-breadcrumb {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-soft);
  }
  .wallet-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-chip {
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-dark);
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 700;
  }
  .btn-chip.primary { border-color: var(--primary); color: var(--primary); }
  .btn-chip.purple { border-color: #8B5CF6; color: #8B5CF6; }
  .btn-chip.danger { border-color: var(--danger); color: var(--danger); }

  .identity-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 18px;
  }
  .user-meta { display: flex; gap: 14px; align-items: flex-start; }
  .user-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 14%, var(--card-bg));
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 800;
    flex-shrink: 0;
  }
  .user-title { font-size: 1.1rem; font-weight: 800; color: var(--text-dark); }
  .meta-line { margin-top: 6px; color: var(--text-soft); font-size: 13px; display: flex; gap: 8px; align-items: center; }
  .profile-link { margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--primary); }

  .wallet-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .info-box {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 10px 12px;
    background: var(--card-bg);
  }
  .info-label { font-size: 11px; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.06em; }
  .info-value { margin-top: 4px; font-size: 14px; font-weight: 700; color: var(--text-dark); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

  .copy-id-wrap { display: inline-flex; align-items: center; gap: 8px; }
  .copy-id-btn {
    border: 0;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 13px;
  }
  .copy-tip { font-size: 11px; color: var(--success); visibility: hidden; }
  .copy-tip.show { visibility: visible; }

  .status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid var(--border);
  }
  .status-active { color: var(--success); background: color-mix(in srgb, var(--success) 14%, var(--card-bg)); border-color: color-mix(in srgb, var(--success) 24%, var(--border)); }
  .status-frozen { color: var(--primary); background: color-mix(in srgb, var(--primary) 14%, var(--card-bg)); border-color: color-mix(in srgb, var(--primary) 24%, var(--border)); }
  .status-suspended { color: var(--danger); background: color-mix(in srgb, var(--danger) 14%, var(--card-bg)); border-color: color-mix(in srgb, var(--danger) 24%, var(--border)); }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .stat-tile {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    padding: 14px;
  }
  .stat-top { color: var(--text-soft); font-size: 12px; display: inline-flex; gap: 7px; align-items: center; }
  .stat-num { margin-top: 8px; font-size: 1.2rem; font-weight: 800; color: var(--text-dark); }
  .num-green { color: var(--success); }
  .num-red { color: var(--danger); }
  .num-blue { color: var(--primary); }

  .two-col {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 12px;
  }
  .card-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .card-title h3 {
    margin: 0;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--text-dark);
    font-size: 15px;
    font-weight: 800;
  }

  .tx-table-wrap { overflow: auto; }
  .tx-table { width: 100%; border-collapse: collapse; }
  .tx-table th, .tx-table td {
    border-bottom: 1px solid var(--border);
    padding: 10px;
    font-size: 12px;
    color: var(--text-dark);
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }
  .tx-table th { color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.06em; font-size: 11px; }
  .tx-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--primary); }
  .tx-type { border-radius: 999px; padding: 2px 8px; font-size: 11px; font-weight: 700; border: 1px solid var(--border); }
  .type-credit { color: var(--success); background: color-mix(in srgb, var(--success) 10%, var(--card-bg)); }
  .type-debit { color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, var(--card-bg)); }
  .type-transfer { color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, var(--card-bg)); }
  .tx-amount.credit { color: var(--success); font-weight: 700; }
  .tx-amount.debit { color: var(--danger); font-weight: 700; }

  .empty-state {
    min-height: 150px;
    display: grid;
    place-items: center;
    color: var(--text-soft);
    text-align: center;
    gap: 8px;
  }
  .tx-footer-link { margin-top: 10px; display: inline-flex; gap: 6px; align-items: center; color: var(--primary); font-size: 13px; font-weight: 700; }

  .mini-list { display: grid; gap: 8px; margin-bottom: 10px; }
  .mini-item { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--text-soft); }
  .mini-item strong { color: var(--text-dark); }
  .chart-wrap { position: relative; height: 180px; width: 100%; }

  .notes-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: start; }
  .notes-textarea {
    width: 100%;
    min-height: 96px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 10px;
    background: var(--card-bg);
    color: var(--text-dark);
  }
  .btn-note {
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--card-bg);
    padding: 0 16px;
    font-weight: 700;
  }
  .notes-list { margin-top: 12px; display: grid; gap: 8px; }
  .note-item { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 10px; background: var(--card-bg); }
  .note-head { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-soft); }
  .note-body { margin-top: 6px; font-size: 13px; color: var(--text-dark); }

  .danger-zone {
    border: 1px solid rgba(239,68,68,0.2);
    background: rgba(239,68,68,0.04);
  }
  .danger-row {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 12px;
    background: var(--card-bg);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
  }
  .danger-row + .danger-row { margin-top: 10px; }
  .danger-meta h4 { margin: 0; color: var(--text-dark); font-size: 14px; }
  .danger-meta p { margin: 4px 0 0; color: var(--text-soft); font-size: 12px; }
  .btn-danger-outline, .btn-warn-outline, .btn-red {
    height: 34px; border-radius: 999px; padding: 0 14px; display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700;
  }
  .btn-danger-outline { border: 1px solid var(--primary); color: var(--primary); background: transparent; }
  .btn-warn-outline { border: 1px solid var(--warning); color: var(--warning); background: transparent; }
  .btn-red { border: 1px solid var(--danger); background: var(--danger); color: var(--card-bg); }

  .modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.42); display: grid; place-items: center; z-index: 600; }
  .modal-card {
    width: min(560px, calc(100vw - 24px));
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .modal-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; background: var(--primary); color: var(--card-bg); padding: 14px; }
  .modal-title { margin: 0; font-size: 15px; font-weight: 800; display: inline-flex; gap: 8px; align-items: center; }
  .modal-sub { margin-top: 4px; font-size: 12px; opacity: 0.9; }
  .modal-close { background: transparent; border: 0; color: var(--card-bg); font-size: 18px; cursor: pointer; }
  .modal-body { padding: 14px; display: grid; gap: 10px; }
  .modal-footer { display: flex; justify-content: flex-end; gap: 8px; }
  .warn-card { border: 1px solid color-mix(in srgb, var(--danger) 35%, var(--border)); background: color-mix(in srgb, var(--danger) 8%, var(--card-bg)); border-radius: var(--radius-lg); padding: 10px; color: var(--danger); font-size: 13px; }
  .field { display: grid; gap: 6px; }
  .field label { font-size: 12px; color: var(--text-soft); }
  .field input, .field textarea, .field select {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 9px 10px;
    background: var(--card-bg);
    color: var(--text-dark);
  }
  .field textarea { min-height: 88px; }
  .toggle-group { display: flex; gap: 8px; }
  .toggle-pill { position: relative; }
  .toggle-pill input { position: absolute; opacity: 0; }
  .toggle-pill span {
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--border);
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    color: var(--text-soft);
    font-size: 12px;
    font-weight: 700;
  }
  .toggle-pill input:checked + span { color: var(--primary); border-color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, var(--card-bg)); }

  @media (max-width: 1100px) {
    .identity-grid,
    .two-col,
    .stats-strip {
      grid-template-columns: 1fr;
    }
    .notes-form { grid-template-columns: 1fr; }
  }
</style>

<div class="wallet-details-page">
  <section class="wallet-card">
    <div class="wallet-head-top">
      <div>
        <a href="/admin/wallets" class="btn-chip"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to Wallets</a>
        <h1 class="wallet-page-title" style="margin-top: 10px;">
          <span class="wallet-title-icon"><i class="fas fa-wallet" aria-hidden="true"></i></span>
          Wallet Details
        </h1>
        <nav class="wallet-breadcrumb" aria-label="Breadcrumb">
          <span><i class="fas fa-home" aria-hidden="true"></i> Home</span>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span>Wallets</span>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span class="mono"><%= walletIdText %></span>
        </nav>
      </div>

      <div class="wallet-actions">
        <% if (statusRaw === 'frozen') { %>
          <button type="button" class="btn-chip primary" data-open-modal="freezeWalletModal" data-action-mode="unfreeze"><i class="fas fa-fire" aria-hidden="true"></i>Unfreeze</button>
        <% } else if (statusRaw !== 'suspended') { %>
          <button type="button" class="btn-chip primary" data-open-modal="freezeWalletModal" data-action-mode="freeze"><i class="fas fa-snowflake" aria-hidden="true"></i>Freeze</button>
        <% } %>
        <button type="button" class="btn-chip purple" data-open-modal="adjustBalanceModal"><i class="fas fa-indian-rupee-sign" aria-hidden="true"></i>Adjust Balance</button>
        <% if (statusRaw !== 'suspended') { %>
          <button type="button" class="btn-chip danger" data-open-modal="suspendWalletModal"><i class="fas fa-ban" aria-hidden="true"></i>Suspend</button>
        <% } %>
      </div>
    </div>
  </section>

  <section class="wallet-card identity-grid">
    <article>
      <div class="user-meta">
        <span class="user-avatar"><%= initials %></span>
        <div>
          <h2 class="user-title"><%= userName %></h2>
          <p class="meta-line"><i class="fas fa-envelope" aria-hidden="true"></i><%= userEmail %></p>
          <p class="meta-line"><i class="fas fa-phone" aria-hidden="true"></i><%= userPhone %></p>
          <p class="meta-line"><i class="fas fa-calendar" aria-hidden="true"></i>Member since <%= memberSince ? memberSince.toLocaleDateString('en-IN') : '—' %></p>
          <a class="profile-link" href="/admin/users/<%= userId || '' %>"><i class="fas fa-user" aria-hidden="true"></i>View User Profile</a>
        </div>
      </div>
    </article>

    <article class="wallet-info-grid">
      <div class="info-box">
        <span class="info-label">Wallet ID</span>
        <div class="info-value mono copy-id-wrap">
          <span id="walletIdText"><%= walletIdText %></span>
          <button type="button" id="copyWalletIdBtn" class="copy-id-btn" aria-label="Copy wallet id"><i class="fas fa-copy" aria-hidden="true"></i></button>
          <span id="copyWalletTip" class="copy-tip">Copied!</span>
        </div>
      </div>
      <div class="info-box">
        <span class="info-label">Status</span>
        <div class="info-value">
          <span class="status-pill <%= statusRaw === 'active' ? 'status-active' : (statusRaw === 'frozen' ? 'status-frozen' : 'status-suspended') %>" id="walletStatusBadge"><%= statusLabel %></span>
        </div>
      </div>
      <div class="info-box">
        <span class="info-label">Created At</span>
        <div class="info-value"><%= createdAt ? createdAt.toLocaleString('en-IN') : '—' %></div>
      </div>
      <div class="info-box">
        <span class="info-label">Last Updated</span>
        <div class="info-value"><%= updatedAt ? updatedAt.toLocaleString('en-IN') : '—' %></div>
      </div>
    </article>
  </section>

  <section class="stats-strip">
    <article class="stat-tile">
      <div class="stat-top"><i class="fas fa-wallet" aria-hidden="true"></i>Current Balance</div>
      <div class="stat-num <%= balance > 0 ? 'num-green' : 'num-red' %>">₹<%= balance.toLocaleString('en-IN') %></div>
    </article>
    <article class="stat-tile">
      <div class="stat-top"><i class="fas fa-arrow-down" aria-hidden="true"></i>Total Credit</div>
      <div class="stat-num num-green">₹<%= totalCredit.toLocaleString('en-IN') %></div>
    </article>
    <article class="stat-tile">
      <div class="stat-top"><i class="fas fa-arrow-up" aria-hidden="true"></i>Total Debit</div>
      <div class="stat-num num-red">₹<%= totalDebit.toLocaleString('en-IN') %></div>
    </article>
    <article class="stat-tile">
      <div class="stat-top"><i class="fas fa-right-left" aria-hidden="true"></i>Total Transactions</div>
      <div class="stat-num num-blue"><%= totalTransactions %></div>
    </article>
  </section>

  <section class="two-col">
    <article class="wallet-card">
      <div class="card-title">
        <h3><i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Recent Transactions</h3>
      </div>

      <% if ((transactions?.length || 0) > 0) { %>
        <div class="tx-table-wrap">
          <table class="tx-table">
            <thead>
              <tr>
                <th>Txn ID</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Description</th>
                <th>Date &amp; Time</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(function(tx) { %>
                <% const txTypeRaw = String(tx?.type || tx?.transactionType || tx?.direction || 'transfer').toLowerCase(); %>
                <% const txType = txTypeRaw === 'credit' ? 'Credit' : (txTypeRaw === 'debit' ? 'Debit' : 'Transfer'); %>
                <% const txTypeClass = txTypeRaw === 'credit' ? 'type-credit' : (txTypeRaw === 'debit' ? 'type-debit' : 'type-transfer'); %>
                <% const txAmount = Number(tx?.amount || tx?.Amount || 0); %>
                <% const txStatusRaw = String(tx?.status || tx?.Status || 'success').toLowerCase(); %>
                <tr>
                  <td class="tx-id"><%= String(tx?._id || tx?.id || tx?.transactionId || 'N/A').slice(-8) %></td>
                  <td><span class="tx-type <%= txTypeClass %>"><%= txType %></span></td>
                  <td class="tx-amount <%= txTypeRaw === 'credit' ? 'credit' : 'debit' %>">₹<%= txAmount.toLocaleString('en-IN') %></td>
                  <td><%= tx?.description || tx?.Description || 'Wallet transaction' %></td>
                  <td><%= tx?.createdAt ? new Date(tx.createdAt).toLocaleString('en-IN') : '—' %></td>
                  <td>
                    <span class="status-pill <%= txStatusRaw === 'success' ? 'status-active' : (txStatusRaw === 'pending' ? 'status-frozen' : 'status-suspended') %>">
                      <%= txStatusRaw?.charAt(0).toUpperCase() + txStatusRaw?.slice(1) %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-receipt" aria-hidden="true" style="font-size: 1.5rem;"></i>
          <p>No transactions found</p>
        </div>
      <% } %>

      <a class="tx-footer-link" href="/admin/transactions?walletId=<%= walletObj?._id || '' %>"><i class="fas fa-list" aria-hidden="true"></i>View All Transactions</a>
    </article>

    <article class="wallet-card">
      <div class="card-title">
        <h3><i class="fas fa-chart-pie" aria-hidden="true"></i>Activity Overview</h3>
      </div>

      <div class="mini-list">
        <div class="mini-item"><span><i class="fas fa-arrow-down" aria-hidden="true"></i> Total Credits</span><strong style="color: var(--success);">₹<%= totalCredit.toLocaleString('en-IN') %></strong></div>
        <div class="mini-item"><span><i class="fas fa-arrow-up" aria-hidden="true"></i> Total Debits</span><strong style="color: var(--danger);">₹<%= totalDebit.toLocaleString('en-IN') %></strong></div>
        <div class="mini-item"><span><i class="fas fa-clock" aria-hidden="true"></i> Last Transaction</span><strong><%= lastTxAt ? lastTxAt.toLocaleString('en-IN') : '—' %></strong></div>
        <div class="mini-item"><span><i class="fas fa-calendar" aria-hidden="true"></i> Wallet Age</span><strong><%= walletAgeDays %> days</strong></div>
        <div class="mini-item"><span><i class="fas fa-shield-alt" aria-hidden="true"></i> KYC Status</span><strong><span class="status-pill status-active"><%= String(userObj?.KYCStatus || 'verified').toUpperCase() %></span></strong></div>
      </div>

      <div class="chart-wrap">
        <canvas id="walletActivityChart" data-credit="<%= walletObj?.totalCredit || 0 %>" data-debit="<%= walletObj?.totalDebit || 0 %>" aria-label="Wallet activity chart"></canvas>
      </div>
    </article>
  </section>

  <section class="wallet-card">
    <div class="card-title">
      <h3><i class="fas fa-note-sticky" aria-hidden="true"></i>Admin Notes</h3>
    </div>

    <form id="walletNoteForm" class="notes-form">
      <textarea id="walletNoteInput" class="notes-textarea" placeholder="Add a note for this wallet"></textarea>
      <button type="submit" class="btn-note"><i class="fas fa-plus" aria-hidden="true"></i>Add Note</button>
    </form>

    <div class="notes-list" id="notesList">
      <article class="note-item">
        <div class="note-head"><span>Admin User</span><span>Today, 10:18 AM</span></div>
        <p class="note-body">Wallet reviewed after high-value debit spike. No suspicious pattern found.</p>
      </article>
      <article class="note-item">
        <div class="note-head"><span>Risk Team</span><span>Yesterday, 05:42 PM</span></div>
        <p class="note-body">User requested balance correction due to duplicate settlement. Awaiting final reconciliation.</p>
      </article>
    </div>
  </section>

  <section class="wallet-card danger-zone">
    <div class="card-title">
      <h3><i class="fas fa-triangle-exclamation" aria-hidden="true"></i>Danger Zone</h3>
    </div>

    <div class="danger-row">
      <div class="danger-meta">
        <h4>Freeze Wallet</h4>
        <p>Temporarily block all transactions on this wallet</p>
      </div>
      <button type="button" class="btn-danger-outline" data-open-modal="freezeWalletModal"><i class="fas fa-snowflake" aria-hidden="true"></i>Freeze</button>
    </div>

    <div class="danger-row">
      <div class="danger-meta">
        <h4>Reset Balance to Zero</h4>
        <p>Force set wallet balance to ₹0. Use only for corrections.</p>
      </div>
      <button type="button" class="btn-warn-outline" data-open-modal="resetBalanceModal"><i class="fas fa-rotate-left" aria-hidden="true"></i>Reset</button>
    </div>

    <div class="danger-row">
      <div class="danger-meta">
        <h4>Permanently Suspend</h4>
        <p>Permanently disable this wallet. User cannot transact.</p>
      </div>
      <button type="button" class="btn-red" data-open-modal="suspendWalletModal"><i class="fas fa-ban" aria-hidden="true"></i>Suspend</button>
    </div>
  </section>
</div>

<div id="freezeWalletModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div>
        <h3 class="modal-title" id="freezeModalTitle"><i class="fas <%= statusRaw === 'frozen' ? 'fa-fire' : 'fa-snowflake' %>" aria-hidden="true"></i><%= statusRaw === 'frozen' ? 'Unfreeze Wallet' : 'Freeze Wallet' %></h3>
        <p class="modal-sub">Wallet ID: <%= walletIdText %></p>
      </div>
      <button type="button" class="modal-close" data-close-modal="freezeWalletModal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <p class="meta-line">Confirm this action for wallet <strong class="mono"><%= walletIdText %></strong>.</p>
      <div class="modal-footer">
        <button type="button" class="btn-chip" data-close-modal="freezeWalletModal">Cancel</button>
        <button type="button" class="btn-chip primary" id="freezeConfirmBtn" data-mode="<%= statusRaw === 'frozen' ? 'unfreeze' : 'freeze' %>"><i class="fas <%= statusRaw === 'frozen' ? 'fa-fire' : 'fa-snowflake' %>" aria-hidden="true"></i><%= statusRaw === 'frozen' ? 'Unfreeze' : 'Freeze' %></button>
      </div>
    </div>
  </div>
</div>

<div id="adjustBalanceModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div>
        <h3 class="modal-title"><i class="fas fa-indian-rupee-sign" aria-hidden="true"></i>Adjust Balance</h3>
        <p class="modal-sub">Wallet ID: <%= walletIdText %></p>
      </div>
      <button type="button" class="modal-close" data-close-modal="adjustBalanceModal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <form id="adjustBalanceForm">
        <input type="hidden" id="adjustWalletId" value="<%= walletObj?._id || '' %>">

        <div class="info-box">
          <span class="info-label">Current Balance</span>
          <div class="info-value" id="currentBalanceDisplay">₹<%= balance.toLocaleString('en-IN') %></div>
        </div>

        <div class="toggle-group">
          <label class="toggle-pill"><input type="radio" name="adjustType" value="credit" checked><span>Credit</span></label>
          <label class="toggle-pill"><input type="radio" name="adjustType" value="debit"><span>Debit</span></label>
        </div>

        <div class="field">
          <label for="adjustAmountInput">Amount (₹)</label>
          <input id="adjustAmountInput" type="number" min="1" required placeholder="Enter amount">
        </div>

        <div class="field">
          <label for="adjustReasonSelect">Reason</label>
          <select id="adjustReasonSelect">
            <option value="refund">Refund</option>
            <option value="cashback">Cashback</option>
            <option value="correction">Correction</option>
            <option value="penalty">Penalty</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="field">
          <label for="adjustNoteInput">Note</label>
          <textarea id="adjustNoteInput" placeholder="Admin note (optional)"></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-chip" data-close-modal="adjustBalanceModal">Cancel</button>
          <button type="submit" class="btn-chip primary"><i class="fas fa-check" aria-hidden="true"></i>Apply Adjustment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="suspendWalletModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header" style="background: var(--danger);">
      <div>
        <h3 class="modal-title"><i class="fas fa-ban" aria-hidden="true"></i>Suspend Wallet</h3>
        <p class="modal-sub">Wallet ID: <%= walletIdText %></p>
      </div>
      <button type="button" class="modal-close" data-close-modal="suspendWalletModal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <div class="warn-card">This will restrict this wallet from all future transactions.</div>
      <div class="field">
        <label for="suspendReasonInput">Reason (required)</label>
        <textarea id="suspendReasonInput" required placeholder="Enter suspension reason"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-chip" data-close-modal="suspendWalletModal">Cancel</button>
        <button type="button" class="btn-red" id="suspendConfirmBtn"><i class="fas fa-ban" aria-hidden="true"></i>Suspend Wallet</button>
      </div>
    </div>
  </div>
</div>

<div id="resetBalanceModal" class="modal-overlay" hidden>
  <div class="modal-card">
    <div class="modal-header" style="background: var(--warning);">
      <div>
        <h3 class="modal-title"><i class="fas fa-rotate-left" aria-hidden="true"></i>Reset Balance</h3>
        <p class="modal-sub">This will set balance to ₹0</p>
      </div>
      <button type="button" class="modal-close" data-close-modal="resetBalanceModal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="modal-body">
      <div class="warn-card">Type <strong>CONFIRM</strong> to continue.</div>
      <div class="field">
        <label for="resetConfirmInput">Confirmation text</label>
        <input id="resetConfirmInput" type="text" placeholder="Type CONFIRM">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-chip" data-close-modal="resetBalanceModal">Cancel</button>
        <button type="button" class="btn-red" id="resetConfirmBtn" disabled><i class="fas fa-check" aria-hidden="true"></i>Reset to ₹0</button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= locals.cspNonce || '' %>">
  (function () {
    const walletId = "<%= walletObj?._id || '' %>";
    const walletStatus = "<%= statusRaw %>";

    function openModal(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.hidden = false;
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.hidden = true;
    }

    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.getAttribute('data-open-modal')));
    });

    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => closeModal(btn.getAttribute('data-close-modal')));
    });

    function ensureChart(cb) {
      if (window.Chart) return cb();
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      s.onload = cb;
      document.head.appendChild(s);
    }

    function initChart() {
      const canvas = document.getElementById('walletActivityChart');
      if (!canvas || !window.Chart) return;
      const credit = Number(canvas.getAttribute('data-credit') || 0);
      const debit = Number(canvas.getAttribute('data-debit') || 0);
      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: ['Credit', 'Debit'],
          datasets: [{ data: [credit, debit], backgroundColor: ['#22c55e', '#ef4444'], borderWidth: 0 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }
    ensureChart(initChart);

    const copyBtn = document.getElementById('copyWalletIdBtn');
    const copyTip = document.getElementById('copyWalletTip');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText("<%= walletIdText %>");
          if (copyTip) {
            copyTip.classList.add('show');
            setTimeout(() => copyTip.classList.remove('show'), 1500);
          }
        } catch (err) {}
      });
    }

    async function patchStatus(action, extra = {}) {
      const res = await fetch('/admin/wallets/' + walletId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, ...extra })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Failed');
      location.reload();
    }

    const freezeBtn = document.getElementById('freezeConfirmBtn');
    if (freezeBtn) {
      freezeBtn.addEventListener('click', async () => {
        const mode = freezeBtn.getAttribute('data-mode') || (walletStatus === 'frozen' ? 'unfreeze' : 'freeze');
        try { await patchStatus(mode); } catch (e) { alert(e.message); }
      });
    }

    const suspendBtn = document.getElementById('suspendConfirmBtn');
    if (suspendBtn) {
      suspendBtn.addEventListener('click', async () => {
        const reason = document.getElementById('suspendReasonInput')?.value?.trim();
        if (!reason) return alert('Suspension reason is required');
        try { await patchStatus('suspend', { reason }); } catch (e) { alert(e.message); }
      });
    }

    const adjustForm = document.getElementById('adjustBalanceForm');
    if (adjustForm) {
      adjustForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const type = document.querySelector('input[name="adjustType"]:checked')?.value;
        const amount = document.getElementById('adjustAmountInput')?.value;
        const reason = document.getElementById('adjustReasonSelect')?.value;
        const note = document.getElementById('adjustNoteInput')?.value;

        const res = await fetch('/admin/wallets/' + walletId + '/adjust-balance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, amount, reason, note })
        });
        const data = await res.json();
        if (!data.success) return alert(data.message || 'Failed to adjust balance');
        location.reload();
      });
    }

    const resetInput = document.getElementById('resetConfirmInput');
    const resetBtn = document.getElementById('resetConfirmBtn');
    if (resetInput && resetBtn) {
      resetInput.addEventListener('input', () => {
        resetBtn.disabled = resetInput.value !== 'CONFIRM';
      });

      resetBtn.addEventListener('click', async () => {
        const res = await fetch('/admin/wallets/' + walletId + '/reset-balance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (!data.success) return alert(data.message || 'Failed to reset balance');
        location.reload();
      });
    }

    const noteForm = document.getElementById('walletNoteForm');
    const noteInput = document.getElementById('walletNoteInput');
    const notesList = document.getElementById('notesList');
    if (noteForm && noteInput && notesList) {
      noteForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = noteInput.value.trim();
        if (!text) return;

        const wrap = document.createElement('article');
        wrap.className = 'note-item';
        wrap.innerHTML = `
          <div class="note-head"><span>Admin User</span><span>${new Date().toLocaleString('en-IN')}</span></div>
          <p class="note-body"></p>
        `;
        wrap.querySelector('.note-body').textContent = text;
        notesList.prepend(wrap);
        noteInput.value = '';
      });
    }
  })();
</script>

