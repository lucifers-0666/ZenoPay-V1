<script>
  function toggleDropdown(btn) {
    const dropdown = btn.nextElementSibling;
    const isOpen = dropdown.classList.contains('open');

    document.querySelectorAll('.action-dropdown.open').forEach((d) => {
      d.classList.remove('open');
      d.style.top = '100%';
      d.style.bottom = 'auto';
    });

    if (!isOpen) {
      dropdown.classList.add('open');
      const rect = dropdown.getBoundingClientRect();
      if (rect.bottom > window.innerHeight - 20) {
        dropdown.style.top = 'auto';
        dropdown.style.bottom = '100%';
      }
    }
  }

  function walletAction(walletId, action, btn) {
    const labels = { freeze: 'Freeze', unfreeze: 'Unfreeze', suspend: 'Suspend' };
    if (!confirm(`Are you sure you want to ${labels[action]} this wallet?`)) return;

    const dropdown = btn.closest('.action-dropdown');
    if (dropdown) dropdown.classList.remove('open');

    fetch(`/admin/wallets/${walletId}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action })
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          const row = btn.closest('tr');
          const badge = row ? row.querySelector('.status-badge') : null;
          const statusMap = {
            active: { text: 'Active', cls: 'badge-success' },
            frozen: { text: 'Frozen', cls: 'badge-info' },
            suspended: { text: 'Suspended', cls: 'badge-danger' }
          };
          const s = statusMap[data.status];
          if (badge && s) {
            badge.textContent = s.text;
            badge.className = `wallet-badge status-badge ${s.cls}`;
          }
          setTimeout(() => location.reload(), 800);
        } else {
          alert(data.message || 'Action failed');
        }
      })
      .catch(() => alert('Network error. Please try again.'));
  }

  function openAdjustModal(walletId, currentBalance) {
    const adjustWalletId = document.getElementById('adjustWalletId');
    const balanceDisplay = document.getElementById('currentBalanceDisplay');
    const amountInput = document.getElementById('adjustAmountInput');
    const noteInput = document.getElementById('adjustNoteInput');
    const modal = document.getElementById('adjustBalanceModal');

    if (adjustWalletId) adjustWalletId.value = walletId;
    if (balanceDisplay) {
      const amount = parseFloat(currentBalance || 0) || 0;
      balanceDisplay.textContent = '₹' + amount.toLocaleString('en-IN');
    }
    if (amountInput) amountInput.value = '';
    if (noteInput) noteInput.value = '';

    if (modal) {
      modal.hidden = false;
      modal.classList.add('modal-open');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const table = document.getElementById('walletsTable');
    const selectAll = document.getElementById('selectAllWallets');
    const rowChecks = Array.from(document.querySelectorAll('.wallet-row-check'));
    const bulkBar = document.getElementById('walletBulkBar');
    const bulkCount = document.getElementById('walletBulkCount');
    const statusFilter = document.getElementById('walletStatusFilter');
    const balanceFilter = document.getElementById('walletBalanceFilter');
    const searchInput = document.getElementById('walletSearch');
    const resetFiltersBtn = document.getElementById('resetWalletFilters');

    function parseBalance(text) {
      return Number((text || '').replace(/[₹,\s]/g, '')) || 0;
    }

    function updateBulkState() {
      const selected = rowChecks.filter((check) => check.checked).length;
      bulkCount.textContent = `${selected} wallets selected`;
      bulkBar.hidden = selected === 0;
    }

    function applyFilters() {
      const rows = Array.from(table.querySelectorAll('tbody tr'));
      const q = (searchInput.value || '').trim().toLowerCase();
      const status = statusFilter.value;
      const range = balanceFilter.value;

      rows.forEach((row) => {
        const rowText = row.textContent.toLowerCase();
        const rowStatus = row.getAttribute('data-status') || '';
        const rowBalance = Number(row.getAttribute('data-balance') || 0);

        let statusMatch = !status || rowStatus === status;
        let searchMatch = !q || rowText.includes(q);
        let balanceMatch = true;

        if (range === '0-1000') balanceMatch = rowBalance >= 0 && rowBalance <= 1000;
        if (range === '1000-10000') balanceMatch = rowBalance > 1000 && rowBalance <= 10000;
        if (range === '10000-100000') balanceMatch = rowBalance > 10000 && rowBalance <= 100000;
        if (range === '100000+') balanceMatch = rowBalance > 100000;

        row.style.display = (statusMatch && searchMatch && balanceMatch) ? '' : 'none';
      });
    }

    if (selectAll) {
      selectAll.addEventListener('change', function () {
        rowChecks.forEach((check) => {
          if (check.closest('tr').style.display !== 'none') {
            check.checked = selectAll.checked;
          }
        });
        updateBulkState();
      });
    }

    rowChecks.forEach((check) => {
      check.addEventListener('change', updateBulkState);
    });

    [statusFilter, balanceFilter, searchInput].forEach((node) => {
      if (!node) return;
      node.addEventListener('input', applyFilters);
      node.addEventListener('change', applyFilters);
    });

    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', function () {
        searchInput.value = '';
        statusFilter.value = '';
        balanceFilter.value = '';
        applyFilters();
      });
    }

    document.querySelectorAll('.copy-wallet-btn').forEach((btn) => {
      btn.addEventListener('click', function () {
        const value = this.getAttribute('data-copy') || '';
        if (!value || !navigator.clipboard) return;
        navigator.clipboard.writeText(value).catch(() => {});
      });
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.action-cell')) {
        document.querySelectorAll('.action-dropdown.open').forEach((d) => {
          d.classList.remove('open');
          d.style.top = '100%';
          d.style.bottom = 'auto';
        });
      }
    });

    const adjustForm = document.getElementById('adjustBalanceForm');
    if (adjustForm) {
      adjustForm.addEventListener('submit', function (e) {
        e.preventDefault();

        const walletId = document.getElementById('adjustWalletId')?.value;
        const type = document.querySelector('input[name="adjustType"]:checked')?.value;
        const amount = document.getElementById('adjustAmountInput')?.value;
        const reason = document.getElementById('adjustReasonSelect')?.value;
        const note = document.getElementById('adjustNoteInput')?.value;

        fetch(`/admin/wallets/${walletId}/adjust-balance`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, amount, reason, note })
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.success) {
              alert('Balance adjusted successfully');
              location.reload();
            } else {
              alert(data.message || 'Failed to adjust balance');
            }
          })
          .catch(() => alert('Network error'));
      });
    }

    updateBulkState();
    applyFilters();
  });
</script>
