  <button class="mobile-sidebar-toggle" id="mobileSidebarToggle" aria-label="Open docs menu"><i class="fas fa-bars"></i></button>
  <div class="overlay" id="sidebarOverlay"></div>

  <script>
    (function () {
      const baseUrlText = document.getElementById('baseUrlText');
      const copyBaseBtn = document.getElementById('copyBaseBtn');
      const responseCodeBlock = document.getElementById('responseCodeBlock');
      const docsSidebar = document.getElementById('docsSidebar');
      const utilityBar = document.querySelector('.utility-bar');
      const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
      const sidebarOverlay = document.getElementById('sidebarOverlay');
      const sidebarSearch = document.getElementById('sidebarSearch');
      const topSearch = document.getElementById('topSearch');

      const syncStickyOffsets = () => {
        if (!utilityBar) return;
        const height = Math.ceil(utilityBar.getBoundingClientRect().height);
        document.documentElement.style.setProperty('--utility-bar-height', `${height}px`);
      };

      syncStickyOffsets();
      window.addEventListener('resize', syncStickyOffsets);
      window.addEventListener('load', syncStickyOffsets);
      if (window.ResizeObserver && utilityBar) {
        const resizeObserver = new ResizeObserver(syncStickyOffsets);
        resizeObserver.observe(utilityBar);
      }

      const responseMap = {
        ok: `{
  "id": "pay_9Qx1kL2z",
  "status": "created",
  "amount": 5000,
  "currency": "INR",
  "checkout_url": "https://checkout.zenopay.in/pay/pay_9Qx1kL2z"
}`,
        bad: `{
  "error_code": "INVALID_AMOUNT",
  "message": "Amount must be greater than zero",
  "details": { "field": "amount" }
}`,
        auth: `{
  "error_code": "AUTH_FAILED",
  "message": "Invalid API key",
  "details": null
}`,
        val: `{
  "error_code": "VALIDATION_ERROR",
  "message": "Validation failed",
  "details": { "currency": "Unsupported code" }
}`,
        server: `{
  "error_code": "INTERNAL_ERROR",
  "message": "Unexpected server error",
  "details": null
}`,
      };

      const copyText = async (text, btn) => {
        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
          setTimeout(() => { btn.innerHTML = prev; }, 1200);
        } catch (_) {}
      };

      if (copyBaseBtn && baseUrlText) {
        copyBaseBtn.addEventListener('click', () => copyText(baseUrlText.textContent.trim(), copyBaseBtn));
      }

      document.querySelectorAll('[data-copy-inline]').forEach((btn) => {
        btn.addEventListener('click', () => copyText(btn.getAttribute('data-copy-inline') || '', btn));
      });

      document.querySelectorAll('[data-codeblock]').forEach((block) => {
        const tabs = Array.from(block.querySelectorAll('.lang-tab'));
        const panes = Array.from(block.querySelectorAll('.code-pane'));
        const copyBtn = block.querySelector('[data-copy]');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.classList.remove('active'));
            panes.forEach((p) => p.classList.remove('active'));
            tab.classList.add('active');
            const pane = block.querySelector(`.code-pane[data-pane="${tab.dataset.lang}"]`);
            if (pane) pane.classList.add('active');
          });
        });

        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            const activePane = block.querySelector('.code-pane.active');
            copyText(activePane ? activePane.textContent : '', copyBtn);
          });
        }
      });

      document.querySelectorAll('[data-status-tabs]').forEach((tabsWrap) => {
        const tabs = Array.from(tabsWrap.querySelectorAll('.status-tab'));
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            responseCodeBlock.textContent = responseMap[tab.dataset.status] || responseMap.ok;
          });
        });
      });

      const runSandboxRequest = () => {
        const output = document.getElementById('sandboxOutput');
        const amount = Number(document.getElementById('sandboxAmount')?.value || 0);
        const currency = document.getElementById('sandboxCurrency')?.value || 'INR';
        const key = document.getElementById('sandboxApiKey')?.value || 'sk_test_xxxxxxxxxxxx';

        const payload = {
          request: {
            authorization: `Bearer ${key.slice(0, 12)}...`,
            amount,
            currency,
            order_id: `ORD_${Math.floor(Math.random() * 9000 + 1000)}`
          },
          response: {
            id: `pay_${Math.random().toString(36).slice(2, 10)}`,
            status: 'created',
            amount,
            currency,
            checkout_url: 'https://checkout.zenopay.in/pay/demo',
            sandbox: true
          }
        };

        output.textContent = JSON.stringify(payload, null, 2);
      };

      document.getElementById('sendSandbox')?.addEventListener('click', runSandboxRequest);

      const navItems = Array.from(document.querySelectorAll('.nav-item'));
      const tocLinks = Array.from(document.querySelectorAll('.toc a'));
      const allSearchTargets = navItems;

      const filterNav = (value) => {
        const q = value.trim().toLowerCase();
        allSearchTargets.forEach((item) => {
          const text = item.textContent.toLowerCase();
          item.style.display = text.includes(q) ? 'flex' : 'none';
        });
      };

      sidebarSearch?.addEventListener('input', (e) => filterNav(e.target.value));
      topSearch?.addEventListener('input', (e) => filterNav(e.target.value));

      const sections = Array.from(document.querySelectorAll('.doc-section[id], [id="create-payment"], [id="sandbox"]'));
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;

          navItems.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });

          tocLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        });
      }, { rootMargin: '-45% 0px -50% 0px', threshold: 0.01 });

      sections.forEach((section) => observer.observe(section));

      navItems.forEach((item) => {
        item.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            docsSidebar.classList.remove('open');
            sidebarOverlay.classList.remove('show');
          }
        });
      });

      mobileSidebarToggle?.addEventListener('click', () => {
        docsSidebar.classList.add('open');
        sidebarOverlay.classList.add('show');
      });

      sidebarOverlay?.addEventListener('click', () => {
        docsSidebar.classList.remove('open');
        sidebarOverlay.classList.remove('show');
      });

      const sandboxHead = document.querySelector('.sandbox-head');
      const sandboxBody = document.getElementById('sandboxBody');
      sandboxHead?.addEventListener('click', () => {
        if (window.innerWidth < 768) sandboxBody.classList.toggle('collapsed');
      });
    })();
  </script>
</body>
