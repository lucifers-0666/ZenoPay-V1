<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'API Documentation - ZenoPay' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --border: #E2E8F0;
      --line: #F1F5F9;
      --text: #1F2937;
      --secondary: #475569;
      --muted: #94A3B8;
      --blue: #3B82F6;
      --blue-dark: #2563EB;
      --gradient-primary: linear-gradient(135deg, #3B82F6, #2563EB);
      --gradient-header: linear-gradient(135deg, #1F2937 0%, #374151 100%);
      --radius-xl: 20px;
      --radius-lg: 16px;
      --radius-md: 12px;
      --shadow-card: 0 4px 16px rgba(0,0,0,0.06);
      --focus: 0 0 0 4px rgba(59,130,246,0.1);
      --utility-bar-height: 65px;
      --sticky-gap: 16px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .docs-hero {
      background: var(--gradient-header);
      position: relative;
      overflow: hidden;
      padding: 60px 0;
    }

    .docs-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(rgba(255,255,255,0.6) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,0.35) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.35) 1px, transparent 1px);
      background-size: 14px 14px, 40px 40px, 40px 40px;
      opacity: 0.05;
      pointer-events: none;
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    .breadcrumb {
      color: rgba(255,255,255,0.6);
      font-size: 14px;
      margin-bottom: 16px;
    }

    .breadcrumb a {
      color: #fff;
      text-decoration: none;
      opacity: .85;
    }

    .breadcrumb a:hover { opacity: 1; }

    .hero-title {
      margin: 0;
      font-size: 52px;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #fff;
      font-weight: 800;
    }

    .hero-sub {
      margin: 14px 0 0;
      max-width: 600px;
      color: rgba(255,255,255,0.75);
      font-size: 18px;
      line-height: 1.7;
    }

    .hero-row {
      margin-top: 32px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 20px;
      padding: 8px 16px;
      font-size: 14px;
      font-weight: 600;
    }

    .badge.version { background: #3B82F6; color: #fff; }
    .badge.base {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      font-family: 'Courier New', monospace;
      font-size: 14px;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.25);
      background: rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.7);
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: all .2s ease;
    }

    .icon-btn:hover { color: #fff; border-color: rgba(255,255,255,0.55); }

    .hero-actions { display: flex; gap: 12px; margin-top: 16px; }

    .btn {
      height: 42px;
      border: 0;
      border-radius: 10px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, #3B82F6, #8B5CF6);
      color: #fff;
    }

    .btn-outline-light {
      border: 1px solid rgba(255,255,255,0.4);
      background: transparent;
      color: #fff;
    }

    .utility-bar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      min-height: var(--utility-bar-height);
    }

    .search-wrap {
      position: relative;
      width: 280px;
      max-width: 100%;
    }

    .search-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94A3B8;
      font-size: 14px;
    }

    .search-input {
      width: 100%;
      height: 40px;
      border: 1px solid var(--border);
      background: #F8FAFC;
      border-radius: 8px;
      padding: 0 12px 0 38px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
    }

    .search-input:focus { border-color: var(--blue); box-shadow: var(--focus); }

    .utility-links { display: flex; align-items: center; gap: 10px; color: #94A3B8; }
    .utility-links a {
      text-decoration: none;
      color: #64748B;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      display: inline-block;
    }

    .docs-shell {
      max-width: 1600px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr) 240px;
      gap: 0;
      align-items: stretch;
      min-height: calc(100vh - 1px);
      position: relative;
      overflow: visible;
    }

    .docs-sidebar {
      background: #fff;
      border-right: 1px solid var(--border);
      height: calc(100vh - var(--utility-bar-height) - (var(--sticky-gap) * 2));
      position: sticky;
      top: calc(var(--utility-bar-height) + var(--sticky-gap));
      overflow-y: auto;
      padding: 24px 0;
      margin-top: 0;
    }

    .docs-sidebar::-webkit-scrollbar { width: 4px; }
    .docs-sidebar::-webkit-scrollbar-track { background: transparent; }
    .docs-sidebar::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 4px; }

    .sidebar-search { padding: 0 16px 20px; }

    .nav-group-title {
      font-size: 11px;
      font-weight: 700;
      color: #94A3B8;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 16px 20px 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 20px;
      font-size: 14px;
      color: #475569;
      font-weight: 500;
      text-decoration: none;
      border-left: 3px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-item:hover { background: #F8FAFC; color: #3B82F6; }
    .nav-item.active {
      color: #3B82F6;
      border-left-color: #3B82F6;
      background: #EFF6FF;
      font-weight: 600;
    }

    .mini-method {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .mini-get { background: rgba(16,185,129,0.1); color: #059669; }
    .mini-post { background: rgba(59,130,246,0.1); color: #2563EB; }
    .mini-put { background: rgba(245,158,11,0.1); color: #D97706; }
    .mini-delete { background: rgba(239,68,68,0.1); color: #DC2626; }

    .docs-content {
      padding: 48px 60px;
      max-width: 900px;
      width: min(100%, 900px);
      margin: 0 auto;
      position: relative;
    }

    .toc-column {
      align-self: stretch;
      padding: 0 24px 0 0;
      position: relative;
      overflow: visible;
      min-height: 100%;
    }

    .doc-section { scroll-margin-top: 80px; margin-bottom: 44px; }

    .section-title {
      font-size: 36px;
      font-weight: 800;
      margin: 0 0 8px;
    }

    .section-desc {
      font-size: 17px;
      color: #6B7280;
      line-height: 1.7;
      max-width: 700px;
      margin: 0 0 28px;
    }

    .divider { border-top: 1px solid var(--border); margin: 40px 0; }

    .endpoint-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .method {
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Courier New', monospace;
      border: 1px solid;
    }

    .method-get { background: rgba(16,185,129,0.12); color: #059669; border-color: #10B981; }
    .method-post { background: rgba(59,130,246,0.12); color: #2563EB; border-color: #3B82F6; }
    .method-put { background: rgba(245,158,11,0.12); color: #D97706; border-color: #F59E0B; }
    .method-delete { background: rgba(239,68,68,0.12); color: #DC2626; border-color: #EF4444; }

    .endpoint-url { font-size: 20px; font-family: 'Courier New', monospace; font-weight: 600; }

    .desc-p { font-size: 16px; color: #475569; line-height: 1.8; margin: 0 0 24px; }

    .auth-banner {
      background: rgba(59,130,246,0.06);
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 10px;
      padding: 16px 20px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 20px;
      color: #1E40AF;
      font-size: 14px;
    }

    .auth-banner i { color: #3B82F6; font-size: 18px; margin-top: 1px; }

    .code-block {
      background: #0F172A;
      border-radius: 12px;
      overflow: hidden;
      margin: 20px 0;
    }

    .code-block-header {
      background: #1E293B;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .lang-tabs { display: flex; gap: 4px; flex-wrap: wrap; }

    .lang-tab {
      padding: 6px 14px;
      border-radius: 6px;
      border: 0;
      background: transparent;
      color: rgba(255,255,255,0.5);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .lang-tab.active { background: #3B82F6; color: #fff; }

    .copy-btn {
      border: 0;
      background: transparent;
      color: rgba(255,255,255,0.5);
      cursor: pointer;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .copy-btn:hover { color: #fff; }

    .code-content {
      margin: 0;
      padding: 20px 24px;
      overflow-x: auto;
      font-family: 'Courier New', monospace;
      font-size: 14px;
      line-height: 1.8;
      color: #E2E8F0;
      white-space: pre;
    }

    .code-pane { display: none; }
    .code-pane.active { display: block; }

    .token-keyword { color: #60A5FA; }
    .token-string  { color: #86EFAC; }
    .token-number  { color: #FCA5A5; }
    .token-comment { color: rgba(255,255,255,0.35); }
    .token-key     { color: #C4B5FD; }

    .table-title {
      margin: 24px 0 10px;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .table-wrap {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: auto;
    }

    table { width: 100%; border-collapse: collapse; min-width: 620px; }
    thead th {
      background: #F8FAFC;
      text-align: left;
      padding: 12px 16px;
      font-size: 12px;
      color: #94A3B8;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    tbody td { padding: 14px 16px; font-size: 14px; border-top: 1px solid #F1F5F9; }
    tbody tr:nth-child(even) td { background: #F8FAFC; }

    .param-name { font-family: 'Courier New', monospace; font-weight: 600; }

    .type-badge {
      font-size: 12px;
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 600;
      display: inline-block;
    }

    .type-string { background: rgba(59,130,246,0.12); color: #2563EB; }
    .type-number { background: rgba(16,185,129,0.12); color: #059669; }
    .type-boolean { background: rgba(139,92,246,0.12); color: #7C3AED; }
    .type-object { background: rgba(245,158,11,0.12); color: #D97706; }

    .required { color: #DC2626; font-size: 13px; }
    .optional { color: #94A3B8; font-size: 13px; }

    .status-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 16px; }

    .status-tab {
      border: 1px solid;
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      background: transparent;
    }

    .status-tab.active { color: #fff !important; }
    .status-ok { background: rgba(16,185,129,0.12); color: #059669; border-color: #10B981; }
    .status-bad { background: rgba(245,158,11,0.12); color: #D97706; border-color: #F59E0B; }
    .status-auth { background: rgba(239,68,68,0.12); color: #DC2626; border-color: #EF4444; }
    .status-val { background: rgba(249,115,22,0.12); color: #EA580C; border-color: #FB923C; }
    .status-server { background: rgba(100,116,139,0.12); color: #475569; border-color: #94A3B8; }

    .status-tab.status-ok.active { background: #10B981; }
    .status-tab.status-bad.active { background: #F59E0B; }
    .status-tab.status-auth.active { background: #EF4444; }
    .status-tab.status-val.active { background: #F97316; }
    .status-tab.status-server.active { background: #64748B; }

    .event-badge {
      display: inline-flex;
      align-items: center;
      background: #1E293B;
      color: #60A5FA;
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-family: 'Courier New', monospace;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .sandbox {
      background: #fff;
      border: 1.5px solid #3B82F6;
      border-radius: 16px;
      overflow: hidden;
      margin: 32px 0;
    }

    .sandbox-head {
      background: linear-gradient(135deg, #3B82F6, #8B5CF6);
      color: #fff;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 16px;
      font-weight: 700;
    }

    .sandbox-badge {
      background: #FDE047;
      color: #111827;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 8px;
      border-radius: 999px;
      font-weight: 800;
    }

    .sandbox-body { padding: 24px; }

    .field {
      margin-bottom: 12px;
    }

    .field label {
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      display: block;
      margin-bottom: 6px;
    }

    .field input, .field select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      height: 44px;
      padding: 0 14px;
      font-size: 14px;
      font-family: inherit;
      outline: none;
      background: #fff;
    }

    .field input:focus, .field select:focus { border-color: #3B82F6; box-shadow: var(--focus); }

    .btn-send {
      width: 100%;
      border: 0;
      border-radius: 10px;
      height: 44px;
      background: var(--gradient-primary);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      cursor: pointer;
    }

    .sandbox-output {
      margin-top: 14px;
      background: #0F172A;
      border-radius: 10px;
      padding: 16px 20px;
      min-height: 100px;
      font-family: 'Courier New', monospace;
      font-size: 13px;
      color: #E2E8F0;
      white-space: pre-wrap;
    }

    .placeholder { color: rgba(255,255,255,0.3); }

    .steps {
      position: relative;
      margin-top: 12px;
    }

    .steps::before {
      content: '';
      position: absolute;
      left: 19px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: #E2E8F0;
    }

    .step {
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 20px;
      margin-bottom: 40px;
      position: relative;
    }

    .step-num {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #3B82F6, #8B5CF6);
      color: #fff;
      font-weight: 700;
      font-size: 18px;
      display: grid;
      place-items: center;
      box-shadow: 0 4px 12px rgba(59,130,246,0.25);
      z-index: 1;
    }

    .step h4 { margin: 2px 0 8px; font-size: 20px; }
    .step p { margin: 0 0 16px; color: #6B7280; font-size: 15px; line-height: 1.7; }

    .info-box {
      background: rgba(59,130,246,0.08);
      border: 1px solid rgba(59,130,246,0.25);
      border-radius: 12px;
      padding: 16px 18px;
      color: #1E40AF;
      font-size: 14px;
      margin: 12px 0;
    }

    .warning {
      background: #FEF3C7;
      border-left: 4px solid #F59E0B;
      border-radius: 10px;
      padding: 16px 20px;
      color: #92400E;
      font-size: 14px;
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }

    .error-section-row td {
      background: #F8FAFC !important;
      font-weight: 700;
      color: #64748B;
    }

    .http-badge {
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Courier New', monospace;
      display: inline-block;
    }

    .http-400 { background: rgba(245,158,11,0.15); color: #B45309; }
    .http-401 { background: rgba(239,68,68,0.15); color: #B91C1C; }
    .http-422 { background: rgba(249,115,22,0.15); color: #C2410C; }
    .http-500 { background: rgba(71,85,105,0.15); color: #334155; }

    .events-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .event-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
    }

    .event-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .event-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #3B82F6, #8B5CF6);
      color: #fff;
      display: grid;
      place-items: center;
    }

    .event-meta h4 { margin: 0; font-size: 15px; }
    .event-meta span { color: #94A3B8; font-size: 13px; }

    .event-item {
      padding: 10px 0;
      border-bottom: 1px solid #F1F5F9;
    }

    .event-item:last-child { border-bottom: 0; }
    .event-item code { color: #3B82F6; font-size: 14px; font-weight: 600; font-family: 'Courier New', monospace; }
    .event-item p { margin: 4px 0 0; color: #94A3B8; font-size: 13px; }

    .sdk-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .sdk-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      box-shadow: var(--shadow-card);
      transition: transform .2s ease, border-color .2s ease;
    }

    .sdk-card:hover { transform: translateY(-4px); border-color: #3B82F6; }

    .sdk-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }

    .sdk-lang { display: flex; align-items: center; gap: 12px; }

    .sdk-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #E2E8F0;
      display: grid;
      place-items: center;
      font-size: 20px;
      color: #334155;
      font-weight: 800;
    }

    .sdk-lang h4 { margin: 0; font-size: 20px; }

    .sdk-version {
      border-radius: 20px;
      padding: 4px 12px;
      background: #F1F5F9;
      color: #475569;
      font-size: 12px;
      font-weight: 600;
    }

    .install {
      background: #0F172A;
      border-radius: 8px;
      padding: 14px 16px;
      color: #E2E8F0;
      font-family: 'Courier New', monospace;
      font-size: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 12px 0 14px;
      gap: 8px;
    }

    .btn-outline {
      width: 100%;
      border: 1px solid #E2E8F0;
      background: #fff;
      color: #3B82F6;
      border-radius: 10px;
      height: 40px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      text-decoration: none;
      font-weight: 600;
    }

    .toc {
      position: sticky;
      top: calc(var(--utility-bar-height) + var(--sticky-gap));
      width: 100%;
