      <section class="doc-section" id="overview">
        <h2 class="section-title">Overview</h2>
        <p class="section-desc">ZenoPay API is built around predictable REST principles with JSON request/response bodies and robust idempotency handling.</p>

        <div class="endpoint-head" id="create-payment">
          <span class="method method-post">POST</span>
          <span class="endpoint-url">/payments</span>
        </div>
        <p class="desc-p">Create a payment intent and receive a checkout URL for hosted payment completion.</p>

        <div class="auth-banner"><i class="fas fa-lock"></i><span><strong>Requires Authentication</strong> — Include <code>Authorization: Bearer {api_key}</code> in header</span></div>

        <div class="code-block" data-codeblock>
          <div class="code-block-header">
            <div class="lang-tabs">
              <button class="lang-tab active" data-lang="curl">cURL</button>
              <button class="lang-tab" data-lang="node">Node.js</button>
              <button class="lang-tab" data-lang="php">PHP</button>
              <button class="lang-tab" data-lang="python">Python</button>
              <button class="lang-tab" data-lang="java">Java</button>
            </div>
            <button class="copy-btn" data-copy><i class="fas fa-copy"></i> Copy</button>
          </div>

          <pre class="code-content code-pane active" data-pane="curl"><span class="token-keyword">curl</span> <span class="token-string">-X POST https://api.zenopay.in/v2/payments</span> \
  <span class="token-keyword">-H</span> <span class="token-string">"Authorization: Bearer sk_test_xxxxxxxxxxxx"</span> \
  <span class="token-keyword">-H</span> <span class="token-string">"Content-Type: application/json"</span> \
  <span class="token-keyword">-d</span> <span class="token-string">'{
    "amount": 5000,
    "currency": "INR",
    "order_id": "ORD_1029",
    "customer": { "email": "john@example.com" }
  }'</span></pre>

          <pre class="code-content code-pane" data-pane="node"><span class="token-keyword">const</span> client = <span class="token-keyword">new</span> ZenoPay({ apiKey: <span class="token-string">'sk_test_xxxxxxxxxxxx'</span> });
<span class="token-keyword">const</span> payment = <span class="token-keyword">await</span> client.payments.create({
  <span class="token-key">amount</span>: <span class="token-number">5000</span>,
  <span class="token-key">currency</span>: <span class="token-string">'INR'</span>,
  <span class="token-key">order_id</span>: <span class="token-string">'ORD_1029'</span>
});</pre>

          <pre class="code-content code-pane" data-pane="php">$client = <span class="token-keyword">new</span> ZenoPay\Client(<span class="token-string">'sk_test_xxxxxxxxxxxx'</span>);
$payment = $client->payments->create([
  <span class="token-key">'amount'</span> => <span class="token-number">5000</span>,
  <span class="token-key">'currency'</span> => <span class="token-string">'INR'</span>
]);</pre>

          <pre class="code-content code-pane" data-pane="python">client = zenopay.Client(api_key=<span class="token-string">"sk_test_xxxxxxxxxxxx"</span>)
payment = client.payments.create({
  <span class="token-key">"amount"</span>: <span class="token-number">5000</span>,
  <span class="token-key">"currency"</span>: <span class="token-string">"INR"</span>
})</pre>

          <pre class="code-content code-pane" data-pane="java">ZenoPayClient client = <span class="token-keyword">new</span> ZenoPayClient(<span class="token-string">"sk_test_xxxxxxxxxxxx"</span>);
Payment payment = client.payments().create(Map.of(
  <span class="token-string">"amount"</span>, <span class="token-number">5000</span>,
  <span class="token-string">"currency"</span>, <span class="token-string">"INR"</span>
));</pre>
        </div>

        <h3 class="table-title"><i class="fas fa-table"></i> Request Parameters</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Parameter</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">amount</span></td><td><span class="type-badge type-number">number</span></td><td><span class="required">● Required</span></td><td>Amount in paise (e.g. ₹50.00 = 5000).</td></tr>
              <tr><td><span class="param-name">currency</span></td><td><span class="type-badge type-string">string</span></td><td><span class="required">● Required</span></td><td>Three-letter ISO code, default <code>INR</code>.</td></tr>
              <tr><td><span class="param-name">order_id</span></td><td><span class="type-badge type-string">string</span></td><td><span class="optional">— Optional</span></td><td>Merchant reference order identifier.</td></tr>
              <tr><td><span class="param-name">customer</span></td><td><span class="type-badge type-object">object</span></td><td><span class="optional">— Optional</span></td><td>Customer payload with email/phone/name.</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="table-title"><i class="fas fa-reply"></i> Response</h3>
        <div class="status-tabs" data-status-tabs>
          <button class="status-tab status-ok active" data-status="ok">200 OK</button>
          <button class="status-tab status-bad" data-status="bad">400 Bad Request</button>
          <button class="status-tab status-auth" data-status="auth">401 Unauthorized</button>
          <button class="status-tab status-val" data-status="val">422 Validation Error</button>
          <button class="status-tab status-server" data-status="server">500 Server Error</button>
        </div>

        <div class="code-block">
          <pre class="code-content" id="responseCodeBlock">{
  "id": "pay_9Qx1kL2z",
  "status": "created",
  "amount": 5000,
  "currency": "INR",
