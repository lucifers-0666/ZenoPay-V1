<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= author.FullName %> — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/blog.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="page-transition-ready">
  <%- include('../partials/navbar') %>

  <section class="blog-sub-hero" style="--hero-color: linear-gradient(135deg, #1E0A3C 0%, #2D1B69 35%, #4A2680 65%, #6B3FA0 100%)">
    <div class="blog-sub-hero-bg"></div>
    <div class="container">
      <nav class="blog-breadcrumb">
        <a href="/">Home</a>
        <i class="fas fa-chevron-right"></i>
        <a href="/blog">Blog</a>
        <i class="fas fa-chevron-right"></i>
        <span><%= author.FullName %></span>
      </nav>
      <div class="author-hero-layout">
        <div class="author-hero-avatar">
          <div class="author-avatar-initials"><%= author.FullName.split(' ').map((n) => n[0]).join('').toUpperCase().substring(0, 2) %></div>
        </div>
        <div class="author-hero-info">
          <span class="author-role-badge"><i class="fas fa-pen-nib"></i> Author</span>
          <h1 class="blog-sub-hero-title"><%= author.FullName %></h1>
          <p class="blog-sub-hero-subtitle"><%= author.Email || 'Writer at ZenoPay' %></p>
          <div class="author-stats-row">
            <span class="author-stat"><i class="fas fa-newspaper"></i> <%= totalPosts || postCount || 0 %> articles</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="modern-main blog-main">
    <div class="container">
      <div class="blog-list-topbar">
        <p class="blog-list-info">Articles by <strong><%= author.FullName %></strong></p>
        <a href="/blog" class="back-to-blog-btn"><i class="fas fa-arrow-left"></i> All Articles</a>
      </div>

      <div class="blog-posts-grid">
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach((post) => { %>
            <% const catName = (post.category_id && post.category_id.name) ? post.category_id.name : 'General'; %>
            <article class="blog-card" onclick="window.location='/blog/<%= post.slug %>'">
              <div class="blog-card-progress"></div>
              <div class="blog-card-img-wrap">
                <img
                  src="<%= post.image || post.featured_image?.url || 'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=450&fit=crop&auto=format&q=80' %>"
                  alt="<%= post.title %>"
                  loading="lazy"
                  onerror="this.onerror=null;const fallbacks={'Payment Solutions':'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=450&fit=crop&auto=format&q=80','Security & Compliance':'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=800&h=450&fit=crop&auto=format&q=80','Developer Guides':'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&h=450&fit=crop&auto=format&q=80','Industry News':'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800&h=450&fit=crop&auto=format&q=80','Product Updates':'https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&h=450&fit=crop&auto=format&q=80','Business Tips':'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=450&fit=crop&auto=format&q=80','Case Studies':'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=450&fit=crop&auto=format&q=80'};this.src=fallbacks['<%= catName %>']||'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=450&fit=crop&auto=format&q=80'"
                />
                <div class="blog-card-readtime-overlay"><i class="fas fa-clock"></i> <%= post.reading_time_minutes || 5 %> min</div>
              </div>
              <div class="blog-card-body">
                <h3 class="blog-card-title"><%= post.title %></h3>
                <p class="blog-card-excerpt"><%= post.excerpt || '' %></p>
                <div class="blog-card-footer">
                  <div class="blog-card-date" style="font-size:0.75rem;color:#94A3B8;"><%= new Date(post.published_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                  <a href="/blog/<%= post.slug %>" class="blog-card-read-btn" onclick="event.stopPropagation()">Read <i class="fas fa-arrow-right"></i></a>
                </div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="blog-empty-state">
            <div class="empty-icon"><i class="fas fa-user"></i></div>
            <h3>No articles yet</h3>
            <p>This author has no published posts.</p>
            <a href="/blog" class="btn-primary">Browse All Articles</a>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/blog-animations.js"></script>
</body>
</html>
