<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= category.name %> — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/blog.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="page-transition-ready">
  <%- include('../partials/navbar') %>

  <% 
    const CAT_CONFIG = {
      'payment-solutions': {
        name: 'Payment Solutions',
        icon: 'fas fa-credit-card',
        desc: 'How-to guides, tutorials, and best practices for accepting payments',
        color: 'linear-gradient(135deg,rgba(29,78,216,0.92) 0%,rgba(79,70,229,0.92) 50%,rgba(107,63,160,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'security-compliance': {
        name: 'Security & Compliance',
        icon: 'fas fa-shield-halved',
        desc: 'Stay secure and compliant with RBI, PCI DSS, and fraud prevention',
        color: 'linear-gradient(135deg,rgba(6,95,70,0.93) 0%,rgba(5,150,105,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'developer-guides': {
        name: 'Developer Guides',
        icon: 'fas fa-code',
        desc: 'API docs, webhooks, SDKs and integration tutorials',
        color: 'linear-gradient(135deg,rgba(76,29,149,0.93) 0%,rgba(124,58,237,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'industry-news': {
        name: 'Industry News',
        icon: 'fas fa-newspaper',
        desc: 'Latest trends, RBI updates, and fintech industry news',
        color: 'linear-gradient(135deg,rgba(146,64,14,0.93) 0%,rgba(217,119,6,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'product-updates': {
        name: 'Product Updates',
        icon: 'fas fa-rocket',
        desc: 'New features, improvements, and product announcements',
        color: 'linear-gradient(135deg,rgba(159,18,57,0.93) 0%,rgba(225,29,72,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'business-tips': {
        name: 'Business Tips',
        icon: 'fas fa-lightbulb',
        desc: 'Growth strategies and best practices for merchants',
        color: 'linear-gradient(135deg,rgba(20,83,45,0.93) 0%,rgba(22,163,74,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1400&h=400&fit=crop&auto=format&q=60',
      },
      'case-studies': {
        name: 'Case Studies',
        icon: 'fas fa-chart-line',
        desc: 'Real success stories from businesses using ZenoPay',
        color: 'linear-gradient(135deg,rgba(88,28,135,0.93) 0%,rgba(147,51,234,0.9) 100%)',
        heroBg: 'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1400&h=400&fit=crop&auto=format&q=60',
      },
    };

    const cfg = CAT_CONFIG[category.slug] || {
      icon: 'fas fa-folder',
      desc: category.description || 'Articles in this category',
      color: 'linear-gradient(135deg,#1E0A3C 0%, #6B3FA0 100%)'
    };

    function getCategoryName(post) {
      return post?.category_id?.name || category.name || 'General';
    }

    function getCategoryClass(catName) {
      const map = {
        'Payment Solutions': 'badge-payment-solutions',
        'Security & Compliance': 'badge-security-compliance',
        'Developer Guides': 'badge-developer-guides',
        'Industry News': 'badge-industry-news',
        'Product Updates': 'badge-product-updates',
        'Business Tips': 'badge-business-tips',
        'Case Studies': 'badge-case-studies',
      };
      return map[catName] || 'badge-default';
    }

    function getImage(post) {
      return post?.image || post?.featured_image?.url || 'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=450&fit=crop&auto=format&q=80';
    }

    function pageLink(pageNo) {
      return '/blog/category/' + encodeURIComponent(slug || category.slug) + '?page=' + pageNo + '&sort=' + encodeURIComponent(currentSort || 'latest');
    }
  %>

  <%- include('./partials/blog-sub-header', {
    title: category.name,
    subtitle: cfg.desc,
    icon: cfg.icon,
    breadcrumb: category.name,
    heroClass: 'blog-sub-hero-img',
    heroStyle: '--hero-color: ' + cfg.color + '; --hero-bg-img: url(\'' + cfg.heroBg + '\')',
    count: totalPosts
  }) %>

  <main class="modern-main blog-main">
    <div class="container">
      <div class="blog-list-topbar">
        <p class="blog-list-info">Showing <strong><%= posts.length %></strong> of <strong><%= totalPosts %></strong> articles</p>
        <div class="blog-sort-wrap">
          <span class="blog-sort-label">Sort by:</span>
          <select class="blog-sort-select" onchange="window.location.href='/blog/category/<%= slug || category.slug %>?sort=' + this.value">
            <option value="latest" <%= currentSort === 'latest' ? 'selected' : '' %>>Latest</option>
            <option value="popular" <%= currentSort === 'popular' ? 'selected' : '' %>>Popular</option>
            <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
          </select>
        </div>
      </div>

      <div class="blog-posts-grid">
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach((post) => { %>
            <article class="blog-card" onclick="window.location='/blog/<%= post.slug %>'">
              <div class="blog-card-progress"></div>
              <div class="blog-card-img-wrap">
                <img
                  src="<%= getImage(post) %>"
                  alt="<%= post.title %>"
                  loading="lazy"
                  onerror="this.onerror=null;const fallbacks={'Payment Solutions':'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=450&fit=crop&auto=format&q=80','Security & Compliance':'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=800&h=450&fit=crop&auto=format&q=80','Developer Guides':'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&h=450&fit=crop&auto=format&q=80','Industry News':'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800&h=450&fit=crop&auto=format&q=80','Product Updates':'https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&h=450&fit=crop&auto=format&q=80','Business Tips':'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=450&fit=crop&auto=format&q=80','Case Studies':'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=450&fit=crop&auto=format&q=80'};this.src=fallbacks['<%= getCategoryName(post) %>']||'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=450&fit=crop&auto=format&q=80'"
                />
                <div class="blog-card-badge-overlay">
                  <span class="badge <%= getCategoryClass(getCategoryName(post)) %>"><%= getCategoryName(post) %></span>
                </div>
                <div class="blog-card-readtime-overlay"><i class="fas fa-clock"></i> <%= post.reading_time_minutes || 5 %> min</div>
              </div>
              <div class="blog-card-body">
                <h3 class="blog-card-title"><%= post.title %></h3>
                <p class="blog-card-excerpt"><%= post.excerpt || '' %></p>
                <div class="blog-card-footer">
                  <div class="blog-card-author">
                    <div class="blog-card-avatar"><%= ((post.author_id?.FullName || 'Z')[0]).toUpperCase() %></div>
                    <div>
                      <div class="blog-card-author-name"><%= post.author_id?.FullName || 'ZenoPay Team' %></div>
                      <div class="blog-card-date"><%= new Date(post.published_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                    </div>
                  </div>
                  <a href="/blog/<%= post.slug %>" class="blog-card-read-btn" onclick="event.stopPropagation()">Read <i class="fas fa-arrow-right"></i></a>
                </div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="blog-empty-state">
            <div class="empty-icon"><i class="<%= cfg.icon %>"></i></div>
            <h3>No articles yet</h3>
            <p>We’re working on new content for this category.</p>
            <a href="/blog" class="btn-primary">Browse All Articles</a>
          </div>
        <% } %>
      </div>

      <div class="related-categories-bar">
        <h4>
          <i class="fas fa-th-large"></i>
          Explore Other Categories
        </h4>
        <div class="related-categories-grid">
          <% const otherCats = Object.entries(CAT_CONFIG)
            .filter(([s]) => s !== (slug || category.slug))
            .slice(0, 4);
            otherCats.forEach(([s, c]) => { %>
            <a href="/blog/category/<%= s %>" class="related-cat-card">
              <i class="<%= c.icon %>"></i>
              <%= c.name %>
              <i class="fas fa-arrow-right related-cat-arrow"></i>
            </a>
          <% }) %>
        </div>
      </div>

      <% if (totalPages > 1) { %>
        <div class="blog-pagination">
          <a href="<%= pageLink(currentPage - 1) %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"><i class="fas fa-chevron-left"></i></a>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="<%= pageLink(i) %>" class="page-btn <%= i === currentPage ? 'page-active' : '' %>"><%= i %></a>
          <% } %>
          <a href="<%= pageLink(currentPage + 1) %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"><i class="fas fa-chevron-right"></i></a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/blog-animations.js"></script>
</body>
</html>
