<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= confirmed ? 'Subscribed!' : 'Invalid Link' %> — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/blog.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="page-transition-ready">
<%- include('../partials/navbar') %>

<section class="newsletter-page-section">
  <div class="container">
    <div class="newsletter-page-card animate-fade-up">

      <% if (confirmed) { %>

      <div class="nl-success-animation">
        <div class="nl-icon nl-icon-success animate-pop">
          <i class="fas fa-circle-check"></i>
        </div>
        <div class="nl-confetti">
          <span></span><span></span>
          <span></span><span></span>
          <span></span><span></span>
          <span></span><span></span>
        </div>
      </div>

      <h1 class="nl-title">You're Subscribed! 🎊</h1>
      <p class="nl-desc">
        Welcome to the ZenoPay newsletter.
        Your first issue will arrive soon!
      </p>

      <div class="nl-what-to-expect">
        <h4>
          <i class="fas fa-gift" style="color:#6B3FA0;margin-right:7px;"></i>
          What you'll receive:
        </h4>
        <ul>
          <li><i class="fas fa-check-circle" style="color:#10B981;"></i> Weekly fintech industry insights</li>
          <li><i class="fas fa-check-circle" style="color:#10B981;"></i> ZenoPay product updates &amp; new features</li>
          <li><i class="fas fa-check-circle" style="color:#10B981;"></i> Payment security tips &amp; compliance guides</li>
          <li><i class="fas fa-check-circle" style="color:#10B981;"></i> Exclusive merchant offers</li>
        </ul>
      </div>

      <div class="nl-action-group">
        <a href="/blog" class="btn-primary">
          Read Latest Articles
          <i class="fas fa-arrow-right"></i>
        </a>
        <a href="/" class="btn-outline-purple">Go to ZenoPay</a>
      </div>

      <% } else { %>

      <div class="nl-icon nl-icon-error animate-shake">
        <i class="fas fa-triangle-exclamation"></i>
      </div>

      <h1 class="nl-title">Invalid or Expired Link</h1>
      <p class="nl-desc">
        This confirmation link has expired
        or is no longer valid.<br>
        Please subscribe again to get
        a fresh link.
      </p>

      <div class="nl-action-group">
        <a href="/blog/newsletter/subscribe" class="btn-primary">
          <i class="fas fa-envelope"></i>
          Subscribe Again
        </a>
        <a href="/blog" class="btn-outline-purple">Back to Blog</a>
      </div>

      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<script src="/js/blog-animations.js"></script>
</body>
</html>
