<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Subscribe — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/blog.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="newsletter-page-hero">
    <div class="container">
      <div class="newsletter-page-card">
        <% if (success) { %>
          <div class="nl-icon nl-icon-success"><i class="fas fa-envelope-circle-check"></i></div>
          <h1 class="nl-title">Almost There! 🎉</h1>
          <p class="nl-desc">We've sent a confirmation email to <strong><%= email %></strong>. Please verify from your inbox.</p>
          <a href="/blog" class="btn-primary">Back to Blog</a>
        <% } else { %>
          <div class="nl-icon nl-icon-default"><i class="fas fa-envelope"></i></div>
          <h1 class="nl-title">Stay Ahead in Fintech</h1>
          <p class="nl-desc">Join our newsletter for weekly insights on payments and growth.</p>
          <form class="nl-form" onsubmit="subscribeFromPage(event)">
            <input type="email" class="nl-input" id="newsletterEmailPage" placeholder="Your email address" required />
            <button type="submit" class="btn-primary nl-submit-btn"><i class="fas fa-paper-plane"></i> Subscribe for Free</button>
          </form>
          <p class="nl-privacy"><i class="fas fa-lock" style="color:#10B981;"></i> No spam ever. Unsubscribe anytime.</p>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    function subscribeFromPage(event) {
      event.preventDefault();
      const email = document.getElementById('newsletterEmailPage').value;
      fetch('/blog/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'newsletter_page' })
      })
      .then((r) => r.json())
      .then((data) => {
        alert(data.message || 'Please check your inbox to confirm.');
        window.location.reload();
      })
      .catch(() => alert('Subscription failed. Please try again.'));
    }
  </script>
</body>
</html>
