<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unsubscribed — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/blog.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="page-transition-ready">
<%- include('../partials/header') %>

<main class="modern-main">
<section class="newsletter-page-section">
  <div class="container">
    <div class="newsletter-page-card animate-fade-up">

      <% if (unsubscribed) { %>

      <div class="nl-icon nl-icon-muted animate-float">
        <i class="fas fa-bell-slash"></i>
      </div>

      <h1 class="nl-title">You've Unsubscribed</h1>
      <p class="nl-desc">
        You've been removed from the
        ZenoPay newsletter.<br>
        We're sorry to see you go!
      </p>

      <div class="nl-resubscribe-box">
        <i class="fas fa-heart" style="color:#E11D48;font-size:1.2rem;display:block;margin-bottom:8px;"></i>
        <p>Changed your mind?</p>
        <a href="/blog/newsletter/subscribe" class="nl-resubscribe-link">Subscribe again →</a>
      </div>

      <div class="nl-action-group">
        <a href="/blog" class="btn-outline-purple">
          <i class="fas fa-arrow-left"></i>
          Back to Blog
        </a>
      </div>

      <% } else { %>

      <div class="nl-icon nl-icon-error animate-shake">
        <i class="fas fa-triangle-exclamation"></i>
      </div>
      <h1 class="nl-title">Invalid Link</h1>
      <p class="nl-desc">
        This unsubscribe link is invalid
        or has already been used.
      </p>
      <div class="nl-action-group">
        <a href="/blog" class="btn-primary">Back to Blog</a>
      </div>

      <% } %>
    </div>
  </div>
</section>
</main>

<%- include('../partials/footer') %>
<script src="/js/header.js"></script>
<script src="/js/blog-animations.js"></script>
</body>
</html>
