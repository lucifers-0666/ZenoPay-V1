<section class="blog-sub-hero <%= heroClass || '' %>" style="<%= heroStyle || ('--hero-color: ' + (bgColor || 'linear-gradient(135deg, #1E0A3C 0%, #2D1B69 35%, #4A2680 65%, #6B3FA0 100%)')) %>">
  <div class="blog-sub-hero-bg"></div>
  <div class="container">
    <nav class="blog-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <a href="/blog">Blog</a>
      <i class="fas fa-chevron-right"></i>
      <span><%= breadcrumb %></span>
    </nav>

    <div class="blog-sub-hero-content">
      <div class="blog-sub-hero-icon">
        <i class="<%= icon %>"></i>
      </div>
      <div>
        <h1 class="blog-sub-hero-title"><%= title %></h1>
        <p class="blog-sub-hero-subtitle"><%= subtitle %></p>
        <% if (typeof count !== 'undefined') { %>
          <span class="blog-sub-count-badge">
            <i class="fas fa-newspaper"></i>
            <%= count %> article<%= count !== 1 ? 's' : '' %>
          </span>
        <% } %>

        <div class="blog-sub-quick-links">
          <a href="/blog"><i class="fas fa-house"></i> All Posts</a>
          <a href="/blog/search?q=payments"><i class="fas fa-search"></i> Search</a>
          <a href="/blog/newsletter/subscribe"><i class="fas fa-envelope"></i> Newsletter</a>
        </div>
      </div>

    </div>
  </div>
</section>
