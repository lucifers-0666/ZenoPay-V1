<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search: "<%= query %>" — ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/blog.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="page-transition-ready">
  <%- include('../partials/navbar') %>

  <%- include('./partials/blog-sub-header', {
    title: 'Search Results',
    subtitle: (posts && posts.length > 0)
      ? ('Found ' + (totalPosts || posts.length) + ' article' + ((totalPosts || posts.length) !== 1 ? 's' : '') + ' for "' + query + '"')
      : ('No results found for "' + query + '"'),
    icon: 'fas fa-magnifying-glass',
    breadcrumb: 'Search Results',
    bgColor: 'linear-gradient(135deg, #1E0A3C 0%, #2D1B69 40%, #6B3FA0 100%)'
  }) %>

  <main class="modern-main blog-main">
    <div class="container">
      <form action="/blog/search" method="GET" class="search-hero-form" style="margin-bottom:24px;">
        <div class="blog-search-box" style="max-width:560px;">
          <i class="fas fa-search blog-search-icon"></i>
          <input type="text" name="q" value="<%= query %>" class="blog-search-input" placeholder="Search again..." />
          <button type="submit" class="blog-search-btn">Search</button>
        </div>
        <div class="blog-search-chips" style="margin-top:12px;">
          <span class="chip-label">Browse:</span>
          <a href="/blog/category/payment-solutions" class="search-chip">Payments</a>
          <a href="/blog/category/developer-guides" class="search-chip">Dev Guides</a>
          <a href="/blog/category/security-compliance" class="search-chip">Security</a>
          <a href="/blog/category/industry-news" class="search-chip">News</a>
        </div>
      </form>

      <% if (posts && posts.length > 0) { %>
        <div class="blog-list-topbar">
          <p class="blog-list-info"><strong><%= posts.length %></strong> of <strong><%= totalPosts || posts.length %></strong> results for <span class="search-query-highlight">"<%= query %>"</span></p>
          <div class="blog-sort-wrap">
            <span class="blog-sort-label">Sort by:</span>
            <select class="blog-sort-select" onchange="window.location.href='/blog/search?q=<%= encodeURIComponent(query) %>&sort=' + this.value">
              <option value="relevance" <%= currentSort === 'relevance' ? 'selected' : '' %>>Relevance</option>
              <option value="latest" <%= currentSort === 'latest' ? 'selected' : '' %>>Latest</option>
              <option value="popular" <%= currentSort === 'popular' ? 'selected' : '' %>>Popular</option>
            </select>
          </div>
        </div>

        <div class="search-results-list">
          <% posts.forEach((post) => { %>
            <% const catName = (post.category_id && post.category_id.name) ? post.category_id.name : 'General'; %>
            <article class="search-result-card" onclick="window.location='/blog/<%= post.slug %>'">
              <div class="search-result-img">
                <img
                  src="<%= post.image || post.featured_image?.url || 'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=300&h=200&fit=crop&auto=format&q=80' %>"
                  alt="<%= post.title %>"
                  loading="lazy"
                  onerror="this.onerror=null;const fallbacks={'Payment Solutions':'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=450&fit=crop&auto=format&q=80','Security & Compliance':'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=800&h=450&fit=crop&auto=format&q=80','Developer Guides':'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&h=450&fit=crop&auto=format&q=80','Industry News':'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800&h=450&fit=crop&auto=format&q=80','Product Updates':'https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&h=450&fit=crop&auto=format&q=80','Business Tips':'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=450&fit=crop&auto=format&q=80','Case Studies':'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=450&fit=crop&auto=format&q=80'};this.src=fallbacks['<%= catName %>']||'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=450&fit=crop&auto=format&q=80'"
                />
              </div>
              <div class="search-result-body">
                <div class="search-result-top">
                  <span class="badge badge-default"><%= post.category_id?.name || 'General' %></span>
                  <span class="search-result-meta">
                    <i class="fas fa-calendar"></i> <%= new Date(post.published_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    <span class="meta-dot">•</span>
                    <i class="fas fa-clock"></i> <%= post.reading_time_minutes || 5 %> min
                  </span>
                </div>
                <h3 class="search-result-title"><%= post.title %></h3>
                <p class="search-result-excerpt"><%- post.excerpt || '' %></p>
                <div class="search-result-footer">
                  <span class="search-result-url" data-url="/blog/<%= post.slug %>">/blog/<%= post.slug %></span>
                  <a href="/blog/<%= post.slug %>" class="blog-card-read-btn" onclick="event.stopPropagation()">Read Article <i class="fas fa-arrow-right"></i></a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
          <div class="blog-pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="/blog/search?q=<%= encodeURIComponent(query) %>&page=<%= i %>&sort=<%= encodeURIComponent(currentSort || 'relevance') %>" class="page-btn <%= i === currentPage ? 'page-active' : '' %>"><%= i %></a>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <div class="blog-no-results">
          <div class="no-results-icon"><i class="fas fa-search"></i></div>
          <h3>No results for "<%= query %>"</h3>
          <p>Try different keywords or browse categories.</p>
          <div class="no-results-suggestions">
            <h4>Suggested searches:</h4>
            <div class="tag-cloud" style="justify-content:center;">
              <% ['UPI', 'Payment Gateway', 'KYC', 'Security', 'API Integration', 'Fintech'].forEach((s) => { %>
                <a href="/blog/search?q=<%= encodeURIComponent(s) %>" class="tag-item"><%= s %></a>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/blog-animations.js"></script>
</body>
</html>
