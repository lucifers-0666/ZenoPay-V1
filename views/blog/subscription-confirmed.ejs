<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subscription Confirmed - ZenoPay Blog</title>
  <link rel="stylesheet" href="/css/global-fonts.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: var(--zenopay-font-sans);
      background: linear-gradient(135deg, #7c5cdb 0%, #6b47b8 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .message-card {
      background: white;
      border-radius: 10px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      padding: 60px 40px;
      text-align: center;
      max-width: 500px;
    }

    .success-icon {
      width: 80px;
      height: 80px;
      background: #4CAF50;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      margin: 0 auto 30px;
    }

    .message-card h1 {
      color: #333;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .message-card p {
      color: #666;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .email-highlight {
      background: #f0f0f0;
      padding: 10px 15px;
      border-radius: 5px;
      color: #7c5cdb;
      font-weight: 600;
      display: inline-block;
      margin: 10px 0;
    }

    .btn {
      padding: 12px 30px;
      border-radius: 5px;
      text-decoration: none;
      display: inline-block;
      margin: 10px 5px;
    }

    .btn-primary {
      background: #7c5cdb;
      color: white;
    }

    .btn-primary:hover {
      background: #6b47b8;
      color: white;
    }

    .btn-secondary {
      background: #f0f0f0;
      color: #333;
    }

    .btn-secondary:hover {
      background: #e0e0e0;
      color: #333;
    }
  </style>
</head>
<body>
  <div class="message-card">
    <div class="success-icon">
      <i class="fas fa-check"></i>
    </div>
    <h1>Subscription Confirmed!</h1>
    <p>Thank you for subscribing to the ZenoPay Blog newsletter.</p>
    <div class="email-highlight">
      <%= email %>
    </div>
    <p style="margin-top: 20px;">
      You'll now receive our latest articles, updates, and fintech insights directly in your inbox.
      <br><br>
      <small>Check your inbox for our first newsletter coming soon!</small>
    </p>
    <div>
      <a href="/blog" class="btn btn-primary">
        <i class="fas fa-newspaper"></i> Read Blog
      </a>
      <a href="/" class="btn btn-secondary">
        <i class="fas fa-home"></i> Back Home
      </a>
    </div>
  </div>
</body>
</html>
