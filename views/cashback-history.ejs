<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    body { margin:0; font-family: Inter, Arial, sans-serif; background: linear-gradient(180deg,#f8fbff 0%,#f8fafc 220px); color:#0f172a; }
    .wrap { max-width: 1100px; margin: 24px auto; padding: 0 16px; }
    .summary { background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; padding:14px; margin-bottom:12px; }
    .list-item { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:14px; margin-bottom:12px; box-shadow:0 8px 20px rgba(2,6,23,.04); }
    .muted { color:#64748b; font-size:13px; }
    .row { display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap; }
    .status-pill { display:inline-flex; align-items:center; border-radius:999px; padding:4px 10px; font-size:12px; font-weight:700; text-transform:capitalize; }
    .status-pill.credited { background:#dcfce7; color:#166534; }
    .status-pill.pending { background:#fef3c7; color:#92400e; }
    .status-pill.failed { background:#fee2e2; color:#991b1b; }
    .empty { text-align:center; padding:28px; border:1px dashed #cbd5e1; border-radius:12px; color:#64748b; background:#fff; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="wrap">
    <h1>Cashback History</h1>
    <% if (previewMode) { %>
      <div class="summary" style="border-left:4px solid #2563eb;">
        Preview mode: Sign in to load cashback earned from your real transactions.
      </div>
    <% } %>
    <div class="summary">
      <strong>Total Lifetime Cashback:</strong> ₹<%= Number(totalLifetimeCashback || 0).toFixed(2) %>
    </div>

    <% if (cashbackRows && cashbackRows.length) { %>
      <% cashbackRows.forEach((row) => { %>
        <article class="list-item">
          <div class="row">
            <strong>₹<%= Number(row.amount || 0).toFixed(2) %> cashback</strong>
            <span class="status-pill <%= row.status %>"><%= row.status %></span>
          </div>
          <div class="muted" style="margin-top:6px;">Rate: <%= Number(row.percent || 0).toFixed(2) %>%</div>
          <% if (row.transactionId?._id) { %><div class="muted">Transaction Ref: <%= row.transactionId._id %></div><% } %>
          <div class="muted">Created: <%= new Date(row.createdAt).toLocaleString('en-IN') %></div>
          <% if (row.creditedAt) { %><div class="muted">Credited At: <%= new Date(row.creditedAt).toLocaleString('en-IN') %></div><% } %>
        </article>
      <% }) %>
    <% } else { %>
      <section class="empty">
        <i class="fas fa-gift" style="font-size:20px;"></i>
        <h3>No cashback earned yet</h3>
        <p>Start sending money to earn cashback rewards.</p>
      </section>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
