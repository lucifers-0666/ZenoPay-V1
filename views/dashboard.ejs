<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZenoPay - Modern Payment Gateway | Accept Payments Globally</title>
  <meta name="description"
    content="Enterprise-grade payment infrastructure for businesses. Zero setup fees, instant settlements, 99.9% uptime. Trusted by 10,000+ businesses." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/premium-animations.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body class="modern-body">

  <!-- Modern Header (No Sidebar) -->
  <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="modern-main">

      <% if (isLoggedIn && user) { %>
        <!-- LOGGED IN USER VIEW -->

        <!-- Hero Section - Logged In -->
        <section class="hero-logged-in">
          <div class="hero-background"></div>
          <div class="container">
            <div class="hero-logged-content">
              <!-- Welcome Text -->
              <div class="welcome-section">
                <div class="eyebrow-badge">
                  <i class="fas fa-check-circle"></i>
                  <span>Welcome back</span>
                </div>
                <h1 class="hero-logged-title">Hello, <%= user.Name %>!</h1>
                <p class="hero-logged-subtitle">
                  Manage your payments seamlessly with enterprise-grade infrastructure
                </p>
              </div>

              <!-- Quick Stats Cards -->
              <div class="quick-stats-grid">
                <div class="quick-stat-card">
                  <div class="quick-stat-icon wallet">
                    <i class="fas fa-wallet"></i>
                  </div>
                  <div class="quick-stat-content">
                    <h3 class="quick-stat-value">₹0</h3>
                    <p class="quick-stat-label">Total Balance</p>
                    <span class="quick-stat-trend positive">
                      <i class="fas fa-arrow-up"></i> 0%
                    </span>
                  </div>
                </div>
                <div class="quick-stat-card">
                  <div class="quick-stat-icon transactions">
                    <i class="fas fa-exchange-alt"></i>
                  </div>
                  <div class="quick-stat-content">
                    <h3 class="quick-stat-value">0</h3>
                    <p class="quick-stat-label">Transactions</p>
                    <span class="quick-stat-trend">This month</span>
                  </div>
                </div>
                <div class="quick-stat-card">
                  <div class="quick-stat-icon growth">
                    <i class="fas fa-chart-line"></i>
                  </div>
                  <div class="quick-stat-content">
                    <h3 class="quick-stat-value">98.4%</h3>
                    <p class="quick-stat-label">Success Rate</p>
                    <span class="quick-stat-trend positive">
                      <i class="fas fa-arrow-up"></i> 2.1%
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions-section">
              <h2 class="section-title-small">Quick Actions</h2>
              <div class="quick-actions-grid">
                <a href="/send-to" class="quick-action-card">
                  <div class="quick-action-icon">
                    <i class="fas fa-paper-plane"></i>
                  </div>
                  <h3>Send Money</h3>
                  <p>Transfer funds instantly</p>
                </a>
                <a href="/Transaction-History" class="quick-action-card">
                  <div class="quick-action-icon">
                    <i class="fas fa-history"></i>
                  </div>
                  <h3>Transactions</h3>
                  <p>View your history</p>
                </a>
                <a href="/api-integration" class="quick-action-card">
                  <div class="quick-action-icon">
                    <i class="fas fa-code"></i>
                  </div>
                  <h3>API Keys</h3>
                  <p>Manage integration</p>
                </a>
                <a href="/Profile" class="quick-action-card">
                  <div class="quick-action-icon">
                    <i class="fas fa-user-circle"></i>
                  </div>
                  <h3>Profile</h3>
                  <p>Account settings</p>
                </a>
              </div>
            </div>
          </div>
        </section>

        <% } else { %>
          <!-- GUEST/NOT LOGGED IN VIEW -->

          <!-- Hero Section - Guest -->
          <section class="hero-guest">
            <div class="hero-guest-background"></div>
            <div class="hero-decorations">
              <div class="decoration-circle circle-1"></div>
              <div class="decoration-circle circle-2"></div>
            </div>

            <div class="container">
              <div class="hero-guest-grid">

                <!-- Left Column - Text Content -->
                <div class="hero-text-content">
                  <!-- Trust Badge -->
                  <div class="trust-badge">
                    <i class="fas fa-check-circle"></i>
                    <span>Trusted by 10,000+ Businesses</span>
                  </div>

                  <!-- Main Headline -->
                  <h1 class="hero-main-title">
                    Accept Payments Globally.
                    <span class="title-highlight">Get Paid Instantly.</span>
                  </h1>

                  <!-- Subheading -->
                  <p class="hero-main-subtitle">
                    Enterprise-grade payment infrastructure for businesses of all sizes.
                    Zero setup fees, transparent pricing, instant settlements.
                  </p>

                  <!-- CTA Buttons -->
                  <div class="hero-cta-group">
                    <a href="/register" class="btn-hero btn-hero-primary">
                      <i class="fas fa-rocket"></i>
                      <span>Start Free Trial</span>
                    </a>
                    <a href="#integration" class="btn-hero btn-hero-secondary">
                      <i class="fas fa-file-code"></i>
                      <span>View Documentation</span>
                    </a>
                  </div>

                  <div class="hero-live-ticker">
                    <span class="ticker-label">
                      <span class="ticker-dot"></span>
                      Live
                    </span>
                    <div class="ticker-track" id="tickerTrack">
                      <div class="ticker-item">
                        <i class="fas fa-circle-check" style="color:#10B981;"></i>
                        Priya S. received ₹12,500 via UPI
                      </div>
                      <div class="ticker-item">
                        <i class="fas fa-circle-check" style="color:#10B981;"></i>
                        Merchant #4821 settled ₹3,20,000
                      </div>
                      <div class="ticker-item">
                        <i class="fas fa-circle-check" style="color:#10B981;"></i>
                        API call processed in 0.8 seconds
                      </div>
                      <div class="ticker-item">
                        <i class="fas fa-circle-check" style="color:#10B981;"></i>
                        Rohan K. linked virtual account
                      </div>
                      <div class="ticker-item">
                        <i class="fas fa-circle-check" style="color:#10B981;"></i>
                        ₹45,000 payout completed instantly
                      </div>
                    </div>
                  </div>

                  <!-- Trust Badges Row -->
                  <div class="trust-badges-row">
                    <div class="trust-item">
                      <i class="fas fa-shield-alt"></i>
                      <span>PCI-DSS Certified</span>
                    </div>
                    <div class="trust-item">
                      <i class="fas fa-lock"></i>
                      <span>256-bit SSL</span>
                    </div>
                    <div class="trust-item">
                      <i class="fas fa-award"></i>
                      <span>ISO Certified</span>
                    </div>
                    <div class="trust-item">
                      <i class="fas fa-chart-line"></i>
                      <span>99.9% Uptime</span>
                    </div>
                  </div>
                </div>

                <!-- Right Column - Visual Element -->
                <div class="hero-visual-content">
                  <div class="dashboard-preview-card">
                    <div class="preview-header">
                      <div class="preview-dots">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                      </div>
                      <span class="preview-title">ZenoPay Dashboard</span>
                    </div>
                    <div class="preview-content">
                      <div class="preview-stat-row">
                        <span class="preview-label">Today's Revenue</span>
                        <span class="preview-value">₹45,280</span>
                      </div>
                      <div class="preview-mini-stats">
                        <div class="preview-mini-card cyan">
                          <div class="preview-mini-label">Transactions</div>
                          <div class="preview-mini-value">1,248</div>
                          <div class="preview-mini-trend">
                            <i class="fas fa-arrow-up"></i> 12.5%
                          </div>
                        </div>
                        <div class="preview-mini-card emerald">
                          <div class="preview-mini-label">Success Rate</div>
                          <div class="preview-mini-value">98.4%</div>
                          <div class="preview-mini-trend">
                            <i class="fas fa-arrow-up"></i> 2.1%
                          </div>
                        </div>
                      </div>
                      <div class="preview-chart"></div>
                    </div>
                  </div>

                  <!-- Floating stat card -->
                  <div class="floating-stat-card">
                    <div class="floating-stat-icon">
                      <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="floating-stat-info">
                      <div class="floating-stat-label">Payment Success</div>
                      <div class="floating-stat-amount">+₹2,450</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <% const safeStats = {
            activeUsers: (typeof stats !== 'undefined' && stats && typeof stats.activeUsers !== 'undefined') ? stats.activeUsers : 10000,
            processed: (typeof stats !== 'undefined' && stats && typeof stats.processed !== 'undefined') ? stats.processed : 500,
            uptime: (typeof stats !== 'undefined' && stats && typeof stats.uptime !== 'undefined') ? stats.uptime : 99.9,
            settlementTime: (typeof stats !== 'undefined' && stats && typeof stats.settlementTime !== 'undefined') ? stats.settlementTime : 2,
            countriesSupported: (typeof stats !== 'undefined' && stats && typeof stats.countriesSupported !== 'undefined') ? stats.countriesSupported : 22,
          }; %>

          <!-- Stats Section -->
          <section class="stats-section">
            <div class="container">
              <div class="stats-grid">

                <!-- Active Users -->
                <div class="stat-item stat-card">
                  <div class="stat-icon-wrapper cyan stat-icon stat-icon-blue">
                    <i class="fas fa-users"></i>
                  </div>
                  <div class="stat-number"
                    id="stat-users"
                    data-target="<%= safeStats.activeUsers %>"
                    data-suffix=""
                    data-prefix="">
                    0
                  </div>
                  <div class="stat-label">ACTIVE USERS</div>
                  <div class="stat-trend positive stat-badge stat-badge-green">
                    <i class="fas fa-arrow-trend-up"></i>
                    23% this month
                  </div>
                </div>

                <!-- Processed -->
                <div class="stat-item stat-card">
                  <div class="stat-icon-wrapper emerald stat-icon stat-icon-green">
                    <i class="fas fa-check-circle"></i>
                  </div>
                  <div class="stat-number"
                    id="stat-processed"
                    data-target="<%= safeStats.processed %>"
                    data-suffix="Cr+"
                    data-prefix="₹">
                    ₹0
                  </div>
                  <div class="stat-label">PROCESSED</div>
                  <div class="stat-trend positive stat-badge stat-badge-green">
                    <i class="fas fa-arrow-trend-up"></i>
                    45% growth
                  </div>
                </div>

                <!-- Uptime -->
                <div class="stat-item stat-card">
                  <div class="stat-icon-wrapper blue stat-icon stat-icon-blue-light">
                    <i class="fas fa-shield-halved"></i>
                  </div>
                  <div class="stat-number"
                    id="stat-uptime"
                    data-target="<%= safeStats.uptime %>"
                    data-suffix="%"
                    data-prefix="">
                    0%
                  </div>
                  <div class="stat-label">UPTIME</div>
                  <div class="stat-trend neutral stat-badge stat-badge-gray">
                    Last 12 months
                  </div>
                </div>

                <!-- Settlement Time -->
                <div class="stat-item stat-card">
                  <div class="stat-icon-wrapper amber stat-icon stat-icon-yellow">
                    <i class="fas fa-bolt"></i>
                  </div>
                  <div class="stat-number"
                    id="stat-settlement"
                    data-target="<%= safeStats.settlementTime %>"
                    data-suffix=" Sec"
                    data-prefix="">
                    0
                  </div>
                  <div class="stat-label">SETTLEMENT TIME</div>
                  <div class="stat-trend neutral stat-badge stat-badge-gray">
                    Industry fastest
                  </div>
                </div>

                <div class="stat-item stat-card">
                  <div class="stat-icon-wrapper stat-icon stat-icon-purple">
                    <i class="fas fa-earth-asia"></i>
                  </div>
                  <div class="stat-number"
                    data-target="<%= safeStats.countriesSupported %>"
                    data-suffix="+"
                    data-prefix="">
                    0
                  </div>
                  <div class="stat-label">COUNTRIES SUPPORTED</div>
                  <div class="stat-badge stat-badge-blue">
                    <i class="fas fa-globe"></i>
                    Cross-border payments
                  </div>
                </div>

              </div>
            </div>
          </section>

          <!-- Features Section -->
          <section class="features-section" id="features">
            <div class="container">

              <!-- Section Header -->
              <div class="section-header">
                <h2 class="section-title">Why Choose ZenoPay?</h2>
                <p class="section-subtitle">Join thousands who trust us for their financial needs</p>
              </div>

              <!-- Features Grid -->
              <div class="features-grid">

                <!-- Feature 1 -->
                <div class="feature-card">
                  <div class="feature-icon cyan">
                    <i class="fas fa-bolt"></i>
                  </div>
                  <h3 class="feature-title">Instant Transfers</h3>
                  <p class="feature-description">
                    Receive payments in under 2 seconds. Real-time settlement with zero delays.
                    Money hits your account instantly.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

                <!-- Feature 2 -->
                <div class="feature-card">
                  <div class="feature-icon emerald">
                    <i class="fas fa-shield-alt"></i>
                  </div>
                  <h3 class="feature-title">Bank-Level Security</h3>
                  <p class="feature-description">
                    Military-grade 256-bit encryption, PCI-DSS Level 1 certified, and
                    multi-layer fraud protection keeps your money safe.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

                <!-- Feature 3 -->
                <div class="feature-card">
                  <div class="feature-icon blue">
                    <i class="fas fa-mobile-alt"></i>
                  </div>
                  <h3 class="feature-title">Mobile First</h3>
                  <p class="feature-description">
                    Beautiful mobile apps for iOS and Android. Accept payments anywhere,
                    anytime with our optimized mobile experience.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

                <!-- Feature 4 -->
                <div class="feature-card">
                  <div class="feature-icon purple">
                    <i class="fas fa-percent"></i>
                  </div>
                  <h3 class="feature-title">Zero Hidden Fees</h3>
                  <p class="feature-description">
                    Transparent pricing with no setup costs, no monthly fees, no hidden charges.
                    Only pay for successful transactions.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

                <!-- Feature 5 -->
                <div class="feature-card">
                  <div class="feature-icon orange">
                    <i class="fas fa-qrcode"></i>
                  </div>
                  <h3 class="feature-title">QR Payments</h3>
                  <p class="feature-description">
                    Generate instant QR codes for UPI payments. Accept payments through
                    any UPI app with zero hassle.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

                <!-- Feature 6 -->
                <div class="feature-card">
                  <div class="feature-icon pink">
                    <i class="fas fa-headset"></i>
                  </div>
                  <h3 class="feature-title">24/7 Support</h3>
                  <p class="feature-description">
                    Round-the-clock customer support via chat, email, and phone.
                    Our team is always ready to help you succeed.
                  </p>
                  <a href="#" class="feature-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>

              </div>
            </div>
          </section>

          <section class="payment-methods-section" id="payment-methods">
            <div class="container">

              <div class="section-header">
                <span class="section-tag">Payment Methods</span>
                <h2 class="section-title">Accept Payments Any Way Your Customers Prefer</h2>
                <p class="section-subtitle">
                  From UPI to international cards — ZenoPay supports every major payment method in India and beyond.
                </p>
              </div>

              <div class="pm-tabs">
                <button class="pm-tab pm-tab-active" data-tab="upi" onclick="switchPMTab('upi', this)">UPI</button>
                <button class="pm-tab" data-tab="cards" onclick="switchPMTab('cards', this)">Cards</button>
                <button class="pm-tab" data-tab="netbanking" onclick="switchPMTab('netbanking', this)">Net Banking</button>
                <button class="pm-tab" data-tab="wallets" onclick="switchPMTab('wallets', this)">Wallets</button>
                <button class="pm-tab" data-tab="bnpl" onclick="switchPMTab('bnpl', this)">BNPL</button>
              </div>

              <div class="pm-content pm-content-active" id="tab-upi">
                <div class="pm-layout">
                  <div class="pm-left">
                    <h3 class="pm-title">India's #1 Payment Method</h3>
                    <p class="pm-desc">
                      Accept UPI payments from any app — GPay, PhonePe, Paytm, BHIM and 200+ more. Sub-second settlement directly to your account.
                    </p>
                    <ul class="pm-features">
                      <li><i class="fas fa-circle-check"></i>Instant settlement in &lt; 2 seconds</li>
                      <li><i class="fas fa-circle-check"></i>UPI AutoPay for subscriptions</li>
                      <li><i class="fas fa-circle-check"></i>Collect via QR code or payment link</li>
                      <li><i class="fas fa-circle-check"></i>Zero MDR on UPI transactions</li>
                    </ul>
                    <div class="pm-apps">
                      <span class="pm-app-chip">GPay</span>
                      <span class="pm-app-chip">PhonePe</span>
                      <span class="pm-app-chip">Paytm</span>
                      <span class="pm-app-chip">BHIM</span>
                      <span class="pm-app-chip">+200</span>
                    </div>
                  </div>
                  <div class="pm-right">
                    <div class="pm-visual pm-visual-upi">
                      <div class="pm-visual-card">
                        <div class="pm-visual-header">
                          <span>ZenoPay Checkout</span>
                          <span class="pm-visual-secure">🔒 Secure</span>
                        </div>
                        <div class="pm-visual-amount">₹2,499.00</div>
                        <div class="pm-visual-upi-input">
                          <i class="fas fa-mobile-screen" style="color:#6B3FA0;"></i>
                          <span style="color:#94A3B8;">yourname@upi</span>
                        </div>
                        <div class="pm-visual-apps-row">
                          <div class="pm-visual-app" style="background:#1A73E8;">G</div>
                          <div class="pm-visual-app" style="background:#5F259F;">P</div>
                          <div class="pm-visual-app" style="background:#002970;">B</div>
                          <div class="pm-visual-app" style="background:#00BAF2;">PT</div>
                        </div>
                        <div class="pm-visual-btn">Pay with UPI</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pm-content" id="tab-cards">
                <div class="pm-layout">
                  <div class="pm-left">
                    <h3 class="pm-title">All Major Cards Accepted</h3>
                    <p class="pm-desc">
                      Visa, Mastercard, RuPay, Amex — debit and credit cards from 150+ banks. EMI options available.
                    </p>
                    <ul class="pm-features">
                      <li><i class="fas fa-circle-check"></i>3D Secure 2.0 authentication</li>
                      <li><i class="fas fa-circle-check"></i>EMI up to 24 months on select banks</li>
                      <li><i class="fas fa-circle-check"></i>International cards supported</li>
                      <li><i class="fas fa-circle-check"></i>Saved cards with tokenization</li>
                    </ul>
                    <div class="pm-apps">
                      <span class="pm-app-chip">Visa</span>
                      <span class="pm-app-chip">Mastercard</span>
                      <span class="pm-app-chip">RuPay</span>
                      <span class="pm-app-chip">Amex</span>
                    </div>
                  </div>
                  <div class="pm-right">
                    <div class="pm-visual">
                      <div class="pm-visual-card card-style">
                        <div class="pm-card-chip"></div>
                        <div class="pm-card-number">•••• •••• •••• 4242</div>
                        <div class="pm-card-meta">
                          <span>VALID THRU 12/28</span>
                          <span>ROHIT SHARMA</span>
                        </div>
                        <div class="pm-card-networks">
                          <div class="pm-network-circle" style="background:#EB001B;"></div>
                          <div class="pm-network-circle" style="background:#F79E1B; margin-left:-10px; opacity:0.9;"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pm-content" id="tab-netbanking">
                <div class="pm-layout">
                  <div class="pm-left">
                    <h3 class="pm-title">150+ Banks Supported</h3>
                    <p class="pm-desc">
                      NEFT, RTGS, IMPS — all modes. Direct debit from SBI, HDFC, ICICI, Axis and 150+ more banks.
                    </p>
                    <ul class="pm-features">
                      <li><i class="fas fa-circle-check"></i>Real-time payment confirmation</li>
                      <li><i class="fas fa-circle-check"></i>IMPS for 24x7 instant transfers</li>
                      <li><i class="fas fa-circle-check"></i>Corporate net banking support</li>
                      <li><i class="fas fa-circle-check"></i>Bank-grade 256-bit SSL encryption</li>
                    </ul>
                  </div>
                  <div class="pm-right">
                    <div class="pm-banks-grid">
                      <% ['SBI','HDFC','ICICI','Axis','Kotak','PNB','BOB','IDBI','Yes Bank','IndusInd'].forEach((b) => { %>
                        <div class="pm-bank-chip"><%= b %></div>
                      <% }) %>
                      <div class="pm-bank-chip pm-bank-more">+140 more</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pm-content" id="tab-wallets">
                <div class="pm-layout">
                  <div class="pm-left">
                    <h3 class="pm-title">Top Wallets, One Integration</h3>
                    <p class="pm-desc">
                      Accept wallet payments from Paytm, Amazon Pay, Mobikwik and more with high conversion checkout flows.
                    </p>
                    <ul class="pm-features">
                      <li><i class="fas fa-circle-check"></i>One-click wallet checkout</li>
                      <li><i class="fas fa-circle-check"></i>Wallet cashback compatibility</li>
                      <li><i class="fas fa-circle-check"></i>Fast OTP-less repeat flow</li>
                      <li><i class="fas fa-circle-check"></i>Real-time success webhooks</li>
                    </ul>
                    <div class="pm-apps">
                      <span class="pm-app-chip">Paytm</span>
                      <span class="pm-app-chip">Amazon Pay</span>
                      <span class="pm-app-chip">Mobikwik</span>
                      <span class="pm-app-chip">Freecharge</span>
                    </div>
                  </div>
                  <div class="pm-right">
                    <div class="pm-visual">
                      <div class="pm-visual-card">
                        <div class="pm-visual-header">
                          <span>Wallet Checkout</span>
                          <span class="pm-visual-secure">⚡ Fast</span>
                        </div>
                        <div class="pm-visual-amount">₹899.00</div>
                        <div class="pm-visual-apps-row">
                          <div class="pm-visual-app" style="background:#00BAF2;">PT</div>
                          <div class="pm-visual-app" style="background:#FF9900;">AZ</div>
                          <div class="pm-visual-app" style="background:#0EA5E9;">MW</div>
                        </div>
                        <div class="pm-visual-btn">Pay with Wallet</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pm-content" id="tab-bnpl">
