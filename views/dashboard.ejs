<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZenoPay - Modern Payment Gateway | Accept Payments Globally</title>
  <meta name="description"
    content="Enterprise-grade payment infrastructure for businesses. Zero setup fees, instant settlements, 99.9% uptime. Trusted by 10,000+ businesses." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/premium-animations.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    /* ══════════════════════════════════════════════
       LOGGED-IN DASHBOARD — LIGHT COLOR SYSTEM
       Matching the site-wide premium fintech palette
    ══════════════════════════════════════════════ */
    :root {
      color-scheme: light;
      --primary: #3B82F6;
      --primary-dark: #2563EB;
      --primary-light: #60A5FA;
      --secondary: #8B5CF6;
      --secondary-dark: #7C3AED;
      --success: #10B981;
      --success-dark: #059669;
      --accent: #F59E0B;
      --accent-dark: #D97706;
      --primary-blue: #3B82F6;
      --primary-blue-light: #60A5FA;
      --primary-blue-lighter: #93C5FD;
      --white: #ffffff;
      --slate-50: #F8FAFC;
      --slate-100: #F1F5F9;
      --slate-200: #E2E8F0;
      --slate-300: #CBD5E1;
      --slate-400: #94A3B8;
      --slate-500: #6B7280;
      --slate-600: #475569;
      --slate-700: #374151;
      --slate-800: #2c3e50;
      --slate-900: #1F2937;
      --text-dark: #2c3e50;
      --text-light: #6c757d;
      --error: #dc3545;
      --warning: #F59E0B;
      --info: #456882;
      --gradient-start: #1E3A8A;
      --gradient-end: #5B21B6;
      --success-green: #10B981;
      --error-red: #EF4444;
      --warning-yellow: #F59E0B;
      --text-primary: #1F2937;
      --text-secondary: #6B7280;
      --text-light-2: #9CA3AF;
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9FAFB;
      --bg-tertiary: #F3F4F6;
      --border-light: #E5E7EB;
      --border-medium: #D1D5DB;
      --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
      --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
      --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
      --transition-fast: 150ms ease-in-out;
      --transition-base: 200ms ease-in-out;
      --transition-slow: 300ms ease-in-out;
    }

    /* ── Page wrapper ── */
    .zd-page {
      background: var(--bg-secondary);
      min-height: 100vh;
      color: var(--text-primary);
      font-family: 'Inter', sans-serif;
    }

    .zd-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ══════════════════════════════════════════════
       HERO BANNER
    ══════════════════════════════════════════════ */
    .zd-hero {
      position: relative;
      background: linear-gradient(135deg, var(--gradient-start) 0%, #2563EB 50%, var(--gradient-end) 100%);
      border-bottom: 1px solid var(--border-light);
      overflow: hidden;
      padding: 48px 0 56px;
    }
    .zd-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 600px 300px at 80% 50%, rgba(96,165,250,0.15) 0%, transparent 70%),
        radial-gradient(ellipse 400px 400px at 10% 80%, rgba(139,92,246,0.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .zd-hero-inner {
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
    }

    .zd-welcome { flex: 1; min-width: 260px; }
    .zd-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 4px 12px;
      border-radius: 99px;
      margin-bottom: 16px;
    }
    .zd-hero-title {
      font-size: clamp(1.75rem, 4vw, 2.4rem);
      font-weight: 800;
      color: #fff;
      margin: 0 0 10px;
      line-height: 1.2;
    }
    .zd-hero-title span { color: #93C5FD; }
    .zd-hero-sub {
      color: rgba(255,255,255,0.75);
      font-size: 15px;
      margin: 0 0 24px;
      line-height: 1.6;
    }

    .zd-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
    .zd-cta-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 8px; font-size: 14px;
      font-weight: 600; text-decoration: none; transition: all var(--transition-base);
    }
    .zd-cta-primary {
      background: #fff;
      color: var(--primary-dark);
      box-shadow: var(--shadow-md);
    }
    .zd-cta-primary:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .zd-cta-outline {
      background: rgba(255,255,255,0.12);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.35);
    }
    .zd-cta-outline:hover { background: rgba(255,255,255,0.22); }

    /* user id card */
    .zd-id-card {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 16px;
      padding: 20px 24px;
      min-width: 240px;
      backdrop-filter: blur(12px);
    }
    .zd-id-row { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .zd-avatar-ring {
      width: 52px; height: 52px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary-light), var(--secondary));
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; font-weight: 800; color: #fff; flex-shrink: 0;
    }
    .zd-id-name { font-size: 16px; font-weight: 700; color: #fff; }
    .zd-id-sub  { font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; }
    .zd-id-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .zd-chip {
      font-size: 11px; font-weight: 600; padding: 3px 10px;
      border-radius: 99px; border: 1px solid;
    }
    .zd-chip-green { color: #fff; border-color: rgba(16,185,129,.5); background: rgba(16,185,129,.35); }
    .zd-chip-blue  { color: #fff; border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.15); }

    /* ══════════════════════════════════════════════
       STAT CARDS ROW
    ══════════════════════════════════════════════ */
    .zd-stats { padding: 40px 0 0; }
    .zd-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }
    .zd-stat-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 22px 20px;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .zd-stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
      border-radius: 16px 16px 0 0;
    }
    .zd-stat-card.cyan::before  { background: linear-gradient(90deg, var(--primary), var(--primary-light)); }
    .zd-stat-card.green::before { background: linear-gradient(90deg, var(--success), var(--success-dark)); }
    .zd-stat-card.purple::before{ background: linear-gradient(90deg, var(--secondary), var(--secondary-dark)); }
    .zd-stat-card.amber::before { background: linear-gradient(90deg, var(--accent), var(--accent-dark)); }
    .zd-stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

    .zd-stat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .zd-stat-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center; font-size: 16px;
    }
    .zd-stat-icon.cyan   { background: #EFF6FF; color: var(--primary); }
    .zd-stat-icon.green  { background: #ECFDF5; color: var(--success); }
    .zd-stat-icon.purple { background: #F5F3FF; color: var(--secondary); }
    .zd-stat-icon.amber  { background: #FFFBEB; color: var(--accent); }

    .zd-stat-trend {
      font-size: 11px; font-weight: 600; padding: 3px 8px;
      border-radius: 99px; display: flex; align-items: center; gap: 4px;
    }
    .zd-stat-trend.up   { color: var(--success-dark); background: #ECFDF5; }
    .zd-stat-trend.down { color: var(--error-red); background: #FEF2F2; }
    .zd-stat-trend.neu  { color: var(--text-secondary); background: var(--bg-tertiary); }

    .zd-stat-val   { font-size: 26px; font-weight: 800; color: var(--text-primary); line-height: 1; margin-bottom: 4px; }
    .zd-stat-label { font-size: 13px; color: var(--text-secondary); }

    /* ══════════════════════════════════════════════
       SECTION TITLES
    ══════════════════════════════════════════════ */
    .zd-section { padding: 40px 0; }
    .zd-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .zd-section-title {
      font-size: 18px; font-weight: 700; color: var(--text-primary);
      display: flex; align-items: center; gap: 10px;
    }
    .zd-section-title i { color: var(--primary); font-size: 16px; }
    .zd-section-link {
      font-size: 13px; color: var(--primary); text-decoration: none;
      display: flex; align-items: center; gap: 4px; font-weight: 500;
    }
    .zd-section-link:hover { color: var(--primary-dark); }

    .zd-alert-wrap { margin-top: 18px; }
    .zd-alert-success {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: #ECFDF5;
      border: 1px solid #A7F3D0;
      color: #065F46;
      border-radius: 12px;
      padding: 12px 14px;
      box-shadow: var(--shadow-sm);
      font-size: 13.5px;
      font-weight: 600;
    }
    .zd-alert-msg { display: inline-flex; align-items: center; gap: 8px; }
    .zd-alert-close {
      border: 0;
      background: transparent;
      color: #047857;
      font-size: 15px;
      cursor: pointer;
      line-height: 1;
      padding: 2px;
    }

    /* ══════════════════════════════════════════════
       QUICK ACTIONS
    ══════════════════════════════════════════════ */
    .zd-actions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px;
    }
    .zd-action-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 20px 16px;
      text-decoration: none;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      transition: all var(--transition-base);
      text-align: center;
      box-shadow: var(--shadow-sm);
    }
    .zd-action-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary-light);
      box-shadow: 0 8px 24px rgba(59,130,246,0.15);
    }
    .zd-action-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; font-size: 18px;
    }
    .zd-action-icon.c1 { background: #EFF6FF; color: var(--primary); }
    .zd-action-icon.c2 { background: #ECFDF5; color: var(--success); }
    .zd-action-icon.c3 { background: #F5F3FF; color: var(--secondary); }
    .zd-action-icon.c4 { background: #FFFBEB; color: var(--accent); }
    .zd-action-icon.c5 { background: #FEF2F2; color: var(--error-red); }
    .zd-action-icon.c6 { background: #EFF6FF; color: var(--primary-dark); }
    .zd-action-icon.c7 { background: #ECFDF5; color: var(--success-dark); }
    .zd-action-icon.c8 { background: #FFF7ED; color: var(--accent-dark); }

    .zd-action-label { font-size: 13px; font-weight: 600; color: var(--text-primary); line-height: 1.3; }
    .zd-action-sub   { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }

    /* ══════════════════════════════════════════════
       RECENT TRANSACTIONS TABLE
    ══════════════════════════════════════════════ */
    .zd-txn-table {
      background: var(--bg-primary);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .zd-txn-row {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 20px;
      border-bottom: 1px solid var(--border-light);
      transition: background var(--transition-fast);
    }
    .zd-txn-row:last-child { border-bottom: none; }
    .zd-txn-row:hover { background: var(--slate-50); }
    .zd-txn-icon {
      width: 38px; height: 38px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 15px;
    }
    .zd-txn-icon.credit  { background: #ECFDF5; color: var(--success); }
    .zd-txn-icon.debit   { background: #FEF2F2; color: var(--error-red); }
    .zd-txn-icon.pending { background: #FFFBEB; color: var(--accent); }
    .zd-txn-info { flex: 1; min-width: 0; }
    .zd-txn-name { font-size: 14px; font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .zd-txn-time { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
    .zd-txn-amount { font-size: 15px; font-weight: 700; white-space: nowrap; }
    .zd-txn-amount.credit  { color: var(--success-dark); }
    .zd-txn-amount.debit   { color: var(--error-red); }
    .zd-txn-amount.pending { color: var(--accent-dark); }
    .zd-txn-status {
      font-size: 11px; font-weight: 600; padding: 3px 10px;
      border-radius: 99px; white-space: nowrap;
    }
    .zd-txn-status.s-ok   { color: var(--success-dark); background: #ECFDF5; }
    .zd-txn-status.s-fail { color: var(--error-red); background: #FEF2F2; }
    .zd-txn-status.s-pend { color: var(--accent-dark); background: #FFFBEB; }

    .zd-txn-empty {
      padding: 48px 20px;
      text-align: center;
      color: var(--text-secondary);
    }
    .zd-txn-empty i { font-size: 36px; margin-bottom: 12px; display: block; color: var(--border-medium); }
    .zd-txn-empty p { font-size: 14px; }

    /* ══════════════════════════════════════════════
       TWO-COL ROW (Wallet Card + Account Info)
    ══════════════════════════════════════════════ */
    .zd-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 680px) { .zd-two-col { grid-template-columns: 1fr; } }

    /* Wallet card */
    .zd-wallet-card {
      background: linear-gradient(135deg, #3B82F6 0%, #2563EB 55%, #8B5CF6 100%);
      border-radius: 20px;
      padding: 28px 24px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }
    .zd-wallet-card::after {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 180px; height: 180px;
      background: radial-gradient(circle, rgba(147,197,253,0.25), transparent 70%);
      border-radius: 50%;
    }
    .zd-wallet-label { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.65); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px; }
    .zd-wallet-amount { font-size: 36px; font-weight: 800; color: #fff; margin-bottom: 4px; font-variant-numeric: tabular-nums; }
    .zd-wallet-sub { font-size: 12px; color: rgba(255,255,255,0.55); margin-bottom: 24px; }
    .zd-wallet-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .zd-wallet-mini-list { margin-top: 16px; display: grid; gap: 8px; }
    .zd-wallet-mini-item { display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,0.92); font-size: 12px; border-top: 1px solid rgba(255,255,255,0.14); padding-top: 8px; }
    .zd-wallet-mini-item .amt { font-weight: 700; font-variant-numeric: tabular-nums; }
    .zd-wal-btn {
      flex: 1; min-width: 90px;
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 9px 14px; border-radius: 9px; font-size: 13px; font-weight: 600;
      text-decoration: none; transition: all var(--transition-base); border: none; cursor: pointer;
    }
    .zd-wal-btn.add  { background: #fff; color: var(--primary-dark); box-shadow: var(--shadow-sm); }
    .zd-wal-btn.send { background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); }
    .zd-wal-btn.with { background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); }
    .zd-wal-btn:hover { transform: translateY(-2px); }

    /* account info card */
    .zd-acct-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-light);
      border-radius: 20px;
      padding: 28px 24px;
      box-shadow: var(--shadow-sm);
    }
    .zd-acct-title { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
    .zd-acct-title i { color: var(--primary); }
    .zd-acct-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 0; border-bottom: 1px solid var(--border-light);
    }
    .zd-acct-row:last-child { border-bottom: none; padding-bottom: 0; }
    .zd-acct-key   { font-size: 12px; color: var(--text-secondary); font-weight: 500; }
    .zd-acct-val   { font-size: 13px; color: var(--text-primary); font-weight: 600; }
    .zd-acct-copy  {
      font-size: 12px; color: var(--primary); cursor: pointer;
      padding: 3px 6px; border-radius: 5px; background: #EFF6FF;
      transition: background var(--transition-fast);
    }
    .zd-acct-copy:hover { background: #DBEAFE; }
    .zd-acct-status { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; color: var(--success-dark); }
    .zd-acct-dot   { width: 7px; height: 7px; border-radius: 50%; background: var(--success); animation: pulse-dot 2s infinite; }
    @keyframes pulse-dot { 0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,.5)} 50%{box-shadow:0 0 0 5px rgba(16,185,129,0)} }

    /* ══════════════════════════════════════════════
       KYC BANNER
    ══════════════════════════════════════════════ */
    .zd-kyc-banner {
      background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
      border: 1px solid #FDE68A;
      border-radius: 14px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: var(--shadow-sm);
    }
    .zd-kyc-icon { width: 44px; height: 44px; border-radius: 12px; background: #FEF3C7; color: var(--accent-dark); font-size: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .zd-kyc-text  { flex: 1; }
    .zd-kyc-title { font-size: 14px; font-weight: 700; color: var(--accent-dark); margin-bottom: 2px; }
    .zd-kyc-sub   { font-size: 12px; color: #92400E; }
    .zd-kyc-btn {
      padding: 9px 18px; background: var(--accent); border: 1px solid var(--accent-dark);
      color: #fff; font-size: 13px; font-weight: 600; border-radius: 8px;
      text-decoration: none; white-space: nowrap; transition: all var(--transition-base);
      box-shadow: var(--shadow-sm);
    }
    .zd-kyc-btn:hover { background: var(--accent-dark); transform: translateY(-1px); }

    /* ══════════════════════════════════════════════
       SECURITY INDICATORS
    ══════════════════════════════════════════════ */
    .zd-security-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
    }
    .zd-sec-item {
      background: var(--bg-primary);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 16px 18px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition-base);
    }
    .zd-sec-item:hover { box-shadow: var(--shadow-md); }
    .zd-sec-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .zd-sec-label { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .zd-sec-sub   { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
    .zd-sec-check { margin-left: auto; color: var(--success); font-size: 16px; }

    /* ══════════════════════════════════════════════
       REFERRAL BANNER
    ══════════════════════════════════════════════ */
    .zd-referral-banner {
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      border-radius: 16px;
      padding: 28px 28px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
      position: relative; overflow: hidden;
      box-shadow: var(--shadow-xl);
    }
    .zd-referral-banner::after {
      content: '';
      position: absolute; right: -60px; top: -60px;
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(147,197,253,0.2), transparent 65%);
      border-radius: 50%;
    }
    .zd-ref-left  { flex: 1; }
    .zd-ref-tag   { font-size: 11px; font-weight: 700; color: #93C5FD; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; }
    .zd-ref-title { font-size: 20px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .zd-ref-sub   { font-size: 13px; color: rgba(255,255,255,0.7); }
    .zd-ref-btn {
      padding: 11px 24px; background: #fff; color: var(--primary-dark);
      font-size: 14px; font-weight: 700; border-radius: 9px; text-decoration: none;
      white-space: nowrap; transition: all var(--transition-base); box-shadow: var(--shadow-md);
    }
    .zd-ref-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

    /* ══════════════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════════════ */
    @media (max-width: 680px) {
      .zd-hero-inner { flex-direction: column; }
      .zd-id-card { width: 100%; }
      .zd-actions-grid { grid-template-columns: repeat(3,1fr); }
      .zd-stats-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 420px) {
      .zd-actions-grid { grid-template-columns: repeat(2,1fr); }
    }
  </style>
</head>

<body class="modern-body">

  <!-- Header -->
  <%- include('partials/header') %>

  <!-- Main Content -->
  <main class="modern-main">

    <% if (isLoggedIn && user) { %>
    <!-- ═══════════════════════════════════════════════════
         LOGGED-IN DASHBOARD
    ═══════════════════════════════════════════════════ -->
    <div class="zd-page">

      <!-- ── HERO ── -->
      <section class="zd-hero">
        <div class="zd-container">
          <div class="zd-hero-inner">

            <!-- Welcome text -->
            <div class="zd-welcome">
              <div class="zd-badge"><i class="fas fa-check-circle"></i> Welcome back</div>
              <h1 class="zd-hero-title">Hello, <span><%= user.Name %>!</span></h1>
              <p class="zd-hero-sub">Manage your payments, track transactions, and grow your business — all in one place.</p>
              <div class="zd-hero-ctas">
                <a href="/send-money" class="zd-cta-btn zd-cta-primary"><i class="fas fa-paper-plane"></i> Send Money</a>
                <a href="/transaction-history" class="zd-cta-btn zd-cta-outline"><i class="fas fa-history"></i> View History</a>
              </div>
            </div>

            <!-- ID Card -->
            <div class="zd-id-card">
              <div class="zd-id-row">
                <div class="zd-avatar-ring"><%= (user.Name || 'U').charAt(0).toUpperCase() %></div>
                <div>
                  <div class="zd-id-name"><%= user.Name || 'User' %></div>
                  <div class="zd-id-sub"><%= user.Email || 'user@zenopay.me' %></div>
                </div>
              </div>
              <div class="zd-id-chips">
                <span class="zd-chip zd-chip-green"><i class="fas fa-circle" style="font-size:7px"></i> Active</span>
                <span class="zd-chip zd-chip-blue"><i class="fas fa-id-card" style="font-size:9px"></i> <%= user.ZenoPayID || 'ZP-XXXXX' %></span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <% if (typeof pinSuccessMessage !== 'undefined' && pinSuccessMessage) { %>
      <div class="zd-container zd-alert-wrap" id="pinSuccessBanner">
        <div class="zd-alert-success" role="status" aria-live="polite">
          <span class="zd-alert-msg"><i class="fas fa-check-circle"></i> <%= pinSuccessMessage %></span>
          <button class="zd-alert-close" type="button" aria-label="Dismiss" onclick="document.getElementById('pinSuccessBanner').style.display='none'">&times;</button>
        </div>
      </div>
      <% } %>

      <!-- ── STATS ── -->
      <div class="zd-container">
        <div class="zd-stats">
          <div class="zd-stats-grid">

            <div class="zd-stat-card cyan">
              <div class="zd-stat-top">
                <div class="zd-stat-icon cyan"><i class="fas fa-wallet"></i></div>
                <span class="zd-stat-trend up"><i class="fas fa-arrow-up"></i> 0%</span>
              </div>
              <div class="zd-stat-val">₹<%= Number(typeof walletBalance !== 'undefined' ? walletBalance : 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
              <div class="zd-stat-label">Wallet Balance</div>
            </div>

            <div class="zd-stat-card green">
              <div class="zd-stat-top">
                <div class="zd-stat-icon green"><i class="fas fa-exchange-alt"></i></div>
                <span class="zd-stat-trend neu">This month</span>
              </div>
              <div class="zd-stat-val"><%= typeof monthTransactionCount !== 'undefined' ? monthTransactionCount : 0 %></div>
              <div class="zd-stat-label">Transactions</div>
            </div>

            <div class="zd-stat-card purple">
              <div class="zd-stat-top">
                <div class="zd-stat-icon purple"><i class="fas fa-chart-line"></i></div>
                <span class="zd-stat-trend up"><i class="fas fa-arrow-up"></i> 2.1%</span>
              </div>
              <div class="zd-stat-val"><%= Number(typeof monthSuccessRate !== 'undefined' ? monthSuccessRate : 98.4).toFixed(1) %>%</div>
              <div class="zd-stat-label">Success Rate</div>
            </div>

            <div class="zd-stat-card amber">
              <div class="zd-stat-top">
                <div class="zd-stat-icon amber"><i class="fas fa-bolt"></i></div>
                <span class="zd-stat-trend neu">Avg</span>
              </div>
              <div class="zd-stat-val">~2s</div>
              <div class="zd-stat-label">Settlement Time</div>
            </div>

          </div>
        </div>

        <!-- ── WALLET + ACCOUNT INFO ── -->
        <div class="zd-section">
          <div class="zd-two-col">

            <!-- Wallet Card -->
            <div class="zd-wallet-card">
              <div class="zd-wallet-label">Available Balance</div>
              <div class="zd-wallet-amount" id="walletBalanceAnimated" data-balance="<%= Number(typeof walletBalance !== 'undefined' ? walletBalance : 0) %>">₹0.00</div>
              <div class="zd-wallet-sub">Last updated just now</div>
              <div class="zd-wallet-actions">
                <a href="/wallet/topup" class="zd-wal-btn add"><i class="fas fa-plus"></i> Add Money</a>
                <a href="/wallet/send" class="zd-wal-btn send"><i class="fas fa-paper-plane"></i> Send Money</a>
                <a href="/wallet/transactions" class="zd-wal-btn with"><i class="fas fa-clock-rotate-left"></i> History</a>
              </div>
              <div class="zd-wallet-mini-list">
                <% if (typeof recentTransactions !== 'undefined' && recentTransactions && recentTransactions.length > 0) { %>
                  <% recentTransactions.slice(0, 3).forEach(function(txn) { %>
                    <div class="zd-wallet-mini-item">
                      <span><%= txn.description || 'Transaction' %></span>
                      <span class="amt"><%= txn.type === 'credit' ? '+' : '-' %>₹<%= Number(txn.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="zd-wallet-mini-item"><span>No recent wallet transactions</span><span class="amt">—</span></div>
                <% } %>
              </div>
            </div>

            <!-- Account Info -->
            <div class="zd-acct-card">
              <div class="zd-acct-title"><i class="fas fa-id-card"></i> Account Details</div>
              <div class="zd-acct-row">
                <span class="zd-acct-key">ZenoPay ID</span>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span class="zd-acct-val"><%= user.ZenoPayID || '—' %></span>
                  <span class="zd-acct-copy" title="Copy"><i class="fas fa-copy"></i></span>
                </div>
              </div>
              <div class="zd-acct-row">
                <span class="zd-acct-key">Email</span>
                <span class="zd-acct-val" style="font-family:inherit"><%= user.Email || '—' %></span>
              </div>
              <div class="zd-acct-row">
                <span class="zd-acct-key">Account Status</span>
                <span class="zd-acct-status"><span class="zd-acct-dot"></span> Active</span>
              </div>
              <div class="zd-acct-row">
                <span class="zd-acct-key">KYC Status</span>
                <span class="zd-chip zd-chip-green" style="font-size:11px;color:#059669;border-color:rgba(5,150,105,.3);background:#ECFDF5;">Verified</span>
              </div>
            </div>

          </div>
        </div>

        <!-- ── QUICK ACTIONS ── -->
        <div class="zd-section" style="padding-top:0">
          <div class="zd-section-head">
            <h2 class="zd-section-title"><i class="fas fa-grid-2"></i> Quick Actions</h2>
          </div>
          <div class="zd-actions-grid">
            <a href="/send-money" class="zd-action-card">
              <div class="zd-action-icon c1"><i class="fas fa-paper-plane"></i></div>
              <div><div class="zd-action-label">Send Money</div><div class="zd-action-sub">Transfer instantly</div></div>
            </a>
            <a href="/request-money" class="zd-action-card">
              <div class="zd-action-icon c2"><i class="fas fa-hand-holding-dollar"></i></div>
              <div><div class="zd-action-label">Request Money</div><div class="zd-action-sub">Ask for payment</div></div>
            </a>
            <a href="/add-money" class="zd-action-card">
              <div class="zd-action-icon c3"><i class="fas fa-plus-circle"></i></div>
              <div><div class="zd-action-label">Add Money</div><div class="zd-action-sub">Top up wallet</div></div>
            </a>
            <a href="/withdraw" class="zd-action-card">
              <div class="zd-action-icon c4"><i class="fas fa-money-bill-transfer"></i></div>
              <div><div class="zd-action-label">Withdraw</div><div class="zd-action-sub">To bank account</div></div>
            </a>
            <a href="/qr-payment" class="zd-action-card">
              <div class="zd-action-icon c5"><i class="fas fa-qrcode"></i></div>
              <div><div class="zd-action-label">QR Payment</div><div class="zd-action-sub">Scan & pay</div></div>
            </a>
            <a href="/transaction-history" class="zd-action-card">
              <div class="zd-action-icon c6"><i class="fas fa-history"></i></div>
              <div><div class="zd-action-label">Transactions</div><div class="zd-action-sub">View history</div></div>
            </a>
            <a href="/invoices" class="zd-action-card">
              <div class="zd-action-icon c7"><i class="fas fa-file-invoice-dollar"></i></div>
              <div><div class="zd-action-label">Invoices</div><div class="zd-action-sub">Create & manage</div></div>
            </a>
            <a href="/profile" class="zd-action-card">
              <div class="zd-action-icon c8"><i class="fas fa-user-circle"></i></div>
              <div><div class="zd-action-label">My Profile</div><div class="zd-action-sub">Account settings</div></div>
            </a>
          </div>
        </div>

        <!-- ── RECENT TRANSACTIONS ── -->
        <div class="zd-section" style="padding-top:0">
          <div class="zd-section-head">
            <h2 class="zd-section-title"><i class="fas fa-clock-rotate-left"></i> Recent Transactions</h2>
            <a href="/transaction-history" class="zd-section-link">View all <i class="fas fa-arrow-right"></i></a>
          </div>
          <div class="zd-txn-table">
            <% if (typeof recentTransactions !== 'undefined' && recentTransactions && recentTransactions.length > 0) { %>
              <% recentTransactions.slice(0,6).forEach(function(txn) { %>
                <div class="zd-txn-row">
                  <div class="zd-txn-icon <%= txn.type === 'credit' ? 'credit' : txn.status === 'pending' ? 'pending' : 'debit' %>">
                    <i class="fas fa-<%= txn.type === 'credit' ? 'arrow-down' : txn.status === 'pending' ? 'clock' : 'arrow-up' %>"></i>
                  </div>
                  <div class="zd-txn-info">
                    <div class="zd-txn-name"><%= txn.description || txn.to || 'Transaction' %></div>
                    <div class="zd-txn-time"><%= txn.date || txn.createdAt || '' %></div>
                  </div>
                  <div class="zd-txn-amount <%= txn.type === 'credit' ? 'credit' : txn.status === 'pending' ? 'pending' : 'debit' %>">
                    <%= txn.type === 'credit' ? '+' : '-' %>₹<%= Number(txn.amount || 0).toLocaleString('en-IN') %>
                  </div>
                  <span class="zd-txn-status <%= txn.status === 'success' ? 's-ok' : txn.status === 'pending' ? 's-pend' : 's-fail' %>">
                    <%= txn.status || 'success' %>
                  </span>
                </div>
              <% }); %>
            <% } else { %>
              <div class="zd-txn-empty">
                <i class="fas fa-receipt"></i>
                <p>No transactions yet. Start by sending or adding money.</p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- ── KYC / VERIFICATION NUDGE ── -->
        <div class="zd-section" style="padding-top:0">
          <div class="zd-kyc-banner">
            <div class="zd-kyc-icon"><i class="fas fa-id-card"></i></div>
            <div class="zd-kyc-text">
              <div class="zd-kyc-title">Complete KYC Verification</div>
              <div class="zd-kyc-sub">Verify your identity to unlock higher transaction limits and all features.</div>
            </div>
            <a href="/kyc-verification" class="zd-kyc-btn"><i class="fas fa-arrow-right"></i> Verify Now</a>
          </div>
        </div>

        <!-- ── SECURITY INDICATORS ── -->
        <div class="zd-section" style="padding-top:0">
          <div class="zd-section-head">
            <h2 class="zd-section-title"><i class="fas fa-shield-halved"></i> Account Security</h2>
            <a href="/security-settings" class="zd-section-link">Manage <i class="fas fa-arrow-right"></i></a>
          </div>
          <div class="zd-security-row">
            <div class="zd-sec-item">
              <div class="zd-sec-icon" style="background:#ECFDF5;color:#059669;"><i class="fas fa-lock"></i></div>
              <div><div class="zd-sec-label">Password</div><div class="zd-sec-sub">Last changed recently</div></div>
              <i class="fas fa-check-circle zd-sec-check"></i>
            </div>
            <div class="zd-sec-item">
              <div class="zd-sec-icon" style="background:#EFF6FF;color:#2563EB;"><i class="fas fa-mobile-screen-button"></i></div>
              <div><div class="zd-sec-label">2FA Authentication</div><div class="zd-sec-sub">Extra layer of security</div></div>
              <a href="/security-settings" style="margin-left:auto;font-size:11px;color:var(--accent-dark);text-decoration:none;font-weight:600;background:#FFFBEB;padding:3px 8px;border-radius:6px;">Enable</a>
            </div>
            <div class="zd-sec-item">
              <div class="zd-sec-icon" style="background:#F5F3FF;color:#7C3AED;"><i class="fas fa-envelope-circle-check"></i></div>
              <div><div class="zd-sec-label">Email Verified</div><div class="zd-sec-sub"><%= user.Email || '—' %></div></div>
              <i class="fas fa-check-circle zd-sec-check"></i>
            </div>
            <div class="zd-sec-item">
              <div class="zd-sec-icon" style="background:#FFFBEB;color:#D97706;"><i class="fas fa-shield-alt"></i></div>
              <div><div class="zd-sec-label">Fraud Protection</div><div class="zd-sec-sub">Always active</div></div>
              <i class="fas fa-check-circle zd-sec-check"></i>
            </div>
          </div>
        </div>

        <!-- ── REFERRAL BANNER ── -->
        <div class="zd-section" style="padding-top:0;padding-bottom:56px;">
          <div class="zd-referral-banner">
            <div class="zd-ref-left">
              <div class="zd-ref-tag"><i class="fas fa-gift"></i> Referral Program</div>
              <div class="zd-ref-title">Earn ₹200 for every friend you invite!</div>
              <div class="zd-ref-sub">Share your referral link and earn cashback when they complete their first transaction.</div>
            </div>
            <a href="/referral-program" class="zd-ref-btn"><i class="fas fa-share-nodes"></i> Invite Friends</a>
          </div>
        </div>

      </div>
    </div>
    <!-- END LOGGED-IN DASHBOARD -->

    <% } else { %>
    <!-- ═══════════════════════════════════════════════════
         GUEST / NOT LOGGED IN VIEW (unchanged)
    ═══════════════════════════════════════════════════ -->

          <!-- Hero Section - Guest -->
          <section class="hero-guest">
            <div class="hero-guest-background"></div>
            <div class="hero-decorations">
              <div class="decoration-circle circle-1"></div>
              <div class="decoration-circle circle-2"></div>
            </div>

            <div class="container">
              <div class="hero-guest-grid">

                <!-- Left Column - Text Content -->
