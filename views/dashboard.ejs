          <% const safeStats = {
            activeUsers: (typeof stats !== 'undefined' && stats && typeof stats.activeUsers !== 'undefined') ? stats.activeUsers : 10000,
            processed: (typeof stats !== 'undefined' && stats && typeof stats.processed !== 'undefined') ? stats.processed : 500,
            uptime: (typeof stats !== 'undefined' && stats && typeof stats.uptime !== 'undefined') ? stats.uptime : 99.9,
            settlementTime: (typeof stats !== 'undefined' && stats && typeof stats.settlementTime !== 'undefined') ? stats.settlementTime : 2,
