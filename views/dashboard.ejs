                  <div class="stat-icon-wrapper emerald stat-icon stat-icon-green">
                    <i class="fas fa-check-circle"></i>
                  </div>
                  <div class="stat-number"
                    id="stat-processed"
                    data-target="<%= safeStats.processed %>"
                    data-suffix="Cr+"
                    data-prefix="₹">
                    ₹0
                  </div>
