<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZenoPay - Modern Payment Gateway | Accept Payments Globally</title>
  <meta name="description"
    content="Enterprise-grade payment infrastructure for businesses. Zero setup fees, instant settlements, 99.9% uptime. Trusted by 10,000+ businesses." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/premium-animations.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body class="modern-body">
  <%- include('partials/header') %>

  <main class="modern-main dash-page">
    <% if (isLoggedIn && user) { %>
    <% 
      const recentTx = (typeof recentTransactions !== 'undefined' && recentTransactions) ? recentTransactions : [];
      const walletAmount = Number(typeof walletBalance !== 'undefined' ? walletBalance : 0);
      const monthlyCount = typeof monthTransactionCount !== 'undefined' ? monthTransactionCount : 0;
      const successRate = Number(typeof monthSuccessRate !== 'undefined' ? monthSuccessRate : 98.4);
      const spendCategory = topSpendingCategory || 'Operations';
      const spendAmount = Number(topSpendingAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const dailyRemaining = Number(transactionLimitWidget?.dailyRemaining || 0);
      const dailyUsed = Number(transactionLimitWidget?.dailyUsed || 0);
      const dailyLimit = Number(transactionLimitWidget?.dailyLimit || 0);
      const limitPercent = dailyLimit > 0 ? Math.min(100, Math.round((dailyUsed / dailyLimit) * 100)) : 0;
      const userInitial = (user.Name || 'U').charAt(0).toUpperCase();
      const kycTone = kycStatus === 'approved' ? 'success' : (kycStatus === 'pending' ? 'warning' : (kycStatus === 'rejected' ? 'danger' : 'neutral'));
      const kycText = kycStatus === 'approved' ? 'Verified' : (kycStatus === 'pending' ? 'Pending review' : (kycStatus === 'rejected' ? 'Rejected' : 'Not submitted'));
    %>

    <section class="dash-hero dash-hero-auth">
      <div class="dash-container">
        <div class="dash-hero-grid">
          <div class="dash-hero-copy" data-reveal>
            <span class="dash-pill dash-pill-primary">
              <i class="fas fa-wave-square"></i>
              Live account overview
            </span>
            <h1 class="dash-hero-title">Welcome back, <span><%= user.Name || 'there' %></span></h1>
            <p class="dash-hero-text">Track money movement, keep your account secure, and move funds faster from one premium control center.</p>
            <div class="dash-hero-actions">
              <a href="/send-money" class="dash-btn dash-btn-primary" data-ripple>
                <i class="fas fa-paper-plane"></i>
                Send Money
              </a>
              <a href="/transaction-history" class="dash-btn dash-btn-secondary" data-ripple>
                <i class="fas fa-clock-rotate-left"></i>
                View History
              </a>
            </div>
            <div class="dash-hero-meta">
              <div class="dash-meta-item">
                <span class="dash-meta-label">KYC</span>
                <span class="dash-meta-value dash-text-<%= kycTone %>"><%= kycText %></span>
              </div>
              <div class="dash-meta-item">
                <span class="dash-meta-label">Daily limit left</span>
                <span class="dash-meta-value">₹<%= dailyRemaining.toLocaleString('en-IN') %></span>
              </div>
              <div class="dash-meta-item">
                <span class="dash-meta-label">Success rate</span>
                <span class="dash-meta-value"><%= successRate.toFixed(1) %>%</span>
              </div>
            </div>
          </div>

          <aside class="dash-hero-panel dash-card dash-surface-dark" data-reveal data-reveal-delay="120">
            <div class="dash-account-head">
              <div class="dash-avatar"><%= userInitial %></div>
              <div>
                <div class="dash-account-name"><%= user.Name || 'User' %></div>
                <div class="dash-account-sub"><%= user.Email || 'user@zenopay.me' %></div>
              </div>
              <span class="dash-status-dot">
                <i></i>
                Active
              </span>
            </div>

            <div class="dash-balance-stack">
              <span class="dash-eyebrow">Available balance</span>
              <div class="dash-balance-value"
                id="walletBalanceAnimated"
                data-count-to="<%= walletAmount %>"
                data-prefix="₹"
                data-decimals="2"
                data-format="currency">
                ₹0.00
              </div>
              <p class="dash-balance-note">Payments settle quickly into the same wallet you use for transfers and payouts.</p>
            </div>

            <div class="dash-account-grid">
              <div class="dash-account-metric">
                <span>Transactions</span>
                <strong><%= monthlyCount %></strong>
              </div>
              <div class="dash-account-metric">
                <span>ZenoPay ID</span>
                <strong class="dash-inline-copy-wrap">
                  <span class="dash-mono"><%= user.ZenoPayID || '—' %></span>
                  <button class="dash-copy-btn" type="button" data-copy-value="<%= user.ZenoPayID || '' %>" aria-label="Copy ZenoPay ID">
                    <i class="fas fa-copy"></i>
                  </button>
                </strong>
              </div>
            </div>

            <div class="dash-limit-card">
              <div class="dash-limit-row">
                <span>Daily limit usage</span>
                <strong><%= limitPercent %>%</strong>
              </div>
              <div class="dash-progress">
                <span data-progress="<%= limitPercent %>"></span>
              </div>
              <div class="dash-limit-foot">
                Used ₹<%= dailyUsed.toLocaleString('en-IN') %> of ₹<%= dailyLimit.toLocaleString('en-IN') %>
                <a href="/user/limits">View limits</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <% if (typeof pinSuccessMessage !== 'undefined' && pinSuccessMessage) { %>
    <section class="dash-flush">
      <div class="dash-container">
        <div class="dash-inline-alert" id="pinSuccessBanner" role="status" aria-live="polite">
          <div class="dash-inline-alert-copy">
            <i class="fas fa-check-circle"></i>
            <span><%= pinSuccessMessage %></span>
          </div>
          <button type="button" class="dash-inline-alert-close" data-dismiss-target="pinSuccessBanner" aria-label="Dismiss">
            <i class="fas fa-xmark"></i>
          </button>
        </div>
      </div>
    </section>
    <% } %>

    <section class="dash-section dash-flush">
      <div class="dash-container">
        <div class="dash-grid-4 dash-kpi-grid">
          <article class="dash-card dash-kpi-card" data-reveal>
            <div class="dash-kpi-head">
              <span class="dash-icon-shell tone-blue"><i class="fas fa-wallet"></i></span>
              <span class="dash-kpi-trend positive"><i class="fas fa-arrow-trend-up"></i> Available</span>
            </div>
            <div class="dash-kpi-value"
              data-count-to="<%= walletAmount %>"
              data-prefix="₹"
              data-decimals="2"
              data-format="currency">
              ₹0.00
            </div>
            <div class="dash-kpi-label">Wallet balance</div>
            <div class="dash-kpi-spark tone-blue"></div>
          </article>

          <article class="dash-card dash-kpi-card" data-reveal data-reveal-delay="80">
            <div class="dash-kpi-head">
              <span class="dash-icon-shell tone-green"><i class="fas fa-arrow-right-arrow-left"></i></span>
              <span class="dash-kpi-trend neutral">This month</span>
            </div>
            <div class="dash-kpi-value" data-count-to="<%= monthlyCount %>">0</div>
            <div class="dash-kpi-label">Transactions processed</div>
            <div class="dash-kpi-spark tone-green"></div>
          </article>

          <article class="dash-card dash-kpi-card" data-reveal data-reveal-delay="160">
            <div class="dash-kpi-head">
              <span class="dash-icon-shell tone-violet"><i class="fas fa-chart-line"></i></span>
              <span class="dash-kpi-trend positive"><i class="fas fa-shield-halved"></i> Stable</span>
            </div>
            <div class="dash-kpi-value" data-count-to="<%= successRate %>" data-suffix="%" data-decimals="1">0%</div>
            <div class="dash-kpi-label">Success rate</div>
            <div class="dash-kpi-spark tone-violet"></div>
          </article>

          <article class="dash-card dash-kpi-card" data-reveal data-reveal-delay="240">
            <div class="dash-kpi-head">
              <span class="dash-icon-shell tone-amber"><i class="fas fa-layer-group"></i></span>
              <span class="dash-kpi-trend neutral">Top spend</span>
            </div>
            <div class="dash-kpi-title"><%= spendCategory %></div>
            <div class="dash-kpi-label">₹<%= spendAmount %> this month</div>
            <div class="dash-kpi-spark tone-amber"></div>
          </article>
        </div>
      </div>
    </section>

    <section class="dash-section">
      <div class="dash-container">
        <div class="dash-section-head">
          <div>
            <span class="dash-section-kicker">Fast actions</span>
            <h2>Move money without friction</h2>
            <p>Core workflows, organized around the actions you take most.</p>
          </div>
        </div>

        <div class="dash-grid-4 dash-actions-grid">
          <a href="/send-money" class="dash-card dash-action-card" data-reveal>
            <span class="dash-icon-shell tone-blue"><i class="fas fa-paper-plane"></i></span>
            <h3>Send Money</h3>
            <p>Transfer funds instantly to contacts or linked accounts.</p>
          </a>
          <a href="/request-money" class="dash-card dash-action-card" data-reveal data-reveal-delay="60">
            <span class="dash-icon-shell tone-green"><i class="fas fa-hand-holding-dollar"></i></span>
            <h3>Request Money</h3>
            <p>Create a payment request and track when it clears.</p>
          </a>
          <a href="/add-money" class="dash-card dash-action-card" data-reveal data-reveal-delay="120">
            <span class="dash-icon-shell tone-violet"><i class="fas fa-plus-circle"></i></span>
            <h3>Add Money</h3>
            <p>Top up your wallet and keep outbound payments ready.</p>
          </a>
          <a href="/withdraw" class="dash-card dash-action-card" data-reveal data-reveal-delay="180">
            <span class="dash-icon-shell tone-amber"><i class="fas fa-money-bill-transfer"></i></span>
            <h3>Withdraw</h3>
            <p>Move available balance back to your bank account.</p>
          </a>
          <a href="/qr-payment" class="dash-card dash-action-card" data-reveal>
            <span class="dash-icon-shell tone-red"><i class="fas fa-qrcode"></i></span>
            <h3>QR Payment</h3>
            <p>Accept scan-and-pay flows for quick in-person collection.</p>
          </a>
          <a href="/transaction-history" class="dash-card dash-action-card" data-reveal data-reveal-delay="60">
            <span class="dash-icon-shell tone-slate"><i class="fas fa-clock-rotate-left"></i></span>
            <h3>Transactions</h3>
            <p>Review credits, debits, statuses, and timestamps.</p>
          </a>
          <a href="/user/analytics" class="dash-card dash-action-card" data-reveal data-reveal-delay="120">
            <span class="dash-icon-shell tone-blue"><i class="fas fa-chart-pie"></i></span>
            <h3>Analytics</h3>
            <p>Inspect usage trends, categories, and performance signals.</p>
          </a>
          <a href="/invoices" class="dash-card dash-action-card" data-reveal data-reveal-delay="180">
            <span class="dash-icon-shell tone-green"><i class="fas fa-file-invoice-dollar"></i></span>
            <h3>Invoices</h3>
            <p>Create and manage billing workflows from one place.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="dash-section">
      <div class="dash-container">
        <div class="dash-main-grid">
          <div class="dash-main-column">
            <div class="dash-section-head">
              <div>
                <span class="dash-section-kicker">Recent activity</span>
                <h2>Latest transactions</h2>
                <p>See incoming and outgoing movement at a glance.</p>
              </div>
              <a href="/transaction-history" class="dash-link-inline">View all <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="dash-card dash-transactions-card" data-reveal>
              <% if (recentTx.length > 0) { %>
              <div class="dash-table-head">
                <span>Transaction</span>
                <span>Date</span>
                <span>Amount</span>
                <span>Status</span>
              </div>
              <div class="dash-transaction-list">
                <% recentTx.slice(0, 6).forEach(function(txn, index) { 
                  const txnStatus = txn.status || 'success';
                  const txnType = txn.type === 'credit' ? 'credit' : (txnStatus === 'pending' ? 'pending' : 'debit');
                  const txnIcon = txn.type === 'credit' ? 'arrow-down' : (txnStatus === 'pending' ? 'clock' : 'arrow-up');
                  const txnSign = txn.type === 'credit' ? '+' : '-';
                %>
                <article class="dash-transaction-row" data-reveal data-reveal-delay="<%= index * 50 %>">
                  <div class="dash-transaction-main">
                    <span class="dash-icon-shell tone-<%= txnType === 'credit' ? 'green' : (txnType === 'pending' ? 'amber' : 'red') %>">
                      <i class="fas fa-<%= txnIcon %>"></i>
                    </span>
                    <div>
                      <h3><%= txn.description || txn.to || 'Transaction' %></h3>
                      <p><%= txn.type === 'credit' ? 'Incoming payment' : 'Outgoing payment' %></p>
                    </div>
                  </div>
                  <div class="dash-transaction-date"><%= txn.date || txn.createdAt || 'Just now' %></div>
                  <div class="dash-transaction-amount dash-amount-<%= txnType %>"><%= txnSign %>₹<%= Number(txn.amount || 0).toLocaleString('en-IN') %></div>
                  <div class="dash-transaction-status">
                    <span class="dash-badge dash-badge-<%= txnStatus === 'success' ? 'success' : (txnStatus === 'pending' ? 'warning' : 'danger') %>">
                      <%= txnStatus %>
                    </span>
                  </div>
                </article>
                <% }); %>
              </div>
              <% } else { %>
              <div class="dash-empty-state">
                <span class="dash-icon-shell tone-slate"><i class="fas fa-receipt"></i></span>
                <h3>No transactions yet</h3>
                <p>Start by adding money or sending your first transfer.</p>
              </div>
              <% } %>
            </div>
          </div>

          <aside class="dash-side-column">
            <div class="dash-card dash-panel-card" data-reveal>
              <div class="dash-panel-head">
                <div>
                  <span class="dash-section-kicker">Account</span>
                  <h3>Profile and limits</h3>
                </div>
                <a href="/profile" class="dash-link-inline">Profile</a>
              </div>

              <div class="dash-detail-list">
                <div class="dash-detail-row">
                  <span>Email</span>
                  <strong><%= user.Email || '—' %></strong>
                </div>
                <div class="dash-detail-row">
                  <span>ZenoPay ID</span>
                  <strong class="dash-mono"><%= user.ZenoPayID || '—' %></strong>
                </div>
                <div class="dash-detail-row">
                  <span>KYC status</span>
                  <span class="dash-badge dash-badge-<%= kycTone %>"><%= kycText %></span>
                </div>
              </div>

              <div class="dash-inline-surface">
                <div class="dash-inline-surface-top">
                  <span>Daily limit remaining</span>
                  <strong>₹<%= dailyRemaining.toLocaleString('en-IN') %></strong>
                </div>
                <div class="dash-progress">
                  <span data-progress="<%= limitPercent %>"></span>
                </div>
                <div class="dash-inline-note">Used ₹<%= dailyUsed.toLocaleString('en-IN') %> of ₹<%= dailyLimit.toLocaleString('en-IN') %>.</div>
              </div>
            </div>

            <div class="dash-card dash-panel-card dash-security-focus" data-reveal data-reveal-delay="80">
              <div class="dash-panel-head">
                <div>
                  <span class="dash-section-kicker">Security</span>
                  <h3>Keep access protected</h3>
                </div>
                <a href="/security-settings" class="dash-link-inline">Manage</a>
              </div>

              <div class="dash-security-list">
                <div class="dash-security-item">
                  <span class="dash-icon-shell tone-green"><i class="fas fa-lock"></i></span>
                  <div>
                    <strong>Password protection</strong>
                    <p>Last changed recently and active across your account.</p>
                  </div>
                  <span class="dash-badge dash-badge-success">Protected</span>
                </div>
                <div class="dash-security-item dash-security-item-featured">
                  <span class="dash-icon-shell tone-violet"><i class="fas fa-mobile-screen-button"></i></span>
                  <div>
                    <strong>Two-factor authentication</strong>
                    <p>Add an extra sign-in step before high-value actions.</p>
                  </div>
                  <a href="/security-settings" class="dash-mini-cta">Enable</a>
                </div>
                <div class="dash-security-item">
                  <span class="dash-icon-shell tone-blue"><i class="fas fa-envelope-circle-check"></i></span>
                  <div>
                    <strong>Email verification</strong>
                    <p><%= user.Email || '—' %></p>
                  </div>
                  <span class="dash-badge dash-badge-success">Verified</span>
                </div>
              </div>
            </div>

            <div class="dash-card dash-panel-card" data-reveal data-reveal-delay="160">
              <div class="dash-panel-head">
                <div>
                  <span class="dash-section-kicker">Productivity</span>
                  <h3>Stay in control</h3>
                </div>
              </div>
              <div class="dash-mini-list">
                <a href="/wallet/topup" class="dash-mini-link">
                  <span>Add money</span>
                  <i class="fas fa-arrow-right"></i>
                </a>
                <a href="/wallet/send" class="dash-mini-link">
                  <span>Send from wallet</span>
                  <i class="fas fa-arrow-right"></i>
                </a>
                <a href="/wallet/transactions" class="dash-mini-link">
                  <span>Wallet history</span>
                  <i class="fas fa-arrow-right"></i>
                </a>
                <a href="/qr-payment" class="dash-mini-link">
                  <span>Accept QR payments</span>
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="dash-section dash-section-compact-top">
      <div class="dash-container">
        <% if (kycStatus !== 'approved') { %>
        <div class="dash-card dash-callout dash-callout-<%= kycTone %>" data-reveal>
          <span class="dash-icon-shell tone-<%= kycTone === 'neutral' ? 'slate' : kycTone %>"><i class="fas fa-id-card"></i></span>
          <div class="dash-callout-copy">
            <h3>
              <% if (kycStatus === 'pending') { %>
              KYC under review
              <% } else if (kycStatus === 'rejected') { %>
              KYC needs attention
              <% } else { %>
              Complete your KYC verification
              <% } %>
            </h3>
            <p>
              <% if (kycStatus === 'pending') { %>
              Your documents are being reviewed. This usually takes 24 to 48 hours.
              <% } else if (kycStatus === 'rejected') { %>
              Please resubmit your documents with corrected details to restore full access.
              <% } else { %>
              Unlock higher transaction limits and the full ZenoPay experience with a completed verification.
              <% } %>
            </p>
          </div>
          <% if (kycStatus === 'pending') { %>
          <a href="/kyc" class="dash-btn dash-btn-primary" data-ripple>View Status</a>
          <% } else { %>
          <a href="/kyc<%= kycStatus === 'rejected' ? '/submit' : '' %>" class="dash-btn dash-btn-primary" data-ripple>
            <%= kycStatus === 'rejected' ? 'Resubmit KYC' : 'Verify Now' %>
          </a>
          <% } %>
        </div>
        <% } else { %>
        <div class="dash-card dash-callout dash-callout-success" data-reveal>
          <span class="dash-icon-shell tone-green"><i class="fas fa-circle-check"></i></span>
          <div class="dash-callout-copy">
            <h3>KYC verified</h3>
            <p>Your identity is approved and your account is ready for higher limits and smoother transfers.</p>
          </div>
          <a href="/security-settings" class="dash-btn dash-btn-secondary" data-ripple>Review Security</a>
        </div>
        <% } %>
      </div>
    </section>

    <section class="dash-section dash-section-last">
      <div class="dash-container">
        <div class="dash-lower-grid">
          <article class="dash-card dash-trust-card" data-reveal>
            <span class="dash-section-kicker">Trust</span>
            <h3>Protected by bank-grade controls</h3>
            <p>Encryption, account verification, fraud monitoring, and payout controls work together to keep your money flow reliable.</p>
            <a href="/security-settings" class="dash-link-inline">Security settings <i class="fas fa-arrow-right"></i></a>
          </article>

          <article class="dash-card dash-help-card" data-reveal data-reveal-delay="80">
            <span class="dash-section-kicker">Help</span>
            <h3>Need to move faster?</h3>
            <p>Use analytics for insights, invoices for collections, and transaction history for operational follow-up.</p>
            <div class="dash-help-links">
              <a href="/user/analytics">Analytics</a>
              <a href="/invoices">Invoices</a>
              <a href="/transaction-history">History</a>
            </div>
          </article>

          <article class="dash-card dash-referral-card" data-reveal data-reveal-delay="160">
            <span class="dash-section-kicker">Referral program</span>
            <h3>Earn ₹200 for every successful invite</h3>
            <p>Share your referral link and collect cashback once their first transaction completes.</p>
            <a href="/referral-program" class="dash-btn dash-btn-primary" data-ripple>Invite Friends</a>
          </article>
        </div>
      </div>
    </section>

    <% } else { %>
    <% const safeStats = {
      activeUsers: (typeof stats !== 'undefined' && stats && typeof stats.activeUsers !== 'undefined') ? stats.activeUsers : 10000,
      processed: (typeof stats !== 'undefined' && stats && typeof stats.processed !== 'undefined') ? stats.processed : 500,
      uptime: (typeof stats !== 'undefined' && stats && typeof stats.uptime !== 'undefined') ? stats.uptime : 99.9,
      settlementTime: (typeof stats !== 'undefined' && stats && typeof stats.settlementTime !== 'undefined') ? stats.settlementTime : 2
    }; %>

    <section class="dash-hero dash-hero-guest">
      <div class="dash-container">
        <div class="dash-hero-grid dash-hero-grid-guest">
          <div class="dash-hero-copy" data-reveal>
            <span class="dash-pill dash-pill-ghost">
              <i class="fas fa-shield-halved"></i>
              Trusted by 10,000+ businesses
            </span>
            <h1 class="dash-hero-title">Accept payments globally. <span>Settle fast with confidence.</span></h1>
            <p class="dash-hero-text">Enterprise-grade payment infrastructure for ambitious businesses. Launch quickly, scale cleanly, and keep every customer payment experience polished.</p>
            <div class="dash-hero-actions">
              <a href="/register" class="dash-btn dash-btn-primary dash-btn-on-dark" data-ripple>
                <i class="fas fa-rocket"></i>
                Start Free Trial
              </a>
              <a href="#integration" class="dash-btn dash-btn-secondary dash-btn-on-dark" data-ripple>
                <i class="fas fa-code"></i>
                View Documentation
              </a>
            </div>
            <div class="dash-hero-trust">
              <span><i class="fas fa-lock"></i> PCI DSS Level 1</span>
              <span><i class="fas fa-bolt"></i> Instant settlements</span>
              <span><i class="fas fa-chart-line"></i> 99.9% uptime</span>
            </div>
          </div>

          <div class="dash-product-stage" data-reveal data-reveal-delay="120">
            <div class="dash-stage-window">
              <div class="dash-stage-top">
                <div class="dash-window-dots">
                  <span></span><span></span><span></span>
                </div>
                <span>ZenoPay dashboard</span>
              </div>
              <div class="dash-stage-highlight">
                <div>
                  <span class="dash-stage-label">Today's revenue</span>
                  <strong>₹45,280</strong>
