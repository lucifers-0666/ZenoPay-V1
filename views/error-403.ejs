<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>403 - Access Denied | ZenoPay</title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main style="min-height:70vh; display:grid; place-items:center; padding:2rem;">
    <section style="text-align:center; max-width:700px;">
      <h1 style="font-size:4.5rem; margin:0;">403</h1>
      <h2 style="margin:.5rem 0 1rem 0;">Access Denied</h2>
      <p style="font-size:1.05rem; margin-bottom:.5rem;">You don't have permission to view this page.</p>
      <p style="color:#64748b; margin-bottom:1.5rem;">If you believe this is a mistake, please contact support.</p>

      <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
        <button onclick="history.back()" style="padding:.7rem 1rem; border:1px solid #d1d5db; border-radius:8px; background:#fff; cursor:pointer;">
          Go Back
        </button>
        <a href="/dashboard" style="padding:.7rem 1rem; border-radius:8px; background:#0f172a; color:#fff; text-decoration:none;">
          Go to Dashboard
        </a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
