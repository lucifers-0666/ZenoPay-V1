<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Invoice Details - ZenoPay' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --text: #1F2937;
      --muted: #6B7280;
      --muted-2: #94A3B8;
      --border: #E2E8F0;
      --line: #F1F5F9;
      --blue: #3B82F6;
      --blue-dark: #2563EB;
      --green: #10B981;
      --green-dark: #059669;
      --amber: #F59E0B;
      --red: #EF4444;
      --slate: #64748B;
      --shadow: 0 8px 24px rgba(15,23,42,0.06);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
    }

    .page {
      max-width: 1000px;
      margin: 0 auto;
      padding: 40px 24px;
    }

    .breadcrumb {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 14px;
    }

    .breadcrumb a {
      color: var(--blue);
      text-decoration: none;
      transition: .15s ease;
    }

    .breadcrumb a:hover {
      text-decoration: underline;
      color: var(--blue-dark);
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 0;
      background: transparent;
      color: var(--blue);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      padding: 8px 0;
      margin-bottom: 12px;
      font-family: inherit;
      transition: .2s ease;
    }

    .back-btn:hover {
      color: var(--blue-dark);
      transform: translateX(-3px);
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .header h1 {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      color: #1F2937;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 700;
      border: 1px solid transparent;
      text-transform: capitalize;
    }

    .status.paid {
      color: #059669;
      background: rgba(16,185,129,0.1);
      border-color: #10B981;
    }

    .status.pending {
      color: #B45309;
      background: rgba(245,158,11,0.12);
      border-color: #F59E0B;
    }

    .status.overdue {
      color: #B91C1C;
      background: rgba(239,68,68,0.1);
      border-color: #EF4444;
    }

    .status.draft {
      color: #475569;
      background: #F1F5F9;
      border-color: #CBD5E1;
    }

    .action-bar {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 24px;
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .action-meta {
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
    }

    .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--slate);
    }

    .meta-item i {
      color: var(--muted-2);
      font-size: 15px;
    }

    .meta-label {
      font-weight: 600;
      margin-right: 4px;
    }

    .actions {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      height: 42px;
      border: 0;
      border-radius: 10px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-family: inherit;
      transition: .2s ease;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, #3B82F6, #2563EB);
      color: #fff;
      box-shadow: 0 4px 14px rgba(59,130,246,0.30);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(59,130,246,0.40);
    }

    .btn-outline-blue {
      background: #fff;
      border: 1.5px solid #3B82F6;
      color: #3B82F6;
    }

    .btn-outline-blue:hover {
      background: #EFF6FF;
    }

    .btn-outline-green {
      background: #fff;
      border: 1.5px solid #10B981;
      color: #10B981;
    }

    .btn-outline-green:hover {
      background: #ECFDF5;
    }

    .btn-outline-slate {
      background: #fff;
      border: 1.5px solid #CBD5E1;
      color: #475569;
    }

    .btn-outline-slate:hover {
      background: #F8FAFC;
    }

    .invoice-preview {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 48px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .invoice-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }

    .from-details h3 {
      margin: 0 0 8px;
      font-size: 18px;
      font-weight: 700;
      color: #1F2937;
    }

    .from-details p {
      margin: 0;
      font-size: 14px;
      color: var(--muted);
      line-height: 1.6;
    }

    .invoice-meta-header {
      text-align: right;
    }

    .invoice-meta-header h2 {
      margin: 0 0 12px;
      font-size: 28px;
      font-weight: 800;
      color: var(--muted-2);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .invoice-meta-header p {
      margin: 4px 0;
      font-size: 14px;
      color: var(--slate);
      font-weight: 600;
    }

    .invoice-divider {
      height: 2px;
      background: linear-gradient(to right, #E2E8F0, transparent);
      margin: 24px 0;
    }

    .bill-to {
      margin-bottom: 32px;
    }

    .bill-to h4 {
      margin: 0 0 8px;
      font-size: 12px;
      font-weight: 700;
      color: var(--muted-2);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .bill-to h3 {
      margin: 0 0 6px;
      font-size: 18px;
      font-weight: 700;
      color: #1F2937;
    }

    .bill-to p {
      margin: 2px 0;
      font-size: 14px;
      color: var(--muted);
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }

    .items-table thead th {
      background: #F8FAFC;
      color: var(--muted-2);
      text-transform: uppercase;
      font-size: 12px;
      font-weight: 700;
      text-align: left;
      padding: 12px 16px;
      border-bottom: 2px solid var(--border);
      letter-spacing: 0.05em;
    }

    .items-table thead th:last-child,
    .items-table tbody td:last-child {
      text-align: right;
    }

    .items-table tbody td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      font-size: 14px;
      color: #1F2937;
    }

    .items-table tbody td:last-child {
      font-weight: 600;
    }

    .items-table tbody tr:last-child td {
      border-bottom: 2px solid var(--border);
    }

    .totals {
      max-width: 320px;
      margin-left: auto;
      margin-top: 20px;
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      font-size: 14px;
    }

    .total-row.subtotal,
    .total-row.tax {
      color: var(--slate);
    }

    .total-row.divider {
      border-top: 1px solid var(--border);
      margin: 8px 0;
      padding-top: 16px;
    }

    .total-row.final {
      font-size: 20px;
      font-weight: 800;
      color: #1F2937;
    }

    .payment-instructions {
      background: #F8FAFC;
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 20px 24px;
      margin-top: 32px;
    }

    .payment-instructions h4 {
      margin: 0 0 10px;
      font-size: 13px;
      font-weight: 700;
      color: var(--slate);
      text-transform: uppercase;
    }

    .payment-instructions p {
      margin: 6px 0;
      font-size: 14px;
      color: var(--muted);
    }

    .invoice-footer {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
      text-align: center;
    }

    .invoice-footer p {
      margin: 6px 0;
      font-size: 13px;
      color: var(--muted-2);
    }

    .invoice-footer .thank-you {
      font-style: italic;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .payment-history {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px 28px;
      box-shadow: var(--shadow);
    }

    .payment-history-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .payment-history-header i {
      color: var(--green);
      font-size: 20px;
    }

    .payment-history-header h3 {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      color: #1F2937;
    }

    .payment-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 18px;
      margin-top: 14px;
    }

    .payment-info-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .payment-info-item label {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted-2);
      text-transform: uppercase;
    }

    .payment-info-item span {
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
    }

    @media print {
      body { background: #fff; }
      .back-btn, .action-bar, .payment-history { display: none; }
      .invoice-preview { box-shadow: none; border: none; }
    }

    @media (max-width: 760px) {
      .page { padding: 24px 16px; }
      .invoice-preview { padding: 28px 20px; }
      .header { flex-direction: column; align-items: flex-start; }
      .action-bar { flex-direction: column; align-items: stretch; }
      .actions { width: 100%; }
      .btn { width: 100%; justify-content: center; }
      .invoice-header { flex-direction: column; }
      .invoice-meta-header { text-align: left; }
      .items-table { font-size: 13px; }
      .items-table thead th,
      .items-table tbody td { padding: 10px 8px; }
    }
  </style>
</head>
<body>
  <main class="page">
    <nav class="breadcrumb">
      <a href="/">Dashboard</a> &gt; 
      <a href="/invoices">Invoices</a> &gt; 
      <%= invoice.invoiceNo %>
    </nav>

    <button class="back-btn" onclick="window.location.href='/invoices'" type="button">
      <i class="fas fa-arrow-left"></i> Back to Invoices
    </button>

    <header class="header">
      <h1>Invoice <%= invoice.invoiceNo %></h1>
      <span class="status <%= invoice.status %>"><%= invoice.status %></span>
    </header>

    <section class="action-bar">
      <div class="action-meta">
        <div class="meta-item">
          <i class="fas fa-calendar"></i>
          <span><span class="meta-label">Created:</span><%= invoice.issueDate %></span>
        </div>
        <div class="meta-item">
          <i class="fas fa-calendar-check"></i>
          <span><span class="meta-label">Due:</span><%= invoice.dueDate %></span>
        </div>
      </div>

      <div class="actions">
        <button class="btn btn-primary" type="button" onclick="sendInvoice()">
          <i class="fas fa-paper-plane"></i> Send Invoice
        </button>
        <button class="btn btn-outline-blue" type="button" onclick="window.print()">
          <i class="fas fa-download"></i> Download PDF
        </button>
        <% if (invoice.status === 'pending' || invoice.status === 'overdue') { %>
        <button class="btn btn-outline-green" type="button" onclick="markAsPaid()">
          <i class="fas fa-check"></i> Mark as Paid
        </button>
        <% } %>
        <% if (invoice.status === 'draft') { %>
        <button class="btn btn-outline-slate" type="button" onclick="editInvoice()">
          <i class="fas fa-edit"></i> Edit Invoice
        </button>
        <% } %>
      </div>
    </section>

    <section class="invoice-preview">
      <div class="invoice-header">
        <div class="from-details">
          <h3>ZenoPay</h3>
          <p><strong>From:</strong> <%= user?.FullName || 'ZenoPay User' %></p>
          <p><%= user?.Email || 'user@zenopay.com' %></p>
          <p>ZenoPay Platform<br />Mumbai, Maharashtra 400001<br />India</p>
        </div>

        <div class="invoice-meta-header">
          <h2>INVOICE</h2>
          <p><strong>Invoice #:</strong> <%= invoice.invoiceNo.replace('#', '') %></p>
          <p><strong>Issue Date:</strong> <%= invoice.issueDate %></p>
          <p><strong>Due Date:</strong> <%= invoice.dueDate %></p>
        </div>
      </div>

      <div class="invoice-divider"></div>

      <div class="bill-to">
        <h4>Bill To:</h4>
        <h3><%= invoice.client %></h3>
        <p>Email: <%= invoice.clientEmail || 'client@example.com' %></p>
        <p>Address: <%= invoice.clientAddress || 'N/A' %></p>
      </div>

      <table class="items-table">
        <thead>
          <tr>
            <th style="width: 40px;">#</th>
            <th>Description</th>
            <th style="width: 80px;">Qty</th>
            <th style="width: 120px;">Rate</th>
            <th style="width: 120px;">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% (invoice.items || [{desc: 'Service / Product', qty: 1, rate: invoice.amount}]).forEach((item, idx) => { %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item.desc || item.description || 'Service' %></td>
            <td><%= item.qty || item.quantity || 1 %></td>
            <td>₹<%= Number(item.rate || item.price || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
            <td>₹<%= Number((item.qty || 1) * (item.rate || item.price || 0)).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="totals">
        <div class="total-row subtotal">
          <span>Subtotal:</span>
          <span>₹<%= Number(invoice.subtotal || invoice.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
        </div>
        <div class="total-row tax">
          <span>Tax (GST 18%):</span>
          <span>₹<%= Number((invoice.subtotal || invoice.amount) * 0.18).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
        </div>
        <div class="total-row divider final">
          <span>Total:</span>
          <span>₹<%= Number((invoice.subtotal || invoice.amount) * 1.18).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
        </div>
      </div>

      <div class="payment-instructions">
        <h4>Payment Instructions</h4>
        <p><strong>UPI ID:</strong> <%= user?.ZenoPayID || 'zenopay@upi' %>@zenopay</p>
        <p><strong>Bank Account:</strong> XXXX XXXX <%= String(user?.ZenoPayID || '0000').slice(-4) %></p>
        <p><strong>IFSC Code:</strong> ZENO0001234</p>
      </div>

      <div class="invoice-footer">
        <p class="thank-you">Thank you for your business!</p>
        <p>Terms & Conditions: Payment is due within 7 days. Late payments may incur additional charges.</p>
        <p>For any queries, contact us at support@zenopay.com</p>
      </div>
    </section>

    <% if (invoice.status === 'paid' && invoice.paymentInfo) { %>
    <section class="payment-history">
      <div class="payment-history-header">
        <i class="fas fa-check-circle"></i>
        <h3>Payment Received</h3>
      </div>

      <div class="payment-info">
        <div class="payment-info-item">
          <label>Date Paid</label>
          <span><%= invoice.paymentInfo.datePaid || 'N/A' %></span>
        </div>
        <div class="payment-info-item">
          <label>Payment Method</label>
          <span><%= invoice.paymentInfo.method || 'ZenoPay Wallet' %></span>
        </div>
        <div class="payment-info-item">
          <label>Transaction ID</label>
          <span><%= invoice.paymentInfo.transactionId || 'N/A' %></span>
        </div>
        <div class="payment-info-item">
          <label>Amount Received</label>
          <span>₹<%= Number(invoice.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <script>
    function sendInvoice() {
      const email = prompt('Enter recipient email address:');
      if (!email) return;

      alert(`Invoice <%= invoice.invoiceNo %> will be sent to ${email}`);
      // TODO: Implement actual email sending via API
    }

    function markAsPaid() {
      if (!confirm('Mark this invoice as paid?')) return;

      fetch('/api/invoices/<%= invoice.id %>/mark-paid', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Invoice marked as paid!');
            window.location.reload();
          } else {
            alert(data.message || 'Failed to update invoice.');
          }
        })
        .catch(err => {
          console.error('Mark paid error:', err);
          alert('Network error. Please try again.');
        });
    }

    function editInvoice() {
      window.location.href = '/invoices/<%= invoice.id %>/edit';
    }
  </script>
</body>
</html>
