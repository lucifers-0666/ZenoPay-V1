<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZenoPay - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/auth-common.css" />
    <link rel="stylesheet" href="/css/login-modern.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="/js/loader.js"></script>
  </head>
  <body class="login-body">
    <a class="skip-link" href="#login-form-card">Skip to main content</a>

    <div class="auth-shell">
      <aside class="auth-brand" aria-hidden="true">
        <div class="brand-content">
          <div class="brand-logo-wrap">
            <img
              src="/Images/bgFavicon.png"
              alt="ZenoPay"
              class="brand-logo-icon"
            />
            <h1 class="brand-logo-text">ZenoPay</h1>
          </div>

          <div class="brand-hero">
            <h2>Welcome Back to ZenoPay</h2>
            <p>Secure. Fast. Reliable digital payments.</p>
          </div>

          <div class="brand-features" aria-label="ZenoPay features">
            <article class="feature-card">
              <div class="feature-icon"><i class="fas fa-shield-halved"></i></div>
              <div class="feature-text">
                <h3>Bank-grade 256-bit Encryption</h3>
              </div>
            </article>

            <article class="feature-card">
              <div class="feature-icon"><i class="fas fa-bolt"></i></div>
              <div class="feature-text">
                <h3>Instant Money Transfers</h3>
              </div>
            </article>

            <article class="feature-card">
              <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
              <div class="feature-text">
                <h3>Real-time Transaction Monitoring</h3>
              </div>
            </article>
          </div>

          <div class="brand-stats" aria-label="ZenoPay platform stats">
            <div class="stat-item">
              <strong>1M+ Active Users</strong>
            </div>
            <div class="stat-item">
              <strong>₹10B+ Processed</strong>
            </div>
            <div class="stat-item">
              <strong>99.9% Uptime</strong>
            </div>
          </div>
        </div>

        <div class="floating-shapes" aria-hidden="true">
          <div class="shape shape-1"></div>
          <div class="shape shape-2"></div>
          <div class="shape shape-3"></div>
          <div class="shape shape-4"></div>
        </div>
      </aside>

      <main class="auth-form-panel">
        <div class="form-wrapper" id="login-form-card">
          <a href="/" class="back-link">
            <i class="fas fa-arrow-left"></i>
            <span>Back to Home</span>
          </a>

          <header class="form-header">
            <h2>Sign In to Your Account</h2>
            <p>Enter your credentials to continue</p>
          </header>

          <% if (typeof messages !== 'undefined' && messages && messages.error) { %>
          <div class="alert alert-error">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= Array.isArray(messages.error) ? messages.error[0] : messages.error %></span>
          </div>
          <% } %>

          <% if (typeof messages !== 'undefined' && messages && messages.success) { %>
          <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <span><%= Array.isArray(messages.success) ? messages.success[0] : messages.success %></span>
          </div>
          <% } %>

          <div id="inlineAlert" class="alert alert-error" style="display: none">
            <i class="fas fa-circle-exclamation"></i>
            <span id="inlineAlertText"></span>
          </div>

          <form
            id="loginForm"
            action="/login"
            method="POST"
            class="login-form"
            novalidate
          >
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } else if (typeof _csrf !== 'undefined' && _csrf) { %>
            <input type="hidden" name="_csrf" value="<%= _csrf %>" />
            <% } %>

            <div class="form-group">
              <label for="userId" class="form-label">Email or ZenoPay ID</label>
              <div class="input-wrap">
                <span class="input-icon"><i class="fas fa-envelope"></i></span>
                <input
                  type="text"
                  id="userId"
                  name="userId"
                  class="form-input"
                  placeholder="Enter your email or ZenoPay ID"
                  autocomplete="username"
                  required
                />
              </div>
              <p class="helper-text">Use your registered email or ZenoPay ID.</p>
            </div>

            <div class="form-group">
              <label for="password" class="form-label">Password</label>
              <div class="input-wrap">
                <span class="input-icon"><i class="fas fa-lock"></i></span>
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-input"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
                <button
                  type="button"
                  class="input-toggle"
                  id="passwordToggle"
                  aria-label="Toggle password visibility"
                >
                  <i id="passwordToggleIcon" class="fas fa-eye"></i>
                </button>
              </div>
            </div>

            <div class="form-options">
              <label class="remember-wrap">
                <input type="checkbox" id="remember" name="remember" />
                <span class="custom-checkbox"></span>
                <span>Remember me</span>
              </label>
              <a href="/forgot-password" class="forgot-link">Forgot Password?</a>
            </div>

            <button type="submit" class="login-btn" id="loginButton">
              <span class="btn-label">Login</span>
              <span class="btn-loader" aria-hidden="true">
                <i class="fas fa-spinner fa-spin"></i>
              </span>
            </button>
          </form>

          <div class="divider" role="separator" aria-label="Social login divider">
            <span>— or continue with —</span>
          </div>

          <div class="social-actions">
            <button type="button" class="social-btn google-btn">
              <i class="fab fa-google"></i>
              <span>Continue with Google</span>
            </button>
            <button type="button" class="social-btn apple-btn">
              <i class="fab fa-apple"></i>
              <span>Continue with Apple</span>
            </button>
          </div>

          <p class="bottom-link">
            Don't have an account?
            <a href="/register">Sign Up Free</a>
          </p>

          <div class="trust-badges">
            <div class="badge-item">
              <i class="fas fa-lock"></i>
              <span>SSL Secured</span>
            </div>
            <div class="badge-item">
              <i class="fas fa-check-circle"></i>
              <span>GDPR Compliant</span>
            </div>
            <div class="badge-item">
              <i class="fas fa-certificate"></i>
              <span>ISO Certified</span>
            </div>
          </div>
        </div>
      </main>
    </div>

    <script>
      const loginForm = document.getElementById("loginForm");
      const userIdInput = document.getElementById("userId");
      const passwordInput = document.getElementById("password");
      const passwordToggle = document.getElementById("passwordToggle");
      const passwordToggleIcon = document.getElementById("passwordToggleIcon");
      const loginButton = document.getElementById("loginButton");
      const inlineAlert = document.getElementById("inlineAlert");
      const inlineAlertText = document.getElementById("inlineAlertText");

      function setLoadingState(isLoading) {
        loginButton.disabled = isLoading;
        loginButton.classList.toggle("is-loading", isLoading);
      }

      function showInlineError(message) {
        inlineAlertText.textContent = message;
        inlineAlert.style.display = "flex";
      }

      function clearInlineError() {
        inlineAlertText.textContent = "";
        inlineAlert.style.display = "none";
      }

      passwordToggle.addEventListener("click", () => {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";
        passwordToggleIcon.classList.toggle("fa-eye", !isPassword);
        passwordToggleIcon.classList.toggle("fa-eye-slash", isPassword);
      });

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearInlineError();

        const userId = userIdInput.value.trim();
        const password = passwordInput.value.trim();

        if (!userId || !password) {
          showInlineError("Please enter both Email/ZenoPay ID and Password.");
          return;
        }

        setLoadingState(true);
        if (typeof ZenoPayLoader !== "undefined") {
          ZenoPayLoader.show("Authenticating...");
        }

        const payload = {
          userId,
          password,
          remember: !!document.getElementById("remember").checked,
        };

        const csrfInput = loginForm.querySelector('input[name="_csrf"]');
        if (csrfInput?.value) {
          payload._csrf = csrfInput.value;
        }

        try {
          const response = await fetch("/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json();

          if (response.ok && data.success) {
            if (typeof ZenoPayLoader !== "undefined") {
              ZenoPayLoader.show("Login successful! Redirecting...");
            }
            window.location.href = "/";
            return;
          }

          showInlineError(data.message || "Invalid login credentials.");
        } catch (error) {
          console.error("Login Error:", error);
          showInlineError("Server connection failed. Please try again.");
        } finally {
          if (typeof ZenoPayLoader !== "undefined") {
            ZenoPayLoader.hide();
          }
          setLoadingState(false);
        }
      });

      userIdInput.addEventListener("input", clearInlineError);
      passwordInput.addEventListener("input", clearInlineError);
    </script>
  </body>
</html>
