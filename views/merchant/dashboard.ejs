<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Merchant Dashboard' %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root { --bg:#f8fafc; --card:#fff; --text:#0f172a; --muted:#64748b; --border:#e2e8f0; --primary:#2563eb; --ok:#059669; --warn:#d97706; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); }
    .wrap { max-width: 1200px; margin: 0 auto; padding: 24px; }
    .header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom: 20px; }
    .header h1 { margin: 0; font-size: 28px; }
    .header p { margin: 6px 0 0; color: var(--muted); }
    .actions { display:flex; gap:10px; flex-wrap: wrap; }
    .btn { display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:10px; text-decoration:none; font-weight:600; font-size:14px; border:1px solid var(--border); background:#fff; color:var(--text); }
    .btn.primary { background: var(--primary); border-color: var(--primary); color:#fff; }
    .kpis { display:grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap:14px; margin-bottom: 18px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
    .kpi-label { margin:0; color: var(--muted); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .kpi-value { margin:8px 0 0; font-size: 26px; font-weight: 800; }
    .grid { display:grid; grid-template-columns: 1.2fr .8fr; gap:14px; }
    table { width:100%; border-collapse: collapse; }
    th, td { text-align:left; padding:10px 8px; border-bottom: 1px solid var(--border); font-size: 13px; }
    th { color: var(--muted); font-weight: 700; }
    .status { padding:4px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; display:inline-block; }
    .status.completed { background:#dcfce7; color:#166534; }
    .status.pending { background:#fef3c7; color:#92400e; }
    .status.failed { background:#fee2e2; color:#991b1b; }
    .quick-actions { display:grid; gap:10px; }
    .qa-link { padding:12px; border:1px solid var(--border); border-radius:10px; text-decoration:none; color:var(--text); font-weight:600; background:#fff; }
    @media (max-width: 980px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="wrap">
    <section class="header">
      <div>
        <h1><%= merchant?.BusinessName || 'Merchant' %> Dashboard</h1>
        <p>ZenoPay Business ID: <strong><%= merchant?.ZenoPayId || '-' %></strong></p>
      </div>
      <div class="actions">
        <a class="btn" href="/merchant/transactions">View Transactions</a>
        <a class="btn" href="/merchant/payouts">Payouts</a>
      </div>
    </section>

    <section class="kpis">
      <article class="card">
        <p class="kpi-label">Total Revenue</p>
        <p class="kpi-value">₹<%= Number(stats?.totalRevenue || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
      </article>
      <article class="card">
        <p class="kpi-label">Total Transactions</p>
        <p class="kpi-value"><%= Number(stats?.totalTransactions || 0).toLocaleString('en-IN') %></p>
      </article>
      <article class="card">
        <p class="kpi-label">Pending Settlements</p>
        <p class="kpi-value"><%= Number(stats?.pendingSettlements || 0).toLocaleString('en-IN') %></p>
      </article>
      <article class="card">
        <p class="kpi-label">Active Payment Links</p>
        <p class="kpi-value"><%= Number(stats?.activePaymentLinks || 0).toLocaleString('en-IN') %></p>
      </article>
    </section>

    <section class="grid">
      <article class="card">
        <h3 style="margin:0 0 12px;">Revenue (Last 7 Days)</h3>
        <canvas id="revenueChart" height="120"></canvas>
      </article>

      <article class="card">
        <h3 style="margin:0 0 12px;">Quick Actions</h3>
        <div class="quick-actions">
          <a class="qa-link" href="/qr-payment">Generate QR</a>
          <a class="qa-link" href="/request-money">Create Payment Link</a>
          <a class="qa-link" href="/merchant/payouts">Request Payout</a>
        </div>
      </article>
    </section>

    <section class="card" style="margin-top:14px;">
      <h3 style="margin:0 0 12px;">Recent Transactions</h3>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Payer</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if ((recentTransactions || []).length === 0) { %>
            <tr><td colspan="4" style="color:#64748b;">No transactions found.</td></tr>
          <% } %>
          <% (recentTransactions || []).forEach((tx) => { %>
            <tr>
              <td><%= new Date(tx.createdAt || Date.now()).toLocaleString('en-IN') %></td>
              <td><%= tx?.metadata?.counterpartyName || '-' %></td>
              <td>₹<%= Number(tx.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              <td><span class="status <%= tx.status %>"><%= tx.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </div>

  <script>
    const labels = JSON.parse('<%- JSON.stringify((chart && chart.labels) || []) %>');
    const values = JSON.parse('<%- JSON.stringify((chart && chart.data) || []) %>');
    const ctx = document.getElementById('revenueChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Revenue',
            data: values,
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37,99,235,.15)',
            borderWidth: 2,
            fill: true,
            tension: 0.35
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { ticks: { callback: (v) => '₹' + v } }
          }
        }
      });
    }
  </script>
</body>
</html>
