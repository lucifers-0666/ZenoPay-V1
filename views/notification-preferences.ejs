  <div class="save-bar">
    <div class="save-inner">
      <button class="btn btn-outline" id="resetBtn" type="button">
        <i class="fas fa-undo"></i>
        Reset to Default
      </button>
      <button class="btn btn-save" id="saveBtn" type="button">
        <i class="fas fa-save"></i>
        Save Preferences
      </button>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    (function () {
      const stateDefaults = {
        master: true,
        channels: { email: true, sms: true, push: true, whatsapp: false },
        quietHours: true,
        dailyDigest: true,
        weekend: true,
        digestTime: '9:00 AM'
      };

      const masterToggle = document.getElementById('masterToggle');
      const channelsCard = document.getElementById('channelsCard');
      const channelToggles = Array.from(document.querySelectorAll('.channel-toggle'));
      const categoryCards = Array.from(document.querySelectorAll('.category-card'));
      const quietHoursToggle = document.getElementById('quietHoursToggle');
      const quietHoursPanel = document.getElementById('quietHoursPanel');
      const dailyDigestToggle = document.getElementById('dailyDigestToggle');
      const dailyDigestTime = document.getElementById('dailyDigestTime');
      const weekendToggle = document.getElementById('weekendToggle');
      const resetBtn = document.getElementById('resetBtn');
      const saveBtn = document.getElementById('saveBtn');
      const toastEl = document.getElementById('toast');

      const notify = (message) => {
        toastEl.textContent = message;
        toastEl.classList.add('show');
        window.clearTimeout(window.__toastTimer);
        window.__toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2200);
      };

      const refreshChannelCards = () => {
        channelToggles.forEach((toggle) => {
          const card = toggle.closest('.channel-card');
          card.classList.toggle('active', toggle.checked);
        });
      };

      const syncCategoryMaster = (card) => {
        const allButtons = Array.from(card.querySelectorAll('.channel-btn'));
        const activeButtons = allButtons.filter((btn) => btn.classList.contains('active'));
        const categoryToggle = card.querySelector('.category-toggle');
        categoryToggle.checked = activeButtons.length > 0;
      };

      const applyMaster = () => {
        const on = masterToggle.checked;
        const managedSections = [channelsCard, ...categoryCards, document.querySelector('.card:last-of-type')];
        managedSections.forEach((section) => {
          section.classList.toggle('disabled-all', !on);
        });
      };

      const syncRowsWithChannels = () => {
        const enabledChannels = {};
        channelToggles.forEach((toggle) => {
          enabledChannels[toggle.dataset.channel] = toggle.checked;
        });

        document.querySelectorAll('.channel-btn').forEach((btn) => {
          const channel = btn.dataset.channel;
          if (!enabledChannels[channel]) {
            btn.classList.remove('active');
          }
        });

        categoryCards.forEach(syncCategoryMaster);
      };

      categoryCards.forEach((card) => {
        const header = card.querySelector('.category-header');
        const categoryToggle = card.querySelector('.category-toggle');

        header.addEventListener('click', (event) => {
          if (event.target.closest('.toggle')) return;
          card.classList.toggle('expanded');
        });

        categoryToggle.addEventListener('change', () => {
          const rowButtons = Array.from(card.querySelectorAll('.channel-btn'));
          rowButtons.forEach((btn) => {
            const channelEnabled = document.querySelector(`.channel-toggle[data-channel="${btn.dataset.channel}"]`)?.checked;
            btn.classList.toggle('active', categoryToggle.checked && !!channelEnabled);
          });
        });

        card.querySelectorAll('.channel-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const channelEnabled = document.querySelector(`.channel-toggle[data-channel="${btn.dataset.channel}"]`)?.checked;
            if (!channelEnabled) {
              notify('Enable this channel first in Notification Channels.');
              return;
            }
            btn.classList.toggle('active');
            syncCategoryMaster(card);
          });
        });
      });

      channelToggles.forEach((toggle) => {
        toggle.addEventListener('change', () => {
          refreshChannelCards();
          syncRowsWithChannels();
        });
      });

      masterToggle.addEventListener('change', applyMaster);

      quietHoursToggle.addEventListener('change', () => {
        quietHoursPanel.style.display = quietHoursToggle.checked ? 'block' : 'none';
      });

      resetBtn.addEventListener('click', () => {
        masterToggle.checked = stateDefaults.master;
        channelToggles.forEach((toggle) => {
          toggle.checked = !!stateDefaults.channels[toggle.dataset.channel];
        });

        document.querySelectorAll('.channel-btn').forEach((btn) => {
          const channel = btn.dataset.channel;
          btn.classList.toggle('active', stateDefaults.channels[channel]);
        });

        categoryCards.forEach((card) => {
          card.classList.remove('expanded');
          const toggle = card.querySelector('.category-toggle');
          toggle.checked = true;
          syncCategoryMaster(card);
        });

        categoryCards[0]?.classList.add('expanded');
        quietHoursToggle.checked = stateDefaults.quietHours;
        dailyDigestToggle.checked = stateDefaults.dailyDigest;
        weekendToggle.checked = stateDefaults.weekend;
        dailyDigestTime.value = stateDefaults.digestTime;

        quietHoursPanel.style.display = quietHoursToggle.checked ? 'block' : 'none';
        refreshChannelCards();
        applyMaster();
        notify('Preferences reset to default.');
      });

      saveBtn.addEventListener('click', () => {
        notify('Notification preferences saved successfully.');
      });

      quietHoursPanel.style.display = quietHoursToggle.checked ? 'block' : 'none';
      refreshChannelCards();
      syncRowsWithChannels();
      applyMaster();
    })();
  </script>
