<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Notification Preferences - ZenoPay' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --text: #1F2937;
      --muted: #6B7280;
      --muted-2: #94A3B8;
      --white: #FFFFFF;
      --border: #E2E8F0;
      --line: #F1F5F9;
      --blue: #3B82F6;
      --purple: #8B5CF6;
      --green: #10B981;
      --slate: #475569;
      --shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
      --blue-grad: linear-gradient(135deg, #3B82F6, #8B5CF6);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      font-family: 'Inter', sans-serif;
      color: var(--text);
      min-height: 100vh;
    }

    .content-wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 24px;
    }

    .breadcrumb {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 18px;
    }

    .header-block { margin-bottom: 32px; }

    .header-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 8px;
    }

    .header-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: var(--blue-grad);
      display: grid;
      place-items: center;
      color: #fff;
      flex-shrink: 0;
    }

    .header-icon i { font-size: 28px; }

    h1 {
      margin: 0;
      font-size: 32px;
      font-weight: 800;
      color: #1F2937;
      letter-spacing: -0.02em;
    }

    .subtitle {
      margin: 0;
      font-size: 15px;
      color: var(--muted);
    }

    .quick-toggle {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
    }

    .quick-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .quick-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #EFF6FF;
      color: var(--blue);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .quick-title {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
    }

    .quick-sub {
      margin: 3px 0 0;
      font-size: 13px;
      color: var(--muted);
    }

    .toggle {
      position: relative;
      width: 48px;
      height: 28px;
      display: inline-flex;
      flex-shrink: 0;
      cursor: pointer;
    }

    .toggle.large { width: 60px; height: 34px; }

    .toggle input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      inset: 0;
      background: #CBD5E1;
      border-radius: 999px;
      transition: 0.24s ease;
    }

    .slider::before {
      content: '';
      position: absolute;
      width: 22px;
      height: 22px;
      left: 3px;
      top: 3px;
      border-radius: 50%;
      background: #fff;
      transition: 0.24s ease;
      box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    }

    .toggle.large .slider::before {
      width: 26px;
      height: 26px;
      left: 4px;
      top: 4px;
    }

    .toggle input:checked + .slider { background: #3B82F6; }
    .toggle input:checked + .slider::before { transform: translateX(20px); }
    .toggle.large input:checked + .slider::before { transform: translateX(26px); }

    .tabs-wrap {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 6px;
      display: flex;
      gap: 4px;
      margin-bottom: 24px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .tab-btn {
      border: 0;
      background: transparent;
      color: var(--slate);
      font-size: 14px;
      font-weight: 600;
      border-radius: 8px;
      padding: 10px 20px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .tab-btn:hover { background: #F1F5F9; }

    .tab-btn.active {
      background: var(--blue-grad);
      color: #fff;
    }

    .category-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      box-shadow: var(--shadow);
      margin-bottom: 20px;
    }

    .category-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      border-bottom: 1px solid #F1F5F9;
      padding-bottom: 20px;
      margin-bottom: 20px;
    }

    .cat-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .cat-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--blue-grad);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .cat-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .cat-title {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      color: #1F2937;
    }

    .count-badge {
      background: #EFF6FF;
      color: #2563EB;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 600;
    }

    .cat-right {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--slate);
      font-weight: 600;
      flex-shrink: 0;
    }

    .notification-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid #F8FAFC;
    }

    .notification-row:last-child { border-bottom: none; }

    .row-left {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      min-width: 0;
      padding-right: 10px;
    }

    .row-left i {
      font-size: 16px;
      color: #94A3B8;
      margin-top: 2px;
      flex-shrink: 0;
    }

    .row-title {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
    }

    .row-desc {
      margin: 2px 0 0;
      font-size: 12px;
      color: #94A3B8;
    }

    .digest-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px;
      margin-top: 4px;
    }

    .digest-head {
      margin: 0 0 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      font-weight: 700;
      color: #1F2937;
    }

    .digest-head i { color: #3B82F6; }

    .pill-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }

    .pill {
      height: 36px;
      padding: 0 18px;
      border: 1.5px solid #E2E8F0;
      border-radius: 20px;
      background: #fff;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .pill.active {
      background: var(--blue-grad);
      color: #fff;
      border-color: transparent;
    }

    .quiet-row {
      border-top: 1px solid #F1F5F9;
      padding-top: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .quiet-title {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
    }

    .quiet-sub {
      margin: 2px 0 0;
      font-size: 12px;
      color: #94A3B8;
    }

    .time-range {
      margin-top: 14px;
      display: none;
      gap: 12px;
      flex-wrap: wrap;
    }

    .time-range.show { display: flex; }

    .time-field {
      min-width: 180px;
      flex: 1;
    }

    .time-field label {
      display: block;
      font-size: 12px;
      color: #64748B;
      margin-bottom: 6px;
      font-weight: 600;
    }

    .time-input-wrap {
      height: 44px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 12px;
    }

    .time-input-wrap i { color: #94A3B8; }

    .time-input-wrap input {
      border: none;
      outline: none;
      width: 100%;
      font-size: 14px;
      color: #334155;
      background: transparent;
      font-family: inherit;
    }

    .contact-strip {
      background: #F0F7FF;
      border: 1px solid #BFDBFE;
      border-radius: 12px;
      padding: 16px 24px;
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .contact-row {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #1F2937;
      flex-wrap: wrap;
    }

    .contact-row .email-ico { color: #3B82F6; }
    .contact-row .phone-ico { color: #10B981; }

    .edit-link {
      color: #2563EB;
      font-size: 13px;
      text-decoration: none;
      font-weight: 600;
    }

    .actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 24px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      height: 48px;
      border-radius: 12px;
      padding: 0 18px;
      font-size: 14px;
      font-weight: 700;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-discard {
      background: #fff;
      border-color: #CBD5E1;
      color: #475569;
    }

    .btn-discard:hover { background: #F8FAFC; }

    .btn-save {
      background: var(--blue-grad);
      color: #fff;
      box-shadow: 0 10px 20px rgba(59, 130, 246, 0.22);
    }

    .btn-save:hover { transform: translateY(-1px); }

    .paused {
      opacity: 0.55;
      pointer-events: none;
    }

    .toast {
      position: fixed;
      right: 18px;
      bottom: 18px;
      background: #16A34A;
      color: #fff;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 12px 24px rgba(16, 185, 129, 0.3);
      opacity: 0;
      transform: translateY(20px);
      pointer-events: none;
      z-index: 1200;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
      animation: fadeInUp 0.28s ease;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
      .content-wrapper { padding: 28px 16px; }
      h1 { font-size: 28px; }
      .quick-toggle { padding: 14px 16px; }
      .category-card { padding: 20px 16px; }
      .notification-row { padding: 10px 0; }
      .digest-card { padding: 18px 16px; }
      .actions { justify-content: stretch; }
      .actions .btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <% const emailAddress = (user && user.Email) ? user.Email : 'user@example.com'; %>
  <% const phoneRaw = (user && user.PhoneNumber) ? String(user.PhoneNumber) : '+91 98765 XXXXX'; %>

  <main class="content-wrapper">
    <div class="breadcrumb">Dashboard &gt; Settings &gt; Notification Preferences</div>

    <section class="header-block">
      <div class="header-row">
        <div class="header-icon"><i class="fas fa-bell" aria-hidden="true"></i></div>
        <h1>Notification Preferences</h1>
      </div>
      <p class="subtitle">Choose what you hear about and how you hear it</p>
    </section>

    <section class="quick-toggle">
      <div class="quick-left">
        <div class="quick-icon"><i class="fas fa-bell-slash"></i></div>
        <div>
          <p class="quick-title">Pause All Notifications</p>
          <p class="quick-sub">Temporarily stop all notifications</p>
        </div>
      </div>
      <label class="toggle large" aria-label="Pause all notifications toggle">
        <input id="pauseAll" type="checkbox" />
        <span class="slider"></span>
      </label>
    </section>

    <section class="tabs-wrap" id="tabsWrap">
      <button class="tab-btn active" data-tab="email"><i class="fas fa-envelope"></i> Email</button>
      <button class="tab-btn" data-tab="sms"><i class="fas fa-sms"></i> SMS</button>
      <button class="tab-btn" data-tab="inapp"><i class="fas fa-bell"></i> In-App</button>
      <button class="tab-btn" data-tab="push"><i class="fas fa-mobile-alt"></i> Push</button>
    </section>

    <section id="categoriesMount"></section>

    <section class="digest-card" id="digestCard">
      <h3 class="digest-head"><i class="fas fa-clock"></i> Email Digest Frequency</h3>
      <div class="pill-group" id="digestPills">
        <button class="pill active" data-frequency="real-time" type="button">Real-time</button>
        <button class="pill" data-frequency="daily" type="button">Daily Digest</button>
        <button class="pill" data-frequency="weekly" type="button">Weekly Digest</button>
      </div>

      <div class="quiet-row">
        <div>
          <p class="quiet-title">Quiet Hours</p>
          <p class="quiet-sub">Suppress notifications between set hours</p>
        </div>
        <label class="toggle" aria-label="Quiet hours toggle">
          <input id="quietToggle" type="checkbox" />
          <span class="slider"></span>
        </label>
      </div>

      <div class="time-range" id="timeRange">
        <div class="time-field">
          <label for="quietFrom">From</label>
          <div class="time-input-wrap">
            <i class="fas fa-clock"></i>
            <input id="quietFrom" type="time" value="22:00" />
          </div>
        </div>
        <div class="time-field">
          <label for="quietTo">To</label>
          <div class="time-input-wrap">
            <i class="fas fa-clock"></i>
            <input id="quietTo" type="time" value="07:00" />
          </div>
        </div>
      </div>
    </section>

    <section class="contact-strip">
      <div class="contact-row">
        <i class="fas fa-envelope email-ico"></i>
        <span>Sending to: <strong><%= emailAddress %></strong></span>
        <a href="/account-settings" class="edit-link">Edit</a>
      </div>
      <div class="contact-row" id="phoneRow" data-phone="<%= phoneRaw %>">
        <i class="fas fa-phone phone-ico"></i>
        <span id="phoneLabel">SMS to: <strong><%= phoneRaw %></strong></span>
        <a href="/account-settings" class="edit-link">Edit</a>
      </div>
    </section>

    <section class="actions">
      <button class="btn btn-discard" id="discardBtn" type="button"><i class="fas fa-times"></i> Discard Changes</button>
      <button class="btn btn-save" id="saveBtn" type="button"><i class="fas fa-save"></i> Save Preferences</button>
    </section>
  </main>

  <div class="toast" id="saveToast" role="status" aria-live="polite">Preferences saved</div>
  <script id="notificationStateData" type="application/json"><%- JSON.stringify(notificationStateData || null) %></script>

  <script>
    (function () {
      const stateNode = document.getElementById('notificationStateData');
      let serverState = null;
      try {
        serverState = stateNode?.textContent ? JSON.parse(stateNode.textContent) : null;
      } catch (error) {
        serverState = null;
      }

      const getDefaultCategoriesByTab = () => {
        const email = [
          {
            icon: 'fa-paper-plane',
            name: 'Transactions',
            items: [
              { icon: 'fa-paper-plane', title: 'Money Sent', desc: 'When you send money to someone', enabled: true },
              { icon: 'fa-arrow-down', title: 'Money Received', desc: 'When someone sends you money', enabled: true },
              { icon: 'fa-clock', title: 'Payment Pending', desc: 'When your payment is awaiting confirmation', enabled: true },
              { icon: 'fa-times-circle', title: 'Payment Failed', desc: 'When a payment fails to process', enabled: true },
              { icon: 'fa-undo', title: 'Refund Processed', desc: 'When a refund is credited to your account', enabled: true },
              { icon: 'fa-calendar-check', title: 'Scheduled Payment Executed', desc: 'When a scheduled payment runs', enabled: true }
            ]
          },
          {
            icon: 'fa-shield-alt',
            name: 'Security',
            items: [
              { icon: 'fa-sign-in-alt', title: 'New Login', desc: 'When a new device signs into your account', enabled: true },
              { icon: 'fa-mobile-alt', title: '2FA Changes', desc: 'When 2FA is enabled or disabled', enabled: true },
              { icon: 'fa-lock', title: 'Password Changed', desc: 'When your password is updated', enabled: true },
              { icon: 'fa-exclamation-triangle', title: 'Suspicious Activity', desc: 'When unusual behavior is detected', enabled: true }
            ]
          },
          {
            icon: 'fa-user-circle',
            name: 'Account',
            items: [
              { icon: 'fa-user-check', title: 'KYC Status Update', desc: 'Approval or rejection of your KYC', enabled: true },
              { icon: 'fa-wallet', title: 'Balance Low Alert', desc: 'When balance drops below ₹500', enabled: true },
              { icon: 'fa-gift', title: 'Referral Reward', desc: 'When a referral bonus is credited', enabled: true }
            ]
          },
          {
            icon: 'fa-bullhorn',
            name: 'Marketing',
            items: [
              { icon: 'fa-tag', title: 'Offers & Promotions', desc: 'Deals and discounts from ZenoPay', enabled: false },
              { icon: 'fa-newspaper', title: 'Product Updates', desc: 'New features and improvements', enabled: true },
              { icon: 'fa-envelope', title: 'Newsletter', desc: 'Monthly digest from ZenoPay', enabled: false }
            ]
          }
        ];

        return {
          email,
          sms: JSON.parse(JSON.stringify(email)),
          inapp: JSON.parse(JSON.stringify(email)),
          push: JSON.parse(JSON.stringify(email))
        };
      };

      const getDefaultState = () => ({
        tab: 'email',
        paused: false,
        digestFrequency: 'real-time',
        quietHours: false,
        quietFrom: '22:00',
        quietTo: '07:00',
        categoriesByTab: getDefaultCategoriesByTab()
      });

      const cloneDeep = (value) => JSON.parse(JSON.stringify(value));
      const safeState = serverState && typeof serverState === 'object' ? serverState : getDefaultState();
      const categoriesByTab = safeState.categoriesByTab && typeof safeState.categoriesByTab === 'object'
        ? cloneDeep(safeState.categoriesByTab)
        : getDefaultCategoriesByTab();

      const state = {
        tab: safeState.tab || 'email',
        paused: !!safeState.paused,
        digestFrequency: ['real-time', 'daily', 'weekly'].includes(safeState.digestFrequency) ? safeState.digestFrequency : 'real-time',
        quietHours: !!safeState.quietHours,
        quietFrom: safeState.quietFrom || '22:00',
        quietTo: safeState.quietTo || '07:00',
        snapshot: null
      };

      const elements = {
        mount: document.getElementById('categoriesMount'),
        tabs: Array.from(document.querySelectorAll('.tab-btn')),
        pauseAll: document.getElementById('pauseAll'),
        digestCard: document.getElementById('digestCard'),
        digestPills: Array.from(document.querySelectorAll('#digestPills .pill')),
        quietToggle: document.getElementById('quietToggle'),
        quietFrom: document.getElementById('quietFrom'),
        quietTo: document.getElementById('quietTo'),
        timeRange: document.getElementById('timeRange'),
        discardBtn: document.getElementById('discardBtn'),
        saveBtn: document.getElementById('saveBtn'),
        toast: document.getElementById('saveToast'),
        phoneRow: document.getElementById('phoneRow'),
        phoneLabel: document.getElementById('phoneLabel')
      };

      const maskPhone = (phone) => {
        if (!phone) return '+91 98765 XXXXX';
        const str = String(phone).trim();
        const digits = str.replace(/\D/g, '');
        if (digits.length < 5) return str;
        const masked = `${digits.slice(0, Math.max(0, digits.length - 5))}XXXXX`;
        if (str.startsWith('+')) {
          const country = str.split(' ')[0];
          const rest = masked.slice(country.replace(/\D/g, '').length);
          return `${country} ${rest || 'XXXXX'}`.trim();
        }
        return masked;
      };

      const showToast = (message, type = 'success') => {
        elements.toast.textContent = message;
        elements.toast.style.background = type === 'error' ? '#DC2626' : '#16A34A';
        elements.toast.style.boxShadow = type === 'error'
          ? '0 12px 24px rgba(220, 38, 38, 0.32)'
          : '0 12px 24px rgba(16, 185, 129, 0.3)';
        elements.toast.classList.add('show');
        clearTimeout(window.__notifToast);
        window.__notifToast = setTimeout(() => elements.toast.classList.remove('show'), 3000);
      };

      const setDigestVisibility = () => {
        elements.digestCard.style.display = state.tab === 'email' ? 'block' : 'none';
      };

      const renderCategories = () => {
        const categories = categoriesByTab[state.tab] || [];

        elements.mount.innerHTML = categories.map((category, categoryIndex) => {
          const enabledCount = category.items.filter((item) => item.enabled).length;

          return `
            <article class="category-card" data-category-index="${categoryIndex}">
              <header class="category-header">
                <div class="cat-left">
                  <div class="cat-icon"><i class="fas ${category.icon}"></i></div>
                  <div>
                    <div class="cat-title-row">
                      <h3 class="cat-title">${category.name}</h3>
                      <span class="count-badge">${category.items.length} notifications</span>
                    </div>
                  </div>
                </div>
                <div class="cat-right">
                  <span>Enable All</span>
                  <label class="toggle" aria-label="Enable all in ${category.name}">
                    <input class="category-toggle" data-category-index="${categoryIndex}" type="checkbox" ${enabledCount === category.items.length ? 'checked' : ''}>
                    <span class="slider"></span>
                  </label>
                </div>
              </header>

              ${category.items.map((item, itemIndex) => `
                <div class="notification-row">
                  <div class="row-left">
                    <i class="fas ${item.icon}"></i>
                    <div>
                      <p class="row-title">${item.title}</p>
                      <p class="row-desc">${item.desc}</p>
                    </div>
                  </div>
                  <label class="toggle" aria-label="Toggle ${item.title}">
                    <input class="item-toggle" data-category-index="${categoryIndex}" data-item-index="${itemIndex}" type="checkbox" ${item.enabled ? 'checked' : ''}>
                    <span class="slider"></span>
                  </label>
                </div>
              `).join('')}
            </article>
          `;
        }).join('');

        bindCategoryEvents();
      };

      const bindCategoryEvents = () => {
        const categoryToggles = Array.from(document.querySelectorAll('.category-toggle'));
        const itemToggles = Array.from(document.querySelectorAll('.item-toggle'));

        categoryToggles.forEach((toggle) => {
          toggle.addEventListener('change', () => {
            const categoryIndex = Number(toggle.dataset.categoryIndex);
            const category = categoriesByTab[state.tab][categoryIndex];
            category.items.forEach((item) => { item.enabled = toggle.checked; });
            renderCategories();
            applyPausedState();
          });
        });

        itemToggles.forEach((toggle) => {
          toggle.addEventListener('change', () => {
            const categoryIndex = Number(toggle.dataset.categoryIndex);
            const itemIndex = Number(toggle.dataset.itemIndex);
            categoriesByTab[state.tab][categoryIndex].items[itemIndex].enabled = toggle.checked;
            syncCategoryMasterToggle(categoryIndex);
          });
        });
      };

      const syncCategoryMasterToggle = (categoryIndex) => {
        const category = categoriesByTab[state.tab][categoryIndex];
        const categoryToggle = document.querySelector(`.category-toggle[data-category-index="${categoryIndex}"]`);
        if (!category || !categoryToggle) return;
        categoryToggle.checked = category.items.every((item) => item.enabled);
      };

      const applyPausedState = () => {
        const blocks = [document.getElementById('tabsWrap'), elements.mount, elements.digestCard, document.querySelector('.contact-strip')];
        blocks.forEach((block) => {
          if (!block) return;
          if (state.paused) block.classList.add('paused');
          else block.classList.remove('paused');
        });
      };

      const getPayload = () => ({
        tab: state.tab,
        paused: state.paused,
        digestFrequency: state.digestFrequency,
        quietHours: state.quietHours,
        quietFrom: elements.quietFrom?.value || state.quietFrom,
        quietTo: elements.quietTo?.value || state.quietTo,
        categoriesByTab
      });

      const captureSnapshot = () => {
        state.snapshot = cloneDeep(getPayload());
      };

      const restoreSnapshot = () => {
        if (!state.snapshot) return;

        state.tab = state.snapshot.tab;
        state.paused = state.snapshot.paused;
        state.digestFrequency = state.snapshot.digestFrequency;
        state.quietHours = state.snapshot.quietHours;
        state.quietFrom = state.snapshot.quietFrom;
        state.quietTo = state.snapshot.quietTo;

        Object.keys(categoriesByTab).forEach((key) => {
          categoriesByTab[key] = cloneDeep(state.snapshot.categoriesByTab[key] || []);
        });

        elements.tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.tab === state.tab));
        elements.pauseAll.checked = state.paused;
        elements.digestPills.forEach((pill) => pill.classList.toggle('active', pill.dataset.frequency === state.digestFrequency));
        elements.quietToggle.checked = state.quietHours;
        elements.timeRange.classList.toggle('show', state.quietHours);
        if (elements.quietFrom) elements.quietFrom.value = state.quietFrom;
        if (elements.quietTo) elements.quietTo.value = state.quietTo;

        setDigestVisibility();
        renderCategories();
        applyPausedState();
      };

      elements.tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          state.tab = tab.dataset.tab;
          elements.tabs.forEach((btn) => btn.classList.toggle('active', btn === tab));
          setDigestVisibility();
          renderCategories();
          applyPausedState();
        });
      });

      elements.pauseAll.addEventListener('change', () => {
        state.paused = elements.pauseAll.checked;
        applyPausedState();
      });

      elements.digestPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          state.digestFrequency = pill.dataset.frequency;
          elements.digestPills.forEach((btn) => btn.classList.toggle('active', btn === pill));
        });
      });

      elements.quietToggle.addEventListener('change', () => {
        state.quietHours = elements.quietToggle.checked;
        elements.timeRange.classList.toggle('show', state.quietHours);
      });

      if (elements.quietFrom) {
        elements.quietFrom.addEventListener('change', () => {
          state.quietFrom = elements.quietFrom.value;
        });
      }

      if (elements.quietTo) {
        elements.quietTo.addEventListener('change', () => {
          state.quietTo = elements.quietTo.value;
        });
      }

      elements.discardBtn.addEventListener('click', restoreSnapshot);

      elements.saveBtn.addEventListener('click', async () => {
        try {
          elements.saveBtn.disabled = true;
          const payload = getPayload();

          const response = await fetch('/settings/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ notificationState: payload })
          });

          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.success) {
            throw new Error(result.message || 'Failed to save preferences');
          }

          captureSnapshot();
          showToast('Preferences saved', 'success');
        } catch (error) {
          showToast(error.message || 'Failed to save preferences', 'error');
        } finally {
          elements.saveBtn.disabled = false;
        }
      });

      const rawPhone = elements.phoneRow?.dataset.phone || '';
      const masked = maskPhone(rawPhone);
      if (elements.phoneLabel) {
        elements.phoneLabel.innerHTML = `SMS to: <strong>${masked}</strong>`;
      }

      elements.pauseAll.checked = state.paused;
      elements.quietToggle.checked = state.quietHours;
      if (elements.quietFrom) elements.quietFrom.value = state.quietFrom;
      if (elements.quietTo) elements.quietTo.value = state.quietTo;
      elements.timeRange.classList.toggle('show', state.quietHours);
      elements.digestPills.forEach((pill) => pill.classList.toggle('active', pill.dataset.frequency === state.digestFrequency));
      elements.tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.tab === state.tab));

      captureSnapshot();
      renderCategories();
      setDigestVisibility();
      applyPausedState();
    })();
  </script>
</body>
</html>
