<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle || 'Notifications' %> - ZenoPay</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="/js/loader.js"></script>
    <script src="/js/confirmation.js"></script>
    <script src="/js/navbar.js" defer></script>

    <style>
      :root {
        --primary: #3B82F6;
        --primary-dark: #2563EB;
        --secondary: #8B5CF6;
        --success: #10B981;
        --danger: #EF4444;
        --warning: #F59E0B;
        --bg-primary: #FFFFFF;
        --bg-secondary: #F9FAFB;
        --bg-light: #F3F4F6;
        --border: #E5E7EB;
        --text-primary: #1F2937;
        --text-secondary: #6B7280;
        --text-light: #9CA3AF;
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: linear-gradient(180deg, #ffffff 0%, var(--bg-light) 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--text-primary);
      }

      .notifications-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      .not-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      .not-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .not-title i {
        color: var(--primary);
      }

      .btn-group {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        white-space: nowrap;
      }

      .btn-primary {
        background: var(--primary);
        color: white;
        box-shadow: var(--shadow-md);
      }

      .btn-primary:hover:not(:disabled) {
        background: var(--primary-dark);
        box-shadow: var(--shadow-lg);
        transform: translateY(-1px);
      }

      .btn-secondary {
        background: var(--bg-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border);
      }

      .btn-secondary:hover:not(:disabled) {
        background: var(--bg-light);
        border-color: var(--primary);
      }

      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .filter-tabs {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }

      .filter-tab {
        padding: 0.625rem 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: all 0.2s ease;
        color: var(--text-secondary);
        font-weight: 500;
      }

      .filter-tab:hover {
        background: var(--bg-light);
        border-color: var(--primary);
      }

      .filter-tab.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
      }

      .notifications-list {
        background: var(--bg-primary);
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-md);
        overflow: hidden;
      }

      .notification-item {
        display: flex;
        padding: 1.5rem;
        border-bottom: 1px solid var(--border);
        align-items: flex-start;
        transition: all 0.2s ease;
      }

      .notification-item:last-child {
        border-bottom: none;
      }

      .notification-item:hover {
        background: var(--bg-secondary);
      }

      .notification-item.unread {
        background: linear-gradient(to right, rgba(59, 130, 246, 0.05), rgba(139, 92, 246, 0.02));
        border-left: 4px solid var(--primary);
      }

      .notif-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1.25rem;
        flex-shrink: 0;
        font-size: 1.25rem;
      }

      .notif-icon.credit {
        background: #ECFDF5;
        color: var(--success);
      }

      .notif-icon.debit {
        background: #FEF2F2;
        color: var(--danger);
      }

      .notif-icon.info {
        background: #EFF6FF;
        color: var(--primary);
      }

      .notif-icon.warning {
        background: #FFFBEB;
        color: var(--warning);
      }

      .notif-icon.reward {
        background: #FEFCE8;
        color: #EAB308;
      }

      .notif-content {
        flex: 1;
      }

      .notif-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.25rem;
        gap: 1rem;
      }

      .notif-title {
        font-weight: 700;
        color: var(--text-primary);
        font-size: 0.95rem;
      }

      .notif-amount {
        font-weight: 700;
        font-size: 1rem;
        white-space: nowrap;
      }

      .notif-amount.credit {
        color: var(--success);
      }

      .notif-amount.debit {
        color: var(--danger);
      }

      .notif-message {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }

      .notif-time {
        font-size: 0.85rem;
        color: var(--text-light);
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      .empty-container {
        text-align: center;
        padding: 4rem 2rem;
      }

      .empty-icon {
        font-size: 3.5rem;
        color: var(--text-light);
        margin-bottom: 1rem;
      }

      .empty-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
      }

      .empty-text {
        color: var(--text-secondary);
        font-size: 0.95rem;
      }

      @media (max-width: 768px) {
        .not-header {
          flex-direction: column;
          align-items: flex-start;
        }

        .btn-group {
          width: 100%;
        }

        .btn {
          flex: 1;
          justify-content: center;
        }

        .notification-item {
          padding: 1.25rem;
        }

        .notif-icon {
          width: 40px;
          height: 40px;
          font-size: 1.1rem;
          margin-right: 1rem;
        }

        .notif-header {
          flex-direction: column;
        }

        .notif-amount {
          font-size: 0.9rem;
        }
      }
    </style>
  </head>

  <body>
    <%- include('partials/header') %>

    <main class="main-content">
      <div class="notifications-wrapper">
        <div class="not-header">
          <h1 class="not-title">
            <i class="fas fa-bell"></i> Notifications
          </h1>
          <div class="btn-group">
            <button id="markAllReadBtn" class="btn btn-primary" title="Mark all as read">
              <i class="fas fa-check-double"></i> Mark All Read
            </button>
            <button id="deleteReadBtn" class="btn btn-secondary" title="Delete read notifications">
              <i class="fas fa-trash-alt"></i> Clear Read
            </button>
          </div>
        </div>

        <div class="filter-tabs">
          <div class="filter-tab active" data-filter="all">All</div>
          <div class="filter-tab" data-filter="unread">Unread</div>
          <div class="filter-tab" data-filter="credit">Credits</div>
          <div class="filter-tab" data-filter="debit">Debits</div>
          <div class="filter-tab" data-filter="info">Info</div>
        </div>

        <div class="notifications-list">
          <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(n => { %>
              <div
                class="notification-item <%= !n.IsRead ? 'unread' : '' %>"
                data-type="<%= n.Type %>"
                data-read="<%= n.IsRead ? 'true' : 'false' %>"
              >
                <div class="notif-icon <%= n.Type %>">
                  <i class="fas <%= 
                    n.Type === 'credit' ? 'fa-arrow-down' : 
                    n.Type === 'debit' ? 'fa-arrow-up' : 
                    n.Type === 'warning' ? 'fa-exclamation-triangle' : 
                    n.Type === 'reward' ? 'fa-gift' : 
                    'fa-info-circle' 
                  %>"></i>
                </div>
                <div class="notif-content">
                  <div class="notif-header">
                    <div>
                      <div class="notif-title"><%= n.Title %></div>
                      <div class="notif-message"><%= n.Message %></div>
                      <div class="notif-time">
                        <i class="far fa-clock"></i>
                        <span class="time-ago" data-time="<%= n.createdAt %>"></span>
                      </div>
                    </div>
                    <% if (n.Amount) { %>
                      <div class="notif-amount <%= n.Type %>">
                        <%= n.Type === 'credit' ? '+' : '-' %>₹<%= parseFloat(n.Amount).toFixed(2) %>
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="empty-container">
              <div class="empty-icon">
                <i class="fas fa-bell-slash"></i>
              </div>
              <div class="empty-title">No Notifications</div>
              <div class="empty-text">You are all caught up!</div>
            </div>
          <% } %>
        </div>
      </div>
    </main>

    <script nonce="<%= locals.cspNonce || '' %>">
      document.addEventListener("DOMContentLoaded", () => {
        // Time ago formatter
        function getTimeAgo(date) {
          const seconds = Math.floor((new Date() - date) / 1000);
          let interval = Math.floor(seconds / 31536000);
          if (interval >= 1) return interval + "y ago";
          interval = Math.floor(seconds / 2592000);
          if (interval >= 1) return interval + "mo ago";
          interval = Math.floor(seconds / 86400);
          if (interval >= 1) return interval + "d ago";
          interval = Math.floor(seconds / 3600);
          if (interval >= 1) return interval + "h ago";
          interval = Math.floor(seconds / 60);
          if (interval >= 1) return interval + "m ago";
          return "Just now";
        }

        function updateTimes() {
          document.querySelectorAll(".time-ago").forEach((el) => {
            const dateStr = el.dataset.time;
            if (dateStr) {
              el.textContent = getTimeAgo(new Date(dateStr));
            }
          });
        }

        updateTimes();
        setInterval(updateTimes, 60000);

        // Filter tabs
        const tabs = document.querySelectorAll(".filter-tab");
        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            tabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");

            const filter = tab.dataset.filter;
            const items = document.querySelectorAll(".notification-item");

            items.forEach((item) => {
              if (filter === "all") {
                item.style.display = "flex";
              } else if (filter === "unread") {
                item.style.display = item.dataset.read === "false" ? "flex" : "none";
              } else {
                item.style.display = item.dataset.type === filter ? "flex" : "none";
              }
            });
          });
        });

        // Mark all read
        const markAllReadBtn = document.getElementById("markAllReadBtn");
        if (markAllReadBtn) {
          markAllReadBtn.addEventListener("click", async () => {
            const items = document.querySelectorAll(".notification-item[data-read='false']");
            if (items.length === 0) {
              if (typeof ZenoAlert !== "undefined") {
                ZenoAlert.info("Info", "No unread notifications");
              }
              return;
            }

            markAllReadBtn.disabled = true;
            const originalText = markAllReadBtn.innerHTML;
            markAllReadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

            try {
              const res = await fetch("/api/notifications/mark-all-read", { method: "POST" });
              const data = await res.json();

              if (data.success) {
                document.querySelectorAll(".notification-item").forEach((item) => {
                  item.classList.remove("unread");
                  item.dataset.read = "true";
                });

                if (typeof ZenoAlert !== "undefined") {
                  ZenoAlert.success("Success", "All marked as read");
                }
                setTimeout(() => location.reload(), 1000);
              } else {
                throw new Error(data.message || "Failed");
              }
            } catch (err) {
              console.error(err);
              if (typeof ZenoAlert !== "undefined") {
                ZenoAlert.error("Error", "Failed to mark as read");
              }
              markAllReadBtn.innerHTML = originalText;
              markAllReadBtn.disabled = false;
            }
          });
        }

        // Delete read
        const deleteReadBtn = document.getElementById("deleteReadBtn");
        if (deleteReadBtn) {
          deleteReadBtn.addEventListener("click", async () => {
            const items = document.querySelectorAll(".notification-item[data-read='true']");
            if (items.length === 0) {
              if (typeof ZenoAlert !== "undefined") {
                ZenoAlert.info("Info", "No read notifications to delete");
              }
              return;
            }

            const confirmed = await ZenoAlert.confirm(
              "Confirm Delete",
              "Delete all read notifications? This cannot be undone.",
              { confirmButtonText: "Yes, Delete", cancelButtonText: "Cancel" }
            );

            if (!confirmed) return;

            deleteReadBtn.disabled = true;
            const originalText = deleteReadBtn.innerHTML;
            deleteReadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';

            try {
              const res = await fetch("/notifications/delete-read", { 
                method: "GET",
                headers: { "Content-Type": "application/json" }
              });

              if (res.ok) {
                // Remove read items from DOM
                document.querySelectorAll(".notification-item[data-read='true']").forEach((item) => {
                  item.style.opacity = "0";
                  setTimeout(() => item.remove(), 200);
                });

                if (typeof ZenoAlert !== "undefined") {
                  ZenoAlert.success("Success", "Read notifications deleted");
                }

                // Check if empty and show empty state
                const remaining = document.querySelectorAll(".notification-item");
                if (remaining.length === 0) {
                  const list = document.querySelector(".notifications-list");
                  list.innerHTML = `
                    <div class="empty-container">
                      <div class="empty-icon"><i class="fas fa-bell-slash"></i></div>
                      <div class="empty-title">No Notifications</div>
                      <div class="empty-text">You are all caught up!</div>
                    </div>
                  `;
                }

                setTimeout(() => location.reload(), 1000);
              } else {
                throw new Error("Delete failed");
              }
            } catch (err) {
              console.error(err);
              if (typeof ZenoAlert !== "undefined") {
                ZenoAlert.error("Error", "Failed to delete notifications");
              }
              deleteReadBtn.innerHTML = originalText;
              deleteReadBtn.disabled = false;
            }
          });
        }
      });
    </script>

    <script src="/js/header.js"></script>
    <%- include('partials/footer') %>
  </body>
</html>

