<link rel="stylesheet" href="/css/footer.css">
<!-- Modern Fintech Footer -->
<footer class="modern-footer">

  <!-- NEWSLETTER SECTION -->
  <section class="newsletter-section">
    <div class="newsletter-container">
      <div class="newsletter-content">
        <h2 class="newsletter-headline">Stay Ahead of the Payment Curve</h2>
        <p class="newsletter-subtext">Get industry insights, product updates, and exclusive offers delivered to your inbox</p>
        <span class="newsletter-badge">Join 10,000+ subscribers</span>
      </div>
      <div class="newsletter-form-wrapper">
        <form class="newsletter-form">
          <div class="input-group">
            <input type="email" class="newsletter-input" placeholder="Enter your email" aria-label="Email address" required>
            <button type="submit" class="newsletter-btn">
              <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- PRE-FOOTER STATS BAR -->
  <section class="stats-bar-section">
    <div class="stats-bar-container">
      <div class="stat-item">
        <div class="stat-icon-wrapper"><i class="fas fa-rocket"></i></div>
        <div class="stat-number-wrapper">
          <span class="stat-number" data-target="10000">0</span><span class="stat-suffix">+</span>
        </div>
        <span class="stat-label">Active Merchants</span>
      </div>
      <div class="stat-item">
        <div class="stat-icon-wrapper"><i class="fas fa-globe"></i></div>
        <div class="stat-number-wrapper">
          <span class="stat-number" data-target="150">0</span><span class="stat-suffix">+</span>
        </div>
        <span class="stat-label">Countries Supported</span>
      </div>
      <div class="stat-item">
        <div class="stat-icon-wrapper"><i class="fas fa-shield-alt"></i></div>
        <div class="stat-number-wrapper">
          <span class="stat-number" data-target="99.9">0</span><span class="stat-suffix">%</span>
        </div>
        <span class="stat-label">Uptime Guarantee</span>
      </div>
      <div class="stat-item">
        <div class="stat-icon-wrapper"><i class="fas fa-coins"></i></div>
        <div class="stat-number-wrapper">
          <span class="stat-currency">&#8377;</span><span class="stat-number" data-target="50">0</span><span class="stat-suffix">Cr+</span>
        </div>
        <span class="stat-label">Transactions Processed</span>
      </div>
    </div>
  </section>

  <!-- MAIN FOOTER -->
  <div class="main-footer">
    <div class="footer-inner-wrapper">

      <!-- Footer Columns Grid -->
      <div class="footer-grid">

        <!-- COLUMN 1: BRAND & SOCIAL -->
        <div class="footer-col footer-brand">
          <a href="/" class="brand-logo-link" id="brandLogoTop">
            <div class="brand-logo">
              <img src="/Images/bgFavicon.png" alt="ZenoPay Logo" class="footer-logo-img" />
              <span class="footer-logo-text">ZenoPay</span>
            </div>
          </a>
          <p class="brand-description">
            Empowering businesses with seamless payment solutions. Fast, secure, and reliable payment infrastructure for the modern internet.
          </p>
          <!-- SOCIAL ICONS -->
          <div class="social-icons-row">
            <a href="https://www.linkedin.com/company/zenopay" target="_blank" rel="noopener noreferrer" class="social-icon social-linkedin" aria-label="LinkedIn">
              <i class="fab fa-linkedin-in"></i>
            </a>
            <a href="https://twitter.com/ZenoPay" target="_blank" rel="noopener noreferrer" class="social-icon social-twitter" aria-label="Twitter">
              <i class="fab fa-twitter"></i>
            </a>
            <a href="https://github.com/lucifers-0666/ZenoPay-V1" target="_blank" rel="noopener noreferrer" class="social-icon social-github" aria-label="GitHub">
              <i class="fab fa-github"></i>
            </a>
            <a href="https://discord.gg/zenopay" target="_blank" rel="noopener noreferrer" class="social-icon social-discord" aria-label="Discord">
              <i class="fab fa-discord"></i>
            </a>
          </div>
        </div>

        <!-- COLUMN 2: PRODUCT -->
        <div class="footer-col">
          <h3 class="footer-heading">Product</h3>
          <div class="footer-links-list">
            <a href="/#features" class="footer-link">
              <i class="fas fa-star footer-link-icon"></i> Features
            </a>
            <a href="/pricing" class="footer-link">
              <i class="fas fa-tags footer-link-icon"></i> Pricing
            </a>
            <a href="/api-docs" class="footer-link">
              <i class="fas fa-code footer-link-icon"></i> API Docs
            </a>
            <a href="/api-integration" class="footer-link">
              <i class="fas fa-plug footer-link-icon"></i> Integrations
            </a>
            <a href="/open-account" class="footer-link">
              <i class="fas fa-user-plus footer-link-icon"></i> Open Account
            </a>
            <a href="/register-zenopay" class="footer-link">
              <i class="fas fa-wallet footer-link-icon"></i> Create Wallet
            </a>
          </div>
        </div>

        <!-- COLUMN 3: PAYMENTS -->
        <div class="footer-col">
          <h3 class="footer-heading">Payments</h3>
          <div class="footer-links-list">
            <a href="/send-money" class="footer-link">
              <i class="fas fa-paper-plane footer-link-icon"></i> Send Money
            </a>
            <a href="/request-money" class="footer-link">
              <i class="fas fa-hand-holding-usd footer-link-icon"></i> Request Money
            </a>
            <a href="/qr-payment" class="footer-link">
              <i class="fas fa-qrcode footer-link-icon"></i> QR Payment
            </a>
            <a href="/scheduled-payments" class="footer-link">
              <i class="fas fa-calendar-alt footer-link-icon"></i> Scheduled Payments
            </a>
            <a href="/add-money" class="footer-link">
              <i class="fas fa-plus-circle footer-link-icon"></i> Add Money
            </a>
            <a href="/withdraw" class="footer-link">
              <i class="fas fa-arrow-circle-down footer-link-icon"></i> Withdraw Funds
            </a>
          </div>
        </div>

        <!-- COLUMN 4: ACCOUNT -->
        <div class="footer-col">
          <h3 class="footer-heading">My Account</h3>
          <div class="footer-links-list">
            <a href="/dashboard" class="footer-link">
              <i class="fas fa-th-large footer-link-icon"></i> Dashboard
            </a>
            <a href="/profile" class="footer-link">
              <i class="fas fa-user-circle footer-link-icon"></i> My Profile
            </a>
            <a href="/statements" class="footer-link">
              <i class="fas fa-file-alt footer-link-icon"></i> Statements
            </a>
            <a href="/transaction-history" class="footer-link">
              <i class="fas fa-history footer-link-icon"></i> Transaction History
            </a>
            <a href="/receipts" class="footer-link">
              <i class="fas fa-receipt footer-link-icon"></i> Receipts
            </a>
            <a href="/kyc/submit" class="footer-link">
              <i class="fas fa-id-card footer-link-icon"></i> KYC Verification
            </a>
          </div>
        </div>

        <!-- COLUMN 5: SUPPORT -->
        <div class="footer-col">
          <h3 class="footer-heading">Support</h3>
          <div class="footer-links-list">
            <a href="/help" class="footer-link">
              <i class="fas fa-question-circle footer-link-icon"></i> Help Center
            </a>
            <a href="/support" class="footer-link">
              <i class="fas fa-headset footer-link-icon"></i> Support Center
            </a>
            <a href="/report-issue" class="footer-link">
              <i class="fas fa-exclamation-triangle footer-link-icon"></i> Report an Issue
            </a>
            <a href="/disputes" class="footer-link">
              <i class="fas fa-balance-scale footer-link-icon"></i> Disputes
            </a>
            <a href="/contact" class="footer-link">
              <i class="fas fa-envelope footer-link-icon"></i> Contact Us
            </a>
            <a href="/system-status" class="footer-link">
              <i class="fas fa-signal footer-link-icon"></i> System Status
            </a>
          </div>
        </div>

        <!-- COLUMN 6: COMPANY -->
        <div class="footer-col">
          <h3 class="footer-heading">Company</h3>
          <div class="footer-links-list">
            <a href="/about" class="footer-link">
              <i class="fas fa-info-circle footer-link-icon"></i> About ZenoPay
            </a>
            <a href="/referral-program" class="footer-link">
              <i class="fas fa-gift footer-link-icon"></i> Referral Program
            </a>
            <a href="/security-settings" class="footer-link">
              <i class="fas fa-shield-alt footer-link-icon"></i> Security
            </a>
            <a href="/privacy" class="footer-link">
              <i class="fas fa-user-shield footer-link-icon"></i> Privacy Policy
            </a>
            <a href="/terms" class="footer-link">
              <i class="fas fa-file-contract footer-link-icon"></i> Terms of Service
            </a>
          </div>
        </div>

      </div>

      <!-- TRUST BADGES ROW -->
      <div class="trust-badges-row">
        <div class="trust-badges-container">
          <div class="trust-card">
            <svg class="trust-icon trust-icon-security" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <div class="trust-text">
              <span class="trust-label">PCI DSS Level 1</span>
              <span class="trust-sublabel">Certified Secure</span>
            </div>
          </div>
          <div class="trust-card">
            <svg class="trust-icon trust-icon-security" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <div class="trust-text">
              <span class="trust-label">256-bit SSL</span>
              <span class="trust-sublabel">Bank-grade Encryption</span>
            </div>
          </div>
          <div class="trust-card">
            <svg class="trust-icon trust-icon-compliance" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <div class="trust-text">
              <span class="trust-label">SOC 2 Type II</span>
              <span class="trust-sublabel">Audited Annually</span>
            </div>
          </div>
          <div class="trust-card">
            <svg class="trust-icon trust-icon-uptime" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <div class="trust-text">
              <span class="trust-label">99.9% Uptime SLA</span>
              <span class="trust-sublabel">Always Available</span>
            </div>
          </div>
        </div>
      </div>

      <!-- BOTTOM BAR -->
      <div class="bottom-bar-row">
        <div class="copyright-left">
          <p class="copyright-text">
            &copy; 2026 ZenoPay &bull;
            <a href="/privacy" class="footer-legal-link">Privacy</a> &bull;
            <a href="/terms" class="footer-legal-link">Terms</a> &bull;
            <a href="/security-settings" class="footer-legal-link">Security</a> &bull;
            Made with <span class="heart-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:inline-block;vertical-align:middle;color:#EF4444;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></span> in India
          </p>
        </div>

        <!-- PAYMENT BADGES -->
        <div class="payment-methods-center">
          <span class="payment-label">We Accept:</span>
          <div class="payment-badges-row">
            <div class="payment-badge-card" title="Visa"><i class="fab fa-cc-visa"></i></div>
            <div class="payment-badge-card" title="Mastercard"><i class="fab fa-cc-mastercard"></i></div>
            <div class="payment-badge-card" title="RuPay">
              <svg class="payment-icon-svg" viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="48" height="32" rx="4" fill="white"/>
                <text x="24" y="20" font-family="Arial" font-weight="bold" font-size="10" fill="#097939" text-anchor="middle">RuPay</text>
              </svg>
            </div>
            <div class="payment-badge-card" title="UPI">
              <svg class="payment-icon-svg" viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="48" height="32" rx="4" fill="white"/>
                <text x="24" y="20" font-family="Arial" font-weight="bold" font-size="11" fill="#FF6600" text-anchor="middle">UPI</text>
              </svg>
            </div>
          </div>
        </div>

        <div class="language-selector-right">
          <div class="language-selector" role="button" tabindex="0" aria-label="Select language">
            <i class="fas fa-globe"></i>
            <span class="language-text">English (US)</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
      </div>

    </div>
  </div>

</footer>
<script nonce="<%= locals.cspNonce || '' %>">
  if (!document.querySelector('link[href*="font-awesome"]')) {
    var fa = document.createElement('link');
    fa.rel = 'stylesheet';
    fa.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css';
    fa.crossOrigin = 'anonymous';
    fa.referrerPolicy = 'no-referrer';
    document.head.appendChild(fa);
  }
</script>
<script src="/js/footer.js"></script>
