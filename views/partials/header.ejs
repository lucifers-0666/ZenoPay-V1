                <a href="/change-password" class="profile-menu-item"><i class="fas fa-key"></i><span>Change Password</span></a>
                <a href="/security-settings" class="profile-menu-item"><i class="fas fa-shield-halved"></i><span>Security Settings</span></a>
                <a href="/notification-preferences" class="profile-menu-item"><i class="fas fa-bell"></i><span>Notification Preferences</span></a>
                <a href="/verification-status" class="profile-menu-item"><i class="fas fa-badge-check"></i><span>Verification Status</span></a>
                <a href="/kyc" class="profile-menu-item"><i class="fas fa-id-card"></i><span>KYC Verification</span></a>
                <a href="/banks" class="profile-menu-item"><i class="fas fa-building-columns"></i><span>Banks & Cards</span></a>
