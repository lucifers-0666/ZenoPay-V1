      <!-- Right: Actions Section -->
      <div class="header-actions-section">

        <% if (isLoggedIn && user) { %>
          <!-- Authenticated User Actions -->
          <a href="/" class="action-link dashboard-link desktop-only">
            <i class="fas fa-th-large"></i>
            <span>Dashboard</span>
          </a>

