            <button class="action-icon-btn help-btn" aria-label="Help & Support">
              <i class="fas fa-circle-question"></i>
            </button>
            <div class="dropdown-menu help-dropdown">
              <a href="/help" class="dropdown-item"><i class="fas fa-circle-question"></i><span>Help Center</span></a>
              <a href="/contact" class="dropdown-item"><i class="fas fa-headset"></i><span>Contact Support</span></a>
              <a href="/report-issue" class="dropdown-item"><i class="fas fa-flag"></i><span>Report Issue</span></a>
              <a href="/system-status" class="dropdown-item"><i class="fas fa-signal"></i><span>System Status</span></a>
            </div>
          </div>

          <a href="/login" class="btn-header btn-login desktop-only">
            <i class="fas fa-arrow-right-to-bracket"></i>
            <span>Login</span>
          </a>

          <a href="/register" class="btn-header btn-signup">
            <i class="fas fa-user-plus"></i>
            <span>Sign Up Free</span>
          </a>
