                <a href="/payment-methods" class="profile-menu-item"><i class="fas fa-wallet"></i><span>Payment Methods</span></a>
                <a href="/Transaction-History" class="profile-menu-item"><i class="fas fa-history"></i><span>Transaction History</span></a>
                <a href="/statements" class="profile-menu-item"><i class="fas fa-file-lines"></i><span>Statements</span></a>
