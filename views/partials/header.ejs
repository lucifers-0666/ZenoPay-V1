<!-- FontAwesome Icons — loaded here to cover all pages via header partial -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6g=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>
<!-- ZenoPay Header v2 — Auth-aware, fully linked, fixed position -->
<%
  // Safely extract user and login state, handling express-ejs-layouts scoping and explicit render passes
  const _user = typeof user !== 'undefined' ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null);
  const _isLoggedIn = typeof isLoggedIn !== 'undefined' ? isLoggedIn : (typeof locals !== 'undefined' && locals.isLoggedIn ? locals.isLoggedIn : false);
  const currentUser = _user || null;
  const loggedIn = _isLoggedIn || !!currentUser;
  const currentUserName = currentUser ? (currentUser.name || currentUser.Name || currentUser.FullName || currentUser.Email || 'User') : 'User';
  const currentUserInitial = currentUserName.charAt(0).toUpperCase();
  const currentUserAvatar = currentUser
    ? (currentUser.ProfilePicture || currentUser.ImagePath || currentUser.profilePhoto || '')
    : '';
%>
<script nonce="<%= locals.cspNonce || '' %>">
  (function ensureHeaderStylesLast() {
    var head = document.head;
    if (!head) return;

    var styles = [
      '/css/responsive.css',
      '/css/header.css'
    ];

    styles.forEach(function(href) {
      var existing = head.querySelector('link[rel="stylesheet"][href="' + href + '"]');
      if (existing) {
        head.appendChild(existing);
        return;
      }
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      head.appendChild(link);
    });
  })();
</script>
