<!-- ================================================================
     HEADER JAVASCRIPT
     ================================================================ -->
<script>
(function() {
  const header = document.getElementById('zenoHeader');

  // Scroll class
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 10);
  }, { passive: true });

  // Desktop dropdowns & mega menus
  document.querySelectorAll('.header-nav .nav-item').forEach(item => {
    const btn = item.querySelector('.nav-btn');
    if (!btn) return;
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.header-nav .nav-item.open').forEach(o => {
        o.classList.remove('open');
        const b = o.querySelector('.nav-btn');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Notifications
  const notifWrapper = document.getElementById('notifWrapper');
  const notifBtn    = document.getElementById('notifBtn');
  if (notifBtn && notifWrapper) {
    notifBtn.addEventListener('click', e => {
      e.stopPropagation();
      closeAllActions([notifWrapper]);
      notifWrapper.classList.toggle('open');
    });
  }

  // Profile
  const profileWrapper = document.getElementById('profileWrapper');
  const profileBtn     = document.getElementById('profileBtn');
  if (profileBtn && profileWrapper) {
    profileBtn.addEventListener('click', e => {
      e.stopPropagation();
      closeAllActions([profileWrapper]);
      profileWrapper.classList.toggle('open');
    });
  }

  // Help wrapper (guest)
  const helpWrapper = document.getElementById('helpWrapper');
  if (helpWrapper) {
    const helpBtn = helpWrapper.querySelector('.action-btn');
    if (helpBtn) {
      helpBtn.addEventListener('click', e => {
        e.stopPropagation();
        helpWrapper.classList.toggle('open');
      });
    }
  }

  function closeAllActions(except = []) {
    [notifWrapper, profileWrapper, helpWrapper].forEach(w => {
      if (w && !except.includes(w)) w.classList.remove('open');
    });
  }

  // Close on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll('.header-nav .nav-item.open').forEach(o => {
      o.classList.remove('open');
      const b = o.querySelector('.nav-btn');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
    closeAllActions();
  });

  // Mobile toggle
  const mobileToggle  = document.getElementById('mobileToggle');
  const mobileOverlay = document.getElementById('mobileOverlay');
  const mobOpenIcon   = document.getElementById('mobOpenIcon');
  const mobCloseIcon  = document.getElementById('mobCloseIcon');

  if (mobileToggle && mobileOverlay) {
    mobileToggle.addEventListener('click', () => {
      const open = mobileOverlay.classList.toggle('open');
      document.body.style.overflow = open ? 'hidden' : '';
      mobOpenIcon.style.display  = open ? 'none'  : '';
      mobCloseIcon.style.display = open ? ''      : 'none';
    });
  }

  // Mobile expandable sections
  document.querySelectorAll('.mob-section .mob-item.expandable').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.mob-section').classList.toggle('expanded');
    });
  });

  // Mark all notifications read
  const markReadBtn = document.querySelector('.mark-read-btn');
  if (markReadBtn) {
    markReadBtn.addEventListener('click', () => {
      document.querySelectorAll('.notif-item.unread').forEach(n => n.classList.remove('unread'));
      const badge = document.querySelector('.notif-badge');
      if (badge) badge.style.display = 'none';

      const mobileBadge = document.getElementById('mobileNavBadge');
      if (mobileBadge) mobileBadge.style.display = 'none';
    });
  }

  // Auto-set active tab for mobile bottom nav based on current URL path
  const path = window.location.pathname;
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');

  mobileNavItems.forEach(item => {
    item.classList.remove('active');
    const page = item.getAttribute('data-page');

    if (page === 'dashboard' && (path === '/' || path === '/dashboard')) {
      item.classList.add('active');
    } else if (page === 'send' && path.includes('send-money')) {
      item.classList.add('active');
    } else if (page === 'history' && path.includes('transaction-history')) {
      item.classList.add('active');
    } else if (page === 'payments' && (path.includes('add-money') || path.includes('withdraw') || path.includes('payment'))) {
      item.classList.add('active');
    } else if (page === 'alerts' && path.includes('notifications')) {
      item.classList.add('active');
    }
  });

  // Mirror top notification badge count to mobile badge when available
  const topBadge = document.querySelector('.notif-badge');
  const mobileBadge = document.getElementById('mobileNavBadge');
  if (mobileBadge && topBadge) {
    const topBadgeHidden = topBadge.style.display === 'none' || topBadge.textContent.trim() === '';
    if (topBadgeHidden) {
      mobileBadge.style.display = 'none';
    } else {
      mobileBadge.textContent = topBadge.textContent.trim();
      mobileBadge.style.display = 'flex';
    }
  }
})();
</script>
