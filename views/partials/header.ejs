                  <img src="<%= user.ProfilePicture %>" alt="<%= user.Name %>" class="profile-avatar-large" />
                <% } else { %>
                  <div class="profile-avatar-large placeholder"><%= user.Name.charAt(0).toUpperCase() %></div>
                <% } %>
                <div class="profile-user-details">
                  <div class="profile-user-name"><%= user.Name %></div>
                  <div class="profile-user-email"><%= user.Email || user.ZenoPayID %></div>
