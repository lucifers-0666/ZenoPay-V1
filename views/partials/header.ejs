            <div class="mob-item-inner"><i class="fas fa-building"></i> Company</div>
            <i class="fas fa-chevron-down mob-chevron"></i>
          </button>
          <div class="mob-sub">
            <a href="/about" class="mob-sub-item">About Us</a>
            <a href="/pricing" class="mob-sub-item">Pricing</a>
            <a href="/referral-program" class="mob-sub-item">Referral Program</a>
            <a href="/contact" class="mob-sub-item">Contact Us</a>
              <a href="/shop" class="mob-sub-item">Shop</a>
              <a href="/blog" class="mob-sub-item">Blog</a>
          </div>
        </div>

      </nav>

      <div class="mob-cta">
        <a href="/login" class="mob-btn btn-login"><i class="fas fa-arrow-right-to-bracket"></i> Login</a>
        <a href="/register" class="mob-btn btn-signup"><i class="fas fa-user-plus"></i> Sign Up Free</a>
