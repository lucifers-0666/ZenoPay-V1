                <a href="/support" class="profile-menu-item"><i class="fas fa-life-ring"></i><span>Support Center</span></a>
                <a href="/contact" class="profile-menu-item"><i class="fas fa-headset"></i><span>Contact Support</span></a>
                <div class="profile-menu-separator"></div>
                <a href="/logout" class="profile-menu-item logout-item"><i class="fas fa-sign-out-alt"></i><span>Log Out</span></a>
              </div>
            </div>
          </div>

        <% } else { %>
