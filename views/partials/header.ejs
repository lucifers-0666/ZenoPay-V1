            <a href="/contact" class="mob-sub-item">Contact Support</a>
            <a href="/support" class="mob-sub-item">Support Center</a>
            <a href="/report-issue" class="mob-sub-item">Report an Issue</a>
            <a href="/disputes" class="mob-sub-item">Disputes</a>
            <a href="/system-status" class="mob-sub-item">System Status</a>
            <a href="/privacy" class="mob-sub-item">Privacy Policy</a>
            <a href="/terms" class="mob-sub-item">Terms of Service</a>
          </div>
        </div>

        <div class="mob-section">
          <button class="mob-item expandable">
            <div class="mob-item-inner"><i class="fas fa-building"></i> Company</div>
            <i class="fas fa-chevron-down mob-chevron"></i>
          </button>
          <div class="mob-sub">
            <a href="/about" class="mob-sub-item">About Us</a>
            <a href="/referral-program" class="mob-sub-item">Referral Program</a>
            <a href="/contact" class="mob-sub-item">Contact Us</a>
            <a href="/blog" class="mob-sub-item">Blog</a>
          </div>
        </div>

      </nav>

      <div class="mob-cta">
        <a href="/login" class="mob-btn btn-login"><i class="fas fa-arrow-right-to-bracket"></i> Login</a>
        <a href="/register" class="mob-btn btn-signup"><i class="fas fa-user-plus"></i> Sign Up Free</a>
      </div>

    <% } %>

  </div>
</div>

<!-- ================================================================
     HEADER JAVASCRIPT
     ================================================================ -->
<script>
(function() {
  const header = document.getElementById('zenoHeader');

  // ── SCROLL PROGRESS BAR ──────────────────────────────────────────
  const progressBar = document.getElementById('scrollProgressBar');

  function updateScrollProgress() {
    if (!progressBar) return;
    const scrollTop = window.scrollY || window.pageYOffset;
    const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
    progressBar.style.width = pct + '%';
  }

  // ── SCROLL HEADER CLASS ──────────────────────────────────────────
  function onHeaderScroll() {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 10);
    updateScrollProgress();
  }

  // rAF-throttled scroll listener for smooth, jank-free updates
  let rafPending = false;
  window.addEventListener('scroll', function() {
    if (!rafPending) {
      rafPending = true;
      window.requestAnimationFrame(function() {
        onHeaderScroll();
        rafPending = false;
      });
    }
  }, { passive: true });

  // Run once on load to set initial state
  updateScrollProgress();

  // ── NAV DROPDOWNS ────────────────────────────────────────────────
  document.querySelectorAll('.header-nav .nav-item').forEach(item => {
    const btn = item.querySelector('.nav-btn');
    if (!btn) return;
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.header-nav .nav-item.open').forEach(o => {
        o.classList.remove('open');
        const b = o.querySelector('.nav-btn');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  const notifWrapper  = document.getElementById('notifWrapper');
  const notifBtn     = document.getElementById('notifBtn');
  const notifList    = document.getElementById('notifList');
  const notifBadge   = document.getElementById('notifBadge');
  const markReadBtn  = document.getElementById('markReadBtn');
  const mobileBadge  = document.getElementById('mobileNavBadge');
  const NOTIF_POLL_INTERVAL_MS = 25000;
  let isNotifLoading = false;
  let notifPollTimer = null;

  const escapeHtml = (value) => String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  const formatRelativeTime = (isoDate) => {
    const date = new Date(isoDate);
    if (Number.isNaN(date.getTime())) return 'Just now';

    const diffSec = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
    if (diffSec < 60) return 'Just now';

    const mins = Math.floor(diffSec / 60);
    if (mins < 60) return `${mins} minute${mins === 1 ? '' : 's'} ago`;

    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;

    const days = Math.floor(hours / 24);
    if (days < 7) return `${days} day${days === 1 ? '' : 's'} ago`;

    return date.toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  };

  const getNotifUi = (type) => {
    const normalized = String(type || '').toLowerCase();
    if (normalized === 'credit' || normalized === 'success' || normalized === 'reward') {
      return { css: 'success', icon: 'fa-circle-check' };
    }
    if (normalized === 'debit' || normalized === 'warning' || normalized === 'security') {
      return { css: 'warning', icon: 'fa-triangle-exclamation' };
    }
    return { css: 'info', icon: 'fa-circle-info' };
  };

  const syncNotificationBadges = (count) => {
    const safeCount = Math.max(0, Number(count || 0));
    if (notifBadge) {
      if (safeCount > 0) {
        notifBadge.textContent = safeCount > 99 ? '99+' : String(safeCount);
        notifBadge.style.display = 'flex';
      } else {
        notifBadge.textContent = '0';
        notifBadge.style.display = 'none';
      }
    }

    if (mobileBadge) {
      if (safeCount > 0) {
        mobileBadge.textContent = safeCount > 99 ? '99+' : String(safeCount);
        mobileBadge.style.display = 'flex';
      } else {
        mobileBadge.textContent = '0';
        mobileBadge.style.display = 'none';
      }
    }
  };

  const renderNotifications = (notifications) => {
    if (!notifList) return;

    if (!Array.isArray(notifications) || notifications.length === 0) {
      notifList.innerHTML = `
        <a href="/notifications" class="notif-item">
          <div class="notif-icon info"><i class="fas fa-bell"></i></div>
          <div class="notif-body">
            <div class="notif-title">No notifications yet</div>
            <div class="notif-text">You'll see transaction alerts here in real time.</div>
            <div class="notif-time">Now</div>
          </div>
        </a>
      `;
      return;
    }

    notifList.innerHTML = notifications.map((notification) => {
      const ui = getNotifUi(notification.Type);
      const unreadClass = notification.IsRead ? '' : ' unread';

      return `
        <a href="/notifications" class="notif-item${unreadClass}">
          <div class="notif-icon ${ui.css}"><i class="fas ${ui.icon}"></i></div>
          <div class="notif-body">
            <div class="notif-title">${escapeHtml(notification.Title || 'Notification')}</div>
            <div class="notif-text">${escapeHtml(notification.Message || '')}</div>
            <div class="notif-time">${escapeHtml(formatRelativeTime(notification.createdAt || notification.updatedAt))}</div>
          </div>
        </a>
      `;
    }).join('');
  };

  const loadNotifications = async (force = false) => {
    if (isNotifLoading && !force) return;

    try {
      isNotifLoading = true;

      const [countRes, recentRes] = await Promise.all([
        fetch('/api/notifications/count', { credentials: 'same-origin' }),
        fetch('/api/notifications/recent', { credentials: 'same-origin' }),
      ]);

      const countJson = await countRes.json().catch(() => ({}));
      const recentJson = await recentRes.json().catch(() => ({}));

      syncNotificationBadges(countJson?.success ? countJson.count : 0);
      renderNotifications(recentJson?.success ? recentJson.notifications : []);
    } catch (error) {
      console.error('Failed to load notifications:', error);
      syncNotificationBadges(0);
      renderNotifications([]);
    } finally {
      isNotifLoading = false;
    }
  };

  const startNotificationPolling = () => {
    if (notifPollTimer) return;

    notifPollTimer = window.setInterval(() => {
      if (document.hidden) return;
      loadNotifications();
    }, NOTIF_POLL_INTERVAL_MS);
  };

  const stopNotificationPolling = () => {
    if (!notifPollTimer) return;
    window.clearInterval(notifPollTimer);
    notifPollTimer = null;
  };

  if (notifBtn && notifWrapper) {
    notifBtn.addEventListener('click', e => {
      e.stopPropagation();
      closeAllActions([notifWrapper]);
      notifWrapper.classList.toggle('open');

      if (notifWrapper.classList.contains('open')) {
        loadNotifications(true);
      }
    });
  }

  const profileWrapper = document.getElementById('profileWrapper');
  const profileBtn     = document.getElementById('profileBtn');
  if (profileBtn && profileWrapper) {
    profileBtn.addEventListener('click', e => {
      e.stopPropagation();
      closeAllActions([profileWrapper]);
      profileWrapper.classList.toggle('open');
    });
  }

  const helpWrapper = document.getElementById('helpWrapper');
  if (helpWrapper) {
    const helpBtn = helpWrapper.querySelector('.action-btn');
    if (helpBtn) {
      helpBtn.addEventListener('click', e => {
        e.stopPropagation();
        helpWrapper.classList.toggle('open');
      });
    }
  }

  function closeAllActions(except = []) {
    [notifWrapper, profileWrapper, helpWrapper].forEach(w => {
      if (w && !except.includes(w)) w.classList.remove('open');
    });
  }

  document.addEventListener('click', () => {
    document.querySelectorAll('.header-nav .nav-item.open').forEach(o => {
      o.classList.remove('open');
      const b = o.querySelector('.nav-btn');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
    closeAllActions();
  });

  const mobileToggle  = document.getElementById('mobileToggle');
  const mobileOverlay = document.getElementById('mobileOverlay');
  const mobOpenIcon   = document.getElementById('mobOpenIcon');
  const mobCloseIcon  = document.getElementById('mobCloseIcon');

  if (mobileToggle && mobileOverlay) {
    mobileToggle.addEventListener('click', () => {
      const open = mobileOverlay.classList.toggle('open');
      document.body.style.overflow = open ? 'hidden' : '';
      mobOpenIcon.style.display  = open ? 'none' : '';
      mobCloseIcon.style.display = open ? ''     : 'none';
    });
  }

  document.querySelectorAll('.mob-section .mob-item.expandable').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.mob-section').classList.toggle('expanded');
    });
  });

  if (markReadBtn) {
    markReadBtn.addEventListener('click', async (event) => {
      event.preventDefault();
      try {
        const response = await fetch('/api/notifications/mark-all-read', {
          method: 'POST',
          credentials: 'same-origin',
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Failed to mark notifications as read');
        }

        document.querySelectorAll('.notif-item.unread').forEach((node) => node.classList.remove('unread'));
        syncNotificationBadges(0);
        loadNotifications(true);
      } catch (error) {
        console.error('Failed to mark notifications as read:', error);
      }
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      loadNotifications();
      startNotificationPolling();
    } else {
      stopNotificationPolling();
    }
  });

  window.addEventListener('beforeunload', () => {
    stopNotificationPolling();
  });

  const path = window.location.pathname;
  document.querySelectorAll('.mobile-nav-item').forEach(item => {
    item.classList.remove('active');
    const page = item.getAttribute('data-page');
    if (page === 'dashboard' && (path === '/' || path === '/dashboard')) item.classList.add('active');
    else if (page === 'send' && (path.includes('/wallet/send') || path.includes('send-money'))) item.classList.add('active');
    else if (page === 'history' && (path.includes('/wallet/transactions') || path.includes('transaction-history'))) item.classList.add('active');
    else if (page === 'payments' && (path.includes('/wallet/topup') || path.includes('add-money') || path.includes('withdraw') || path.includes('payment'))) item.classList.add('active');
    else if (page === 'alerts' && path.includes('notifications')) item.classList.add('active');
  });

  if (notifList) {
    notifList.innerHTML = `
      <a href="/notifications" class="notif-item">
        <div class="notif-icon info"><i class="fas fa-spinner fa-spin"></i></div>
        <div class="notif-body">
          <div class="notif-title">Loading notifications</div>
          <div class="notif-text">Please wait a moment...</div>
          <div class="notif-time">Now</div>
        </div>
      </a>
    `;
  }

  loadNotifications();
  startNotificationPolling();

  onHeaderScroll();
})();
</script>
