<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Pay with ZenoPay' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <style>
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #111827;
      --muted: #6b7280;
      --primary: #2563eb;
      --success: #059669;
      --error: #dc2626;
      --border: #e5e7eb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #eef2ff 0%, var(--bg) 100%);
      color: var(--text);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
    }
    .card {
      width: 100%;
      max-width: 540px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
      padding: 24px;
    }
    .title {
      margin: 0 0 8px;
      font-size: 24px;
      font-weight: 800;
    }
    .subtitle {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: 14px;
    }
    .recipient {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      background: #f9fafb;
      margin-bottom: 18px;
    }
    .recipient h2 {
      margin: 0 0 6px;
      font-size: 16px;
    }
    .recipient p {
      margin: 2px 0;
      color: var(--muted);
      font-size: 13px;
    }
    .field { margin-bottom: 14px; }
    .label {
      display: block;
      margin-bottom: 6px;
      font-size: 13px;
      font-weight: 600;
    }
    .input {
      width: 100%;
      height: 40px;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0 12px;
      font-size: 14px;
      outline: none;
    }
    .input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }
    .btn {
      width: 100%;
      border: none;
      border-radius: 10px;
      height: 40px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      color: #fff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      transition: transform .15s ease;
    }
    .btn:hover { transform: translateY(-1px); }
    .muted-box {
      margin: 12px 0 14px;
      border: 1px dashed var(--border);
      border-radius: 10px;
      padding: 12px;
      font-size: 13px;
      color: var(--muted);
      background: #fcfcfd;
    }
    .login-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 8px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .message {
      margin-top: 12px;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 13px;
      display: none;
    }
    .message.success { display: block; color: var(--success); background: #ecfdf5; border: 1px solid #a7f3d0; }
    .message.error { display: block; color: var(--error); background: #fef2f2; border: 1px solid #fecaca; }
  </style>
</head>
<body>
  <main class="card">
    <h1 class="title">Pay with ZenoPay</h1>
    <p class="subtitle">Secure instant payment to recipient wallet</p>

    <section class="recipient">
      <h2><i class="fa-solid fa-user"></i> <%= recipient.fullName %></h2>
      <p>ZenoPay ID: <strong><%= recipient.zenoPayId %></strong></p>
      <% if (previewMode && previewMessage) { %>
        <p style="color:#1d4ed8;"><strong><%= previewMessage %></strong></p>
      <% } %>
      <% if (description) { %>
        <p>Note: <%= description %></p>
      <% } %>
      <% if (expiry) { %>
        <p>Expires: <%= new Date(expiry).toLocaleString('en-IN') %></p>
      <% } %>
    </section>

    <form id="payForm">
      <div class="field">
        <label class="label" for="amount">Amount (INR)</label>
        <input class="input" id="amount" name="amount" type="number" min="0.01" step="0.01" value="<%= amount || '' %>" required />
      </div>

      <input type="hidden" name="description" value="<%= description || '' %>" />
      <input type="hidden" name="expiry" value="<%= expiry || '' %>" />

      <% if (!isLoggedIn) { %>
        <div class="muted-box">
          You are not logged in. You can either <strong>login first</strong> or pay by entering your ZenoPay ID + PIN.
          <br />
          <a class="login-cta" href="/login?returnTo=<%= encodeURIComponent(`/pay/${recipient.zenoPayId}?${new URLSearchParams({ ...(amount ? { amount: String(amount) } : {}), ...(description ? { description: String(description) } : {}), ...(expiry ? { expiry: String(expiry) } : {}) }).toString()}`) %>">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Login to Pay
          </a>
        </div>

        <div class="field">
          <label class="label" for="payerZenoPayId">Your ZenoPay ID</label>
          <input class="input" id="payerZenoPayId" name="payerZenoPayId" type="text" placeholder="Enter your ZenoPay ID" />
        </div>

        <div class="field">
          <label class="label" for="pin">Transaction PIN</label>
          <input class="input" id="pin" name="pin" type="password" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit PIN" />
        </div>
      <% } %>

      <button class="btn" type="submit"><i class="fa-solid fa-bolt"></i> Pay Now</button>
    </form>

    <div id="message" class="message"></div>
  </main>

  <script>
    (function () {
      const form = document.getElementById('payForm');
      const message = document.getElementById('message');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        message.className = 'message';
        message.style.display = 'none';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const response = await fetch(window.location.pathname, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            message.className = 'message error';
            message.textContent = result.message || 'Payment failed';
            return;
          }

          message.className = 'message success';
          message.textContent = result.message || 'Payment successful';

          setTimeout(() => {
            const amount = encodeURIComponent(result?.data?.amount || payload.amount || 0);
            const to = encodeURIComponent('<%= recipient.fullName %>');
            const tx = encodeURIComponent(result?.data?.reference || 'QR-PAYMENT');
            window.location.href = `/payment/success?txId=${tx}&amount=${amount}&to=${to}&method=QR%20Payment&type=QR%20Transfer`;
          }, 900);
        } catch (error) {
          message.className = 'message error';
          message.textContent = 'Unable to process payment right now.';
        }
      });
    })();
  </script>
</body>
</html>
