<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Payment Processing - ZenoPay' %></title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --text: #1F2937;
      --muted: #6B7280;
      --muted-2: #94A3B8;
      --border: #E2E8F0;
      --line: #F1F5F9;
      --blue: #3B82F6;
      --blue-dark: #2563EB;
      --green: #10B981;
      --amber: #F59E0B;
      --amber-dark: #D97706;
      --red: #DC2626;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      font-family: 'Inter', sans-serif;
      color: var(--text);
      display: block;
    }

    .page-shell {
      min-height: calc(100vh - 68px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    .page {
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
      padding: 40px 24px;
    }

    .card {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
      overflow: hidden;
      animation: fadeInUp 0.4s ease-out;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero {
      position: relative;
      overflow: hidden;
      text-align: center;
      background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
      padding: 48px 40px 36px;
    }

    .hero::before,
    .hero::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
    }

    .hero::before {
      width: 200px;
      height: 200px;
      background: rgba(255,255,255,0.07);
      top: -80px;
      left: -70px;
    }

    .hero::after {
      width: 160px;
      height: 160px;
      background: rgba(255,255,255,0.04);
      right: -50px;
      bottom: -60px;
    }

    .icon-ring {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 3px solid rgba(255,255,255,0.3);
      margin: 0 auto 20px;
      display: grid;
      place-items: center;
    }

    .pending-icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #fff;
      display: grid;
      place-items: center;
      animation: tickPulse 1.5s ease-in-out infinite;
    }

    .pending-icon i {
      font-size: 28px;
      color: #F59E0B;
    }

    @keyframes tickPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    .hero-title {
      margin: 0;
      font-size: 26px;
      line-height: 1.15;
      letter-spacing: -0.02em;
      font-weight: 800;
      color: #fff;
    }

    .hero-sub {
      margin: 8px 0 0;
      font-size: 15px;
      color: rgba(255,255,255,0.85);
      line-height: 1.5;
    }

    .eta-pill {
      margin-top: 16px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0,0,0,0.15);
      border-radius: 20px;
      padding: 8px 20px;
      color: #fff;
      font-size: 13px;
    }

    .tracker {
      padding: 28px 32px;
      border-bottom: 1px solid #F1F5F9;
    }

    .section-title {
      margin: 0 0 20px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #94A3B8;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 700;
    }

    .section-title i { font-size: 12px; }

    .timeline {
      position: relative;
      margin: 0;
      padding: 0;
      list-style: none;
      border-left: 2px solid #E2E8F0;
      margin-left: 10px;
      padding-left: 34px;
    }

    .step {
      position: relative;
      padding-bottom: 16px;
    }

    .step:last-child { padding-bottom: 0; }

    .step-dot {
      position: absolute;
      left: -43px;
      top: 2px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2px solid #CBD5E1;
      background: #fff;
      display: grid;
      place-items: center;
      font-size: 10px;
      color: transparent;
    }

    .step-complete .step-dot {
      border-color: #10B981;
      background: #10B981;
      color: #fff;
    }

    .step-active .step-dot {
      border-color: #3B82F6;
      background: #3B82F6;
      color: #fff;
      animation: livePulse 1.2s ease-in-out infinite;
    }

    @keyframes livePulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(59,130,246,0.4); }
      50% { box-shadow: 0 0 0 8px rgba(59,130,246,0); }
    }

    .step-title {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
    }

    .step-pending .step-title { color: #94A3B8; }

    .step-time {
      margin: 4px 0 0;
      font-size: 12px;
      color: #94A3B8;
    }

    .summary {
      padding: 24px 32px 20px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid #F8FAFC;
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: #6B7280;
    }

    .detail-label i {
      width: 14px;
      text-align: center;
      color: #94A3B8;
      font-size: 14px;
    }

    .detail-value {
      text-align: right;
      font-size: 14px;
      font-weight: 600;
      color: #1F2937;
      word-break: break-word;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
      letter-spacing: .01em;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(245,158,11,0.1);
      color: #D97706;
      border: 1px solid #F59E0B;
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .info-card {
      margin: 0 32px 20px;
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-radius: 12px;
      padding: 16px 20px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: #78350F;
      font-size: 13px;
      line-height: 1.6;
    }

    .info-card i {
      font-size: 18px;
      color: #F59E0B;
      margin-top: 2px;
      flex-shrink: 0;
    }

    .actions {
      padding: 0 32px 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .btn,
    .grid-btn {
      width: 100%;
      border-radius: 12px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: inherit;
      cursor: pointer;
      transition: all .3s ease;
    }

    .btn:focus-visible,
    .grid-btn:focus-visible {
      outline: 2px solid #3B82F6;
      outline-offset: 2px;
    }

    .btn-refresh {
      border: 0;
      height: 50px;
      background: linear-gradient(135deg, #F59E0B, #D97706);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(245,158,11,0.30);
    }

    .btn-refresh:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(245,158,11,0.40);
    }

    .btn-cancel {
      height: 46px;
      border: 1.5px solid #FECACA;
      background: #fff;
      color: #DC2626;
      font-size: 14px;
      font-weight: 600;
    }

    .btn-cancel:hover {
      background: #FEF2F2;
      border-color: #EF4444;
    }

    .cancel-note {
      margin: -4px 0 2px;
      text-align: center;
      font-size: 11px;
      color: #94A3B8;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .grid-btn {
      height: 42px;
      border: 1.5px solid #E2E8F0;
      background: #fff;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
      border-radius: 10px;
    }

    .grid-btn.receipt:hover {
      border-color: #3B82F6;
      color: #3B82F6;
      background: #EFF6FF;
    }

    .grid-btn.dashboard:hover {
      border-color: #94A3B8;
      color: #334155;
      background: #F8FAFC;
    }

    .security {
      background: linear-gradient(135deg, rgba(245,158,11,0.05), rgba(217,119,6,0.02));
      border-top: 1px solid #F1F5F9;
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #94A3B8;
      font-size: 12px;
      text-align: center;
    }

    .security i {
      color: #F59E0B;
      font-size: 14px;
      flex-shrink: 0;
    }

    .spin { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 639px) {
      body {
        align-items: flex-end;
        padding: 0;
      }

      .page {
        padding: 0;
        max-width: none;
      }

      .card {
        border-radius: 20px 20px 0 0;
      }

      .hero {
        padding: 36px 24px 28px;
      }

      .tracker,
      .summary,
      .actions,
      .security {
        padding-inline: 24px;
      }

      .info-card {
        margin: 0 24px 20px;
      }

      .detail-row {
        padding: 8px 0;
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <div class="page-shell">
  <% const transaction = tx || {}; %>

  <main class="page">
    <article class="card">
      <header class="hero">
        <div class="icon-ring">
          <div class="pending-icon"><i class="fas fa-clock"></i></div>
        </div>

        <h1 class="hero-title">Payment Processing</h1>
        <p class="hero-sub">Your payment is being verified by your bank</p>
        <div class="eta-pill"><i class="fas fa-hourglass-half"></i> Estimated: <%= transaction.eta || '5–30 minutes' %></div>
      </header>

      <section class="tracker">
        <h2 class="section-title"><i class="fas fa-signal"></i> Payment Status</h2>

        <ol class="timeline">
          <li class="step step-complete">
            <span class="step-dot"><i class="fas fa-check"></i></span>
            <p class="step-title">Payment Initiated</p>
            <p class="step-time"><%= transaction.step1Time || '11:09 AM' %></p>
          </li>

          <li class="step step-complete">
            <span class="step-dot"><i class="fas fa-check"></i></span>
            <p class="step-title">Bank Received</p>
            <p class="step-time"><%= transaction.step2Time || '11:10 AM' %></p>
          </li>

          <li class="step step-active">
            <span class="step-dot"><i class="fas fa-clock"></i></span>
            <p class="step-title">Processing</p>
            <p class="step-time"><%= transaction.step3Time || 'In progress now' %></p>
          </li>

          <li class="step step-pending">
            <span class="step-dot"></span>
            <p class="step-title">Confirmation</p>
            <p class="step-time">Awaiting final bank response</p>
          </li>
        </ol>
      </section>

      <section class="summary">
        <h2 class="section-title"><i class="fas fa-receipt"></i> Transaction Details</h2>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-hashtag"></i> Transaction ID</span>
          <span class="detail-value mono"><%= transaction.id || 'ZP-2024-8X7K-9M2P' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-user"></i> Sending To</span>
          <span class="detail-value"><%= transaction.sendingTo || 'Priya Mehta' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-credit-card"></i> Method</span>
          <span class="detail-value"><%= transaction.method || 'NEFT Transfer' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-calendar-alt"></i> Submitted At</span>
          <span class="detail-value"><%= transaction.submittedAt || 'Feb 24, 2026 - 11:10 AM' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-rupee-sign"></i> Amount</span>
          <span class="detail-value"><%= transaction.amountFormatted || '₹5,000.00' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-clock"></i> Status</span>
          <span class="detail-value"><span class="status-badge"><i class="fas fa-clock"></i> Pending</span></span>
        </div>
      </section>

      <section class="info-card">
        <i class="fas fa-info-circle"></i>
        <span>You will receive a notification and email once the payment is confirmed. Do not retry to avoid double deduction.</span>
      </section>

      <section class="actions">
        <button type="button" class="btn btn-refresh" id="refreshBtn"><i class="fas fa-sync-alt" id="refreshIcon"></i> Refresh Status</button>
        <a href="/dashboard" class="btn btn-cancel"><i class="fas fa-ban"></i> Cancel Payment</a>
        <p class="cancel-note">Cancellation only available within 5 minutes</p>

        <div class="grid">
          <a href="/receipts" class="grid-btn receipt"><i class="fas fa-download"></i> Download Pending Receipt</a>
          <a href="/dashboard" class="grid-btn dashboard"><i class="fas fa-home"></i> Go to Dashboard</a>
        </div>
      </section>

      <footer class="security">
        <i class="fas fa-shield-alt"></i>
        <span>Your money is safe — funds are held securely during processing</span>
      </footer>
    </article>
  </main>
  </div>

  <script>
    (function () {
      const refreshBtn = document.getElementById('refreshBtn');
      const refreshIcon = document.getElementById('refreshIcon');
      const originalHtml = refreshBtn.innerHTML;

      refreshBtn.addEventListener('click', () => {
        refreshBtn.disabled = true;
        refreshIcon.classList.add('spin');
        refreshBtn.innerHTML = '<i class="fas fa-sync-alt spin"></i> Checking bank status...';

        window.setTimeout(() => {
          refreshBtn.disabled = false;
          refreshBtn.innerHTML = originalHtml;
        }, 1400);
      });
    })();
  </script>
</body>
</html>
