<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/header.css" />
  <style>
    :root {
      --primary:#01696f; --primary-hover:#0c4e54; --success:#437a22; --error:#a12c7b;
      --text:#28251d; --muted:#7a7974; --bg:#f7f6f2; --surface:#fff; --border:1px solid rgba(40,37,29,0.12);
      --shadow:0 4px 12px rgba(40,37,29,0.08); --transition:all 180ms cubic-bezier(0.16,1,0.3,1);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; color: var(--text); background: var(--bg); }
    .page { max-width: 680px; margin: 0 auto; padding: 24px 16px 56px; }
    .card { border: var(--border); box-shadow: var(--shadow); border-radius: 12px; background: var(--surface); padding: 24px; }
    h1 { margin: 0 0 10px; font-family: 'DM Serif Display', serif; }
    .muted { color: var(--muted); }
    .group { margin-top: 14px; }
    .label { display: block; font-weight: 600; margin-bottom: 8px; }
    .pin-grid { display: flex; gap: 8px; }
    .pin-box {
      width: 46px; height: 52px; border-radius: 8px; border: 1px solid rgba(40,37,29,0.2);
      text-align: center; font-size: 1.2rem; font-weight: 600; outline: none; transition: var(--transition);
    }
    .pin-box:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(1,105,111,0.14); }
    .error { color: var(--error); margin-top: 8px; font-size: .9rem; }
    .btn { margin-top: 16px; background: var(--primary); color: #fff; border: none; border-radius: 8px; padding: 12px 20px; font-weight: 600; cursor: pointer; transition: var(--transition); }
    .btn:hover { background: var(--primary-hover); transform: translateY(-1px); }
    .toast { position: fixed; top: 18px; right: 18px; color: #fff; padding: 12px 16px; border-radius: 10px; box-shadow: var(--shadow); opacity: 0; transform: translateY(-12px); transition: var(--transition); }
    .toast.success { background: var(--success); } .toast.error { background: var(--error); }
    .toast.show { opacity: 1; transform: translateY(0); }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="page">
    <section class="card">
      <h1><%= hasPin ? 'Change Transaction PIN' : 'Set Transaction PIN' %></h1>
      <p class="muted">Never share your PIN with anyone.</p>

      <form id="pinForm" action="/pin/set" method="post" novalidate>
        <div class="group">
          <label class="label">New PIN</label>
          <div class="pin-grid" data-group="pin">
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
          </div>
          <input type="hidden" name="pin" id="pinHidden" />
          <p class="error"><%= errors?.pin || '' %></p>
        </div>

        <div class="group">
          <label class="label">Confirm PIN</label>
          <div class="pin-grid" data-group="confirm">
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
            <input class="pin-box" inputmode="numeric" maxlength="1" />
          </div>
          <input type="hidden" name="confirmPin" id="confirmPinHidden" />
          <p class="error" id="confirmErr"><%= errors?.confirmPin || '' %></p>
        </div>

        <button class="btn" type="submit">Set Transaction PIN</button>
      </form>
    </section>
  </main>

  <% if (flash && flash.message) { %>
    <div class="toast <%= flash.type === 'error' ? 'error' : 'success' %>" id="toast"><%= flash.message %></div>
  <% } %>

  <script>
    function bindPinGrid(groupNode) {
      const boxes = Array.from(groupNode.querySelectorAll('.pin-box'));
      boxes.forEach((box, idx) => {
        box.addEventListener('input', () => {
          box.value = box.value.replace(/\D/g, '').slice(0, 1);
          if (box.value && idx < boxes.length - 1) boxes[idx + 1].focus();
        });
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !box.value && idx > 0) boxes[idx - 1].focus();
        });
      });
      return () => boxes.map((b) => b.value).join('');
    }

    const pinGetter = bindPinGrid(document.querySelector(".pin-grid[data-group='pin']"));
    const confirmGetter = bindPinGrid(document.querySelector(".pin-grid[data-group='confirm']"));

    document.getElementById('pinForm').addEventListener('submit', (e) => {
      const pin = pinGetter();
      const confirmPin = confirmGetter();
      document.getElementById('pinHidden').value = pin;
      document.getElementById('confirmPinHidden').value = confirmPin;

      if (!/^\d{6}$/.test(pin) || !/^\d{6}$/.test(confirmPin)) {
        e.preventDefault();
        document.getElementById('confirmErr').textContent = 'Both PIN fields must be 6 digits.';
        return;
      }
      if (pin !== confirmPin) {
        e.preventDefault();
        document.getElementById('confirmErr').textContent = 'PIN and confirmation do not match.';
      }
    });

    (function initToast() {
      const toast = document.getElementById('toast');
      if (!toast) return;
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => toast.classList.remove('show'), 4000);
    })();
  </script>
</body>
</html>
