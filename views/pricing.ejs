<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= pageTitle || 'Pricing - ZenoPay' %>
  </title>
  <meta name="description"
    content="Transparent pricing for ZenoPay payment gateway. Choose from Starter, Professional, Business, or Enterprise plans. No hidden fees.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/pricing.css">
  <link rel="stylesheet" href="/css/premium-animations.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
  <%- include('partials/header') %>

  <% 
    const plans = (pricingData && Array.isArray(pricingData.plans)) ? pricingData.plans : [];
    const settings = (pricingData && pricingData.settings) ? pricingData.settings : {};
    const annualDiscount = Number(settings.annualDiscount || 0);
    const formatINR = (value) => {
      const amount = Number(value || 0);
      return `₹${amount.toLocaleString('en-IN', { maximumFractionDigits: 0 })}`;
    };
  %>

  <!-- SECTION 1: Hero Section -->
  <div class="pricing-hero">
    <div class="pricing-hero-content">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-separator"><i class="fas fa-chevron-right"></i></span>
        <span class="breadcrumb-current">Pricing</span>
      </nav>

      <h1 class="hero-title">Simple, Transparent Pricing</h1>
      <p class="hero-subtitle">Choose the perfect plan for your business. No hidden fees, no surprises.</p>

      <div class="trust-badge">
        <i class="fas fa-shield-check"></i>
        <span>Trusted by 50,000+ businesses across India</span>
      </div>

      <!-- Billing Toggle -->
      <div class="billing-toggle">
        <span class="toggle-label active" id="monthlyLabel">Monthly</span>
        <div class="toggle-switch">
          <input type="checkbox" id="billingToggle" class="toggle-input">
          <label for="billingToggle" class="toggle-slider"></label>
        </div>
        <span class="toggle-label" id="yearlyLabel">
          Yearly
          <span class="savings-badge">Save up to <%= annualDiscount %>%</span>
        </span>
      </div>
    </div>
  </div>

  <!-- SECTION 2: Pricing Cards Grid -->
  <section class="pricing-section">
    <div class="pricing-container">
      <div class="pricing-grid">
        <% if (!plans.length) { %>
          <div class="pricing-card" style="grid-column:1 / -1; text-align:center;">
            <h3 class="plan-name">No active pricing plans</h3>
            <p class="plan-description">Our team is updating plans. Please check back shortly.</p>
            <button class="cta-button secondary-btn" onclick="window.location.href='/contact'">Contact Sales</button>
          </div>
        <% } %>

        <% plans.forEach((plan) => { 
          const monthly = Number(plan.monthlyPrice || 0);
          const yearly = Number(plan.annualPrice || 0);
          const yearlyMonthly = Number(plan.yearlyMonthlyEquivalent || (yearly > 0 ? yearly / 12 : 0));
          const yearlySavings = Math.max(0, Math.round((monthly * 12) - yearly));
          const isCustom = !!plan.isCustomPricing;
          const cardClasses = [
            'pricing-card',
            plan.highlightPopular ? 'popular' : '',
            plan.bestValue ? 'recommended' : '',
            String(plan.slug || '').toLowerCase() === 'enterprise' ? 'enterprise' : '',
          ].filter(Boolean).join(' ');
        %>
          <div class="<%= cardClasses %>">
            <% if (plan.highlightPopular) { %><div class="popular-badge">MOST POPULAR</div><% } %>
            <% if (plan.bestValue) { %><div class="recommended-badge">BEST VALUE</div><% } %>

            <div class="card-header">
              <div class="plan-icon">
                <i class="fas fa-layer-group"></i>
              </div>
              <h3 class="plan-name"><%= plan.name %></h3>
              <p class="plan-description"><%= plan.tagline || plan.description || 'Flexible for your business needs' %></p>
            </div>

            <div class="pricing-display">
              <% if (isCustom) { %>
                <div class="price-wrapper custom-pricing">
                  <span class="custom-text">Custom</span>
                </div>
              <% } else { %>
                <div class="price-wrapper">
                  <span class="currency">₹</span>
                  <span class="price monthly-price"><%= Math.round(monthly).toLocaleString('en-IN') %></span>
                  <span class="price yearly-price" style="display: none;"><%= Math.round(yearlyMonthly).toLocaleString('en-IN') %></span>
                  <span class="period">/month</span>
                </div>
                <div class="yearly-info" style="display: none;">
                  <p class="yearly-total"><%= formatINR(yearly) %>/year</p>
                  <p class="yearly-savings">Save <%= formatINR(yearlySavings) %></p>
                </div>
              <% } %>
            </div>

            <div class="transaction-fees">
              <i class="fas fa-percentage"></i>
              <span><%= plan.transactionFeeText || 'Custom fee structure' %></span>
            </div>

            <div class="volume-limit">
              <i class="fas fa-chart-line"></i>
              <span><%= plan.volumeLimitText || 'Flexible volume limit' %></span>
            </div>

            <button class="cta-button <%= isCustom ? 'secondary-btn' : 'primary-btn' %>"><%= isCustom ? 'Contact Sales' : 'Get Started' %></button>

            <div class="features-list">
              <% (plan.features || []).forEach((feature) => { %>
                <div class="feature-item included">
                  <i class="fas fa-check-circle"></i>
                  <span><%= feature %></span>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

              <!-- SECTION 3: GST Benefits Banner -->
              <section class="gst-benefits-section">
                <div class="gst-benefits-container">
                  <div class="gst-icon-side">
                    <div class="gst-badge-illustration">
                      <i class="fas fa-file-invoice"></i>
                      <div class="gst-check">
                        <i class="fas fa-check"></i>
                      </div>
                    </div>
                  </div>

                  <div class="gst-content-side">
                    <h2 class="gst-title">Have a GST Number? Get Extra Savings!</h2>
                    <p class="gst-subtitle">Reduce transaction fees and claim input tax credit</p>

                    <div class="gst-benefits-list">
                      <div class="gst-benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Live GST rate: <%= Number(settings.gstRate || 0) %>%</span>
                      </div>
                      <div class="gst-benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Annual billing discount: <%= Number(settings.annualDiscount || 0) %>%</span>
                      </div>
                      <div class="gst-benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Student pricing enabled: <%= settings.studentDiscountEnabled ? 'Yes' : 'No' %></span>
                      </div>
                    </div>

                    <button class="gst-cta-button">Learn More About GST Benefits</button>
                  </div>
                </div>
              </section>

              <!-- SECTION 4: Detailed Comparison Table -->
              <section class="comparison-section">
                <div class="comparison-container">
                  <h2 class="comparison-title">Compare All Features</h2>

                  <div class="table-wrapper">
                    <table class="comparison-table">
                      <thead>
                        <tr>
                          <th class="feature-column">Feature</th>
                          <% plans.forEach((plan) => { %>
                            <th class="<%= plan.highlightPopular ? 'popular-column' : '' %>"><%= plan.name %></th>
                          <% }) %>
                        </tr>
                      </thead>
                      <tbody>
                        <tr class="category-header">
                          <td colspan="<%= plans.length + 1 %>">PAYMENT FEATURES</td>
                        </tr>
                        <tr>
                          <td class="feature-name">Monthly Volume Limit</td>
                          <% plans.forEach((plan) => { %><td><%= plan.volumeLimitText || 'Flexible' %></td><% }) %>
                        </tr>
                        <tr>
                          <td class="feature-name">Transaction Limit</td>
                          <% plans.forEach((plan) => { %><td><%= Number(plan.monthlyTxLimit || 0) > 0 ? `${Number(plan.monthlyTxLimit).toLocaleString('en-IN')}/month` : 'Unlimited' %></td><% }) %>
                        </tr>
                        <tr>
                          <td class="feature-name">Domestic Transaction Fee</td>
                          <% plans.forEach((plan) => { %><td><%= plan.transactionFeeText || 'Custom' %></td><% }) %>
                        </tr>
                        <tr class="category-header">
                          <td colspan="<%= plans.length + 1 %>">FEATURES INCLUDED</td>
                        </tr>
                        <% 
                          const featurePool = Array.from(new Set(plans.flatMap((plan) => Array.isArray(plan.features) ? plan.features : []))).slice(0, 12);
                        %>
                        <% featurePool.forEach((feature) => { %>
                          <tr>
                            <td class="feature-name"><%= feature %></td>
                            <% plans.forEach((plan) => { %>
                              <td>
                                <% if ((plan.features || []).includes(feature)) { %>
                                  <i class="fas fa-check text-success"></i>
                                <% } else { %>
                                  <i class="fas fa-times text-muted"></i>
                                <% } %>
                              </td>
                            <% }) %>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </section>

              <!-- SECTION 5: FAQ Section -->
              <section class="faq-section">
                <div class="faq-container">
                  <h2 class="faq-title">Frequently Asked Questions</h2>

                  <div class="faq-list">
                    <div class="faq-item">
                      <div class="faq-question">
                        <span>What payment methods do you support?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>We support UPI, credit/debit cards (Visa, Mastercard, RuPay, Amex), net banking (50+ banks),
                          digital
                          wallets (Paytm, PhonePe, Google Pay), and BNPL options.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Are there any setup or hidden fees?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>No setup fees, no annual maintenance charges, and no hidden costs. You only pay the monthly
                          subscription and per-transaction fees listed above.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Can I upgrade or downgrade my plan anytime?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>Yes! You can upgrade immediately. Downgrades take effect at the end of your current billing
                          cycle.
                          Pro-rated credits are applied.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>How does the GST discount work?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>Upload your GST certificate during onboarding. Once verified, platform discounts are applied based on the live admin configuration.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>What is the payout schedule?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>Starter: T+3 days, Professional: T+2 days, Business: T+1 day, Enterprise: Same day or instant
                          (custom
                          arrangement).</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Do you charge for failed transactions?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>No, you're only charged for successful transactions. Failed or declined transactions are
                          free.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Is there a contract or lock-in period?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>No lock-in period for monthly plans. Yearly plans require 12-month commitment but offer 17%
                          savings.
                        </p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>What happens if I exceed my monthly volume?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>You'll receive usage alerts and can upgrade plans anytime. Final overage and discounts always follow your current live plan configuration.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Do you offer refunds?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>Subscription fees are non-refundable, but you can cancel anytime. Unused months on yearly
                          plans are
                          pro-rated.</p>
                      </div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-question">
                        <span>Can I try before I buy?</span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="faq-answer">
                        <p>Yes! We offer a 14-day free trial on all plans (no credit card required). Test all features
                          before
                          committing.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- SECTION 6: Enterprise Contact Section -->
              <section class="enterprise-contact-section">
                <div class="enterprise-contact-content">
                  <h2 class="enterprise-title">Need a Custom Solution?</h2>
                  <p class="enterprise-subtitle">Let's discuss your requirements and create a tailored plan for your
                    business.</p>

                  <div class="enterprise-cta-buttons">
                    <button class="enterprise-btn primary">Contact Sales</button>
                    <button class="enterprise-btn secondary">Schedule a Demo</button>
                  </div>

                  <div class="trust-indicators">
                    <p class="trust-text">Used by leading enterprises across India</p>
                  </div>
                </div>
              </section>

              <!-- SECTION 7: Trust & Security Section -->
              <section class="trust-security-section">
                <div class="trust-security-container">
                  <h2 class="trust-security-title">Your Security is Our Priority</h2>

                  <div class="security-grid">
                    <div class="security-feature">
                      <div class="security-icon">
                        <i class="fas fa-shield-alt"></i>
                      </div>
                      <h3 class="security-feature-title">PCI DSS Compliant</h3>
                      <p class="security-feature-desc">Bank-grade security for all transactions</p>
                    </div>

                    <div class="security-feature">
                      <div class="security-icon">
                        <i class="fas fa-lock"></i>
                      </div>
                      <h3 class="security-feature-title">256-bit SSL Encryption</h3>
                      <p class="security-feature-desc">Your data is encrypted end-to-end</p>
                    </div>

                    <div class="security-feature">
                      <div class="security-icon">
                        <i class="fas fa-mobile-alt"></i>
                      </div>
                      <h3 class="security-feature-title">Two-Factor Authentication</h3>
                      <p class="security-feature-desc">Extra layer of account security</p>
                    </div>

                    <div class="security-feature">
                      <div class="security-icon">
                        <i class="fas fa-server"></i>
                      </div>
                      <h3 class="security-feature-title">99.9% Uptime SLA</h3>
                      <p class="security-feature-desc">Reliable service you can count on</p>
                    </div>
                  </div>

                  <div class="trust-badges">
                    <div class="trust-badge-item">
                      <i class="fas fa-certificate"></i>
                      <span>RBI Authorized</span>
                    </div>
                    <div class="trust-badge-item">
                      <i class="fas fa-award"></i>
                      <span>ISO Certified</span>
                    </div>
                    <div class="trust-badge-item">
                      <i class="fas fa-check-circle"></i>
                      <span>SOC 2 Compliant</span>
                    </div>
                    <div class="trust-badge-item">
                      <i class="fas fa-globe"></i>
                      <span>GDPR Ready</span>
                    </div>
                  </div>
                </div>
              </section>
              

              <!-- SECTION 8: Call-to-Action (Bottom) -->
              <section class="bottom-cta-section">
                <div class="bottom-cta-content">
                  <h2 class="bottom-cta-title">Ready to Get Started?</h2>
                  <p class="bottom-cta-subtitle">Join 50,000+ businesses already using ZenoPay</p>

                  <div class="bottom-cta-buttons">
                    <button class="bottom-cta-btn primary">Start Free Trial</button>
                    <button class="bottom-cta-btn secondary">View Documentation</button>
                  </div>
                </div>
              </section>

              <%- include('partials/footer') %>

              <script src="/js/pricing.js?v=20260429"></script>
              <script src="/js/header.js"></script>
              <script src="/js/premium-interactions.js"></script>
</body>

</html>