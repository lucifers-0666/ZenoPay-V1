<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f7fa;
      color: #1f2937;
    }
    
    .compare-hero {
      background: linear-gradient(135deg, #1E3A8A 0%, #312E81 50%, #6D28D9 100%);
      padding: 40px;
      text-align: center;
      color: white;
    }
    
    .compare-hero h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }
    
    .container {
      max-width: 1600px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    
    .version-selector {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      display: flex;
      gap: 20px;
      align-items: center;
      flex-wrap: wrap;
    }
    
    .version-selector select {
      flex: 1;
      min-width: 200px;
      padding: 12px;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }
    
    .version-selector button {
      padding: 12px 24px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }
    
    .version-selector button:hover {
      background: #5568d3;
    }
    
    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    
    .version-column {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      overflow: hidden;
    }
    
    .version-header {
      padding: 20px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .version-header h2 {
      font-size: 24px;
      margin-bottom: 8px;
    }
    
    .version-meta {
      font-size: 14px;
      opacity: 0.9;
    }
    
    .version-content {
      padding: 30px;
      max-height: 800px;
      overflow-y: auto;
    }
    
    .section-item {
      margin-bottom: 30px;
      padding-bottom: 30px;
      border-bottom: 1px solid #e5e7eb;
    }
    
    .section-item:last-child {
      border-bottom: none;
    }
    
    .section-title {
      font-size: 18px;
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .section-number {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 14px;
    }
    
    .section-content {
      color: #4b5563;
      line-height: 1.8;
      font-size: 14px;
    }
    
    .diff-added {
      background: #d1fae5;
      padding: 2px 4px;
      border-radius: 3px;
      border-left: 3px solid #10b981;
    }
    
    .diff-removed {
      background: #fee2e2;
      padding: 2px 4px;
      border-radius: 3px;
      border-left: 3px solid #ef4444;
      text-decoration: line-through;
      opacity: 0.7;
    }
    
    .diff-modified {
      background: #fef3c7;
      padding: 2px 4px;
      border-radius: 3px;
      border-left: 3px solid #f59e0b;
    }
    
    .legend {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      justify-content: center;
    }
    
    .legend-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
    }
    
    .legend-color {
      width: 24px;
      height: 24px;
      border-radius: 4px;
    }
    
    @media (max-width: 992px) {
      .comparison-grid {
        grid-template-columns: 1fr;
      }
      
      .version-selector {
        flex-direction: column;
      }
      
      .version-selector select {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero Section -->
  <div class="compare-hero">
    <h1><i class="fas fa-exchange-alt"></i> Compare Privacy Policy Versions</h1>
    <p>See what changed between different versions</p>
  </div>

  <!-- Main Container -->
  <div class="container">
    
    <!-- Version Selector (Optional - for future enhancement) -->
    <!-- 
    <div class="version-selector">
      <select id="version1Select">
        <option>Select Version 1</option>
      </select>
      <i class="fas fa-exchange-alt" style="color: #667eea;"></i>
      <select id="version2Select">
        <option>Select Version 2</option>
      </select>
      <button onclick="compareVersions()">Compare</button>
    </div>
    -->
    
    <!-- Legend -->
    <div class="legend">
      <div class="legend-item">
        <div class="legend-color" style="background: #d1fae5; border-left: 3px solid #10b981;"></div>
        <span>Added Content</span>
      </div>
      <div class="legend-item">
        <div class="legend-color" style="background: #fee2e2; border-left: 3px solid #ef4444;"></div>
        <span>Removed Content</span>
      </div>
      <div class="legend-item">
        <div class="legend-color" style="background: #fef3c7; border-left: 3px solid #f59e0b;"></div>
        <span>Modified Content</span>
      </div>
    </div>
    
    <!-- Comparison Grid -->
    <div class="comparison-grid">
      
      <!-- Version 1 (Older) -->
      <div class="version-column">
        <div class="version-header">
          <h2>Version <%= policy1.version %></h2>
          <div class="version-meta">
            <i class="fas fa-calendar"></i>
            Published: <%= new Date(policy1.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </div>
        </div>
        <div class="version-content">
          <% policy1.sections.forEach(section => { %>
          <div class="section-item">
            <div class="section-title">
              <span class="section-number"><%= section.id %></span>
              <%= section.title %>
            </div>
            <div class="section-content">
              <%- section.content %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      
      <!-- Version 2 (Newer) -->
      <div class="version-column">
        <div class="version-header" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
          <h2>Version <%= policy2.version %></h2>
          <div class="version-meta">
            <i class="fas fa-calendar"></i>
            Published: <%= new Date(policy2.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </div>
        </div>
        <div class="version-content">
          <% policy2.sections.forEach(section => { %>
          <div class="section-item">
            <div class="section-title">
              <span class="section-number" style="background: linear-gradient(135deg, #10b981, #059669);"><%= section.id %></span>
              <%= section.title %>
            </div>
            <div class="section-content">
              <%- section.content %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      
    </div>
    
    <!-- Action Buttons -->
    <div style="margin-top: 40px; text-align: center; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
      <a href="/privacy-policy/v/<%= policy1.version %>" class="btn" style="padding: 12px 24px; background: #667eea; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
        <i class="fas fa-eye"></i>
        View v<%= policy1.version %> Full Policy
      </a>
      <a href="/privacy-policy/v/<%= policy2.version %>" class="btn" style="padding: 12px 24px; background: #10b981; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
        <i class="fas fa-eye"></i>
        View v<%= policy2.version %> Full Policy
      </a>
      <a href="/privacy-policy/archive" class="btn" style="padding: 12px 24px; background: #6b7280; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
        <i class="fas fa-archive"></i>
        Back to Archive
      </a>
    </div>
    
  </div>

  <%- include('partials/footer') %>
  
  <script>
    // Sync scroll between columns
    const columns = document.querySelectorAll('.version-content');
    let isScrolling = false;
    
    columns.forEach((column, index) => {
      column.addEventListener('scroll', function() {
        if (!isScrolling) {
          isScrolling = true;
          const otherColumn = columns[index === 0 ? 1 : 0];
          const scrollPercentage = this.scrollTop / (this.scrollHeight - this.clientHeight);
          otherColumn.scrollTop = scrollPercentage * (otherColumn.scrollHeight - otherColumn.clientHeight);
          setTimeout(() => { isScrolling = false; }, 50);
        }
      });
    });
  </script>
</body>
</html>
