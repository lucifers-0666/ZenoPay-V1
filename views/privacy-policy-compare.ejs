<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Compare Privacy Policy Versions' %> | ZenoPay</title>
  <link rel="stylesheet" href="/css/header.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main class="container" style="max-width: 1100px; margin: 2rem auto; padding: 1rem;">
    <h1>Compare Privacy Policy Versions</h1>

    <% const newer = currentPolicy || policy2 || null; %>
    <% const older = comparePolicy || policy1 || null; %>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:1rem; margin-top:1rem;">
      <article style="border:2px solid #16a34a; border-radius:10px; padding:1rem; background:#f0fdf4;">
        <div style="font-size:.85rem; font-weight:700; color:#15803d;">NEWER VERSION</div>
        <h2 style="margin:.4rem 0;"><%= newer?.title || 'Current Policy' %></h2>
        <p><strong>Version:</strong> <%= newer?.version || 'N/A' %></p>
        <p><strong>Effective Date:</strong> <%= newer?.effectiveDate || 'N/A' %></p>
        <hr />
        <div><%- newer?.content || '' %></div>
      </article>

      <article style="border:2px solid #94a3b8; border-radius:10px; padding:1rem; background:#f8fafc;">
        <div style="font-size:.85rem; font-weight:700; color:#475569;">OLDER VERSION</div>
        <h2 style="margin:.4rem 0;"><%= older?.title || 'Compared Policy' %></h2>
        <p><strong>Version:</strong> <%= older?.version || 'N/A' %></p>
        <p><strong>Effective Date:</strong> <%= older?.effectiveDate || 'N/A' %></p>
        <hr />
        <div><%- older?.content || '' %></div>
      </article>
    </div>

    <div style="margin-top:1.25rem;">
      <a href="/privacy-policy/archive" style="text-decoration:none; font-weight:600;">← Back to Archive</a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
