<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <% if (policy && policy.metaDescription) { %>
  <meta name="description" content="<%= policy.metaDescription %>">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/terms.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .search-container {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    
    .search-box {
      position: relative;
    }
    
    .search-input {
      width: 100%;
      padding: 12px 40px 12px 40px;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      transition: border-color 0.3s;
    }
    
    .search-input:focus {
      outline: none;
      border-color: #667eea;
    }
    
    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
    }
    
    .search-results {
      margin-top: 10px;
      font-size: 13px;
      color: #6b7280;
    }
    
    .highlight-match {
      background-color: #fef08a;
      padding: 2px 4px;
      border-radius: 2px;
    }
    
    .acceptance-banner {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }
    
    .acceptance-text {
      flex: 1;
    }
    
    .acceptance-text h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }
    
    .acceptance-text p {
      font-size: 14px;
      opacity: 0.9;
    }
    
    .accept-btn {
      padding: 12px 24px;
      background: white;
      color: #667eea;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      white-space: nowrap;
    }
    
    .accept-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3);
    }
    
    .archive-notice {
      background: #fef3c7;
      color: #92400e;
      padding: 15px 20px;
      border-radius: 8px;
      margin-bottom: 20px;
      border-left: 4px solid #f59e0b;
    }
    
    .archive-notice i {
      margin-right: 8px;
    }
  </style>
</head>
<body data-user-logged-in="<%= user ? 'true' : 'false' %>" data-policy-version="<%= policy && policy.version ? policy.version : 'unknown' %>">
  <%- include('partials/header') %>

  <!-- Page Header -->
  <div class="terms-hero">
    <div class="terms-hero-content">
      <i class="fas fa-shield-alt hero-icon"></i>
      <h1 class="hero-title">Privacy Policy</h1>
      <% if (policy) { %>
      <p class="hero-subtitle">
        <%= policy.publishedDate ? 'Last updated: ' + new Date(policy.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Draft Version' %>
      </p>
      <div class="hero-meta">
        <span class="meta-badge effective-badge">
          <i class="fas fa-calendar-check"></i>
          Effective from: <%= new Date(policy.effectiveDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </span>
        <span class="meta-badge version-badge">
          <i class="fas fa-code-branch"></i>
          Version <%= policy.version %>
        </span>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Main Content Container -->
  <div class="terms-container">
    <div class="terms-layout">
      
      <!-- Sidebar Table of Contents (Desktop) -->
      <aside class="terms-sidebar" id="termsSidebar">
        <div class="sidebar-sticky">
          <% if (!isPreview && policy && policy.status === 'published') { %>
          <!-- Search Box -->
          <div class="search-container">
            <div class="search-box">
              <i class="fas fa-search search-icon"></i>
              <input type="text" 
                     class="search-input" 
                     id="searchInput" 
                     placeholder="Search privacy policy...">
            </div>
            <div class="search-results" id="searchResults"></div>
          </div>
          <% } %>
          
          <h3 class="sidebar-title">Table of Contents</h3>
          <nav class="toc-nav">
            <% if (policy && policy.sections) { %>
              <% policy.sections.forEach((section, index) => { %>
              <a href="#section-<%= section.id %>" 
                 class="toc-link <%= index === 0 ? 'active' : '' %>" 
                 data-section="section-<%= section.id %>">
                <span class="toc-number"><%= section.id %></span>
                <span class="toc-text"><%= section.title %></span>
              </a>
              <% }); %>
            <% } %>
          </nav>
          
          <!-- Action Buttons -->
          <div class="sidebar-actions">
            <a href="/privacy-policy/download?version=<%= policy ? policy.version : '' %>" 
               class="action-btn download-btn">
              <i class="fas fa-download"></i>
              <span>Download PDF</span>
            </a>
            <button class="action-btn print-btn" onclick="window.print()">
              <i class="fas fa-print"></i>
              <span>Print</span>
            </button>
            <% if (!isPreview && policy && policy.status === 'published') { %>
            <a href="/privacy-policy/archive" class="action-btn">
              <i class="fas fa-history"></i>
              <span>View Archive</span>
            </a>
            <% } %>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="terms-content">
        
        <% if (typeof isArchive !== 'undefined' && isArchive) { %>
        <div class="archive-notice">
          <i class="fas fa-info-circle"></i>
          <strong>Archived Version:</strong> You are viewing a previous version of our Privacy Policy. 
          <a href="/privacy-policy" style="color: #92400e; text-decoration: underline;">View current version</a>
        </div>
        <% } %>
        
        <% if (!isPreview && user && !hasAccepted && policy && policy.isCurrent) { %>
        <div class="acceptance-banner">
          <div class="acceptance-text">
            <h3><i class="fas fa-check-circle"></i> Accept Privacy Policy</h3>
            <p>We've updated our Privacy Policy. Please review and accept to continue using ZenoPay.</p>
          </div>
          <button class="accept-btn" onclick="acceptPolicy()">
            I Accept
          </button>
        </div>
        <% } %>
        
        <% if (policy && policy.sections) { %>
          <% policy.sections.forEach((section) => { %>
          <section id="section-<%= section.id %>" class="terms-section">
            <div class="section-header">
              <span class="section-number"><%= section.id %></span>
              <h2 class="section-title"><%= section.title %></h2>
            </div>
            <div class="section-body">
              <%- section.content %>
            </div>
          </section>
          <% }); %>
        <% } else { %>
        <div class="empty-state" style="text-align: center; padding: 60px 20px;">
          <i class="fas fa-file-alt" style="font-size: 64px; color: #d1d5db; margin-bottom: 20px;"></i>
          <h3 style="font-size: 24px; color: #6b7280; margin-bottom: 10px;">Privacy Policy Not Available</h3>
          <p style="color: #9ca3af;">The privacy policy is currently being updated. Please check back later.</p>
        </div>
        <% } %>

        <!-- Contact Section -->
        <% if (policy) { %>
        <section class="terms-section" style="background: #f8f9fa; border-radius: 12px; padding: 30px; margin-top: 40px;">
          <div class="section-header">
            <span class="section-number"><i class="fas fa-envelope"></i></span>
            <h2 class="section-title">Questions About Privacy?</h2>
          </div>
          <div class="section-body">
            <p>If you have any questions or concerns about our Privacy Policy or data practices, please contact us:</p>
            <ul>
              <li><strong>Email:</strong> <a href="mailto:privacy@zenopay.com">privacy@zenopay.com</a></li>
              <li><strong>Data Protection Officer:</strong> <a href="mailto:dpo@zenopay.com">dpo@zenopay.com</a></li>
              <li><strong>Support:</strong> <a href="/contact">Contact Form</a></li>
            </ul>
          </div>
        </section>
        <% } %>

      </main>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="/js/privacy-policy.js"></script>
</body>
</html>
