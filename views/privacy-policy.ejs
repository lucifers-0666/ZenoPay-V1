<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Privacy Policy' %> | ZenoPay</title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main class="container" style="max-width: 960px; margin: 2rem auto; padding: 1rem;">
    <h1>Privacy Policy</h1>

    <% if (policy) { %>
      <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:1rem; margin:1rem 0;">
        <p><strong>Title:</strong> <%= policy.title || 'Privacy Policy' %></p>
        <p><strong>Version:</strong> <%= policy.version || 'N/A' %></p>
        <p><strong>Effective Date:</strong> <%= policy.effectiveDate || 'N/A' %></p>
        <p><strong>Last Updated:</strong> <%= policy.lastUpdated || policy.publishedDate || 'N/A' %></p>
      </div>

      <section style="line-height:1.7;">
        <%- policy.content || '' %>
      </section>
    <% } else { %>
      <p>Privacy policy content is currently unavailable.</p>
    <% } %>

    <div style="margin-top:1.5rem;">
      <a href="/privacy-policy/archive" style="display:inline-flex; align-items:center; gap:.5rem; text-decoration:none; font-weight:600;">
        <i class="fas fa-history"></i>
        View Previous Versions
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
