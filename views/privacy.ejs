                      <p class="contact-card-role">General privacy enquiries &amp; data subject requests</p>
                      <a href="mailto:privacy@zenopay.com" class="contact-card-link">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        privacy@zenopay.com
                      </a>
                      <p class="contact-card-note">Response within 30 days</p>
                    </div>

                    <div class="contact-card">
                      <div class="contact-card-icon-wrap">
                        <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                      </div>
                      <h3>Legal Department</h3>
                      <p class="contact-card-role">Legal process, subpoenas &amp; regulatory requests</p>
                      <a href="mailto:legal@zenopay.com" class="contact-card-link">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        legal@zenopay.com
                      </a>
                      <p class="contact-card-note">Legal requests only</p>
                    </div>

                    <div class="contact-card">
                      <div class="contact-card-icon-wrap">
                        <i class="fas fa-user-tie" aria-hidden="true"></i>
                      </div>
                      <h3>Data Protection Officer</h3>
                      <p class="contact-card-role">GDPR rights, escalations &amp; DPA complaints</p>
                      <a href="mailto:dpo@zenopay.com" class="contact-card-link">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        dpo@zenopay.com
                      </a>
                      <p class="contact-card-note">DPO — independently appointed</p>
                    </div>
                  </div>

                  <div class="mailing-address-box">
                    <div class="mailing-address-title">
                      <i class="fas fa-location-dot" aria-hidden="true"></i>
                      Postal Address
                    </div>
                    <address class="mailing-address-body">
                      <p>ZenoPay Privacy &amp; Data Protection</p>
                      <p>Attention: Privacy Team</p>
                      <p>123 ZenoPay Way, Financial District</p>
                      <p>Nairobi, Kenya 00100</p>
                    </address>
                  </div>
                </div>
              </section>

