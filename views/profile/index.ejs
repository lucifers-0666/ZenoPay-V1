<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <style>
    :root {
      --primary:#3B82F6; --primary-hover:#2563EB; --primary-light:#60A5FA;
      --secondary:#8B5CF6; --secondary-dark:#7C3AED;
      --success:#10B981; --error:#EF4444; --warning:#F59E0B;
      --text:#1E293B; --muted:#64748B; --bg:#F8FAFC; --surface:#FFFFFF; --border:1px solid rgba(148,163,184,0.35);
      --shadow:0 8px 24px rgba(15,23,42,0.08); --transition:all 180ms cubic-bezier(0.16,1,0.3,1);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; }
    .page { max-width: 1020px; margin: 0 auto; padding: 24px 16px 64px; }
    h1 { margin: 0 0 14px; font-family: 'DM Serif Display', serif; font-size: 2rem; }
    .grid { display: grid; gap: 14px; grid-template-columns: 1.4fr .9fr; }
    .card { background: var(--surface); border: var(--border); border-radius: 12px; box-shadow: var(--shadow); padding: 20px; transition: var(--transition); }
    .card:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(15,23,42,.12); }
    .hero { display: flex; align-items: center; gap: 14px; }
    .avatar { width: 62px; height: 62px; border-radius: 50%; background: var(--primary); color: #fff; font-weight: 700; font-size: 1.4rem; display: grid; place-items: center; }
    .muted { color: var(--muted); }
    .badge { border-radius: 9999px; padding: 6px 10px; font-size: .8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    .b-pending { background: #f2f2f0; color: #555; }
    .b-submitted { background: #FFFBEB; color: #B45309; }
    .b-verified { background: #ECFDF5; color: #047857; }
    .b-rejected { background: #FEE2E2; color: #B91C1C; }
    .progress-wrap { margin-top: 12px; }
    .progress { width: 100%; background: #E2E8F0; border-radius: 9999px; height: 10px; overflow: hidden; }
    .progress > span { display: block; height: 100%; background: var(--primary); width: 0; transition: width 260ms ease; }

    form { margin-top: 14px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
    label { font-weight: 600; font-size: .9rem; }
    .field { display: grid; gap: 6px; }
    .field.full { grid-column: 1 / -1; }
    input, textarea {
      border: 1px solid rgba(40,37,29,0.2); border-radius: 8px; padding: 12px 14px; outline: none; transition: var(--transition);
    }
    textarea { min-height: 78px; resize: vertical; }
    input:focus, textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.22); }
    .btn {
      background: var(--primary); color: #fff; border: none; border-radius: 8px; padding: 12px 20px; font-weight: 600; cursor: pointer; transition: var(--transition);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn:hover { transform: translateY(-1px); background: var(--primary-hover); }
    .wallet-link { text-decoration: none; color: inherit; }
    .wallet-amt { font-size: 1.8rem; margin: 8px 0 0; font-variant-numeric: tabular-nums; }
    .toast { position: fixed; right: 18px; top: 18px; color: #fff; padding: 12px 16px; border-radius: 10px; box-shadow: var(--shadow); opacity: 0; transform: translateY(-12px); transition: var(--transition); }
    .toast.success { background: var(--success); } .toast.error { background: var(--error); }
    .toast.show { opacity: 1; transform: translateY(0); }
    @media (max-width: 840px) { .grid { grid-template-columns: 1fr; } form { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <% const pUser = profileUser || {}; %>
  <% const name = pUser.name || pUser.FullName || 'User'; %>
  <% const kyc = String(pUser.kycStatus || 'pending').toLowerCase(); %>

  <main class="page">
    <h1>My Profile</h1>

    <div class="grid">
      <section class="card">
        <div class="hero">
          <div class="avatar"><%= String(name).trim().charAt(0).toUpperCase() %></div>
          <div>
            <strong><%= name %></strong>
            <div class="muted"><%= pUser.Email || pUser.email || 'No email' %></div>
            <div style="margin-top:8px;">
              <% if (kyc === 'verified') { %>
                <span class="badge b-verified">Verified ✓</span>
              <% } else if (kyc === 'submitted') { %>
                <span class="badge b-submitted">Under Review</span>
              <% } else if (kyc === 'rejected') { %>
                <span class="badge b-rejected">Rejected</span>
              <% } else { %>
                <span class="badge b-pending">Not Started</span>
              <% } %>
            </div>
          </div>
        </div>

        <div class="progress-wrap">
          <div class="muted">KYC completion: <strong style="color:var(--text)"><%= Number(kycCompletion || 0) %>%</strong></div>
          <div class="progress"><span id="kycProgressFill" data-width="<%= Number(kycCompletion || 0) %>"></span></div>
        </div>

        <form action="/profile/update" method="post">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" value="<%= name %>" required />
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" value="<%= pUser.phone || pUser.Mobile || '' %>" />
          </div>
          <div class="field">
            <label for="dateOfBirth">Date of Birth</label>
            <input id="dateOfBirth" name="dateOfBirth" type="date" value="<%= (pUser.dateOfBirth || pUser.DOB) ? new Date(pUser.dateOfBirth || pUser.DOB).toISOString().split('T')[0] : '' %>" />
          </div>
          <div class="field full">
            <label for="address">Address</label>
            <textarea id="address" name="address"><%= pUser.address || pUser.Address || '' %></textarea>
          </div>
          <div class="field full">
            <button class="btn" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Profile</button>
          </div>
        </form>
      </section>

      <aside class="card">
        <a class="wallet-link" href="/wallet/balance">
          <small class="muted">Wallet Balance</small>
          <div class="wallet-amt">₹<%= Number(wallet?.balance || 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
          <div class="muted" style="margin-top:8px;">View wallet details →</div>
        </a>
        <hr style="border:none;border-top:var(--border);margin:16px 0;" />
        <a class="btn" href="/profile/kyc" style="text-decoration:none;justify-content:center;">Complete KYC</a>
        <a class="btn" href="/user/set-pin" style="text-decoration:none;justify-content:center;margin-top:10px;">Set Transaction PIN</a>
      </aside>
    </div>
  </main>

  <% if (flash && flash.message) { %>
    <div class="toast <%= flash.type === 'error' ? 'error' : 'success' %>" id="toast"><%= flash.message %></div>
  <% } %>

  <script>
    (function setProgress() {
      const bar = document.getElementById('kycProgressFill');
      if (!bar) return;
      const width = Number(bar.dataset.width || 0);
      requestAnimationFrame(() => {
        bar.style.width = `${Math.max(0, Math.min(100, width))}%`;
      });
    })();

    (function initToast() {
      const toast = document.getElementById('toast');
      if (!toast) return;
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => toast.classList.remove('show'), 4000);
    })();
  </script>
</body>
</html>
