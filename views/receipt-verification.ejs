<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --primary-blue: #3B82F6;
      --primary-dark: #2563EB;
      --secondary-purple: #8B5CF6;
      --success-green: #10B981;
      --error-red: #EF4444;
      --warning-yellow: #F59E0B;
      --bg-light: #F8FAFC;
      --bg-white: #FFFFFF;
      --border-color: #E2E8F0;
      --text-primary: #1F2937;
      --text-secondary: #475569;
      --text-muted: #6B7280;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: var(--bg-light);
      min-height: 100vh;
      color: var(--text-primary);
    }

    .page-wrap {
      max-width: 800px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    .breadcrumb {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 40px;
    }

    .breadcrumb a {
      color: var(--primary-blue);
      text-decoration: none;
    }

    .breadcrumb a:hover { text-decoration: underline; }

    .hero { text-align: center; }

    .hero-icon {
      width: 96px;
      height: 96px;
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-purple));
      border-radius: 20px;
      padding: 16px;
      margin: 0 auto 24px;
      box-shadow: 0 8px 24px rgba(59, 130, 246, 0.25);
      display: grid;
      place-items: center;
      color: white;
      font-size: 42px;
    }

    .hero h1 {
      margin: 0 0 12px;
      font-size: 36px;
      line-height: 1.15;
      font-weight: 800;
      color: var(--text-primary);
    }

    .hero p {
      max-width: 550px;
      margin: 0 auto 40px;
      font-size: 17px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .card {
      background: var(--bg-white);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    #verification-form-card {
      padding: 40px;
      margin-bottom: 32px;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .card h2 {
      margin: 0 0 8px;
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .card .sub {
      margin: 0 0 24px;
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .input-row {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    .input-wrap { flex: 1; }

    .receipt-input {
      width: 100%;
      height: 52px;
      border: 1.5px solid var(--border-color);
      border-radius: 12px;
      padding: 0 20px;
      font-size: 16px;
      font-family: 'Courier New', monospace;
      color: var(--text-primary);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: all 0.3s ease;
    }

    .receipt-input::placeholder { color: #94A3B8; }

    .receipt-input:focus {
      outline: none;
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .receipt-input.error {
      border-color: var(--error-red);
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
      background: #FEF2F2;
    }

    .verify-btn {
      width: 160px;
      height: 52px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      color: white;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.3s ease;
    }

    .verify-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(59, 130, 246, 0.35);
      background: linear-gradient(135deg, #2563EB, #1D4ED8);
    }

    .verify-btn:disabled {
      opacity: 0.8;
      cursor: not-allowed;
      transform: none;
    }

    .btn-loading .spinner {
      animation: spin 0.8s linear infinite;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: white;
      border-radius: 50%;
      width: 18px;
      height: 18px;
    }

    .error-message {
      margin-top: 8px;
      color: var(--error-red);
      font-size: 13px;
      display: none;
      align-items: center;
      gap: 6px;
    }

    .or-divider {
      margin: 24px 0;
      display: flex;
      align-items: center;
      gap: 16px;
      color: #94A3B8;
      font-size: 14px;
    }

    .or-divider::before,
    .or-divider::after {
      content: '';
      flex: 1;
      border-top: 1px solid var(--border-color);
    }

    .qr-btn {
      width: 100%;
      height: 48px;
      background: white;
      border: 1.5px solid var(--border-color);
      border-radius: 12px;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .qr-btn:hover {
      border-color: var(--primary-blue);
      color: var(--primary-blue);
      background: #EFF6FF;
    }

    #result-state { display: none; }

    .verified-banner,
    .invalid-banner {
      border-radius: 16px;
      padding: 24px 32px;
      display: flex;
      gap: 20px;
      margin-bottom: 32px;
    }

    .verified-banner {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(5, 150, 105, 0.05));
      border: 1.5px solid var(--success-green);
      box-shadow: 0 4px 16px rgba(16, 185, 129, 0.12);
      align-items: center;
    }

    .invalid-banner {
      background: rgba(239, 68, 68, 0.06);
      border: 1.5px solid var(--error-red);
      box-shadow: 0 4px 16px rgba(239, 68, 68, 0.10);
      align-items: flex-start;
      animation: shake 0.5s ease;
    }

    .state-icon {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: white;
      font-size: 28px;
      flex-shrink: 0;
    }

    .verified-icon {
      background: var(--success-green);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      animation: verifiedPulse 0.5s ease forwards;
    }

    .invalid-icon { background: var(--error-red); }

    .state-content h3 {
      margin: 0 0 4px;
      font-size: 22px;
      font-weight: 700;
    }

    .verified-banner .state-content h3 { color: #065F46; }
    .invalid-banner .state-content h3 { color: #991B1B; }

    .state-content p {
      margin: 0;
      font-size: 14px;
      line-height: 1.5;
    }

    .verified-banner .state-content p { color: #047857; }
    .invalid-banner .state-content p { color: #B91C1C; }

    .verify-time {
      margin-top: 6px;
      font-size: 12px;
      color: var(--text-muted);
    }

    .invalid-reasons {
      margin: 10px 0 0;
      padding-left: 18px;
      color: #DC2626;
      font-size: 14px;
      line-height: 1.6;
    }

    .warning-box {
      background: #FFFBEB;
      border: 1px solid var(--warning-yellow);
      border-radius: 12px;
      padding: 20px 24px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .warning-box i {
      color: var(--warning-yellow);
      font-size: 24px;
      margin-top: 2px;
    }

    .warning-box h4 {
      margin: 0 0 6px;
      font-size: 16px;
      font-weight: 700;
      color: #92400E;
    }

    .warning-box p {
      margin: 0;
      font-size: 14px;
      color: #92400E;
      line-height: 1.6;
    }

    .receipt-card {
      overflow: hidden;
      margin-bottom: 24px;
    }

    .receipt-header {
      background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
      padding: 28px 32px;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .receipt-meta {
      font-size: 12px;
      opacity: 0.7;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .receipt-id {
      font-family: 'Courier New', monospace;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 10px;
      word-break: break-word;
    }

    .status-pill {
      display: inline-block;
      background: rgba(255, 255, 255, 0.2);
      color: white;
      font-size: 12px;
      padding: 4px 12px;
      border-radius: 20px;
      font-weight: 600;
    }

    .receipt-header-right {
      text-align: right;
      font-weight: 700;
    }

    .receipt-header-right small {
      display: block;
      margin-top: 4px;
      font-size: 12px;
      opacity: 0.7;
      font-weight: 500;
    }

    .receipt-body {
      padding: 32px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .field {
      margin-bottom: 16px;
    }

    .field .label {
      font-size: 12px;
      color: #94A3B8;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .field .value {
      font-size: 16px;
      color: var(--text-primary);
      font-weight: 600;
      word-break: break-word;
    }

    .receipt-divider {
      height: 1px;
      background: #F1F5F9;
      margin: 0 32px;
    }

    .amount-section {
      padding: 24px 32px;
      background: var(--bg-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .amount-label {
      font-size: 12px;
      color: #94A3B8;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .amount-value {
      font-size: 36px;
      font-weight: 800;
      color: var(--text-primary);
      text-align: right;
    }

    .amount-fee {
      font-size: 13px;
      color: #94A3B8;
      text-align: right;
      margin-top: 4px;
    }

    .receipt-footer {
      background: var(--bg-light);
      padding: 20px 32px;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      font-size: 13px;
      color: var(--text-muted);
    }

    .hash {
      font-size: 12px;
      font-family: 'Courier New', monospace;
      color: #94A3B8;
    }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 24px;
    }

    .btn {
      height: 48px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      border: none;
      min-width: 160px;
      padding: 0 16px;
    }

    .btn-primary {
      flex: 1;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      color: white;
    }

    .btn-outline {
      flex: 1;
      background: white;
      border: 1.5px solid var(--border-color);
      color: var(--text-secondary);
    }

    .btn-red {
      background: white;
      border: 1.5px solid var(--error-red);
      color: #B91C1C;
    }

    .btn-primary:hover,
    .btn-outline:hover,
    .btn-red:hover {
      transform: translateY(-2px);
    }

    .btn-primary:hover { box-shadow: 0 8px 24px rgba(59, 130, 246, 0.3); }

    .btn-outline:hover {
      border-color: var(--primary-blue);
      color: var(--primary-blue);
      background: #EFF6FF;
    }

    .verify-another {
      margin-top: 12px;
      width: 100%;
      height: 44px;
      border: none;
      background: transparent;
      color: var(--primary-blue);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .verify-another:hover { text-decoration: underline; }

    .help-title {
      text-align: center;
      font-size: 24px;
      color: var(--text-primary);
      margin: 10px 0 32px;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .step-card {
      background: white;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 28px 24px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      transition: all 0.3s ease;
    }

    .step-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(59, 130, 246, 0.10);
      border-color: #3B82F6;
    }

    .step-num {
      width: 40px;
      height: 40px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-purple));
      color: white;
      font-size: 18px;
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
      display: grid;
      place-items: center;
    }

    .step-icon {
      font-size: 30px;
      margin-bottom: 12px;
      color: var(--primary-blue);
      line-height: 1;
    }

    .step-card h3 {
      margin: 0 0 8px;
      font-size: 17px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .step-card p {
      margin: 0;
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .trust-box {
      margin-top: 40px;
      background: white;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 28px 32px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      text-align: center;
    }

    .trust-item i {
      font-size: 28px;
      color: var(--primary-blue);
    }

    .trust-item h4 {
      margin: 8px 0 4px;
      font-size: 14px;
      color: var(--text-primary);
      font-weight: 600;
    }

    .trust-item p {
      margin: 0;
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .fade-in { animation: fadeIn 0.3s ease; }

    @keyframes verifiedPulse {
      0% { transform: scale(0.8); opacity: 0; }
      60% { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-5px); }
      80% { transform: translateX(5px); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 767px) {
      .page-wrap { max-width: 100%; padding: 40px 16px; }
      .hero h1 { font-size: 28px; }
      #verification-form-card { padding: 24px; }
      .input-row { flex-direction: column; }
      .verify-btn { width: 100%; }
      .receipt-body { grid-template-columns: 1fr; gap: 8px; padding: 24px; }
      .amount-section { flex-direction: column; align-items: flex-start; }
      .amount-value, .amount-fee { text-align: left; }
      .actions { flex-direction: column; }
      .btn, .btn-primary, .btn-outline { width: 100%; flex: none; }
      .steps-grid { grid-template-columns: 1fr; }
      .trust-box { grid-template-columns: repeat(2, 1fr); padding: 24px; }
      .verified-banner, .invalid-banner { padding: 20px; }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
      .page-wrap { max-width: 700px; }
    }
  </style>
</head>
<body data-prefilled-receipt-id="<%= prefilledReceiptId || '' %>">
  <%- include('partials/header') %>
  <div class="page-wrap">
    <div class="breadcrumb"><a href="/">Home</a> &gt; Receipt Verification</div>

    <section class="hero">
      <div class="hero-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <h1>Verify Receipt Authenticity</h1>
      <p>Enter your receipt ID below to instantly verify if a ZenoPay transaction is genuine</p>
    </section>

    <section id="verification-form-card" class="card">
      <h2>Enter Receipt ID</h2>
      <p class="sub">Your receipt ID can be found on your ZenoPay transaction receipt (format: ZP-XXXX-XXXX-XXXX)</p>

      <form id="verify-form">
        <div class="input-row">
          <div class="input-wrap">
            <input
              type="text"
              id="receiptIdInput"
              class="receipt-input"
              placeholder="ZP-XXXX-XXXX-XXXX"
              autocomplete="off"
              maxlength="17"
              value="<%= prefilledReceiptId || '' %>"
            />
            <div id="inputError" class="error-message"><i class="fa-solid fa-circle-exclamation"></i> <span></span></div>
          </div>
          <button id="verifyBtn" type="submit" class="verify-btn">
            <i class="fa-solid fa-shield"></i>
            <span>Verify</span>
          </button>
        </div>
      </form>

      <div class="or-divider">or scan QR code</div>
      <button class="qr-btn" id="scanQrBtn"><i class="fa-solid fa-qrcode"></i> Scan QR Code</button>
    </section>

    <section id="result-state" class="fade-in">
      <div id="success-state" style="display:none;">
        <div class="verified-banner">
          <div class="state-icon verified-icon"><i class="fa-solid fa-check"></i></div>
          <div class="state-content">
            <h3>✓ Receipt Verified Successfully</h3>
            <p>This receipt is authentic and has been verified by ZenoPay's secure system</p>
            <div id="verifiedAt" class="verify-time"></div>
          </div>
        </div>

        <div class="card receipt-card">
          <div class="receipt-header">
            <div>
              <div class="receipt-meta">Transaction Receipt</div>
              <div id="r-receipt-id" class="receipt-id">-</div>
              <div id="r-status" class="status-pill">COMPLETED</div>
            </div>
            <div class="receipt-header-right">
              ZenoPay
              <small>Secure Payment</small>
            </div>
          </div>

          <div class="receipt-body">
            <div>
              <div class="field"><div class="label">Sender Name</div><div class="value" id="r-sender-name">-</div></div>
              <div class="field"><div class="label">Sender Account</div><div class="value" id="r-sender-account">-</div></div>
              <div class="field"><div class="label">Transaction ID</div><div class="value" id="r-transaction-id">-</div></div>
              <div class="field"><div class="label">Reference No</div><div class="value" id="r-reference">-</div></div>
              <div class="field"><div class="label">Payment Method</div><div class="value" id="r-method">-</div></div>
            </div>
            <div>
              <div class="field"><div class="label">Recipient Name</div><div class="value" id="r-recipient-name">-</div></div>
              <div class="field"><div class="label">Recipient Account</div><div class="value" id="r-recipient-account">-</div></div>
              <div class="field"><div class="label">Transaction Date</div><div class="value" id="r-date">-</div></div>
              <div class="field"><div class="label">Transaction Time</div><div class="value" id="r-time">-</div></div>
              <div class="field"><div class="label">Transaction Type</div><div class="value">Money Transfer</div></div>
            </div>
          </div>

          <div class="receipt-divider"></div>

          <div class="amount-section">
            <div>
              <div class="amount-label">Transaction Amount</div>
            </div>
            <div>
              <div id="r-amount" class="amount-value">₹0.00</div>
              <div id="r-fees" class="amount-fee">Platform fee: ₹0.00 - GST: ₹0.00 - Net amount: ₹0.00</div>
            </div>
          </div>

          <div class="receipt-footer">
            <div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:middle;margin-right:6px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Secured by ZenoPay - SSL Encrypted</div>
            <div id="r-hash" class="hash">SHA256: -</div>
          </div>
        </div>

        <div class="actions">
          <button id="downloadBtn" class="btn btn-primary"><i class="fa-solid fa-download"></i> Download PDF</button>
          <button id="printBtn" class="btn btn-outline"><i class="fa-solid fa-print"></i> Print Receipt</button>
          <button id="shareBtn" class="btn btn-outline"><i class="fa-solid fa-share-nodes"></i> Share</button>
        </div>
      </div>

      <div id="failed-state" style="display:none;">
        <div class="invalid-banner">
          <div class="state-icon invalid-icon"><i class="fa-solid fa-xmark"></i></div>
          <div class="state-content">
            <h3>✗ Receipt Not Verified</h3>
            <p>We could not verify this receipt. This could mean:</p>
            <ul class="invalid-reasons">
              <li>The receipt ID is incorrect or has a typo</li>
              <li>This receipt was not generated by ZenoPay</li>
              <li>The transaction was cancelled or reversed</li>
              <li>This may be a fraudulent document</li>
            </ul>
          </div>
        </div>

        <div class="warning-box">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <div>
            <h4>⚠ Potential Fraud Warning</h4>
