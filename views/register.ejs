              <div class="field full-width business-wrap" id="businessWrap">
                <label class="label" for="BusinessName"><i class="fa-solid fa-building"></i> Business Name</label>
                <input class="input" id="BusinessName" name="BusinessName" type="text" placeholder="Registered business name" />
                <p class="error-msg" id="error-BusinessName"><i class="fa-solid fa-circle-exclamation"></i> Enter your business name (3–80 chars)</p>
              </div>

              <div class="field full-width">
                <label class="tnc-box" for="tnc">
                  <input type="checkbox" id="tnc" name="tnc" />
                  <span>
                    I agree to ZenoPay's <a href="/terms" target="_blank" rel="noopener noreferrer">Terms & Conditions</a> and
                    <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>. I confirm all details provided are accurate and genuine.
                  </span>
                </label>
                <p class="error-msg" id="error-tnc"><i class="fa-solid fa-circle-exclamation"></i> You must accept the terms to continue</p>
              </div>
            </div>

            <div class="btn-row">
              <button class="btn btn-ghost" type="button" id="prev3"><i class="fa-solid fa-arrow-left"></i> Previous</button>
              <button class="btn btn-primary btn-full" id="submitBtn" type="submit"><i class="fa-solid fa-user-tie"></i> Create Account</button>
            </div>
          </section>
        </form>

        <section class="success" id="successScreen">
          <div class="success-icon"><i class="fa-solid fa-check"></i></div>
          <h3 class="success-title">Account Created!</h3>
          <p class="success-sub">Welcome to ZenoPay. Please verify your email to activate your account.</p>
          <p class="success-count">Redirecting in <span id="countdown">3</span>s…</p>
        </section>
      </section>

      <div class="trust-row">
        <div class="trust-item"><i class="fa-solid fa-lock"></i> SSL Secured</div>
        <div class="trust-item"><i class="fa-solid fa-shield-halved"></i> GDPR Compliant</div>
        <div class="trust-item"><i class="fa-solid fa-circle-check"></i> ISO Certified</div>
      </div>

      <div class="login-row">Already have an account? <a href="/login">Login here</a></div>
    </main>
  </div>

  <script nonce="<%= locals.cspNonce || '' %>">
    let currentStep = 1;

    const nameRegex = /^[A-Za-z\s.'·-]{3,60}$/;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const mobileRegex = /^[6-9]\d{9}$/;
    const pincodeRegex = /^\d{6}$/;

    const byId = (id) => document.getElementById(id);
    const stepper = byId('stepper');
    const form = byId('registerForm');
    const defaultErrorMessages = {};
    document.querySelectorAll('.error-msg').forEach((el) => {
      defaultErrorMessages[el.id] = el.textContent.trim();
    });

    const fieldStepMap = {
      FullName: 1,
      Email: 1,
      Mobile: 1,
      Password: 1,
      ConfirmPassword: 1,
      DOB: 2,
      Gender: 2,
      FatherName: 2,
      MotherName: 2,
      Address: 2,
      City: 2,
      State: 2,
      Pincode: 2,
      Country: 2,
      ImagePath: 2,
      Role: 3,
      BusinessName: 3,
      tnc: 3,
    };

    function clearServerError() {
      byId('serverError').classList.remove('show');
      byId('serverErrorText').textContent = '';
    }

    function showServerError(message) {
      byId('serverErrorText').textContent = message || 'Registration failed. Please try again.';
      byId('serverError').classList.add('show');
      byId('serverError').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function getFieldElement(name) {
      return byId(name) || document.querySelector(`[name="${name}"]`);
    }

    function showError(name, customText) {
      const field = getFieldElement(name);
      const error = byId(`error-${name}`);
      if (field) {
        field.classList.remove('is-valid');
        field.classList.add('is-invalid');
      }
      if (error) {
        error.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
        error.append(document.createTextNode(` ${customText || defaultErrorMessages[error.id] || 'Invalid input.'}`));
        error.classList.add('show');
      }
    }

    function clearError(name) {
      const field = getFieldElement(name);
      const error = byId(`error-${name}`);
      if (field) field.classList.remove('is-invalid');
      if (error) {
        error.classList.remove('show');
        error.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
        error.append(document.createTextNode(` ${defaultErrorMessages[error.id] || 'Invalid input.'}`));
      }
    }

    function setValid(name) {
      clearError(name);
      const field = getFieldElement(name);
      if (field) field.classList.add('is-valid');
    }

    function clearValid(name) {
      const field = getFieldElement(name);
      if (field) field.classList.remove('is-valid');
    }

    function validateAge18(dob) {
      if (!dob) return false;
      const birthDate = new Date(dob);
      if (Number.isNaN(birthDate.getTime())) return false;

      const today = new Date();
      let age = today.getFullYear() - birthDate.getFullYear();
      const m = today.getMonth() - birthDate.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age -= 1;
      return age >= 18;
    }

    function passwordScore(password) {
      let score = 0;
      const checks = {
        length: password.length >= 8,
        upper: /[A-Z]/.test(password),
        lower: /[a-z]/.test(password),
        number: /\d/.test(password),
        special: /[^A-Za-z0-9]/.test(password),
      };

      Object.values(checks).forEach((pass) => { if (pass) score += 1; });
      return { score, checks };
    }

    function updatePasswordStrength() {
      const password = byId('Password').value;
      const box = byId('strengthBox');
      const fill = byId('strengthFill');
      const label = byId('strengthLabel');

      if (!password) {
        box.style.display = 'none';
        fill.style.width = '0%';
        fill.style.backgroundColor = '#E5E7EB';
        return 0;
      }

      box.style.display = 'block';
      const { score, checks } = passwordScore(password);

      const map = [
        { color: '#EF4444', text: 'Weak' },
        { color: '#F59E0B', text: 'Fair' },
        { color: '#F59E0B', text: 'Fair' },
        { color: '#10B981', text: 'Strong' },
        { color: '#10B981', text: 'Strong' },
      ];

      const stepInfo = map[Math.max(score - 1, 0)] || { color: '#E5E7EB', text: 'Weak' };
      fill.style.width = `${(score / 5) * 100}%`;
      fill.style.backgroundColor = stepInfo.color;
      label.textContent = `Strength: ${stepInfo.text}`;
      label.style.color = stepInfo.color;

      const ruleMap = [
        ['rule-length', checks.length],
        ['rule-upper', checks.upper],
        ['rule-lower', checks.lower],
        ['rule-number', checks.number],
        ['rule-special', checks.special],
      ];

      ruleMap.forEach(([id, met]) => {
        byId(id).classList.toggle('met', met);
      });

      if (score >= 4) clearError('Password');
      return score;
    }

    function updateConfirmPasswordState() {
      const password = byId('Password').value;
      const confirm = byId('ConfirmPassword').value;
      const okState = byId('confirmOk');

      clearValid('ConfirmPassword');
      okState.classList.remove('show');

      if (!confirm) {
        clearError('ConfirmPassword');
        return false;
      }

      if (password === confirm) {
        setValid('ConfirmPassword');
        clearError('ConfirmPassword');
        okState.classList.add('show');
        return true;
      }

      showError('ConfirmPassword', 'Passwords do not match');
      return false;
    }

    function applyServerFieldErrors(fieldErrors) {
      if (!fieldErrors || typeof fieldErrors !== 'object') return;

      const entries = Object.entries(fieldErrors);
      if (!entries.length) return;

      const [firstField] = entries[0];
      const stepForFirstField = fieldStepMap[firstField];
      if (stepForFirstField && stepForFirstField !== currentStep) {
        currentStep = stepForFirstField;
        updateStepUI();
      }

      entries.forEach(([field, message]) => {
        showError(field, message);
      });
    }

    function updateStepUI() {
      document.querySelectorAll('.step-item').forEach((item) => {
        const step = Number(item.dataset.step);
        item.classList.toggle('active', step === currentStep);
        item.classList.toggle('done', step < currentStep);

        const circle = item.querySelector('.step-circle');
        if (step < currentStep) {
          circle.innerHTML = '<i class="fa-solid fa-check"></i>';
        } else if (step === 1) {
          circle.innerHTML = '<i class="fa-solid fa-user"></i>';
        } else if (step === 2) {
          circle.innerHTML = '<i class="fa-solid fa-id-card"></i>';
        } else {
          circle.innerHTML = '<i class="fa-solid fa-shield-halved"></i>';
        }
      });

      document.querySelectorAll('.step-panel').forEach((panel) => {
        panel.classList.toggle('active', Number(panel.dataset.step) === currentStep);
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function validateStep1() {
      let valid = true;

      const fullName = byId('FullName').value.trim();
      if (!nameRegex.test(fullName)) { showError('FullName'); valid = false; }
      else { setValid('FullName'); }

      const email = byId('Email').value.trim();
      if (!emailRegex.test(email)) { showError('Email'); valid = false; }
      else { setValid('Email'); }

      const mobile = byId('Mobile').value.trim();
      if (!mobileRegex.test(mobile)) { showError('Mobile'); valid = false; }
      else { setValid('Mobile'); }

      const strengthScore = updatePasswordStrength();
      if (strengthScore < 4) { showError('Password'); valid = false; }
      else { setValid('Password'); }

      const confirmOk = updateConfirmPasswordState();
      if (!confirmOk) {
        if (!byId('ConfirmPassword').value.trim()) {
          showError('ConfirmPassword', 'Passwords do not match');
        }
        valid = false;
      }

      return valid;
    }

    function validateStep2() {
      let valid = true;

      const dob = byId('DOB').value;
      if (!validateAge18(dob)) { showError('DOB'); valid = false; }
      else { setValid('DOB'); }

      const gender = byId('Gender').value;
      if (!gender) { showError('Gender'); valid = false; }
      else { setValid('Gender'); }

      const fatherName = byId('FatherName').value.trim();
      if (!nameRegex.test(fatherName)) { showError('FatherName'); valid = false; }
      else { setValid('FatherName'); }

      const motherName = byId('MotherName').value.trim();
      if (motherName && !nameRegex.test(motherName)) { showError('MotherName'); valid = false; }
      else {
        clearError('MotherName');
        if (motherName) setValid('MotherName');
      }

      const address = byId('Address').value.trim();
      if (address.length < 10) { showError('Address'); valid = false; }
      else { setValid('Address'); }

      const city = byId('City').value.trim();
      if (city.length < 2) { showError('City'); valid = false; }
      else { setValid('City'); }

      const state = byId('State').value;
      if (!state) { showError('State'); valid = false; }
      else { setValid('State'); }

      const pincode = byId('Pincode').value.trim();
      if (!pincodeRegex.test(pincode)) { showError('Pincode'); valid = false; }
      else { setValid('Pincode'); }

      return valid;
    }

    function validateStep3() {
      let valid = true;

      const role = byId('Role').value;
      if (!role) { showError('Role'); valid = false; }
      else { clearError('Role'); }

      if (role === 'merchant') {
        const businessName = byId('BusinessName').value.trim();
        if (businessName.length < 3 || businessName.length > 80) {
          showError('BusinessName');
          valid = false;
        } else {
          setValid('BusinessName');
        }
      } else {
        clearError('BusinessName');
        clearValid('BusinessName');
      }

      if (!byId('tnc').checked) {
        showError('tnc');
        valid = false;
      } else {
        clearError('tnc');
      }

      const photoField = byId('ImagePath');
      if (photoField.files && photoField.files[0]) {
        const file = photoField.files[0];
        const allowed = ['image/jpeg', 'image/png', 'image/webp'];
        if (!allowed.includes(file.type) || file.size > 5 * 1024 * 1024) {
          showError('ImagePath');
          valid = false;
        } else {
          clearError('ImagePath');
        }
      }

      return valid;
    }

    function goNext(step) {
      const validationMap = {
        1: validateStep1,
        2: validateStep2,
      };

      const validate = validationMap[step];
      if (!validate || !validate()) return;

      currentStep = Math.min(3, step + 1);
      updateStepUI();
    }

    function goPrev(step) {
      currentStep = Math.max(1, step - 1);
      updateStepUI();
    }

    function setupAccountTypeCards() {
      const cards = document.querySelectorAll('.account-card');
      const roleInput = byId('Role');
      const businessWrap = byId('businessWrap');
      const businessInput = byId('BusinessName');

      const activate = (value) => {
        cards.forEach((card) => {
          const selected = card.dataset.role === value;
          card.classList.toggle('selected', selected);
          card.setAttribute('aria-checked', String(selected));
        });

        roleInput.value = value;
        clearError('Role');

        if (value === 'merchant') {
          businessWrap.classList.add('show');
        } else {
          businessWrap.classList.remove('show');
          businessInput.value = '';
          clearError('BusinessName');
        }
      };

      cards.forEach((card) => {
        card.addEventListener('click', () => activate(card.dataset.role));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(card.dataset.role);
          }
        });
      });

      activate('user');
    }

    function setupPhotoUpload() {
      const box = byId('uploadBox');
      const input = byId('ImagePath');
      const preview = byId('photoPreview');

      const openPicker = () => input.click();
      box.addEventListener('click', openPicker);
      box.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openPicker();
        }
      });

      input.addEventListener('change', () => {
        clearError('ImagePath');
        const file = input.files && input.files[0];
        if (!file) {
          box.classList.remove('has-file');
          preview.style.display = 'none';
          preview.src = '';
          return;
        }

        const allowed = ['image/jpeg', 'image/png', 'image/webp'];
        if (!allowed.includes(file.type) || file.size > 5 * 1024 * 1024) {
          input.value = '';
          box.classList.remove('has-file');
          preview.style.display = 'none';
          preview.src = '';
          showError('ImagePath', 'File must be JPG/PNG under 5 MB');
          return;
        }

        const reader = new FileReader();
        reader.onload = (event) => {
          preview.src = event.target.result;
          preview.style.display = 'block';
          box.classList.add('has-file');
        };
        reader.readAsDataURL(file);
      });
    }

    function setupInputSanitizers() {
      byId('Mobile').addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10);
        clearError('Mobile');
      });

      byId('Pincode').addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6);
        clearError('Pincode');
      });
    }

    function setupBlurValidation() {
      const nameFields = ['FullName', 'FatherName', 'MotherName'];
      nameFields.forEach((fieldId) => {
        byId(fieldId).addEventListener('blur', (e) => {
          const value = e.target.value.trim();
          if (fieldId === 'MotherName' && !value) {
            clearError(fieldId);
            clearValid(fieldId);
            return;
          }
          if (!value || !nameRegex.test(value)) showError(fieldId);
          else setValid(fieldId);
        });
      });

      byId('Email').addEventListener('blur', (e) => {
        const value = e.target.value.trim();
        if (!value || !emailRegex.test(value)) showError('Email');
        else setValid('Email');
      });

      byId('Mobile').addEventListener('blur', (e) => {
        const value = e.target.value.trim();
        if (!value || !mobileRegex.test(value)) showError('Mobile');
        else setValid('Mobile');
      });

      byId('Pincode').addEventListener('blur', (e) => {
        const value = e.target.value.trim();
        if (!value || !pincodeRegex.test(value)) showError('Pincode');
        else setValid('Pincode');
      });

      byId('ConfirmPassword').addEventListener('blur', updateConfirmPasswordState);
    }

    function setupLiveFieldCorrections() {
      document.querySelectorAll('.input, .select, .textarea').forEach((el) => {
        el.addEventListener('input', () => {
          if (el.id) clearError(el.id);
        });
      });

      byId('Password').addEventListener('input', () => {
        updatePasswordStrength();
        if (byId('ConfirmPassword').value) updateConfirmPasswordState();
      });

      byId('ConfirmPassword').addEventListener('input', updateConfirmPasswordState);
    }

    function setupPasswordToggles() {
      document.querySelectorAll('.toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          const input = byId(targetId);
          const icon = btn.querySelector('i');
          const hidden = input.type === 'password';
          input.type = hidden ? 'text' : 'password';
          icon.className = hidden ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        });
      });
    }

    function setupStepNavigation() {
      byId('next1').addEventListener('click', () => goNext(1));
      byId('next2').addEventListener('click', () => goNext(2));
      byId('prev2').addEventListener('click', () => goPrev(2));
      byId('prev3').addEventListener('click', () => goPrev(3));
    }

    async function submitForm(event) {
      event.preventDefault();
      clearServerError();

      if (!validateStep3()) return;

      const submitBtn = byId('submitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating account…';

      try {
        const response = await fetch('/register-zenopay', {
          method: 'POST',
          body: new FormData(form),
        });

        const rawBody = await response.text();
        let result = null;
        try {
          result = rawBody ? JSON.parse(rawBody) : null;
        } catch (_) {
          result = null;
        }

        if (!response.ok) {
          applyServerFieldErrors(result?.fieldErrors);
          showServerError(result?.message || `Request failed (${response.status}). Please try again.`);
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fa-solid fa-user-tie"></i> Create Account';
          return;
        }

        if (!result?.success) {
          applyServerFieldErrors(result?.fieldErrors);
          showServerError(result?.message || 'Registration failed. Please try again.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fa-solid fa-user-tie"></i> Create Account';
          return;
        }

        form.style.display = 'none';
        stepper.style.display = 'none';
        byId('successScreen').classList.add('show');

        const successRedirect = result?.redirect || '/verify-email';
        let countdown = 3;
        const countdownNode = byId('countdown');
        const timer = setInterval(() => {
          countdown -= 1;
          countdownNode.textContent = countdown;
          if (countdown <= 0) {
            clearInterval(timer);
            window.location.href = successRedirect;
          }
        }, 1000);
      } catch (error) {
        showServerError(error?.message || 'Network issue. Please check your connection and try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-user-tie"></i> Create Account';
      }
    }

    function init() {
      setupStepNavigation();
      setupPasswordToggles();
      setupLiveFieldCorrections();
      setupInputSanitizers();
      setupBlurValidation();
      setupAccountTypeCards();
      setupPhotoUpload();

      byId('tnc').addEventListener('change', () => clearError('tnc'));
      form.addEventListener('submit', submitForm);

      updateStepUI();
    }

    init();
  </script>
</body>
</html>

