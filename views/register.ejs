                <p class="error-msg" id="error-Gender"><i class="fa-solid fa-circle-exclamation"></i> Please select your gender</p>
              </div>

              <div class="field">
                <label class="label" for="FatherName"><i class="fa-solid fa-user-tie"></i> Father's Name</label>
                <input class="input" id="FatherName" name="FatherName" type="text" placeholder="Father's full name" />
                <p class="error-msg" id="error-FatherName"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid father's name</p>
              </div>

              <div class="field">
                <label class="label" for="MotherName"><i class="fa-solid fa-user-nurse"></i> Mother's Name <span class="optional">(optional)</span></label>
                <input class="input" id="MotherName" name="MotherName" type="text" placeholder="Mother's full name (optional)" />
                <p class="error-msg" id="error-MotherName"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid mother's name</p>
              </div>

              <div class="field full-width">
                <label class="label" for="Address"><i class="fa-solid fa-house"></i> Full Address</label>
                <textarea class="textarea" id="Address" name="Address" placeholder="House/Flat No., Street, Area, Landmark"></textarea>
