<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account — ZenoPay</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary-blue: #3B82F6;
      --primary-dark: #2563EB;
      --gradient-start: #1E3A8A;
      --gradient-end: #5B21B6;
      --success: #10B981;
      --error: #EF4444;
      --warning: #F59E0B;
      --text-dark: #1F2937;
      --text-light: #6B7280;
      --text-muted: #9CA3AF;
      --border: #E5E7EB;
      --bg: #F3F4F6;
      --card: #FFFFFF;
      --input-bg: #F9FAFB;
      --radius-card: 14px;
      --radius-ui: 9px;
      --shadow: 0 4px 12px rgba(0,0,0,.10);
      --ease: all 0.2s ease;
    }

    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text-dark);
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
      line-height: 1.45;
    }

    .layout {
      min-height: 100vh;
      display: flex;
      align-items: stretch;
    }

    /* Left panel */
    .left-panel {
      flex: 0 0 40%;
      min-width: 380px;
      height: 100vh;
      position: sticky;
      top: 0;
      overflow: hidden;
      background: linear-gradient(145deg, var(--gradient-start), #2563EB 52%, var(--gradient-end));
      color: #fff;
      padding: 36px 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .left-panel::before,
    .left-panel::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,.15);
      pointer-events: none;
      z-index: 0;
    }

    .left-panel::before { width: 280px; height: 280px; top: -80px; right: -70px; }
    .left-panel::after { width: 220px; height: 220px; bottom: 42px; left: -80px; }

    .left-content, .left-top, .left-bottom { position: relative; z-index: 1; }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(255,255,255,.16);
      border: 1px solid rgba(255,255,255,.25);
      display: grid;
      place-items: center;
      font-size: 21px;
      font-weight: 800;
    }

    .brand-name { font-size: 22px; font-weight: 800; letter-spacing: -.2px; }
    .beta-badge {
      margin-left: 4px;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: .7px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.25);
      background: rgba(255,255,255,.12);
    }

    .hero-title {
      margin-top: 42px;
      font-size: 28px;
      line-height: 1.25;
      font-weight: 800;
    }

    .hero-sub {
      margin-top: 10px;
      font-size: 14.5px;
      color: rgba(255,255,255,.78);
      max-width: 95%;
    }

    .feature-list {
      margin-top: 30px;
      display: grid;
      gap: 12px;
    }

    .feature-card {
      border-radius: 12px;
      padding: 13px 14px;
      border: 1px solid rgba(255,255,255,.22);
      background: rgba(255,255,255,.10);
      backdrop-filter: blur(2px);
      display: flex;
      gap: 10px;
      align-items: flex-start;
      transition: var(--ease);
    }

    .feature-card:hover { transform: translateY(-2px); }

    .feature-icon {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: rgba(255,255,255,.18);
      display: grid;
      place-items: center;
      font-size: 14px;
      flex-shrink: 0;
    }

    .feature-title { font-size: 13px; font-weight: 700; }
    .feature-desc { font-size: 11.8px; color: rgba(255,255,255,.75); margin-top: 2px; }

    .stats-line {
      margin-top: 20px;
      font-size: 12.2px;
      color: rgba(255,255,255,.86);
      border-top: 1px solid rgba(255,255,255,.20);
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Right panel */
    .right-panel {
      flex: 0 0 60%;
      min-width: 0;
      padding: 36px 44px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .back-link {
      width: fit-content;
      text-decoration: none;
      color: var(--text-light);
      font-size: 13.5px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: var(--ease);
      margin-bottom: 18px;
    }

    .back-link:hover { color: var(--primary-blue); }

    .page-title { font-size: 26px; font-weight: 800; color: var(--text-dark); }

    .page-sub {
      margin-top: 5px;
      margin-bottom: 24px;
      color: var(--text-light);
      font-size: 14px;
    }

    .stepper {
      display: flex;
      align-items: flex-start;
      margin-bottom: 20px;
      user-select: none;
    }

    .step-item {
      flex: 1;
      text-align: center;
      position: relative;
    }

    .step-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      margin: 0 auto;
      border: 1.5px solid var(--border);
      background: #fff;
      color: var(--text-muted);
      display: grid;
      place-items: center;
      font-size: 13px;
      transition: var(--ease);
      position: relative;
      z-index: 2;
    }

    .step-label {
      margin-top: 6px;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      transition: var(--ease);
    }

    .step-item .connector {
      position: absolute;
      top: 17px;
      left: calc(50% + 18px);
      width: calc(100% - 36px);
      height: 2px;
      background: var(--border);
      z-index: 1;
      transition: var(--ease);
    }

    .step-item:last-child .connector { display: none; }

    .step-item.active .step-circle {
      background: var(--primary-blue);
      color: #fff;
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 4px rgba(59,130,246,.18);
    }

    .step-item.active .step-label { color: var(--primary-blue); }

    .step-item.done .step-circle {
      background: var(--success);
      border-color: var(--success);
      color: #fff;
    }

    .step-item.done .step-label { color: var(--success); }
    .step-item.done .connector { background: var(--success); }

    .form-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow);
      padding: 26px;
      position: relative;
    }

    .server-error {
      display: none;
      margin-bottom: 14px;
      border-radius: 9px;
      border: 1.5px solid #FECACA;
      background: #FEF2F2;
      color: var(--error);
      padding: 10px 12px;
      font-size: 13px;
      align-items: center;
      gap: 8px;
    }

    .server-error.show { display: flex; }

    .step-panel { display: none; }
    .step-panel.active { display: block; animation: slideUp .3s ease; }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-6px); max-height: 0; }
      to { opacity: 1; transform: translateY(0); max-height: 160px; }
    }

    .step-heading {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 3px;
    }

    .step-subtitle {
      font-size: 12.8px;
      color: var(--text-light);
      margin-bottom: 18px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .full-width { grid-column: 1 / -1; }

    .field { display: flex; flex-direction: column; gap: 6px; }

    .label {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-dark);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .label i { color: var(--primary-blue); font-size: 11px; }

    .optional {
      font-weight: 500;
      color: var(--text-muted);
      font-size: 11.5px;
    }

    .input,
    .select,
    .textarea {
      width: 100%;
      border-radius: var(--radius-ui);
      border: 1.5px solid var(--border);
      background: var(--input-bg);
      color: var(--text-dark);
      font: 400 13.5px 'Inter', 'Segoe UI', system-ui, sans-serif;
      padding: 11px 12px;
      transition: var(--ease);
    }

    .textarea { min-height: 80px; resize: vertical; }

    .input::placeholder,
    .textarea::placeholder {
      color: var(--text-muted);
      font-size: 12.5px;
    }

    .input:focus,
    .select:focus,
    .textarea:focus,
    .country-code:focus {
      outline: none;
      border-color: var(--primary-blue);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(59,130,246,.12);
    }

    .is-valid {
      border-color: var(--success) !important;
      background: #F0FDF4 !important;
    }

    .is-invalid {
      border-color: var(--error) !important;
      background: #FFF5F5 !important;
      box-shadow: 0 0 0 3px rgba(239,68,68,.10);
    }

    .error-msg {
      font-size: 11.5px;
      color: var(--error);
      display: none;
      align-items: center;
      gap: 5px;
    }

    .error-msg.show { display: flex; }

    .phone-wrap {
      display: grid;
      grid-template-columns: 112px 1fr;
      gap: 8px;
    }

    .country-code {
      border-radius: var(--radius-ui);
      border: 1.5px solid var(--border);
      background: var(--input-bg);
      font-size: 13px;
      padding: 0 8px;
      transition: var(--ease);
    }

    .input-wrap { position: relative; }
    .input-wrap .input { padding-right: 42px; }

    .toggle-btn {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      border: 0;
      background: transparent;
      color: var(--text-muted);
      width: 28px;
      height: 28px;
      border-radius: 7px;
      cursor: pointer;
      transition: var(--ease);
    }

    .toggle-btn:hover { color: var(--primary-blue); background: #EFF6FF; }

    .strength-box { margin-top: 8px; display: none; }

    .strength-track {
      height: 4px;
      border-radius: 999px;
      background: var(--border);
      overflow: hidden;
      margin-bottom: 8px;
    }

    .strength-fill {
      width: 0;
      height: 100%;
      transition: width .3s ease, background-color .3s ease;
    }

    .strength-label {
      font-size: 11.5px;
      font-weight: 600;
      margin-bottom: 4px;
      color: var(--text-light);
    }

    .rules {
      display: grid;
      gap: 4px;
    }

    .rule {
      font-size: 11.5px;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .rule i { font-size: 10px; }

    .rule.met {
      color: var(--success);
      font-weight: 500;
    }

    .rule.met i::before { content: '\f00c'; }

    .confirm-ok {
      font-size: 11.5px;
      color: var(--success);
      display: none;
      align-items: center;
      gap: 5px;
    }

    .confirm-ok.show { display: inline-flex; }

    .upload-box {
      border: 2px dashed var(--border);
      border-radius: 11px;
      padding: 18px;
      text-align: center;
      cursor: pointer;
      transition: var(--ease);
      background: #fff;
    }

    .upload-box:hover {
      border-color: var(--primary-blue);
      background: #EFF6FF;
    }

    .upload-box.has-file {
      border-color: var(--success);
      background: #F0FDF4;
    }

    .upload-icon {
      font-size: 28px;
      color: var(--primary-blue);
      margin-bottom: 4px;
    }

    .upload-title { font-size: 13px; color: var(--text-light); }
    .upload-help { font-size: 11.5px; color: var(--text-muted); }

    .photo-preview {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      margin: 10px auto 0;
      border: 3px solid var(--success);
      display: none;
    }

    .account-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .account-card {
      border: 1.5px solid var(--border);
      border-radius: 12px;
      background: #fff;
      padding: 14px;
      cursor: pointer;
      transition: var(--ease);
      position: relative;
    }

    .account-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }

    .account-card .check-badge {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 19px;
      height: 19px;
      border-radius: 50%;
      background: var(--primary-blue);
      color: #fff;
      font-size: 11px;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .account-card i {
      color: var(--primary-blue);
      font-size: 22px;
      margin-bottom: 8px;
    }

    .account-title { font-size: 14px; font-weight: 700; color: var(--text-dark); }
    .account-desc { font-size: 12px; color: var(--text-light); margin-top: 2px; }

    .account-card.selected {
      border: 2px solid var(--primary-blue);
      background: #EFF6FF;
    }

    .account-card.selected .check-badge { display: inline-flex; }

    .business-wrap {
      display: none;
      margin-top: 2px;
    }

    .business-wrap.show {
      display: block;
      animation: slideDown .25s ease;
    }

    .tnc-box {
      border: 1.5px solid var(--border);
      background: var(--input-bg);
      border-radius: 9px;
      padding: 12px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13px;
      color: var(--text-light);
    }

    .tnc-box input[type="checkbox"] {
      width: 16px;
      height: 16px;
      margin-top: 2px;
      accent-color: var(--primary-blue);
      flex-shrink: 0;
    }

    .tnc-box a {
      color: var(--primary-blue);
      text-decoration: underline;
      font-weight: 600;
    }

    .btn-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 22px;
    }

    .btn {
      border: 0;
      border-radius: 9px;
      font-size: 14px;
      font-weight: 600;
      padding: 11px 24px;
      cursor: pointer;
      transition: var(--ease);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: inherit;
    }

    .btn-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      box-shadow: 0 3px 10px rgba(59,130,246,.32);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 7px 18px rgba(59,130,246,.34);
    }

    .btn-primary:disabled {
      opacity: .55;
      cursor: not-allowed;
      transform: none;
      box-shadow: 0 3px 10px rgba(59,130,246,.24);
    }

    .btn-ghost {
      color: #374151;
      background: #fff;
      border: 1.5px solid var(--border);
    }

    .btn-ghost:hover {
      border-color: var(--primary-blue);
      color: var(--primary-blue);
      background: #EFF6FF;
    }

    .btn-right { margin-left: auto; }
    .btn-full { width: 100%; }

    .success {
      display: none;
      text-align: center;
      padding: 38px 10px;
    }

    .success.show {
      display: block;
      animation: slideUp .4s ease;
    }

    .success-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      margin: 0 auto 16px;
      background: linear-gradient(135deg, #10B981, #059669);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 31px;
      box-shadow: 0 10px 22px rgba(16,185,129,.30);
    }

    .success-title { font-size: 22px; font-weight: 800; color: var(--text-dark); }
    .success-sub { margin-top: 5px; font-size: 14px; color: var(--text-light); }
    .success-count { margin-top: 9px; font-size: 13px; color: var(--text-muted); }

    .trust-row {
      margin-top: 15px;
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .trust-item {
      font-size: 11.5px;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .trust-item i { color: var(--success); }

    .login-row {
      margin-top: 12px;
      text-align: center;
      font-size: 13.5px;
      color: var(--text-light);
    }

    .login-row a {
      color: var(--primary-blue);
      text-decoration: none;
      font-weight: 600;
    }

    .login-row a:hover { text-decoration: underline; }

    @media (max-width: 900px) {
      .left-panel { display: none; }
      .right-panel { flex: 1; padding: 28px 24px; }
      .form-card { padding: 22px; }
    }

    @media (max-width: 500px) {
      .right-panel { padding: 20px 16px; }
      .grid,
      .account-cards,
      .phone-wrap {
        grid-template-columns: 1fr;
      }

      .btn-row {
        flex-direction: column;
      }

      .btn-right { margin-left: 0; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="left-panel" aria-hidden="true">
      <div class="left-top">
        <div class="brand">
          <div class="brand-icon">Z</div>
          <div>
            <span class="brand-name">ZenoPay</span>
            <span class="beta-badge">Beta</span>
          </div>
        </div>
      </div>

      <div class="left-content">
        <h2 class="hero-title">Your Gateway to Seamless Payments</h2>
        <p class="hero-sub">Join thousands of users who trust ZenoPay to move money securely, instantly, and transparently.</p>

        <div class="feature-list">
          <article class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
            <div>
              <div class="feature-title">Bank-Level Security</div>
              <div class="feature-desc">256-bit encryption on all data</div>
            </div>
          </article>

          <article class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-bolt" aria-hidden="true"></i></div>
            <div>
              <div class="feature-title">Instant Transfers</div>
              <div class="feature-desc">Send money in seconds, not hours</div>
            </div>
          </article>

          <article class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-tags" aria-hidden="true"></i></div>
            <div>
              <div class="feature-title">Zero Hidden Fees</div>
              <div class="feature-desc">Transparent pricing, no surprises</div>
            </div>
          </article>
        </div>
      </div>

      <div class="left-bottom">
        <div class="stats-line">
          <span>1M+ Active Users</span>
          <span>|</span>
          <span>₹10B+ Processed</span>
          <span>|</span>
          <span>99.9% Uptime</span>
        </div>
      </div>
    </aside>

    <main class="right-panel">
      <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Home</a>

      <h1 class="page-title">Create Your Account</h1>
      <p class="page-sub">Start your journey with ZenoPay today — takes less than 3 minutes</p>

      <div class="stepper" id="stepper" aria-label="Signup steps">
        <div class="step-item active" data-step="1">
          <div class="step-circle"><i class="fa-solid fa-user"></i></div>
          <div class="step-label">Quick Signup</div>
          <span class="connector"></span>
        </div>
        <div class="step-item" data-step="2">
          <div class="step-circle"><i class="fa-solid fa-id-card"></i></div>
          <div class="step-label">Your Profile</div>
          <span class="connector"></span>
        </div>
        <div class="step-item" data-step="3">
          <div class="step-circle"><i class="fa-solid fa-shield-halved"></i></div>
          <div class="step-label">Account Type</div>
        </div>
      </div>

      <section class="form-card" aria-live="polite">
        <div class="server-error" id="serverError">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span id="serverErrorText">Something went wrong.</span>
        </div>

        <form id="registerForm" action="/register-zenopay" method="POST" enctype="multipart/form-data" novalidate>
          <!-- Step 1 -->
          <section class="step-panel active" data-step="1">
            <h2 class="step-heading">Let's Get Started</h2>
            <p class="step-subtitle">Your basic account credentials</p>

            <div class="grid">
              <div class="field full-width">
                <label class="label" for="FullName"><i class="fa-solid fa-id-card"></i> Full Name</label>
                <input class="input" id="FullName" name="FullName" type="text" placeholder="As on your official ID (e.g. Rahul Kumar Sharma)" autocomplete="name" />
                <p class="error-msg" id="error-FullName"><i class="fa-solid fa-circle-exclamation"></i> Enter your full name (letters only, 3–60 chars)</p>
              </div>

              <div class="field">
                <label class="label" for="Email"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input class="input" id="Email" name="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                <p class="error-msg" id="error-Email"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid email address</p>
              </div>

              <div class="field">
                <label class="label" for="Mobile"><i class="fa-solid fa-mobile-screen"></i> Mobile Number</label>
                <div class="phone-wrap">
                  <select class="country-code" id="MobileCode" aria-label="Country code">
                    <option value="+91" selected>+91</option>
                    <option value="+1">+1</option>
                    <option value="+44">+44</option>
                    <option value="+971">+971</option>
                    <option value="+61">+61</option>
                  </select>
                  <input class="input" id="Mobile" name="Mobile" type="text" inputmode="numeric" maxlength="10" placeholder="10-digit number" autocomplete="tel-national" />
                </div>
                <p class="error-msg" id="error-Mobile"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid 10-digit mobile number</p>
              </div>

              <div class="field full-width">
                <label class="label" for="referralCode"><i class="fa-solid fa-gift"></i> Have a referral code? <span class="optional">(optional)</span></label>
                <input class="input" id="referralCode" name="referralCode" type="text" placeholder="Enter referral code" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>" />
              </div>

              <div class="field full-width">
                <label class="label" for="Password"><i class="fa-solid fa-key"></i> Password</label>
                <div class="input-wrap">
                  <input class="input" id="Password" name="Password" type="password" placeholder="Create a strong password" autocomplete="new-password" />
                  <button class="toggle-btn" type="button" data-target="Password" aria-label="Toggle password visibility">
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>

                <div class="strength-box" id="strengthBox">
                  <div class="strength-track">
                    <div class="strength-fill" id="strengthFill"></div>
                  </div>
                  <div class="strength-label" id="strengthLabel">Strength: Weak</div>

                  <div class="rules">
                    <div class="rule" id="rule-length"><i class="fa-solid fa-circle"></i> At least 8 characters</div>
                    <div class="rule" id="rule-upper"><i class="fa-solid fa-circle"></i> One uppercase letter (A–Z)</div>
                    <div class="rule" id="rule-lower"><i class="fa-solid fa-circle"></i> One lowercase letter (a–z)</div>
                    <div class="rule" id="rule-number"><i class="fa-solid fa-circle"></i> One number (0–9)</div>
                    <div class="rule" id="rule-special"><i class="fa-solid fa-circle"></i> One special character (!@#$%^&*)</div>
                  </div>
                </div>

                <p class="error-msg" id="error-Password"><i class="fa-solid fa-circle-exclamation"></i> Password must meet all requirements above</p>
              </div>

              <div class="field full-width">
                <label class="label" for="ConfirmPassword"><i class="fa-solid fa-lock"></i> Confirm Password</label>
                <div class="input-wrap">
                  <input class="input" id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="Re-enter your password" autocomplete="new-password" />
                  <button class="toggle-btn" type="button" data-target="ConfirmPassword" aria-label="Toggle confirm password visibility">
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>
                <p class="confirm-ok" id="confirmOk"><i class="fa-solid fa-check"></i> Passwords match</p>
                <p class="error-msg" id="error-ConfirmPassword"><i class="fa-solid fa-circle-exclamation"></i> Passwords do not match</p>
              </div>
            </div>

            <div class="btn-row">
              <button class="btn btn-primary btn-right" type="button" id="next1">Next <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </section>

          <!-- Step 2 -->
          <section class="step-panel" data-step="2">
            <h2 class="step-heading">Complete Your Profile</h2>
            <p class="step-subtitle">Personal details for your account records</p>

            <div class="grid">
              <div class="field">
                <label class="label" for="DOB"><i class="fa-solid fa-calendar-days"></i> Date of Birth</label>
