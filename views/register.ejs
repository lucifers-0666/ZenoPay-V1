              <div class="field">
                <label class="label" for="Pincode"><i class="fa-solid fa-map-pin"></i> Pincode</label>
                <input class="input" id="Pincode" name="Pincode" type="text" inputmode="numeric" maxlength="6" placeholder="6-digit pincode" />
                <p class="error-msg" id="error-Pincode"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid 6-digit pincode</p>
