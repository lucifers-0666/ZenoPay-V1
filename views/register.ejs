              <div class="field">
                <label class="label" for="Country"><i class="fa-solid fa-globe"></i> Country</label>
                <select class="select" id="Country" name="Country">
                  <option value="India" selected>India</option>
                  <option value="USA">USA</option>
                  <option value="UK">UK</option>
                  <option value="UAE">UAE</option>
                  <option value="Australia">Australia</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="field full-width">
                <label class="label" for="ImagePath"><i class="fa-solid fa-camera"></i> Profile Photo <span class="optional">(optional)</span></label>
                <div class="upload-box" id="uploadBox" role="button" tabindex="0" aria-label="Upload profile photo">
                  <div class="upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                  <div class="upload-title">Click to upload your photo</div>
                  <div class="upload-help">JPG, PNG up to 5 MB</div>
                  <img src="" alt="Uploaded profile preview" id="photoPreview" class="photo-preview" />
