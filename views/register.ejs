<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account — ZenoPay</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary:        #3B82F6;
      --primary-dark:   #2563EB;
      --grad-start:     #1E3A8A;
      --grad-end:       #5B21B6;
      --success:        #10B981;
      --error:          #EF4444;
      --warning:        #F59E0B;
      --text-dark:      #1F2937;
      --text-mid:       #374151;
      --text-light:     #6B7280;
      --text-muted:     #9CA3AF;
      --border:         #E5E7EB;
      --border-focus:   #3B82F6;
      --bg-page:        #F3F4F6;
      --bg-card:        #FFFFFF;
      --bg-input:       #F9FAFB;
      --shadow-sm:      0 1px 3px rgba(0,0,0,.08);
      --shadow-md:      0 4px 12px rgba(0,0,0,.10);
      --shadow-lg:      0 10px 32px rgba(0,0,0,.12);
      --radius:         14px;
      --ease:           0.2s ease;
    }

    body {
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
      background: var(--bg-page);
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      align-items: stretch;
    }

    /* ── SPLIT LAYOUT ── */
    .reg-wrap {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }

    /* LEFT PANEL */
    .reg-left {
      width: 420px;
      flex-shrink: 0;
      background: linear-gradient(145deg, var(--grad-start) 0%, #2563EB 50%, var(--grad-end) 100%);
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .reg-left::before,
    .reg-left::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      opacity: .15;
    }
    .reg-left::before { width: 320px; height: 320px; background: #fff; top: -80px; right: -80px; }
    .reg-left::after  { width: 200px; height: 200px; background: #fff; bottom: 60px; left: -60px; }

    .brand { display: flex; align-items: center; gap: 12px; position: relative; z-index: 2; }
    .brand-logo {
      width: 46px; height: 46px;
      background: rgba(255,255,255,.2);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; color: #fff; font-weight: 900;
    }
    .brand-name { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -.3px; }
    .brand-badge {
      font-size: 9px; font-weight: 700; background: rgba(255,255,255,.25);
      color: #fff; padding: 2px 7px; border-radius: 20px; text-transform: uppercase;
      letter-spacing: .6px; margin-left: 6px;
    }

    .left-content { position: relative; z-index: 2; }
    .left-title { font-size: 28px; font-weight: 800; color: #fff; line-height: 1.3; margin-bottom: 12px; }
    .left-subtitle { font-size: 14.5px; color: rgba(255,255,255,.78); line-height: 1.6; margin-bottom: 32px; }

    .feature-list { display: flex; flex-direction: column; gap: 14px; }
    .feature-item {
      display: flex; align-items: flex-start; gap: 14px;
      background: rgba(255,255,255,.1);
      border-radius: 12px; padding: 14px 16px;
    }
    .feature-icon {
      width: 38px; height: 38px; flex-shrink: 0;
      background: rgba(255,255,255,.18);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; color: #fff;
    }
    .feature-text { flex: 1; }
    .feature-title  { font-size: 13.5px; font-weight: 700; color: #fff; margin-bottom: 2px; }
    .feature-desc   { font-size: 12px; color: rgba(255,255,255,.65); }

    .stats-row { display: flex; gap: 0; position: relative; z-index: 2; }
    .stat-item { flex: 1; text-align: center; }
    .stat-item + .stat-item { border-left: 1px solid rgba(255,255,255,.2); }
    .stat-num { font-size: 20px; font-weight: 800; color: #fff; }
    .stat-label { font-size: 10.5px; color: rgba(255,255,255,.6); text-transform: uppercase; letter-spacing: .6px; margin-top: 2px; }

    /* RIGHT PANEL */
    .reg-right {
      flex: 1;
      overflow-y: auto;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
    }

    .back-link {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 13.5px; font-weight: 500; color: var(--text-light);
      text-decoration: none; margin-bottom: 36px;
      transition: color var(--ease);
    }
    .back-link:hover { color: var(--primary); }

    .page-title    { font-size: 26px; font-weight: 800; color: var(--text-dark); margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: var(--text-light); margin-bottom: 28px; }

    /* STEP INDICATOR */
    .steps-bar {
      display: flex; align-items: center; gap: 0;
      margin-bottom: 32px;
    }
    .step-node {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      flex: 1; position: relative;
    }
    .step-node:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 18px; left: calc(50% + 18px);
      width: calc(100% - 36px);
      height: 2px;
      background: var(--border);
      transition: background var(--ease);
    }
    .step-node.done:not(:last-child)::after { background: var(--success); }
    .step-node.active:not(:last-child)::after { background: var(--border); }

    .step-circle {
      width: 36px; height: 36px; border-radius: 50%;
      border: 2px solid var(--border);
      background: var(--bg-card);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: var(--text-muted);
      transition: all var(--ease);
      position: relative; z-index: 1;
    }
    .step-node.active .step-circle {
      border-color: var(--primary); background: var(--primary); color: #fff;
      box-shadow: 0 0 0 4px rgba(59,130,246,.18);
    }
    .step-node.done .step-circle {
      border-color: var(--success); background: var(--success); color: #fff;
    }
    .step-label {
      font-size: 11px; font-weight: 600; color: var(--text-muted);
      white-space: nowrap; transition: color var(--ease);
    }
    .step-node.active .step-label { color: var(--primary); }
    .step-node.done .step-label   { color: var(--success); }

    /* FORM CARD */
    .form-card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      padding: 32px;
      flex: 1;
    }

    .form-step { display: none; }
    .form-step.active { display: block; animation: slideUp .3s ease; }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .step-heading { font-size: 18px; font-weight: 700; color: var(--text-dark); margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
    .step-heading i { color: var(--primary); font-size: 17px; }
    .step-sub { font-size: 13px; color: var(--text-light); margin-bottom: 24px; }

    /* FORM GRID */
    .fg { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 24px; }
    .fg-full { grid-column: 1 / -1; }

    /* FORM GROUP */
    .fgroup { display: flex; flex-direction: column; gap: 5px; }
    .flabel {
      font-size: 12.5px; font-weight: 600; color: var(--text-mid);
      display: flex; align-items: center; gap: 5px;
    }
    .flabel i { color: var(--primary); font-size: 11px; }
    .req { color: var(--error); }

    .finput, .fselect, .ftextarea {
      padding: 10px 14px;
      border: 1.5px solid var(--border);
      border-radius: 9px;
      font-size: 13.5px;
      background: var(--bg-input);
      color: var(--text-dark);
      font-family: inherit;
      transition: border-color var(--ease), box-shadow var(--ease), background var(--ease);
      width: 100%;
    }
    .finput:focus, .fselect:focus, .ftextarea:focus {
      outline: none;
      border-color: var(--border-focus);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(59,130,246,.12);
    }
    .finput.is-error, .fselect.is-error, .ftextarea.is-error {
      border-color: var(--error);
      background: #FFF5F5;
      box-shadow: 0 0 0 3px rgba(239,68,68,.10);
    }
    .finput.is-ok, .fselect.is-ok {
      border-color: var(--success);
      background: #F0FDF4;
    }
    .finput::placeholder, .ftextarea::placeholder { color: var(--text-muted); font-size: 13px; }
    .ftextarea { resize: vertical; min-height: 80px; }

    .ferr {
      font-size: 11.5px; color: var(--error);
      display: none; align-items: center; gap: 4px;
    }
    .ferr.show { display: flex; }
    .ferr i { font-size: 11px; }

    .fhint { font-size: 11.5px; color: var(--text-muted); }

    /* PASSWORD INPUT WRAPPER */
    .pw-wrap { position: relative; }
    .pw-wrap .finput { padding-right: 42px; }
    .pw-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 15px;
      transition: color var(--ease);
    }
    .pw-toggle:hover { color: var(--primary); }

    /* PASSWORD STRENGTH */
    .pw-strength { margin-top: 8px; }
    .pw-bar-track {
      height: 4px; border-radius: 4px; background: var(--border); overflow: hidden; margin-bottom: 6px;
    }
    .pw-bar-fill {
      height: 100%; border-radius: 4px; width: 0%;
      transition: width .3s ease, background .3s ease;
    }
    .pw-rules { display: flex; flex-direction: column; gap: 3px; }
    .pw-rule {
      font-size: 11.5px; color: var(--text-muted);
      display: flex; align-items: center; gap: 6px;
    }
    .pw-rule i { font-size: 10px; }
    .pw-rule.met { color: var(--success); }
    .pw-rule.met i::before { content: '\f00c'; }

    /* PHONE COMBO */
    .phone-combo { display: flex; gap: 8px; }
    .phone-code {
      width: 100px; flex-shrink: 0;
      padding: 10px 10px;
      border: 1.5px solid var(--border);
      border-radius: 9px;
      font-size: 13px;
      background: var(--bg-input);
      color: var(--text-dark);
      font-family: inherit;
      transition: border-color var(--ease), box-shadow var(--ease);
    }
    .phone-code:focus {
      outline: none; border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(59,130,246,.12); background: #fff;
    }

    /* PHOTO UPLOAD */
    .photo-drop {
      border: 2px dashed var(--border);
      border-radius: 10px; padding: 24px;
      text-align: center; cursor: pointer;
      transition: border-color var(--ease), background var(--ease);
      position: relative;
    }
    .photo-drop:hover { border-color: var(--primary); background: #EFF6FF; }
    .photo-drop.has-file { border-color: var(--success); background: #F0FDF4; }
    .photo-drop i { font-size: 28px; color: var(--primary); margin-bottom: 8px; }
    .photo-drop p { font-size: 13px; color: var(--text-light); }
    .photo-drop small { font-size: 11.5px; color: var(--text-muted); }
    .photo-preview {
      width: 80px; height: 80px; border-radius: 50%;
      object-fit: cover; margin: 12px auto 0;
      display: none; border: 3px solid var(--success);
    }

    /* T&C */
    .tnc-row {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 13px; color: var(--text-light);
      padding: 14px; border-radius: 9px;
      background: var(--bg-input); border: 1.5px solid var(--border);
      margin-top: 4px;
    }
    .tnc-row input[type="checkbox"] { margin-top: 2px; accent-color: var(--primary); width: 15px; height: 15px; flex-shrink: 0; }
    .tnc-row a { color: var(--primary); font-weight: 600; text-decoration: none; }
    .tnc-row a:hover { text-decoration: underline; }

    /* BUTTONS */
    .fbtn-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 28px; }
    .fbtn {
      padding: 11px 24px; border-radius: 9px;
      font-size: 14px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      border: none; transition: all var(--ease); font-family: inherit;
    }
    .fbtn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: #fff; box-shadow: 0 3px 10px rgba(59,130,246,.32);
    }
    .fbtn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(59,130,246,.38); }
    .fbtn-primary:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    .fbtn-ghost {
      background: #fff; color: var(--text-mid);
      border: 1.5px solid var(--border);
    }
    .fbtn-ghost:hover { border-color: var(--primary); color: var(--primary); background: #EFF6FF; }
    .fbtn-ghost:disabled { opacity: .4; cursor: not-allowed; }
    .fbtn-full { width: 100%; justify-content: center; }

    /* TRUST ROW */
    .trust-row {
      display: flex; align-items: center; justify-content: center;
      gap: 20px; margin-top: 20px;
    }
    .trust-item { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--text-muted); }
    .trust-item i { color: var(--success); font-size: 12px; }

    /* ALREADY HAVE ACCOUNT */
    .login-link-row { text-align: center; font-size: 13.5px; color: var(--text-light); margin-top: 16px; }
    .login-link-row a { color: var(--primary); font-weight: 600; text-decoration: none; }
    .login-link-row a:hover { text-decoration: underline; }

    /* GLOBAL SERVER ERROR */
    .server-err {
      background: #FEF2F2; border: 1.5px solid #FECACA;
      border-radius: 9px; padding: 12px 16px;
      color: var(--error); font-size: 13.5px;
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 18px; display: none;
    }
    .server-err.show { display: flex; }

    /* SUCCESS */
    .success-screen {
      display: none; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 60px 24px;
    }
    .success-screen.show { display: flex; animation: slideUp .4s ease; }
    .success-icon {
      width: 80px; height: 80px; border-radius: 50%;
      background: linear-gradient(135deg, var(--success), #059669);
      display: flex; align-items: center; justify-content: center;
      font-size: 36px; color: #fff; margin-bottom: 20px;
      box-shadow: 0 8px 24px rgba(16,185,129,.3);
    }
    .success-screen h3 { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
    .success-screen p  { font-size: 14px; color: var(--text-light); }
    .success-redirect  { font-size: 13px; color: var(--text-muted); margin-top: 12px; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .reg-left { display: none; }
      .reg-right { padding: 32px 24px; }
      .fg { grid-template-columns: 1fr; }
    }
    @media (max-width: 500px) {
      .reg-right { padding: 24px 16px; }
      .form-card { padding: 20px; }
    }
  </style>
</head>
<body>

<div class="reg-wrap">

  <!-- ══ LEFT PANEL ══ -->
  <div class="reg-left">
    <div class="brand">
      <div class="brand-logo">Z</div>
      <div>
        <span class="brand-name">ZenoPay</span>
        <span class="brand-badge">Beta</span>
      </div>
    </div>

    <div class="left-content">
      <h2 class="left-title">Your Gateway to Seamless Payments</h2>
      <p class="left-subtitle">Join thousands of users who trust ZenoPay for secure, fast, and reliable digital transactions.</p>
      <div class="feature-list">
        <div class="feature-item">
          <div class="feature-icon"><i class="fas fa-shield-halved"></i></div>
          <div class="feature-text">
            <div class="feature-title">Bank-Level Security</div>
            <div class="feature-desc">256-bit encryption on all data</div>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fas fa-bolt"></i></div>
          <div class="feature-text">
            <div class="feature-title">Instant Transfers</div>
            <div class="feature-desc">Send money in seconds, not hours</div>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fas fa-tags"></i></div>
          <div class="feature-text">
            <div class="feature-title">Zero Hidden Fees</div>
            <div class="feature-desc">Transparent pricing, no surprises</div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-item">
        <div class="stat-num">1M+</div>
        <div class="stat-label">Active Users</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">₹10B+</div>
        <div class="stat-label">Processed</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">99.9%</div>
        <div class="stat-label">Uptime</div>
      </div>
    </div>
  </div>

  <!-- ══ RIGHT PANEL ══ -->
  <div class="reg-right">
    <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Back to Home</a>

    <h1 class="page-title">Create Your Account</h1>
    <p class="page-subtitle">Start your journey with ZenoPay today — takes less than 3 minutes</p>

    <!-- Step indicator -->
    <div class="steps-bar" id="stepsBar">
      <div class="step-node active" data-step="1">
        <div class="step-circle"><i class="fas fa-user" style="font-size:13px"></i></div>
        <div class="step-label">Personal Info</div>
      </div>
      <div class="step-node" data-step="2">
        <div class="step-circle"><i class="fas fa-lock" style="font-size:12px"></i></div>
        <div class="step-label">Account Setup</div>
      </div>
      <div class="step-node" data-step="3">
        <div class="step-circle"><i class="fas fa-map-marker-alt" style="font-size:12px"></i></div>
        <div class="step-label">Address & Photo</div>
      </div>
    </div>

    <!-- ── FORM CARD ── -->
    <div class="form-card">

      <div class="server-err" id="serverErr"><i class="fas fa-circle-exclamation"></i> <span id="serverErrMsg"></span></div>

      <form id="regForm" action="/register-zenopay" method="POST" enctype="multipart/form-data" novalidate>

        <!-- ═══════════════════════════ STEP 1: PERSONAL INFO ═══════════════════════════ -->
        <div class="form-step active" data-step="1">
          <h2 class="step-heading"><i class="fas fa-user-circle"></i> Personal Information</h2>
          <p class="step-sub">Your identity details — must match your official documents</p>

          <div class="fg">

            <!-- Full Name -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-id-card"></i> Full Name <span class="req">*</span></label>
              <input type="text" name="FullName" id="FullName" class="finput"
                placeholder="As on your official ID (e.g. Ashok Kumar Sharma)"
                autocomplete="name" />
              <span class="ferr" id="err-FullName"><i class="fas fa-circle-exclamation"></i> Enter your full name (letters only, 3–60 chars)</span>
            </div>

            <!-- Date of Birth -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-calendar-days"></i> Date of Birth <span class="req">*</span></label>
              <input type="date" name="DOB" id="DOB" class="finput" />
              <span class="ferr" id="err-DOB"><i class="fas fa-circle-exclamation"></i> You must be at least 18 years old</span>
            </div>

            <!-- Gender -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-venus-mars"></i> Gender <span class="req">*</span></label>
              <select name="Gender" id="Gender" class="fselect">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other / Prefer not to say</option>
              </select>
              <span class="ferr" id="err-Gender"><i class="fas fa-circle-exclamation"></i> Please select your gender</span>
            </div>

            <!-- Father's Name -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-user-tie"></i> Father's Name <span class="req">*</span></label>
              <input type="text" name="FatherName" id="FatherName" class="finput"
                placeholder="Father's full name" autocomplete="off" />
              <span class="ferr" id="err-FatherName"><i class="fas fa-circle-exclamation"></i> Enter a valid father's name</span>
            </div>

            <!-- Mother's Name -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-user-nurse"></i> Mother's Name</label>
              <input type="text" name="MotherName" id="MotherName" class="finput"
                placeholder="Mother's full name (optional)" autocomplete="off" />
              <span class="ferr" id="err-MotherName"><i class="fas fa-circle-exclamation"></i> Only letters and spaces allowed</span>
            </div>

            <!-- Account Role -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-user-tag"></i> Account Type <span class="req">*</span></label>
              <select name="Role" id="Role" class="fselect">
                <option value="">Select type</option>
                <option value="user" selected>Personal User</option>
                <option value="merchant">Merchant / Business</option>
              </select>
              <span class="ferr" id="err-Role"><i class="fas fa-circle-exclamation"></i> Please select account type</span>
            </div>

            <!-- Business Name (conditional) -->
            <div class="fgroup fg-full" id="bizGroup" style="display:none">
              <label class="flabel"><i class="fas fa-building"></i> Business Name <span class="req">*</span></label>
              <input type="text" name="BusinessName" id="BusinessName" class="finput"
                placeholder="Registered business name" autocomplete="organization" />
              <span class="ferr" id="err-BusinessName"><i class="fas fa-circle-exclamation"></i> Enter your business name (3–80 chars)</span>
            </div>

          </div>

          <div class="fbtn-row">
            <span></span>
            <button type="button" class="fbtn fbtn-primary" onclick="goNext(1)">
              Next <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <!-- ═══════════════════════════ STEP 2: ACCOUNT SETUP ═══════════════════════════ -->
        <div class="form-step" data-step="2">
          <h2 class="step-heading"><i class="fas fa-lock"></i> Account Setup</h2>
          <p class="step-sub">Your login credentials and contact details — kept strictly private</p>

          <div class="fg">

            <!-- Email -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-envelope"></i> Email Address <span class="req">*</span></label>
              <input type="email" name="Email" id="Email" class="finput"
                placeholder="you@example.com" autocomplete="email" />
              <span class="ferr" id="err-Email"><i class="fas fa-circle-exclamation"></i> Enter a valid email address</span>
            </div>

            <!-- Phone -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-mobile-screen"></i> Mobile Number <span class="req">*</span></label>
              <div class="phone-combo">
                <select name="PhoneCode" id="PhoneCode" class="phone-code">
                  <option value="+91">🇮🇳 +91</option>
                  <option value="+1">🇺🇸 +1</option>
                  <option value="+44">🇬🇧 +44</option>
                  <option value="+971">🇦🇪 +971</option>
                  <option value="+61">🇦🇺 +61</option>
                </select>
                <input type="tel" name="Mobile" id="Mobile" class="finput"
                  placeholder="10-digit number (e.g. 9876543210)"
                  maxlength="10" style="flex:1" />
              </div>
              <span class="ferr" id="err-Mobile"><i class="fas fa-circle-exclamation"></i> Enter a valid 10-digit mobile number</span>
            </div>

            <!-- Password -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-key"></i> Password <span class="req">*</span></label>
              <div class="pw-wrap">
                <input type="password" name="Password" id="Password" class="finput"
                  placeholder="Create a strong password" autocomplete="new-password" />
                <button type="button" class="pw-toggle" onclick="togglePw('Password',this)"><i class="fas fa-eye"></i></button>
              </div>
              <div class="pw-strength" id="pwStrength" style="display:none">
                <div class="pw-bar-track"><div class="pw-bar-fill" id="pwBar"></div></div>
                <div class="pw-rules">
                  <div class="pw-rule" id="rule-len"><i class="fas fa-circle"></i> At least 8 characters</div>
                  <div class="pw-rule" id="rule-upper"><i class="fas fa-circle"></i> One uppercase letter</div>
                  <div class="pw-rule" id="rule-lower"><i class="fas fa-circle"></i> One lowercase letter</div>
                  <div class="pw-rule" id="rule-num"><i class="fas fa-circle"></i> One number</div>
                  <div class="pw-rule" id="rule-special"><i class="fas fa-circle"></i> One special character (!@#$...)</div>
                </div>
              </div>
              <span class="ferr" id="err-Password"><i class="fas fa-circle-exclamation"></i> Password must meet all requirements above</span>
            </div>

            <!-- Confirm Password -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-lock"></i> Confirm Password <span class="req">*</span></label>
              <div class="pw-wrap">
                <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="finput"
                  placeholder="Re-enter your password" autocomplete="new-password" />
                <button type="button" class="pw-toggle" onclick="togglePw('ConfirmPassword',this)"><i class="fas fa-eye"></i></button>
              </div>
              <span class="ferr" id="err-ConfirmPassword"><i class="fas fa-circle-exclamation"></i> <span id="cpMsg">Passwords do not match</span></span>
            </div>

          </div>

          <div class="fbtn-row">
            <button type="button" class="fbtn fbtn-ghost" onclick="goPrev(2)">
              <i class="fas fa-arrow-left"></i> Previous
            </button>
            <button type="button" class="fbtn fbtn-primary" onclick="goNext(2)">
              Next <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <!-- ═══════════════════════════ STEP 3: ADDRESS & PHOTO ═══════════════════════════ -->
        <div class="form-step" data-step="3">
          <h2 class="step-heading"><i class="fas fa-map-location-dot"></i> Address & Profile Photo</h2>
          <p class="step-sub">For identity verification and account records</p>

          <div class="fg">

            <!-- Address -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-house"></i> Full Address <span class="req">*</span></label>
              <textarea name="Address" id="Address" class="ftextarea"
                placeholder="House/Flat No., Street, Area, Landmark"></textarea>
              <span class="ferr" id="err-Address"><i class="fas fa-circle-exclamation"></i> Enter your complete address (min 10 chars)</span>
            </div>

            <!-- City -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-city"></i> City <span class="req">*</span></label>
              <input type="text" name="City" id="City" class="finput" placeholder="e.g. Ahmedabad" />
              <span class="ferr" id="err-City"><i class="fas fa-circle-exclamation"></i> Enter your city name</span>
            </div>

            <!-- State -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-map"></i> State <span class="req">*</span></label>
              <select name="State" id="State" class="fselect">
                <option value="">Select state</option>
                <option>Andhra Pradesh</option><option>Arunachal Pradesh</option>
                <option>Assam</option><option>Bihar</option><option>Chhattisgarh</option>
                <option>Goa</option><option selected>Gujarat</option>
                <option>Haryana</option><option>Himachal Pradesh</option>
                <option>Jharkhand</option><option>Karnataka</option><option>Kerala</option>
                <option>Madhya Pradesh</option><option>Maharashtra</option><option>Manipur</option>
                <option>Meghalaya</option><option>Mizoram</option><option>Nagaland</option>
                <option>Odisha</option><option>Punjab</option><option>Rajasthan</option>
                <option>Sikkim</option><option>Tamil Nadu</option><option>Telangana</option>
                <option>Tripura</option><option>Uttar Pradesh</option><option>Uttarakhand</option>
                <option>West Bengal</option>
                <option>Delhi</option><option>Jammu & Kashmir</option><option>Ladakh</option>
                <option>Chandigarh</option><option>Puducherry</option><option>Other</option>
              </select>
              <span class="ferr" id="err-State"><i class="fas fa-circle-exclamation"></i> Please select your state</span>
            </div>

            <!-- Pincode -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-map-pin"></i> Pincode <span class="req">*</span></label>
              <input type="text" name="Pincode" id="Pincode" class="finput"
                placeholder="6-digit pincode" maxlength="6" inputmode="numeric" />
              <span class="ferr" id="err-Pincode"><i class="fas fa-circle-exclamation"></i> Enter a valid 6-digit pincode</span>
            </div>

            <!-- Country -->
            <div class="fgroup">
              <label class="flabel"><i class="fas fa-globe"></i> Country <span class="req">*</span></label>
              <select name="Country" id="Country" class="fselect">
                <option value="India" selected>🇮🇳 India</option>
                <option value="United States">🇺🇸 United States</option>
                <option value="United Kingdom">🇬🇧 United Kingdom</option>
                <option value="UAE">🇦🇪 UAE</option>
                <option value="Australia">🇦🇺 Australia</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Profile Photo -->
            <div class="fgroup fg-full">
              <label class="flabel"><i class="fas fa-camera"></i> Profile Photo <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
              <div class="photo-drop" id="photoDrop" onclick="document.getElementById('photoInput').click()">
                <i class="fas fa-cloud-arrow-up"></i>
                <p>Click to upload your photo</p>
                <small>JPG, PNG up to 5 MB</small>
                <img id="photoPreview" class="photo-preview" alt="Preview" />
              </div>
              <input type="file" id="photoInput" name="ImagePath" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="previewPhoto(this)" />
              <span class="ferr" id="err-photo"><i class="fas fa-circle-exclamation"></i> File must be JPG/PNG under 5 MB</span>
            </div>

            <!-- T&C -->
            <div class="fgroup fg-full">
              <label class="tnc-row" for="tnc">
                <input type="checkbox" id="tnc" name="tnc" />
                <span>I agree to ZenoPay's <a href="/terms" target="_blank">Terms &amp; Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a>. I confirm all details are accurate.</span>
              </label>
              <span class="ferr" id="err-tnc"><i class="fas fa-circle-exclamation"></i> You must accept the terms to continue</span>
            </div>

          </div>

          <div class="fbtn-row">
            <button type="button" class="fbtn fbtn-ghost" onclick="goPrev(3)">
              <i class="fas fa-arrow-left"></i> Previous
            </button>
            <button type="submit" class="fbtn fbtn-primary" id="submitBtn">
              <i class="fas fa-user-plus"></i> Create Account
            </button>
          </div>
        </div>

      </form>

      <!-- SUCCESS SCREEN -->
      <div class="success-screen" id="successScreen">
        <div class="success-icon"><i class="fas fa-check"></i></div>
        <h3>Account Created!</h3>
        <p>Welcome to ZenoPay. Your account is ready.</p>
        <p class="success-redirect">Redirecting to login in <span id="countdown">3</span>s…</p>
      </div>

    </div><!-- /form-card -->

    <div class="trust-row">
      <div class="trust-item"><i class="fas fa-lock"></i> SSL Secured</div>
      <div class="trust-item"><i class="fas fa-shield-halved"></i> GDPR Compliant</div>
      <div class="trust-item"><i class="fas fa-certificate"></i> ISO Certified</div>
    </div>

    <div class="login-link-row">Already have an account? <a href="/login">Login here</a></div>

  </div><!-- /reg-right -->
</div>

<script>
/* ───────────────────────────────────────
   HELPERS
─────────────────────────────────────── */
let currentStep = 1;
const totalSteps = 3;

function $(id){ return document.getElementById(id); }

function showErr(id, msg){
  const el = $('err-' + id);
  if(!el) return;
  if(msg) el.querySelector('span') && (el.querySelector('span').textContent = msg);
  el.classList.add('show');
  const inp = $(id);
  if(inp){ inp.classList.remove('is-ok'); inp.classList.add('is-error'); }
}
function clearErr(id){
  const el = $('err-' + id);
  if(el) el.classList.remove('show');
  const inp = $(id);
  if(inp){ inp.classList.remove('is-error'); }
}
function setOk(id){
  clearErr(id);
  const inp = $(id);
  if(inp) inp.classList.add('is-ok');
}

/* ───────────────────────────────────────
   VALIDATION RULES
─────────────────────────────────────── */
const nameRe = /^[A-Za-z\s.'-]{3,60}$/;
const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
const mobileRe = /^[6-9]\d{9}$/;
const pincodeRe = /^\d{6}$/;
const addrMin = 10;

function ageOk(dob){
  const d = new Date(dob), now = new Date();
  let age = now.getFullYear() - d.getFullYear();
  const m = now.getMonth() - d.getMonth();
  if(m < 0 || (m===0 && now.getDate() < d.getDate())) age--;
  return age >= 18;
}

function pwScore(pw){
  let s = 0;
  if(pw.length >= 8) s++;
  if(/[A-Z]/.test(pw)) s++;
  if(/[a-z]/.test(pw)) s++;
  if(/\d/.test(pw)) s++;
  if(/[^A-Za-z0-9]/.test(pw)) s++;
  return s;
}

/* ───────────────────────────────────────
   STEP VALIDATION
─────────────────────────────────────── */
function validateStep(step){
  let ok = true;

  if(step === 1){
    const fn = $('FullName').value.trim();
    if(!nameRe.test(fn)){ showErr('FullName'); ok=false; } else setOk('FullName');

    const dob = $('DOB').value;
    if(!dob || !ageOk(dob)){ showErr('DOB'); ok=false; } else setOk('DOB');

    if(!$('Gender').value){ showErr('Gender'); ok=false; } else setOk('Gender');

    const fat = $('FatherName').value.trim();
    if(!nameRe.test(fat)){ showErr('FatherName'); ok=false; } else setOk('FatherName');

    const mot = $('MotherName').value.trim();
    if(mot && !nameRe.test(mot)){ showErr('MotherName'); ok=false; } else clearErr('MotherName');

    if(!$('Role').value){ showErr('Role'); ok=false; } else setOk('Role');

    if($('Role').value === 'merchant'){
      const biz = $('BusinessName').value.trim();
      if(biz.length < 3 || biz.length > 80){ showErr('BusinessName'); ok=false; } else setOk('BusinessName');
    }
  }

  if(step === 2){
    const email = $('Email').value.trim();
    if(!emailRe.test(email)){ showErr('Email'); ok=false; } else setOk('Email');

    const mob = $('Mobile').value.trim();
    if(!mobileRe.test(mob)){ showErr('Mobile'); ok=false; } else setOk('Mobile');

    const pw = $('Password').value;
    if(pwScore(pw) < 4){ showErr('Password'); ok=false; } else setOk('Password');

    const cpw = $('ConfirmPassword').value;
    if(!cpw){ showErr('ConfirmPassword','Please confirm your password'); ok=false; }
    else if(pw !== cpw){ showErr('ConfirmPassword','Passwords do not match'); ok=false; }
    else setOk('ConfirmPassword');
  }

  if(step === 3){
    const addr = $('Address').value.trim();
    if(addr.length < addrMin){ showErr('Address'); ok=false; } else setOk('Address');

    const city = $('City').value.trim();
    if(city.length < 2){ showErr('City'); ok=false; } else setOk('City');

    if(!$('State').value){ showErr('State'); ok=false; } else setOk('State');

    const pin = $('Pincode').value.trim();
    if(!pincodeRe.test(pin)){ showErr('Pincode'); ok=false; } else setOk('Pincode');

    if(!$('tnc').checked){ showErr('tnc'); ok=false; } else clearErr('tnc');
  }

  return ok;
}

/* ───────────────────────────────────────
   NAVIGATION
─────────────────────────────────────── */
function updateUI(){
  document.querySelectorAll('.step-node').forEach(n => {
    const s = parseInt(n.dataset.step);
    n.classList.toggle('active', s === currentStep);
    n.classList.toggle('done', s < currentStep);
  });
  document.querySelectorAll('.form-step').forEach(s => {
    s.classList.toggle('active', parseInt(s.dataset.step) === currentStep);
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function goNext(step){
  if(!validateStep(step)) return;
  currentStep = step + 1;
  updateUI();
}

function goPrev(step){
  currentStep = step - 1;
  updateUI();
}

/* ───────────────────────────────────────
   PASSWORD STRENGTH UI
─────────────────────────────────────── */
$('Password').addEventListener('input', function(){
  const pw = this.value;
  $('pwStrength').style.display = pw ? 'block' : 'none';

  const rules = [
    ['rule-len',     pw.length >= 8],
    ['rule-upper',   /[A-Z]/.test(pw)],
    ['rule-lower',   /[a-z]/.test(pw)],
    ['rule-num',     /\d/.test(pw)],
    ['rule-special', /[^A-Za-z0-9]/.test(pw)],
  ];
  rules.forEach(([id, met]) => {
    $(id).classList.toggle('met', met);
  });

  const score = pwScore(pw);
  const colors = ['#EF4444','#F59E0B','#F59E0B','#10B981','#10B981'];
  const bar = $('pwBar');
  bar.style.width = (score/5*100) + '%';
  bar.style.background = colors[score-1] || '#E5E7EB';

  // live clear error if strong enough
  if(score >= 4) clearErr('Password');
});

/* confirm password live check */
$('ConfirmPassword').addEventListener('input', function(){
  const pw  = $('Password').value;
  const cpw = this.value;
  if(!cpw) return;
  if(pw === cpw){ setOk('ConfirmPassword'); clearErr('ConfirmPassword'); }
  else { showErr('ConfirmPassword','Passwords do not match'); }
});

/* ───────────────────────────────────────
   PASSWORD TOGGLE
─────────────────────────────────────── */
function togglePw(id, btn){
  const inp = $(id);
  const isHidden = inp.type === 'password';
  inp.type = isHidden ? 'text' : 'password';
  btn.querySelector('i').className = isHidden ? 'fas fa-eye-slash' : 'fas fa-eye';
}

/* ───────────────────────────────────────
   BUSINESS NAME TOGGLE
─────────────────────────────────────── */
$('Role').addEventListener('change', function(){
  const show = this.value === 'merchant';
  $('bizGroup').style.display = show ? 'block' : 'none';
  $('BusinessName').required = show;
});

/* ───────────────────────────────────────
   PROFILE PHOTO
─────────────────────────────────────── */
function previewPhoto(input){
  clearErr('photo');
  if(!input.files || !input.files[0]) return;
  const file = input.files[0];
  if(file.size > 5 * 1024 * 1024){ showErr('photo','File must be JPG/PNG under 5 MB'); input.value=''; return; }
  if(!['image/jpeg','image/png','image/webp'].includes(file.type)){ showErr('photo','Only JPG/PNG/WebP files allowed'); input.value=''; return; }
  const reader = new FileReader();
  reader.onload = e => {
    const prev = $('photoPreview');
    prev.src = e.target.result;
    prev.style.display = 'block';
    $('photoDrop').classList.add('has-file');
  };
  reader.readAsDataURL(file);
}

/* ───────────────────────────────────────
   LIVE VALIDATE ON BLUR
─────────────────────────────────────── */
['FullName','FatherName','MotherName'].forEach(id => {
  $(id) && $(id).addEventListener('blur', function(){
    const v = this.value.trim();
    if(!v) return;
    if(id === 'MotherName'){ if(v && !nameRe.test(v)) showErr(id); else clearErr(id); return; }
    if(!nameRe.test(v)) showErr(id); else setOk(id);
  });
});

$('Email').addEventListener('blur', function(){
  if(!this.value) return;
  if(!emailRe.test(this.value.trim())) showErr('Email'); else setOk('Email');
});

$('Mobile').addEventListener('input', function(){
  this.value = this.value.replace(/\D/g,'').slice(0,10);
});
$('Mobile').addEventListener('blur', function(){
  if(!this.value) return;
  if(!mobileRe.test(this.value.trim())) showErr('Mobile'); else setOk('Mobile');
});

$('Pincode').addEventListener('input', function(){
  this.value = this.value.replace(/\D/g,'').slice(0,6);
});
$('Pincode').addEventListener('blur', function(){
  if(!this.value) return;
  if(!pincodeRe.test(this.value.trim())) showErr('Pincode'); else setOk('Pincode');
});

/* clear errors on input */
document.querySelectorAll('.finput,.fselect,.ftextarea').forEach(el => {
  el.addEventListener('input', function(){
    if(this.classList.contains('is-error')) clearErr(this.id || this.name);
  });
});

/* ───────────────────────────────────────
   FORM SUBMIT
─────────────────────────────────────── */
$('regForm').addEventListener('submit', async function(e){
  e.preventDefault();
  if(!validateStep(3)) return;

  const btn = $('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating account…';

  $('serverErr').classList.remove('show');

  try {
    const resp = await fetch('/register-zenopay', { method:'POST', body: new FormData(this) });
    const data = await resp.json();

    if(data.success){
      this.style.display = 'none';
      $('stepsBar').style.display = 'none';
      $('successScreen').classList.add('show');
      let c = 3;
      const cd = $('countdown');
      const t = setInterval(() => {
        c--; cd.textContent = c;
        if(c <= 0){ clearInterval(t); window.location.href = '/login'; }
      }, 1000);
    } else {
      $('serverErrMsg').textContent = data.message || 'Registration failed. Please try again.';
      $('serverErr').classList.add('show');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-user-plus"></i> Create Account';
    }
  } catch(err){
    $('serverErrMsg').textContent = 'Network error. Please check your connection and try again.';
    $('serverErr').classList.add('show');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-user-plus"></i> Create Account';
  }
});
</script>
</body>
</html>
