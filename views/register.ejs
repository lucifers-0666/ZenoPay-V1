                <input id="ImagePath" name="ImagePath" type="file" accept="image/jpeg,image/png,image/webp" style="display:none" />
                <p class="error-msg" id="error-ImagePath"><i class="fa-solid fa-circle-exclamation"></i> File must be JPG/PNG under 5 MB</p>
