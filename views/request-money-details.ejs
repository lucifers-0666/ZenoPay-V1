<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --border: #E2E8F0;
      --text: #1F2937;
      --muted: #6B7280;
      --muted-2: #94A3B8;
      --blue: #3B82F6;
      --blue-dark: #2563EB;
      --green: #10B981;
      --orange: #F59E0B;
      --red: #EF4444;
      --slate: #475569;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      min-height: 100vh;
      padding: 40px 0;
      color: var(--text);
    }

    .wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .breadcrumb {
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 20px;
    }
    .breadcrumb a { color: var(--blue); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--blue);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 24px;
      transition: transform 0.3s ease;
    }
    .back-link:hover { transform: translateX(-4px); }

    .title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .title-row h1 {
      margin: 0;
      font-size: 32px;
      font-weight: 800;
      color: var(--text);
    }

    .req-badge {
      background: #F1F5F9;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 16px;
      font-size: 14px;
      font-family: 'Courier New', monospace;
      color: var(--slate);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .hero {
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      margin-bottom: 24px;
    }

    .hero-strip {
      height: 6px;
      background: linear-gradient(135deg, #F59E0B, #D97706);
    }
    .hero-strip-pending { background: linear-gradient(135deg, #F59E0B, #D97706); }
    .hero-strip-paid { background: linear-gradient(135deg, #10B981, #059669); }
    .hero-strip-expired { background: linear-gradient(135deg, #6B7280, #475569); }
    .hero-strip-cancelled { background: linear-gradient(135deg, #EF4444, #DC2626); }

    .hero-body {
      padding: 36px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 16px;
      align-items: center;
    }

    .amount-label {
      margin: 0 0 8px;
      font-size: 12px;
      color: var(--muted-2);
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .amount {
      margin: 0;
      font-size: 48px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .note {
      margin-top: 8px;
      font-size: 16px;
      color: var(--muted);
      line-height: 1.6;
      font-style: italic;
      background: #F8FAFC;
      padding: 12px;
      border-radius: 8px;
      border-left: 3px solid var(--blue);
    }

    .status-pill {
      padding: 12px 24px;
      border-radius: 40px;
      font-size: 16px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1.5px solid;
    }
    .status-pending { background: rgba(245,158,11,0.1); color: #D97706; border-color: #F59E0B; }
    .status-paid { background: rgba(16,185,129,0.1); color: #059669; border-color: #10B981; }
    .status-expired { background: rgba(107,114,128,0.12); color: #475569; border-color: #6B7280; }
    .status-cancelled { background: rgba(239,68,68,0.1); color: #DC2626; border-color: #EF4444; }

    .hero-divider { height: 1px; background: #F1F5F9; margin: 0 36px; }

    .meta-strip {
      padding: 20px 36px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .meta i { font-size: 20px; color: var(--muted-2); margin-bottom: 6px; }
    .meta-label {
      font-size: 12px;
      color: var(--muted-2);
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .meta-value { font-size: 15px; font-weight: 600; }

    .layout {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 24px;
      align-items: start;
    }

    .section-card { padding: 28px; margin-bottom: 24px; }

    .section-title {
      margin: 0 0 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid #F1F5F9;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-title i { color: var(--blue); }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .label {
      font-size: 12px;
      color: var(--muted-2);
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 4px;
    }
    .value {
      font-size: 15px;
      color: var(--text);
      font-weight: 600;
      line-height: 1.4;
      word-break: break-word;
    }

    .mono { font-family: 'Courier New', monospace; font-size: 14px; }

    .badge-yes {
      background: rgba(59,130,246,0.1);
      color: var(--blue-dark);
      border: 1px solid rgba(59,130,246,0.3);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .badge-no {
      background: rgba(239,68,68,0.1);
      color: #DC2626;
      border: 1px solid rgba(239,68,68,0.3);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .share-box {
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .share-link {
      font-size: 14px;
      font-family: 'Courier New', monospace;
      color: var(--slate);
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      flex: 1;
    }

    .copy-btn {
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(135deg, #3B82F6, #2563EB);
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }
    .copy-btn:hover { transform: translateY(-1px); }

    .share-platforms {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .share-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
      font-size: 18px;
      color: var(--slate);
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .share-btn:hover { transform: translateY(-2px); }
    .share-whatsapp:hover { color: #16A34A; border-color: #16A34A; background: #F0FDF4; }
    .share-email:hover { color: #2563EB; border-color: #2563EB; background: #EFF6FF; }
    .share-sms:hover { color: #475569; border-color: #94A3B8; background: #F1F5F9; }
    .share-link-btn:hover { color: #2563EB; border-color: #2563EB; background: #EFF6FF; }

    .qr-wrap {
      display: grid;
      place-items: center;
      gap: 12px;
    }

    .qr-image {
      width: 200px;
      height: 200px;
      background: #fff;
      border-radius: 12px;
      padding: 16px;
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
    }

    .qr-subtitle {
      font-size: 14px;
      color: var(--muted);
      text-align: center;
    }

    .outline-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 8px;
      padding: 8px 14px;
      border: 1.5px solid var(--blue);
      color: var(--blue);
      background: #fff;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .outline-btn:hover { background: #EFF6FF; }

    .timeline {
      position: relative;
      padding-left: 52px;
    }
    .timeline::before {
      content: "";
      position: absolute;
      left: 20px;
      top: 4px;
      bottom: 8px;
      border-left: 2px solid var(--border);
    }

    .t-item {
      position: relative;
      padding-bottom: 28px;
    }
    .t-item:last-child { padding-bottom: 0; }

    .t-dot {
      position: absolute;
      left: -42px;
      top: 4px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 2px solid;
      background: #fff;
      display: grid;
      place-items: center;
      font-size: 10px;
    }

    .dot-completed { border-color: #10B981; color: #10B981; }
    .dot-active {
      border-color: #3B82F6;
      color: #3B82F6;
      animation: pulse 1.3s infinite;
    }
    .dot-pending { border-color: #E2E8F0; color: #E2E8F0; }

    .t-title { font-size: 15px; font-weight: 600; }
    .t-desc { font-size: 13px; color: var(--muted); margin-top: 4px; }
    .t-time { font-size: 12px; color: var(--muted-2); margin-top: 4px; }

    .sidebar-card { padding: 24px; margin-bottom: 24px; }
    .sidebar-title {
      margin: 0 0 16px;
      font-size: 16px;
      font-weight: 700;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .action-btn {
      width: 100%;
      height: 44px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 14px;
      cursor: pointer;
      transition: all .3s ease;
      border: 1.5px solid var(--border);
      background: #fff;
      color: #475569;
      margin-bottom: 10px;
      text-decoration: none;
    }

    .action-btn:hover { transform: translateY(-2px); }

    .action-primary {
      background: linear-gradient(135deg, #3B82F6, #2563EB);
      color: #fff;
      border: none;
    }
    .action-primary:hover { box-shadow: 0 8px 20px rgba(59,130,246,.3); }

    .action-outline:hover { border-color: #3B82F6; color: #3B82F6; background: #EFF6FF; }
    .action-danger { border-color: #EF4444; color: #DC2626; }
    .action-danger:hover { background: #FEF2F2; border-color: #EF4444; color: #DC2626; }

    .summary-amount {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .summary-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
      border: 1px solid transparent;
    }

    .summary-pending { background: rgba(245,158,11,0.1); color: #D97706; border-color: rgba(245,158,11,0.3); }
    .summary-paid { background: rgba(16,185,129,0.1); color: #059669; border-color: rgba(16,185,129,0.3); }
    .summary-expired { background: rgba(107,114,128,0.12); color: #475569; border-color: rgba(107,114,128,0.3); }
    .summary-cancelled { background: rgba(239,68,68,0.1); color: #DC2626; border-color: rgba(239,68,68,0.3); }

    .progress {
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: #E2E8F0;
      overflow: hidden;
      margin-top: 8px;
      margin-bottom: 4px;
    }
    .progress-fill {
      height: 100%;
      background: #F59E0B;
      border-radius: 999px;
      width: calc(var(--progress, 0) * 1%);
    }

    .partial-progress-fill {
      background: #10B981;
    }

    .partial-item {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--slate);
      margin-bottom: 8px;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(59,130,246,0.4); }
      70% { box-shadow: 0 0 0 8px rgba(59,130,246,0); }
      100% { box-shadow: 0 0 0 0 rgba(59,130,246,0); }
    }

    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      body { padding: 24px 0; }
      .wrapper { padding: 0 16px; }
      .hero-body { grid-template-columns: 1fr; padding: 24px; }
      .amount { font-size: 36px; }
      .meta-strip { grid-template-columns: repeat(2, 1fr); padding: 20px 24px; }
      .hero-divider { margin: 0 24px; }
      .info-grid { grid-template-columns: 1fr; }
      .timeline { padding-left: 42px; }
      .timeline::before { left: 14px; }
      .t-dot { left: -32px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="breadcrumb">
      <a href="/">Home</a> &gt; <a href="/dashboard">Dashboard</a> &gt; <a href="/request-money">Request Money</a> &gt; Request Details
    </div>

    <a href="/request-money" class="back-link">
      <i class="fas fa-arrow-left"></i> Back to Requests
    </a>

    <div class="title-row">
      <h1>Money Request Details</h1>
      <div class="req-badge"><i class="fas fa-hashtag"></i> <%= request.id %></div>
    </div>

    <section class="card hero">
      <div class="hero-strip hero-strip-<%= status.key %>"></div>
      <div class="hero-body">
        <div>
          <p class="amount-label">Requested Amount</p>
          <p class="amount">₹<%= Number(request.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
          <div class="note"><%= request.note %></div>
        </div>
        <div>
          <span class="status-pill status-<%= status.key %>">
            <i class="fas <%= status.icon %>"></i>
            <%= status.text %>
          </span>
        </div>
      </div>
      <div class="hero-divider"></div>
      <div class="meta-strip">
        <div class="meta">
          <i class="fas fa-user"></i>
          <div class="meta-label">Requested From</div>
          <div class="meta-value"><%= meta.requestedFrom %></div>
        </div>
        <div class="meta">
          <i class="fas fa-calendar-alt"></i>
          <div class="meta-label">Requested On</div>
          <div class="meta-value"><%= meta.requestedOn %></div>
        </div>
        <div class="meta">
          <i class="fas fa-clock"></i>
          <div class="meta-label">Expires On</div>
          <div class="meta-value"><%= meta.expiresOn %></div>
        </div>
        <div class="meta">
          <i class="fas fa-mobile-alt"></i>
          <div class="meta-label">Via</div>
          <div class="meta-value"><%= meta.via %></div>
        </div>
      </div>
    </section>

    <div class="layout">
      <div>
        <section class="card section-card">
          <h2 class="section-title"><i class="fas fa-info-circle"></i> Request Details</h2>
          <div class="info-grid">
            <% detailFields.forEach(function(field){ %>
              <div>
                <div class="label"><%= field.label %></div>
                <% if (field.badge) { %>
                  <div class="value">
                    <span class="<%= field.value === 'Yes' ? 'badge-yes' : 'badge-no' %>">
                      <i class="fas <%= field.value === 'Yes' ? 'fa-check' : 'fa-xmark' %>"></i>
                      <%= field.value %>
                    </span>
                  </div>
                <% } else if (field.isQr) { %>
                  <div class="value">
                    <button class="outline-btn" type="button"><i class="fas fa-qrcode"></i> Generate QR</button>
                  </div>
                <% } else { %>
                  <div class="value <%= field.mono ? 'mono' : '' %>"><%= field.value %></div>
                <% } %>
              </div>
            <% }); %>
          </div>
        </section>

        <section class="card section-card">
          <h2 class="section-title"><i class="fas fa-share-alt"></i> Share Payment Link</h2>
          <div class="share-box">
            <div class="share-link" id="paymentLinkText"><%= request.paymentLink %></div>
            <button class="copy-btn" id="copyPaymentLinkBtn"><i class="fas fa-copy"></i> Copy</button>
          </div>
          <div class="share-platforms">
            <button class="share-btn share-whatsapp" data-share="whatsapp" aria-label="Share on WhatsApp"><i class="fab fa-whatsapp"></i></button>
            <button class="share-btn share-email" data-share="email" aria-label="Share via email"><i class="fas fa-envelope"></i></button>
            <button class="share-btn share-sms" data-share="sms" aria-label="Share via SMS"><i class="fas fa-sms"></i></button>
            <button class="share-btn share-link-btn" data-share="link" aria-label="Copy link"><i class="fas fa-link"></i></button>
          </div>
        </section>

        <section class="card section-card">
          <h2 class="section-title"><i class="fas fa-qrcode"></i> Payment QR Code</h2>
          <div class="qr-wrap">
            <div class="qr-image">
              <img alt="Payment QR" width="200" height="200" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><rect width='200' height='200' fill='%23ffffff'/><rect x='16' y='16' width='48' height='48' fill='%230f172a'/><rect x='136' y='16' width='48' height='48' fill='%230f172a'/><rect x='16' y='136' width='48' height='48' fill='%230f172a'/><rect x='88' y='88' width='24' height='24' fill='%230f172a'/><rect x='120' y='88' width='24' height='24' fill='%230f172a'/><rect x='88' y='120' width='24' height='24' fill='%230f172a'/></svg>" />
            </div>
            <div class="qr-subtitle">Scan to pay ₹<%= Number(request.amount || 0).toLocaleString('en-IN') %></div>
            <button class="outline-btn" type="button"><i class="fas fa-download"></i> Download QR</button>
          </div>
        </section>

        <section class="card section-card">
          <h2 class="section-title"><i class="fas fa-history"></i> Request Activity</h2>
          <div class="timeline">
            <% timeline.forEach(function(item){ %>
              <div class="t-item">
                <div class="t-dot dot-<%= item.state %>">
                  <i class="fas <%= item.state === 'completed' ? 'fa-check' : item.state === 'active' ? 'fa-circle' : 'fa-dot-circle' %>"></i>
                </div>
                <div class="t-title"><%= item.title %></div>
                <div class="t-desc"><%= item.desc %></div>
                <div class="t-time"><%= item.time %></div>
              </div>
            <% }); %>
          </div>
        </section>
      </div>

      <aside>
        <section class="card sidebar-card">
          <h3 class="sidebar-title">Quick Actions</h3>
          <a class="action-btn action-primary" href="#"><i class="fas fa-bolt"></i> Pay Now</a>
          <button class="action-btn action-outline" type="button"><i class="fas fa-bell"></i> Send Reminder</button>
          <% if (status.key !== 'paid') { %>
            <button class="action-btn action-outline" type="button"><i class="fas fa-pen"></i> Edit Amount</button>
            <button class="action-btn action-danger" type="button"><i class="fas fa-times"></i> Cancel Request</button>
          <% } %>
          <button class="action-btn action-outline" type="button"><i class="fas fa-download"></i> Download PDF</button>
        </section>

        <section class="card sidebar-card">
          <h3 class="sidebar-title">Request Summary</h3>
          <div class="summary-amount">₹<%= Number(request.amount || 0).toLocaleString('en-IN') %></div>
          <div class="summary-status summary-<%= status.key %>">
            <i class="fas <%= status.icon %>"></i>
            <%= status.text %>
          </div>
          <div class="label">Expiry countdown</div>
          <div class="value"><%= expiryDays %> days remaining</div>
          <div class="progress"><div class="progress-fill" style="--progress: <%= expiryProgress %>"></div></div>
        </section>

        <% if (request.partialEnabled) { %>
          <section class="card sidebar-card">
            <h3 class="sidebar-title">Partial Payments</h3>
            <div class="value">₹<%= Number(request.partialReceived || 0).toLocaleString('en-IN') %> received of ₹<%= Number(request.amount || 0).toLocaleString('en-IN') %></div>
            <div class="progress">
              <div class="progress-fill partial-progress-fill" style="--progress: <%= Math.min(100, Math.round((request.partialReceived / request.amount) * 100)) %>"></div>
            </div>
            <div style="margin-top: 12px;">
              <% request.partialPayments.forEach(function(payment){ %>
                <div class="partial-item">
                  <span><%= payment.name %> • <%= payment.date %></span>
                  <strong>₹<%= Number(payment.amount).toLocaleString('en-IN') %></strong>
                </div>
              <% }); %>
            </div>
          </section>
        <% } %>
      </aside>
    </div>
  </div>

  <script>
    (function(){
      const link = '<%= request.paymentLink %>';
      const copyBtn = document.getElementById('copyPaymentLinkBtn');
      const shareButtons = document.querySelectorAll('[data-share]');

      const copyToClipboard = async () => {
        try {
          await navigator.clipboard.writeText(link);
          if (copyBtn) {
            const original = copyBtn.innerHTML;
            copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            setTimeout(() => (copyBtn.innerHTML = original), 1400);
          }
        } catch {
          window.prompt('Copy this link:', link);
        }
      };

      copyBtn?.addEventListener('click', copyToClipboard);

      shareButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const channel = btn.dataset.share;
          if (channel === 'link') return copyToClipboard();
          if (channel === 'email') {
            window.location.href = `mailto:?subject=Payment Request&body=${encodeURIComponent(link)}`;
            return;
          }
          if (channel === 'sms') {
            window.location.href = `sms:?body=${encodeURIComponent(link)}`;
            return;
          }
          if (channel === 'whatsapp') {
            window.open(`https://wa.me/?text=${encodeURIComponent(link)}`, '_blank');
          }
        });
      });
    })();
  </script>
</body>
</html>
