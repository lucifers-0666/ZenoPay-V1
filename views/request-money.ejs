<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Request Money - ZenoPay</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode.js/1.5.3/qrcode.min.js"></script>
  <link rel="stylesheet" href="/css/request-money.css">
</head>
<body>
  <div class="page-wrapper">
    <!-- Header -->
    <header class="page-header">
      <div class="header-content">
        <div class="breadcrumb">
          <a href="/dashboard"><i class="fas fa-home"></i> Dashboard</a>
          <span class="divider">/</span>
          <span>Payments</span>
          <span class="divider">/</span>
          <span class="active">Request Money</span>
        </div>
        <h1 class="page-title">Request Money</h1>
        <p class="page-subtitle">Create a payment request, share it, and track responses.</p>
      </div>
      <div class="header-actions">
        <a href="/dashboard" class="btn btn-outline"><i class="fas fa-home"></i> Dashboard</a>
        <a href="/Transaction-History" class="btn btn-outline"><i class="fas fa-history"></i> View History</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-container">
      <div class="content-grid">
        <!-- Left Panel - Form -->
        <div class="form-panel">
          <form id="request-form" class="request-form">
            <!-- Recipients Section -->
            <div class="form-section">
              <h3 class="section-title">Request From</h3>
              <p class="section-desc">Add one or more recipients for this payment request.</p>
              <div class="form-group">
                <div class="recipient-input-wrapper">
                  <input 
                    type="text" 
                    id="recipient-input" 
                    class="form-input" 
                    placeholder="Email or phone number"
                    autocomplete="off"
                  >
                  <button type="button" class="btn btn-secondary" id="add-recipient">
                    <i class="fas fa-user-plus"></i> Add
                  </button>
                </div>
                <p class="help-text">Press Enter or click Add to add multiple recipients</p>
                <div class="recipient-chips" id="recipient-list">
                  <p class="empty-state"><i class="fas fa-users"></i> No recipients added yet</p>
                </div>
                <span class="error-message" id="recipient-error" hidden></span>
              </div>
            </div>

            <!-- Amount Section -->
            <div class="form-section">
              <h3 class="section-title">Amount</h3>
              <div class="form-group amount-group">
                <div class="amount-input-wrapper">
                  <select id="currency" class="form-select">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="INR" selected>INR</option>
                    <option value="GBP">GBP</option>
                  </select>
                  <input 
                    type="number" 
                    id="amount" 
                    class="form-input amount-field" 
                    placeholder="0.00" 
                    min="0" 
                    step="0.01"
                    required
                  >
                </div>
                <span class="error-message" id="amount-error" hidden></span>
              </div>

              <!-- Split Toggle -->
              <div class="split-section">
                <label class="checkbox-label">
                  <input type="checkbox" id="split-toggle" class="checkbox">
                  <span>Split this request</span>
                </label>
                <div class="split-control" id="split-control" hidden>
                  <span class="split-text">Split among</span>
                  <input type="number" id="split-count" class="form-input split-input" min="1" value="2">
                  <span class="split-text">people</span>
                </div>
              </div>
            </div>

            <!-- Description Section -->
            <div class="form-section">
              <div class="section-header">
                <h3 class="section-title">Description / Note</h3>
                <span class="char-count">0/500</span>
              </div>
              <div class="form-group">
                <textarea 
                  id="description" 
                  class="form-textarea" 
                  rows="3" 
                  placeholder="Add a note for your recipients..."
                  maxlength="500"
                ></textarea>
              </div>
            </div>

            <!-- Due Date Section -->
            <div class="form-section">
              <h3 class="section-title">
                Due Date <span class="optional">(optional)</span>
              </h3>
              <div class="form-group">
                <input 
                  type="date" 
                  id="due-date" 
                  class="form-input"
                >
                <p class="due-info" id="due-info" hidden></p>
              </div>
            </div>

            <!-- Category Section -->
            <div class="form-section">
              <h3 class="section-title">
                Category / Tag <span class="optional">(optional)</span>
              </h3>
              <div class="form-group">
                <select id="category" class="form-select">
                  <option value="">Select a category</option>
                  <option value="rent">Rent</option>
                  <option value="utilities">Utilities</option>
                  <option value="subscription">Subscription</option>
                  <option value="freelance">Freelance</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>

            <!-- Send Options -->
            <div class="form-section">
              <h3 class="section-title">Send Options</h3>
              <div class="form-group">
                <div class="checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" id="send-email" checked class="checkbox">
                    <span>Send via Email</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" id="send-sms" class="checkbox">
                    <span>Send via SMS</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" id="generate-link" checked class="checkbox">
                    <span>Generate shareable link</span>
                  </label>
                </div>
              </div>
              <div class="action-buttons">
                <button type="button" class="btn btn-outline" id="copy-link" disabled>
                  <i class="fas fa-link"></i> Copy Link
                </button>
                <button type="button" class="btn btn-outline" id="show-qr" disabled>
                  <i class="fas fa-qrcode"></i> Show QR Code
                </button>
              </div>
            </div>

            <!-- Templates Section -->
            <div class="form-section">
              <h3 class="section-title">Quick Templates</h3>
              <p class="section-desc">Click any template to auto-fill the form.</p>
              <div class="templates-grid">
                <button type="button" class="template-card" data-amount="5000" data-title="Rent" data-category="rent" data-note="Monthly rent payment">
                  <div class="template-icon"><i class="fas fa-home"></i></div>
                  <div class="template-info">
                    <span class="template-title">Rent</span>
                    <span class="template-amount">₹5,000</span>
                  </div>
                  <span class="template-badge"><i class="fas fa-bolt"></i> Quick Fill</span>
                </button>
                <button type="button" class="template-card" data-amount="2000" data-title="Utilities" data-category="utilities" data-note="Monthly utilities">
                  <div class="template-icon"><i class="fas fa-lightbulb"></i></div>
                  <div class="template-info">
                    <span class="template-title">Utilities</span>
                    <span class="template-amount">₹2,000</span>
                  </div>
                  <span class="template-badge"><i class="fas fa-bolt"></i> Quick Fill</span>
                </button>
                <button type="button" class="template-card" data-amount="10000" data-title="Freelance" data-category="freelance" data-note="Project payment">
                  <div class="template-icon"><i class="fas fa-code"></i></div>
                  <div class="template-info">
                    <span class="template-title">Freelance</span>
                    <span class="template-amount">₹10,000</span>
                  </div>
                  <span class="template-badge"><i class="fas fa-bolt"></i> Quick Fill</span>
                </button>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions">
              <button type="button" class="btn btn-outline" id="save-draft">
                <i class="fas fa-save"></i> Save as Draft
              </button>
              <button type="submit" class="btn btn-primary" id="send-request">
                <i class="fas fa-paper-plane"></i> Send Request
              </button>
            </div>
          </form>
        </div>

        <!-- Right Panel - Preview -->
        <div class="preview-panel">
          <div class="preview-card sticky">
            <div class="preview-header">
              <h3>Preview</h3>
              <p class="preview-subtitle">This is how recipients will see it</p>
              <div class="preview-status-badge" id="preview-status">Draft</div>
            </div>

            <!-- Phone Frame Mockup -->
            <div class="phone-frame">
              <div class="phone-content">
                <div class="preview-amount" id="preview-amount">₹0.00</div>
                <p class="preview-sender">Requested by <strong id="preview-name">You</strong></p>
                <p class="preview-description" id="preview-desc">Add a description so your recipients know what this is for.</p>
                
                <div class="preview-badges-section">
                  <div class="badge-group" id="preview-due-badge" hidden>
                    <span class="badge badge-warning"><i class="fas fa-calendar"></i> <span id="preview-due">Due soon</span></span>
                  </div>
                  <div class="badge-group" id="preview-category-badge" hidden>
                    <span class="badge badge-primary"><i class="fas fa-tag"></i> <span id="preview-category">—</span></span>
                  </div>
                </div>

                <div class="preview-meta">
                  <div class="meta-item">
                    <i class="fas fa-users"></i>
                    <span id="preview-recipients">0 recipients</span>
                  </div>
                  <div class="meta-item" id="preview-per-person-item" hidden>
                    <i class="fas fa-divide"></i>
                    <span id="preview-per-person">—</span>
                  </div>
                </div>

                <button type="button" class="btn btn-secondary" id="preview-qr-btn" hidden>
                  <i class="fas fa-qrcode"></i> View QR Code
                </button>

                <a href="/Transaction-History" class="preview-link">
                  <i class="fas fa-history"></i> View request history
                </a>
              </div>
            </div>

            <!-- Success State -->
            <div class="success-state" id="success-box" hidden>
              <div class="success-icon">
                <i class="fas fa-check-circle"></i>
              </div>
              <h3>Request Sent Successfully!</h3>
              <p id="success-message">Your request has been sent to all recipients.</p>
              <div class="success-actions">
                <button type="button" class="btn btn-primary" id="send-another">
                  <i class="fas fa-plus"></i> Send Another
                </button>
                <a href="/Transaction-History" class="btn btn-outline">
                  <i class="fas fa-list"></i> View Requests
                </a>
                <a href="/dashboard" class="btn btn-ghost">
                  <i class="fas fa-home"></i> Dashboard
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Toast Notifications -->
  <div class="toast-container" id="toast-container"></div>

  <!-- QR Code Modal -->
  <div class="modal" id="qr-modal" hidden>
    <div class="modal-overlay" id="modal-overlay"></div>
    <div class="modal-content">
      <button type="button" class="btn-icon" id="close-qr">
        <i class="fas fa-times"></i>
      </button>
      <div class="modal-body">
        <h3>Payment Request QR Code</h3>
        <p>Scan this QR code to open the payment request link</p>
        <div class="qr-container">
          <div id="qr-image"></div>
        </div>
        <p class="qr-hint">Use any QR code scanner or your phone camera</p>
      </div>
    </div>
  </div>

  <!-- Context Data -->
  <script>
    window.APP_CONFIG = {
      userName: "<%= (user && user.FullName) ? user.FullName.replace(/\"/g, '\\\"') : 'You' %>",
      userId: "<%= (user && user._id) ? user._id : '' %>",
      baseUrl: "<%= process.env.BASE_URL || 'http://localhost:3000' %>"
    };
  </script>

  <script src="/js/request-money.js"></script>
</body>
</html>
