<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction History - ZenoPay</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/transaction-history.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body>
    <!-- Sidebar -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="main-content">
     

      <div class="transaction-container">
        <!-- Page Header -->
        <div class="page-header">
          <div class="page-header-content">
            <div class="page-header-left">
              <h1><i class="fas fa-history"></i> Transaction History</h1>
              <p>View and manage all your payments</p>
            </div>
            <div class="page-header-right">
              <button class="time-filter-pill" onclick="showTimeFilterOptions()">
                <i class="fas fa-calendar-alt"></i> This Month <i class="fas fa-chevron-down"></i>
              </button>
              <button class="export-btn" onclick="exportTransactions()">
                <i class="fas fa-download"></i> Export CSV
              </button>
            </div>
          </div>
        </div>

        <div class="main-wrapper">
          <!-- Summary Strip -->
          <div class="summary-strip">
            <div class="summary-card">
              <div class="summary-card-icon blue">
                <i class="fas fa-list"></i>
              </div>
              <div class="summary-card-value"><%= totalTransactions || 0 %></div>
              <div class="summary-card-label">Total Transactions</div>
            </div>
            <div class="summary-card">
              <div class="summary-card-icon purple">
                <i class="fas fa-wallet"></i>
              </div>
              <div class="summary-card-value">₹<%= (Number(totalAmount) || 0).toLocaleString('en-IN', {maximumFractionDigits: 2}) %></div>
              <div class="summary-card-label">Total Amount</div>
            </div>
            <div class="summary-card">
              <div class="summary-card-icon green">
                <i class="fas fa-arrow-down"></i>
              </div>
              <div class="summary-card-value">₹<%= (Number(moneyIn) || 0).toLocaleString('en-IN', {maximumFractionDigits: 2}) %></div>
              <div class="summary-card-label">Money In</div>
            </div>
            <div class="summary-card">
              <div class="summary-card-icon orange">
                <i class="fas fa-arrow-up"></i>
              </div>
              <div class="summary-card-value">₹<%= (Number(moneyOut) || 0).toLocaleString('en-IN', {maximumFractionDigits: 2}) %></div>
              <div class="summary-card-label">Money Out</div>
            </div>
          </div>

          <!-- Filter & Search Card -->
          <div class="filter-section">
            <div class="filter-row-main">
              <div class="filter-group">
                <label for="transactionType">Type</label>
                <select id="transactionType">
                  <option value="">All Types</option>
                  <option value="credit">Receive</option>
                  <option value="debit">Send</option>
                  <option value="transfer">Transfer</option>
                </select>
              </div>
              <div class="filter-group">
                <label for="status">Status</label>
                <select id="status">
                  <option value="">All Status</option>
                  <option value="success">Success</option>
                  <option value="pending">Pending</option>
                  <option value="failed">Failed</option>
                </select>
              </div>
              <div class="filter-group">
                <label for="paymentMethod">Payment Method</label>
                <select id="paymentMethod">
                  <option value="">All Methods</option>
                  <option value="upi">UPI</option>
                  <option value="card">Card</option>
                  <option value="bank">Bank Transfer</option>
                  <option value="wallet">Wallet</option>
                </select>
              </div>
              <div class="filter-group">
                <label for="dateFrom">From Date</label>
                <input type="date" id="dateFrom" />
              </div>
            </div>
            <div class="filter-divider"></div>
            <div class="filter-row-bottom">
              <div class="search-wrapper">
                <label for="searchInput">Search</label>
                <i class="fas fa-search search-icon"></i>
                <input
                  type="text"
                  class="search-input"
                  placeholder="Search by name, ID, or note…"
                  id="searchInput"
                  oninput="searchTransactions()"
                />
              </div>
              <button class="reset-btn" onclick="resetFilters()">
                <i class="fas fa-undo"></i> Reset
              </button>
            </div>
          </div>

          <!-- Transaction Table -->
          <div class="transaction-list">
            <% if (hasTransactions) { %>
              <div class="transactions-table-wrapper">
                <table class="transactions-table">
                  <thead>
                    <tr>
                      <th style="width: 50px;"></th>
                      <th>Date & Time</th>
                      <th>Description</th>
                      <th>Payment Method</th>
                      <th style="text-align: right;">Amount</th>
                      <th style="text-align: center;">Status</th>
                      <th style="text-align: center; width: 50px;">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% Object.values(allTransactions || []).forEach(txn => { %>
                      <tr class="transaction-row" data-txn="<%= encodeURIComponent(JSON.stringify(txn)) %>">
                        <td class="txn-icon-cell">
                          <div class="txn-icon <%= txn.type || 'transfer' %>">
                            <i class="fas <%= txn.type === 'credit' ? 'fa-arrow-down' : txn.type === 'debit' ? 'fa-arrow-up' : 'fa-exchange-alt' %>"></i>
                          </div>
                        </td>
                        <td>
                          <div style="font-size: 0.85rem; font-weight: 600;">
                            <%= txn.date %><br>
                            <span style="color: #9CA3AF; font-size: 0.8rem;"><%= txn.time || 'N/A' %></span>
                          </div>
                        </td>
                        <td>
                          <div class="txn-description">
                            <div class="txn-name"><%= txn.isCredit ? (txn.senderName || txn.description) : (txn.receiverName || txn.description) %></div>
                            <div class="txn-note"><%= txn.note || txn.reference || 'No note' %></div>
                          </div>
                        </td>
                        <td class="txn-method"><%= txn.paymentMethod || 'Unknown' %></td>
                        <td class="txn-amount <%= txn.isCredit ? 'positive' : 'negative' %>">
                          <%= txn.isCredit ? '+' : '-' %>₹<%= (Number(txn.amount) || 0).toLocaleString('en-IN', {maximumFractionDigits: 2}) %>
                        </td>
                        <td style="text-align: center;">
                          <span class="status-badge status-<%= txn.status || 'pending' %>">
                            <i class="fas <%= txn.status === 'success' ? 'fa-check-circle' : txn.status === 'pending' ? 'fa-clock' : 'fa-times-circle' %>"></i>
                            <%= txn.status || 'pending' %>
                          </span>
                        </td>
                        <td class="txn-actions" onclick="event.stopPropagation();">
                          <button class="action-menu" data-txn="<%= encodeURIComponent(JSON.stringify(txn)) %>">
                            <i class="fas fa-ellipsis-v"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Mobile Stacked Cards View -->
              <div class="transaction-cards-mobile">
                <% Object.values(allTransactions || []).forEach(txn => { %>
                  <div class="transaction-card-mobile" data-txn="<%= encodeURIComponent(JSON.stringify(txn)) %>">
                    <div class="transaction-card-mobile-header">
                      <div class="txn-icon <%= txn.type || 'transfer' %>">
                        <i class="fas <%= txn.type === 'credit' ? 'fa-arrow-down' : txn.type === 'debit' ? 'fa-arrow-up' : 'fa-exchange-alt' %>"></i>
                      </div>
                      <div class="transaction-card-mobile-info">
                        <div class="transaction-card-mobile-name"><%= txn.isCredit ? (txn.senderName || txn.description) : (txn.receiverName || txn.description) %></div>
                        <div class="transaction-card-mobile-date"><%= txn.date %></div>
                      </div>
                      <div class="transaction-card-mobile-amount">
                        <div class="transaction-card-mobile-value <%= txn.isCredit ? 'positive' : 'negative' %>">
                          <%= txn.isCredit ? '+' : '-' %>₹<%= (Number(txn.amount) || 0).toLocaleString('en-IN', {maximumFractionDigits: 2}) %>
                        </div>
                        <span class="transaction-card-mobile-status status-<%= txn.status || 'pending' %>">
                          <%= txn.status || 'pending' %>
                        </span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h3>No Transactions Yet</h3>
                <p>Your transaction history will appear here once you start using ZenoPay</p>
                <a href="/send-money" style="text-decoration: none;">
                  <button class="empty-state-btn">
                    <i class="fas fa-paper-plane"></i> Start Your First Payment
                  </button>
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <!-- Transaction Detail Drawer -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
    <div id="transactionDrawer" class="transaction-drawer">
      <div class="drawer-header">
        <h3><i class="fas fa-receipt"></i> Transaction Details</h3>
        <button class="drawer-close" onclick="closeDrawer()">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="drawer-body" id="drawerBody">
        <!-- Content will be dynamically inserted -->
      </div>
      <div class="drawer-footer">
        <button class="drawer-btn drawer-btn-secondary" onclick="downloadReceipt()">
          <i class="fas fa-download"></i> Receipt
        </button>
        <button class="drawer-btn drawer-btn-primary" onclick="raiseDispute()">
          <i class="fas fa-flag"></i> Dispute
        </button>
      </div>
    </div>

    <%- include('partials/MobileNav') %>
    <%- include('partials/footer') %>


    <script src="/js/header.js"></script>
    <script src="/js/transaction-history.js"></script>
  </body>
</html>
