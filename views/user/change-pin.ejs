<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <style>
    body { font-family: Inter, Arial, sans-serif; background:#f8fafc; margin:0; }
    .wrap { max-width:420px; margin:48px auto; background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:24px; }
    .title { margin:0 0 8px; font-size:24px; }
    .sub { margin:0 0 18px; color:#64748b; font-size:14px; }
    .field { margin-bottom:12px; }
    label { display:block; margin-bottom:6px; font-size:13px; font-weight:600; }
    input[type="password"] { width:100%; height:42px; border:1px solid #cbd5e1; border-radius:10px; padding:0 12px; letter-spacing:3px; }
    .err { color:#dc2626; font-size:12px; margin-top:6px; }
    .btn { width:100%; height:42px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:600; cursor:pointer; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1 class="title">Change Transaction PIN</h1>
    <p class="sub">Update your existing 6-digit PIN.</p>

    <form method="POST" action="/user/change-pin">
      <div class="field">
        <label for="currentPin">Current PIN</label>
        <input id="currentPin" name="currentPin" type="password" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required />
        <% if (errors && errors.currentPin) { %><div class="err"><%= errors.currentPin %></div><% } %>
      </div>

      <div class="field">
        <label for="newPin">New PIN</label>
        <input id="newPin" name="newPin" type="password" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required />
        <% if (errors && errors.newPin) { %><div class="err"><%= errors.newPin %></div><% } %>
      </div>

      <div class="field">
        <label for="confirmPin">Confirm New PIN</label>
        <input id="confirmPin" name="confirmPin" type="password" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required />
        <% if (errors && errors.confirmPin) { %><div class="err"><%= errors.confirmPin %></div><% } %>
      </div>

      <button class="btn" type="submit">Change PIN</button>
    </form>
  </div>
</body>
</html>
