<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - ZenoPay</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #f5f7fa;
      color: #333;
    }
    .container {
      max-width: 900px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .kyc-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 40px;
      margin-bottom: 30px;
    }
    .kyc-header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid #e5e7eb;
    }
    .kyc-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
    }
    .kyc-icon.pending {
      background: #fef3c7;
    }
    .kyc-icon.approved {
      background: #d1fae5;
    }
    .kyc-icon.rejected {
      background: #fee2e2;
    }
    .kyc-header-content h1 {
      font-size: 26px;
      margin-bottom: 5px;
      color: #111;
    }
    .kyc-header-content p {
      color: #666;
      font-size: 14px;
    }
    .status-badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .status-badge.pending {
      background: #fef3c7;
      color: #78350f;
    }
    .status-badge.approved {
      background: #d1fae5;
      color: #065f46;
    }
    .status-badge.rejected {
      background: #fee2e2;
      color: #7f1d1d;
    }
    .status-badge.not_submitted {
      background: #e5e7eb;
      color: #374151;
    }
    .kyc-content {
      margin: 30px 0;
    }
    .content-section {
      margin-bottom: 30px;
    }
    .content-section h3 {
      font-size: 16px;
      font-weight: 600;
      color: #111;
      margin-bottom: 12px;
    }
    .content-section p {
      color: #666;
      line-height: 1.6;
      font-size: 14px;
    }
    .info-box {
      background: #f3f4f6;
      border-left: 4px solid #3b82f6;
      padding: 15px;
      border-radius: 4px;
      margin: 10px 0;
      font-size: 14px;
    }
    .info-box.success {
      background: #dcfce7;
      border-left-color: #22c55e;
      color: #166534;
    }
    .info-box.warning {
      background: #fef3c7;
      border-left-color: #eab308;
      color: #713f12;
    }
    .info-box.error {
      background: #fee2e2;
      border-left-color: #ef4444;
      color: #7f1d1d;
    }
    .action-buttons {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }
    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .btn-primary {
      background: #3b82f6;
      color: white;
    }
    .btn-primary:hover {
      background: #2563eb;
    }
    .btn-secondary {
      background: #e5e7eb;
      color: #374151;
    }
    .btn-secondary:hover {
      background: #d1d5db;
    }
    .documents-list {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 20px;
      margin: 15px 0;
    }
    .documents-list li {
      list-style: none;
      padding: 8px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .documents-list li:before {
      content: "✓";
      color: #22c55e;
      font-weight: bold;
      font-size: 16px;
    }
    .dates {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin: 15px 0;
    }
    .date-item {
      background: #f9fafb;
      padding: 12px;
      border-radius: 6px;
      font-size: 13px;
    }
    .date-item strong {
      color: #111;
      display: block;
      margin-bottom: 5px;
    }
    .date-item span {
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="kyc-card">
      <div class="kyc-header">
        <div class="kyc-icon <%= kyc.status %>">
          <% if(kyc.status === 'approved') { %>
            ✓
          <% } else if(kyc.status === 'rejected') { %>
            ✗
          <% } else if(kyc.status === 'under_review' || kyc.status === 'pending') { %>
            ⏳
          <% } else { %>
            ⓘ
          <% } %>
        </div>
        <div class="kyc-header-content">
          <h1>KYC Verification</h1>
          <p>Your Know Your Customer (KYC) verification status</p>
        </div>
        <div style="margin-left: auto;">
          <span class="status-badge <%= kyc.status %>">
            <% if(kyc.status === 'pending') { %>
              Under Review
            <% } else if(kyc.status === 'under_review') { %>
              Under Review
            <% } else if(kyc.status === 'approved') { %>
              Verified ✓
            <% } else if(kyc.status === 'rejected') { %>
              Rejected
            <% } else { %>
              Not Submitted
            <% } %>
          </span>
        </div>
      </div>

      <div class="kyc-content">
        <% if(kyc.isVerified) { %>
          <div class="info-box success">
            <strong>✓ Verification Complete</strong><br>
            Your KYC has been successfully verified. You now have full access to all ZenoPay features and higher transaction limits.
          </div>
        <% } else if(kyc.status === 'pending' || kyc.status === 'under_review') { %>
          <div class="info-box warning">
            <strong>⏳ Under Review</strong><br>
            Your documents are being reviewed by our team. This usually takes 24-48 hours. We'll notify you once the process is complete.
          </div>
        <% } else if(kyc.status === 'rejected') { %>
          <div class="info-box error">
            <strong>✗ Verification Rejected</strong><br>
            Your KYC submission was rejected. Please review the reason below and resubmit with correct information.
          </div>
        <% } else { %>
          <div class="info-box">
            <strong>ⓘ KYC Not Submitted</strong><br>
            You have not submitted KYC documents yet. Please submit your PAN and Aadhaar details to verify your account and unlock all features.
          </div>
        <% } %>

        <% if(kyc.status === 'pending' || kyc.status === 'under_review') { %>
          <div class="content-section">
            <h3>What We're Checking</h3>
            <ul class="documents-list">
              <li>PAN Card (validity and authenticity)</li>
              <li>Aadhaar Document (front and back)</li>
              <li>Name and address verification</li>
            </ul>
          </div>
        <% } %>

        <% if(kyc.status === 'rejected' && kyc.rejectionReason) { %>
          <div class="content-section">
            <h3>Rejection Reason</h3>
            <div class="info-box error">
              <%= kyc.rejectionReason %>
            </div>
          </div>
        <% } %>

        <% if(kyc.submittedAt || kyc.reviewedAt) { %>
          <div class="content-section">
            <h3>Timeline</h3>
            <div class="dates">
              <% if(kyc.submittedAt) { %>
                <div class="date-item">
                  <strong>Submitted</strong>
                  <span><%= new Date(kyc.submittedAt).toLocaleString() %></span>
                </div>
              <% } %>
              <% if(kyc.reviewedAt) { %>
                <div class="date-item">
                  <strong>Reviewed</strong>
                  <span><%= new Date(kyc.reviewedAt).toLocaleString() %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <div class="action-buttons">
          <% if(kyc.status === 'not_submitted' || (kyc.status === 'rejected' && kyc.resubmissionAllowed)) { %>
            <a href="/kyc/submit" class="btn btn-primary">
              <% if(kyc.status === 'rejected') { %>
                Resubmit KYC
              <% } else { %>
                Submit KYC Documents
              <% } %>
            </a>
          <% } %>
          <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
