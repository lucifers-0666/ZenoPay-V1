<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    body { font-family: Inter, Arial, sans-serif; background:#f8fafc; margin:0; color:#0f172a; }
    .wrap { max-width:460px; margin:42px auto 64px; background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px; box-shadow:0 10px 28px rgba(2,6,23,.06); }
    .title { margin:0 0 8px; font-size:24px; }
    .sub { margin:0 0 18px; color:#64748b; font-size:14px; }
    .otp {
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      margin:10px 0 14px;
      flex-wrap:nowrap;
      overflow:hidden;
    }
    .otp input.digit {
      width:52px !important;
      min-width:52px !important;
      max-width:52px !important;
      flex:0 0 52px !important;
      height:52px;
      text-align:center;
      font-size:24px;
      border:1px solid #cbd5e1;
      border-radius:10px;
      outline:none;
      background:#fff;
      padding:0;
      box-sizing:border-box;
    }
    .otp input.digit:focus {
      border-color:#2563eb;
      box-shadow:0 0 0 3px rgba(37,99,235,0.15);
    }
    .err { color:#dc2626; font-size:12px; margin-bottom:12px; }
    .info { margin:0 0 14px; padding:10px 12px; border-radius:10px; border:1px solid #bfdbfe; background:#eff6ff; color:#1d4ed8; font-size:13px; }
    .hint { color:#64748b; font-size:13px; margin:0 0 12px; }
    .btn { width:100%; height:40px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:600; cursor:pointer; }

    @media (max-width: 520px) {
      .wrap { margin:24px 12px; padding:18px; }
      .otp { gap:8px; }
      .otp input.digit {
        width:44px !important;
        min-width:44px !important;
        max-width:44px !important;
        flex:0 0 44px !important;
        height:48px;
        font-size:20px;
      }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="wrap">
    <h1 class="title">Verify Transaction PIN</h1>
    <p class="sub">Enter your 6-digit PIN to continue this transaction.</p>

    <% if (previewMode) { %>
      <p class="info"><i class="fas fa-eye"></i> Preview mode: sign in to verify your real transaction PIN.</p>
    <% } %>

    <p class="hint">For security, your PIN attempt may be locked after multiple failed tries.</p>

    <% if (error) { %><div class="err"><%= error %></div><% } %>

    <form method="POST" action="/verify-pin" id="verifyPinForm">
      <input type="hidden" name="pin" id="pin" />
      <div class="otp" id="otpWrap">
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
        <input type="password" inputmode="numeric" maxlength="1" class="digit" required />
      </div>
      <button class="btn" type="submit">Verify PIN</button>
    </form>
  </div>

  <script nonce="<%= locals.cspNonce || '' %>">
    (function () {
      const inputs = Array.from(document.querySelectorAll('.digit'));
      const hiddenPin = document.getElementById('pin');
      const form = document.getElementById('verifyPinForm');

      const syncPin = () => {
        hiddenPin.value = inputs.map((i) => (i.value || '').replace(/\D/g, '')).join('');
      };

      inputs.forEach((input, idx) => {
        input.addEventListener('input', (e) => {
          e.target.value = e.target.value.replace(/\D/g, '').slice(0, 1);
          syncPin();
          if (e.target.value && idx < inputs.length - 1) {
            inputs[idx + 1].focus();
          }
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !input.value && idx > 0) {
            inputs[idx - 1].focus();
          }
        });
      });

      form.addEventListener('submit', (e) => {
        syncPin();
        if (!/^\d{6}$/.test(hiddenPin.value)) {
          e.preventDefault();
          inputs[0].focus();
        }
      });

      inputs[0].focus();
    })();
  </script>
  <%- include('../partials/footer') %>
</body>
</html>

