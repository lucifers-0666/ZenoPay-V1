<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <style>
    :root {
      --primary:#3B82F6; --primary-hover:#2563EB; --secondary:#8B5CF6;
      --success:#10B981; --error:#EF4444; --text:#1E293B; --muted:#64748B;
      --bg:#F8FAFC; --surface:#FFFFFF; --offset:#F1F5F9; --border:1px solid rgba(148,163,184,0.35);
      --shadow:0 8px 24px rgba(15,23,42,0.08); --transition:all 180ms cubic-bezier(0.16,1,0.3,1);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; color: var(--text); background: var(--bg); }
    .page { max-width: 980px; margin: 0 auto; padding: 24px 16px 64px; }
    h1 { margin: 0 0 14px; font-family: 'DM Serif Display', serif; font-size: 2rem; }
    .summary { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    .sum-card { border-radius: 12px; border: var(--border); background: var(--surface); box-shadow: var(--shadow); padding: 14px; }
    .sum-card small { color: var(--muted); }
    .sum-card strong { display: block; margin-top: 6px; font-size: 1.2rem; font-variant-numeric: tabular-nums; }
    .sum-card.in strong { color: var(--success); }
    .sum-card.out strong { color: var(--error); }
    .tabs { display: flex; gap: 14px; margin: 8px 0 14px; border-bottom: var(--border); }
    .tab { border: none; background: none; padding: 10px 0; cursor: pointer; color: var(--muted); font-weight: 600; position: relative; }
    .tab.active { color: var(--text); }
    .tab.active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; border-radius: 3px; background: var(--primary); }
    .list { background: var(--surface); border: var(--border); border-radius: 12px; box-shadow: var(--shadow); overflow: hidden; }
    .row {
      display: grid; grid-template-columns: 42px 1fr auto; gap: 12px; align-items: center;
      padding: 14px; border-bottom: var(--border); transition: var(--transition); opacity: 0; transform: translateY(8px);
    }
    .row.show { opacity: 1; transform: translateY(0); }
    .row:last-child { border-bottom: none; }
    .row:hover { background: var(--offset); }
    .icon {
      width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
      font-size: .9rem;
    }
    .icon.in { background: #ECFDF5; color: var(--success); }
    .icon.out { background: #FEE2E2; color: var(--error); }
    .meta small { color: var(--muted); }
    .amt { font-weight: 700; font-variant-numeric: tabular-nums; }
    .amt.in { color: var(--success); }
    .amt.out { color: var(--error); }
    .empty { text-align: center; padding: 28px; }
    .empty p { color: var(--muted); margin: 6px 0 16px; }
    .btn { text-decoration: none; background: var(--primary); color: #fff; border-radius: 8px; padding: 10px 16px; transition: var(--transition); display:inline-block; }
    .btn:hover { transform: translateY(-1px); }
    .pager { display: flex; justify-content: space-between; margin-top: 12px; }
    .pager a { text-decoration: none; border-radius: 8px; border: var(--border); background: #fff; color: var(--text); padding: 10px 14px; }
    .toast { position: fixed; top: 18px; right: 18px; padding: 12px 16px; border-radius: 10px; color: #fff; box-shadow: var(--shadow); opacity: 0; transform: translateY(-12px); transition: var(--transition); }
    .toast.success { background: var(--success); } .toast.error { background: var(--error); }
    .toast.show { opacity: 1; transform: translateY(0); }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="page">
    <h1>Transaction History</h1>

    <section class="summary">
      <article class="sum-card in"><small>Total In</small><strong>₹<%= Number(totalIn || 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></article>
      <article class="sum-card out"><small>Total Out</small><strong>₹<%= Number(totalOut || 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></article>
    </section>

    <div class="tabs" id="tabs">
      <button class="tab <%= filter === 'all' ? 'active' : '' %>" data-filter="all">All</button>
      <button class="tab <%= filter === 'topup' ? 'active' : '' %>" data-filter="topup">Added</button>
      <button class="tab <%= filter === 'send' ? 'active' : '' %>" data-filter="send">Sent</button>
      <button class="tab <%= filter === 'receive' ? 'active' : '' %>" data-filter="receive">Received</button>
    </div>

    <section class="list" id="txList">
      <% if (transactions && transactions.length) { %>
        <% transactions.forEach(function(tx, idx){ %>
          <% const isIn = ['topup','receive','refund'].includes(tx.type); %>
          <article class="row" data-type="<%= tx.type %>" data-delay="<%= idx * 50 %>">
            <div class="icon <%= isIn ? 'in' : 'out' %>"><i class="fa-solid <%= isIn ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i></div>
            <div class="meta">
              <strong><%= tx.description || tx.type %></strong>
              <div><small><%= tx.reference %> • <%= new Date(tx.createdAt).toLocaleString('en-IN') %></small></div>
            </div>
            <div class="amt <%= isIn ? 'in' : 'out' %>"><%= isIn ? '+' : '-' %>₹<%= Number(tx.amount || 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="empty">
          <h3 style="font-family:'DM Serif Display',serif;margin:0;">No transactions yet.</h3>
          <p>Add money to get started</p>
          <a class="btn" href="/wallet/topup">Add Money</a>
        </div>
      <% } %>
    </section>

    <div class="pager">
      <% const prevPage = Math.max(1, Number(currentPage || 1) - 1); %>
      <% const nextPage = Math.min(Number(totalPages || 1), Number(currentPage || 1) + 1); %>
      <% if (Number(currentPage || 1) > 1) { %>
        <a href="/wallet/transactions?type=<%= filter %>&page=<%= prevPage %>">← Previous</a>
      <% } else { %>
        <span></span>
      <% } %>
      <% if (Number(currentPage || 1) < Number(totalPages || 1)) { %>
        <a href="/wallet/transactions?type=<%= filter %>&page=<%= nextPage %>">Next →</a>
      <% } %>
    </div>
  </main>

  <% if (flash && flash.message) { %>
    <div class="toast <%= flash.type === 'error' ? 'error' : 'success' %>" id="toast"><%= flash.message %></div>
  <% } %>

  <script nonce="<%= locals.cspNonce || '' %>">
    const tabs = Array.from(document.querySelectorAll('.tab'));
    const rows = Array.from(document.querySelectorAll('.row'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.dataset.filter;
        rows.forEach((row) => {
          row.style.display = filter === 'all' || row.dataset.type === filter ? 'grid' : 'none';
        });
      });
    });

    requestAnimationFrame(() => rows.forEach((row) => {
      row.style.transitionDelay = `${Number(row.dataset.delay || 0)}ms`;
      row.classList.add('show');
    }));

    (function initToast() {
      const toast = document.getElementById('toast');
      if (!toast) return;
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => toast.classList.remove('show'), 4000);
    })();
  </script>
</body>
</html>

